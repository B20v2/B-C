	cost = 18000, buildTime = 30, size = { 4, 7 }, model = "droneRamp", params = { tint = "european" },
	launcher = "RAPTOR", reload = 6, research = "drones_2", needsRoad = false,
	desc = "European ramp that launches Raptors twice as fast." })

function Buildings.get(id: string): BuildingDef?
	return byId[id]
end

function Buildings.all(): { BuildingDef }
	return list
end

function Buildings.forTab(category: string, tab: string, faction: string?): { BuildingDef }
	local out = {}
	for _, def in list do
		if def.category == category and def.tab == tab then
			if faction == nil or def.faction == faction then
				table.insert(out, def)
			end
		end
	end
	return out
end

-- Tabs that contain faction variants show the Standard / Eastern / European toggle.
function Buildings.tabHasFactions(category: string, tab: string): boolean
	for _, def in list do
		if def.category == category and def.tab == tab and def.faction ~= "Standard" then
			return true
		end
	end
	return false
end

return Buildings
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="11">
          <Properties>
            <string name="Name">Products</string>
            <string name="Source"><![CDATA[--[[
	Monetization catalog.

	HOW TO GO LIVE: create each pass / developer product on the Creator Hub
	(Monetization tab of your experience) and paste its ID into `id` below.
	While an ID is 0 the item is still shown in the store and, in Studio with
	Config.StudioFreePurchases enabled, buying it grants it for free so every
	perk can be tested.

	`robux` is only the fallback label; the live price is fetched from
	MarketplaceService at runtime.
]]

export type PassDef = {
	key: string,
	id: number,
	name: string,
	robux: number,
	desc: string,
	perks: { string },
	color: Color3,
	order: number?,
}

export type ProductDef = {
	key: string,
	id: number,
	name: string,
	robux: number,
	desc: string,
	kind: string, -- "cash" | "instantBuild" | "instantResearch" | "boost" | "supply" | "starter" | "repair"
	minutes: number?, -- cash packs: minutes of income; boosts: duration
	minCash: number?,
	oneTime: boolean?,
	tag: string?,
	order: number?,
}

local Products = {}

Products.Passes = {
	{ key = "DoubleCash", id = 0, name = "2x Cash", robux = 449, color = Color3.fromRGB(46, 160, 90),
		desc = "Double every pay day, forever.", perks = { "2x pay day income", "2x offline earnings" } },
	{ key = "VIP", id = 0, name = "VIP", robux = 299, color = Color3.fromRGB(222, 170, 40),
		desc = "+25% income, VIP tag and longer offline earnings.",
		perks = { "+25% income", "VIP chat tag", "Offline earnings x2", "+10 unit cap" } },
	{ key = "FastBuild", id = 0, name = "Fast Construction", robux = 249, color = Color3.fromRGB(60, 130, 220),
		desc = "Buildings, research and factories work twice as fast.",
		perks = { "2x construction speed", "2x research speed", "2x factory speed" } },
	{ key = "EasternPack", id = 0, name = "Eastern Military Pack", robux = 399, color = Color3.fromRGB(176, 60, 60),
		desc = "Unlock the Eastern faction arsenal.",
		perks = { "Tor-M2, S-300, S-400", "OTR Launcher, Swarm Rack", "BMP-3, T-90, Tor-M" } },
	{ key = "EuropeanPack", id = 0, name = "European Military Pack", robux = 399, color = Color3.fromRGB(56, 92, 170),
		desc = "Unlock the European faction arsenal.",
		perks = { "Crotale NG, SAMP/T", "Storm Battery, Falcon Ramp", "VBCI, Leclerc, CAESAR" } },
	{ key = "ExtraQueue", id = 0, name = "Factory Expansion", robux = 149, color = Color3.fromRGB(120, 90, 200),
		desc = "Bigger production queues and a bigger army.",
		perks = { "+3 queue slots per factory", "+20 unit cap" } },
	{ key = "Billboard", id = 0, name = "Billboard", robux = 99, color = Color3.fromRGB(230, 120, 40),
		desc = "Place billboards with your own message.", perks = { "Up to 6 custom billboards" } },
} :: { PassDef }

Products.Developer = {
	{ key = "StarterPack", id = 0, name = "Starter Pack", robux = 99, kind = "starter", oneTime = true,
		tag = "BEST VALUE", desc = "$150k, 10 SRBMs and 30 minutes of 2x cash. One time only." },
	{ key = "Cash1", id = 0, name = "Pocket Change", robux = 49, kind = "cash", minutes = 10, minCash = 25000,
		desc = "10 minutes of income." },
	{ key = "Cash2", id = 0, name = "Briefcase", robux = 149, kind = "cash", minutes = 40, minCash = 100000,
		desc = "40 minutes of income." },
	{ key = "Cash3", id = 0, name = "Vault", robux = 399, kind = "cash", minutes = 150, minCash = 400000,
		tag = "POPULAR", desc = "2.5 hours of income." },
	{ key = "Cash4", id = 0, name = "National Treasury", robux = 999, kind = "cash", minutes = 480,
		minCash = 1500000, desc = "8 hours of income." },
	{ key = "Boost2x", id = 0, name = "2x Cash Boost", robux = 99, kind = "boost", minutes = 30,
		desc = "Double income for 30 minutes. Stacks time." },
	{ key = "InstantBuild", id = 0, name = "Instant Construction", robux = 39, kind = "instantBuild",
		desc = "Finish every building under construction now." },
	{ key = "InstantResearch", id = 0, name = "Instant Research", robux = 79, kind = "instantResearch",
		desc = "Finish your current research now." },
	{ key = "SupplyDrop", id = 0, name = "Supply Drop", robux = 149, kind = "supply",
		desc = "Fill every unlocked missile and drone stockpile." },
	{ key = "Repairs", id = 0, name = "Emergency Repairs", robux = 25, kind = "repair",
		desc = "Repair every damaged building for free." },
} :: { ProductDef }

for i, p in Products.Passes do
	p.order = i
end
for i, p in Products.Developer do
	p.order = i
end

function Products.pass(key: string): PassDef?
	for _, p in Products.Passes do
		if p.key == key then
			return p
		end
	end
	return nil
end

function Products.product(key: string): ProductDef?
	for _, p in Products.Developer do
		if p.key == key then
			return p
		end
	end
	return nil
end

function Products.productById(id: number): ProductDef?
	if id == 0 then
		return nil
	end
	for _, p in Products.Developer do
		if p.id == id then
			return p
		end
	end
	return nil
end

return Products
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="12">
          <Properties>
            <string name="Name">Quests</string>
            <string name="Source"><![CDATA[--[[
	Objective chain. Guides new players through every system and pays out
	cash so the early game feels fast. Checked on the server every second.

	kinds:
	  build      - own `count` finished buildings with id `target`
	  population - reach `count` citizens
	  research   - complete research node `target`
	  stock      - hold `count` of weapon `target`
	  launch     - fire `count` weapons in total
	  hits       - land `count` hits in total
	  capture    - capture `count` strategic points in total
	  units      - own `count` vehicles
]]

export type QuestDef = {
	kind: string,
	target: string?,
	count: number,
	reward: number,
	text: string,
}

local Quests: { QuestDef } = {
	{ kind = "build", target = "road", count = 4, reward = 2000, text = "Draw 32 studs of road" },
	{ kind = "build", target = "small_house", count = 3, reward = 3000, text = "Build 3 Small Houses" },
	{ kind = "build", target = "wind_turbine", count = 1, reward = 3000, text = "Build a Wind Turbine" },
	{ kind = "build", target = "water_tower", count = 1, reward = 3000, text = "Build a Water Tower" },
	{ kind = "population", count = 60, reward = 5000, text = "Reach 60 population" },
	{ kind = "build", target = "shop", count = 1, reward = 5000, text = "Build a Corner Shop" },
	{ kind = "build", target = "park", count = 1, reward = 5000, text = "Build a Park" },
	{ kind = "build", target = "oil_pump", count = 2, reward = 8000, text = "Build 2 Oil Pumps" },
	{ kind = "build", target = "small_refinery", count = 1, reward = 10000, text = "Build a Small Refinery" },
	{ kind = "build", target = "research_lab", count = 1, reward = 10000, text = "Build a Research Lab" },
	{ kind = "research", target = "military_doctrine", count = 1, reward = 20000, text = "Research Military Doctrine" },
	{ kind = "build", target = "small_military_factory", count = 1, reward = 25000, text = "Build a Small Military Factory" },
	{ kind = "research", target = "ballistics", count = 1, reward = 25000, text = "Research Ballistics" },
	{ kind = "build", target = "srbm_launcher", count = 1, reward = 30000, text = "Build an SRBM Launcher" },
	{ kind = "stock", target = "SRBM", count = 3, reward = 30000, text = "Produce 3 SRBMs" },
	{ kind = "launch", count = 1, reward = 40000, text = "Travel and launch a missile" },
	{ kind = "population", count = 1000, reward = 50000, text = "Reach 1,000 population" },
	{ kind = "hits", count = 5, reward = 60000, text = "Land 5 hits" },
	{ kind = "units", count = 3, reward = 75000, text = "Build 3 vehicles" },
	{ kind = "capture", count = 1, reward = 100000, text = "Capture a strategic point" },
	{ kind = "population", count = 5000, reward = 150000, text = "Reach 5,000 population" },
	{ kind = "hits", count = 30, reward = 200000, text = "Land 30 hits" },
	{ kind = "population", count = 15000, reward = 400000, text = "Reach 15,000 population" },
	{ kind = "hits", count = 100, reward = 750000, text = "Land 100 hits" },
}

return Quests
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="13">
          <Properties>
            <string name="Name">Research</string>
            <string name="Source"><![CDATA[--[[
	Research tree. Research labs generate research points (RP). A node costs
	RP + cash, takes time and unlocks buildings, weapons and units that list it
	in their `research` field. Some military nodes also need confirmed hits,
	so players climb the missile ladder by actually using their arsenal.
]]

export type ResearchDef = {
	id: string,
	name: string,
	branch: string, -- "Civil" | "Military"
	col: number,
	row: number,
	rp: number,
	cash: number,
	time: number,
	requires: { string },
	hits: number?,
	desc: string,
}

local Research = {}

local list: { ResearchDef } = {}
local byId: { [string]: ResearchDef } = {}

local function R(def: { [string]: any })
	def.requires = def.requires or {}
	local typed = def :: ResearchDef
	table.insert(list, typed)
	byId[typed.id] = typed
end

-- Civil branch
R({ id = "urban_planning", name = "Urban Planning", branch = "Civil", col = 1, row = 1, rp = 40, cash = 15000,
	time = 30, desc = "Apartment blocks and offices." })
R({ id = "coal_power", name = "Coal Power", branch = "Civil", col = 1, row = 2, rp = 60, cash = 20000,
	time = 40, desc = "Coal power plants." })
R({ id = "water_treatment", name = "Water Treatment", branch = "Civil", col = 1, row = 3, rp = 60, cash = 18000,
	time = 40, desc = "Pumping stations." })
R({ id = "heavy_industry", name = "Heavy Industry", branch = "Civil", col = 1, row = 4, rp = 120, cash = 40000,
	time = 60, desc = "Steel mills, medium refineries, tank farms." })
R({ id = "solar", name = "Solar Power", branch = "Civil", col = 2, row = 2, rp = 80, cash = 25000, time = 45,
	requires = { "coal_power" }, desc = "Solar farms." })
R({ id = "public_services", name = "Public Services", branch = "Civil", col = 2, row = 1, rp = 150, cash = 50000,
	time = 60, requires = { "urban_planning" }, desc = "Schools, hospitals and universities." })
R({ id = "petrochemistry", name = "Petrochemistry", branch = "Civil", col = 2, row = 4, rp = 400, cash = 150000,
	time = 120, requires = { "heavy_industry" }, desc = "Large refineries." })
R({ id = "high_density", name = "High Density Living", branch = "Civil", col = 3, row = 1, rp = 300,
	cash = 120000, time = 90, requires = { "public_services" }, desc = "Highrise towers." })
R({ id = "nuclear", name = "Nuclear Fission", branch = "Civil", col = 3, row = 3, rp = 800, cash = 400000,
	time = 180, requires = { "solar", "heavy_industry" }, desc = "Nuclear power plants." })

-- Military branch
R({ id = "military_doctrine", name = "Military Doctrine", branch = "Military", col = 1, row = 2, rp = 100,
	cash = 30000, time = 45, desc = "Small military factory, research center." })
R({ id = "ballistics", name = "Ballistics", branch = "Military", col = 2, row = 1, rp = 150, cash = 40000,
	time = 60, requires = { "military_doctrine" }, desc = "SRBM launcher and missiles." })
R({ id = "air_defense_1", name = "Air Defense I", branch = "Military", col = 2, row = 2, rp = 120, cash = 30000,
	time = 45, requires = { "military_doctrine" }, desc = "CIWS turrets." })
R({ id = "drones_1", name = "Drone Warfare", branch = "Military", col = 2, row = 3, rp = 150, cash = 35000,
	time = 60, requires = { "military_doctrine" }, desc = "Hornet drones and racks." })
R({ id = "mechanized", name = "Mechanized Forces", branch = "Military", col = 2, row = 4, rp = 250,
	cash = 70000, time = 90, requires = { "military_doctrine", "heavy_industry" },
	desc = "Large factory, vehicle depot, trucks and IFVs." })
R({ id = "cruise_missiles", name = "Cruise Missiles", branch = "Military", col = 3, row = 1, rp = 300,
	cash = 90000, time = 90, requires = { "ballistics" }, hits = 5, desc = "GLCM launcher and missiles." })
R({ id = "air_defense_2", name = "Air Defense II", branch = "Military", col = 3, row = 2, rp = 300, cash = 80000,
	time = 90, requires = { "air_defense_1" }, desc = "SAM sites, radar, mobile anti-air." })
R({ id = "drones_2", name = "Jet Drones", branch = "Military", col = 3, row = 3, rp = 350, cash = 100000,
	time = 100, requires = { "drones_1" }, hits = 5, desc = "Raptor jet drones." })
R({ id = "armor", name = "Armored Warfare", branch = "Military", col = 3, row = 4, rp = 450, cash = 130000,
	time = 120, requires = { "mechanized" }, desc = "Main battle tanks." })
R({ id = "mrbm", name = "Medium-Range Missiles", branch = "Military", col = 4, row = 1, rp = 700, cash = 220000,
	time = 150, requires = { "cruise_missiles" }, hits = 10, desc = "MRBM launcher and missiles." })
R({ id = "air_defense_3", name = "Air Defense III", branch = "Military", col = 4, row = 2, rp = 800,
	cash = 250000, time = 180, requires = { "air_defense_2" }, desc = "Long-range SAM." })
R({ id = "rocket_artillery", name = "Rocket Artillery", branch = "Military", col = 4, row = 4, rp = 600,
	cash = 180000, time = 150, requires = { "armor" }, desc = "HIMARS." })
R({ id = "cluster", name = "Cluster Munitions", branch = "Military", col = 5, row = 1, rp = 1000, cash = 350000,
	time = 200, requires = { "mrbm" }, hits = 30, desc = "Cluster BM launcher and missiles." })
R({ id = "directed_energy", name = "Directed Energy", branch = "Military", col = 5, row = 2, rp = 2000,
	cash = 900000, time = 300, requires = { "air_defense_3" }, desc = "Laser defense." })
R({ id = "hypersonic", name = "Hypersonic Weapons", branch = "Military", col = 6, row = 1, rp = 2500,
	cash = 1200000, time = 360, requires = { "cluster" }, hits = 100, desc = "Hypersonic BM launcher." })

function Research.get(id: string): ResearchDef?
	return byId[id]
end

function Research.all(): { ResearchDef }
	return list
end

return Research
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="14">
          <Properties>
            <string name="Name">Units</string>
            <string name="Source"><![CDATA[--[[
	Units catalog: ground vehicles built in military factories. Units roll out
	at home, deploy to the mainland through the tunnel and capture points.
]]

export type UnitDef = {
	id: string,
	name: string,
	role: string,
	faction: string,
	cost: number,
	fuel: number,
	steel: number,
	time: number,
	hp: number,
	speed: number,
	dps: number,
	range: number,
	capture: number, -- capture points per second
	antiAir: number?, -- chance to shoot down projectiles nearby
	model: string,
	params: { [string]: any }?,
	research: string,
	pass: string?,
	order: number,
	desc: string,
}

local Units = {}

local list: { UnitDef } = {}
local byId: { [string]: UnitDef } = {}

local FactionPass = { Eastern = "EasternPack", European = "EuropeanPack" }

local function U(def: { [string]: any })
	def.order = #list + 1
	def.faction = def.faction or "Standard"
	if def.faction ~= "Standard" then
		def.pass = FactionPass[def.faction]
	end
	local typed = def :: UnitDef
	table.insert(list, typed)
	byId[typed.id] = typed
end

U({ id = "truck", name = "Supply Truck", role = "Capture", cost = 1500, fuel = 20, steel = 10, time = 10,
	hp = 60, speed = 34, dps = 0, range = 0, capture = 1, model = "truck", research = "mechanized",
	desc = "Cheap and fast. Good for holding points." })
U({ id = "marder", name = "Marder", role = "IFV", cost = 6000, fuel = 60, steel = 40, time = 25,
	hp = 180, speed = 26, dps = 10, range = 60, capture = 3, model = "ifv", research = "mechanized",
	desc = "Infantry fighting vehicle. Best at capturing." })
U({ id = "leopard", name = "Leopard", role = "Tank", cost = 14000, fuel = 100, steel = 90, time = 40,
	hp = 420, speed = 20, dps = 24, range = 80, capture = 2, model = "tank", research = "armor",
	desc = "Main battle tank. Tough and hard hitting." })
U({ id = "himars", name = "HIMARS", role = "Artillery", cost = 18000, fuel = 80, steel = 60, time = 45,
	hp = 140, speed = 28, dps = 40, range = 220, capture = 1, model = "mlrs", research = "rocket_artillery",
	desc = "Long-range rockets. Shreds garrisons from afar." })
U({ id = "gepard", name = "Gepard", role = "Anti-Air", cost = 12000, fuel = 60, steel = 50, time = 30,
	hp = 200, speed = 24, dps = 8, range = 60, capture = 1, antiAir = 0.3, model = "spaag",
	research = "air_defense_2", desc = "Mobile anti-air. Protects your army from drones and missiles." })
U({ id = "bmp", name = "BMP-3", role = "IFV", faction = "Eastern", cost = 6500, fuel = 60, steel = 40,
	time = 22, hp = 190, speed = 28, dps = 13, range = 65, capture = 3, model = "ifv", params = { eastern = true },
	research = "mechanized", desc = "Eastern IFV with a heavier gun." })
U({ id = "t90", name = "T-90", role = "Tank", faction = "Eastern", cost = 15000, fuel = 100, steel = 95,
	time = 38, hp = 460, speed = 20, dps = 26, range = 80, capture = 2, model = "tank", params = { eastern = true },
	research = "armor", desc = "Eastern main battle tank." })
U({ id = "tor_m", name = "Tor-M", role = "Anti-Air", faction = "Eastern", cost = 13000, fuel = 60, steel = 50,
	time = 28, hp = 220, speed = 22, dps = 6, range = 60, capture = 1, antiAir = 0.4, model = "spaag",
	params = { eastern = true }, research = "air_defense_2", desc = "Eastern mobile SAM." })
U({ id = "vbci", name = "VBCI", role = "IFV", faction = "European", cost = 6500, fuel = 55, steel = 40,
	time = 22, hp = 200, speed = 32, dps = 11, range = 65, capture = 3, model = "ifv", params = { wheeled = true },
	research = "mechanized", desc = "Fast wheeled European IFV." })
U({ id = "leclerc", name = "Leclerc", role = "Tank", faction = "European", cost = 15500, fuel = 100, steel = 90,
	time = 38, hp = 420, speed = 24, dps = 26, range = 85, capture = 2, model = "tank", params = { european = true },
	research = "armor", desc = "Fast European main battle tank." })
U({ id = "caesar", name = "CAESAR", role = "Artillery", faction = "European", cost = 17000, fuel = 70, steel = 55,
	time = 40, hp = 150, speed = 32, dps = 44, range = 240, capture = 1, model = "mlrs", params = { gun = true },
	research = "rocket_artillery", desc = "Truck-mounted howitzer with extreme range." })

function Units.get(id: string): UnitDef?
	return byId[id]
end

function Units.all(): { UnitDef }
	return list
end

return Units
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="15">
          <Properties>
            <string name="Name">WarMap</string>
            <string name="Source"><![CDATA[--[[
	Strategic points on the central battlefield. Offsets are relative to
	Config.MainlandOrigin. The capital sits in the middle; the rest sit
	between the bridge lanes so every nation has something on its way in.
	Bonuses are paid to the owner every pay day / tick.
]]

export type PointDef = {
	id: string,
	name: string,
	offset: Vector3,
	garrison: number,
	model: string,
	bonus: { income: number?, oil: number?, power: number?, steel: number?, rp: number? },
	bonusText: string,
}

local WarMap: { PointDef } = {
	{ id = "capital", name = "CAPITAL", offset = Vector3.new(0, 0, 0), garrison = 2500, model = "city",
		bonus = { income = 20000 }, bonusText = "+$20k per pay" },
	{ id = "airport", name = "AIRPORT", offset = Vector3.new(-573, 0, -237), garrison = 900, model = "airport",
		bonus = { income = 6000, rp = 20 }, bonusText = "+$6k per pay, +20 RP/min" },
	{ id = "oil_field", name = "OIL FIELD", offset = Vector3.new(554, 0, 230), garrison = 700, model = "oilField",
		bonus = { oil = 600 }, bonusText = "+600 oil/min" },
	{ id = "nuclear_plant", name = "NUCLEAR POWER PLANT", offset = Vector3.new(237, 0, -573), garrison = 1100,
		model = "nuclear", bonus = { power = 400 }, bonusText = "+400 MW power" },
	{ id = "city", name = "CITY", offset = Vector3.new(480, 0, -199), garrison = 1000, model = "city",
		bonus = { income = 9000 }, bonusText = "+$9k per pay" },
	{ id = "port", name = "PORT", offset = Vector3.new(237, 0, 573), garrison = 800, model = "port",
		bonus = { steel = 300 }, bonusText = "+300 steel/min" },
	{ id = "military_base", name = "MILITARY BASE", offset = Vector3.new(-554, 0, 230), garrison = 1300,
		model = "base", bonus = { rp = 60 }, bonusText = "+60 RP/min" },
}

return WarMap
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="16">
          <Properties>
            <string name="Name">Weapons</string>
            <string name="Source"><![CDATA[--[[
	Weapons catalog: missiles and drones.
	Produced in military factories, stored in the national stockpile and
	fired from launchers of the matching `family`.
]]

export type WeaponDef = {
	id: string,
	name: string,
	short: string, -- hotbar label
	kind: string, -- "missile" | "drone"
	family: string, -- which launcher fires it
	cost: number,
	fuel: number,
	steel: number,
	time: number, -- seconds to produce at speed 1
	damage: number,
	radius: number,
	flight: number, -- seconds in the air
	apex: number, -- arc height (studs)
	interceptMod: number, -- multiplies air defense hit chance
	stockCap: number,
	research: string,
	order: number,
	color: Color3,
	desc: string,
}

local Weapons = {}

local list: { WeaponDef } = {}
local byId: { [string]: WeaponDef } = {}

local function W(def: { [string]: any })
	def.order = #list + 1
	def.stockCap = def.stockCap or 60
	local typed = def :: WeaponDef
	table.insert(list, typed)
	byId[typed.id] = typed
end

W({ id = "HORNET", name = "Hornet Drone", short = "HORNET", kind = "drone", family = "HORNET",
	cost = 600, fuel = 10, steel = 5, time = 8, damage = 30, radius = 14, flight = 22, apex = 40,
	interceptMod = 1.25, research = "drones_1", color = Color3.fromRGB(150, 155, 140),
	desc = "Slow, cheap loitering munition. Swarm defenses with them." })
W({ id = "RAPTOR", name = "Raptor Jet Drone", short = "RAPTOR", kind = "drone", family = "RAPTOR",
	cost = 1800, fuel = 25, steel = 12, time = 14, damage = 55, radius = 18, flight = 12, apex = 70,
	interceptMod = 0.9, research = "drones_2", color = Color3.fromRGB(120, 128, 118),
	desc = "Fast jet-powered strike drone." })
W({ id = "SRBM", name = "Short-Range Ballistic Missile", short = "SRBM", kind = "missile", family = "SRBM",
	cost = 2500, fuel = 40, steel = 20, time = 20, damage = 70, radius = 26, flight = 9, apex = 280,
	interceptMod = 1.0, research = "ballistics", color = Color3.fromRGB(96, 110, 70),
	desc = "Reliable ballistic strike." })
W({ id = "GLCM", name = "Ground-Launched Cruise Missile", short = "GLCM", kind = "missile", family = "GLCM",
	cost = 3200, fuel = 60, steel = 25, time = 24, damage = 80, radius = 22, flight = 15, apex = 28,
	interceptMod = 0.7, research = "cruise_missiles", color = Color3.fromRGB(150, 156, 162),
	desc = "Hugs the ground. Air defense struggles to hit it." })
W({ id = "MRBM", name = "Medium-Range Ballistic Missile", short = "MRBM", kind = "missile", family = "MRBM",
	cost = 6000, fuel = 90, steel = 50, time = 35, damage = 140, radius = 34, flight = 12, apex = 440,
	interceptMod = 0.9, research = "mrbm", color = Color3.fromRGB(180, 182, 176),
	desc = "Heavy warhead, big blast." })
W({ id = "CLUSTER", name = "Cluster Ballistic Missile", short = "CLUSTER", kind = "missile", family = "CLUSTER",
	cost = 7000, fuel = 90, steel = 60, time = 40, damage = 45, radius = 70, flight = 12, apex = 380,
	interceptMod = 1.0, research = "cluster", color = Color3.fromRGB(196, 178, 128),
	desc = "Scatters bomblets over a huge area." })
W({ id = "HYPERSONIC", name = "Hypersonic Ballistic Missile", short = "HYPER", kind = "missile", family = "HYPERSONIC",
	cost = 15000, fuel = 150, steel = 90, time = 60, damage = 200, radius = 34, flight = 6, apex = 180,
	interceptMod = 0.35, research = "hypersonic", color = Color3.fromRGB(60, 64, 70),
	desc = "Mach 10. Defenses rarely react in time." })

function Weapons.get(id: string): WeaponDef?
	return byId[id]
end

function Weapons.all(): { WeaponDef }
	return list
end

return Weapons
]]></string>
          </Properties>
        </Item>
      </Item>
      <Item class="ModuleScript" referent="17">
        <Properties>
          <string name="Name">Config</string>
          <string name="Source"><![CDATA[--[[
	Config
	Global tuning for Forge & Frontline. Every balance number that is not tied
	to a single building / weapon / unit lives here so the game can be tuned
	from one place.
]]

local Config = {}

Config.GameName = "Forge & Frontline"
Config.DataStoreName = "FF_PlayerData_v1"
Config.DataVersion = 1

-- Set to true while testing in Studio: game passes count as owned and
-- developer products are granted without a real purchase.
Config.StudioFreePurchases = true

-- Roblox group that gives the "Join group" bonus. 0 disables the reward.
Config.GroupId = 0

---------------------------------------------------------------------------
-- World layout
-- The central battlefield (the "mainland") sits in the middle of the map.
-- Every nation's island sits on a ring around it, facing the centre, and
-- is joined to it by its own bridge.
---------------------------------------------------------------------------
Config.CellSize = 4 -- studs per cell: catalog footprints + the optional GRID snap
Config.PlotSize = 480 -- studs; each island's free-build area (square)
Config.MaxPlots = 8
Config.MainlandOrigin = Vector3.new(0, 0, 0)
Config.MainlandRadius = 1000 -- round continent (sand edge)
Config.PlotRingRadius = 1440 -- island centres from the middle
Config.BridgeWidth = 30

---------------------------------------------------------------------------
-- Economy
---------------------------------------------------------------------------
Config.StartCash = 60000
Config.PayInterval = 60 -- seconds between pay days
Config.TaxPerCitizen = 15 -- $ per citizen per pay at 100% tax efficiency
Config.UpkeepRate = 0.0025 -- fraction of build cost charged every pay day
Config.SellRefund = 0.5 -- refund when deleting a finished building
Config.RepairCostRate = 0.25 -- fraction of build cost to repair a damaged building
Config.BaseResourceCap = 2000 -- oil / steel stored nationally before tanks & warehouses
Config.PopulationGrowth = 0.012 -- fraction of free housing filled each second
Config.PopulationMinGrowth = 1
Config.HappinessBase = 50
Config.OfflineEarningsHours = 2 -- max hours of offline pay
Config.OfflineEarningsRate = 0.3 -- 30% of pay while away (VIP doubles)
Config.PremiumIncomeBonus = 0.1 -- Roblox Premium members earn +10%

---------------------------------------------------------------------------
-- Construction / logistics
---------------------------------------------------------------------------
Config.TruckCapacity = 250
Config.TruckSpeed = 28 -- studs per second
Config.UndoWindow = 45 -- seconds an action can be undone for a full refund
Config.MaxQueuePerFactory = 5
Config.MaxBuildings = 900 -- per nation (road segments included)
Config.RoadMaxLength = 240 -- longest single road segment, studs

---------------------------------------------------------------------------
-- Combat
---------------------------------------------------------------------------
Config.PvpToggleCooldown = 180 -- after attacking you must wait before going PvP OFF
Config.NewPlayerShield = 20 * 60 -- seconds of protection for brand new nations
Config.StrikeLootRate = 0.03 -- attacker earns this fraction of the value they damage
Config.InterceptAt = 0.72 -- fraction of a flight at which interceptions happen

---------------------------------------------------------------------------
-- Conquest
---------------------------------------------------------------------------
Config.CaptureRadius = 70
Config.CaptureTime = 100 -- capture points needed (units add their capture power per second)
Config.GarrisonRegen = 4 -- garrison HP regenerated per second
Config.MaxUnitsPerPlayer = 40
Config.UnitSpeedScale = 1.6 -- vehicles drive the catalog speed x this
Config.RaidBuildingDamage = 1.5 -- vehicle dps multiplier against buildings

-- Colour used for each plot slot's nation on the war map.
Config.NationColors = {
	Color3.fromRGB(64, 140, 230),
	Color3.fromRGB(226, 84, 74),
	Color3.fromRGB(80, 184, 96),
	Color3.fromRGB(236, 170, 40),
	Color3.fromRGB(150, 96, 216),
	Color3.fromRGB(40, 190, 196),
	Color3.fromRGB(236, 116, 180),
	Color3.fromRGB(150, 150, 150),
}

---------------------------------------------------------------------------
-- Rewards / retention
---------------------------------------------------------------------------
Config.DailyRewards = { 5000, 10000, 20000, 35000, 50000, 75000, 150000 }
Config.PlaytimeGiftInterval = 10 * 60
Config.PlaytimeGiftPays = 1.5 -- gift = 1.5 pay days of income (min 5k)
Config.GroupRewardCash = 25000

Config.Codes = {
	FORGE = 25000,
	FRONTLINE = 50000,
	RELEASE = 100000,
}

---------------------------------------------------------------------------
-- Nation identity, ranks and world
---------------------------------------------------------------------------
Config.NationNameMin = 3
Config.NationNameMax = 20

-- Power = population + building value / 100 + techs * 150 + vehicles * 80
-- + strategic points * 600. Crossing a threshold pays the reward once.
Config.Ranks = {
	{ name = "Outpost", power = 0, reward = 0 },
	{ name = "Township", power = 500, reward = 10000 },
	{ name = "City-State", power = 2500, reward = 30000 },
	{ name = "Republic", power = 10000, reward = 80000 },
	{ name = "Federation", power = 40000, reward = 200000 },
	{ name = "Superpower", power = 150000, reward = 500000 },
}

Config.DayLength = 16 * 60 -- seconds for a full day + night
Config.NightShare = 0.3 -- fraction of the cycle spent at night

return Config
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="18">
        <Properties>
          <string name="Name">ModelBuilder</string>
          <string name="Source"><![CDATA[--[[
	ModelBuilder
	Builds every asset in the game out of plain parts: a consistent, clean,
	low-poly style with zero external asset IDs. Used by the server (real
	buildings / units), and by the client (placement ghosts, build-menu
	thumbnails, projectiles, fuel trucks).

	Conventions
	  * Models are built at the origin, unrotated, footprint centered on X/Z,
	    ground at Y = 0. Width (w) runs along X, depth (d) along Z.
	  * Front of vehicles / launchers faces -Z (the CFrame LookVector).
	  * PrimaryPart is "Base" (buildings) or "Root" (units/projectiles).
	  * Animated sub-models carry attributes the client animator reads:
	      Spin = rad/s around the sub-model's local axis given by SpinAxis
	      Rock = amplitude (radians) for pump jacks
]]

local Config = require(script.Parent.Config)
local AssetLibrary = require(script.Parent.AssetLibrary)

local ModelBuilder = {}

local CELL = Config.CellSize
local G = 0.4 -- foundation slab height

local rgb = Color3.fromRGB
local C = {
	concrete = rgb(206, 206, 200),
	pad = rgb(186, 186, 180),
	wall = rgb(234, 233, 228),
	wallWarm = rgb(226, 216, 196),
	wallCool = rgb(214, 218, 222),
	panel = rgb(218, 214, 206),
	terracotta = rgb(180, 90, 66),
	slate = rgb(90, 98, 112),
	roofGrey = rgb(150, 152, 156),
	glass = rgb(72, 96, 120),
	window = rgb(64, 74, 88),
	metal = rgb(168, 172, 176),
	darkMetal = rgb(78, 82, 88),
	steel = rgb(120, 126, 132),
	olive = rgb(92, 102, 66),
	oliveDark = rgb(70, 78, 50),
	eastern = rgb(74, 94, 60),
	european = rgb(170, 156, 118),
	sand = rgb(178, 162, 120),
	red = rgb(192, 58, 48),
	orange = rgb(222, 132, 44),
	yellow = rgb(226, 182, 52),
	grass = rgb(104, 142, 80),
	leaf = rgb(80, 122, 62),
	leafLight = rgb(110, 150, 70),
	trunk = rgb(110, 84, 60),
	asphalt = rgb(74, 76, 80),
	line = rgb(226, 224, 214),
	water = rgb(86, 150, 196),
	white = rgb(245, 245, 242),
	black = rgb(30, 32, 36),
	brick = rgb(168, 104, 84),
	blue = rgb(70, 120, 200),
	solar = rgb(38, 58, 96),
}
ModelBuilder.Colors = C

---------------------------------------------------------------------------
-- Primitive helpers (operate on the model currently being built)
---------------------------------------------------------------------------
local M: Model

local function finish(p: BasePart, color: Color3, material: Enum.Material?)
	p.Anchored = true
	p.Color = color
	p.Material = material or Enum.Material.SmoothPlastic
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	p.CanTouch = false
	p.Parent = M
end

-- Box with its BOTTOM at y (easy stacking).
local function blk(sx: number, sy: number, sz: number, x: number, y: number, z: number, color: Color3, material: Enum.Material?): Part
	local p = Instance.new("Part")
	p.Size = Vector3.new(sx, sy, sz)
	p.CFrame = CFrame.new(x, y + sy / 2, z)
	finish(p, color, material)
	return p
end

-- Box at an arbitrary center CFrame.
local function plank(sx: number, sy: number, sz: number, cf: CFrame, color: Color3, material: Enum.Material?): Part
	local p = Instance.new("Part")
	p.Size = Vector3.new(sx, sy, sz)
	p.CFrame = cf
	finish(p, color, material)
	return p
end

-- Vertical cylinder, bottom at y.
local function cyl(h: number, d: number, x: number, y: number, z: number, color: Color3, material: Enum.Material?): Part
	local p = Instance.new("Part")
	p.Shape = Enum.PartType.Cylinder
	p.Size = Vector3.new(h, d, d)
	p.CFrame = CFrame.new(x, y + h / 2, z) * CFrame.Angles(0, 0, math.rad(90))
	finish(p, color, material)
	return p
end

-- Cylinder whose axis is the X axis of cf.
local function axleCyl(len: number, d: number, cf: CFrame, color: Color3, material: Enum.Material?): Part
	local p = Instance.new("Part")
	p.Shape = Enum.PartType.Cylinder
	p.Size = Vector3.new(len, d, d)
	p.CFrame = cf
	finish(p, color, material)
	return p
end

local function ball(d: number, x: number, y: number, z: number, color: Color3, material: Enum.Material?): Part
	local p = Instance.new("Part")
	p.Shape = Enum.PartType.Ball
	p.Size = Vector3.new(d, d, d)
	p.CFrame = CFrame.new(x, y, z)
	finish(p, color, material)
	return p
end

local function noCollide(p: BasePart)
	p.CanCollide = false
	return p
end

-- Window pane: glows at night (see NightLights on the client).
local function lit(p: BasePart): BasePart
	p.CanCollide = false
	p:SetAttribute("Window", true)
	return p
end

-- Window bands around a box (centered x,z; floors stacked from y0).
local function windows(w: number, d: number, x: number, z: number, y0: number, floors: number, floorH: number, color: Color3?, gaps: boolean?)
	local col = color or C.window
	for f = 0, floors - 1 do
		local y = y0 + f * floorH + floorH * 0.32
		local h = floorH * 0.42
		lit(blk(w - 1, h, 0.2, x, y, z - d / 2 - 0.05, col))
		lit(blk(w - 1, h, 0.2, x, y, z + d / 2 + 0.05, col))
		lit(blk(0.2, h, d - 1, x - w / 2 - 0.05, y, z, col))
		lit(blk(0.2, h, d - 1, x + w / 2 + 0.05, y, z, col))
	end
	if gaps then
		-- vertical mullions so long facades read as individual windows
		local step = 3
		local n = math.floor((w - 1) / step)
		for i = 1, n - 1 do
			local px = x - (w - 1) / 2 + i * step
			noCollide(blk(0.35, floors * floorH - 0.6, 0.3, px, y0 + 0.3, z - d / 2 - 0.08, C.panel))
			noCollide(blk(0.35, floors * floorH - 0.6, 0.3, px, y0 + 0.3, z + d / 2 + 0.08, C.panel))
		end
	end
end

-- Gable roof built from two tilted planks; ridge runs along Z.
local function gableRoof(w: number, d: number, x: number, y: number, z: number, color: Color3, pitch: number?)
	local a = math.rad(pitch or 28)
	local half = w / 2
	local rise = half * math.tan(a)
	local len = half / math.cos(a) + 0.5
	plank(len, 0.4, d + 0.6, CFrame.new(x + half / 2, y + rise / 2, z) * CFrame.Angles(0, 0, -a), color)
	plank(len, 0.4, d + 0.6, CFrame.new(x - half / 2, y + rise / 2, z) * CFrame.Angles(0, 0, a), color)
	-- gable infill so the roof never looks hollow (kept inside the slopes)
	blk(w * 0.42, rise * 0.55, d - 0.2, x, y, z, C.wall)
	return rise
end

local function tree(x: number, z: number, s: number?)
	local k = s or 1
	noCollide(cyl(2.2 * k, 0.5 * k, x, G, z, C.trunk))
	noCollide(ball(3 * k, x, G + 3 * k, z, C.leaf))
	noCollide(ball(2 * k, x + 0.6 * k, G + 4 * k, z - 0.3 * k, C.leafLight))
end

local function wheelPair(x: number, y: number, z: number, track: number, d: number)
	axleCyl(0.7, d, CFrame.new(x - track / 2, y, z), C.black)
	axleCyl(0.7, d, CFrame.new(x + track / 2, y, z), C.black)
end

local function base(w: number, d: number, color: Color3?, h: number?): Part
	local p = blk(w, h or G, d, 0, 0, 0, color or C.concrete)
	p.Name = "Base"
	M.PrimaryPart = p
	return p
end

local function spinGroup(name: string, speed: number, axis: string): Model
	local sub = Instance.new("Model")
	sub.Name = name
	sub:SetAttribute("Spin", speed)
	sub:SetAttribute("SpinAxis", axis)
	sub.Parent = M
	return sub
end

-- Run fn with M temporarily pointing at a sub-model.
local function into(sub: Model, fn: () -> ())
	local prev = M
	M = sub
	fn()
	M = prev
end

---------------------------------------------------------------------------
-- Building styles
---------------------------------------------------------------------------
local Styles: { [string]: (w: number, d: number, p: { [string]: any }) -> () } = {}

Styles.house = function(w, d, p)
	local bw, bd = w - 1.6, d - 1.6
	local wallC = p.wallColor or C.wallWarm
	blk(bw, 5, bd, 0, G, 0, wallC)
	local roofC = p.roof == "slate" and C.slate or C.terracotta
	gableRoof(bw + 0.6, bd, 0, G + 5, 0, roofC)
	noCollide(blk(1.4, 2.6, 0.2, 0, G, -bd / 2 - 0.1, C.trunk)) -- door
	lit(blk(1.2, 1.2, 0.2, -bw / 4 - 0.3, G + 2.2, -bd / 2 - 0.1, C.window))
	lit(blk(1.2, 1.2, 0.2, bw / 4 + 0.3, G + 2.2, -bd / 2 - 0.1, C.window))
	lit(blk(0.2, 1.2, 1.2, bw / 2 + 0.1, G + 2.2, 0, C.window))
	lit(blk(0.2, 1.2, 1.2, -bw / 2 - 0.1, G + 2.2, 0, C.window))
	blk(0.8, 2.5, 0.8, bw / 4, G + 6, bd / 4, C.brick)
end

Styles.townhouse = function(w, d, p)
	local n = p.count or 3
	local each = w / n
	local walls = { C.wallWarm, C.wall, rgb(222, 200, 186) }
	for i = 1, n do
		local x = -w / 2 + each * (i - 0.5)
		local bw, bd = each - 0.3, d - 1.6
		blk(bw, 7, bd, x, G, 0, walls[(i - 1) % #walls + 1])
		gableRoof(bw, bd, x, G + 7, 0, i % 2 == 0 and C.slate or C.terracotta, 24)
		noCollide(blk(1.4, 2.6, 0.2, x, G, -bd / 2 - 0.1, C.trunk))
		lit(blk(bw - 2, 1.2, 0.2, x, G + 4.4, -bd / 2 - 0.1, C.window))
		lit(blk(bw - 2, 1.2, 0.2, x, G + 4.4, bd / 2 + 0.1, C.window))
	end
end

Styles.apartment = function(w, d, p)
	local floors = p.floors or 4
	local fh = 3.2
	local bw, bd = w - 1.4, d - 1.4
	blk(bw, floors * fh + 0.8, bd, 0, G, 0, C.panel)
	windows(bw, bd, 0, 0, G + 0.8, floors, fh, C.window, true)
	blk(bw + 0.4, 0.6, bd + 0.4, 0, G + floors * fh + 0.8, 0, C.roofGrey)
	-- rooftop details
	local units = math.max(1, math.floor(bw / 12))
	for i = 1, units do
		local x = -bw / 2 + (i - 0.5) * (bw / units)
		blk(2.2, 1.6, 2.2, x, G + floors * fh + 1.4, 0, C.metal)
	end
	-- entrances
	local doors = math.max(1, math.floor(bw / 10))
	for i = 1, doors do
		local x = -bw / 2 + (i - 0.5) * (bw / doors)
		noCollide(blk(2, 2.6, 0.4, x, G, -bd / 2 - 0.2, C.darkMetal))
	end
end

Styles.tower = function(w, d, p)
	local floors = p.floors or 14
	local fh = 3.2
	local bw, bd = w - 2.2, d - 2.2
	blk(w - 0.8, 4, d - 0.8, 0, G, 0, C.wallCool)
	blk(bw, floors * fh, bd, 0, G + 4, 0, C.wall)
	windows(bw, bd, 0, 0, G + 4, floors, fh, C.glass)
	local top = G + 4 + floors * fh
	blk(bw - 2, 3, bd - 2, 0, top, 0, C.roofGrey)
	noCollide(cyl(6, 0.3, 0, top + 3, 0, C.metal))
	noCollide(ball(0.7, 0, top + 9.2, 0, C.red, Enum.Material.Neon))
end

Styles.road = function(w, d, _p)
	local p = blk(w, 0.3, d, 0, 0, 0, C.asphalt)
	p.Name = "Base"
	M.PrimaryPart = p
end

Styles.plaza = function(w, d, _p)
	local b = M.PrimaryPart :: BasePart
	b.Color = rgb(196, 190, 176)
	cyl(0.8, 6, 0, G, 0, C.pad)
	cyl(0.85, 5, 0, G, 0, C.water, Enum.Material.Glass).Transparency = 0.2
	noCollide(cyl(2.4, 0.6, 0, G, 0, C.pad))
	tree(-w / 2 + 2, -d / 2 + 2, 0.8)
	tree(w / 2 - 2, d / 2 - 2, 0.8)
	tree(w / 2 - 2, -d / 2 + 2, 0.8)
	tree(-w / 2 + 2, d / 2 - 2, 0.8)
end

Styles.windTurbine = function(_w, _d, _p)
	cyl(1, 2.4, 0, G, 0, C.pad)
	cyl(30, 1.1, 0, G + 1, 0, C.white)
	local top = G + 31
	blk(1.6, 1.6, 3.2, 0, top - 0.4, 0.2, C.white)
	local rotor = spinGroup("Rotor", 1.6, "X")
	into(rotor, function()
		local hubCF = CFrame.new(0, top + 0.4, -1.7)
		local hub = axleCyl(0.8, 1.2, hubCF * CFrame.Angles(0, math.rad(90), 0), C.white)
		hub.Name = "Hub"
		rotor.PrimaryPart = hub
		for k = 0, 2 do
			noCollide(plank(0.7, 12, 0.25, hubCF * CFrame.Angles(0, 0, math.rad(k * 120)) * CFrame.new(0, 6.2, 0), C.white))
		end
	end)
end

Styles.solarFarm = function(w, d, _p)
	local rows = math.floor((d - 2) / 4)
	for r = 0, rows - 1 do
		local z = -d / 2 + 2.5 + r * 4
		for _, x in { -w / 4, w / 4 } do
			noCollide(blk(0.3, 1.2, 0.3, x, G, z, C.metal))
		end
		local panel = plank(w - 2, 0.2, 2.8, CFrame.new(0, G + 1.6, z) * CFrame.Angles(math.rad(-25), 0, 0), C.solar)
		panel.Reflectance = 0.15
	end
end

local function stripedChimney(x: number, z: number, h: number, dia: number)
	local seg = h / 6
	for i = 0, 5 do
		cyl(seg, dia, x, G + i * seg, z, i % 2 == 0 and C.white or C.red)
	end
end

local function coolingTower(x: number, z: number, scale: number)
	local s = scale
	cyl(5 * s, 14 * s, x, G, z, C.wallCool)
	cyl(5 * s, 12.5 * s, x, G + 5 * s, z, C.wallCool)
	cyl(4 * s, 11.5 * s, x, G + 10 * s, z, C.wallCool)
	cyl(4 * s, 12.2 * s, x, G + 14 * s, z, C.wallCool)
	cyl(0.8 * s, 12.5 * s, x, G + 17.4 * s, z, C.red)
	-- dark interior so the top reads as hollow
	noCollide(cyl(0.2, 10.5 * s, x, G + 18.1 * s, z, C.darkMetal))
end

Styles.coalPlant = function(w, d, _p)
	blk(w * 0.55, 12, d * 0.62, -w * 0.18, G, -d * 0.12, C.wallCool)
	windows(w * 0.55, d * 0.62, -w * 0.18, -d * 0.12, G + 2, 3, 3.4, C.window)
	blk(w * 0.25, 18, d * 0.35, -w * 0.3, G, d * 0.28, C.metal)
	stripedChimney(-w * 0.08, d * 0.32, 34, 2.6)
	stripedChimney(-w * 0.18, d * 0.32, 34, 2.6)
	coolingTower(w * 0.28, -d * 0.12, 1)
	-- coal pile
	local pile = cyl(2.5, 9, w * 0.3, G, d * 0.3, C.black)
	pile.Material = Enum.Material.Slate
end

Styles.nuclearPlant = function(w, d, _p)
	coolingTower(-w * 0.26, -d * 0.2, 1.45)
	coolingTower(w * 0.02, -d * 0.24, 1.45)
	-- reactor
	cyl(10, 14, w * 0.3, G, d * 0.18, C.wall)
	ball(14, w * 0.3, G + 10, d * 0.18, C.wall)
	-- turbine hall
	blk(w * 0.5, 9, d * 0.28, -w * 0.15, G, d * 0.3, C.wallCool)
	windows(w * 0.5, d * 0.28, -w * 0.15, d * 0.3, G + 1.5, 2, 3.4)
	blk(w * 0.5, 0.5, 1.2, -w * 0.15, G + 9, d * 0.3, C.red)
	-- switchyard
	for i = 0, 3 do
		noCollide(blk(0.5, 6, 0.5, w * 0.42, G, -d * 0.4 + i * 4, C.metal))
	end
end

Styles.waterTower = function(_w, _d, _p)
	for _, o in { Vector3.new(-1.6, 0, -1.6), Vector3.new(1.6, 0, -1.6), Vector3.new(-1.6, 0, 1.6), Vector3.new(1.6, 0, 1.6) } do
		blk(0.5, 14, 0.5, o.X, G, o.Z, C.metal)
	end
	cyl(14, 1, 0, G, 0, C.metal)
	ball(7.5, 0, G + 17, 0, C.white)
	cyl(1, 7.6, 0, G + 16.3, 0, C.white)
end

Styles.pumpStation = function(w, d, _p)
	blk(w * 0.45, 6, d * 0.4, -w * 0.22, G, -d * 0.22, C.wallWarm)
	gableRoof(w * 0.45, d * 0.4, -w * 0.22, G + 6, -d * 0.22, C.slate, 18)
	for _, x in { w * 0.18, -w * 0.18 } do
		cyl(1.2, d * 0.36, x, G, d * 0.22, C.pad)
		cyl(1.25, d * 0.3, x, G, d * 0.22, C.water, Enum.Material.Glass).Transparency = 0.15
	end
	axleCyl(w * 0.5, 0.8, CFrame.new(w * 0.12, G + 1.4, -d * 0.22), C.blue)
end

Styles.oilPump = function(w, d, _p)
	blk(2.4, 0.6, d - 1, 0, G, 0, C.darkMetal)
	-- A-frame
	plank(0.4, 5.2, 0.4, CFrame.new(-0.7, G + 2.8, 0) * CFrame.Angles(0, 0, math.rad(-8)), C.darkMetal)
	plank(0.4, 5.2, 0.4, CFrame.new(0.7, G + 2.8, 0) * CFrame.Angles(0, 0, math.rad(8)), C.darkMetal)
	blk(1, 1.2, 1.4, 0, G + 0.6, d / 2 - 1.6, C.darkMetal) -- motor
	local beam = Instance.new("Model")
	beam.Name = "Beam"
	beam:SetAttribute("Rock", math.rad(16))
	beam.Parent = M
	into(beam, function()
		local pivot = plank(0.6, 0.6, 0.6, CFrame.new(0, G + 5.4, 0), C.darkMetal)
		pivot.Name = "Pivot"
		beam.PrimaryPart = pivot
		plank(0.6, 0.7, d - 1.4, CFrame.new(0, G + 5.6, 0), C.orange)
		plank(0.9, 2.2, 1, CFrame.new(0, G + 5.2, -d / 2 + 1), C.orange) -- horse head
		plank(1, 1.2, 1, CFrame.new(0, G + 5.2, d / 2 - 1.2), C.darkMetal)
	end)
	noCollide(blk(0.2, 4.5, 0.2, 0, G, -d / 2 + 0.9, C.black)) -- polished rod
	local _ = w
end

Styles.oilTank = function(w, d, _p)
	for _, o in { Vector2.new(-1, -1), Vector2.new(1, -1), Vector2.new(-1, 1), Vector2.new(1, 1) } do
		local x, z = o.X * w / 4, o.Y * d / 4
		cyl(5, w / 2 - 1, x, G, z, C.white)
		cyl(0.3, w / 2 - 0.9, x, G + 5, z, C.metal)
	end
end

Styles.refinery = function(w, d, p)
	local s = p.scale or 1
	-- control building
	blk(w * 0.3, 5, d * 0.25, -w * 0.3, G, -d * 0.33, C.wall)
	windows(w * 0.3, d * 0.25, -w * 0.3, -d * 0.33, G + 1, 1, 3.4)
	-- storage tanks
	local tankD = math.min(w, d) * 0.22
	local tanks = { Vector2.new(-0.28, 0.18), Vector2.new(-0.28, -0.05) }
	if s >= 2 then
		table.insert(tanks, Vector2.new(0.32, 0.3))
	end
	if s >= 3 then
		table.insert(tanks, Vector2.new(0.32, 0.05))
	end
	for _, t in tanks do
		cyl(4 + s, tankD, t.X * w, G, t.Y * d, C.white)
		cyl(0.3, tankD + 0.1, t.X * w, G + 4 + s, t.Y * d, C.metal)
	end
	-- distillation columns
	for i = 0, s do
		local x = w * (0.02 + i * 0.09)
		cyl(14 + s * 4 - i * 2, 1.8, x, G, -d * 0.12, C.metal)
		cyl(0.6, 2.1, x, G + 6, -d * 0.12, C.darkMetal)
	end
	-- pipe rack
	blk(w * 0.7, 0.5, 1.2, 0, G + 3, d * 0.05, C.steel)
	for i = 0, 4 do
		noCollide(blk(0.4, 3, 0.4, -w * 0.35 + i * w * 0.175, G, d * 0.05, C.steel))
	end
	-- flare stack
	cyl(16 + s * 4, 0.8, w * 0.4, G, -d * 0.38, C.metal)
	cyl(1.2, 1, w * 0.4, G + 16 + s * 4, -d * 0.38, C.red)
end

Styles.steelMill = function(w, d, _p)
	blk(w * 0.7, 12, d * 0.65, -w * 0.1, G, 0, C.steel)
	blk(w * 0.7 + 0.2, 1, d * 0.65 + 0.2, -w * 0.1, G + 8, 0, C.orange)
	gableRoof(w * 0.7, d * 0.65, -w * 0.1, G + 12, 0, C.darkMetal, 14)
	for i = 0, 2 do
		cyl(26, 1.8, w * 0.36, G, -d * 0.3 + i * d * 0.3, C.darkMetal)
		cyl(1, 2, w * 0.36, G + 22, -d * 0.3 + i * d * 0.3, C.orange)
	end
	plank(w * 0.4, 0.6, 1.2, CFrame.new(w * 0.15, G + 6, -d * 0.4) * CFrame.Angles(0, 0, math.rad(-18)), C.darkMetal)
end

Styles.warehouse = function(w, d, _p)
	blk(w - 1.2, 7, d - 1.2, 0, G, 0, C.wallCool)
	gableRoof(w - 1.2, d - 1.2, 0, G + 7, 0, C.roofGrey, 12)
	local doors = math.max(2, math.floor(w / 8))
	for i = 1, doors do
		local x = -w / 2 + (i - 0.5) * (w / doors)
		noCollide(blk(3, 4.5, 0.25, x, G, -d / 2 + 0.5, C.darkMetal))
	end
end

Styles.factory = function(w, d, p)
	local military = p.tint == "military"
	local wallC = military and rgb(150, 154, 132) or C.wallWarm
	local roofC = military and C.oliveDark or C.roofGrey
	local bw, bd = w - 1.6, d - 1.6
	local h = p.large and 10 or 8
	blk(bw, h, bd, 0, G, 0, wallC)
	-- sawtooth roof
	local teeth = math.max(2, math.floor(bd / 6))
	local step = bd / teeth
	for i = 0, teeth - 1 do
		local z = -bd / 2 + (i + 0.5) * step
		plank(bw, 0.4, step / math.cos(math.rad(30)), CFrame.new(0, G + h + step * 0.29, z) * CFrame.Angles(math.rad(-30), 0, 0), roofC)
		noCollide(blk(bw - 0.4, step * 0.55, 0.2, 0, G + h, z + step / 2 - 0.15, C.glass))
	end
	lit(blk(bw - 2, 1.4, 0.2, 0, G + 3, -bd / 2 - 0.1, C.window))
	for i = 1, (p.large and 3 or 2) do
		noCollide(blk(3.4, 4.4, 0.3, -bw / 2 + i * bw / ((p.large and 3 or 2) + 1), G, bd / 2 + 0.1, C.darkMetal))
	end
	cyl(h + 10, 1.6, bw / 2 - 2, G, -bd / 2 + 2, military and C.oliveDark or C.brick)
	if military then
		blk(4, 0.2, 4, -bw / 2 + 3, G + h + 0.1, -bd / 2 + 3, C.red).CanCollide = false
	end
end

Styles.shop = function(w, d, _p)
	local bw, bd = w - 1.4, d - 1.4
	blk(bw, 4.6, bd, 0, G, 0, C.wall)
	blk(bw + 0.2, 0.4, bd + 0.2, 0, G + 4.6, 0, C.roofGrey)
	noCollide(blk(bw - 1, 2.6, 0.2, 0, G + 0.6, -bd / 2 - 0.1, C.glass))
	local awning = noCollide(plank(bw, 0.2, 1.8, CFrame.new(0, G + 3.6, -bd / 2 - 0.8) * CFrame.Angles(math.rad(18), 0, 0), C.red))
	awning.Name = "Awning"
	noCollide(blk(bw * 0.7, 0.9, 0.25, 0, G + 4.8, -bd / 2 + 0.2, C.yellow))
end

Styles.park = function(w, d, _p)
	local b = M.PrimaryPart :: BasePart
	b.Color = C.grass
	b.Material = Enum.Material.Grass
	noCollide(blk(w - 0.5, 0.06, 1.2, 0, G, 0, rgb(214, 200, 168)))
	noCollide(blk(1.2, 0.06, d - 0.5, 0, G, 0, rgb(214, 200, 168)))
	tree(-w / 4, -d / 4, 1)
	tree(w / 4, d / 4, 1.2)
	tree(w / 4, -d / 4, 0.9)
	cyl(0.15, w / 3, -w / 4, G, d / 4, C.water, Enum.Material.Glass).CanCollide = false
	noCollide(blk(1.6, 0.5, 0.5, 2, G + 0.3, -1.2, C.trunk))
end

Styles.office = function(w, d, p)
	local floors = p.floors or 8
	local fh = 3.4
	local bw, bd = w - 1.6, d - 1.6
	blk(bw, floors * fh, bd, 0, G, 0, C.glass, Enum.Material.Glass).Transparency = 0
	for f = 1, floors do
		noCollide(blk(bw + 0.2, 0.5, bd + 0.2, 0, G + f * fh - 0.5, 0, C.wallCool))
	end
	blk(bw - 2, 2, bd - 2, 0, G + floors * fh, 0, C.metal)
end

Styles.school = function(w, d, _p)
	blk(w * 0.9, 7, d * 0.35, 0, G, -d * 0.28, C.brick)
	windows(w * 0.9, d * 0.35, 0, -d * 0.28, G + 0.8, 2, 3.2, C.window)
	blk(w * 0.9 + 0.3, 0.5, d * 0.35 + 0.3, 0, G + 7, -d * 0.28, C.roofGrey)
	-- sports field
	noCollide(blk(w * 0.7, 0.08, d * 0.45, 0, G, d * 0.2, C.grass, Enum.Material.Grass))
	noCollide(blk(0.2, 0.1, d * 0.45, 0, G, d * 0.2, C.line))
	noCollide(cyl(9, 0.25, w * 0.42, G, d * 0.42, C.metal))
	noCollide(blk(0.1, 1.4, 2.2, w * 0.42, G + 7.4, d * 0.42 - 1.1, C.blue))
end

Styles.hospital = function(w, d, _p)
	blk(w * 0.8, 10, d * 0.45, 0, G, -d * 0.18, C.white)
	windows(w * 0.8, d * 0.45, 0, -d * 0.18, G + 0.8, 3, 3.1, C.glass)
	blk(w * 0.35, 6, d * 0.35, -w * 0.2, G, d * 0.25, C.white)
	local top = G + 10
	noCollide(blk(5, 0.15, 1.4, 0, top, -d * 0.18, C.red))
	noCollide(blk(1.4, 0.15, 5, 0, top, -d * 0.18, C.red))
	noCollide(cyl(0.1, 6, w * 0.25, G, d * 0.25, C.darkMetal))
	noCollide(blk(2.4, 0.12, 0.4, w * 0.25, G + 0.1, d * 0.25, C.line))
end

Styles.billboard = function(w, _d, _p)
	blk(0.4, 6, 0.4, -w / 3, G, 0, C.darkMetal)
	blk(0.4, 6, 0.4, w / 3, G, 0, C.darkMetal)
	local board = blk(w - 0.2, 4.2, 0.4, 0, G + 5, 0, C.white)
	board.Name = "Board"
	for _, face in { Enum.NormalId.Front, Enum.NormalId.Back } do
		local gui = Instance.new("SurfaceGui")
		gui.Face = face
		gui.CanvasSize = Vector2.new(400, 110)
		gui.LightInfluence = 0.2
		gui.Parent = board
		local label = Instance.new("TextLabel")
		label.Name = "Message"
		label.Size = UDim2.fromScale(1, 1)
		label.BackgroundColor3 = rgb(250, 248, 240)
		label.TextColor3 = rgb(28, 34, 46)
		label.TextScaled = true
		label.FontFace = Font.new("rbxasset://fonts/families/TitilliumWeb.json", Enum.FontWeight.Bold)
		label.Text = "YOUR AD HERE"
		label.Parent = gui
		local pad = Instance.new("UIPadding")
		pad.PaddingLeft = UDim.new(0, 12)
		pad.PaddingRight = UDim.new(0, 12)
		pad.Parent = label
	end
end

Styles.researchLab = function(w, d, _p)
	blk(w * 0.8, 6, d * 0.6, 0, G, -d * 0.1, C.white)
	windows(w * 0.8, d * 0.6, 0, -d * 0.1, G + 0.8, 1, 4, C.glass)
	ball(5.5, w * 0.15, G + 6, -d * 0.1, C.wallCool)
	noCollide(cyl(5, 0.25, -w * 0.25, G + 6, -d * 0.2, C.metal))
	noCollide(blk(w * 0.8, 0.06, d * 0.25, 0, G, d * 0.32, C.grass, Enum.Material.Grass))
end

Styles.university = function(w, d, _p)
	blk(w * 0.85, 9, d * 0.5, 0, G, d * 0.05, C.wallWarm)
	windows(w * 0.85, d * 0.5, 0, d * 0.05, G + 1, 2, 3.6, C.window)
	blk(w * 0.4, 1.2, 3, 0, G, -d * 0.25, C.pad)
	for i = 0, 5 do
		cyl(8, 0.9, -w * 0.17 + i * w * 0.068, G + 1.2, -d * 0.25, C.white)
	end
	blk(w * 0.42, 1.4, 3.4, 0, G + 9, -d * 0.25, C.white)
	ball(7, 0, G + 9, d * 0.05, rgb(120, 160, 150))
end

Styles.milResearch = function(w, d, _p)
	blk(w * 0.75, 5, d * 0.5, -w * 0.05, G, -d * 0.12, rgb(140, 146, 124))
	blk(w * 0.75 + 0.3, 0.5, d * 0.5 + 0.3, -w * 0.05, G + 5, -d * 0.12, C.oliveDark)
	windows(w * 0.75, d * 0.5, -w * 0.05, -d * 0.12, G + 1, 1, 3.4)
	for i, x in { -w * 0.25, w * 0.05 } do
		noCollide(cyl(1.6, 0.8, x, G, d * 0.3, C.metal))
		plank(5 - i, 0.3, 5 - i, CFrame.new(x, G + 3, d * 0.3) * CFrame.Angles(math.rad(-35), 0, 0), C.white)
	end
	noCollide(cyl(16, 0.35, w * 0.35, G, d * 0.3, C.metal))
	noCollide(ball(0.6, w * 0.35, G + 16.2, d * 0.3, C.red, Enum.Material.Neon))
end

Styles.depot = function(w, d, _p)
	blk(w - 1.4, 6, d * 0.55, 0, G, d * 0.15, rgb(150, 154, 132))
	blk(w - 1.2, 0.5, d * 0.55 + 0.2, 0, G + 6, d * 0.15, C.oliveDark)
	local doors = 4
	for i = 1, doors do
		local x = -w / 2 + 0.7 + (i - 0.5) * ((w - 1.4) / doors)
		noCollide(blk(((w - 1.4) / doors) - 1, 4.6, 0.25, x, G, d * 0.15 - d * 0.275 - 0.1, C.darkMetal))
	end
	noCollide(blk(w - 1, 0.06, d * 0.35, 0, G, -d * 0.28, C.asphalt))
end

Styles.radar = function(_w, _d, _p)
	blk(3, 3, 3, 0, G, 0, rgb(150, 154, 132))
	cyl(8, 1.2, 0, G + 3, 0, C.metal)
	local dish = spinGroup("Dish", 1.2, "Y")
	into(dish, function()
		local hub = plank(1, 1, 1, CFrame.new(0, G + 11.5, 0), C.metal)
		hub.Name = "Hub"
		dish.PrimaryPart = hub
		plank(7, 3, 0.3, CFrame.new(0, G + 12.2, 0) * CFrame.Angles(math.rad(-15), 0, 0), C.white)
	end)
end

local function factionColor(p: { [string]: any }): Color3
	if p.eastern then
		return C.eastern
	elseif p.european then
		return C.european
	elseif p.tint == "sand" then
		return C.sand
	elseif p.tint == "dark" then
		return rgb(66, 70, 74)
	elseif p.tint == "eastern" then
		return C.eastern
	elseif p.tint == "european" then
		return C.european
	end
	return C.olive
end

Styles.ciws = function(_w, _d, p)
	local col = factionColor(p)
	cyl(1, 6, 0, G, 0, C.pad)
	cyl(2, 2.6, 0, G + 1, 0, col)
	blk(2.6, 1.8, 2.6, 0, G + 3, 0, col)
	axleCyl(3.4, 0.5, CFrame.new(0, G + 3.9, -2.6) * CFrame.Angles(0, math.rad(90), 0) * CFrame.Angles(0, 0, math.rad(20)), C.darkMetal)
	ball(2.2, 0, G + 5.4, 0.4, C.white)
end

local function launcherTruck(len: number, col: Color3)
	blk(3.2, 1.2, len, 0, G + 0.9, 0, col)
	blk(3.2, 2.2, 2.6, 0, G + 0.9, -len / 2 + 1.3, col) -- cab
	lit(blk(2.8, 0.8, 0.15, 0, G + 2.2, -len / 2 - 0.02, C.window))
	local axles = math.max(2, math.floor(len / 2.6))
	for i = 0, axles - 1 do
		wheelPair(0, G + 0.75, -len / 2 + 1.2 + i * ((len - 2.4) / (axles - 1)), 3.3, 1.5)
	end
end

Styles.sam = function(w, d, p)
	local col = factionColor(p)
	local count = p.large and 2 or 1
	for i = 1, count do
		local x = count == 1 and -w * 0.12 or (-w * 0.3 + (i - 1) * w * 0.32)
		local len = d * 0.7
		local unit = Instance.new("Model")
		unit.Name = "Launcher" .. i
		unit.Parent = M
		into(unit, function()
			launcherTruck(len, col)
			local tubeCF = CFrame.new(0, G + 4, len * 0.12) * CFrame.Angles(math.rad(50), 0, 0)
			for tx = -1, 1, 2 do
				plank(1.2, 1.2, len * 0.55, tubeCF * CFrame.new(tx * 0.7, 0.6, 0), col)
				plank(1.2, 1.2, len * 0.55, tubeCF * CFrame.new(tx * 0.7, -0.6, 0), col)
			end
		end)
		unit:TranslateBy(Vector3.new(x, 0, 0))
	end
	-- radar truck
	local rx = w * 0.32
	blk(2.6, 1.2, d * 0.45, rx, G + 0.6, d * 0.1, col)
	plank(3.6, 3.2, 0.4, CFrame.new(rx, G + 4, d * 0.1) * CFrame.Angles(math.rad(-20), 0, 0), C.white)
end

Styles.laser = function(_w, _d, _p)
	cyl(1.2, 8, 0, G, 0, C.pad)
	cyl(3, 3.6, 0, G + 1.2, 0, C.metal)
	blk(3.4, 2.8, 3.4, 0, G + 4.2, 0, C.wall)
	local lens = axleCyl(1.6, 2.2, CFrame.new(0, G + 5.6, -2) * CFrame.Angles(0, math.rad(90), 0), rgb(120, 200, 255), Enum.Material.Neon)
	lens.Name = "Lens"
end

Styles.launcher = function(w, d, p)
	local col = factionColor(p)
	local len = d - 1.2
	launcherTruck(len, col)
	if p.kind == "box" then
		local boxCF = CFrame.new(0, G + 3.6, len * 0.12) * CFrame.Angles(math.rad(25), 0, 0)
		plank(3, 2.4, len * 0.62, boxCF, col)
		for ix = -1, 1, 2 do
			for iy = -1, 1, 2 do
				noCollide(plank(0.9, 0.9, 0.2, boxCF * CFrame.new(ix * 0.7, iy * 0.55, -len * 0.31 - 0.05), C.black))
			end
		end
	else
		local h = p.big and 18 or 14
		local z = len * 0.22
		-- erector frame
		blk(0.4, h * 0.85, 0.4, -1.3, G + 2, z + 1.2, C.darkMetal)
		blk(0.4, h * 0.85, 0.4, 1.3, G + 2, z + 1.2, C.darkMetal)
		cyl(h, p.big and 1.9 or 1.5, 0, G + 2, z, rgb(220, 222, 214))
		ball(p.big and 1.9 or 1.5, 0, G + 2 + h, z, C.darkMetal)
		cyl(1.2, (p.big and 1.9 or 1.5) + 0.1, 0, G + 2 + h * 0.55, z, col)
	end
	local _ = w
end

local function deltaDrone(cf: CFrame, s: number, color: Color3)
	plank(0.5 * s, 0.4 * s, 3.2 * s, cf, color)
	plank(4.2 * s, 0.15 * s, 1.2 * s, cf * CFrame.new(0, 0, 0.6 * s) * CFrame.Angles(0, math.rad(25), 0), color)
	plank(4.2 * s, 0.15 * s, 1.2 * s, cf * CFrame.new(0, 0, 0.6 * s) * CFrame.Angles(0, math.rad(-25), 0), color)
end

Styles.droneRack = function(w, d, p)
	local n = p.big and 4 or 2
	blk(w - 1, 1, d - 1, 0, G, 0, C.oliveDark)
	for i = 1, n do
		local x = -w / 2 + 0.5 + (i - 0.5) * ((w - 1) / n)
		local cf = CFrame.new(x, G + 3.2, 0) * CFrame.Angles(math.rad(30), 0, 0)
		plank(0.6, 0.3, d - 2, cf * CFrame.new(0, -0.4, 0), C.darkMetal)
		deltaDrone(cf, 0.8, rgb(170, 172, 164))
		noCollide(blk(0.3, 2.4, 0.3, x, G + 1, d / 2 - 2, C.darkMetal))
	end
end

Styles.droneRamp = function(w, d, p)
	local col = p.tint == "european" and C.european or C.olive
	plank(2.6, 0.5, d - 1.5, CFrame.new(0, G + 2.4, 0) * CFrame.Angles(math.rad(14), 0, 0), C.darkMetal)
	blk(1, 2, 1, 0, G, d / 2 - 1.5, C.darkMetal)
	local cf = CFrame.new(0, G + 3.4, -d * 0.1) * CFrame.Angles(math.rad(14), 0, 0)
	axleCyl(5, 1.1, cf * CFrame.Angles(0, math.rad(90), 0), col)
	plank(6, 0.2, 1.6, cf * CFrame.new(0, 0, 0.4), col)
	plank(2.2, 0.2, 0.8, cf * CFrame.new(0, 0, 2.2), col)
	blk(w * 0.3, 3, 4, w * 0.3, G, d * 0.3, rgb(150, 154, 132))
end

---------------------------------------------------------------------------
-- Public: buildings
---------------------------------------------------------------------------
-- Kit vehicles get an invisible Root (physics / selection) sized to the model.
local function kitWithRoot(name: string, length: number, centered: boolean): Model?
	local kit = AssetLibrary.instantiate(name, { length = length })
	if not kit then
		return nil
	end
	local oldBase = kit:FindFirstChild("Base")
	if oldBase then
		oldBase:Destroy()
	end
	local _, size = kit:GetBoundingBox()
	if centered then
		for _, part in kit:GetDescendants() do
			if part:IsA("BasePart") then
				part.CFrame -= Vector3.new(0, size.Y / 2, 0)
			end
		end
	end
	local r = Instance.new("Part")
	r.Name = "Root"
	r.Size = size
	r.CFrame = CFrame.new(0, centered and 0 or size.Y / 2, 0)
	r.Transparency = 1
	r.CanCollide = false
	r.CanTouch = false
	r.Anchored = true
	r.Parent = kit
	kit.PrimaryPart = r
	for _, part in kit:GetDescendants() do
		if part:IsA("BasePart") then
			part.CanCollide = false
		end
	end
	return kit
end

local UNIT_LENGTH = { truck = 8, ifv = 9, tank = 10, mlrs = 9.6, spaag = 9 }

-- True when the Blender kit has been imported into ReplicatedStorage.Assets.
function ModelBuilder.usingKit(): boolean
	return AssetLibrary.count() > 0
end

function ModelBuilder.building(def: { id: string, model: string, size: { number }, params: { [string]: any }? }): Model
	local kit = AssetLibrary.instantiate(def.id, { width = def.size[1] * CELL, depth = def.size[2] * CELL, hitbox = true })
	if kit then
		kit.Name = def.id
		return kit
	end
	local model = Instance.new("Model")
	model.Name = def.id
	M = model
	local w, d = def.size[1] * CELL, def.size[2] * CELL
	if def.model ~= "road" then
		base(w - 0.2, d - 0.2, (def.model == "park") and C.grass or C.concrete)
	end
	local style = Styles[def.model]
	if style then
		style(w, d, def.params or {})
	else
		blk(w - 2, 4, d - 2, 0, G, 0, C.wall)
	end
	return model
end

---------------------------------------------------------------------------
-- Units (vehicles), front = -Z
---------------------------------------------------------------------------
local function root(sx: number, sy: number, sz: number): Part
	local r = Instance.new("Part")
	r.Name = "Root"
	r.Size = Vector3.new(sx, sy, sz)
	r.CFrame = CFrame.new(0, sy / 2, 0)
	r.Transparency = 1
	r.CanCollide = false
	r.CanTouch = false
	r.Anchored = true
	r.Parent = M
	M.PrimaryPart = r
	return r
end

local function tracks(len: number, width: number)
	blk(1, 1.4, len, -width / 2 + 0.5, 0, 0, C.black)
	blk(1, 1.4, len, width / 2 - 0.5, 0, 0, C.black)
end

local UnitStyles: { [string]: (p: { [string]: any }, col: Color3) -> () } = {}

UnitStyles.truck = function(_p, col)
	root(3.6, 3.4, 8)
	blk(3.2, 2.4, 2.4, 0, 0.8, -2.6, col)
	lit(blk(2.8, 0.8, 0.15, 0, 2.1, -3.82, C.window))
	blk(3.4, 2.6, 5, 0, 0.8, 1.2, rgb(120, 126, 98))
	wheelPair(0, 0.75, -2.6, 3.3, 1.5)
	wheelPair(0, 0.75, 0.6, 3.3, 1.5)
	wheelPair(0, 0.75, 2.6, 3.3, 1.5)
end

UnitStyles.ifv = function(p, col)
	root(4.4, 3.6, 9)
	if p.wheeled then
		for _, z in { -3, -1, 1, 3 } do
			wheelPair(0, 0.8, z, 4.1, 1.6)
		end
		blk(3.8, 1.8, 8.6, 0, 0.9, 0, col)
	else
		tracks(8.6, 4.4)
		blk(3.6, 1.8, 8.6, 0, 0.6, 0, col)
	end
	plank(3.6, 0.3, 2.2, CFrame.new(0, 2.2, -4.2) * CFrame.Angles(math.rad(-30), 0, 0), col)
	blk(2.2, 1, 2.6, 0, 2.6, -0.5, col)
	axleCyl(3.2, 0.3, CFrame.new(0, 3.1, -3.2) * CFrame.Angles(0, math.rad(90), 0), C.darkMetal)
end

UnitStyles.tank = function(_p, col)
	root(5, 3.8, 10)
	tracks(9.6, 5)
	blk(4, 1.6, 9.6, 0, 0.7, 0, col)
	blk(3.4, 1.3, 4, 0, 2.3, 0.6, col)
	axleCyl(6, 0.45, CFrame.new(0, 2.9, -4.2) * CFrame.Angles(0, math.rad(90), 0), col)
end

UnitStyles.mlrs = function(p, col)
	root(3.8, 4, 9.6)
	blk(3.2, 1, 9, 0, 0.8, 0, col)
	blk(3.2, 2.2, 2.4, 0, 1.8, -3.3, col)
	lit(blk(2.8, 0.8, 0.15, 0, 3, -4.52, C.window))
	for _, z in { -3.3, 1.2, 3.4 } do
		wheelPair(0, 0.75, z, 3.3, 1.5)
	end
	if p.gun then
		axleCyl(7, 0.5, CFrame.new(0, 2.8, 0.4) * CFrame.Angles(0, math.rad(90), 0) * CFrame.Angles(0, 0, math.rad(-12)), C.darkMetal)
	else
		local pod = plank(3, 2, 4.4, CFrame.new(0, 3, 1.8) * CFrame.Angles(math.rad(12), 0, 0), col)
		pod.Name = "Pod"
		noCollide(plank(2.4, 1.4, 0.2, CFrame.new(0, 3.5, -0.42) * CFrame.Angles(math.rad(12), 0, 0), C.black))
	end
end

UnitStyles.spaag = function(_p, col)
	root(4.6, 4.4, 9)
	tracks(8.6, 4.6)
	blk(3.8, 1.6, 8.6, 0, 0.7, 0, col)
	blk(3, 1.6, 3.2, 0, 2.3, 0.4, col)
	axleCyl(3.6, 0.3, CFrame.new(-1.7, 3, -1.6) * CFrame.Angles(0, math.rad(90), 0), C.darkMetal)
	axleCyl(3.6, 0.3, CFrame.new(1.7, 3, -1.6) * CFrame.Angles(0, math.rad(90), 0), C.darkMetal)
	plank(2, 1.4, 0.2, CFrame.new(0, 4.4, 1.6), C.white)
end

function ModelBuilder.unit(def: { id: string, model: string, params: { [string]: any }? }): Model
	local kit = kitWithRoot("unit_" .. def.id, UNIT_LENGTH[def.model] or 9, false)
	if kit then
		kit.Name = def.id
		return kit
	end
	local model = Instance.new("Model")
	model.Name = def.id
	M = model
	local p = def.params or {}
	local col = p.eastern and C.eastern or (p.european and C.european or C.olive)
	local style = UnitStyles[def.model] or UnitStyles.truck
	style(p, col)
	for _, part in model:GetDescendants() do
		if part:IsA("BasePart") then
			part.CanCollide = false
			part.Anchored = true
		end
	end
	return model
end

---------------------------------------------------------------------------
-- Projectiles (client visuals), forward = -Z
---------------------------------------------------------------------------
function ModelBuilder.projectile(def: { kind: string, color: Color3, id: string }): Model
	local kit = kitWithRoot("proj_" .. def.id, def.kind == "drone" and 4.6 or (def.id == "MRBM" and 7.4 or 6), true)
	if kit then
		kit.Name = def.id
		local tail = Instance.new("Attachment")
		tail.Name = "Tail"
		tail.Position = Vector3.new(0, 0, (kit.PrimaryPart :: BasePart).Size.Z / 2)
		tail.Parent = kit.PrimaryPart
		for _, part in kit:GetDescendants() do
			if part:IsA("BasePart") then
				part.CanQuery = false
				part.CastShadow = false
			end
		end
		return kit
	end
	local model = Instance.new("Model")
	model.Name = def.id
	M = model
	local r = root(1, 1, 1)
	r.CFrame = CFrame.new()
	if def.kind == "drone" then
		if def.id == "RAPTOR" then
			axleCyl(4.4, 0.9, CFrame.Angles(0, math.rad(90), 0), def.color)
			plank(5, 0.15, 1.4, CFrame.new(0, 0, 0.6), def.color)
			plank(2, 0.15, 0.7, CFrame.new(0, 0, 2), def.color)
		else
			deltaDrone(CFrame.new(), 1, def.color)
		end
	else
		local len = def.id == "MRBM" and 7 or (def.id == "GLCM" and 4.5 or 6)
		axleCyl(len, 0.9, CFrame.Angles(0, math.rad(90), 0), def.color)
		ball(0.9, 0, 0, -len / 2, def.color)
		for k = 0, 3 do
			plank(0.12, 1.2, 1, CFrame.new(0, 0, len / 2 - 0.5) * CFrame.Angles(0, 0, math.rad(45 + k * 90)) * CFrame.new(0, 0.6, 0), C.darkMetal)
		end
		if def.id == "GLCM" then
			plank(3, 0.1, 0.6, CFrame.new(0, 0, 0.2), def.color)
		end
	end
	local tail = Instance.new("Attachment")
	tail.Name = "Tail"
	tail.Position = Vector3.new(0, 0, 2.6)
	tail.Parent = r
	for _, part in model:GetDescendants() do
		if part:IsA("BasePart") then
			part.CanCollide = false
			part.CanQuery = false
			part.CastShadow = false
		end
	end
	return model
end

function ModelBuilder.fuelTruck(): Model
	local kit = kitWithRoot("fuel_truck", 8, false)
	if kit then
		kit.Name = "FuelTruck"
		for _, part in kit:GetDescendants() do
			if part:IsA("BasePart") then
				part.CanQuery = false
			end
		end
		return kit
	end
	local model = Instance.new("Model")
	model.Name = "FuelTruck"
	M = model
	root(3.4, 3.6, 8)
	blk(3, 2.2, 2.2, 0, 0.8, -2.8, C.white)
	lit(blk(2.6, 0.8, 0.15, 0, 2, -3.92, C.window))
	blk(3, 0.6, 5.6, 0, 0.7, 0.9, C.darkMetal)
	axleCyl(5, 2.6, CFrame.new(0, 2.6, 0.9) * CFrame.Angles(0, math.rad(90), 0), C.white)
	noCollide(blk(3.1, 0.4, 2, 0, 2.4, 0.9, C.orange))
	wheelPair(0, 0.7, -2.8, 3.1, 1.4)
	wheelPair(0, 0.7, 1.4, 3.1, 1.4)
	wheelPair(0, 0.7, 3, 3.1, 1.4)
	for _, part in model:GetDescendants() do
		if part:IsA("BasePart") then
			part.CanCollide = false
			part.CanQuery = false
		end
	end
	return model
end

---------------------------------------------------------------------------
-- Mainland strategic point structures (size in studs)
---------------------------------------------------------------------------
local PointStyles: { [string]: (s: number) -> () } = {}

PointStyles.city = function(s)
	local rng = Random.new(7)
	for i = 1, 22 do
		local x = rng:NextNumber(-s / 2.4, s / 2.4)
		local z = rng:NextNumber(-s / 2.4, s / 2.4)
		local h = rng:NextNumber(5, 22)
		local w = rng:NextNumber(6, 12)
		blk(w, h, w * rng:NextNumber(0.8, 1.4), x, 0, z, i % 3 == 0 and C.wallWarm or C.wallCool)
		blk(w * 0.9, 0.4, w * 0.9, x, h, z, C.roofGrey)
	end
	blk(s * 0.9, 0.2, 5, 0, 0, 0, C.asphalt)
	blk(5, 0.2, s * 0.9, 0, 0, 0, C.asphalt)
end

PointStyles.airport = function(s)
	blk(14, 0.3, s * 1.4, 0, 0, 0, C.asphalt)
	blk(6, 0.3, s * 1.2, 22, 0, 0, C.asphalt)
	for i = -6, 6 do
		noCollide(blk(0.8, 0.1, 6, 0, 0.3, i * s / 10, C.line))
	end
	for i = 0, 4 do
		local z = -s * 0.5 + i * s * 0.25
		blk(14, 7, 12, -26, 0, z, C.wallCool)
		gableRoof(14, 12, -26, 7, z, C.roofGrey, 14)
	end
	cyl(18, 3, -18, 0, s * 0.62, C.white)
	blk(6, 3, 6, -18, 18, s * 0.62, C.glass)
end

PointStyles.oilField = function(s)
	local rng = Random.new(3)
	for _ = 1, 9 do
		local x, z = rng:NextNumber(-s / 2.4, s / 2.4), rng:NextNumber(-s / 2.4, s / 2.4)
		blk(2.4, 0.6, 9, x, 0, z, C.darkMetal)
		blk(0.6, 0.7, 9, x, 5, z, C.orange)
		blk(0.6, 5, 0.6, x, 0, z, C.darkMetal)
	end
	for i = 0, 2 do
		cyl(6, 10, s * 0.35, 0, -s * 0.3 + i * 13, C.white)
	end
end

PointStyles.nuclear = function(s)
	local prev = G
	coolingTower(-s * 0.2, 0, 1.6)
	coolingTower(s * 0.12, -s * 0.1, 1.6)
	cyl(12, 16, s * 0.3, 0, s * 0.25, C.wall)
	ball(16, s * 0.3, 12, s * 0.25, C.wall)
	blk(s * 0.5, 9, 14, -s * 0.05, 0, s * 0.3, C.wallCool)
	local _ = prev
end

PointStyles.port = function(s)
	blk(s, 2, s * 0.35, 0, -1.6, -s * 0.2, C.concrete)
	local rng = Random.new(5)
	local colors = { C.red, C.blue, C.orange, C.olive, C.white }
	for i = 1, 26 do
		local x = rng:NextNumber(-s / 2.3, s / 2.3)
		local z = rng:NextNumber(-s * 0.3, -s * 0.08)
		blk(3, 3, 7, x, 0.4, z, colors[(i % #colors) + 1])
	end
	for i = 0, 2 do
		local x = -s * 0.3 + i * s * 0.3
		blk(1.2, 22, 1.2, x - 3, 0, -s * 0.34, C.orange)
		blk(1.2, 22, 1.2, x + 3, 0, -s * 0.34, C.orange)
		blk(1.2, 1.2, 24, x, 22, -s * 0.34 + 6, C.orange)
	end
end

PointStyles.base = function(s)
	for i = 0, 2 do
		local x = -s * 0.3 + i * s * 0.3
		blk(16, 8, 14, x, 0, -s * 0.15, rgb(150, 154, 132))
		gableRoof(16, 14, x, 8, -s * 0.15, C.oliveDark, 16)
	end
	cyl(0.3, 18, s * 0.25, 0, s * 0.25, C.asphalt)
	cyl(18, 0.6, -s * 0.35, 0, s * 0.3, C.metal)
	-- perimeter wall
	for _, side in { -1, 1 } do
		blk(s, 3, 1, 0, 0, side * s / 2, C.pad)
		blk(1, 3, s, side * s / 2, 0, 0, C.pad)
	end
end

function ModelBuilder.warPoint(style: string, size: number): Model
	local kit = AssetLibrary.instantiate("site_" .. style, { width = size, depth = size })
	if kit then
		kit.Name = style
		return kit
	end
	local model = Instance.new("Model")
	model.Name = style
	M = model
	local prevG = G
	G = 0
	local fn = PointStyles[style] or PointStyles.city
	fn(size)
	G = prevG
	local center = Instance.new("Part")
	center.Name = "Base"
	center.Anchored = true
	center.Size = Vector3.new(size, 0.2, size)
	center.CFrame = CFrame.new(0, -0.1, 0)
	center.Transparency = 1
	center.CanCollide = false
	center.Parent = model
	model.PrimaryPart = center
	return model
end

---------------------------------------------------------------------------
-- States
---------------------------------------------------------------------------
-- Under construction: show the building as a translucent blueprint.
function ModelBuilder.setConstruction(model: Model, on: boolean)
	for _, d in model:GetDescendants() do
		if d:IsA("BasePart") and d.Name ~= "Base" and d.Name ~= "Root" then
			if on then
				if d:GetAttribute("T0") == nil then
					d:SetAttribute("T0", d.Transparency)
					d:SetAttribute("C0", d.CanCollide)
				end
				d.Transparency = math.max(d.Transparency, 0.7)
				d.CanCollide = false
			else
				local t0 = d:GetAttribute("T0")
				if t0 ~= nil then
					d.Transparency = t0 :: number
					d.CanCollide = d:GetAttribute("C0") == true
					d:SetAttribute("T0", nil)
					d:SetAttribute("C0", nil)
				end
			end
		end
	end
end

-- Free-form road segment along local Z (width x len). Round caps at both
-- ends fill the joints, so segments meeting at any angle read as one road.
-- A single tile (len <= width) stays square, like the GRID-mode road tile.
function ModelBuilder.roadSegment(width: number, len: number, seed: number?): Model
	local model = Instance.new("Model")
	model.Name = "road"
	M = model
	local lift = ((seed or 0) % 5) * 0.012 -- overlapping junctions don't z-fight
	local h = 0.3 + lift
	local base = blk(width, h, len, 0, 0, 0, C.asphalt)
	base.Name = "Base"
	model.PrimaryPart = base
	if len > width + 0.01 then
		for _, z in { -len / 2, len / 2 } do
			local cap = cyl(h, width, 0, 0, z, C.asphalt)
			cap.Name = "Cap"
		end
	end
	if len > 3 then
		local lineLen = math.max(len - width, 1)
		local centre = noCollide(blk(0.35, 0.02, lineLen, 0, h, 0, C.line))
		centre.CanQuery = false
		for _, side in { -1, 1 } do
			local edge = noCollide(blk(0.25, 0.02, lineLen, side * (width / 2 - 0.7), h, 0, C.line))
			edge.CanQuery = false
		end
	end
	return model
end

-- Damaged by a strike: scorched colours + smoke until repaired.
function ModelBuilder.setDamaged(model: Model, on: boolean)
	for _, d in model:GetDescendants() do
		if d:IsA("BasePart") and d.Name ~= "Root" then
			if on then
				if d:GetAttribute("Col0") == nil then
					d:SetAttribute("Col0", d.Color)
				end
				d.Color = (d:GetAttribute("Col0") :: Color3):Lerp(Color3.new(0.12, 0.11, 0.1), 0.6)
			else
				local c0 = d:GetAttribute("Col0")
				if c0 ~= nil then
					d.Color = c0 :: Color3
					d:SetAttribute("Col0", nil)
				end
			end
		end
	end
	local base = model.PrimaryPart
	if not base then
		return
	end
	local existing = base:FindFirstChild("DamageSmoke")
	if on and not existing then
		local att = Instance.new("Attachment")
		att.Name = "DamageSmoke"
		att.Position = Vector3.new(0, 4, 0)
		att.Parent = base
		local smoke = Instance.new("ParticleEmitter")
		smoke.Texture = "rbxasset://textures/particles/smoke_main.dds"
		smoke.Color = ColorSequence.new(Color3.fromRGB(60, 60, 60))
		smoke.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 3), NumberSequenceKeypoint.new(1, 9) })
		smoke.Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.4), NumberSequenceKeypoint.new(1, 1) })
		smoke.Lifetime = NumberRange.new(3, 5)
		smoke.Rate = 4
		smoke.Speed = NumberRange.new(4, 7)
		smoke.Parent = att
	elseif not on and existing then
		existing:Destroy()
	end
end

return ModelBuilder
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="19">
        <Properties>
          <string name="Name">Net</string>
          <string name="Source"><![CDATA[--[[
	Net
	Every remote the game uses is declared here. The server creates them on
	boot, the client waits for them. Using a fixed list means a typo is caught
	immediately instead of silently creating a dead remote.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Net = {}

-- Client -> server requests that return a result ({ ok, err, ... }).
Net.Functions = {
	"PlaceBuilding",
	"PlaceMany",
	"PlaceRoad",
	"DeleteBuilding",
	"MoveBuilding",
	"Undo",
	"RepairBuilding",
	"RepairAll",
	"SetFuelDestination",
	"QueueProduction",
	"CancelProduction",
	"StartResearch",
	"LaunchWeapon",
	"SetPvp",
	"CommandUnits",
	"DeployUnits",
	"RecallUnits",
	"ClaimDaily",
	"ClaimPlaytime",
	"ClaimQuest",
	"ClaimGroup",
	"RedeemCode",
	"SetBillboard",
	"SetNation",
	"GetSnapshot",
	"StudioPurchase",
}

-- Server -> client pushes.
Net.Events = {
	"State", -- partial state patch for the local player
	"Notify", -- toast message
	"Projectile", -- a missile / drone launched (all clients)
	"ProjectileEnd", -- impact or interception (all clients)
	"Effect", -- one-shot visual effect
	"PurchaseDone", -- a product / pass purchase was granted
}

local folder: Folder? = nil

local function getFolder(): Folder
	if folder then
		return folder
	end
	local result: Folder
	if RunService:IsServer() then
		local existing = ReplicatedStorage:FindFirstChild("Remotes")
		if existing then
			result = existing :: Folder
		else
			local f = Instance.new("Folder")
			f.Name = "Remotes"
			for _, name in Net.Functions do
				local rf = Instance.new("RemoteFunction")
				rf.Name = name
				rf.Parent = f
			end
			for _, name in Net.Events do
				local re = Instance.new("RemoteEvent")
				re.Name = name
				re.Parent = f
			end
			f.Parent = ReplicatedStorage
			result = f
		end
	else
		result = ReplicatedStorage:WaitForChild("Remotes") :: Folder
	end
	folder = result
	return result
end

function Net.fn(name: string): RemoteFunction
	assert(table.find(Net.Functions, name), "Unknown remote function " .. name)
	return getFolder():WaitForChild(name) :: RemoteFunction
end

function Net.event(name: string): RemoteEvent
	assert(table.find(Net.Events, name), "Unknown remote event " .. name)
	return getFolder():WaitForChild(name) :: RemoteEvent
end

-- Server helper: bind a request handler with per-player rate limiting and
-- error isolation so one bad request can never break the remote.
function Net.handle(name: string, handler: (Player, ...any) -> any, maxPerSecond: number?)
	local remote = Net.fn(name)
	local limit = maxPerSecond or 8
	local buckets: { [Player]: { t: number, n: number } } = {}
	remote.OnServerInvoke = function(player: Player, ...)
		local now = os.clock()
		local b = buckets[player]
		if not b or now - b.t >= 1 then
			b = { t = now, n = 0 }
			buckets[player] = b
		end
		b.n += 1
		if b.n > limit then
			return { ok = false, err = "Slow down!" }
		end
		local ok, result = pcall(handler, player, ...)
		if not ok then
			warn(("[Net] %s failed for %s: %s"):format(name, player.Name, tostring(result)))
			return { ok = false, err = "Something went wrong" }
		end
		return result
	end
	game:GetService("Players").PlayerRemoving:Connect(function(p)
		buckets[p] = nil
	end)
end

-- Client helper: invoke a request safely.
function Net.request(name: string, ...): any
	local ok, result = pcall(Net.fn(name).InvokeServer, Net.fn(name), ...)
	if not ok then
		return { ok = false, err = "Connection problem" }
	end
	return result or { ok = false }
end

return Net
]]></string>
        </Properties>
      </Item>
      <Item class="Folder" referent="20">
        <Properties>
          <string name="Name">Util</string>
        </Properties>
        <Item class="ModuleScript" referent="21">
          <Properties>
            <string name="Name">Ballistics</string>
            <string name="Source"><![CDATA[--[[
	Ballistics
	Deterministic flight paths so the server (interception timing) and every
	client (visuals) agree on where a projectile is at any moment.
]]

local Ballistics = {}

local function smooth(t: number): number
	return t * t * (3 - 2 * t)
end

-- Position at progress alpha (0..1).
function Ballistics.position(from: Vector3, to: Vector3, apex: number, kind: string, alpha: number): Vector3
	alpha = math.clamp(alpha, 0, 1)
	local flat = from:Lerp(to, alpha)
	local height: number
	if kind == "drone" or apex < 60 then
		-- climb quickly, cruise, then dive onto the target
		local climb = math.min(1, alpha / 0.12)
		local dive = alpha > 0.85 and (1 - (alpha - 0.85) / 0.15) or 1
		height = apex * smooth(climb) * smooth(math.clamp(dive, 0, 1))
	else
		height = 4 * apex * alpha * (1 - alpha)
	end
	return flat + Vector3.new(0, height, 0)
end

function Ballistics.cframe(from: Vector3, to: Vector3, apex: number, kind: string, alpha: number): CFrame
	local p0 = Ballistics.position(from, to, apex, kind, alpha)
	local p1 = Ballistics.position(from, to, apex, kind, math.min(1, alpha + 0.01))
	if (p1 - p0).Magnitude < 1e-3 then
		p1 = p0 + (to - from).Unit
	end
	return CFrame.lookAt(p0, p1)
end

return Ballistics
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="22">
          <Properties>
            <string name="Name">Flag</string>
            <string name="Source"><![CDATA[--[[
	Flag
	Nation flags: a pattern, three colours and an emblem, stored compactly
	as "p,c1,c2,c3,e". Drawn with plain Frames so it works in any GUI:
	the HUD badge, the war map, unit tags and SurfaceGuis on flagpoles.
]]

local Flag = {}

local rgb = Color3.fromRGB

Flag.Colors = {
	rgb(232, 232, 226), rgb(28, 30, 34), rgb(210, 52, 46), rgb(38, 92, 196),
	rgb(46, 150, 82), rgb(250, 196, 48), rgb(240, 128, 36), rgb(120, 70, 180),
	rgb(64, 176, 196), rgb(140, 32, 46), rgb(26, 54, 110), rgb(120, 132, 70),
}

Flag.Patterns = { "Tricolour", "Vertical", "Cross", "Quartered", "Canton", "Band" }
Flag.Emblems = { "None", "Disc", "Diamond", "Star", "Ring" }

export type Data = { p: number, c: { number }, e: number }

Flag.Default = { p = 1, c = { 4, 1, 3 }, e = 1 } :: Data

function Flag.encode(d: Data): string
	return ("%d,%d,%d,%d,%d"):format(d.p, d.c[1], d.c[2], d.c[3], d.e)
end

function Flag.decode(s: string?): Data
	if type(s) ~= "string" then
		return Flag.Default
	end
	local p, a, b, c, e = string.match(s, "^(%d+),(%d+),(%d+),(%d+),(%d+)$")
	if not p then
		return Flag.Default
	end
	return Flag.sanitize({ p = tonumber(p) :: number, c = { tonumber(a) :: number, tonumber(b) :: number, tonumber(c) :: number }, e = tonumber(e) :: number })
end

function Flag.sanitize(d: any): Data
	local function clamp(v: any, hi: number, def: number): number
		if type(v) ~= "number" or v ~= v then
			return def
		end
		return math.clamp(math.floor(v), 1, hi)
	end
	if type(d) ~= "table" then
		return Flag.Default
	end
	local c = type(d.c) == "table" and d.c or {}
	return {
		p = clamp(d.p, #Flag.Patterns, 1),
		c = { clamp(c[1], #Flag.Colors, 4), clamp(c[2], #Flag.Colors, 1), clamp(c[3], #Flag.Colors, 3) },
		e = (type(d.e) == "number" and d.e >= 0) and math.clamp(math.floor(d.e), 0, #Flag.Emblems - 1) or 0,
	}
end

local function rect(parent: Instance, x: number, y: number, w: number, h: number, color: Color3, z: number?): Frame
	local f = Instance.new("Frame")
	f.BorderSizePixel = 0
	f.BackgroundColor3 = color
	f.Position = UDim2.fromScale(x, y)
	f.Size = UDim2.fromScale(w, h)
	f.ZIndex = z or 1
	f.Parent = parent
	return f
end

-- Draw the flag inside `parent` (fills it). Returns the container frame.
function Flag.draw(parent: Instance, data: Data | string | nil): Frame
	local d = typeof(data) == "string" and Flag.decode(data :: string) or Flag.sanitize(data or Flag.Default)
	local c1, c2, c3 = Flag.Colors[d.c[1]], Flag.Colors[d.c[2]], Flag.Colors[d.c[3]]
	local holder = Instance.new("Frame")
	holder.Name = "Flag"
	holder.BackgroundColor3 = c1
	holder.BorderSizePixel = 0
	holder.Size = UDim2.fromScale(1, 1)
	holder.ClipsDescendants = true
	holder.Parent = parent
	local p = d.p
	if p == 1 then
		rect(holder, 0, 0, 1, 1 / 3, c1)
		rect(holder, 0, 1 / 3, 1, 1 / 3 + 0.005, c2)
		rect(holder, 0, 2 / 3, 1, 1 / 3, c3)
	elseif p == 2 then
		rect(holder, 0, 0, 1 / 3, 1, c1)
		rect(holder, 1 / 3, 0, 1 / 3 + 0.005, 1, c2)
		rect(holder, 2 / 3, 0, 1 / 3, 1, c3)
	elseif p == 3 then
		rect(holder, 0.28, 0, 0.16, 1, c3)
		rect(holder, 0, 0.4, 1, 0.2, c3)
		rect(holder, 0.31, 0, 0.1, 1, c2, 2)
		rect(holder, 0, 0.44, 1, 0.12, c2, 2)
	elseif p == 4 then
		rect(holder, 0.5, 0, 0.5, 0.5, c2)
		rect(holder, 0, 0.5, 0.5, 0.5, c2)
		rect(holder, 0, 0, 0.5, 0.5, c1)
		rect(holder, 0.5, 0.5, 0.5, 0.5, c3)
	elseif p == 5 then
		rect(holder, 0, 0.7, 1, 0.3, c3)
		rect(holder, 0, 0, 0.45, 0.55, c2, 2)
	else
		rect(holder, 0, 0, 1, 0.12, c3)
		rect(holder, 0, 0.88, 1, 0.12, c3)
		rect(holder, 0, 0.3, 1, 0.4, c2)
	end
	-- emblem
	if d.e > 0 then
		local emColor = (p == 3 or p == 5) and c1 or (d.c[1] == d.c[3] and c2 or c3)
		if p == 1 or p == 2 or p == 6 then
			emColor = (d.c[2] == 1 or d.c[2] == 6) and Flag.Colors[2] or Flag.Colors[1]
		end
		local cx, cy = 0.5, 0.5
		if p == 5 then
			cx, cy = 0.225, 0.275
		elseif p == 3 then
			cx, cy = 0.36, 0.5
		end
		local size = (p == 5) and 0.32 or 0.36
		local e = Instance.new("Frame")
		e.BorderSizePixel = 0
		e.BackgroundColor3 = emColor
		e.AnchorPoint = Vector2.new(0.5, 0.5)
		e.Position = UDim2.fromScale(cx, cy)
		e.Size = UDim2.fromScale(size * 0.66, size)
		e.ZIndex = 3
		e.Parent = holder
		local ar = Instance.new("UIAspectRatioConstraint")
		ar.AspectRatio = 1
		ar.Parent = e
		if d.e == 1 then
			local cr = Instance.new("UICorner")
			cr.CornerRadius = UDim.new(1, 0)
			cr.Parent = e
		elseif d.e == 2 then
			e.Rotation = 45
			e.Size = UDim2.fromScale(size * 0.5, size * 0.75)
		elseif d.e == 3 then
			e.BackgroundTransparency = 1
			local t = Instance.new("TextLabel")
			t.BackgroundTransparency = 1
			t.Size = UDim2.fromScale(1.6, 1.6)
			t.AnchorPoint = Vector2.new(0.5, 0.5)
			t.Position = UDim2.fromScale(0.5, 0.5)
			t.Text = "★"
			t.TextScaled = true
			t.TextColor3 = emColor
			t.ZIndex = 3
			t.Parent = e
		else
			e.BackgroundTransparency = 1
			local cr = Instance.new("UICorner")
			cr.CornerRadius = UDim.new(1, 0)
			cr.Parent = e
			local st = Instance.new("UIStroke")
			st.Color = emColor
			st.Thickness = 3
			st.Parent = e
		end
	end
	return holder
end

return Flag
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="23">
          <Properties>
            <string name="Name">Footprint</string>
            <string name="Source"><![CDATA[--[[
	Footprint
	Rotated rectangles on an island (local studs) for free-form building:
	overlap tests (separating axes), "is it on my land", road reach and a
	spatial hash so a city of hundreds of buildings checks in microseconds.
	Shared so the placement ghost and server validation always agree.
]]

local Config = require(script.Parent.Parent.Config)

local Footprint = {}

-- Centre (x, z), half extents and the yaw's cos/sin. Local X axis = (c, -s),
-- local Z axis = (s, c), matching CFrame.Angles(0, yaw, 0).
export type Rect = { x: number, z: number, hw: number, hd: number, c: number, s: number }

function Footprint.rect(x: number, z: number, w: number, d: number, angle: number): Rect
	local a = math.rad(angle)
	return { x = x, z = z, hw = w / 2, hd = d / 2, c = math.cos(a), s = math.sin(a) }
end

-- Footprint size (studs) of a catalog building; roads use their segment length.
function Footprint.size(def: any, len: number?): (number, number)
	local cell = Config.CellSize
	return def.size[1] * cell, len or def.size[2] * cell
end

function Footprint.corners(r: Rect): { Vector2 }
	local out = {}
	for _, sx in { -1, 1 } do
		for _, sz in { -1, 1 } do
			local lx, lz = sx * r.hw, sz * r.hd
			table.insert(out, Vector2.new(r.x + lx * r.c + lz * r.s, r.z - lx * r.s + lz * r.c))
		end
	end
	return out
end

-- World-axis bounds (local island axes).
function Footprint.bounds(r: Rect): (number, number, number, number)
	local ex = math.abs(r.hw * r.c) + math.abs(r.hd * r.s)
	local ez = math.abs(r.hw * r.s) + math.abs(r.hd * r.c)
	return r.x - ex, r.z - ez, r.x + ex, r.z + ez
end

local function radius(r: Rect, ax: number, az: number): number
	return r.hw * math.abs(r.c * ax - r.s * az) + r.hd * math.abs(r.s * ax + r.c * az)
end

-- True when the rectangles overlap by more than `gap` studs (touching is fine).
function Footprint.overlaps(a: Rect, b: Rect, gap: number?): boolean
	local g = gap or 0.05
	local dx, dz = b.x - a.x, b.z - a.z
	for _, axis in { { a.c, -a.s }, { a.s, a.c }, { b.c, -b.s }, { b.s, b.c } } do
		local ax, az = axis[1], axis[2]
		local dist = math.abs(dx * ax + dz * az)
		if dist >= radius(a, ax, az) + radius(b, ax, az) - g then
			return false
		end
	end
	return true
end

-- Every corner within +-half of the island centre.
function Footprint.inside(r: Rect, half: number): boolean
	local x0, z0, x1, z1 = Footprint.bounds(r)
	return x0 >= -half and z0 >= -half and x1 <= half and z1 <= half
end

-- Grow a rectangle on every side (road reach checks).
function Footprint.grow(r: Rect, by: number): Rect
	return { x = r.x, z = r.z, hw = r.hw + by, hd = r.hd + by, c = r.c, s = r.s }
end

-- Point-in-rectangle (local studs).
function Footprint.contains(r: Rect, x: number, z: number, pad: number?): boolean
	local dx, dz = x - r.x, z - r.z
	local lx = dx * r.c - dz * r.s
	local lz = dx * r.s + dz * r.c
	local p = pad or 0
	return math.abs(lx) <= r.hw + p and math.abs(lz) <= r.hd + p
end

-- A road segment from A to B: centre, yaw (local Z runs A -> B) and length.
function Footprint.segment(ax: number, az: number, bx: number, bz: number): (number, number, number, number)
	local dx, dz = bx - ax, bz - az
	local len = math.sqrt(dx * dx + dz * dz)
	local angle = math.deg(math.atan2(dx, dz)) % 360
	return (ax + bx) / 2, (az + bz) / 2, angle, len
end

-- A road segment's rectangle including its round end caps (half a width
-- past each end), used when checking buildings against roads. Single tiles
-- (no longer than they are wide) are square and have no caps.
function Footprint.capped(r: Rect): Rect
	if r.hd <= r.hw + 0.005 then
		return r
	end
	return { x = r.x, z = r.z, hw = r.hw, hd = r.hd + r.hw, c = r.c, s = r.s }
end

-- Endpoints of a segment rectangle (along its local Z).
function Footprint.ends(r: Rect): (Vector2, Vector2)
	local ox, oz = r.hd * r.s, r.hd * r.c
	return Vector2.new(r.x - ox, r.z - oz), Vector2.new(r.x + ox, r.z + oz)
end

---------------------------------------------------------------------------
-- Spatial hash: bucket -> set of ids
---------------------------------------------------------------------------
local BUCKET = 32

export type Hash = { [number]: { [number]: boolean } }

local function keysFor(r: Rect, pad: number): { number }
	local x0, z0, x1, z1 = Footprint.bounds(r)
	local out = {}
	for bx = math.floor((x0 - pad) / BUCKET), math.floor((x1 + pad) / BUCKET) do
		for bz = math.floor((z0 - pad) / BUCKET), math.floor((z1 + pad) / BUCKET) do
			table.insert(out, (bx + 512) * 1024 + (bz + 512))
		end
	end
	return out
end

function Footprint.hashAdd(h: Hash, id: number, r: Rect)
	for _, k in keysFor(r, 0) do
		local set = h[k]
		if not set then
			set = {}
			h[k] = set
		end
		set[id] = true
	end
end

function Footprint.hashRemove(h: Hash, id: number, r: Rect)
	for _, k in keysFor(r, 0) do
		local set = h[k]
		if set then
			set[id] = nil
			if next(set) == nil then
				h[k] = nil
			end
		end
	end
end

-- Ids whose buckets touch `r` grown by `pad` (candidates; test them exactly).
function Footprint.hashQuery(h: Hash, r: Rect, pad: number?): { [number]: boolean }
	local out = {}
	for _, k in keysFor(r, pad or 0) do
		local set = h[k]
		if set then
			for id in set do
				out[id] = true
			end
		end
	end
	return out
end

return Footprint
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="24">
          <Properties>
            <string name="Name">Format</string>
            <string name="Source"><![CDATA[--[[
	Format
	Number / time formatting helpers shared by client UI and server messages.
]]

local Format = {}

local SUFFIXES = { "", "k", "M", "B", "T", "Qd", "Qn" }

-- 1234 -> "1.2k", 24100000 -> "24.1M"
function Format.short(n: number): string
	local negative = n < 0
	n = math.abs(n)
	local index = 1
	while n >= 1000 and index < #SUFFIXES do
		n /= 1000
		index += 1
	end
	local text
	if index == 1 then
		text = tostring(math.floor(n + 0.5))
	elseif n >= 100 then
		text = string.format("%d%s", math.floor(n), SUFFIXES[index])
	else
		text = string.format("%.1f%s", math.floor(n * 10) / 10, SUFFIXES[index])
		text = text:gsub("%.0" .. SUFFIXES[index] .. "$", SUFFIXES[index])
	end
	return (negative and "-" or "") .. text
end

function Format.cash(n: number): string
	if n < 0 then
		return "-$" .. Format.short(-n)
	end
	return "$" .. Format.short(n)
end

-- 12000 -> "12,000"
function Format.commas(n: number): string
	local s = tostring(math.floor(math.abs(n) + 0.5))
	local formatted = s:reverse():gsub("(%d%d%d)", "%1,"):reverse()
	if formatted:sub(1, 1) == "," then
		formatted = formatted:sub(2)
	end
	return (n < 0 and "-" or "") .. formatted
end

function Format.money(n: number): string
	return "$" .. Format.commas(n)
end

-- 83 -> "01:23"
function Format.clock(seconds: number): string
	seconds = math.max(0, math.floor(seconds))
	local h = seconds // 3600
	local m = (seconds % 3600) // 60
	local s = seconds % 60
	if h > 0 then
		return string.format("%d:%02d:%02d", h, m, s)
	end
	return string.format("%02d:%02d", m, s)
end

-- 48 -> "48s", 130 -> "2m 10s"
function Format.duration(seconds: number): string
	seconds = math.max(0, math.floor(seconds))
	if seconds < 60 then
		return seconds .. "s"
	elseif seconds < 3600 then
		local s = seconds % 60
		return (seconds // 60) .. "m" .. (s > 0 and (" " .. s .. "s") or "")
	end
	local m = (seconds % 3600) // 60
	return (seconds // 3600) .. "h" .. (m > 0 and (" " .. m .. "m") or "")
end

function Format.rate(n: number): string
	local sign = n >= 0 and "+" or ""
	return sign .. Format.short(n) .. " / Min"
end

function Format.percent(n: number): string
	return math.floor(n + 0.5) .. "%"
end

return Format
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="25">
          <Properties>
            <string name="Name">Grid</string>
            <string name="Source"><![CDATA[--[[
	Grid
	World layout shared by client and server:

	  * the central battlefield (round continent at Config.MainlandOrigin)
	  * eight nation islands on a ring around it, each rotated so its front
	    edge (local -Z) faces the centre
	  * a bridge from every island's front edge to the battlefield

	Buildings are stored in island-local studs (x, z) plus a yaw in degrees,
	so placement is free-form; Grid only converts between spaces and answers
	"where is this point?" questions.
]]

local Config = require(script.Parent.Parent.Config)

local Grid = {}

Grid.CellSize = Config.CellSize
Grid.PlotSize = Config.PlotSize
Grid.Rim = 34 -- sand beach around each island

local CENTER = Config.MainlandOrigin
local RING = Config.PlotRingRadius
local frames: { [number]: CFrame } = {}

-- Yaw of island `index` around the centre (radians).
function Grid.plotAngle(index: number): number
	return (index - 1) * math.pi / 4
end

-- Unit vector from the centre towards island `index`.
function Grid.direction(index: number): Vector3
	local a = Grid.plotAngle(index)
	return Vector3.new(math.sin(a), 0, math.cos(a))
end

function Grid.plotOrigin(index: number): Vector3
	return CENTER + Grid.direction(index) * RING
end

-- Island frame: origin at its centre, LookVector (-Z) pointing at the battlefield.
function Grid.plotCFrame(index: number): CFrame
	local cf = frames[index]
	if not cf then
		cf = CFrame.new(Grid.plotOrigin(index)) * CFrame.Angles(0, Grid.plotAngle(index), 0)
		frames[index] = cf
	end
	return cf
end

-- Island-local (x, z, yaw degrees) -> world CFrame at ground level.
function Grid.toWorld(index: number, x: number, z: number, angle: number?): CFrame
	return Grid.plotCFrame(index) * CFrame.new(x, 0, z) * CFrame.Angles(0, math.rad(angle or 0), 0)
end

-- World position -> island-local position (Y is kept as-is).
function Grid.toLocal(index: number, world: Vector3): Vector3
	return Grid.plotCFrame(index):PointToObjectSpace(world)
end

-- World yaw (degrees) -> island-local yaw.
function Grid.localYaw(index: number, worldYaw: number): number
	return (worldYaw - math.deg(Grid.plotAngle(index))) % 360
end

function Grid.insidePlot(index: number, pos: Vector3, margin: number?): boolean
	local l = Grid.toLocal(index, pos)
	local half = Grid.PlotSize / 2 + (margin or 0)
	return math.abs(l.X) <= half and math.abs(l.Z) <= half
end

-- Which island contains `pos` (the beach counts when margin is given)?
function Grid.plotAt(pos: Vector3, margin: number?): number?
	for i = 1, Config.MaxPlots do
		if Grid.insidePlot(i, pos, margin) then
			return i
		end
	end
	return nil
end

-- Island end of the bridge (outer edge of the beach, centre of the front).
function Grid.gate(index: number): Vector3
	return (Grid.plotCFrame(index) * CFrame.new(0, 0, -(Grid.PlotSize / 2 + Grid.Rim))).Position
end

-- Inside the front edge of the island: where vehicles gather before crossing.
function Grid.yard(index: number): Vector3
	return (Grid.plotCFrame(index) * CFrame.new(0, 0, -(Grid.PlotSize / 2 - 26))).Position
end

-- Battlefield end of the bridge (on the shore).
function Grid.shore(index: number): Vector3
	return CENTER + Grid.direction(index) * Config.MainlandRadius
end

-- Staging area just inland from the bridge on the battlefield.
function Grid.landing(index: number): Vector3
	return CENTER + Grid.direction(index) * (Config.MainlandRadius - 90)
end

local function flat(p: Vector3): Vector3
	return Vector3.new(p.X, 0, p.Z)
end

function Grid.inMainland(pos: Vector3, margin: number?): boolean
	return (flat(pos) - flat(CENTER)).Magnitude <= Config.MainlandRadius + (margin or 0)
end

-- Index of the bridge whose deck contains `pos`.
function Grid.bridgeAt(pos: Vector3): number?
	local p = flat(pos)
	for i = 1, Config.MaxPlots do
		local a, b = flat(Grid.shore(i)), flat(Grid.gate(i))
		local ab = b - a
		local t = (p - a):Dot(ab) / ab:Dot(ab)
		if t >= -0.05 and t <= 1.05 then
			local closest = a + ab * math.clamp(t, 0, 1)
			if (p - closest).Magnitude <= Config.BridgeWidth / 2 + 4 then
				return i
			end
		end
	end
	return nil
end

-- "plot" (index), "bridge" (index), "mainland" or "sea".
function Grid.zoneAt(pos: Vector3): (string, number?)
	local plot = Grid.plotAt(pos, 2)
	if plot then
		return "plot", plot
	end
	if Grid.inMainland(pos) then
		return "mainland", nil
	end
	local bridge = Grid.bridgeAt(pos)
	if bridge then
		return "bridge", bridge
	end
	local beach = Grid.plotAt(pos, Grid.Rim)
	if beach then
		return "plot", beach
	end
	return "sea", nil
end

-- GRID snap: put a footprint's edges on the cell grid (quarter-turn yaws).
function Grid.snapLocal(x: number, z: number, w: number, d: number, angle: number): (number, number)
	local quarter = math.floor(angle / 90 + 0.5) % 2
	local fw, fd = w, d
	if quarter == 1 then
		fw, fd = d, w
	end
	local cell = Grid.CellSize
	local function snap(v: number, size: number): number
		local min = math.floor((v - size / 2) / cell + 0.5) * cell
		return min + size / 2
	end
	return snap(x, fw), snap(z, fd)
end

return Grid
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="26">
          <Properties>
            <string name="Name">Rank</string>
            <string name="Source"><![CDATA[--[[
	Rank
	Nation power score and the rank ladder (Outpost -> Superpower).
	Shared so the server awards ranks and the client can show what's next.
]]

local Config = require(script.Parent.Parent.Config)

local Rank = {}

export type Input = { pop: number, buildingValue: number, researched: number, units: number, points: number }
export type Info = { level: number, name: string, power: number, progress: number, next: string?, nextPower: number? }

function Rank.power(i: Input): number
	return math.floor(i.pop + i.buildingValue / 100 + i.researched * 150 + i.units * 80 + i.points * 600)
end

function Rank.of(power: number): Info
	local ranks = Config.Ranks
	local level = 1
	for i, r in ranks do
		if power >= r.power then
			level = i
		end
	end
	local cur, nxt = ranks[level], ranks[level + 1]
	local progress = 1
	if nxt then
		progress = math.clamp((power - cur.power) / (nxt.power - cur.power), 0, 1)
	end
	return {
		level = level,
		name = cur.name,
		power = power,
		progress = progress,
		next = nxt and nxt.name,
		nextPower = nxt and nxt.power,
	}
end

return Rank
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="27">
          <Properties>
            <string name="Name">Unlocks</string>
            <string name="Source"><![CDATA[--[[
	Unlocks
	One place that answers "can this player use X?" for buildings, weapons and
	units, used by the build menu (locked badges) and the server (validation).
]]

local Unlocks = {}

export type Access = {
	researched: { [string]: boolean },
	passes: { [string]: boolean },
}

-- Returns ok, reason
function Unlocks.check(def: { research: string?, pass: string? }, access: Access): (boolean, string?)
	if def.pass and not access.passes[def.pass] then
		return false, "Requires pass"
	end
	if def.research and not access.researched[def.research] then
		return false, "Research needed"
	end
	return true, nil
end

return Unlocks
]]></string>
          </Properties>
        </Item>
      </Item>
    </Item>
  </Item>
  <Item class="ServerScriptService" referent="28">
    <Properties>
      <string name="Name">ServerScriptService</string>
    </Properties>
    <Item class="Folder" referent="29">
      <Properties>
        <string name="Name">Server</string>
      </Properties>
      <Item class="Script" referent="30">
        <Properties>
          <string name="Name">Main</string>
          <token name="RunContext">0</token>
          <string name="Source"><![CDATA[--[[
	Forge & Frontline - server bootstrap.
	Initialises every service, then creates a runtime Nation for each player
	once their data has loaded, and tears it down (after saving) on leave.
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage.Shared.Config)
local Net = require(ReplicatedStorage.Shared.Net)

local Services = script.Parent.Services
local Nations = require(Services.Nations)

local S = {
	DataService = require(Services.DataService),
	PlotService = require(Services.PlotService),
	StateService = require(Services.StateService),
	BuildService = require(Services.BuildService),
	EconomyService = require(Services.EconomyService),
	LogisticsService = require(Services.LogisticsService),
	ProductionService = require(Services.ProductionService),
	ResearchService = require(Services.ResearchService),
	UnitService = require(Services.UnitService),
	ConquestService = require(Services.ConquestService),
	CombatService = require(Services.CombatService),
	MonetizationService = require(Services.MonetizationService),
	RewardService = require(Services.RewardService),
	NationService = require(Services.NationService),
	WorldService = require(Services.WorldService),
}

local ORDER = {
	"DataService",
	"PlotService",
	"StateService",
	"BuildService",
	"EconomyService",
	"LogisticsService",
	"ProductionService",
	"ResearchService",
	"UnitService",
	"ConquestService",
	"CombatService",
	"MonetizationService",
	"RewardService",
	"NationService",
	"WorldService",
}

-- Make sure every remote exists before any client asks for it.
for _, name in Net.Functions do
	Net.fn(name)
end

for _, name in ORDER do
	S[name].init(S)
end

local function setupLeaderstats(player: Player)
	local stats = Instance.new("Folder")
	stats.Name = "leaderstats"
	local cash = Instance.new("StringValue")
	cash.Name = "Cash"
	cash.Value = "$0"
	cash.Parent = stats
	local pop = Instance.new("StringValue")
	pop.Name = "Population"
	pop.Value = "0"
	pop.Parent = stats
	local power = Instance.new("IntValue")
	power.Name = "Power"
	power.Parent = stats
	stats.Parent = player
end

local Format = require(ReplicatedStorage.Shared.Util.Format)

local function updateLeaderstats(n: Nations.Nation)
	local ls = n.player:FindFirstChild("leaderstats")
	if ls then
		local cash = ls:FindFirstChild("Cash") :: StringValue?
		local pop = ls:FindFirstChild("Population") :: StringValue?
		if cash then
			cash.Value = Format.cash(n.data.Cash)
		end
		if pop then
			pop.Value = Format.short(n.data.Population)
		end
		local power = ls:FindFirstChild("Power") :: IntValue?
		if power and n.stats.rank then
			power.Value = n.stats.rank.power
		end
	end
end

local function onLoaded(player: Player, data: { [string]: any })
	local plot = S.PlotService.claim(player)
	if not plot then
		player:Kick("This server is full. Please join another server.")
		return
	end
	local now = Nations.now()
	local n: Nations.Nation = {
		player = player,
		userId = player.UserId,
		data = data,
		plotIndex = plot.index,
		origin = plot.origin,
		frame = plot.frame,
		folder = plot.buildings,
		buildings = {},
		grid = {},
		stats = {},
		passes = {},
		premium = false,
		joinAt = now,
		nextPayAt = now + Config.PayInterval,
		giftAt = now + Config.PlaytimeGiftInterval,
		pvpLockUntil = 0,
		shieldUntil = data.FirstJoin + Config.NewPlayerShield,
		undo = {},
		units = {},
		nextUnitUid = 1,
		sent = {},
		ready = false,
	}
	Nations.add(n)
	if player.Character then
		player.Character:PivotTo(S.PlotService.spawnCFrame(plot.index))
	end
	player:SetAttribute("Pvp", data.Pvp)
	player:SetAttribute("NationColor", Config.NationColors[plot.index])
	S.MonetizationService.loadPasses(n)
	S.BuildService.loadNation(n)
	if not player.Parent then
		if S.PlotService.get(player) == nil then
			n.folder:ClearAllChildren()
		end
		return
	end
	S.EconomyService.compute(n, 0)
	S.UnitService.loadNation(n)
	S.RewardService.onJoin(n)
	S.NationService.onJoin(n)
	n.ready = true
	S.StateService.push(n, true)
	updateLeaderstats(n)
end

S.DataService.beforeSave(function(player, _data)
	local n = Nations.get(player)
	if n and n.ready then
		S.BuildService.serialize(n)
		S.UnitService.serialize(n)
	end
end)

for _, name in ORDER do
	S[name].start()
end

Players.PlayerAdded:Connect(setupLeaderstats)
for _, p in Players:GetPlayers() do
	setupLeaderstats(p)
end

S.DataService.onLoaded(onLoaded)

Players.PlayerRemoving:Connect(function(player)
	-- serialize + save first (runs synchronously up to the first yield)
	S.DataService.release(player)
	local n = Nations.get(player)
	if n then
		n.ready = false
		S.UnitService.clearNation(n)
		Nations.remove(player)
	end
	S.PlotService.release(player)
end)

-- Leaderboard refresh
task.spawn(function()
	while true do
		task.wait(5)
		for _, n in Nations.all() do
			if n.ready then
				updateLeaderstats(n)
			end
		end
	end
end)

print(("[%s] server ready"):format(Config.GameName))
]]></string>
        </Properties>
      </Item>
      <Item class="Folder" referent="31">
        <Properties>
          <string name="Name">Services</string>
        </Properties>
        <Item class="ModuleScript" referent="32">
          <Properties>
            <string name="Name">BuildService</string>
            <string name="Source"><![CDATA[--[[
	BuildService
	Server-authoritative free-form placement. Buildings sit anywhere on your
	island at any angle (island-local studs + yaw), roads are drawn as
	segments of any length and direction, and every request is validated
	against footprint overlap (Footprint SAT + spatial hash), your land,
	cash, research, passes and limits. Owns building runtime objects, their
	models, construction timers, road access, undo, move and repair.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TextService = game:GetService("TextService")

local Shared = ReplicatedStorage.Shared
local Config = require(Shared.Config)
local Grid = require(Shared.Util.Grid)
local Footprint = require(Shared.Util.Footprint)
local Unlocks = require(Shared.Util.Unlocks)
local Buildings = require(Shared.Catalog.Buildings)
local ModelBuilder = require(Shared.ModelBuilder)
local Net = require(Shared.Net)
local Nations = require(script.Parent.Nations)

type Nation = Nations.Nation
type BRuntime = Nations.BRuntime

local BuildService = {}
local S: { [string]: any }

local HALF = Grid.PlotSize / 2 - 0.5 -- buildable half-extent on an island
local ROAD_REACH = 3 -- a building within this many studs of a road is connected

---------------------------------------------------------------------------
-- Footprints
---------------------------------------------------------------------------
local function isRoadDef(def): boolean
	return def.id == "road" or def.id == "plaza"
end
BuildService.isRoadDef = isRoadDef

-- Segment roads stretch; everything else uses its catalog footprint.
local function isSegment(def): boolean
	return def.id == "road"
end

local function rectFor(def, x: number, z: number, angle: number, len: number?): Footprint.Rect
	local w, d = Footprint.size(def, len)
	return Footprint.rect(x, z, w, d, angle)
end

local function rectOf(b: BRuntime): Footprint.Rect
	return rectFor(b.def, b.x, b.z, b.r, b.len)
end

-- Price of a placement (roads are charged per tile of length).
local function costFor(def, len: number?): number
	if len and isSegment(def) then
		return def.cost * math.max(1, math.ceil(len / (def.size[2] * Config.CellSize) - 0.01))
	end
	return def.cost
end

local function finite(v: any): boolean
	return typeof(v) == "number" and v == v and math.abs(v) < 1e4
end

local function cleanAngle(a: any): number
	if not finite(a) then
		return 0
	end
	return (math.floor(a * 2 + 0.5) / 2) % 360
end

local function cleanPos(v: number): number
	return math.floor(v * 20 + 0.5) / 20
end

function BuildService.canPlace(n: Nation, def, x: number, z: number, angle: number, len: number?, ignoreUid: number?): (boolean, string?)
	if not finite(x) or not finite(z) or not finite(angle) then
		return false, "Invalid position"
	end
	local rect = rectFor(def, x, z, angle, len)
	if not Footprint.inside(rect, HALF) then
		return false, "Outside your land"
	end
	local ground = isRoadDef(def)
	-- a road's round end caps count against buildings
	local mine = isSegment(def) and Footprint.capped(rect) or rect
	for uid in Footprint.hashQuery(n.grid, mine) do
		local other = n.buildings[uid]
		if other and uid ~= ignoreUid and not (ground and isRoadDef(other.def)) then
			local theirs = rectOf(other)
			if isSegment(other.def) then
				theirs = Footprint.capped(theirs)
			end
			if Footprint.overlaps(mine, theirs) then
				return false, (isRoadDef(other.def) and not ground) and "Can't build on a road" or "Space is taken"
			end
		end
	end
	return true, nil
end

local function connectedAt(n: Nation, b: BRuntime): boolean
	if not b.def.needsRoad or isRoadDef(b.def) then
		return true
	end
	local reach = Footprint.grow(rectOf(b), ROAD_REACH)
	for uid in Footprint.hashQuery(n.grid, reach) do
		local other = n.buildings[uid]
		if other and other ~= b and isRoadDef(other.def) and other.finishAt == nil then
			if Footprint.overlaps(reach, rectOf(other), 0) then
				return true
			end
		end
	end
	return false
end

function BuildService.recomputeRoads(n: Nation)
	for _, b in n.buildings do
		b.connected = connectedAt(n, b)
		if b.model then
			b.model:SetAttribute("Connected", b.connected)
		end
	end
end

---------------------------------------------------------------------------
-- Models
---------------------------------------------------------------------------
local function applyBillboard(n: Nation, b: BRuntime)
	if not b.def.billboard or not b.model then
		return
	end
	local text = n.data.Billboard ~= "" and n.data.Billboard or (n.player.DisplayName .. " WAS HERE")
	for _, d in b.model:GetDescendants() do
		if d:IsA("TextLabel") and d.Name == "Message" then
			d.Text = text
		end
	end
end

function BuildService.worldCFrame(n: Nation, b: BRuntime): CFrame
	return Grid.toWorld(n.plotIndex, b.x, b.z, b.r)
end

local function spawnModel(n: Nation, b: BRuntime)
	if b.model then
		b.model:Destroy()
	end
	local model
	if isSegment(b.def) and b.len then
		model = ModelBuilder.roadSegment(b.def.size[1] * Config.CellSize, b.len, b.uid)
	else
		model = ModelBuilder.building(b.def)
	end
	model.Name = tostring(b.uid)
	model:PivotTo(BuildService.worldCFrame(n, b))
	-- placement data for the client ghost / move tool
	model:SetAttribute("PX", b.x)
	model:SetAttribute("PZ", b.z)
	model:SetAttribute("Angle", b.r)
	model:SetAttribute("Len", b.len)
	model:SetAttribute("Uid", b.uid)
	model:SetAttribute("BuildingId", b.id)
	model:SetAttribute("OwnerId", n.userId)
	model:SetAttribute("MaxHp", b.def.hp)
	model:SetAttribute("Hp", b.hp)
	model:SetAttribute("Connected", b.connected)
	if b.finishAt then
		model:SetAttribute("BuildStart", b.startAt or Nations.now())
		model:SetAttribute("FinishAt", b.finishAt)
		model:SetAttribute("Status", "Under Construction")
		ModelBuilder.setConstruction(model, true)
	end
	if b.damaged then
		model:SetAttribute("Damaged", true)
		ModelBuilder.setDamaged(model, true)
	end
	model.Parent = n.folder
	b.model = model
	applyBillboard(n, b)
end

---------------------------------------------------------------------------
-- Runtime creation
---------------------------------------------------------------------------
local function newRuntime(n: Nation, def, x: number, z: number, r: number, len: number?, uid: number?): BRuntime
	local id = uid
	if not id then
		id = n.data.NextUid
		n.data.NextUid += 1
	end
	local b: BRuntime = {
		uid = id :: number,
		id = def.id,
		def = def,
		x = x,
		z = z,
		r = r,
		len = len,
		cost = costFor(def, len),
		model = nil,
		finishAt = nil,
		startAt = nil,
		damaged = false,
		hp = def.hp,
		oil = 0,
		fuel = 0,
		incoming = 0,
		dest = 0,
		trucks = {},
		queue = {},
		reloadUntil = 0,
		connected = true,
		eff = 1,
		status = "",
	}
	if def.refine then
		for _ = 1, def.refine.trucks do
			table.insert(b.trucks, { state = "idle", target = 0, amount = 0, arriveAt = 0, returnAt = 0 })
		end
	end
	return b
end

local function insert(n: Nation, b: BRuntime)
	n.buildings[b.uid] = b
	Footprint.hashAdd(n.grid, b.uid, rectOf(b))
end

local function unindex(n: Nation, b: BRuntime)
	Footprint.hashRemove(n.grid, b.uid, rectOf(b))
end

local function countBuildings(n: Nation): number
	local c = 0
	for _ in n.buildings do
		c += 1
	end
	return c
end

function BuildService.access(n: Nation): Unlocks.Access
	return { researched = n.data.Researched, passes = n.passes }
end

-- Core placement used by requests and undo.
local function placeInternal(n: Nation, def, x: number, z: number, r: number, len: number?, charge: boolean): (boolean, string?, BRuntime?)
	local ok, err = BuildService.canPlace(n, def, x, z, r, len)
	if not ok then
		return false, err, nil
	end
	if def.max and Nations.countAll(n, def.id) >= def.max then
		return false, ("Limit reached (max %d)"):format(def.max), nil
	end
	if countBuildings(n) >= Config.MaxBuildings then
		return false, ("Your nation is at the %d building limit"):format(Config.MaxBuildings), nil
	end
	local cost = costFor(def, len)
	if charge then
		if n.data.Cash < cost then
			return false, "Not enough cash", nil
		end
		n.data.Cash -= cost
	end
	local b = newRuntime(n, def, x, z, r, len)
	local time = def.buildTime / Nations.speed(n)
	if time > 0 then
		b.startAt = Nations.now()
		b.finishAt = b.startAt + time
	end
	insert(n, b)
	b.connected = connectedAt(n, b)
	spawnModel(n, b)
	if isRoadDef(def) and not b.finishAt then
		BuildService.recomputeRoads(n)
	end
	return true, nil, b
end

local function pushUndo(n: Nation, action: { [string]: any })
	action.t = Nations.now()
	table.insert(n.undo, action)
	if #n.undo > 25 then
		table.remove(n.undo, 1)
	end
end

local function removeInternal(n: Nation, b: BRuntime)
	unindex(n, b)
	n.buildings[b.uid] = nil
	if b.model then
		b.model:Destroy()
		b.model = nil
	end
	-- refund queued production
	for _, item in b.queue do
		local cat = item.kind == "unit" and S.ProductionService.unitDef(item.id) or S.ProductionService.weaponDef(item.id)
		if cat then
			n.data.Cash += cat.cost
		end
	end
	if isRoadDef(b.def) then
		BuildService.recomputeRoads(n)
	end
end

function BuildService.completeConstruction(n: Nation, b: BRuntime)
	b.finishAt = nil
	b.startAt = nil
	if b.model then
		ModelBuilder.setConstruction(b.model, false)
		b.model:SetAttribute("FinishAt", nil)
		b.model:SetAttribute("BuildStart", nil)
	end
	if isRoadDef(b.def) then
		BuildService.recomputeRoads(n)
	end
	Net.event("Effect"):FireClient(n.player, "BuildDone", b.model and b.model:GetPivot().Position or n.origin, b.def.name)
end

function BuildService.setDamaged(n: Nation, b: BRuntime, on: boolean)
	b.damaged = on
	if on then
		b.hp = 0
	else
		b.hp = b.def.hp
	end
	if b.model then
		b.model:SetAttribute("Damaged", on or nil)
		b.model:SetAttribute("Hp", b.hp)
		ModelBuilder.setDamaged(b.model, on)
	end
	local _ = n
end

-- Apply strike damage; returns damage actually dealt.
function BuildService.damage(n: Nation, b: BRuntime, amount: number): number
	if b.damaged or isRoadDef(b.def) then
		return 0
	end
	local dealt = math.min(b.hp, amount)
	b.hp -= dealt
	if b.model then
		b.model:SetAttribute("Hp", b.hp)
	end
	if b.hp <= 0 then
		BuildService.setDamaged(n, b, true)
		-- stored resources are lost when a building is knocked out
		b.fuel = 0
		b.oil = 0
	end
	return dealt
end

---------------------------------------------------------------------------
-- Load / save
---------------------------------------------------------------------------
-- Old saves stored grid cells (min corner on a 100-cell plot) and quarter
-- turns; convert them to island-local studs + degrees.
local OLD_CELLS = 100

local function migrate(def, s): (number, number, number)
	local r = s.r or 0
	local fw, fd = def.size[1], def.size[2]
	if r % 2 == 1 then
		fw, fd = fd, fw
	end
	local cell = Config.CellSize
	return (s.x + fw / 2 - OLD_CELLS / 2) * cell, (s.z + fd / 2 - OLD_CELLS / 2) * cell, (r % 4) * 90
end

function BuildService.loadNation(n: Nation)
	for _, s in n.data.Buildings do
		local def = Buildings.get(s.id)
		if def and finite(s.x) and finite(s.z) then
			local x, z, r, len
			if s.a ~= nil then
				x, z, r, len = s.x, s.z, cleanAngle(s.a), s.L
			else
				x, z, r = migrate(def, s)
				len = isSegment(def) and def.size[2] * Config.CellSize or nil
			end
			if BuildService.canPlace(n, def, x, z, r, len) then
				local b = newRuntime(n, def, x, z, r, len, s.u)
				b.finishAt = s.f
				b.startAt = s.st
				b.damaged = s.d == true
				b.hp = b.damaged and 0 or math.clamp(s.hp or def.hp, 1, def.hp)
				b.oil = s.o or 0
				b.fuel = s.fu or 0
				b.dest = s.de or 0
				if s.q then
					for _, q in s.q do
						table.insert(b.queue, { id = q.id, kind = q.k, progress = q.p or 0, started = q.s == true })
					end
				end
				insert(n, b)
				if (s.u or 0) >= n.data.NextUid then
					n.data.NextUid = s.u + 1
				end
			end
		end
	end
	BuildService.recomputeRoads(n)
	-- spawn models gradually so a huge city doesn't hitch the server
	local count = 0
	for _, b in n.buildings do
		if not n.player.Parent then
			return
		end
		spawnModel(n, b)
		count += 1
		if count % 40 == 0 then
			task.wait()
		end
	end
end

function BuildService.serialize(n: Nation)
	local out = {}
	for _, b in n.buildings do
		local q = nil
		if #b.queue > 0 then
			q = {}
			for _, item in b.queue do
				table.insert(q, { id = item.id, k = item.kind, p = item.progress, s = item.started })
			end
		end
		local fuel = b.fuel
		-- fuel on the road is returned to the refinery when saving
		for _, t in b.trucks do
			if t.state ~= "idle" and t.state ~= "back" then
				fuel += t.amount
			end
		end
		table.insert(out, {
			u = b.uid,
			id = b.id,
			x = b.x,
			z = b.z,
			a = b.r,
			L = b.len,
			f = b.finishAt,
			st = b.startAt,
			d = b.damaged or nil,
			hp = (b.hp < b.def.hp and not b.damaged) and math.floor(b.hp) or nil,
			o = b.oil > 0 and math.floor(b.oil) or nil,
			fu = fuel > 0 and math.floor(fuel) or nil,
			de = b.dest ~= 0 and b.dest or nil,
			q = q,
		})
	end
	n.data.Buildings = out
end

---------------------------------------------------------------------------
-- Tick (called by the simulation loop)
---------------------------------------------------------------------------
function BuildService.tick(n: Nation, now: number)
	for _, b in n.buildings do
		if b.finishAt and now >= b.finishAt then
			BuildService.completeConstruction(n, b)
		end
	end
end

function BuildService.finishAll(n: Nation)
	for _, b in n.buildings do
		if b.finishAt then
			BuildService.completeConstruction(n, b)
		end
	end
end

function BuildService.repairAll(n: Nation, free: boolean): (number, number)
	local count, cost = 0, 0
	for _, b in n.buildings do
		if b.damaged then
			local price = math.floor(b.cost * Config.RepairCostRate)
			if free or n.data.Cash >= price then
				if not free then
					n.data.Cash -= price
					cost += price
				end
				BuildService.setDamaged(n, b, false)
				count += 1
			end
		end
	end
	return count, cost
end

---------------------------------------------------------------------------
-- Requests
---------------------------------------------------------------------------
local function nationOf(player: Player): Nation?
	local n = Nations.get(player)
	if n and n.ready then
		return n
	end
	return nil
end

local function requireDef(n: Nation, id: any): (any, string?)
	if typeof(id) ~= "string" then
		return nil, "Unknown building"
	end
	local def = Buildings.get(id)
	if not def then
		return nil, "Unknown building"
	end
	local ok, reason = Unlocks.check(def, BuildService.access(n))
	if not ok then
		return nil, reason
	end
	return def, nil
end

-- x, z: island-local studs (footprint centre); a: yaw in degrees.
local function onPlace(player: Player, id: any, x: any, z: any, a: any)
	local n = nationOf(player)
	if not n then
		return { ok = false, err = "Loading..." }
	end
	local def, err = requireDef(n, id)
	if not def then
		return { ok = false, err = err }
	end
	if not finite(x) or not finite(z) then
		return { ok = false, err = "Invalid position" }
	end
	local len = isSegment(def) and def.size[2] * Config.CellSize or nil
	local ok, perr, b = placeInternal(n, def, cleanPos(x), cleanPos(z), cleanAngle(a), len, true)
	if not ok or not b then
		return { ok = false, err = perr }
	end
	pushUndo(n, { kind = "place", uid = b.uid })
	S.StateService.push(n)
	return { ok = true, uid = b.uid }
end

-- A row of the same building (drag tool): spots = { {x, z}, ... }.
local function onPlaceMany(player: Player, id: any, spots: any, a: any)
	local n = nationOf(player)
	if not n then
		return { ok = false, err = "Loading..." }
	end
	local def, err = requireDef(n, id)
	if not def then
		return { ok = false, err = err }
	end
	if typeof(spots) ~= "table" then
		return { ok = false, err = "Invalid request" }
	end
	local angle = cleanAngle(a)
	local len = isSegment(def) and def.size[2] * Config.CellSize or nil
	local placed = 0
	local lastErr: string? = nil
	local uids = {}
	for i, spot in spots do
		if i > 120 then
			break
		end
		if typeof(spot) == "table" and finite(spot[1]) and finite(spot[2]) then
			local ok, perr, b = placeInternal(n, def, cleanPos(spot[1]), cleanPos(spot[2]), angle, len, true)
			if ok and b then
				placed += 1
				table.insert(uids, b.uid)
			else
				lastErr = perr
				if perr == "Not enough cash" then
					break
				end
			end
		end
	end
	if placed > 0 then
		pushUndo(n, { kind = "placeMany", uids = uids })
		BuildService.recomputeRoads(n)
		S.StateService.push(n)
	end
	return { ok = placed > 0, placed = placed, err = placed == 0 and lastErr or nil }
end

-- Draw a road from A to B (island-local studs), any length and direction.
local function onPlaceRoad(player: Player, id: any, ax: any, az: any, bx: any, bz: any)
	local n = nationOf(player)
	if not n then
		return { ok = false, err = "Loading..." }
	end
	local def, err = requireDef(n, id)
	if not def then
		return { ok = false, err = err }
	end
	if not isSegment(def) then
		return { ok = false, err = "Only roads can be drawn" }
	end
	if not (finite(ax) and finite(az) and finite(bx) and finite(bz)) then
		return { ok = false, err = "Invalid position" }
	end
	local x, z, angle, len = Footprint.segment(ax, az, bx, bz)
	if len < 2 then
		return { ok = false, err = "Drag further to draw a road" }
	end
	if len > Config.RoadMaxLength then
		return { ok = false, err = ("Roads are drawn in pieces up to %d studs"):format(Config.RoadMaxLength) }
	end
	local ok, perr, b = placeInternal(n, def, cleanPos(x), cleanPos(z), cleanAngle(angle), math.floor(len * 10 + 0.5) / 10, true)
	if not ok or not b then
		return { ok = false, err = perr }
	end
	pushUndo(n, { kind = "place", uid = b.uid })
	S.StateService.push(n)
	return { ok = true, uid = b.uid, cost = b.cost }
end

local function refundFor(b: BRuntime): number
	if b.finishAt then
		return b.cost
	elseif b.damaged then
		return math.floor(b.cost * Config.SellRefund * 0.5)
	end
	return math.floor(b.cost * Config.SellRefund)
end

local function onDelete(player: Player, uid: any)
	local n = nationOf(player)
	if not n or typeof(uid) ~= "number" then
		return { ok = false, err = "Invalid request" }
	end
	local b = n.buildings[uid]
	if not b then
		return { ok = false, err = "Building not found" }
	end
	local refund = refundFor(b)
	n.data.Cash += refund
	pushUndo(n, { kind = "delete", id = b.id, x = b.x, z = b.z, r = b.r, len = b.len, refund = refund, wasBuilt = b.finishAt == nil })
	removeInternal(n, b)
	S.StateService.push(n)
	return { ok = true, refund = refund }
end

local function relocate(n: Nation, b: BRuntime, x: number, z: number, r: number)
	unindex(n, b)
	b.x, b.z, b.r = x, z, r
	insert(n, b)
	if b.model then
		b.model:PivotTo(BuildService.worldCFrame(n, b))
		b.model:SetAttribute("PX", b.x)
		b.model:SetAttribute("PZ", b.z)
		b.model:SetAttribute("Angle", b.r)
	end
	BuildService.recomputeRoads(n)
end

local function onMove(player: Player, uid: any, x: any, z: any, a: any)
	local n = nationOf(player)
	if not n or typeof(uid) ~= "number" or not finite(x) or not finite(z) then
		return { ok = false, err = "Invalid request" }
	end
	local b = n.buildings[uid]
	if not b then
		return { ok = false, err = "Building not found" }
	end
	local nx, nz, nr = cleanPos(x), cleanPos(z), cleanAngle(a)
	local ok, err = BuildService.canPlace(n, b.def, nx, nz, nr, b.len, b.uid)
	if not ok then
		return { ok = false, err = err }
	end
	pushUndo(n, { kind = "move", uid = b.uid, x = b.x, z = b.z, r = b.r })
	relocate(n, b, nx, nz, nr)
	return { ok = true }
end

local function onUndo(player: Player)
	local n = nationOf(player)
	if not n then
		return { ok = false }
	end
	local action = table.remove(n.undo)
	if not action then
		return { ok = false, err = "Nothing to undo" }
	end
	if Nations.now() - action.t > Config.UndoWindow then
		table.clear(n.undo)
		return { ok = false, err = "Too late to undo" }
	end
	if action.kind == "place" or action.kind == "placeMany" then
		local uids = action.uids or { action.uid }
		for _, uid in uids do
			local b = n.buildings[uid]
			if b then
				n.data.Cash += b.cost
				removeInternal(n, b)
			end
		end
	elseif action.kind == "delete" then
		local def = Buildings.get(action.id)
		if def then
			if n.data.Cash < action.refund then
				return { ok = false, err = "Not enough cash" }
			end
			local ok, err, b = placeInternal(n, def, action.x, action.z, action.r, action.len, false)
			if not ok or not b then
				return { ok = false, err = err }
			end
			n.data.Cash -= action.refund
			if action.wasBuilt then
				-- it was finished before: put it back finished
				BuildService.completeConstruction(n, b)
			end
		end
	elseif action.kind == "move" then
		local b = n.buildings[action.uid]
		if b and BuildService.canPlace(n, b.def, action.x, action.z, action.r, b.len, b.uid) then
			relocate(n, b, action.x, action.z, action.r)
		end
	end
	S.StateService.push(n)
	return { ok = true }
end

local function onRepair(player: Player, uid: any)
	local n = nationOf(player)
	if not n or typeof(uid) ~= "number" then
		return { ok = false, err = "Invalid request" }
	end
	local b = n.buildings[uid]
	if not b or not b.damaged then
		return { ok = false, err = "Nothing to repair" }
	end
	local price = math.floor(b.cost * Config.RepairCostRate)
	if n.data.Cash < price then
		return { ok = false, err = "Not enough cash" }
	end
	n.data.Cash -= price
	BuildService.setDamaged(n, b, false)
	S.StateService.push(n)
	return { ok = true }
end

local function onRepairAll(player: Player)
	local n = nationOf(player)
	if not n then
		return { ok = false }
	end
	local count, cost = BuildService.repairAll(n, false)
	S.StateService.push(n)
	if count == 0 then
		return { ok = false, err = "Nothing to repair (or not enough cash)" }
	end
	return { ok = true, count = count, cost = cost }
end

local function onSetBillboard(player: Player, text: any)
	local n = nationOf(player)
	if not n or typeof(text) ~= "string" then
		return { ok = false }
	end
	if not n.passes.Billboard then
		return { ok = false, err = "Requires the Billboard pass" }
	end
	text = string.sub(text, 1, 40)
	local ok, filtered = pcall(function()
		local result = TextService:FilterStringAsync(text, player.UserId, Enum.TextFilterContext.PublicChat)
		return result:GetNonChatStringForBroadcastAsync()
	end)
	if not ok then
		return { ok = false, err = "Could not filter text, try again" }
	end
	n.data.Billboard = filtered
	for _, b in n.buildings do
		applyBillboard(n, b)
	end
	return { ok = true, text = filtered }
end

function BuildService.init(services)
	S = services
end

function BuildService.start()
	Net.handle("PlaceBuilding", onPlace, 12)
	Net.handle("PlaceMany", onPlaceMany, 4)
	Net.handle("PlaceRoad", onPlaceRoad, 12)
	Net.handle("DeleteBuilding", onDelete, 12)
	Net.handle("MoveBuilding", onMove, 8)
	Net.handle("Undo", onUndo, 6)
	Net.handle("RepairBuilding", onRepair, 8)
	Net.handle("RepairAll", onRepairAll, 2)
	Net.handle("SetBillboard", onSetBillboard, 1)
end

return BuildService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="33">
          <Properties>
            <string name="Name">CombatService</string>
            <string name="Source"><![CDATA[--[[
	CombatService
	Missile / drone strikes, air-defense interception, damage and PvP rules.

	A strike is resolved deterministically at launch: the server picks the
	launcher, rolls every air defense covering the target, and broadcasts one
	"Projectile" event with the full flight description. All clients animate
	the same flight (Ballistics module) and the server applies the result
	when the flight time elapses.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage.Shared
local Config = require(Shared.Config)
local Format = require(Shared.Util.Format)
local Net = require(Shared.Net)
local Unlocks = require(Shared.Util.Unlocks)
local Weapons = require(Shared.Catalog.Weapons)
local Nations = require(script.Parent.Nations)

type Nation = Nations.Nation
type BRuntime = Nations.BRuntime

local CombatService = {}
local S: { [string]: any }
local nextId = 0

local function flatDist(a: Vector3, b: Vector3): number
	return Vector2.new(a.X - b.X, a.Z - b.Z).Magnitude
end

function CombatService.isShielded(n: Nation): boolean
	return os.time() < n.shieldUntil
end

-- Launchers of a family: total, ready count, the first ready one, next ready time.
function CombatService.launcherState(n: Nation, family: string, now: number): (number, number, BRuntime?, number)
	local total, ready, first, nextReady = 0, 0, nil, math.huge
	for _, b in n.buildings do
		if b.def.launcher == family and Nations.isActive(b) then
			total += 1
			if b.reloadUntil <= now then
				ready += 1
				first = first or b
			else
				nextReady = math.min(nextReady, b.reloadUntil)
			end
		end
	end
	return total, ready, first, nextReady
end

local function radarBonus(n: Nation): number
	for _, b in n.buildings do
		if b.def.radar and Nations.isActive(b) then
			return b.def.radar
		end
	end
	return 0
end

-- Air defenses (buildings of `defender`) that can engage a strike on `target`.
local function defensesFor(defender: Nation, target: Vector3, arrival: number): { BRuntime }
	local out = {}
	local bonus = 1 + radarBonus(defender)
	for _, b in defender.buildings do
		local ad = b.def.airDefense
		if ad and Nations.isActive(b) and b.eff > 0.3 and b.reloadUntil <= arrival then
			local pos = S.BuildService.worldCFrame(defender, b).Position
			if flatDist(pos, target) <= ad.range * bonus then
				table.insert(out, b)
			end
		end
	end
	table.sort(out, function(a, c)
		return a.def.airDefense.chance > c.def.airDefense.chance
	end)
	return out
end

local function classifyTarget(attacker: Nation, target: Vector3): (string?, Nation?, string?)
	if S.UnitService.inMainland(target) then
		return "mainland", nil, nil
	end
	local owner = S.PlotService.ownerAt(target)
	if not owner then
		return nil, nil, "Pick a target on the mainland or an enemy nation"
	end
	if owner == attacker.player then
		return nil, nil, "You can't strike your own nation"
	end
	local defender = Nations.get(owner)
	if not defender or not defender.ready then
		return nil, nil, "That nation isn't ready"
	end
	if not attacker.data.Pvp then
		return nil, nil, "Turn PvP ON to attack other nations"
	end
	if not defender.data.Pvp then
		return nil, nil, owner.DisplayName .. " has PvP OFF"
	end
	if CombatService.isShielded(defender) then
		return nil, nil, owner.DisplayName .. " is protected by the new-nation shield"
	end
	return "nation", defender, nil
end

local function impact(attacker: Nation, weapon, target: Vector3, defender: Nation?, kind: string): (number, number)
	local dealtTotal, value = 0, 0
	local cluster = weapon.id == "CLUSTER"
	local function falloff(d: number): number
		if cluster then
			return 1
		end
		return 1 - 0.5 * math.clamp(d / weapon.radius, 0, 1)
	end

	if kind == "nation" and defender then
		local damagedNames = {}
		for _, b in defender.buildings do
			local center = S.BuildService.worldCFrame(defender, b).Position
			local halfSize = math.min(b.def.size[1], b.def.size[2]) * Config.CellSize / 2
			local d = math.max(0, flatDist(center, target) - halfSize)
			if d <= weapon.radius then
				local wasDamaged = b.damaged
				local dealt = S.BuildService.damage(defender, b, weapon.damage * falloff(d))
				if dealt > 0 then
					dealtTotal += dealt
					value += b.def.cost * (dealt / b.def.hp)
					if b.damaged and not wasDamaged then
						table.insert(damagedNames, b.def.name)
					end
				end
			end
		end
		for _, u in S.UnitService.unitsNear(target, weapon.radius, attacker.userId) do
			if u.n == defender then
				dealtTotal += weapon.damage
				S.UnitService.damage(u, weapon.damage, attacker)
			end
		end
		if dealtTotal > 0 then
			local msg = ("%s's %s hit your nation"):format(attacker.player.DisplayName, weapon.short)
			if #damagedNames > 0 then
				msg ..= (" — %s knocked out"):format(table.concat(damagedNames, ", ", 1, math.min(3, #damagedNames)))
			end
			Nations.notify(defender.player, msg, "bad")
		end
	else
		for _, u in S.UnitService.unitsNear(target, weapon.radius, attacker.userId) do
			dealtTotal += weapon.damage
			S.UnitService.damage(u, weapon.damage * falloff(flatDist(u.root.CFrame.Position, target)), attacker)
		end
		local point = S.ConquestService.pointNear(target, weapon.radius)
		if point then
			-- warheads are very effective against garrisons
			dealtTotal += S.ConquestService.damageGarrison(point, weapon.damage * 2.5, attacker)
		end
	end
	return dealtTotal, value
end

local function launch(attacker: Nation, weaponId: string, target: Vector3): (boolean, string?)
	local weapon = Weapons.get(weaponId)
	if not weapon then
		return false, "Unknown weapon"
	end
	local ok, reason = Unlocks.check(weapon, S.BuildService.access(attacker))
	if not ok then
		return false, reason
	end
	local stock = attacker.data.Inventory[weaponId] or 0
	if stock <= 0 then
		return false, "No " .. weapon.short .. " in stock - build some in a military factory"
	end
	local now = Nations.now()
	local total, _, launcher, nextReady = CombatService.launcherState(attacker, weapon.family, now)
	if total == 0 then
		return false, "Build a launcher for " .. weapon.short
	end
	if not launcher then
		return false, ("All %s launchers reloading (%ds)"):format(weapon.short, math.ceil(nextReady - now))
	end
	local kind, defender, err = classifyTarget(attacker, target)
	if not kind then
		return false, err
	end

	-- commit
	attacker.data.Inventory[weaponId] = stock - 1
	launcher.reloadUntil = now + (launcher.def.reload or 20)
	if launcher.model then
		launcher.model:SetAttribute("ReloadUntil", launcher.reloadUntil)
	end
	attacker.data.Stats.Launches += 1
	if kind == "nation" then
		attacker.pvpLockUntil = now + Config.PvpToggleCooldown
		attacker.shieldUntil = 0 -- attacking ends your own new-nation shield
	end

	local from = S.BuildService.worldCFrame(attacker, launcher).Position + Vector3.new(0, 8, 0)
	local target0 = Vector3.new(target.X, 0, target.Z)
	local dist = flatDist(from, target0)
	local flight = weapon.flight * math.clamp(dist / 1600, 0.7, 1.5)
	local apex = weapon.apex * math.clamp(dist / 1600, 0.6, 1.4)
	if weapon.apex < 60 then
		apex = weapon.apex
	end

	-- interception
	local interceptAt: number? = nil
	local interceptFrom: Vector3? = nil
	local interceptorName: string? = nil
	local arrival = now + flight * Config.InterceptAt
	if defender then
		for _, ad in defensesFor(defender, target0, arrival) do
			ad.reloadUntil = arrival + ad.def.airDefense.reload
			if math.random() < ad.def.airDefense.chance * weapon.interceptMod then
				interceptAt = Config.InterceptAt
				interceptFrom = S.BuildService.worldCFrame(defender, ad).Position + Vector3.new(0, 5, 0)
				interceptorName = ad.def.name
				break
			end
		end
	else
		for _, u in S.UnitService.unitsNear(target0, 140, attacker.userId) do
			if u.def.antiAir and math.random() < u.def.antiAir * weapon.interceptMod then
				interceptAt = Config.InterceptAt
				interceptFrom = u.root.CFrame.Position + Vector3.new(0, 3, 0)
				interceptorName = u.def.name
				break
			end
		end
	end

	nextId += 1
	local id = nextId
	Net.event("Projectile"):FireAllClients({
		id = id,
		w = weaponId,
		from = from,
		to = target0,
		t0 = now,
		flight = flight,
		apex = apex,
		kind = weapon.kind,
		ic = interceptAt,
		icFrom = interceptFrom,
		owner = attacker.userId,
	})

	local resolveIn = flight * (interceptAt or 1)
	task.delay(resolveIn, function()
		if interceptAt then
			Net.event("ProjectileEnd"):FireAllClients({ id = id, intercepted = true })
			if attacker.player.Parent then
				Nations.notify(attacker.player, ("Your %s was intercepted by a %s"):format(weapon.short, interceptorName or "defense"), "bad")
			end
			if defender and defender.player.Parent then
				Nations.notify(defender.player, ("Your %s intercepted %s's %s"):format(interceptorName or "defense", attacker.player.DisplayName, weapon.short), "good")
			end
			return
		end
		local stillDefender = defender
		if defender and not defender.player.Parent then
			stillDefender = nil
		end
		local dealt, value = 0, 0
		if attacker.player.Parent then
			dealt, value = impact(attacker, weapon, target0, stillDefender, kind)
		end
		Net.event("ProjectileEnd"):FireAllClients({ id = id, intercepted = false, hit = dealt > 0, pos = target0, w = weaponId })
		if dealt > 0 and attacker.player.Parent then
			attacker.data.Stats.Hits += 1
			local loot = math.floor(value * Config.StrikeLootRate)
			attacker.data.Cash += loot
			Nations.notify(attacker.player, ("Direct hit!%s"):format(loot > 0 and (" +" .. Format.cash(loot) .. " war spoils") or ""), "good")
			S.StateService.push(attacker)
		end
	end)
	return true, nil
end

local function onLaunch(player: Player, weaponId: any, target: any)
	local n = Nations.get(player)
	if not n or not n.ready or typeof(weaponId) ~= "string" or typeof(target) ~= "Vector3" then
		return { ok = false, err = "Invalid request" }
	end
	if target.X ~= target.X or math.abs(target.X) > 1e5 or math.abs(target.Z) > 1e5 then
		return { ok = false, err = "Invalid target" }
	end
	local ok, err = launch(n, weaponId, target)
	S.StateService.push(n)
	return { ok = ok, err = err }
end

local function onSetPvp(player: Player, on: any)
	local n = Nations.get(player)
	if not n or typeof(on) ~= "boolean" then
		return { ok = false }
	end
	if not on and Nations.now() < n.pvpLockUntil then
		return { ok = false, err = ("You attacked recently. PvP stays ON for %ds"):format(math.ceil(n.pvpLockUntil - Nations.now())) }
	end
	n.data.Pvp = on
	player:SetAttribute("Pvp", on)
	S.StateService.push(n)
	return { ok = true }
end

function CombatService.init(services)
	S = services
end

function CombatService.start()
	Net.handle("LaunchWeapon", onLaunch, 6)
	Net.handle("SetPvp", onSetPvp, 2)
end

return CombatService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="34">
          <Properties>
            <string name="Name">ConquestService</string>
            <string name="Source"><![CDATA[--[[
	ConquestService
	Generates the central battlefield (a round continent in the middle of the
	map with hills, dirt roads, forests, strategic points and a staging pad
	where every nation's bridge lands) and runs the capture loop:

	  * Each point has a garrison. Enemy units in range shoot it down, missile
	    strikes knock big chunks off it, and it regenerates when left alone.
	  * At zero garrison, a single nation's units inside the ring capture it
	    (contested if the owner or a third nation is present).
	  * Owned points pay their bonus (cash, oil, power, steel, RP) every tick.
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage.Shared
local Config = require(Shared.Config)
local WarMap = require(Shared.Catalog.WarMap)
local ModelBuilder = require(Shared.ModelBuilder)
local AssetLibrary = require(Shared.AssetLibrary)
local Grid = require(Shared.Util.Grid)
local Nations = require(script.Parent.Nations)

type Nation = Nations.Nation

export type Point = {
	def: any,
	center: Vector3,
	model: Model,
	ring: BasePart,
	owner: number,
	garrison: number,
	capture: number,
	capturer: number,
}

local ConquestService = {}
local S: { [string]: any }
local points: { Point } = {}

local ORIGIN = Config.MainlandOrigin
local RADIUS = Config.MainlandRadius
local NEUTRAL = Color3.fromRGB(200, 200, 196)

local function part(parent: Instance, size: Vector3, cf: CFrame, color: Color3, material: Enum.Material?): Part
	local p = Instance.new("Part")
	p.Anchored = true
	p.Size = size
	p.CFrame = cf
	p.Color = color
	p.Material = material or Enum.Material.SmoothPlastic
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	p.CanTouch = false
	p.Parent = parent
	return p
end

---------------------------------------------------------------------------
-- World generation
---------------------------------------------------------------------------
local function disc(world: Folder, name: string, radius: number, y: number, thick: number, color: Color3, material: Enum.Material): Part
	local p = part(world, Vector3.new(thick, radius * 2, radius * 2), CFrame.new(ORIGIN + Vector3.new(0, y, 0)) * CFrame.Angles(0, 0, math.rad(90)), color, material)
	p.Shape = Enum.PartType.Cylinder
	p.Name = name
	return p
end

local function buildGround(world: Folder)
	disc(world, "Ground", RADIUS - 40, -3, 6, Color3.fromRGB(86, 110, 60), Enum.Material.Grass)
	disc(world, "Beach", RADIUS, -3.6, 6, Color3.fromRGB(206, 184, 136), Enum.Material.Sand)
end

-- Is this offset near one of the bridge lanes (landing -> capital)?
local function nearLane(v: Vector3, width: number): boolean
	for i = 1, Config.MaxPlots do
		local dir = Grid.direction(i)
		local along = v:Dot(dir)
		if along > 0 then
			local side = (v - dir * along).Magnitude
			if side < width then
				return true
			end
		end
	end
	return false
end

local function buildHills(world: Folder)
	local rng = Random.new(42)
	local greens = { Color3.fromRGB(72, 96, 52), Color3.fromRGB(96, 118, 62), Color3.fromRGB(118, 128, 70), Color3.fromRGB(84, 104, 56) }
	local placed = 0
	for _ = 1, 400 do
		if placed >= 56 then
			break
		end
		-- hills ring the shore between the bridge lanes so the middle stays open
		local a = rng:NextNumber(0, math.pi * 2)
		local r = rng:NextNumber(RADIUS - 300, RADIUS - 110)
		local v = Vector3.new(math.sin(a) * r, 0, math.cos(a) * r)
		if not nearLane(v, 150) then
			placed += 1
			local size = Vector3.new(rng:NextNumber(60, 170), rng:NextNumber(30, 80), rng:NextNumber(60, 170))
			local cf = CFrame.new(ORIGIN + v + Vector3.new(0, -size.Y * 0.25, 0))
				* CFrame.Angles(rng:NextNumber(-0.5, 0.5), rng:NextNumber(0, math.pi), rng:NextNumber(-0.5, 0.5))
			local hill = part(world, size, cf, greens[rng:NextInteger(1, #greens)])
			hill.Name = "Hill"
			hill.CanQuery = false
		end
	end
end

local function buildRoad(world: Folder, a: Vector3, b: Vector3, bend: number)
	local mid = (a + b) / 2
	local dir = (b - a)
	local perp = Vector3.new(-dir.Z, 0, dir.X).Unit
	local ctrl = mid + perp * bend
	local segments = 14
	local prev = a
	for i = 1, segments do
		local t = i / segments
		local p = a * (1 - t) ^ 2 + ctrl * (2 * (1 - t) * t) + b * t ^ 2
		local len = (p - prev).Magnitude
		if len > 0.5 then
			local cf = CFrame.lookAt((prev + p) / 2, p) + Vector3.new(0, 0.05, 0)
			local seg = part(world, Vector3.new(9, 0.2, len + 4), cf, Color3.fromRGB(112, 78, 52))
			seg.Name = "Road"
			seg.CanCollide = false
		end
		prev = p
	end
end

local function buildTrees(world: Folder)
	local rng = Random.new(9)
	for _ = 1, 40 do
		local a = rng:NextNumber(0, math.pi * 2)
		local r = rng:NextNumber(220, RADIUS - 120)
		local v = Vector3.new(math.sin(a) * r, 0, math.cos(a) * r)
		local c = ORIGIN + v
		local tooClose = nearLane(v, 90)
		for _, def in WarMap do
			if ((ORIGIN + def.offset) - c).Magnitude < 160 then
				tooClose = true
				break
			end
		end
		if not tooClose then
			for _ = 1, rng:NextInteger(5, 10) do
				local p = c + Vector3.new(rng:NextNumber(-40, 40), 0, rng:NextNumber(-40, 40))
				local s = rng:NextNumber(0.8, 1.5)
				-- Blender kit trees when imported, simple part trees otherwise
				local kit = AssetLibrary.instantiate("prop_tree_" .. rng:NextInteger(1, 6), { length = 8 * s })
				if kit then
					kit:PivotTo(CFrame.new(p) * CFrame.Angles(0, rng:NextNumber(0, math.pi * 2), 0))
					for _, d in kit:GetDescendants() do
						if d:IsA("BasePart") then
							d.CanCollide = false
							d.CanQuery = false
						end
					end
					kit.Parent = world
				else
					part(world, Vector3.new(1, 5 * s, 1), CFrame.new(p + Vector3.new(0, 2.5 * s, 0)), Color3.fromRGB(96, 74, 52)).CanCollide = false
					local canopy = part(world, Vector3.new(7 * s, 7 * s, 7 * s), CFrame.new(p + Vector3.new(0, 7 * s, 0)), Color3.fromRGB(62, 96, 50))
					canopy.Shape = Enum.PartType.Ball
					canopy.CanCollide = false
				end
			end
		end
	end
end

-- Staging pad where each nation's bridge lands, with its colours flying.
local function buildStaging(world: Folder)
	for i = 1, Config.MaxPlots do
		local pos = Grid.landing(i)
		local cf = CFrame.lookAt(pos, ORIGIN) -- -Z faces the capital
		local pad = part(world, Vector3.new(90, 0.4, 70), cf * CFrame.new(0, 0.2, 0), Color3.fromRGB(176, 176, 168), Enum.Material.Concrete)
		pad.Name = "Staging_" .. i
		pad.CanCollide = false
		for _, side in { -1, 1 } do
			part(world, Vector3.new(0.6, 14, 0.6), cf * CFrame.new(side * 40, 7, 30), Color3.fromRGB(80, 84, 90))
			local flag = part(world, Vector3.new(7, 4, 0.2), cf * CFrame.new(side * 40 + 3.5, 12, 30), Config.NationColors[i])
			flag.Name = "Flag"
		end
		-- sandbag berm around the back of the pad
		for k = -2, 2 do
			part(world, Vector3.new(16, 2.4, 3), cf * CFrame.new(k * 17, 1.2, 38), Color3.fromRGB(160, 146, 108), Enum.Material.Fabric).Name = "Sandbags"
		end
	end
end

local function buildPoint(world: Folder, def): Point
	local center = ORIGIN + def.offset
	local model = ModelBuilder.warPoint(def.model, 130)
	model.Name = def.id
	model:PivotTo(CFrame.new(center))
	local ring = Instance.new("Part")
	ring.Name = "Ring"
	ring.Shape = Enum.PartType.Cylinder
	ring.Anchored = true
	ring.CanCollide = false
	ring.CanQuery = false
	ring.Size = Vector3.new(0.3, Config.CaptureRadius * 2, Config.CaptureRadius * 2)
	ring.CFrame = CFrame.new(center + Vector3.new(0, 0.1, 0)) * CFrame.Angles(0, 0, math.rad(90))
	ring.Color = NEUTRAL
	ring.Transparency = 0.75
	ring.Material = Enum.Material.SmoothPlastic
	ring.Parent = model
	model:SetAttribute("PointId", def.id)
	model:SetAttribute("PointName", def.name)
	model:SetAttribute("Bonus", def.bonusText)
	model:SetAttribute("MaxGarrison", def.garrison)
	model:SetAttribute("Garrison", def.garrison)
	model:SetAttribute("Capture", 0)
	model:SetAttribute("Owner", 0)
	model:SetAttribute("OwnerName", "")
	model.Parent = world
	return {
		def = def,
		center = center,
		model = model,
		ring = ring,
		owner = 0,
		garrison = def.garrison,
		capture = 0,
		capturer = 0,
	}
end

---------------------------------------------------------------------------
-- Queries used by other services
---------------------------------------------------------------------------
local function flatDist(a: Vector3, b: Vector3): number
	return Vector2.new(a.X - b.X, a.Z - b.Z).Magnitude
end

function ConquestService.points(): { Point }
	return points
end

function ConquestService.enemyPointInRange(pos: Vector3, range: number, userId: number): Point?
	for _, p in points do
		if p.owner ~= userId and p.garrison > 0 and flatDist(pos, p.center) <= range + Config.CaptureRadius then
			return p
		end
	end
	return nil
end

function ConquestService.pointNear(pos: Vector3, extra: number): Point?
	for _, p in points do
		if flatDist(pos, p.center) <= Config.CaptureRadius + extra then
			return p
		end
	end
	return nil
end

function ConquestService.damageGarrison(p: Point, amount: number, attacker: Nation?): number
	if attacker and p.owner == attacker.userId then
		return 0
	end
	local dealt = math.min(p.garrison, amount)
	p.garrison -= dealt
	p.model:SetAttribute("Garrison", math.floor(p.garrison))
	return dealt
end

function ConquestService.bonusFor(n: Nation): { income: number, oil: number, power: number, steel: number, rp: number }
	local b = { income = 0, oil = 0, power = 0, steel = 0, rp = 0 }
	for _, p in points do
		if p.owner == n.userId then
			for k, v in p.def.bonus do
				b[k] += v
			end
		end
	end
	return b
end

local function setOwner(p: Point, userId: number)
	local old = p.owner
	p.owner = userId
	p.capture = 0
	p.capturer = 0
	local n = userId ~= 0 and Nations.byUserId(userId) or nil
	p.model:SetAttribute("Owner", userId)
	p.model:SetAttribute("OwnerName", n and n.player.DisplayName or "")
	p.ring.Color = n and (Config.NationColors[n.plotIndex] or NEUTRAL) or NEUTRAL
	p.model:SetAttribute("Color", p.ring.Color)
	if n then
		p.garrison = p.def.garrison * 0.3
		n.data.Stats.Captures += 1
		Nations.notifyAll(("%s captured the %s!"):format(n.player.DisplayName, p.def.name), "war")
	end
	local oldNation = old ~= 0 and Nations.byUserId(old) or nil
	if oldNation and old ~= userId then
		Nations.notify(oldNation.player, ("You lost the %s"):format(p.def.name), "bad")
	end
end

function ConquestService.releaseOwner(userId: number)
	for _, p in points do
		if p.owner == userId then
			setOwner(p, 0)
			p.garrison = p.def.garrison * 0.5
		end
		if p.capturer == userId then
			p.capture = 0
			p.capturer = 0
		end
	end
end

---------------------------------------------------------------------------
-- Capture loop
---------------------------------------------------------------------------
local function step(dt: number)
	local units = S.UnitService.mainlandUnits()
	for _, p in points do
		local occupants: { [number]: { power: number, units: { any } } } = {}
		for _, u in units do
			if flatDist(u.root.CFrame.Position, p.center) <= Config.CaptureRadius then
				local o = occupants[u.n.userId]
				if not o then
					o = { power = 0, units = {} }
					occupants[u.n.userId] = o
				end
				o.power += u.def.capture
				table.insert(o.units, u)
			end
		end
		local enemyIds = {}
		for userId in occupants do
			if userId ~= p.owner then
				table.insert(enemyIds, userId)
			end
		end
		local ownerPresent = p.owner ~= 0 and occupants[p.owner] ~= nil

		if #enemyIds == 0 then
			p.garrison = math.min(p.def.garrison, p.garrison + Config.GarrisonRegen * dt)
			p.capture = math.max(0, p.capture - 5 * dt)
			if p.capture == 0 then
				p.capturer = 0
			end
		else
			-- the garrison fights back
			if p.garrison > 0 then
				local dps = 6 + p.def.garrison * 0.012
				local target = occupants[enemyIds[1]].units[1]
				if target then
					S.UnitService.damage(target, dps * dt, nil)
				end
			end
			if p.garrison <= 0 and not ownerPresent and #enemyIds == 1 then
				local id = enemyIds[1]
				if p.capturer ~= id then
					p.capturer = id
					p.capture = 0
				end
				p.capture += occupants[id].power * dt
				if p.capture >= Config.CaptureTime then
					setOwner(p, id)
				end
			end
		end
		p.model:SetAttribute("Garrison", math.floor(p.garrison))
		p.model:SetAttribute("Capture", math.floor(p.capture / Config.CaptureTime * 100))
		p.model:SetAttribute("Capturer", p.capturer)
		p.model:SetAttribute("Contested", #enemyIds > 0 and (ownerPresent or #enemyIds > 1))
	end
end

-- exposed for automated tests
ConquestService._step = step

function ConquestService.init(services)
	S = services
	local world = Instance.new("Folder")
	world.Name = "Mainland"
	world.Parent = workspace
	buildGround(world)
	buildHills(world)
	local capital = ORIGIN
	for i, def in WarMap do
		if def.id ~= "capital" then
			buildRoad(world, capital, ORIGIN + def.offset, (i % 2 == 0 and 1 or -1) * 90)
		end
	end
	for i = 1, Config.MaxPlots do
		-- every bridge feeds a dirt road to the capital
		buildRoad(world, Grid.shore(i), capital, (i % 2 == 0 and 1 or -1) * 40)
	end
	buildTrees(world)
	buildStaging(world)
	local pointsFolder = Instance.new("Folder")
	pointsFolder.Name = "Points"
	pointsFolder.Parent = world
	for _, def in WarMap do
		table.insert(points, buildPoint(pointsFolder, def))
	end
end

function ConquestService.start()
	task.spawn(function()
		while true do
			task.wait(1)
			local ok, err = pcall(step, 1)
			if not ok then
				warn("[Conquest] step failed: " .. tostring(err))
			end
		end
	end)
	Players.PlayerRemoving:Connect(function(player)
		ConquestService.releaseOwner(player.UserId)
	end)
end

return ConquestService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="35">
          <Properties>
            <string name="Name">DataService</string>
            <string name="Source"><![CDATA[--[[
	DataService
	Loads and saves player data with DataStoreService.

	  * Session lock: a profile records which server owns it. Another server
	    will wait (and eventually steal a stale lock) instead of loading a
	    copy, so items can't be duplicated by server hopping.
	  * Autosave every 2 minutes, on leave and on shutdown (BindToClose).
	  * Missing fields are filled from the template so new features never
	    break old saves.
	  * In Studio without API access the game still runs (data just isn't
	    persisted) so you can test immediately.
]]

local DataStoreService = game:GetService("DataStoreService")
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage.Shared.Config)

local DataService = {}

local AUTOSAVE_INTERVAL = 120
local LOCK_EXPIRE = 300

local store: DataStore? = nil
local storeOk = false
local profiles: { [Player]: { [string]: any } } = {}
local loadedCallbacks: { (Player, { [string]: any }) -> () } = {}
local beforeSaveCallbacks: { (Player, { [string]: any }) -> () } = {}
local releasing: { [Player]: boolean } = {}

local function template(): { [string]: any }
	return {
		Version = Config.DataVersion,
		Cash = Config.StartCash,
		Population = 0,
		ResearchPoints = 0,
		Researched = {},
		ActiveResearch = nil,
		Buildings = {},
		NextUid = 1,
		Inventory = {},
		Units = {},
		Oil = 0,
		Steel = 0,
		Stats = { Hits = 0, Launches = 0, Captures = 0, Kills = 0, TotalEarned = 0, PlayTime = 0 },
		Pvp = false,
		FirstJoin = 0,
		LastOnline = 0,
		LastPay = 0,
		Daily = { Streak = 0, LastDay = 0 },
		Quest = 1,
		Flags = {},
		BoostUntil = 0,
		Redeemed = {},
		Receipts = {},
		Billboard = "",
		RankLevel = 1,
		-- Nation = { Name, Flag } once the player founds their nation
	}
end

local function reconcile(data: { [string]: any }, tmpl: { [string]: any })
	for k, v in tmpl do
		if data[k] == nil then
			if type(v) == "table" then
				data[k] = table.clone(v)
			else
				data[k] = v
			end
		elseif type(v) == "table" and type(data[k]) == "table" and next(v) ~= nil then
			reconcile(data[k], v)
		end
	end
end

local function keyFor(player: Player): string
	return "player_" .. player.UserId
end

local function now(): number
	return os.time()
end

local function tryLoad(player: Player): { [string]: any }?
	local s = store
	if not s then
		return nil
	end
	local result: { [string]: any }? = nil
	local attempts = 0
	while attempts < 8 and player.Parent do
		attempts += 1
		local stolen = false
		local ok, err = pcall(function()
			s:UpdateAsync(keyFor(player), function(old)
				local data = old or template()
				local lock = data._lock
				if lock and lock.job ~= game.JobId and now() - (lock.t or 0) < LOCK_EXPIRE then
					-- another server still owns this profile
					result = nil
					return nil
				end
				stolen = lock ~= nil and lock.job ~= game.JobId
				data._lock = { job = game.JobId, t = now() }
				result = data
				return data
			end)
		end)
		if ok and result then
			if stolen then
				warn(("[Data] Took over a stale session lock for %s"):format(player.Name))
			end
			return result
		elseif not ok then
			warn(("[Data] Load attempt %d failed for %s: %s"):format(attempts, player.Name, tostring(err)))
		end
		task.wait(attempts < 3 and 2 or 6)
	end
	return nil
end

local function save(player: Player, release: boolean): boolean
	local data = profiles[player]
	local s = store
	if not data or not s then
		return false
	end
	for _, cb in beforeSaveCallbacks do
		local ok, err = pcall(cb, player, data)
		if not ok then
			warn("[Data] beforeSave failed: " .. tostring(err))
		end
	end
	data.LastOnline = now()
	data._lock = (not release) and { job = game.JobId, t = now() } or nil
	local payload = data
	local ok, err = false, nil
	for _ = 1, 3 do
		ok, err = pcall(function()
			s:UpdateAsync(keyFor(player), function(old)
				if old and old._lock and old._lock.job ~= game.JobId then
					-- someone else took this profile; never overwrite it
					return nil
				end
				return payload
			end)
		end)
		if ok then
			break
		end
		task.wait(1)
	end
	if not ok then
		warn(("[Data] Save failed for %s: %s"):format(player.Name, tostring(err)))
	end
	return ok
end

function DataService.get(player: Player): { [string]: any }?
	return profiles[player]
end

function DataService.onLoaded(cb: (Player, { [string]: any }) -> ())
	table.insert(loadedCallbacks, cb)
	for p, data in profiles do
		task.spawn(cb, p, data)
	end
end

-- Lets runtime services write their live state into the profile right before it saves.
function DataService.beforeSave(cb: (Player, { [string]: any }) -> ())
	table.insert(beforeSaveCallbacks, cb)
end

function DataService.save(player: Player)
	task.spawn(save, player, false)
end

-- Final save when a player leaves. beforeSave callbacks run synchronously
-- (before the first yield) so callers can tear down runtime state right after.
function DataService.release(player: Player)
	if profiles[player] and not releasing[player] then
		releasing[player] = true
		task.spawn(function()
			save(player, true)
			profiles[player] = nil
			releasing[player] = nil
		end)
	end
end

function DataService.isPersistent(): boolean
	return storeOk
end

local function onPlayerAdded(player: Player)
	local data: { [string]: any }?
	if storeOk then
		data = tryLoad(player)
		if not data then
			if player.Parent then
				player:Kick("Could not load your nation. Please rejoin in a moment.")
			end
			return
		end
	else
		data = template()
	end
	local profile = data :: { [string]: any }
	if not player.Parent then
		-- left while loading: release the session lock we just took
		if storeOk then
			profiles[player] = profile
			save(player, true)
			profiles[player] = nil
		end
		return
	end
	reconcile(profile, template())
	if profile.FirstJoin == 0 then
		profile.FirstJoin = now()
	end
	profiles[player] = profile
	for _, cb in loadedCallbacks do
		task.spawn(cb, player, profile)
	end
end

function DataService.init(_S)
	local ok, result = pcall(function()
		return DataStoreService:GetDataStore(Config.DataStoreName)
	end)
	if ok then
		store = result
		-- In Studio, a quick read tells us whether API access is enabled.
		local readOk = pcall(function()
			(result :: DataStore):GetAsync("__probe")
		end)
		storeOk = readOk
		if not readOk then
			warn("[Data] DataStores unavailable (enable Studio API access to save). Running without saving.")
		end
	else
		warn("[Data] DataStores unavailable: " .. tostring(result))
	end
end

function DataService.start()
	Players.PlayerAdded:Connect(onPlayerAdded)
	for _, p in Players:GetPlayers() do
		task.spawn(onPlayerAdded, p)
	end


	task.spawn(function()
		while true do
			task.wait(AUTOSAVE_INTERVAL)
			for player in profiles do
				task.spawn(save, player, false)
				task.wait(0.5)
			end
		end
	end)

	game:BindToClose(function()
		if RunService:IsStudio() and not storeOk then
			return
		end
		local pending = 0
		for player in profiles do
			if not releasing[player] then
				pending += 1
				task.spawn(function()
					save(player, true)
					pending -= 1
				end)
			end
		end
		local start = os.clock()
		while pending > 0 and os.clock() - start < 25 do
			task.wait(0.2)
		end
	end)
end

return DataService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="36">
          <Properties>
            <string name="Name">EconomyService</string>
            <string name="Source"><![CDATA[--[[
	EconomyService
	Runs the 1-second simulation loop for every nation and owns the core
	economy: workers, power, water, road access, happiness, population,
	national resources and pay day.

	Each tick (in order):
	  BuildService (construction) -> Economy (stats) -> Logistics (refineries,
	  trucks) -> Production (factories) -> Research -> Rewards (quests) -> State
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage.Shared
local Config = require(Shared.Config)
local Format = require(Shared.Util.Format)
local Nations = require(script.Parent.Nations)

type Nation = Nations.Nation

local EconomyService = {}
local S: { [string]: any }

local SERVICE_HAPPINESS = { Leisure = 15, Commerce = 10, Education = 10, Health = 15 }

local function setAttr(model: Model?, key: string, value: any)
	if model and model:GetAttribute(key) ~= value then
		model:SetAttribute(key, value)
	end
end
EconomyService.setAttr = setAttr

function EconomyService.incomeMultiplier(n: Nation): number
	local mult = 1
	if n.passes.VIP then
		mult += 0.25
	end
	if n.premium then
		mult += Config.PremiumIncomeBonus
	end
	if n.passes.DoubleCash then
		mult *= 2
	end
	if n.data.BoostUntil > os.time() then
		mult *= 2
	end
	return mult
end

function EconomyService.compute(n: Nation, dt: number)
	local data = n.data
	local pop = data.Population
	local bonus = S.ConquestService.bonusFor(n)

	-- 1) worker demand from active buildings
	local workersDemand = 0
	for _, b in n.buildings do
		if Nations.isActive(b) and b.def.workers then
			workersDemand += b.def.workers
		end
	end
	local wr = workersDemand > 0 and math.min(1, pop / workersDemand) or 1

	local function baseEff(b): number
		local e = b.connected and 1 or 0.5
		if b.def.workers then
			e *= wr
		end
		return e
	end

	-- 2) power
	local powerSupply, powerDemand = bonus.power or 0, 0
	for _, b in n.buildings do
		if Nations.isActive(b) then
			if b.def.powerOut then
				powerSupply += b.def.powerOut * baseEff(b)
			end
			if b.def.power then
				powerDemand += b.def.power
			end
		end
	end
	local pr = powerDemand > 0 and math.min(1, powerSupply / powerDemand) or 1

	-- 3) water
	local waterSupply, waterDemand = 0, 0
	for _, b in n.buildings do
		if Nations.isActive(b) then
			if b.def.waterOut then
				waterSupply += b.def.waterOut * baseEff(b) * (b.def.power and pr or 1)
			end
			if b.def.water then
				waterDemand += b.def.water
			end
		end
	end
	local wtr = waterDemand > 0 and math.min(1, waterSupply / waterDemand) or 1

	-- 4) per-building efficiency and outputs
	local housingCap = 0
	local oilRate, steelRate, rpRate = bonus.oil or 0, bonus.steel or 0, bonus.rp or 0
	local commerce = bonus.income or 0
	local services = { Leisure = 0, Commerce = 0, Education = 0, Health = 0 }
	local pollution, upkeep, damaged, constructing = 0, 0, 0, 0
	local oilCap, steelCap = Config.BaseResourceCap, Config.BaseResourceCap
	local depotCap = 0

	for _, b in n.buildings do
		local def = b.def
		if b.finishAt then
			constructing += 1
			b.eff = 0
			setAttr(b.model, "Status", "Under Construction")
		elseif b.damaged then
			damaged += 1
			upkeep += b.cost * Config.UpkeepRate
			b.eff = 0
			setAttr(b.model, "Status", "Damaged - Needs Repair")
		else
			upkeep += b.cost * Config.UpkeepRate
			local road = b.connected and 1 or 0.5
			local eff = road
			if def.workers then
				eff *= wr
			end
			if def.power then
				eff *= pr
			end
			if def.water then
				eff *= wtr
			end
			if def.housing then
				local h = road * (0.4 + 0.6 * math.min(pr, wtr))
				housingCap += def.housing * h
				eff = h
			end
			b.eff = eff
			if def.oilOut then
				oilRate += def.oilOut * eff
			end
			if def.steelOut then
				steelRate += def.steelOut * eff
			end
			if def.rpOut then
				rpRate += def.rpOut * eff
			end
			if def.income then
				commerce += def.income * eff
			end
			if def.service then
				services[def.service.kind] += def.service.serves * eff
			end
			if def.pollution then
				pollution += def.pollution
			end
			if def.storage then
				oilCap += def.storage.oil or 0
				steelCap += def.storage.steel or 0
			end
			if def.depot then
				depotCap += def.depot
			end
			-- generic status; specialised services overwrite it afterwards
			local status
			if not b.connected then
				status = "No Road Access - Half Speed"
			elseif def.workers and wr < 0.999 then
				status = "Not Enough Workers"
			elseif def.power and pr < 0.999 then
				status = "Not Enough Power"
			elseif def.water and wtr < 0.999 then
				status = "Not Enough Water"
			else
				status = "Working"
			end
			b.status = status
			setAttr(b.model, "Status", status)
		end
		setAttr(b.model, "Eff", math.floor(b.eff * 100 + 0.5))
	end

	-- 5) happiness
	local happiness = Config.HappinessBase
	for kind, max in SERVICE_HAPPINESS do
		local coverage = pop > 0 and math.min(1, services[kind] / pop) or 1
		happiness += max * coverage
	end
	happiness -= math.min(25, pollution * 0.6)
	happiness -= (1 - pr) * 20 + (1 - wtr) * 20
	happiness -= math.min(15, damaged * 2)
	if pop < 150 then
		happiness += 10 -- small towns are forgiving so new players grow fast
	end
	happiness = math.clamp(happiness, 0, 100)

	-- 6) population
	if pop < housingCap and happiness >= 35 then
		local growth = math.max(Config.PopulationMinGrowth, (housingCap - pop) * Config.PopulationGrowth) * dt
		pop = math.min(housingCap, pop + growth)
	elseif pop > housingCap then
		pop = math.max(housingCap, pop - math.max(1, (pop - housingCap) * 0.06) * dt)
	end
	if happiness < 25 then
		pop = math.max(0, pop - pop * 0.003 * dt)
	end
	data.Population = pop

	-- 7) national resources
	data.Oil = math.min(oilCap, data.Oil + oilRate / 60 * dt)
	data.Steel = math.min(steelCap, data.Steel + steelRate / 60 * dt)
	data.ResearchPoints += rpRate / 60 * dt

	-- 8) projected pay
	local taxes = pop * Config.TaxPerCitizen * (0.4 + 0.8 * happiness / 100)
	local mult = EconomyService.incomeMultiplier(n)
	local gross = (taxes + commerce) * mult
	local net = gross - upkeep

	local st = n.stats
	st.housingCap = housingCap
	st.workersDemand = workersDemand
	st.workersUsed = math.min(pop, workersDemand)
	st.powerSupply, st.powerDemand = powerSupply, powerDemand
	st.waterSupply, st.waterDemand = waterSupply, waterDemand
	st.happiness = happiness
	st.oilRate, st.steelRate, st.rpRate = oilRate, steelRate, rpRate
	st.oilCap, st.steelCap = oilCap, steelCap
	st.taxes, st.commerce, st.upkeep = taxes, commerce, upkeep
	st.gross, st.income, st.mult = gross, net, mult
	st.depotCap = depotCap
	st.damaged, st.constructing = damaged, constructing
	st.services = services
end

function EconomyService.payDay(n: Nation)
	local net = math.floor(n.stats.income or 0)
	local data = n.data
	data.Cash = math.max(0, data.Cash + net)
	data.LastPay = net
	if net > 0 then
		data.Stats.TotalEarned += net
	end
	if net ~= 0 then
		Nations.notify(n.player, (net > 0 and "Pay day! +" or "Pay day: ") .. Format.cash(net), "pay")
	end
end

-- Cash = income per pay day for `minutes` minutes (used by cash packs & gifts).
function EconomyService.incomeFor(n: Nation, minutes: number): number
	local perPay = math.max(n.stats.gross or 0, 0)
	return perPay * (minutes * 60 / Config.PayInterval)
end

local function tick(dt: number)
	local now = Nations.now()
	for _, n in Nations.all() do
		if n.ready then
			local ok, err = pcall(function()
				S.BuildService.tick(n, now)
				EconomyService.compute(n, dt)
				S.LogisticsService.tick(n, dt, now)
				S.ProductionService.tick(n, dt, now)
				S.ResearchService.tick(n, now)
				S.RewardService.tick(n, now)
				S.NationService.tick(n, now)
				if now >= n.nextPayAt then
					n.nextPayAt += Config.PayInterval
					if n.nextPayAt < now then
						n.nextPayAt = now + Config.PayInterval
					end
					EconomyService.payDay(n)
				end
				n.data.Stats.PlayTime += dt
				S.StateService.push(n)
			end)
			if not ok then
				warn("[Economy] tick failed for " .. n.player.Name .. ": " .. tostring(err))
			end
		end
	end
end

-- exposed for automated tests
EconomyService._tick = tick

function EconomyService.init(services)
	S = services
end

function EconomyService.start()
	task.spawn(function()
		local last = os.clock()
		while true do
			task.wait(1)
			local t = os.clock()
			local dt = math.min(3, t - last)
			last = t
			tick(dt)
		end
	end)
end

return EconomyService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="37">
          <Properties>
            <string name="Name">LogisticsService</string>
            <string name="Source"><![CDATA[--[[
	LogisticsService
	Oil pumps fill the national oil pool. Refineries pull oil, refine it into
	fuel and dispatch fuel trucks to fuel consumers (military factories),
	either to a chosen destination or "Auto" (the one with most free space).

	Truck trips are exposed to clients as model attributes
	("Truck1" = "targetUid|departAt|arriveAt|returnAt") so every client,
	including late joiners, animates trucks driving along the roads.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage.Shared
local Config = require(Shared.Config)
local Net = require(Shared.Net)
local Nations = require(script.Parent.Nations)

type Nation = Nations.Nation
type BRuntime = Nations.BRuntime

local LogisticsService = {}
local S: { [string]: any }

local MIN_LOAD = 60

local function freeSpace(b: BRuntime): number
	return (b.def.fuelCap or 0) - b.fuel - b.incoming
end

local function centerOf(n: Nation, b: BRuntime): Vector3
	return S.BuildService.worldCFrame(n, b).Position
end

local function chooseTarget(n: Nation, refinery: BRuntime): BRuntime?
	if refinery.dest ~= 0 then
		local t = n.buildings[refinery.dest]
		if t and t.def.fuelCap and Nations.isActive(t) and freeSpace(t) > 1 then
			return t
		end
		return nil
	end
	local best, bestFree = nil, 1
	for _, b in n.buildings do
		if b.def.fuelCap and Nations.isActive(b) then
			local free = freeSpace(b)
			if free > bestFree then
				best, bestFree = b, free
			end
		end
	end
	return best
end

function LogisticsService.tick(n: Nation, dt: number, now: number)
	local setAttr = S.EconomyService.setAttr
	local oilShare = 0
	local refineries = 0
	for _, b in n.buildings do
		if b.def.refine and Nations.isActive(b) then
			refineries += 1
		end
	end
	if refineries > 0 then
		oilShare = (n.stats.oilRate or 0) / refineries
	end

	for _, b in n.buildings do
		local rf = b.def.refine
		if rf then
			-- trucks keep driving even if the refinery gets knocked out
			local busy = false
			for i, t in b.trucks do
				if t.state == "out" and now >= t.arriveAt then
					local target = n.buildings[t.target]
					if target and target.def.fuelCap then
						target.incoming = math.max(0, target.incoming - t.amount)
						target.fuel = math.min(target.def.fuelCap, target.fuel + t.amount)
					else
						b.fuel = math.min(rf.fuelCap, b.fuel + t.amount) -- destination vanished: bring it home
					end
					t.state = "back"
				end
				if t.state == "back" and now >= t.returnAt then
					t.state = "idle"
					setAttr(b.model, "Truck" .. i, "")
				end
				if t.state ~= "idle" then
					busy = true
				end
			end

			if Nations.isActive(b) then
				-- pull oil from the national pool
				local want = math.min(rf.oilCap - b.oil, rf.rate * 2 / 60 * dt)
				local take = math.max(0, math.min(want, n.data.Oil))
				n.data.Oil -= take
				b.oil += take
				-- refine
				local amount = math.max(0, math.min(b.oil, rf.rate / 60 * dt * b.eff, rf.fuelCap - b.fuel))
				b.oil -= amount
				b.fuel += amount

				-- dispatch idle trucks
				for i, t in b.trucks do
					if t.state == "idle" and b.fuel >= math.min(MIN_LOAD, rf.fuelCap) then
						local target = chooseTarget(n, b)
						if target then
							local load = math.floor(math.min(b.fuel, Config.TruckCapacity, freeSpace(target)))
							if load > 0 then
								local a, c = centerOf(n, b), centerOf(n, target)
								local dist = math.abs(a.X - c.X) + math.abs(a.Z - c.Z)
								local trip = math.max(4, dist / Config.TruckSpeed)
								t.state = "out"
								t.target = target.uid
								t.amount = load
								t.arriveAt = now + trip
								t.returnAt = now + trip * 2
								b.fuel -= load
								target.incoming += load
								busy = true
								setAttr(b.model, "Truck" .. i, ("%d|%.2f|%.2f|%.2f"):format(target.uid, now, t.arriveAt, t.returnAt))
							end
						end
					end
				end

				local status
				if busy then
					status = "Fuel Truck Already Delivering"
				elseif b.fuel >= rf.fuelCap - 0.5 then
					status = chooseTarget(n, b) and "Loading Truck" or "Fuel Storage Full - No Destination"
				elseif b.oil < 1 and n.data.Oil < 1 then
					status = "Waiting For Oil - Build Oil Pumps"
				elseif b.status ~= "Working" then
					status = b.status
				else
					status = "Refining Oil Into Fuel"
				end
				setAttr(b.model, "Status", status)
			end
			setAttr(b.model, "Oil", math.floor(b.oil))
			setAttr(b.model, "Fuel", math.floor(b.fuel))
			setAttr(b.model, "OilArriving", math.floor(oilShare * 10) / 10)
			setAttr(b.model, "Dest", b.dest)
		elseif b.def.fuelCap then
			setAttr(b.model, "Fuel", math.floor(b.fuel))
			setAttr(b.model, "Incoming", math.floor(b.incoming))
		end
	end
end

local function onSetDestination(player: Player, refineryUid: any, destUid: any)
	local n = Nations.get(player)
	if not n or typeof(refineryUid) ~= "number" or typeof(destUid) ~= "number" then
		return { ok = false }
	end
	local b = n.buildings[refineryUid]
	if not b or not b.def.refine then
		return { ok = false, err = "Not a refinery" }
	end
	if destUid ~= 0 then
		local t = n.buildings[destUid]
		if not t or not t.def.fuelCap then
			return { ok = false, err = "That building doesn't use fuel" }
		end
	end
	b.dest = destUid
	if b.model then
		b.model:SetAttribute("Dest", destUid)
	end
	return { ok = true }
end

function LogisticsService.init(services)
	S = services
end

function LogisticsService.start()
	Net.handle("SetFuelDestination", onSetDestination, 6)
end

return LogisticsService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="38">
          <Properties>
            <string name="Name">MonetizationService</string>
            <string name="Source"><![CDATA[--[[
	MonetizationService
	Game passes, developer products (ProcessReceipt) and Roblox Premium.

	  * Receipts are idempotent: every granted PurchaseId is remembered in the
	    player's data, and we only return PurchaseGranted after granting.
	  * Cash packs scale with the player's income so they stay worth buying at
	    every stage of the game (with a floor for brand new players).
	  * In Studio (Config.StudioFreePurchases) the store's buy buttons grant
	    items directly so every perk can be tested without publishing.
]]

local MarketplaceService = game:GetService("MarketplaceService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Shared = ReplicatedStorage.Shared
local Config = require(Shared.Config)
local Format = require(Shared.Util.Format)
local Net = require(Shared.Net)
local Products = require(Shared.Catalog.Products)
local Weapons = require(Shared.Catalog.Weapons)
local Unlocks = require(Shared.Util.Unlocks)
local Nations = require(script.Parent.Nations)

type Nation = Nations.Nation

local MonetizationService = {}
local S: { [string]: any }

local function isPremium(player: Player): boolean
	local ok, premium = pcall(function()
		return player.MembershipType == Enum.MembershipType.Premium
	end)
	return ok and premium == true
end

local function applyPassPerks(n: Nation)
	n.player:SetAttribute("VIP", n.passes.VIP == true)
end

function MonetizationService.grantPass(n: Nation, key: string)
	if n.passes[key] then
		return
	end
	n.passes[key] = true
	applyPassPerks(n)
	local def = Products.pass(key)
	Nations.notify(n.player, ("%s unlocked! Thank you for supporting the game"):format(def and def.name or key), "good")
	Net.event("PurchaseDone"):FireClient(n.player, "pass", key)
	S.StateService.push(n)
end

function MonetizationService.loadPasses(n: Nation)
	for _, def in Products.Passes do
		if def.id ~= 0 then
			local ok, owns = pcall(MarketplaceService.UserOwnsGamePassAsync, MarketplaceService, n.userId, def.id)
			if ok and owns then
				n.passes[def.key] = true
			end
		end
		-- passes bought in Studio test sessions are remembered in data while testing
		if RunService:IsStudio() and n.data.Flags["StudioPass_" .. def.key] then
			n.passes[def.key] = true
		end
	end
	n.premium = isPremium(n.player)
	applyPassPerks(n)
end

-- Returns true when the product was granted.
function MonetizationService.grantProduct(n: Nation, def): boolean
	local data = n.data
	local kind = def.kind
	if kind == "cash" then
		local amount = math.max(def.minCash or 0, S.EconomyService.incomeFor(n, def.minutes or 10))
		amount = math.floor(amount)
		data.Cash += amount
		Nations.notify(n.player, ("+%s added to your treasury"):format(Format.cash(amount)), "pay")
	elseif kind == "boost" then
		data.BoostUntil = math.max(os.time(), data.BoostUntil) + (def.minutes or 30) * 60
		Nations.notify(n.player, "2x Cash boost active!", "good")
	elseif kind == "instantBuild" then
		S.BuildService.finishAll(n)
		Nations.notify(n.player, "All construction finished!", "good")
	elseif kind == "instantResearch" then
		if data.ActiveResearch then
			S.ResearchService.complete(n)
		else
			-- nothing running: bank the value as research points instead
			data.ResearchPoints += 500
			Nations.notify(n.player, "No research running - +500 RP instead", "good")
		end
	elseif kind == "supply" then
		local access = S.BuildService.access(n)
		for _, w in Weapons.all() do
			if Unlocks.check(w, access) then
				data.Inventory[w.id] = math.max(data.Inventory[w.id] or 0, w.stockCap)
			end
		end
		Nations.notify(n.player, "Supply drop delivered: stockpiles full!", "good")
	elseif kind == "repair" then
		local count = S.BuildService.repairAll(n, true)
		Nations.notify(n.player, ("%d buildings repaired"):format(count), "good")
	elseif kind == "starter" then
		data.Cash += 150000
		data.Inventory.SRBM = (data.Inventory.SRBM or 0) + 10
		data.BoostUntil = math.max(os.time(), data.BoostUntil) + 30 * 60
		data.Flags.StarterPack = true
		Nations.notify(n.player, "Starter Pack: +$150k, 10 SRBMs and 30 min of 2x cash!", "good")
	else
		return false
	end
	Net.event("PurchaseDone"):FireClient(n.player, "product", def.key)
	S.StateService.push(n)
	return true
end

local function processReceipt(info)
	local player = Players:GetPlayerByUserId(info.PlayerId)
	if not player then
		return Enum.ProductPurchaseDecision.NotProcessedYet
	end
	local n = Nations.get(player)
	if not n or not n.ready then
		return Enum.ProductPurchaseDecision.NotProcessedYet
	end
	local receipts = n.data.Receipts
	if table.find(receipts, info.PurchaseId) then
		return Enum.ProductPurchaseDecision.PurchaseGranted
	end
	local def = Products.productById(info.ProductId)
	if not def then
		warn("[Monetization] Unknown product id " .. tostring(info.ProductId))
		return Enum.ProductPurchaseDecision.NotProcessedYet
	end
	local ok, granted = pcall(MonetizationService.grantProduct, n, def)
	if not ok or not granted then
		warn("[Monetization] Grant failed: " .. tostring(granted))
		return Enum.ProductPurchaseDecision.NotProcessedYet
	end
	table.insert(receipts, info.PurchaseId)
	while #receipts > 60 do
		table.remove(receipts, 1)
	end
	S.DataService.save(player)
	return Enum.ProductPurchaseDecision.PurchaseGranted
end

local function onStudioPurchase(player: Player, kind: any, key: any)
	if not (RunService:IsStudio() and Config.StudioFreePurchases) then
		return { ok = false, err = "Purchases go through Roblox" }
	end
	local n = Nations.get(player)
	if not n or typeof(key) ~= "string" then
		return { ok = false }
	end
	if kind == "pass" then
		if not Products.pass(key) then
			return { ok = false }
		end
		n.data.Flags["StudioPass_" .. key] = true
		MonetizationService.grantPass(n, key)
		return { ok = true }
	elseif kind == "product" then
		local def = Products.product(key)
		if not def then
			return { ok = false }
		end
		return { ok = MonetizationService.grantProduct(n, def) }
	end
	return { ok = false }
end

function MonetizationService.init(services)
	S = services
end

function MonetizationService.start()
	MarketplaceService.ProcessReceipt = processReceipt
	MarketplaceService.PromptGamePassPurchaseFinished:Connect(function(player, passId, purchased)
		if not purchased then
			return
		end
		local n = Nations.get(player)
		if not n then
			return
		end
		for _, def in Products.Passes do
			if def.id == passId and def.id ~= 0 then
				MonetizationService.grantPass(n, def.key)
			end
		end
	end)
	Players.PlayerMembershipChanged:Connect(function(player)
		local n = Nations.get(player)
		if n then
			n.premium = isPremium(player)
		end
	end)
	Net.handle("StudioPurchase", onStudioPurchase, 3)
end

return MonetizationService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="39">
          <Properties>
            <string name="Name">NationService</string>
            <string name="Source"><![CDATA[--[[
	NationService
	Nation identity and standing:
	  * SetNation  - name (3-20 chars, text-filtered) + flag, saved with the data
	  * identity   - player attributes (NationName / NationFlag) and the plot's
	                 sign + flagpole, so every client can draw the nation
	  * rank       - power score from population, buildings, tech, vehicles
	                 and captured points; each new rank pays a one-off reward
]]

local TextService = game:GetService("TextService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage.Shared
local Config = require(Shared.Config)
local Net = require(Shared.Net)
local Flag = require(Shared.Util.Flag)
local Format = require(Shared.Util.Format)
local Rank = require(Shared.Util.Rank)
local Nations = require(script.Parent.Nations)

type Nation = Nations.Nation

local NationService = {}
local S: { [string]: any }

local NAME_CHARS = "^[%w %-'%.]+$"

local function cleanName(s: string): string
	s = string.gsub(s, "%s+", " ")
	s = string.match(s, "^%s*(.-)%s*$") or ""
	return s
end

-- Pushes the saved identity to attributes and the plot.
function NationService.apply(n: Nation)
	local nation = n.data.Nation
	local name = type(nation) == "table" and nation.Name or nil
	local flag = type(nation) == "table" and nation.Flag or nil
	n.player:SetAttribute("NationName", name)
	n.player:SetAttribute("NationFlag", flag)
	S.PlotService.setIdentity(n.player, name, flag)
end

local function onSetNation(player: Player, name: any, flag: any)
	local n = Nations.get(player)
	if not n or not n.ready then
		return { ok = false }
	end
	if typeof(name) ~= "string" then
		return { ok = false, err = "Pick a name for your nation" }
	end
	name = cleanName(string.sub(name, 1, 64))
	local len = utf8.len(name) or #name
	if len < Config.NationNameMin or len > Config.NationNameMax then
		return { ok = false, err = ("Names are %d-%d characters"):format(Config.NationNameMin, Config.NationNameMax) }
	end
	if not string.match(name, NAME_CHARS) then
		return { ok = false, err = "Use letters, numbers, spaces, - ' or ." }
	end
	local data = typeof(flag) == "string" and Flag.decode(flag) or Flag.sanitize(flag)
	local ok, filtered = pcall(function()
		local result = TextService:FilterStringAsync(name, player.UserId, Enum.TextFilterContext.PublicChat)
		return result:GetNonChatStringForBroadcastAsync()
	end)
	if not ok then
		return { ok = false, err = "Couldn't check that name, try again" }
	end
	if filtered ~= name then
		return { ok = false, err = "That name isn't allowed, try another" }
	end
	local founded = n.data.Nation == nil
	n.data.Nation = { Name = filtered, Flag = Flag.encode(data) }
	NationService.apply(n)
	if founded then
		Nations.notifyAll(("%s founded the nation of %s"):format(player.DisplayName, filtered), "info")
	end
	S.StateService.push(n)
	return { ok = true, name = filtered, flag = n.data.Nation.Flag }
end

function NationService.compute(n: Nation): Rank.Info
	local value = 0
	for _, b in n.buildings do
		if not b.finishAt then
			value += b.cost
		end
	end
	local techs = 0
	for _ in n.data.Researched do
		techs += 1
	end
	local held = 0
	for _, p in S.ConquestService.points() do
		if p.owner == n.userId then
			held += 1
		end
	end
	return Rank.of(Rank.power({
		pop = n.data.Population,
		buildingValue = value,
		researched = techs,
		units = S.UnitService.count(n),
		points = held,
	}))
end

-- Called from the economy tick (once per second per nation).
function NationService.tick(n: Nation, _now: number)
	local info = NationService.compute(n)
	n.stats.rank = info
	local data = n.data
	local best = data.RankLevel or 1
	if info.level > best then
		for level = best + 1, info.level do
			local r = Config.Ranks[level]
			data.Cash += r.reward
			Nations.notify(n.player, ("RANK UP · %s  +%s"):format(string.upper(r.name), Format.cash(r.reward)), "good")
		end
		data.RankLevel = info.level
		Net.event("Effect"):FireClient(n.player, "RankUp", info.level)
		if info.level >= 4 then
			Nations.notifyAll(("%s is now a %s"):format(data.Nation and data.Nation.Name or n.player.DisplayName, info.name), "info")
		end
	end
	if n.player:GetAttribute("Power") ~= info.power then
		n.player:SetAttribute("Power", info.power)
	end
	if n.player:GetAttribute("RankName") ~= info.name then
		n.player:SetAttribute("RankName", info.name)
	end
end

function NationService.onJoin(n: Nation)
	NationService.apply(n)
	NationService.tick(n, Nations.now())
end

function NationService.snapshot(n: Nation): (any, any)
	local nation = n.data.Nation
	local rank = n.stats.rank or Rank.of(0)
	local outNation: any = false
	if type(nation) == "table" then
		outNation = { name = nation.Name, flag = nation.Flag }
	end
	return outNation, rank
end

function NationService.init(services)
	S = services
end

function NationService.start()
	Net.handle("SetNation", onSetNation, 2)
end

return NationService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="40">
          <Properties>
            <string name="Name">Nations</string>
            <string name="Source"><![CDATA[--[[
	Nations
	Runtime registry of every player's nation (live state that is not just
	saved data: building instances, occupancy grid, computed stats, timers).
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Net = require(ReplicatedStorage.Shared.Net)

export type BRuntime = {
	uid: number,
	id: string,
	def: any,
	x: number, -- island-local studs (footprint centre)
	z: number,
	r: number, -- yaw in degrees
	len: number?, -- road segments: length in studs
	cost: number, -- what was paid (roads scale with length)
	model: Model?,
	finishAt: number?,
	startAt: number?,
	damaged: boolean,
	hp: number,
	oil: number,
	fuel: number,
	incoming: number,
	dest: number,
	trucks: { { state: string, target: number, amount: number, arriveAt: number, returnAt: number } },
	queue: { { id: string, kind: string, progress: number, started: boolean } },
	reloadUntil: number,
	connected: boolean,
	eff: number,
	status: string,
}

export type Nation = {
	player: Player,
	userId: number,
	data: { [string]: any },
	plotIndex: number,
	origin: Vector3,
	frame: CFrame, -- island frame; -Z faces the battlefield
	folder: Folder,
	buildings: { [number]: BRuntime },
	grid: { [number]: { [number]: boolean } }, -- spatial hash (Footprint)
	stats: { [string]: any },
	passes: { [string]: boolean },
	premium: boolean,
	joinAt: number,
	nextPayAt: number,
	giftAt: number,
	pvpLockUntil: number,
	shieldUntil: number,
	undo: { { [string]: any } },
	units: { [number]: any },
	nextUnitUid: number,
	sent: { [string]: string },
	ready: boolean,
}

local Nations = {}

local byPlayer: { [Player]: Nation } = {}

function Nations.now(): number
	return workspace:GetServerTimeNow()
end

function Nations.add(n: Nation)
	byPlayer[n.player] = n
end

function Nations.remove(player: Player)
	byPlayer[player] = nil
end

function Nations.get(player: Player): Nation?
	return byPlayer[player]
end

function Nations.all(): { [Player]: Nation }
	return byPlayer
end

function Nations.byUserId(userId: number): Nation?
	local p = Players:GetPlayerByUserId(userId)
	return p and byPlayer[p] or nil
end

-- kind: "info" | "good" | "bad" | "pay"
function Nations.notify(player: Player, text: string, kind: string?)
	Net.event("Notify"):FireClient(player, text, kind or "info")
end

function Nations.notifyAll(text: string, kind: string?)
	Net.event("Notify"):FireAllClients(text, kind or "info")
end

function Nations.hasPass(n: Nation, key: string): boolean
	return n.passes[key] == true
end

-- Multiplier for construction, research and factory speed.
function Nations.speed(n: Nation): number
	return n.passes.FastBuild and 2 or 1
end

-- Finished buildings of a type. Road segments count per 8-stud tile of length.
function Nations.countBuilt(n: Nation, id: string): number
	local c = 0
	for _, b in n.buildings do
		if b.id == id and not b.finishAt then
			if b.len then
				c += math.max(1, math.floor(b.len / 8 + 0.5))
			else
				c += 1
			end
		end
	end
	return c
end

function Nations.countAll(n: Nation, id: string): number
	local c = 0
	for _, b in n.buildings do
		if b.id == id then
			c += 1
		end
	end
	return c
end

-- Finished, undamaged building.
function Nations.isActive(b: BRuntime): boolean
	return b.finishAt == nil and not b.damaged
end

return Nations
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="41">
          <Properties>
            <string name="Name">PlotService</string>
            <string name="Source"><![CDATA[--[[
	PlotService
	Builds the homeland islands (one per player slot), the sea, assigns a plot
	to each joining player and keeps their character spawning on it.
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage.Shared.Config)
local Grid = require(ReplicatedStorage.Shared.Util.Grid)
local Flag = require(ReplicatedStorage.Shared.Util.Flag)

local PlotService = {}

type Plot = {
	index: number,
	origin: Vector3,
	frame: CFrame,
	model: Model,
	buildings: Folder,
	sign: { TextLabel },
	signSub: { TextLabel },
	flags: { BasePart },
	owner: Player?,
}

local plots: { Plot } = {}
local byPlayer: { [Player]: Plot } = {}

local GRASS = Color3.fromRGB(100, 138, 76)
local SAND = Color3.fromRGB(214, 190, 140)
local SEA = Color3.fromRGB(88, 156, 196)
local BORDER = Color3.fromRGB(96, 204, 255)

local function part(parent: Instance, name: string, size: Vector3, cf: CFrame, color: Color3, material: Enum.Material?): Part
	local p = Instance.new("Part")
	p.Name = name
	p.Anchored = true
	p.Size = size
	p.CFrame = cf
	p.Color = color
	p.Material = material or Enum.Material.SmoothPlastic
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	p.Parent = parent
	return p
end

-- Sea: terrain water (waves, reflections) under the whole map, falling back
-- to flat parts if terrain is unavailable.
local SEA_HALF = 2300

local function buildSea(world: Folder)
	local ok = pcall(function()
		local terrain = workspace.Terrain
		terrain.WaterColor = Color3.fromRGB(40, 118, 140)
		terrain.WaterTransparency = 0.55
		terrain.WaterReflectance = 0.5
		terrain.WaterWaveSize = 0.12
		terrain.WaterWaveSpeed = 8
		local chunk = 1150
		for x = -SEA_HALF, SEA_HALF - 1, chunk do
			for z = -SEA_HALF, SEA_HALF - 1, chunk do
				local c = Config.MainlandOrigin + Vector3.new(x + chunk / 2, 0, z + chunk / 2)
				terrain:FillBlock(CFrame.new(c.X, -10, c.Z), Vector3.new(chunk, 16, chunk), Enum.Material.Water)
				-- sandy sea floor so the water reads blue-green, not black
				terrain:FillBlock(CFrame.new(c.X, -20, c.Z), Vector3.new(chunk, 4, chunk), Enum.Material.Sand)
			end
		end
	end)
	if ok then
		return
	end
	local tile = SEA_HALF * 2 / 3
	for ix = -1, 1 do
		for iz = -1, 1 do
			local c = Config.MainlandOrigin + Vector3.new(ix * tile, -3, iz * tile)
			local p = part(world, "Sea", Vector3.new(tile, 2, tile), CFrame.new(c), SEA)
			p.Reflectance = 0.05
			p.CanQuery = false
		end
	end
end

local FONT = Font.new("rbxasset://fonts/families/Sarpanch.json", Enum.FontWeight.Bold)

local function signFace(board: BasePart, face: Enum.NormalId): (TextLabel, TextLabel)
	local gui = Instance.new("SurfaceGui")
	gui.Name = "Sign" .. face.Name
	gui.Face = face
	gui.CanvasSize = Vector2.new(600, 110)
	gui.LightInfluence = 0.4
	gui.Parent = board
	local label = Instance.new("TextLabel")
	label.Name = "Title"
	label.Position = UDim2.fromScale(0.03, 0.06)
	label.Size = UDim2.fromScale(0.94, 0.6)
	label.BackgroundTransparency = 1
	label.TextColor3 = Color3.fromRGB(240, 238, 228)
	label.TextScaled = true
	label.FontFace = FONT
	label.Text = "UNCLAIMED LAND"
	label.Parent = gui
	local sub = Instance.new("TextLabel")
	sub.Name = "Sub"
	sub.Position = UDim2.fromScale(0.03, 0.68)
	sub.Size = UDim2.fromScale(0.94, 0.26)
	sub.BackgroundTransparency = 1
	sub.TextColor3 = Color3.fromRGB(255, 180, 54)
	sub.TextScaled = true
	sub.FontFace = FONT
	sub.Text = "FREE TERRITORY"
	sub.Parent = gui
	return label, sub
end

local function flagpole(model: Model, name: string, base: CFrame): BasePart
	part(model, "FlagBase", Vector3.new(3, 1, 3), base * CFrame.new(0, 0.5, 0), Color3.fromRGB(150, 150, 140), Enum.Material.Concrete)
	local pole = part(model, "FlagPole", Vector3.new(26, 0.5, 0.5), base * CFrame.new(0, 13, 0) * CFrame.Angles(0, 0, math.rad(90)), Color3.fromRGB(200, 204, 206), Enum.Material.Metal)
	pole.Shape = Enum.PartType.Cylinder
	part(model, "FlagCap", Vector3.new(0.9, 0.9, 0.9), base * CFrame.new(0, 26.2, 0), Color3.fromRGB(255, 180, 54), Enum.Material.Metal).Shape = Enum.PartType.Ball
	local cloth = part(model, name, Vector3.new(9, 6, 0.15), base * CFrame.new(4.8, 22.6, 0), Color3.fromRGB(240, 240, 236), Enum.Material.Fabric)
	cloth.CanCollide = false
	cloth.Transparency = 1
	for _, face in { Enum.NormalId.Front, Enum.NormalId.Back } do
		local fg = Instance.new("SurfaceGui")
		fg.Name = "Flag" .. face.Name
		fg.Face = face
		fg.CanvasSize = Vector2.new(180, 120)
		fg.LightInfluence = 0.6
		fg.Enabled = false
		fg.Parent = cloth
	end
	return cloth
end

-- Bridge from the island's beach to the battlefield shore.
local function buildBridge(model: Model, index: number)
	local W = Config.BridgeWidth
	local toCenter = -Grid.direction(index)
	local a = Grid.gate(index) - toCenter * 6
	local b = Grid.shore(index) - Grid.direction(index) * 14
	local len = (b - a).Magnitude
	local frame = CFrame.lookAt((a + b) / 2, b)
	local concrete = Color3.fromRGB(150, 152, 148)
	local deck = part(model, "BridgeDeck", Vector3.new(W, 1.6, len), frame * CFrame.new(0, -0.75, 0), Color3.fromRGB(58, 62, 64), Enum.Material.Asphalt)
	deck:SetAttribute("Bridge", index)
	local line = part(model, "BridgeLine", Vector3.new(0.5, 0.05, len - 4), frame * CFrame.new(0, 0.08, 0), Color3.fromRGB(236, 196, 64))
	line.CanCollide = false
	line.CanQuery = false
	for _, side in { -1, 1 } do
		local x = side * (W / 2 - 0.4)
		part(model, "Railing", Vector3.new(0.8, 1.2, len), frame * CFrame.new(x, 1.6, 0), concrete, Enum.Material.Concrete)
		part(model, "Curb", Vector3.new(1.6, 0.6, len), frame * CFrame.new(side * (W / 2 - 0.8), 0.3, 0), concrete, Enum.Material.Concrete)
		local n = math.max(2, math.floor(len / 36))
		for i = 0, n do
			local z = -len / 2 + 6 + (len - 12) * i / n
			part(model, "Post", Vector3.new(0.9, 2.2, 0.9), frame * CFrame.new(x, 1.1, z), concrete, Enum.Material.Concrete)
			if i % 2 == 0 then
				local lamp = part(model, "LampPost", Vector3.new(0.4, 7, 0.4), frame * CFrame.new(x, 3.5, z), Color3.fromRGB(70, 74, 76), Enum.Material.Metal)
				lamp.CanCollide = false
				local head = part(model, "Lamp", Vector3.new(1.4, 0.5, 1.4), frame * CFrame.new(x - side * 0.6, 7, z), Color3.fromRGB(255, 220, 160), Enum.Material.Neon)
				head.CanCollide = false
				head.Transparency = 1
				head:SetAttribute("NightGlow", true)
			end
		end
	end
	local piers = math.max(2, math.floor(len / 50))
	for i = 1, piers do
		local z = -len / 2 + len * i / (piers + 1)
		for _, side in { -1, 1 } do
			part(model, "Pier", Vector3.new(3.2, 24, 3.2), frame * CFrame.new(side * (W / 2 - 3), -13.5, z), concrete, Enum.Material.Concrete)
		end
		part(model, "PierCap", Vector3.new(W, 1.4, 3.6), frame * CFrame.new(0, -2.2, z), concrete, Enum.Material.Concrete)
	end
end

local function buildPlot(world: Folder, index: number): Plot
	local frame = Grid.plotCFrame(index)
	local origin = frame.Position
	local size = Grid.PlotSize
	local rim = Grid.Rim
	local model = Instance.new("Model")
	model.Name = "Plot_" .. index

	local ground = part(model, "Ground", Vector3.new(size, 6, size), frame * CFrame.new(0, -3, 0), GRASS, Enum.Material.Grass)
	ground:SetAttribute("PlotIndex", index)
	part(model, "Sand", Vector3.new(size + rim * 2, 6, size + rim * 2), frame * CFrame.new(0, -3.6, 0), SAND, Enum.Material.Sand)

	-- thin light-blue border line marking the buildable area
	local h = 0.15
	for _, s in { -1, 1 } do
		local a = part(model, "Border", Vector3.new(size, h, 0.5), frame * CFrame.new(0, h / 2, s * size / 2), BORDER, Enum.Material.Neon)
		local b = part(model, "Border", Vector3.new(0.5, h, size), frame * CFrame.new(s * size / 2, h / 2, 0), BORDER, Enum.Material.Neon)
		a.Transparency, b.Transparency = 0.25, 0.25
		a.CanCollide, b.CanCollide = false, false
		a.CanQuery, b.CanQuery = false, false
	end

	-- border gate over the bridge: nation name on both faces, flags either side
	local gateCF = frame * CFrame.new(0, 0, -(size / 2 + rim * 0.5))
	local steel = Color3.fromRGB(62, 66, 64)
	local W = Config.BridgeWidth
	for _, side in { -1, 1 } do
		part(model, "GatePillar", Vector3.new(2.4, 18, 2.4), gateCF * CFrame.new(side * (W / 2 + 2), 9, 0), steel, Enum.Material.Metal)
	end
	local board = part(model, "SignBoard", Vector3.new(W + 8, 7, 1.2), gateCF * CFrame.new(0, 19, 0), Color3.fromRGB(30, 34, 32))
	part(model, "SignStripe", Vector3.new(W + 8, 0.6, 1.3), gateCF * CFrame.new(0, 15.8, 0), Color3.fromRGB(255, 180, 54), Enum.Material.Neon)
	local titles, subs = {}, {}
	for _, face in { Enum.NormalId.Front, Enum.NormalId.Back } do
		local t, sub = signFace(board, face)
		table.insert(titles, t)
		table.insert(subs, sub)
	end
	local flags = {
		flagpole(model, "FlagCloth", gateCF * CFrame.new(-(W / 2 + 12), 0, 0)),
		flagpole(model, "FlagCloth2", gateCF * CFrame.new(W / 2 + 12, 0, 0)),
	}
	buildBridge(model, index)

	local buildings = Instance.new("Folder")
	buildings.Name = "Buildings"
	buildings.Parent = model

	model.PrimaryPart = ground
	model.Parent = world
	return { index = index, origin = origin, frame = frame, model = model, buildings = buildings, sign = titles, signSub = subs, flags = flags, owner = nil }
end

-- Spawn just inside the front edge, facing into the city.
function PlotService.spawnCFrame(index: number): CFrame
	return Grid.plotCFrame(index) * CFrame.new(0, 4, -(Grid.PlotSize / 2 - 14)) * CFrame.Angles(0, math.pi, 0)
end

function PlotService.claim(player: Player): Plot?
	for _, plot in plots do
		if plot.owner == nil then
			plot.owner = player
			byPlayer[player] = plot
			PlotService.setIdentity(player, nil, nil)
			plot.model:SetAttribute("OwnerId", player.UserId)
			player:SetAttribute("PlotIndex", plot.index)
			return plot
		end
	end
	return nil
end

function PlotService.release(player: Player)
	local plot = byPlayer[player]
	if not plot then
		return
	end
	byPlayer[player] = nil
	plot.owner = nil
	for i, t in plot.sign do
		t.Text = "UNCLAIMED LAND"
		plot.signSub[i].Text = "FREE TERRITORY"
	end
	for _, cloth in plot.flags do
		cloth.Transparency = 1
		for _, g in cloth:GetChildren() do
			if g:IsA("SurfaceGui") then
				g.Enabled = false
				g:ClearAllChildren()
			end
		end
	end
	plot.model:SetAttribute("OwnerId", nil)
	plot.buildings:ClearAllChildren()
end

-- Sign text and flag for the player's plot (name/flag nil = not founded yet).
function PlotService.setIdentity(player: Player, name: string?, flag: string?)
	local plot = byPlayer[player]
	if not plot then
		return
	end
	for i, t in plot.sign do
		t.Text = name and string.upper(name) or (string.upper(player.DisplayName) .. "'S NATION")
		plot.signSub[i].Text = "EST. BY COMMANDER " .. string.upper(player.DisplayName)
	end
	for _, cloth in plot.flags do
		cloth.Transparency = 0
		for _, g in cloth:GetChildren() do
			if g:IsA("SurfaceGui") then
				g:ClearAllChildren()
				Flag.draw(g, flag)
				g.Enabled = true
			end
		end
	end
end

function PlotService.get(player: Player): Plot?
	return byPlayer[player]
end

-- Which player's plot contains this world position?
function PlotService.ownerAt(pos: Vector3): Player?
	for _, plot in plots do
		if plot.owner and Grid.insidePlot(plot.index, pos, 0) then
			return plot.owner
		end
	end
	return nil
end

local function bindCharacter(player: Player)
	local function place(character: Model)
		local plot = byPlayer[player]
		if not plot then
			return
		end
		character:WaitForChild("HumanoidRootPart", 10)
		task.defer(function()
			if character.Parent then
				character:PivotTo(PlotService.spawnCFrame(plot.index))
			end
		end)
	end
	player.CharacterAdded:Connect(place)
	if player.Character then
		place(player.Character)
	end
end

function PlotService.init(_S)
	local world = Instance.new("Folder")
	world.Name = "Homeland"
	world.Parent = workspace
	buildSea(world)
	for i = 1, Config.MaxPlots do
		table.insert(plots, buildPlot(world, i))
	end
end

function PlotService.start()
	Players.PlayerAdded:Connect(bindCharacter)
	for _, p in Players:GetPlayers() do
		bindCharacter(p)
	end
end

return PlotService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="42">
          <Properties>
            <string name="Name">ProductionService</string>
            <string name="Source"><![CDATA[--[[
	ProductionService
	Military factories build missiles, drones and vehicles from a queue.
	Cash is paid when queued, steel when an item starts, and fuel is burned
	while it is being built (delivered by refinery trucks).
]]

local HttpService = game:GetService("HttpService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage.Shared
local Config = require(Shared.Config)
local Net = require(Shared.Net)
local Unlocks = require(Shared.Util.Unlocks)
local Weapons = require(Shared.Catalog.Weapons)
local Units = require(Shared.Catalog.Units)
local Nations = require(script.Parent.Nations)

type Nation = Nations.Nation

local ProductionService = {}
local S: { [string]: any }

function ProductionService.weaponDef(id: string)
	return Weapons.get(id)
end

function ProductionService.unitDef(id: string)
	return Units.get(id)
end

local function catalogFor(kind: string, id: string): any
	if kind == "unit" then
		return Units.get(id)
	end
	return Weapons.get(id)
end

function ProductionService.queueLimit(n: Nation): number
	return Config.MaxQueuePerFactory + (n.passes.ExtraQueue and 3 or 0)
end

local function encodeQueue(b): string
	local out = {}
	for _, item in b.queue do
		table.insert(out, { id = item.id, k = item.kind, p = math.floor(item.progress * 100) / 100 })
	end
	return HttpService:JSONEncode(out)
end

function ProductionService.tick(n: Nation, dt: number, _now: number)
	local setAttr = S.EconomyService.setAttr
	local speed = Nations.speed(n)
	for _, b in n.buildings do
		local fac = b.def.factory
		if fac then
			if Nations.isActive(b) then
				local item = b.queue[1]
				local status
				if not item then
					status = "Idle - Queue Something To Build"
				else
					local cat = catalogFor(item.kind, item.id)
					if not cat then
						table.remove(b.queue, 1)
						status = "Idle"
					elseif not item.started and n.data.Steel < cat.steel then
						status = ("Waiting For Steel (%d needed)"):format(cat.steel)
					else
						if not item.started then
							n.data.Steel -= cat.steel
							item.started = true
						end
						local dp = speed * fac.speed * math.max(b.eff, 0.25) / cat.time * dt
						dp = math.min(dp, 1 - item.progress)
						local fuelNeeded = cat.fuel * dp
						if b.fuel + 1e-6 < fuelNeeded then
							-- burn what we have, then wait for the next truck
							local partial = b.fuel / math.max(cat.fuel, 1e-3)
							item.progress += partial
							b.fuel = 0
							status = "Waiting For Fuel Delivery"
						else
							b.fuel -= fuelNeeded
							item.progress += dp
							status = ("Building %s (%d%%)"):format(cat.name, math.floor(item.progress * 100))
						end
						if item.progress >= 0.999 then
							item.progress = 1
							if item.kind == "unit" then
								if S.UnitService.canAdd(n) then
									S.UnitService.spawn(n, item.id, nil, b)
									table.remove(b.queue, 1)
									Nations.notify(n.player, cat.name .. " rolled out of the factory", "good")
								else
									status = "Army Full - Build Vehicle Depots"
								end
							else
								local stock = n.data.Inventory[item.id] or 0
								if stock < cat.stockCap then
									n.data.Inventory[item.id] = stock + 1
									table.remove(b.queue, 1)
								else
									status = "Stockpile Full - Fire Some!"
								end
							end
						end
					end
				end
				setAttr(b.model, "Status", status)
			end
			setAttr(b.model, "Queue", encodeQueue(b))
		end
	end
end

local function onQueue(player: Player, factoryUid: any, kind: any, id: any)
	local n = Nations.get(player)
	if not n or typeof(factoryUid) ~= "number" or (kind ~= "unit" and kind ~= "weapon") or typeof(id) ~= "string" then
		return { ok = false, err = "Invalid request" }
	end
	local b = n.buildings[factoryUid]
	if not b or not b.def.factory then
		return { ok = false, err = "Not a factory" }
	end
	if b.finishAt then
		return { ok = false, err = "Factory is still being built" }
	end
	local cat = catalogFor(kind, id)
	if not cat then
		return { ok = false, err = "Unknown item" }
	end
	local ok, reason = Unlocks.check(cat, S.BuildService.access(n))
	if not ok then
		return { ok = false, err = reason }
	end
	if #b.queue >= ProductionService.queueLimit(n) then
		return { ok = false, err = "Queue is full" }
	end
	if n.data.Cash < cat.cost then
		return { ok = false, err = "Not enough cash" }
	end
	n.data.Cash -= cat.cost
	table.insert(b.queue, { id = id, kind = kind, progress = 0, started = false })
	if b.model then
		b.model:SetAttribute("Queue", encodeQueue(b))
	end
	S.StateService.push(n)
	return { ok = true }
end

local function onCancel(player: Player, factoryUid: any, index: any)
	local n = Nations.get(player)
	if not n or typeof(factoryUid) ~= "number" or typeof(index) ~= "number" then
		return { ok = false }
	end
	local b = n.buildings[factoryUid]
	if not b or not b.def.factory then
		return { ok = false }
	end
	local item = b.queue[math.floor(index)]
	if not item then
		return { ok = false }
	end
	local cat = catalogFor(item.kind, item.id)
	table.remove(b.queue, math.floor(index))
	if cat then
		n.data.Cash += cat.cost
		if item.started then
			n.data.Steel += cat.steel
		end
	end
	if b.model then
		b.model:SetAttribute("Queue", encodeQueue(b))
	end
	S.StateService.push(n)
	return { ok = true }
end

function ProductionService.init(services)
	S = services
end

function ProductionService.start()
	Net.handle("QueueProduction", onQueue, 10)
	Net.handle("CancelProduction", onCancel, 10)
end

return ProductionService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="43">
          <Properties>
            <string name="Name">ResearchService</string>
            <string name="Source"><![CDATA[--[[
	ResearchService
	One active research at a time. RP and cash are paid up front; the timer
	keeps running while offline (finishAt is an absolute time).
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage.Shared
local Net = require(Shared.Net)
local Research = require(Shared.Catalog.Research)
local Nations = require(script.Parent.Nations)

type Nation = Nations.Nation

local ResearchService = {}
local S: { [string]: any }

function ResearchService.canStart(n: Nation, id: string): (boolean, string?)
	local def = Research.get(id)
	if not def then
		return false, "Unknown research"
	end
	local data = n.data
	if data.Researched[id] then
		return false, "Already researched"
	end
	if data.ActiveResearch then
		return false, "Already researching something"
	end
	for _, req in def.requires do
		if not data.Researched[req] then
			local r = Research.get(req)
			return false, "Requires " .. (r and r.name or req)
		end
	end
	if def.hits and data.Stats.Hits < def.hits then
		return false, ("Requires %d hits (you have %d)"):format(def.hits, data.Stats.Hits)
	end
	if data.ResearchPoints < def.rp then
		return false, "Not enough research points"
	end
	if data.Cash < def.cash then
		return false, "Not enough cash"
	end
	return true, nil
end

function ResearchService.complete(n: Nation)
	local active = n.data.ActiveResearch
	if not active then
		return
	end
	n.data.Researched[active.id] = true
	n.data.ActiveResearch = nil
	local def = Research.get(active.id)
	Nations.notify(n.player, "Research complete: " .. (def and def.name or active.id), "good")
	Net.event("Effect"):FireClient(n.player, "ResearchDone", nil, def and def.name or active.id)
end

function ResearchService.tick(n: Nation, now: number)
	local active = n.data.ActiveResearch
	if active and now >= active.finishAt then
		ResearchService.complete(n)
	end
end

local function onStart(player: Player, id: any)
	local n = Nations.get(player)
	if not n or typeof(id) ~= "string" then
		return { ok = false, err = "Invalid request" }
	end
	local ok, err = ResearchService.canStart(n, id)
	if not ok then
		return { ok = false, err = err }
	end
	local def = Research.get(id)
	if not def then
		return { ok = false }
	end
	n.data.ResearchPoints -= def.rp
	n.data.Cash -= def.cash
	local now = Nations.now()
	n.data.ActiveResearch = { id = id, startAt = now, finishAt = now + def.time / Nations.speed(n) }
	S.StateService.push(n)
	return { ok = true }
end

function ResearchService.init(services)
	S = services
end

function ResearchService.start()
	Net.handle("StartResearch", onStart, 4)
end

return ResearchService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="44">
          <Properties>
            <string name="Name">RewardService</string>
            <string name="Source"><![CDATA[--[[
	RewardService
	Retention loops: offline earnings, daily login streak, playtime gifts,
	group reward, codes and the objective (quest) chain.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage.Shared
local Config = require(Shared.Config)
local Format = require(Shared.Util.Format)
local Net = require(Shared.Net)
local Quests = require(Shared.Catalog.Quests)
local Nations = require(script.Parent.Nations)

type Nation = Nations.Nation

local RewardService = {}
local S: { [string]: any }

local function today(): number
	return os.time() // 86400
end

---------------------------------------------------------------------------
-- Offline earnings
---------------------------------------------------------------------------
function RewardService.onJoin(n: Nation)
	local data = n.data
	n.giftAt = n.joinAt + Config.PlaytimeGiftInterval
	if data.LastOnline > 0 and data.LastPay > 0 then
		local away = os.time() - data.LastOnline
		if away > 120 then
			local capped = math.min(away, Config.OfflineEarningsHours * 3600 * (n.passes.VIP and 2 or 1))
			local rate = Config.OfflineEarningsRate * (n.passes.DoubleCash and 2 or 1)
			local amount = math.floor(data.LastPay * (capped / Config.PayInterval) * rate)
			if amount > 0 then
				data.Cash += amount
				Net.event("Effect"):FireClient(n.player, "Welcome", nil, amount, away)
			end
		end
	end
end

---------------------------------------------------------------------------
-- Daily / gift / group / codes
---------------------------------------------------------------------------
function RewardService.dailyReward(n: Nation, streak: number): number
	local base = Config.DailyRewards[((streak - 1) % #Config.DailyRewards) + 1]
	return math.floor(base + math.max(0, n.stats.gross or 0) * 2)
end

function RewardService.dailyInfo(n: Nation): { [string]: any }
	local d = n.data.Daily
	local canClaim = d.LastDay < today()
	local nextStreak = (d.LastDay == today() - 1) and d.Streak + 1 or (canClaim and 1 or d.Streak)
	return { streak = d.Streak, canClaim = canClaim, next = nextStreak, reward = RewardService.dailyReward(n, math.max(1, nextStreak)) }
end

function RewardService.giftReward(n: Nation): number
	return math.floor(math.max(5000, (n.stats.gross or 0) * Config.PlaytimeGiftPays))
end

local function onClaimDaily(player: Player)
	local n = Nations.get(player)
	if not n then
		return { ok = false }
	end
	local d = n.data.Daily
	if d.LastDay >= today() then
		return { ok = false, err = "Come back tomorrow!" }
	end
	d.Streak = (d.LastDay == today() - 1) and d.Streak + 1 or 1
	d.LastDay = today()
	local reward = RewardService.dailyReward(n, d.Streak)
	n.data.Cash += reward
	Nations.notify(player, ("Day %d reward: +%s"):format(d.Streak, Format.cash(reward)), "pay")
	S.StateService.push(n)
	return { ok = true, reward = reward }
end

local function onClaimPlaytime(player: Player)
	local n = Nations.get(player)
	if not n then
		return { ok = false }
	end
	local now = Nations.now()
	if now < n.giftAt then
		return { ok = false, err = "Gift not ready yet" }
	end
	local reward = RewardService.giftReward(n)
	n.data.Cash += reward
	n.giftAt = now + Config.PlaytimeGiftInterval
	Nations.notify(player, ("Playtime gift: +%s"):format(Format.cash(reward)), "pay")
	S.StateService.push(n)
	return { ok = true, reward = reward }
end

local function onClaimGroup(player: Player)
	local n = Nations.get(player)
	if not n or Config.GroupId == 0 then
		return { ok = false, err = "No group reward" }
	end
	if n.data.Flags.Group then
		return { ok = false, err = "Already claimed" }
	end
	local ok, inGroup = pcall(player.IsInGroup, player, Config.GroupId)
	if not ok or not inGroup then
		return { ok = false, err = "Join the group first, then claim!" }
	end
	n.data.Flags.Group = true
	n.data.Cash += Config.GroupRewardCash
	Nations.notify(player, ("Thanks for joining! +%s"):format(Format.cash(Config.GroupRewardCash)), "pay")
	S.StateService.push(n)
	return { ok = true }
end

local function onRedeem(player: Player, code: any)
	local n = Nations.get(player)
	if not n or typeof(code) ~= "string" then
		return { ok = false }
	end
	code = string.upper((code:gsub("%s", "")))
	local reward = Config.Codes[code]
	if not reward then
		return { ok = false, err = "Invalid code" }
	end
	if n.data.Redeemed[code] then
		return { ok = false, err = "Code already redeemed" }
	end
	n.data.Redeemed[code] = true
	n.data.Cash += reward
	Nations.notify(player, ("Code redeemed: +%s"):format(Format.cash(reward)), "pay")
	S.StateService.push(n)
	return { ok = true, reward = reward }
end

---------------------------------------------------------------------------
-- Quests
---------------------------------------------------------------------------
function RewardService.questProgress(n: Nation): (any?, number, number)
	local q = Quests[n.data.Quest]
	if not q then
		return nil, 0, 0
	end
	local data = n.data
	local cur = 0
	if q.kind == "build" then
		cur = Nations.countBuilt(n, q.target :: string)
	elseif q.kind == "population" then
		cur = math.floor(data.Population)
	elseif q.kind == "research" then
		cur = data.Researched[q.target :: string] and 1 or 0
	elseif q.kind == "stock" then
		cur = data.Inventory[q.target :: string] or 0
	elseif q.kind == "launch" then
		cur = data.Stats.Launches
	elseif q.kind == "hits" then
		cur = data.Stats.Hits
	elseif q.kind == "capture" then
		cur = data.Stats.Captures
	elseif q.kind == "units" then
		cur = S.UnitService.count(n)
	end
	return q, math.min(cur, q.count), q.count
end

function RewardService.tick(_n: Nation, _now: number)
	-- quest progress is computed on demand by StateService
end

local function onClaimQuest(player: Player)
	local n = Nations.get(player)
	if not n then
		return { ok = false }
	end
	local q, cur, max = RewardService.questProgress(n)
	if not q or cur < max then
		return { ok = false, err = "Objective not complete" }
	end
	n.data.Quest += 1
	n.data.Cash += q.reward
	Nations.notify(player, ("Objective complete: +%s"):format(Format.cash(q.reward)), "pay")
	S.StateService.push(n)
	return { ok = true, reward = q.reward }
end

function RewardService.init(services)
	S = services
end

function RewardService.start()
	Net.handle("ClaimDaily", onClaimDaily, 2)
	Net.handle("ClaimPlaytime", onClaimPlaytime, 2)
	Net.handle("ClaimGroup", onClaimGroup, 2)
	Net.handle("RedeemCode", onRedeem, 2)
	Net.handle("ClaimQuest", onClaimQuest, 3)
end

return RewardService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="45">
          <Properties>
            <string name="Name">StateService</string>
            <string name="Source"><![CDATA[--[[
	StateService
	Builds the local player's state snapshot and sends only the keys that
	changed since the last push (one small RemoteEvent per second at most).
]]

local HttpService = game:GetService("HttpService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage.Shared
local Config = require(Shared.Config)
local Net = require(Shared.Net)
local Weapons = require(Shared.Catalog.Weapons)
local Nations = require(script.Parent.Nations)

type Nation = Nations.Nation

local StateService = {}
local S: { [string]: any }

local function r1(x: number?): number
	return math.floor((x or 0) * 10 + 0.5) / 10
end

function StateService.snapshot(n: Nation): { [string]: any }
	local data = n.data
	local st = n.stats
	local now = Nations.now()

	local launchers = {}
	local seen = {}
	for _, w in Weapons.all() do
		if not seen[w.family] then
			seen[w.family] = true
			local total, ready, _, nextReady = S.CombatService.launcherState(n, w.family, now)
			if total > 0 then
				launchers[w.family] = { total = total, ready = ready, nextReady = nextReady ~= math.huge and nextReady or 0 }
			end
		end
	end

	local q, qCur, qMax = S.RewardService.questProgress(n)
	local quest: any = false
	if q then
		quest = { i = data.Quest, text = q.text, cur = qCur, max = qMax, reward = q.reward, done = qCur >= qMax }
	end

	local nation, rank = S.NationService.snapshot(n)

	return {
		nation = nation,
		rank = rank,
		cash = math.floor(data.Cash),
		income = math.floor(st.income or 0),
		gross = math.floor(st.gross or 0),
		upkeep = math.floor(st.upkeep or 0),
		mult = r1(st.mult or 1),
		nextPay = n.nextPayAt,
		pop = math.floor(data.Population),
		popCap = math.floor(st.housingCap or 0),
		workersDemand = math.floor(st.workersDemand or 0),
		workersUsed = math.floor(st.workersUsed or 0),
		happiness = math.floor(st.happiness or 0),
		power = { math.floor(st.powerSupply or 0), math.floor(st.powerDemand or 0) },
		water = { math.floor(st.waterSupply or 0), math.floor(st.waterDemand or 0) },
		oil = math.floor(data.Oil),
		oilCap = st.oilCap or Config.BaseResourceCap,
		oilRate = r1(st.oilRate),
		steel = math.floor(data.Steel),
		steelCap = st.steelCap or Config.BaseResourceCap,
		steelRate = r1(st.steelRate),
		rp = math.floor(data.ResearchPoints),
		rpRate = r1(st.rpRate),
		researched = data.Researched,
		research = data.ActiveResearch or false,
		inventory = data.Inventory,
		launchers = launchers,
		units = S.UnitService.count(n),
		unitCap = S.UnitService.cap(n),
		stats = data.Stats,
		pvp = data.Pvp,
		pvpLock = n.pvpLockUntil,
		shield = n.shieldUntil,
		passes = n.passes,
		boostUntil = data.BoostUntil,
		quest = quest,
		daily = S.RewardService.dailyInfo(n),
		giftAt = n.giftAt,
		giftReward = S.RewardService.giftReward(n),
		groupId = Config.GroupId,
		groupClaimed = data.Flags.Group == true,
		starter = data.Flags.StarterPack == true,
		plot = n.plotIndex,
		billboard = data.Billboard,
		queueLimit = S.ProductionService.queueLimit(n),
		damaged = st.damaged or 0,
		persistent = S.DataService.isPersistent(),
	}
end

-- Send changed keys (or everything when full = true).
function StateService.push(n: Nation, full: boolean?)
	if not n.ready or not n.player.Parent then
		return
	end
	local snap = StateService.snapshot(n)
	local patch = {}
	local any = false
	for k, v in snap do
		local enc = type(v) == "table" and HttpService:JSONEncode(v) or tostring(v)
		if full or n.sent[k] ~= enc then
			n.sent[k] = enc
			patch[k] = v
			any = true
		end
	end
	if any then
		Net.event("State"):FireClient(n.player, patch)
	end
end

function StateService.init(services)
	S = services
end

function StateService.start()
	Net.handle("GetSnapshot", function(player)
		local n = Nations.get(player)
		if not n or not n.ready then
			return nil
		end
		local snap = StateService.snapshot(n)
		for k, v in snap do
			n.sent[k] = type(v) == "table" and HttpService:JSONEncode(v) or tostring(v)
		end
		return snap
	end, 4)
end

return StateService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="46">
          <Properties>
            <string name="Name">UnitService</string>
            <string name="Source"><![CDATA[--[[
	UnitService
	Ground vehicles. Units are physics assemblies driven by AlignPosition /
	AlignOrientation (server-owned) so they glide smoothly on every client.

	They really drive: out of your city, over your bridge, across the central
	battlefield and, with PvP on, over a rival's bridge into their city. Every
	command is routed through the bridge waypoints. Units fight any enemy
	vehicle in the same theatre (the battlefield, or a city being raided),
	wear down strategic-point garrisons, and knock out buildings on raids.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage.Shared
local Config = require(Shared.Config)
local Grid = require(Shared.Util.Grid)
local Net = require(Shared.Net)
local Format = require(Shared.Util.Format)
local Units = require(Shared.Catalog.Units)
local ModelBuilder = require(Shared.ModelBuilder)
local Nations = require(script.Parent.Nations)

type Nation = Nations.Nation

export type Unit = {
	uid: number,
	id: string,
	def: any,
	n: Nation,
	hp: number,
	model: Model,
	root: BasePart,
	align: AlignPosition,
	orient: AlignOrientation,
	location: string, -- "home" | "mainland" (battlefield + bridges) | "raid"
	height: number,
	lastShot: number,
	path: { Vector3 },
}

local UnitService = {}
local S: { [string]: any }
local folder: Folder
local all: { [Unit]: boolean } = {}

-- Battlefield or a bridge (open warzone).
function UnitService.inMainland(pos: Vector3): boolean
	local zone = Grid.zoneAt(pos)
	return zone == "mainland" or zone == "bridge"
end

function UnitService.stagingPos(n: Nation): Vector3
	return Grid.landing(n.plotIndex)
end

function UnitService.cap(n: Nation): number
	local cap = 10 + (n.stats.depotCap or 0)
	if n.passes.VIP then
		cap += 10
	end
	if n.passes.ExtraQueue then
		cap += 20
	end
	return math.min(cap, Config.MaxUnitsPerPlayer + 20)
end

function UnitService.count(n: Nation): number
	local c = 0
	for _ in n.units do
		c += 1
	end
	return c
end

function UnitService.canAdd(n: Nation): boolean
	return UnitService.count(n) < UnitService.cap(n)
end

local function homePos(n: Nation, near: any?): Vector3
	local anchor: Vector3? = nil
	for _, b in n.buildings do
		if b.def.depot and Nations.isActive(b) then
			anchor = S.BuildService.worldCFrame(n, b).Position
			break
		end
	end
	if not anchor and near then
		anchor = S.BuildService.worldCFrame(n, near).Position
	end
	local base = anchor or Grid.yard(n.plotIndex)
	local rng = Random.new()
	local p = base + Vector3.new(rng:NextNumber(-18, 18), 0, rng:NextNumber(-18, 18))
	-- keep inside the island
	local half = Grid.PlotSize / 2 - 6
	local l = Grid.toLocal(n.plotIndex, p)
	return (Grid.plotCFrame(n.plotIndex) * CFrame.new(math.clamp(l.X, -half, half), 0, math.clamp(l.Z, -half, half))).Position
end

local function setTarget(u: Unit, pos: Vector3)
	local current = u.root.CFrame.Position
	local target = Vector3.new(pos.X, u.height, pos.Z)
	u.align.Position = target
	local flatDir = Vector3.new(target.X - current.X, 0, target.Z - current.Z)
	if flatDir.Magnitude > 1 then
		u.orient.CFrame = CFrame.lookAt(Vector3.zero, flatDir.Unit)
	end
	u.model:SetAttribute("Moving", true)
end

function UnitService.spawn(n: Nation, id: string, hp: number?, near: any?, uid: number?): Unit?
	local def = Units.get(id)
	if not def then
		return nil
	end
	local model = ModelBuilder.unit(def)
	local root = model.PrimaryPart :: BasePart
	local height = root.Size.Y / 2
	-- weld everything to the root and make it a physics assembly
	for _, p in model:GetDescendants() do
		if p:IsA("BasePart") then
			p.CanCollide = false
			p.CanTouch = false
			if p ~= root then
				p.Massless = true
				local w = Instance.new("WeldConstraint")
				w.Part0 = root
				w.Part1 = p
				w.Parent = p
			end
		end
	end
	local att = Instance.new("Attachment")
	att.Name = "Drive"
	att.Parent = root
	local align = Instance.new("AlignPosition")
	align.Mode = Enum.PositionAlignmentMode.OneAttachment
	align.Attachment0 = att
	align.MaxForce = 1e7
	align.MaxVelocity = def.speed * Config.UnitSpeedScale
	align.Responsiveness = 30
	align.Parent = root
	local orient = Instance.new("AlignOrientation")
	orient.Mode = Enum.OrientationAlignmentMode.OneAttachment
	orient.Attachment0 = att
	orient.MaxTorque = 1e7
	orient.Responsiveness = 18
	orient.Parent = root

	local unitUid = uid or n.nextUnitUid
	if unitUid >= n.nextUnitUid then
		n.nextUnitUid = unitUid + 1
	end
	model.Name = def.name
	model:SetAttribute("Unit", true)
	model:SetAttribute("UnitId", def.id)
	model:SetAttribute("Uid", unitUid)
	model:SetAttribute("OwnerId", n.userId)
	model:SetAttribute("OwnerName", n.player.DisplayName)
	model:SetAttribute("Hp", hp or def.hp)
	model:SetAttribute("MaxHp", def.hp)
	model:SetAttribute("Color", Config.NationColors[n.plotIndex] or Color3.new(1, 1, 1))

	local pos = homePos(n, near)
	model:PivotTo(CFrame.new(pos.X, height, pos.Z))
	for _, p in model:GetDescendants() do
		if p:IsA("BasePart") then
			p.Anchored = false
		end
	end
	align.Position = Vector3.new(pos.X, height, pos.Z)
	orient.CFrame = CFrame.new()
	model.Parent = folder
	pcall(function()
		root:SetNetworkOwner(nil)
	end)

	local u: Unit = {
		uid = unitUid,
		id = id,
		def = def,
		n = n,
		hp = hp or def.hp,
		model = model,
		root = root,
		align = align,
		orient = orient,
		location = "home",
		height = height,
		lastShot = 0,
		path = {},
	}
	n.units[unitUid] = u
	all[u] = true
	return u
end

function UnitService.remove(u: Unit, exploded: boolean?)
	all[u] = nil
	u.n.units[u.uid] = nil
	if exploded then
		Net.event("Effect"):FireAllClients("Explosion", u.root.CFrame.Position, 1)
	end
	u.model:Destroy()
end

-- Returns true if destroyed.
function UnitService.damage(u: Unit, amount: number, attacker: Nation?): boolean
	if not all[u] then
		return false
	end
	u.hp -= amount
	u.model:SetAttribute("Hp", math.max(0, math.floor(u.hp)))
	if u.hp <= 0 then
		Nations.notify(u.n.player, ("Your %s was destroyed"):format(u.def.name), "bad")
		if attacker then
			attacker.data.Stats.Kills += 1
		end
		UnitService.remove(u, true)
		return true
	end
	return false
end

function UnitService.unitsNear(pos: Vector3, radius: number, excludeUserId: number?): { Unit }
	local out = {}
	for u in all do
		if u.n.userId ~= excludeUserId then
			local p = u.root.CFrame.Position
			local d = Vector2.new(p.X - pos.X, p.Z - pos.Z).Magnitude
			if d <= radius then
				table.insert(out, u)
			end
		end
	end
	return out
end

function UnitService.mainlandUnits(): { Unit }
	local out = {}
	for u in all do
		if u.location == "mainland" then
			table.insert(out, u)
		end
	end
	return out
end

function UnitService.loadNation(n: Nation)
	for _, s in n.data.Units do
		if UnitService.count(n) >= Config.MaxUnitsPerPlayer + 20 then
			break
		end
		UnitService.spawn(n, s.id, s.hp, nil, s.u)
	end
end

function UnitService.serialize(n: Nation)
	local out = {}
	for _, u in n.units do
		table.insert(out, { u = u.uid, id = u.id, hp = math.floor(u.hp) })
	end
	n.data.Units = out
end

function UnitService.clearNation(n: Nation)
	for _, u in n.units do
		UnitService.remove(u, false)
	end
end

---------------------------------------------------------------------------
-- Commands
---------------------------------------------------------------------------
local function collect(n: Nation, uids: any, filter: ((Unit) -> boolean)?): { Unit }
	local out = {}
	if typeof(uids) == "table" then
		for i, uid in uids do
			if i > 100 then
				break
			end
			local u = typeof(uid) == "number" and n.units[uid] or nil
			if u and (not filter or filter(u)) then
				table.insert(out, u)
			end
		end
	else
		for _, u in n.units do
			if not filter or filter(u) then
				table.insert(out, u)
			end
		end
	end
	return out
end

---------------------------------------------------------------------------
-- Routing: city -> yard -> gate -> bridge -> shore -> battlefield -> ...
---------------------------------------------------------------------------
local function flat(v: Vector3): Vector3
	return Vector3.new(v.X, 0, v.Z)
end

-- Waypoints from `from` to `to` through the bridges (straight lines on land).
function UnitService.route(from: Vector3, to: Vector3): { Vector3 }
	local zf, i = Grid.zoneAt(from)
	local zt, j = Grid.zoneAt(to)
	local out: { Vector3 } = {}
	local function add(p: Vector3)
		table.insert(out, flat(p))
	end
	local function intoTarget()
		if zt == "bridge" and j then
			add(Grid.landing(j))
			add(Grid.shore(j))
		elseif zt == "plot" and j then
			add(Grid.landing(j))
			add(Grid.shore(j))
			add(Grid.gate(j))
			add(Grid.yard(j))
		end
	end
	if zf == "plot" and i then
		if zt == "plot" and j == i then
			add(to)
			return out
		end
		add(Grid.yard(i))
		add(Grid.gate(i))
		if zt == "bridge" and j == i then
			add(to)
			return out
		end
		add(Grid.shore(i))
		add(Grid.landing(i))
	elseif zf == "bridge" and i then
		if zt == "plot" and j == i then
			add(Grid.gate(i))
			add(Grid.yard(i))
			add(to)
			return out
		elseif zt == "bridge" and j == i then
			add(to)
			return out
		end
		add(Grid.shore(i))
		add(Grid.landing(i))
	end
	intoTarget()
	add(to)
	-- drop waypoints that are behind us or doubled
	local cleaned: { Vector3 } = {}
	local last = flat(from)
	for _, p in out do
		if (p - last).Magnitude > 4 then
			table.insert(cleaned, p)
			last = p
		end
	end
	return cleaned
end

local function drive(u: Unit, target: Vector3)
	u.path = UnitService.route(u.root.CFrame.Position, target)
	local first = table.remove(u.path, 1)
	if first then
		setTarget(u, first)
	end
end

-- Theatre a unit is fighting in: "mainland" (battlefield + bridges), the
-- index of the island it's on, or nil when safe at home.
local function locate(u: Unit): (string, number?)
	local zone, idx = Grid.zoneAt(u.root.CFrame.Position)
	if zone == "plot" and idx == u.n.plotIndex then
		return "home", idx
	elseif zone == "plot" then
		return "raid", idx
	end
	return "mainland", nil
end

local function updateLocation(u: Unit)
	local loc = locate(u)
	if loc ~= u.location then
		u.location = loc
		u.model:SetAttribute("Location", loc)
	end
end

local function canRaid(n: Nation, defender: Nation?): (boolean, string?)
	if not defender or not defender.ready then
		return false, "Nobody lives there"
	end
	if not n.data.Pvp then
		return false, "Turn PvP ON to invade other nations"
	end
	if not defender.data.Pvp then
		return false, defender.player.DisplayName .. " has PvP OFF"
	end
	if S.CombatService.isShielded(defender) then
		return false, defender.player.DisplayName .. " is protected by the new-nation shield"
	end
	return true, nil
end

local function formation(units: { Unit }, target: Vector3): { Vector3 }
	local cols = math.ceil(math.sqrt(#units))
	local spacing = 11
	local out = {}
	for i = 1, #units do
		local row = (i - 1) // cols
		local col = (i - 1) % cols
		table.insert(out, target + Vector3.new((col - (cols - 1) / 2) * spacing, 0, (row - (cols - 1) / 2) * spacing))
	end
	return out
end

local function onCommand(player: Player, uids: any, target: any)
	local n = Nations.get(player)
	if not n or typeof(target) ~= "Vector3" or target.X ~= target.X or math.abs(target.X) > 1e5 or math.abs(target.Z) > 1e5 then
		return { ok = false, err = "Invalid request" }
	end
	local units = collect(n, uids)
	if #units == 0 then
		return { ok = false, err = "Select units first" }
	end
	local zone, idx = Grid.zoneAt(target)
	if zone == "sea" then
		return { ok = false, err = "Vehicles can't drive on water" }
	end
	if zone == "plot" and idx ~= n.plotIndex then
		local owner = S.PlotService.ownerAt(target)
		local ok, err = canRaid(n, owner and Nations.get(owner) or nil)
		if not ok then
			return { ok = false, err = err }
		end
		n.pvpLockUntil = Nations.now() + Config.PvpToggleCooldown
		n.shieldUntil = 0
	end
	local spots = formation(units, target)
	for i, u in units do
		drive(u, spots[i])
	end
	return { ok = true, count = #units }
end

local function onDeploy(player: Player, uids: any)
	local n = Nations.get(player)
	if not n then
		return { ok = false }
	end
	local units = collect(n, uids, function(u)
		return u.location == "home"
	end)
	local spots = formation(units, UnitService.stagingPos(n))
	for i, u in units do
		drive(u, spots[i])
	end
	if #units > 0 then
		Nations.notify(player, ("%d vehicles rolling out over the bridge to the front"):format(#units), "good")
	end
	return { ok = #units > 0, count = #units, err = #units == 0 and "No units at home" or nil }
end

local function onRecall(player: Player, uids: any)
	local n = Nations.get(player)
	if not n then
		return { ok = false }
	end
	local units = collect(n, uids, function(u)
		return u.location ~= "home"
	end)
	for _, u in units do
		drive(u, homePos(n))
	end
	return { ok = #units > 0, count = #units, err = #units == 0 and "No units on the battlefield" or nil }
end

-- Advance along the route; refresh where each unit is.
local function moveStep()
	for u in all do
		if u.model:GetAttribute("Moving") then
			local d = (u.align.Position - u.root.CFrame.Position) * Vector3.new(1, 0, 1)
			if d.Magnitude < 6 then
				local nextPoint = table.remove(u.path, 1)
				if nextPoint then
					setTarget(u, nextPoint)
				elseif d.Magnitude < 2 then
					u.model:SetAttribute("Moving", nil)
				end
			end
		end
		updateLocation(u)
	end
end

UnitService._moveStep = moveStep

---------------------------------------------------------------------------
-- Combat loop: battlefield fights, city raids and their defenders
---------------------------------------------------------------------------
local STEP = 0.5
local raidNotice: { [Nation]: number } = {}

-- Units fight when they're from different nations in the same theatre.
local function theatre(u: Unit): string
	local loc, idx = locate(u)
	if loc == "mainland" then
		return "mainland"
	end
	return "plot" .. tostring(idx)
end

local function raidAllowed(u: Unit, defender: Nation?): boolean
	return defender ~= nil and u.n.data.Pvp == true and defender.data.Pvp == true and not S.CombatService.isShielded(defender)
end

local function buildingTarget(u: Unit, defender: Nation, pos: Vector3): any?
	local best, bestD = nil, u.def.range
	for _, b in defender.buildings do
		if not b.damaged and not S.BuildService.isRoadDef(b.def) then
			local c = S.BuildService.worldCFrame(defender, b).Position
			local reach = math.min(b.def.size[1], b.def.size[2]) * Config.CellSize / 2
			local d = math.max(0, (Vector3.new(c.X, 0, c.Z) - Vector3.new(pos.X, 0, pos.Z)).Magnitude - reach)
			if d <= bestD then
				best, bestD = b, d
			end
		end
	end
	return best
end

local function combatStep()
	local now = os.clock()
	local byTheatre: { [string]: { Unit } } = {}
	for u in all do
		local t = theatre(u)
		byTheatre[t] = byTheatre[t] or {}
		table.insert(byTheatre[t], u)
	end
	for t, units in byTheatre do
		local plotIdx = tonumber(string.match(t, "^plot(%d+)$"))
		local owner = plotIdx and S.PlotService.ownerAt(Grid.plotOrigin(plotIdx)) or nil
		local defender = owner and Nations.get(owner) or nil
		for _, u in units do
			if all[u] and u.def.dps > 0 then
				local pos = u.root.CFrame.Position
				-- in a city, only fight when the raid is legal
				local legal = t == "mainland" or (defender ~= nil and (u.n == defender or raidAllowed(u, defender)))
				local best, bestD = nil, u.def.range
				if legal then
					for _, other in units do
						if other.n ~= u.n and all[other] and (t == "mainland" or other.n == defender or u.n == defender) then
							local d = (other.root.CFrame.Position - pos).Magnitude
							if d <= bestD then
								best, bestD = other, d
							end
						end
					end
				end
				if best then
					if now - u.lastShot > 1 then
						u.lastShot = now
						Net.event("Effect"):FireAllClients("Shot", pos + Vector3.new(0, 2, 0), best.root.CFrame.Position, u.def.range > 150)
					end
					UnitService.damage(best, u.def.dps * STEP, u.n)
				elseif t == "mainland" then
					local point = S.ConquestService.enemyPointInRange(pos, u.def.range, u.n.userId)
					if point then
						if now - u.lastShot > 1.2 then
							u.lastShot = now
							Net.event("Effect"):FireAllClients("Shot", pos + Vector3.new(0, 2, 0), point.center + Vector3.new(0, 4, 0), u.def.range > 150)
						end
						S.ConquestService.damageGarrison(point, u.def.dps * STEP, u.n)
					end
				elseif defender and u.n ~= defender and raidAllowed(u, defender) then
					local b = buildingTarget(u, defender, pos)
					if b then
						if now - u.lastShot > 1.2 then
							u.lastShot = now
							Net.event("Effect"):FireAllClients("Shot", pos + Vector3.new(0, 2, 0), S.BuildService.worldCFrame(defender, b).Position + Vector3.new(0, 4, 0), u.def.range > 150)
						end
						local wasDamaged = b.damaged
						S.BuildService.damage(defender, b, u.def.dps * STEP * Config.RaidBuildingDamage)
						if b.damaged and not wasDamaged then
							local loot = math.floor(b.cost * Config.StrikeLootRate)
							u.n.data.Cash += loot
							Nations.notify(u.n.player, ("Your %s knocked out a %s%s"):format(u.def.name, b.def.name, loot > 0 and (" +" .. Format.cash(loot)) or ""), "good")
						end
						if (raidNotice[defender] or 0) < now then
							raidNotice[defender] = now + 30
							Nations.notify(defender.player, ("%s's vehicles are attacking your city!"):format(u.n.player.DisplayName), "bad")
						end
					end
				end
			end
		end
	end
end

-- exposed for automated tests
UnitService._combatStep = combatStep

function UnitService.init(services)
	S = services
	folder = Instance.new("Folder")
	folder.Name = "Units"
	folder.Parent = workspace
end

function UnitService.start()
	Net.handle("CommandUnits", onCommand, 6)
	Net.handle("DeployUnits", onDeploy, 3)
	Net.handle("RecallUnits", onRecall, 3)
	task.spawn(function()
		while true do
			task.wait(0.2)
			local ok, err = pcall(moveStep)
			if not ok then
				warn("[Units] move step failed: " .. tostring(err))
			end
		end
	end)
	task.spawn(function()
		while true do
			task.wait(STEP)
			local ok, err = pcall(combatStep)
			if not ok then
				warn("[Units] combat step failed: " .. tostring(err))
			end
		end
	end)
end

return UnitService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="47">
          <Properties>
            <string name="Name">WorldService</string>
            <string name="Source"><![CDATA[--[[
	WorldService
	Day / night cycle. Days are long, nights short (Config.NightShare), and the
	clock replicates through Lighting so every client sees the same sky. At
	night, buildings switch on their window and beacon lights (client side,
	see NightLights).
]]

local Lighting = game:GetService("Lighting")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage.Shared.Config)

local WorldService = {}

-- Maps a 0..1 phase of the cycle onto a 24h clock: day spans 06:00-18:00
-- over (1 - NightShare) of the cycle, night spans 18:00-06:00 over the rest.
function WorldService.clockAt(phase: number): number
	local dayShare = 1 - Config.NightShare
	phase = phase % 1
	if phase < dayShare then
		return 6 + 12 * (phase / dayShare)
	end
	return (18 + 12 * ((phase - dayShare) / Config.NightShare)) % 24
end

function WorldService.isNight(clock: number): boolean
	return clock >= 18.4 or clock < 5.6
end

function WorldService.init(_S) end

function WorldService.start()
	task.spawn(function()
		-- start mid-morning so a fresh server opens in daylight
		local offset = 0.2 * Config.DayLength
		while true do
			local phase = ((workspace:GetServerTimeNow() + offset) / Config.DayLength) % 1
			Lighting.ClockTime = WorldService.clockAt(phase)
			task.wait(0.5)
		end
	end)
end

return WorldService
]]></string>
          </Properties>
        </Item>
      </Item>
    </Item>
