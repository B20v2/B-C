  <Item class="StarterPlayer" referent="49">
    <Properties>
      <string name="Name">StarterPlayer</string>
      <float name="CameraMaxZoomDistance">450</float>
      <float name="CameraMinZoomDistance">8</float>
    </Properties>
    <Item class="StarterPlayerScripts" referent="50">
      <Properties>
        <string name="Name">StarterPlayerScripts</string>
      </Properties>
      <Item class="Folder" referent="51">
        <Properties>
          <string name="Name">Client</string>
        </Properties>
        <Item class="ModuleScript" referent="52">
          <Properties>
            <string name="Name">ClientState</string>
            <string name="Source"><![CDATA[--[[
	ClientState
	Holds the latest state the server sent for the local player and lets
	controllers subscribe to changes. Also tracks the client "mode":
	  "play"  - walking around your nation
	  "build" - build menu open / placing / deleting / moving
	  "war"   - strategic camera (Travel): aim weapons, command units
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Net = require(ReplicatedStorage.Shared.Net)

local ClientState = {}

ClientState.data = {} :: { [string]: any }
ClientState.mode = "play"
ClientState.player = Players.LocalPlayer

local keyListeners: { [string]: { (any) -> () } } = {}
local anyListeners: { (patch: { [string]: any }) -> () } = {}
local modeListeners: { (string, string) -> () } = {}

local function fire(patch: { [string]: any })
	for k, v in patch do
		ClientState.data[k] = v
	end
	for k, v in patch do
		local list = keyListeners[k]
		if list then
			for _, fn in list do
				task.spawn(fn, v)
			end
		end
	end
	for _, fn in anyListeners do
		task.spawn(fn, patch)
	end
end

-- Subscribe to one key; called immediately if a value already exists.
function ClientState.on(key: string, fn: (any) -> ())
	keyListeners[key] = keyListeners[key] or {}
	table.insert(keyListeners[key], fn)
	if ClientState.data[key] ~= nil then
		task.spawn(fn, ClientState.data[key])
	end
end

-- Returns a function that unsubscribes.
function ClientState.onAny(fn: (patch: { [string]: any }) -> ()): () -> ()
	table.insert(anyListeners, fn)
	return function()
		local i = table.find(anyListeners, fn)
		if i then
			table.remove(anyListeners, i)
		end
	end
end

function ClientState.get(key: string): any
	return ClientState.data[key]
end

function ClientState.setMode(mode: string)
	local old = ClientState.mode
	if old == mode then
		return
	end
	ClientState.mode = mode
	for _, fn in modeListeners do
		task.spawn(fn, mode, old)
	end
end

function ClientState.onMode(fn: (string, string) -> ())
	table.insert(modeListeners, fn)
end

function ClientState.start()
	Net.event("State").OnClientEvent:Connect(fire)
	task.spawn(function()
		for _ = 1, 60 do
			local snap = Net.request("GetSnapshot")
			if type(snap) == "table" and snap.cash ~= nil then
				fire(snap)
				return
			end
			task.wait(1)
		end
	end)
end

return ClientState
]]></string>
          </Properties>
        </Item>
        <Item class="Folder" referent="53">
          <Properties>
            <string name="Name">Controllers</string>
          </Properties>
          <Item class="ModuleScript" referent="54">
            <Properties>
              <string name="Name">Animator</string>
              <string name="Source"><![CDATA[--[[
	Animator
	Makes the cities feel alive (client-side only, distance culled):
	  * wind turbine rotors and radar dishes spin, pump jacks rock
	  * construction progress bars over buildings being built
	  * fuel trucks drive refinery -> factory -> refinery along the grid
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Shared = ReplicatedStorage.Shared
local ModelBuilder = require(Shared.ModelBuilder)
local Format = require(Shared.Util.Format)

local Client = script.Parent.Parent
local Lib = require(Client.UI.Lib)
local Theme = require(Client.UI.Theme)

local New = Lib.New

local Animator = {}

local camera = workspace.CurrentCamera
local CULL = 650

type Spinner = { sub: Model, base: CFrame, speed: number, axis: string, rock: number?, phase: number }

local spinners: { [Model]: Spinner } = {}
local bars: { [Model]: { gui: BillboardGui, bar: Lib.Progress, label: TextLabel } } = {}
local trucks: { [string]: Model } = {}
local refineries: { [Model]: boolean } = {}

local function axisAngles(axis: string, angle: number): CFrame
	if axis == "X" then
		return CFrame.Angles(angle, 0, 0)
	elseif axis == "Y" then
		return CFrame.Angles(0, angle, 0)
	end
	return CFrame.Angles(0, 0, angle)
end

local function registerSpinners(building: Model)
	for _, d in building:GetDescendants() do
		if d:IsA("Model") and (d:GetAttribute("Spin") or d:GetAttribute("Rock")) and d.PrimaryPart then
			spinners[d] = {
				sub = d,
				base = d:GetPivot(),
				speed = (d:GetAttribute("Spin") :: number?) or 2,
				axis = (d:GetAttribute("SpinAxis") :: string?) or "Y",
				rock = d:GetAttribute("Rock") :: number?,
				phase = math.random() * 10,
			}
		end
	end
	local base = building.PrimaryPart
	if base then
		-- the server moved the building: re-read the rest pose
		base:GetPropertyChangedSignal("CFrame"):Connect(function()
			task.defer(function()
				for sub, s in spinners do
					if sub:IsDescendantOf(building) then
						s.base = sub:GetPivot()
					end
				end
			end)
		end)
	end
end

local function updateBar(building: Model)
	local finishAt = building:GetAttribute("FinishAt") :: number?
	local existing = bars[building]
	if finishAt and not existing then
		local base = building.PrimaryPart
		if not base then
			return
		end
		local gui = New("BillboardGui", {
			Name = "Construction",
			Adornee = base,
			Size = UDim2.fromOffset(120, 34),
			StudsOffsetWorldSpace = Vector3.new(0, 12, 0),
			AlwaysOnTop = true,
			MaxDistance = 380,
			LightInfluence = 0,
			Parent = building,
		})
		local card = New("Frame", {
			BackgroundColor3 = Theme.Color.Hud,
			BackgroundTransparency = 0.2,
			Size = UDim2.fromScale(1, 1),
			Parent = gui,
		}, { Lib.corner(6), Lib.pad(4, 8) })
		local label = Lib.text({ Text = "", TextColor3 = Color3.new(1, 1, 1), TextSize = 12, FontFace = Theme.Font.Bold, TextXAlignment = Enum.TextXAlignment.Center, Size = UDim2.new(1, 0, 0, 16), Parent = card })
		local bar = Lib.progress({ Position = UDim2.new(0, 0, 1, -6), Size = UDim2.new(1, 0, 0, 5), Parent = card })
		bars[building] = { gui = gui, bar = bar, label = label }
	elseif not finishAt and existing then
		existing.gui:Destroy()
		bars[building] = nil
	end
end

local function hookBuilding(building: Instance)
	if not building:IsA("Model") then
		return
	end
	task.defer(function()
		registerSpinners(building)
		updateBar(building)
		if building:GetAttribute("BuildingId") and tostring(building:GetAttribute("BuildingId")):find("refinery") then
			refineries[building] = true
		end
	end)
	building:GetAttributeChangedSignal("FinishAt"):Connect(function()
		updateBar(building)
	end)
	building.AncestryChanged:Connect(function()
		if not building.Parent then
			for sub in spinners do
				if not sub.Parent or sub:IsDescendantOf(building) then
					spinners[sub] = nil
				end
			end
			if bars[building] then
				bars[building] = nil
			end
			refineries[building] = nil
		end
	end)
end

local function hookPlot(plot: Instance)
	local folder = plot:WaitForChild("Buildings", 10)
	if not folder then
		return
	end
	folder.ChildAdded:Connect(hookBuilding)
	for _, b in folder:GetChildren() do
		hookBuilding(b)
	end
end

---------------------------------------------------------------------------
-- Trucks
---------------------------------------------------------------------------
local function truckModel(key: string): Model
	local m = trucks[key]
	if not m then
		m = ModelBuilder.fuelTruck()
		m.Parent = workspace:FindFirstChild("FX") or workspace
		trucks[key] = m
	end
	return m
end

-- L-shaped route: along X first, then Z.
local function routePoint(a: Vector3, b: Vector3, f: number): (Vector3, Vector3)
	local corner = Vector3.new(b.X, 0, a.Z)
	local l1 = math.abs(b.X - a.X)
	local l2 = math.abs(b.Z - a.Z)
	local total = math.max(0.01, l1 + l2)
	local d = f * total
	if d <= l1 then
		local dir = Vector3.new(b.X >= a.X and 1 or -1, 0, 0)
		return Vector3.new(a.X, 0, a.Z) + dir * d, dir
	end
	local dir = Vector3.new(0, 0, b.Z >= a.Z and 1 or -1)
	return corner + dir * (d - l1), dir
end

local function updateTrucks(now: number)
	local active: { [string]: boolean } = {}
	local camPos = camera.CFrame.Position
	for refinery in refineries do
		local folder = refinery.Parent
		if folder and refinery.PrimaryPart then
			for i = 1, 3 do
				local attr = refinery:GetAttribute("Truck" .. i) :: string?
				if attr and attr ~= "" then
					local uidStr, depart, arrive, ret = attr:match("^(%d+)|([%d%.]+)|([%d%.]+)|([%d%.]+)$")
					local target = uidStr and folder:FindFirstChild(uidStr) :: Model?
					local a = refinery:GetPivot().Position
					if target and depart and arrive and ret and (a - camPos).Magnitude < CULL * 1.5 then
						local b = target:GetPivot().Position
						local t0, t1, t2 = tonumber(depart) :: number, tonumber(arrive) :: number, tonumber(ret) :: number
						local pos, dir
						if now <= t1 then
							pos, dir = routePoint(a, b, math.clamp((now - t0) / math.max(0.1, t1 - t0), 0, 1))
						else
							pos, dir = routePoint(b, a, math.clamp((now - t1) / math.max(0.1, t2 - t1), 0, 1))
						end
						-- reversed route on the way back so the truck retraces the L
						local key = refinery.Name .. "_" .. i
						active[key] = true
						local m = truckModel(key)
						m:PivotTo(CFrame.lookAt(pos + Vector3.new(0, 0.2, 0), pos + Vector3.new(0, 0.2, 0) + dir))
					end
				end
			end
		end
	end
	for key, m in trucks do
		if not active[key] then
			m:Destroy()
			trucks[key] = nil
		end
	end
end

---------------------------------------------------------------------------
-- Frame loop
---------------------------------------------------------------------------
local function step()
	local now = Lib.serverNow()
	local t = os.clock()
	local camPos = camera.CFrame.Position
	for sub, s in spinners do
		if sub.Parent and (s.base.Position - camPos).Magnitude < CULL then
			local angle
			if s.rock then
				angle = math.sin(t * 2.2 + s.phase) * s.rock
				sub:PivotTo(s.base * CFrame.Angles(angle, 0, 0))
			else
				angle = (t + s.phase) * s.speed
				sub:PivotTo(s.base * axisAngles(s.axis, angle))
			end
		end
	end
	for building, b in bars do
		local finishAt = building:GetAttribute("FinishAt") :: number?
		local start = building:GetAttribute("BuildStart") :: number?
		if finishAt and start then
			b.bar.set((now - start) / math.max(0.1, finishAt - start), Theme.Color.Accent)
			b.label.Text = "Building " .. Format.clock(finishAt - now)
		end
	end
	updateTrucks(now)
end

function Animator.init()
	task.spawn(function()
		local homeland = workspace:WaitForChild("Homeland")
		homeland.ChildAdded:Connect(function(c)
			if c.Name:match("^Plot_") then
				hookPlot(c)
			end
		end)
		for _, c in homeland:GetChildren() do
			if c.Name:match("^Plot_") then
				task.spawn(hookPlot, c)
			end
		end
	end)
	RunService.RenderStepped:Connect(step)
end

return Animator
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="55">
            <Properties>
              <string name="Name">ArmyUI</string>
              <string name="Source"><![CDATA[--[[
	ArmyUI
	Your forces: unit-type cards with 3D previews, roles, stats and how many
	are at home vs. out at the front, plus DEPLOY ALL / RECALL ALL / COMMAND.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage.Shared
local Units = require(Shared.Catalog.Units)
local ModelBuilder = require(Shared.ModelBuilder)
local Unlocks = require(Shared.Util.Unlocks)
local Net = require(Shared.Net)

local Client = script.Parent.Parent
local ClientState = require(Client.ClientState)
local Hub = require(Client.Hub)
local Lib = require(Client.UI.Lib)
local Theme = require(Client.UI.Theme)
local Icons = require(Client.UI.Icons)
local Modal = require(script.Parent.Modal)
local Notifications = require(script.Parent.Notifications)
local Sounds = require(script.Parent.Sounds)
local UnitView = require(script.Parent.UnitView)

local New = Lib.New
local C = Theme.Color

local ArmyUI = {}

local ROLE_COLORS = {
	IFV = C.Info,
	Tank = C.Gold,
	Artillery = C.Military,
	["Anti-Air"] = C.Teal,
	Capture = C.Good,
}

function ArmyUI.open()
	local win = Modal.open("Army Command", "Build vehicles in Military Factories · they drive over your bridge to the front", 980, 620)
	local ic = Icons.tank(36, Color3.fromRGB(170, 200, 130))
	ic.Position = UDim2.fromOffset(8, 6)
	ic.Parent = win.iconHolder

	local mine = UnitView.mine()
	local byType: { [string]: { home: number, mainland: number } } = {}
	local deployed = 0
	for _, m in mine do
		local id = m:GetAttribute("UnitId") :: string
		byType[id] = byType[id] or { home = 0, mainland = 0 }
		if (m:GetAttribute("Location") or "home") ~= "home" then
			byType[id].mainland += 1
			deployed += 1
		else
			byType[id].home += 1
		end
	end

	local top = New("Frame", { BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 64), Parent = win.body }, { Lib.list("x", 8, nil, Enum.VerticalAlignment.Center) })
	local function stat(caption: string, value: string, color: Color3, order: number)
		local card = Lib.card({ Size = UDim2.fromOffset(170, 64), LayoutOrder = order, Parent = top }, { Lib.pad(9, 12) })
		Lib.caption(caption, { Parent = card })
		Lib.display({ Text = value, TextSize = 22, TextColor3 = color, Position = UDim2.fromOffset(0, 18), Size = UDim2.new(1, 0, 0, 26), Parent = card })
	end
	stat("Vehicles", ("%d / %d"):format(ClientState.get("units") or #mine, ClientState.get("unitCap") or 10), C.Text, 1)
	stat("Out at the front", tostring(deployed), C.Military, 2)
	local function action(name: string, text: string, variant: string, order: number, fn: () -> ())
		Lib.button({ Name = name, Variant = variant, Text = text, TextSize = 13, Size = UDim2.fromOffset(150, 44), LayoutOrder = order, Parent = top, Activated = fn })
	end
	action("DeployAll", "DEPLOY ALL", "primary", 3, function()
		local res = Net.request("DeployUnits", nil)
		if res.ok then
			Sounds.play("Whoosh")
			Modal.close()
			Hub.call("goWar", "mainland")
		elseif res.err then
			Notifications.show(res.err, "info")
		end
	end)
	action("RecallAll", "RECALL ALL", "secondary", 4, function()
		local res = Net.request("RecallUnits", nil)
		if res.ok then
			Modal.close()
		elseif res.err then
			Notifications.show(res.err, "info")
		end
	end)
	action("Command", "COMMAND", "secondary", 5, function()
		Modal.close()
		Hub.call("goWar", "mainland")
		for _, m in UnitView.mine() do
			if (m:GetAttribute("Location") or "home") ~= "home" then
				UnitView.select(m, true)
			end
		end
	end)

	local list = Lib.scroll({ Position = UDim2.fromOffset(0, 76), Size = UDim2.new(1, 0, 1, -76), Parent = win.body })
	New("UIGridLayout", { CellSize = UDim2.new(1 / 3, -8, 0, 214), CellPadding = UDim2.fromOffset(8, 8), SortOrder = Enum.SortOrder.LayoutOrder, Parent = list })
	local access = { researched = ClientState.get("researched") or {}, passes = ClientState.get("passes") or {} }
	for i, def in Units.all() do
		local counts = byType[def.id]
		local unlocked = Unlocks.check(def, access)
		if counts or unlocked then
			local card = Lib.card({ Name = def.id, LayoutOrder = counts and i or 100 + i, Parent = list }, { Lib.pad(8) })
			local art = Lib.inset({ Size = UDim2.new(1, 0, 0, 92), Parent = card })
			New("UIGradient", { Color = ColorSequence.new(Color3.fromRGB(38, 48, 40), C.Ink), Rotation = 90, Parent = art })
			Lib.viewport(ModelBuilder.unit(def), { Parent = art }, 35)
			local roleCol = ROLE_COLORS[def.role] or C.Text
			Lib.chip(string.upper(def.role), roleCol:Lerp(C.Ink, 0.75), roleCol, { Position = UDim2.fromOffset(6, 6), Parent = art })
			Lib.display({ Text = string.upper(def.name), TextSize = 16, Position = UDim2.fromOffset(2, 98), Size = UDim2.new(1, -4, 0, 20), Parent = card })
			Lib.text({
				Text = ("HP %d · DMG %d/s · RNG %d · CAP %d"):format(def.hp, def.dps, def.range, def.capture),
				FontFace = Theme.Font.Mono,
				TextSize = 10,
				TextColor3 = C.Muted,
				Position = UDim2.fromOffset(2, 120),
				Size = UDim2.new(1, -4, 0, 14),
				Parent = card,
			})
			Lib.text({ Text = def.desc, TextSize = 12, TextColor3 = C.TextSoft, TextWrapped = true, Position = UDim2.fromOffset(2, 136), Size = UDim2.new(1, -4, 0, 30), TextYAlignment = Enum.TextYAlignment.Top, Parent = card })
			local chips = New("Frame", { BackgroundTransparency = 1, AnchorPoint = Vector2.new(0, 1), Position = UDim2.new(0, 2, 1, 0), Size = UDim2.new(1, -4, 0, 20), Parent = card }, { Lib.list("x", 6) })
			if counts then
				Lib.chip(("%d HOME"):format(counts.home), C.InfoSoft, C.Info, { Parent = chips })
				Lib.chip(("%d DEPLOYED"):format(counts.mainland), C.BadSoft, C.Military, { Parent = chips })
			else
				Lib.chip("NONE BUILT", C.Inset, C.Faint, { Parent = chips })
			end
		end
	end
	if #mine == 0 then
		Lib.text({
			Name = "Empty",
			Text = "No vehicles yet. Research Mechanized Forces, build a Military Factory, then queue vehicles from its panel.",
			TextWrapped = true,
			TextColor3 = C.Muted,
			LayoutOrder = 999,
			Parent = list,
		})
	end
end

function ArmyUI.init()
	Hub.openArmy = ArmyUI.open
end

return ArmyUI
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="56">
            <Properties>
              <string name="Name">BuildMenu</string>
              <string name="Source"><![CDATA[--[[
	BuildMenu - the build drawer
	  [ department: CIVIL / MILITARY ]
	  [ tabs · faction toggle / structure cards with 3D previews ]
	  [ detail: spinning preview, cost, stats / tools: DEMOLISH 2, UNDO 3,
	    DRAG 4, MOVE 5, ROTATE 6, CLOSE ]
	plus the placement hint bar above the drawer.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")

local Shared = ReplicatedStorage.Shared
local Config = require(Shared.Config)
local Buildings = require(Shared.Catalog.Buildings)
local Weapons = require(Shared.Catalog.Weapons)
local Research = require(Shared.Catalog.Research)
local Products = require(Shared.Catalog.Products)
local ModelBuilder = require(Shared.ModelBuilder)
local Unlocks = require(Shared.Util.Unlocks)
local Format = require(Shared.Util.Format)

local Client = script.Parent.Parent
local ClientState = require(Client.ClientState)
local Hub = require(Client.Hub)
local Lib = require(Client.UI.Lib)
local Theme = require(Client.UI.Theme)
local Icons = require(Client.UI.Icons)
local Placement = require(script.Parent.Placement)
local Notifications = require(script.Parent.Notifications)
local Sounds = require(script.Parent.Sounds)

local New = Lib.New
local C = Theme.Color

local BuildMenu = {}

local root: Frame
local tooltip: Frame
local category = "Civilian"
local tab = "Housing"
local faction = "Standard"
local refs: { [string]: any } = {}
local cards: { [string]: { btn: TextButton, lock: Frame, price: TextLabel, def: any } } = {}
local thumbs: { [string]: Model } = {}
local lastDetail: string? = nil

local W, H = 1520, 250
local LEFT = 150
local RIGHT = 410

local function access(): Unlocks.Access
	return {
		researched = ClientState.get("researched") or {},
		passes = ClientState.get("passes") or {},
	}
end

local function thumbModel(def): Model
	local m = thumbs[def.id]
	if not m then
		m = ModelBuilder.building(def)
		thumbs[def.id] = m
	end
	return m
end

function BuildMenu.describe(def): string
	local bits = {}
	if def.launcher then
		local w
		for _, wd in Weapons.all() do
			if wd.family == def.launcher then
				w = wd
				break
			end
		end
		return ("Fires %s · stock max %d · %ds reload"):format(def.launcher, w and w.stockCap or 60, def.reload or 20)
	end
	if def.airDefense then
		local ad = def.airDefense
		return ("Range %d · %d%% intercept · %ds reload"):format(ad.range, math.floor(ad.chance * 100), ad.reload)
	end
	if def.housing then
		table.insert(bits, ("+%d residents"):format(def.housing))
	end
	if def.powerOut then
		table.insert(bits, ("+%d MW"):format(def.powerOut))
	end
	if def.waterOut then
		table.insert(bits, ("+%d water"):format(def.waterOut))
	end
	if def.oilOut then
		table.insert(bits, ("+%d oil/min"):format(def.oilOut))
	end
	if def.steelOut then
		table.insert(bits, ("+%d steel/min"):format(def.steelOut))
	end
	if def.refine then
		table.insert(bits, ("%d fuel/min"):format(def.refine.rate))
	end
	if def.factory then
		table.insert(bits, "builds weapons & vehicles")
	end
	if def.rpOut then
		table.insert(bits, ("+%d RP/min"):format(def.rpOut))
	end
	if def.income then
		table.insert(bits, ("+$%s / pay"):format(Format.commas(def.income)))
	end
	if def.service then
		table.insert(bits, ("serves %s"):format(Format.short(def.service.serves)))
	end
	if def.storage then
		table.insert(bits, ("+%s storage"):format(Format.short((def.storage.oil or 0) + (def.storage.steel or 0))))
	end
	if def.depot then
		table.insert(bits, ("+%d army"):format(def.depot))
	end
	if def.workers then
		table.insert(bits, ("%d workers"):format(def.workers))
	end
	if def.power then
		table.insert(bits, ("uses %d MW"):format(def.power))
	end
	if #bits == 0 then
		return def.desc
	end
	return table.concat(bits, " · ")
end

local function lockReason(def): (boolean, string?)
	return Unlocks.check(def, access())
end

local function lockText(def): string
	if def.pass and not (access().passes[def.pass]) then
		local p = Products.pass(def.pass)
		return "PASS · " .. string.upper(p and p.name or def.pass)
	end
	if def.research then
		local r = Research.get(def.research)
		return "RESEARCH · " .. string.upper(r and r.name or def.research)
	end
	return "LOCKED"
end

---------------------------------------------------------------------------
-- Cards
---------------------------------------------------------------------------
local function updateCard(entry)
	local def = entry.def
	local ok = lockReason(def)
	entry.lock.Visible = not ok
	local state = Placement.state()
	local isSel = state.def ~= nil and state.def.id == def.id
	local stroke = entry.btn:FindFirstChildOfClass("UIStroke") :: UIStroke
	stroke.Color = isSel and C.Accent or C.LineSoft
	stroke.Thickness = isSel and 2 or 1
	Lib.setButtonColor(entry.btn, isSel and C.AccentSoft or C.Raised)
	local afford = (ClientState.get("cash") or 0) >= def.cost
	entry.price.TextColor3 = afford and C.Good or C.Bad
end

local function makeCard(def, order: number): TextButton
	local btn = Lib.button({
		Name = def.id,
		Size = UDim2.fromOffset(150, 166),
		BackgroundColor3 = C.Raised,
		LayoutOrder = order,
		Activated = function()
			local ok, reason = lockReason(def)
			if not ok then
				Notifications.show(("%s: %s"):format(def.name, reason or "Locked"), "info")
				if def.pass then
					Hub.call("openShop", "Passes")
				elseif def.research then
					Hub.call("openResearch", def.research)
				end
				return
			end
			local state = Placement.state()
			if state.def and state.def.id == def.id then
				Placement.select(nil)
			else
				Placement.select(def)
			end
		end,
	}, { Lib.corner(4), Lib.stroke(C.LineSoft) })
	local art = Lib.inset({ Position = UDim2.fromOffset(5, 5), Size = UDim2.new(1, -10, 0, 96), Parent = btn })
	New("UIGradient", { Color = ColorSequence.new(Color3.fromRGB(36, 46, 40), Color3.fromRGB(14, 18, 16)), Rotation = 90, Parent = art })
	Lib.viewport(thumbModel(def), { Parent = art }, 40)
	local lock = New("Frame", {
		Name = "Lock",
		BackgroundColor3 = C.Ink,
		BackgroundTransparency = 0.25,
		Size = UDim2.fromScale(1, 1),
		Visible = false,
		ZIndex = 3,
		Parent = art,
	}, { Lib.corner(4) })
	local lk = Icons.get("shield", 18, C.Accent)
	lk.AnchorPoint = Vector2.new(0.5, 0)
	lk.Position = UDim2.new(0.5, 0, 0, 22)
	lk.Parent = lock
	for _, d in lk:GetDescendants() do
		if d:IsA("GuiObject") then
			d.ZIndex = 4
		end
	end
	Lib.display({
		Text = lockText(def),
		TextSize = 10,
		TextColor3 = C.Accent,
		TextWrapped = true,
		TextXAlignment = Enum.TextXAlignment.Center,
		Position = UDim2.fromOffset(6, 46),
		Size = UDim2.new(1, -12, 0, 30),
		ZIndex = 4,
		Parent = lock,
	})
	Lib.text({
		Text = def.name,
		FontFace = Theme.Font.BodyHeavy,
		TextSize = 13,
		Position = UDim2.fromOffset(9, 106),
		Size = UDim2.new(1, -16, 0, 18),
		Parent = btn,
	})
	local price = Lib.display({
		Text = "$" .. Format.commas(def.cost),
		TextSize = 15,
		TextColor3 = C.Good,
		Position = UDim2.fromOffset(9, 128),
		Size = UDim2.new(1, -16, 0, 18),
		Parent = btn,
	})
	if def.buildTime > 0 then
		Lib.chip(Format.duration(def.buildTime), C.InfoSoft, C.Info, {
			AnchorPoint = Vector2.new(1, 0),
			Position = UDim2.new(1, -8, 0, 128),
			Size = UDim2.fromOffset(0, 18),
			Parent = btn,
		})
	end
	cards[def.id] = { btn = btn, lock = lock, price = price, def = def }
	updateCard(cards[def.id])
	btn.MouseEnter:Connect(function()
		refs.hoverDef = def
		BuildMenu.refreshTooltip()
		BuildMenu.refreshDetail()
	end)
	btn.MouseLeave:Connect(function()
		if refs.hoverDef == def then
			refs.hoverDef = nil
			BuildMenu.refreshTooltip()
			BuildMenu.refreshDetail()
		end
	end)
	return btn
end

local function renderCards()
	Lib.clear(refs.scroller)
	table.clear(cards)
	local hasFactions = Buildings.tabHasFactions(category, tab)
	refs.factions.Visible = hasFactions
	local list = Buildings.forTab(category, tab, hasFactions and faction or nil)
	for i, def in list do
		makeCard(def, i).Parent = refs.scroller
	end
	refs.crumb.Text = ("%s  /  %s  ·  %d STRUCTURES"):format(string.upper(category == "Civilian" and "Civil" or category), string.upper(tab), #list)
end

---------------------------------------------------------------------------
-- Tabs / categories / factions
---------------------------------------------------------------------------
local function renderTabs()
	Lib.clear(refs.tabs)
	for _, c in Buildings.Categories do
		if c.id == category then
			for i, t in c.tabs do
				local active = t == tab
				local b = Lib.button({
					Name = t,
					Text = string.upper(t),
					FontFace = Theme.Font.Display,
					TextSize = 14,
					TextColor3 = active and C.Accent or C.Muted,
					BackgroundTransparency = 1,
					Size = UDim2.fromOffset(112, 32),
					LayoutOrder = i,
					Parent = refs.tabs,
					Activated = function()
						tab = t
						faction = "Standard"
						renderTabs()
						BuildMenu.renderFactions()
						renderCards()
					end,
				})
				if active then
					New("Frame", { BackgroundColor3 = C.Accent, BorderSizePixel = 0, AnchorPoint = Vector2.new(0.5, 1), Position = UDim2.new(0.5, 0, 1, 0), Size = UDim2.new(0.7, 0, 0, 2), Parent = b })
				end
			end
		end
	end
	for _, c in Buildings.Categories do
		local tile = refs["cat_" .. c.id] :: TextButton
		local active = c.id == category
		local tint = c.id == "Civilian" and C.Civil or C.Military
		Lib.setButtonColor(tile, active and (c.id == "Civilian" and C.InfoSoft or C.BadSoft) or C.Raised)
		local stroke = tile:FindFirstChildOfClass("UIStroke") :: UIStroke
		stroke.Color = active and tint or C.LineSoft
		stroke.Thickness = active and 2 or 1
	end
end

function BuildMenu.renderFactions()
	Lib.clear(refs.factions)
	local passes = ClientState.get("passes") or {}
	for i, f in Buildings.Factions do
		local passKey = Buildings.FactionPass[f]
		local locked = passKey ~= nil and not passes[passKey]
		local active = f == faction
		local btn = Lib.button({
			Name = f,
			Size = UDim2.fromOffset(96, 26),
			BackgroundColor3 = active and C.AccentSoft or C.Inset,
			LayoutOrder = i,
			Parent = refs.factions,
			Activated = function()
				if locked and passKey then
					local p = Products.pass(passKey)
					Notifications.show(("%s arsenal requires the %s"):format(f, p and p.name or "pack"), "info")
					Hub.call("openShop", "Passes")
					return
				end
				faction = f
				BuildMenu.renderFactions()
				renderCards()
			end,
		}, { Lib.corner(3), Lib.stroke(active and C.Accent or C.LineSoft, 1, active and 0.2 or 0) })
		Lib.display({
			Text = string.upper(f) .. (locked and "  ◆" or ""),
			TextSize = 11,
			TextColor3 = active and C.Accent or (locked and C.Faint or C.TextSoft),
			TextXAlignment = Enum.TextXAlignment.Center,
			Size = UDim2.fromScale(1, 1),
			Parent = btn,
		})
	end
end

local function setCategory(c: string)
	category = c
	for _, cat in Buildings.Categories do
		if cat.id == c then
			tab = cat.tabs[1]
		end
	end
	faction = "Standard"
	renderTabs()
	BuildMenu.renderFactions()
	renderCards()
end

---------------------------------------------------------------------------
-- Detail + tools
---------------------------------------------------------------------------
local function toolButton(parent: Instance, label: string, key: string, icon: string, order: number, onClick: () -> ()): TextButton
	local btn = Lib.button({
		Name = label,
		Size = UDim2.fromOffset(50, 50),
		BackgroundColor3 = C.Raised,
		LayoutOrder = order,
		Parent = parent,
		Activated = onClick,
	}, { Lib.corner(4), Lib.stroke(C.LineSoft) })
	local ic = Icons.get(icon, 16, C.Text)
	ic.AnchorPoint = Vector2.new(0.5, 0)
	ic.Position = UDim2.new(0.5, 0, 0, 8)
	ic.Parent = btn
	Lib.display({ Name = "Label", Text = label, TextSize = 9, TextColor3 = C.TextSoft, TextXAlignment = Enum.TextXAlignment.Center, Position = UDim2.new(0, 0, 1, -18), Size = UDim2.new(1, 0, 0, 14), Parent = btn })
	if key ~= "" then
		Lib.text({ Text = key, FontFace = Theme.Font.Mono, TextSize = 9, TextColor3 = C.Faint, Position = UDim2.fromOffset(4, 2), Size = UDim2.fromOffset(10, 10), Parent = btn })
	end
	return btn
end

local function buildRight(parent: Frame)
	local view = Lib.inset({ Position = UDim2.fromOffset(10, 10), Size = UDim2.fromOffset(166, 150), Parent = parent })
	New("UIGradient", { Color = ColorSequence.new(Color3.fromRGB(38, 50, 42), Color3.fromRGB(12, 16, 14)), Rotation = 90, Parent = view })
	refs.detailView = view
	refs.detailName = Lib.display({ Text = "SELECT A STRUCTURE", TextSize = 17, TextWrapped = true, Position = UDim2.fromOffset(188, 10), Size = UDim2.new(1, -198, 0, 40), TextYAlignment = Enum.TextYAlignment.Top, Parent = parent })
	refs.detailPrice = Lib.display({ Text = "", TextSize = 20, TextColor3 = C.Good, Position = UDim2.fromOffset(188, 52), Size = UDim2.new(1, -198, 0, 22), Parent = parent })
	refs.detailTime = Lib.text({ Text = "", FontFace = Theme.Font.BodyBold, TextSize = 12, TextColor3 = C.Info, Position = UDim2.fromOffset(188, 76), Size = UDim2.new(1, -198, 0, 16), Parent = parent })
	refs.detailReq = Lib.text({
		Text = "Pick anything and build it anywhere on your island, at any angle. Roads are drawn point to point.",
		TextSize = 12,
		TextColor3 = C.TextSoft,
		TextWrapped = true,
		TextYAlignment = Enum.TextYAlignment.Top,
		Position = UDim2.fromOffset(188, 96),
		Size = UDim2.new(1, -198, 0, 64),
		Parent = parent,
	})
	local tools = New("Frame", {
		BackgroundTransparency = 1,
		Position = UDim2.new(0, 10, 1, -60),
		Size = UDim2.new(1, -20, 0, 50),
		Parent = parent,
	}, { Lib.list("x", 5) })
	refs.toolDelete = toolButton(tools, "DEMOLISH", "2", "trash", 1, function()
		Placement.setTool("delete")
	end)
	refs.toolUndo = toolButton(tools, "UNDO", "3", "undo", 2, function()
		Placement.undo()
	end)
	refs.toolDrag = toolButton(tools, "DRAG", "4", "beam", 3, function()
		Placement.toggleDrag()
	end)
	refs.toolMove = toolButton(tools, "MOVE", "5", "map", 4, function()
		Placement.setTool("move")
	end)
	refs.toolRotate = toolButton(tools, "ROTATE", "6", "undo", 5, function()
		Placement.rotate()
	end)
	refs.toolSnap = toolButton(tools, "SNAP", "G", "target", 6, function()
		Placement.toggleSnap()
	end)
	local close = Lib.button({
		Name = "Close",
		Variant = "danger",
		Size = UDim2.fromOffset(50, 50),
		LayoutOrder = 7,
		Parent = tools,
		Activated = function()
			BuildMenu.close()
		end,
	})
	local x = Icons.close(14, C.Bad)
	x.AnchorPoint = Vector2.new(0.5, 0)
	x.Position = UDim2.new(0.5, 0, 0, 9)
	x.Parent = close
	Lib.display({ Text = "CLOSE", TextSize = 10, TextColor3 = C.Bad, TextXAlignment = Enum.TextXAlignment.Center, Position = UDim2.new(0, 0, 1, -18), Size = UDim2.new(1, 0, 0, 14), Parent = close })
end

function BuildMenu.refreshDetail()
	local s = Placement.state()
	local def = refs.hoverDef or s.def
	local key = def and def.id or (s.tool or "none")
	if key ~= lastDetail then
		lastDetail = key
		Lib.clear(refs.detailView)
		if def then
			Lib.viewport(thumbModel(def), { Parent = refs.detailView }, 30, 24)
		else
			local ic = Icons.get(s.tool == "delete" and "trash" or (s.tool == "move" and "map" or "hammer"), 44, C.Faint)
			ic.AnchorPoint = Vector2.new(0.5, 0.5)
			ic.Position = UDim2.fromScale(0.5, 0.5)
			ic.Parent = refs.detailView
		end
	end
	if def then
		refs.detailName.Text = string.upper(def.name)
		refs.detailPrice.Text = "$" .. Format.commas(def.cost)
		refs.detailPrice.TextColor3 = (ClientState.get("cash") or 0) >= def.cost and C.Good or C.Bad
		refs.detailTime.Text = (def.buildTime > 0 and ("BUILDS IN " .. string.upper(Format.duration(def.buildTime))) or "BUILDS INSTANTLY")
			.. ("  ·  %dx%d"):format(def.size[1], def.size[2])
		local ok = lockReason(def)
		refs.detailReq.Text = (ok and "" or (lockText(def) .. "\n")) .. BuildMenu.describe(def)
	else
		refs.detailName.Text = s.tool == "delete" and "DEMOLISH" or (s.tool == "move" and "MOVE" or "SELECT A STRUCTURE")
		refs.detailPrice.Text = ""
		refs.detailTime.Text = ""
		refs.detailReq.Text = s.tool == "delete" and "Click a building to remove it. 50% refund (100% while it's still under construction)."
			or (s.tool == "move" and "Click a building, then click its new spot. R rotates it." or "Pick anything and build it anywhere on your island, at any angle. Roads are drawn point to point.")
	end
end

local function refreshTools()
	local s = Placement.state()
	local function mark(btn: TextButton, on: boolean)
		Lib.setButtonColor(btn, on and C.AccentSoft or C.Raised)
		local stroke = btn:FindFirstChildOfClass("UIStroke") :: UIStroke
		stroke.Color = on and C.Accent or C.LineSoft
	end
	mark(refs.toolDelete, s.tool == "delete")
	mark(refs.toolMove, s.tool == "move")
	mark(refs.toolDrag, s.drag)
	mark(refs.toolSnap, s.snap == "grid")
	local snapLabel = refs.toolSnap:FindFirstChild("Label") :: TextLabel?
	if snapLabel then
		snapLabel.Text = s.snap == "grid" and "GRID" or "FREE"
	end
	for _, entry in cards do
		updateCard(entry)
	end
	BuildMenu.refreshDetail()
	BuildMenu.refreshTooltip()
end

function BuildMenu.refreshTooltip()
	local s = Placement.state()
	local def = s.def
	if not root.Visible or (not def and not s.tool) then
		tooltip.Visible = false
		return
	end
	tooltip.Visible = true
	local cash = ClientState.get("cash") or 0
	local snap = s.snap == "grid" and "G FREE" or "G GRID"
	if def and def.id == "road" and not s.moving then
		local road = s.road
		if road then
			refs.tipName.Text = ("ROAD  ·  %d STUDS"):format(math.floor(road.len + 0.5))
			refs.tipPrice.Text = "$" .. Format.commas(road.cost)
			refs.tipPrice.TextColor3 = road.valid and C.Good or C.Bad
			refs.tipHint.Text = "CLICK NEXT POINT  ·  SAME SPOT / RMB / Q FINISH  ·  SHIFT 15°"
		else
			refs.tipName.Text = "ROAD"
			refs.tipPrice.Text = ("$%s / %d studs"):format(Format.commas(def.cost), def.size[2] * Config.CellSize)
			refs.tipPrice.TextColor3 = cash >= def.cost and C.Good or C.Bad
			refs.tipHint.Text = "CLICK START, THEN CLICK OR DRAG TO DRAW  ·  ENDS SNAP TO ROADS  ·  " .. snap
		end
	elseif def then
		refs.tipName.Text = ("%s%s  ·  %d°"):format(s.moving and "MOVING " or "", string.upper(def.name), math.floor(s.rotation + 0.5) % 360)
		refs.tipPrice.Text = s.moving and "" or ("$" .. Format.commas(def.cost))
		refs.tipPrice.TextColor3 = cash >= def.cost and C.Good or C.Bad
		local rot = s.snap == "grid" and "R ROTATE 90°" or "R / SHIFT+R ROTATE 15°  ·  AUTO-ALIGNS TO ROADS (ALT OFF)"
		refs.tipHint.Text = (s.drag and "HOLD LMB + DRAG A ROW" or "LMB PLACE") .. "  ·  " .. rot .. "  ·  " .. snap .. "  ·  Q CANCEL"
	else
		refs.tipName.Text = s.tool == "delete" and "DEMOLISH MODE" or "MOVE MODE"
		refs.tipPrice.Text = ""
		refs.tipHint.Text = s.tool == "delete" and "CLICK A BUILDING  ·  2 EXIT" or "CLICK A BUILDING  ·  5 EXIT"
	end
end

---------------------------------------------------------------------------
-- Open / close
---------------------------------------------------------------------------
function BuildMenu.open()
	if ClientState.mode == "war" then
		return
	end
	root.Visible = true
	root.Position = UDim2.new(0.5, 0, 1, 40)
	Lib.tween(root, 0.22, { Position = UDim2.new(0.5, 0, 1, -12) }, Enum.EasingStyle.Quint)
	ClientState.setMode("build")
	Sounds.play("Open", 1.1)
	renderTabs()
	BuildMenu.renderFactions()
	renderCards()
	refreshTools()
end

function BuildMenu.close()
	Placement.cancel()
	root.Visible = false
	tooltip.Visible = false
	if ClientState.mode == "build" then
		ClientState.setMode("play")
	end
end

function BuildMenu.toggle()
	if ClientState.mode == "war" then
		Hub.call("goHome")
	elseif root.Visible then
		BuildMenu.close()
	else
		BuildMenu.open()
	end
end

function BuildMenu.init(gui: GuiObject)
	root = Lib.panel({
		Name = "BuildMenu",
		AnchorPoint = Vector2.new(0.5, 1),
		Position = UDim2.new(0.5, 0, 1, -12),
		Size = UDim2.fromOffset(W, H),
		Visible = false,
		Parent = gui,
	})
	Lib.brackets(root, C.Accent, 14, 2, 4)
	Lib.hazard({ Position = UDim2.fromOffset(0, 0), Size = UDim2.new(0, 160, 0, 4), BackgroundTransparency = 0.1, Parent = root }, C.Accent, C.Panel, 9)

	-- department column
	local rail = New("Frame", {
		BackgroundTransparency = 1,
		Position = UDim2.fromOffset(12, 12),
		Size = UDim2.fromOffset(LEFT, H - 24),
		Parent = root,
	}, { Lib.list("y", 8) })
	Lib.caption("Department", { LayoutOrder = 0, Parent = rail })
	for i, c in Buildings.Categories do
		local tint = c.id == "Civilian" and C.Civil or C.Military
		local tile = Lib.button({
			Name = c.id,
			Size = UDim2.fromOffset(LEFT, 92),
			BackgroundColor3 = C.Raised,
			LayoutOrder = i,
			Parent = rail,
			Activated = function()
				setCategory(c.id)
			end,
		}, { Lib.corner(4), Lib.stroke(C.LineSoft) })
		local ic = Icons.get(c.id == "Civilian" and "house" or "helmet", 34, tint)
		ic.Position = UDim2.fromOffset(14, 14)
		ic.Parent = tile
		Lib.display({ Text = c.id == "Civilian" and "CIVIL" or "MILITARY", TextSize = 17, Position = UDim2.fromOffset(14, 54), Size = UDim2.new(1, -20, 0, 20), Parent = tile })
		Lib.text({ Text = c.id == "Civilian" and "economy & people" or "arms & defense", TextSize = 11, TextColor3 = C.Muted, Position = UDim2.fromOffset(14, 72), Size = UDim2.new(1, -20, 0, 14), Parent = tile })
		refs["cat_" .. c.id] = tile
	end

	-- main column
	local mainW = W - LEFT - RIGHT - 48
	local main = New("Frame", {
		BackgroundTransparency = 1,
		Position = UDim2.fromOffset(LEFT + 24, 10),
		Size = UDim2.fromOffset(mainW, H - 20),
		Parent = root,
	})
	refs.tabs = New("Frame", { BackgroundTransparency = 1, Size = UDim2.new(1, -310, 0, 32), Parent = main }, { Lib.list("x", 2) })
	refs.factions = New("Frame", {
		BackgroundTransparency = 1,
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.new(1, 0, 0, 3),
		Size = UDim2.fromOffset(300, 26),
		Parent = main,
	}, { Lib.list("x", 4, Enum.HorizontalAlignment.Right) })
	Lib.divider({ Position = UDim2.fromOffset(0, 34), Parent = main })
	refs.crumb = Lib.caption("", { Position = UDim2.fromOffset(0, 40), Size = UDim2.new(1, 0, 0, 14), Parent = main })
	refs.scroller = Lib.scroll({
		Position = UDim2.fromOffset(0, 60),
		Size = UDim2.new(1, 0, 0, 172),
		AutomaticCanvasSize = Enum.AutomaticSize.X,
		ScrollingDirection = Enum.ScrollingDirection.X,
		Parent = main,
	}, { Lib.list("x", 8), Lib.pad(2, 2, 6, 2) })

	-- detail column
	local right = Lib.inset({
		BackgroundTransparency = 0.25,
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.new(1, -12, 0, 12),
		Size = UDim2.fromOffset(RIGHT, H - 24),
		Parent = root,
	})
	Lib.stroke(C.LineSoft, 1, 0).Parent = right
	buildRight(right)

	-- placement hint bar
	tooltip = Lib.panel({
		Name = "PlaceHint",
		AnchorPoint = Vector2.new(0.5, 1),
		Position = UDim2.new(0.5, 0, 1, -H - 24),
		Size = UDim2.fromOffset(520, 42),
		Visible = false,
		Parent = gui,
	})
	Lib.brackets(tooltip, C.Accent, 8, 2, 3)
	refs.tipName = Lib.display({ Text = "", TextSize = 15, Position = UDim2.fromOffset(14, 0), Size = UDim2.new(0.5, -14, 1, 0), Parent = tooltip })
	refs.tipPrice = Lib.display({ Text = "", TextSize = 15, AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, -14, 0, 0), Size = UDim2.fromOffset(110, 42), TextXAlignment = Enum.TextXAlignment.Right, Parent = tooltip })
	refs.tipHint = Lib.text({ Text = "", FontFace = Theme.Font.Mono, TextSize = 10, TextColor3 = C.Muted, Position = UDim2.new(0.42, 0, 0, 0), Size = UDim2.new(0.58, -130, 1, 0), TextXAlignment = Enum.TextXAlignment.Right, Parent = tooltip })

	Placement.onChanged(refreshTools)
	RunService.RenderStepped:Connect(function()
		if root.Visible and Placement.state().drawing then
			BuildMenu.refreshTooltip()
		end
	end)
	ClientState.onAny(function(patch)
		if not root.Visible then
			return
		end
		if patch.researched or patch.passes then
			BuildMenu.renderFactions()
			renderCards()
		elseif patch.cash then
			for _, entry in cards do
				updateCard(entry)
			end
			BuildMenu.refreshDetail()
			BuildMenu.refreshTooltip()
		end
	end)

	UserInputService.InputBegan:Connect(function(input, processed)
		if processed then
			return
		end
		if input.KeyCode == Enum.KeyCode.B then
			BuildMenu.toggle()
		elseif input.KeyCode == Enum.KeyCode.X and root.Visible then
			BuildMenu.close()
		end
	end)

	Hub.toggleBuild = BuildMenu.toggle
	Hub.openBuild = BuildMenu.open
	Hub.closeBuild = BuildMenu.close
	Hub.describeBuilding = BuildMenu.describe
	setCategory("Civilian")
end

return BuildMenu
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="57">
            <Properties>
              <string name="Name">BuildingPanel</string>
              <string name="Source"><![CDATA[--[[
	BuildingPanel - the Inspector
	Click any of your buildings: a panel docks on the right (the world stays
	visible) with a live 3D header, status, a 2x2 stat grid, activity and a
	building-specific section (fuel destinations, production queue, launcher
	readiness, billboard text), then Repair / Move / Demolish.
]]

local HttpService = game:GetService("HttpService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Shared = ReplicatedStorage.Shared
local Config = require(Shared.Config)
local Buildings = require(Shared.Catalog.Buildings)
local Weapons = require(Shared.Catalog.Weapons)
local Units = require(Shared.Catalog.Units)
local ModelBuilder = require(Shared.ModelBuilder)
local Unlocks = require(Shared.Util.Unlocks)
local Format = require(Shared.Util.Format)
local Net = require(Shared.Net)

local Client = script.Parent.Parent
local ClientState = require(Client.ClientState)
local Hub = require(Client.Hub)
local Lib = require(Client.UI.Lib)
local Theme = require(Client.UI.Theme)
local Modal = require(script.Parent.Modal)
local Notifications = require(script.Parent.Notifications)
local Placement = require(script.Parent.Placement)
local Sounds = require(script.Parent.Sounds)

local New = Lib.New
local C = Theme.Color

local BuildingPanel = {}

type StatCard = { value: TextLabel, sub: TextLabel, caption: TextLabel, bar: Lib.Progress }

local function statCard(parent: Instance, order: number): StatCard
	local card = Lib.card({ LayoutOrder = order, Parent = parent }, { Lib.pad(9, 11) })
	local caption = Lib.caption("", { Parent = card })
	local value = Lib.display({ Text = "-", TextSize = 20, Position = UDim2.fromOffset(0, 15), Size = UDim2.new(1, 0, 0, 24), Parent = card })
	local sub = Lib.text({ Text = "", TextSize = 11, TextColor3 = C.Muted, FontFace = Theme.Font.BodyBold, Position = UDim2.fromOffset(0, 40), Size = UDim2.new(1, 0, 0, 13), Parent = card })
	local bar = Lib.progress({ Segments = 8, Position = UDim2.new(0, 0, 1, -5), Size = UDim2.new(1, 0, 0, 5), Parent = card })
	return { value = value, sub = sub, caption = caption, bar = bar }
end

local function setStat(c: StatCard, caption: string, value: string, sub: string, frac: number?, color: Color3?)
	c.caption.Text = string.upper(caption)
	c.value.Text = value
	c.sub.Text = sub
	c.bar.frame.Visible = frac ~= nil
	if frac then
		c.bar.set(frac, color)
	end
end

local function weaponForFamily(family: string)
	for _, w in Weapons.all() do
		if w.family == family then
			return w
		end
	end
	return nil
end

local function plotFolder(): Folder?
	local idx = ClientState.get("plot")
	local homeland = workspace:FindFirstChild("Homeland")
	local plot = idx and homeland and homeland:FindFirstChild("Plot_" .. idx)
	return plot and plot:FindFirstChild("Buildings") :: Folder? or nil
end

-- Fuel consumers in your nation, numbered per type ("Large Military Factory #2").
local function consumers(): { { uid: number, name: string, model: Model, cap: number } }
	local out = {}
	local folder = plotFolder()
	if not folder then
		return out
	end
	local models = {}
	for _, m in folder:GetChildren() do
		local def = Buildings.get(m:GetAttribute("BuildingId") :: string)
		if def and def.fuelCap then
			table.insert(models, { m = m, def = def })
		end
	end
	table.sort(models, function(a, b)
		return (a.m:GetAttribute("Uid") :: number) < (b.m:GetAttribute("Uid") :: number)
	end)
	local counts = {}
	for _, e in models do
		counts[e.def.id] = (counts[e.def.id] or 0) + 1
		table.insert(out, {
			uid = e.m:GetAttribute("Uid") :: number,
			name = ("%s #%d"):format(e.def.name, counts[e.def.id]),
			model = e.m,
			cap = e.def.fuelCap,
		})
	end
	return out
end

local function statusColor(status: string, model: Model): Color3
	if model:GetAttribute("Damaged") then
		return C.Bad
	elseif status:find("Not Enough") or status:find("No Road") or status:find("Waiting") or status:find("Full") then
		return C.Gold
	elseif model:GetAttribute("FinishAt") then
		return C.Info
	end
	return C.Good
end

local function section(parent: Instance, title: string, order: number): (Frame, TextLabel)
	local s = Lib.card({ LayoutOrder = order, Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, Parent = parent }, { Lib.pad(10, 12), Lib.list("y", 6) })
	local t = Lib.caption(title, { TextColor3 = C.Accent, LayoutOrder = 0, Parent = s })
	return s, t
end

function BuildingPanel.open(model: Model)
	local def = Buildings.get(model:GetAttribute("BuildingId") :: string)
	if not def then
		return
	end
	local uid = model:GetAttribute("Uid") :: number
	local win = Modal.openSide(def.name, ("%s · %s · %dx%d"):format(def.category == "Civilian" and "CIVIL" or "MILITARY", string.upper(def.tab), def.size[1], def.size[2]), 440)
	Sounds.play("Open")
	Lib.viewport(ModelBuilder.building(def), { Parent = win.iconHolder }, 40, 30)

	local scroll = Lib.scroll({ Size = UDim2.new(1, 0, 1, -54), Parent = win.body }, { Lib.list("y", 8), Lib.pad(0, 6, 6, 0) })

	-- status line
	local statusRow = New("Frame", { BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 24), LayoutOrder = 1, Parent = scroll })
	local statusDot = New("Frame", { BackgroundColor3 = C.Good, AnchorPoint = Vector2.new(0, 0.5), Position = UDim2.new(0, 2, 0.5, 0), Size = UDim2.fromOffset(8, 8), Parent = statusRow }, { Lib.round() })
	local statusText = Lib.display({ Text = "", TextSize = 13, Position = UDim2.fromOffset(18, 0), Size = UDim2.new(1, -18, 1, 0), Parent = statusRow })

	-- stat grid
	local grid = New("Frame", { BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 2 * 70 + 8), LayoutOrder = 2, Parent = scroll }, { Lib.grid(UDim2.new(0.5, -4, 0, 70), 8) })
	local stats = { statCard(grid, 1), statCard(grid, 2), statCard(grid, 3), statCard(grid, 4) }

	-- activity
	local activity = Lib.card({ LayoutOrder = 3, Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, Parent = scroll }, { Lib.pad(10, 12), Lib.list("y", 3) })
	Lib.caption("Activity", { TextColor3 = C.Accent, LayoutOrder = 0, Parent = activity })
	local doingDesc = Lib.text({
		Text = def.desc,
		TextSize = 13,
		TextColor3 = C.TextSoft,
		TextWrapped = true,
		Size = UDim2.new(1, 0, 0, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		TextTruncate = Enum.TextTruncate.None,
		LayoutOrder = 1,
		Parent = activity,
	})

	-- actions (fixed at the bottom)
	local actions = New("Frame", {
		BackgroundTransparency = 1,
		AnchorPoint = Vector2.new(0, 1),
		Position = UDim2.new(0, 0, 1, 0),
		Size = UDim2.new(1, 0, 0, 44),
		Parent = win.body,
	}, { Lib.list("x", 6, Enum.HorizontalAlignment.Right, Enum.VerticalAlignment.Center) })
	local repairBtn = Lib.button({
		Name = "Repair",
		Variant = "primary",
		Text = "REPAIR",
		TextSize = 13,
		Size = UDim2.fromOffset(160, 40),
		LayoutOrder = 1,
		Visible = false,
		Parent = actions,
		Activated = function()
			local res = Net.request("RepairBuilding", uid)
			if res.ok then
				Sounds.play("Success")
			elseif res.err then
				Notifications.show(res.err, "bad")
			end
		end,
	})
	Lib.button({
		Name = "Move",
		Variant = "secondary",
		Text = "MOVE",
		TextSize = 13,
		Size = UDim2.fromOffset(96, 40),
		LayoutOrder = 2,
		Parent = actions,
		Activated = function()
			Modal.close()
			Hub.call("openBuild")
			Placement.beginMove(model)
		end,
	})
	local confirmDelete = false
	local deleteBtn: TextButton
	deleteBtn = Lib.button({
		Name = "Demolish",
		Variant = "danger",
		Text = "DEMOLISH",
		TextSize = 13,
		Size = UDim2.fromOffset(130, 40),
		LayoutOrder = 3,
		Parent = actions,
		Activated = function()
			if not confirmDelete then
				confirmDelete = true
				deleteBtn.Text = "CONFIRM?"
				task.delay(3, function()
					confirmDelete = false
					if deleteBtn.Parent then
						deleteBtn.Text = "DEMOLISH"
					end
				end)
				return
			end
			local res = Net.request("DeleteBuilding", uid)
			if res.ok then
				Modal.close()
				Notifications.show(("%s demolished (+%s)"):format(def.name, Format.cash(res.refund or 0)), "info")
			elseif res.err then
				Notifications.show(res.err, "bad")
			end
		end,
	})

	-------------------------------------------------------------------
	-- building-specific sections
	-------------------------------------------------------------------
	local rebuildSpecial: (() -> ())? = nil
	local updateSpecial: (() -> ())? = nil

	if def.refine then
		local special, specialTitle = section(scroll, "Fuel goes to", 4)
		local rows: { [number]: { bar: Lib.Progress, amount: TextLabel, radio: Frame } } = {}
		local signature = ""
		local listHolder = New("Frame", { BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, LayoutOrder = 1, Parent = special }, { Lib.list("y", 5) })
		local function row(destUid: number, name: string, right: string, order: number)
			local btn = Lib.button({
				Name = destUid == 0 and "Auto" or ("Dest" .. destUid),
				Size = UDim2.new(1, 0, 0, destUid == 0 and 36 or 46),
				BackgroundColor3 = C.Inset,
				LayoutOrder = order,
				Parent = listHolder,
				Activated = function()
					local res = Net.request("SetFuelDestination", uid, destUid)
					if not res.ok and res.err then
						Notifications.show(res.err, "bad")
					end
				end,
			}, { Lib.corner(4), Lib.stroke(C.LineSoft) })
			local radio = New("Frame", {
				BackgroundColor3 = C.Panel,
				Position = UDim2.fromOffset(10, destUid == 0 and 9 or 13),
				Size = UDim2.fromOffset(18, 18),
				Parent = btn,
			}, { Lib.round(), Lib.stroke(C.Faint, 2) })
			New("Frame", { Name = "Dot", BackgroundColor3 = C.Accent, AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5), Size = UDim2.fromOffset(10, 10), Visible = false, Parent = radio }, { Lib.round() })
			Lib.text({ Text = name, FontFace = Theme.Font.BodyBold, TextSize = 13, TextColor3 = destUid == 0 and C.Accent or C.Text, Position = UDim2.fromOffset(38, destUid == 0 and 0 or 4), Size = UDim2.new(0.6, 0, 0, destUid == 0 and 36 or 20), Parent = btn })
			local amount = Lib.text({ Text = right, FontFace = Theme.Font.Mono, TextSize = 11, TextColor3 = C.Muted, AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, -10, 0, destUid == 0 and 0 or 4), Size = UDim2.new(0.36, 0, 0, destUid == 0 and 36 or 20), TextXAlignment = Enum.TextXAlignment.Right, Parent = btn })
			local bar = Lib.progress({ Segments = 10, Position = UDim2.new(0, 38, 0, 30), Size = UDim2.new(1, -48, 0, 5), Parent = btn, Visible = destUid ~= 0 })
			rows[destUid] = { bar = bar, amount = amount, radio = radio }
		end
		local function rebuildList()
			local list = consumers()
			local sig = ""
			for _, c in list do
				sig ..= c.uid .. ","
			end
			if sig == signature then
				return
			end
			signature = sig
			Lib.clear(listHolder)
			table.clear(rows)
			specialTitle.Text = ("FUEL GOES TO (%d BUILDINGS)"):format(#list)
			row(0, "Auto", "most free space", 0)
			for i, c in list do
				row(c.uid, c.name, "", i)
			end
			if #list == 0 then
				Lib.text({ Text = "No fuel users yet - build a Military Factory.", TextSize = 12, TextColor3 = C.Muted, LayoutOrder = 99, Parent = listHolder })
			end
		end
		rebuildSpecial = rebuildList
		updateSpecial = function()
			rebuildList()
			local dest = (model:GetAttribute("Dest") :: number?) or 0
			for _, c in consumers() do
				local r = rows[c.uid]
				if r then
					local fuel = (c.model:GetAttribute("Fuel") :: number?) or 0
					r.amount.Text = ("%s / %s"):format(Format.commas(fuel), Format.commas(c.cap))
					r.bar.set(fuel / c.cap)
				end
			end
			for id, r in rows do
				(r.radio:FindFirstChild("Dot") :: Frame).Visible = id == dest
			end
		end
	elseif def.factory then
		local queueSection, queueTitle = section(scroll, "Production queue", 4)
		local queueHolder = New("Frame", { BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, LayoutOrder = 1, Parent = queueSection }, { Lib.list("y", 4) })
		local optSection = section(scroll, "Build orders", 5)
		local options = New("Frame", { BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, LayoutOrder = 1, Parent = optSection }, { Lib.grid(UDim2.new(0.5, -4, 0, 58), 6) })
		local lastQueue = ""
		local function renderOptions()
			Lib.clear(options)
			local acc = { researched = ClientState.get("researched") or {}, passes = ClientState.get("passes") or {} }
			local items = {}
			for _, w in Weapons.all() do
				table.insert(items, { kind = "weapon", def = w })
			end
			for _, u in Units.all() do
				table.insert(items, { kind = "unit", def = u })
			end
			for i, item in items do
				local d = item.def
				local ok = Unlocks.check(d, acc)
				local btn = Lib.button({
					Name = "Order_" .. d.id,
					LayoutOrder = (ok and 0 or 100) + i,
					BackgroundColor3 = ok and C.Raised or C.Inset,
					Parent = options,
					Activated = function()
						if not ok then
							Notifications.show(d.name .. " is locked - check Research" .. (d.pass and " or the Store" or ""), "info")
							return
						end
						local res = Net.request("QueueProduction", uid, item.kind, d.id)
						if res.ok then
							Sounds.play("Click", 1.1)
						elseif res.err then
							Notifications.show(res.err, "bad")
						end
					end,
				}, { Lib.corner(4), Lib.stroke(ok and C.LineSoft or C.Inset), Lib.pad(6, 8) })
				Lib.display({ Text = string.upper(item.kind == "weapon" and (d :: any).short or d.name), TextSize = 13, TextColor3 = ok and C.Text or C.Faint, Size = UDim2.new(1, -60, 0, 16), Parent = btn })
				Lib.display({ Text = "$" .. Format.short(d.cost), TextSize = 12, TextColor3 = ok and C.Good or C.Faint, AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, 0, 0, 0), Size = UDim2.fromOffset(58, 16), TextXAlignment = Enum.TextXAlignment.Right, Parent = btn })
				Lib.text({
					Text = ok and ("%d fuel · %d steel · %s"):format(d.fuel, d.steel, Format.duration(d.time)) or "LOCKED",
					TextSize = 11,
					FontFace = Theme.Font.BodyBold,
					TextColor3 = ok and C.Muted or C.Accent,
					Position = UDim2.fromOffset(0, 22),
					Size = UDim2.new(1, 0, 0, 14),
					Parent = btn,
				})
			end
		end
		renderOptions()
		rebuildSpecial = renderOptions
		updateSpecial = function()
			local q = (model:GetAttribute("Queue") :: string?) or "[]"
			if q == lastQueue then
				return
			end
			lastQueue = q
			local ok, items = pcall(HttpService.JSONDecode, HttpService, q)
			if not ok then
				items = {}
			end
			Lib.clear(queueHolder)
			queueTitle.Text = ("PRODUCTION QUEUE (%d / %d)"):format(#items, ClientState.get("queueLimit") or Config.MaxQueuePerFactory)
			if #items == 0 then
				Lib.text({ Text = "Queue is empty - pick a build order below.", TextSize = 12, TextColor3 = C.Muted, Parent = queueHolder })
			end
			for i, it in items do
				local cat = it.k == "unit" and Units.get(it.id) or Weapons.get(it.id)
				local rowF = Lib.inset({ Size = UDim2.new(1, 0, 0, 36), LayoutOrder = i, Parent = queueHolder })
				Lib.text({ Text = cat and cat.name or it.id, FontFace = Theme.Font.BodyBold, TextSize = 13, Position = UDim2.fromOffset(10, 2), Size = UDim2.new(0.6, 0, 0, 20), Parent = rowF })
				local bar = Lib.progress({ Segments = 10, Position = UDim2.new(0, 10, 0, 24), Size = UDim2.new(1, -90, 0, 5), Parent = rowF })
				bar.set(it.p or 0, i == 1 and C.Accent or C.Faint)
				Lib.button({
					Text = "CANCEL",
					Variant = "danger",
					TextSize = 10,
					AnchorPoint = Vector2.new(1, 0.5),
					Position = UDim2.new(1, -6, 0.5, 0),
					Size = UDim2.fromOffset(64, 24),
					Parent = rowF,
					Activated = function()
						Net.request("CancelProduction", uid, i)
					end,
				})
			end
		end
	elseif def.launcher then
		local special = section(scroll, "Strike", 4)
		Lib.text({ Text = "Open the war map, pick this weapon in the hotbar and click a target.", TextSize = 13, TextColor3 = C.TextSoft, TextWrapped = true, Size = UDim2.new(1, 0, 0, 34), LayoutOrder = 1, Parent = special })
		Lib.button({
			Variant = "primary",
			Text = "OPEN WAR MAP",
			TextSize = 13,
			Size = UDim2.fromOffset(180, 36),
			LayoutOrder = 2,
			Parent = special,
			Activated = function()
				Modal.close()
				Hub.call("goWar", "mainland")
			end,
		})
	elseif def.billboard then
		local special = section(scroll, "Billboard message", 4)
		local box = Lib.textbox({
			Text = ClientState.get("billboard") or "",
			PlaceholderText = "Your message (40 characters)",
			LayoutOrder = 1,
			Parent = special,
		})
		Lib.button({
			Variant = "primary",
			Text = "SAVE MESSAGE",
			TextSize = 13,
			Size = UDim2.fromOffset(160, 34),
			LayoutOrder = 2,
			Parent = special,
			Activated = function()
				local res = Net.request("SetBillboard", box.Text)
				if res.ok then
					Notifications.show("Billboards updated", "good")
				elseif res.err then
					Notifications.show(res.err, "bad")
				end
			end,
		})
	end

	-------------------------------------------------------------------
	-- live refresh
	-------------------------------------------------------------------
	local function refresh()
		if not model.Parent then
			Modal.close()
			return
		end
		local status = (model:GetAttribute("Status") :: string?) or ""
		local finishAt = model:GetAttribute("FinishAt") :: number?
		local now = Lib.serverNow()
		if finishAt then
			local start = (model:GetAttribute("BuildStart") :: number?) or now
			local frac = (now - start) / math.max(0.1, finishAt - start)
			status = ("Under construction · %s left"):format(Format.duration(finishAt - now))
			setStat(stats[1], "Construction", Format.percent(frac * 100), "being built", frac, C.Info)
			setStat(stats[2], "Cost", Format.cash(def.cost), "full refund if cancelled", nil)
			setStat(stats[3], "Health", ("%d"):format(def.hp), "max structure", nil)
			setStat(stats[4], "Footprint", ("%dx%d"):format(def.size[1], def.size[2]), "grid cells", nil)
		else
			local eff = ((model:GetAttribute("Eff") :: number?) or 0) / 100
			local hp = (model:GetAttribute("Hp") :: number?) or def.hp
			local d = ClientState.data
			if def.refine then
				local oil = (model:GetAttribute("Oil") :: number?) or 0
				local fuel = (model:GetAttribute("Fuel") :: number?) or 0
				setStat(stats[1], "Oil stored", ("%s/%s"):format(Format.short(oil), Format.short(def.refine.oilCap)), "waiting to refine", oil / def.refine.oilCap)
				setStat(stats[2], "Fuel stored", ("%s/%s"):format(Format.short(fuel), Format.short(def.refine.fuelCap)), "waiting for trucks", fuel / def.refine.fuelCap)
				setStat(stats[3], "Fuel output", ("%s/min"):format(Format.short(def.refine.rate * eff)), "refined from oil", eff, C.Teal)
				setStat(stats[4], "Oil arriving", ("+%s/min"):format(Format.short((model:GetAttribute("OilArriving") :: number?) or 0)), "from your oil pumps", nil)
			elseif def.factory then
				local fuel = (model:GetAttribute("Fuel") :: number?) or 0
				setStat(stats[1], "Fuel stored", ("%s/%s"):format(Format.short(fuel), Format.short(def.fuelCap or 0)), "delivered by trucks", fuel / (def.fuelCap or 1))
				setStat(stats[2], "Steel", Format.short(d.steel or 0), ("+%s/min nationally"):format(Format.short(d.steelRate or 0)), (d.steelCap or 0) > 0 and (d.steel or 0) / d.steelCap or 0, C.TextSoft)
				setStat(stats[3], "Build speed", ("x%s"):format(tostring(def.factory.speed * ((d.passes or {}).FastBuild and 2 or 1))), "Fast Construction doubles it", nil)
				setStat(stats[4], "Efficiency", Format.percent(eff * 100), "workers, power, road", eff, C.Teal)
			elseif def.launcher then
				local w = weaponForFamily(def.launcher)
				local stock = w and ((d.inventory or {})[w.id] or 0) or 0
				local l = (d.launchers or {})[def.launcher]
				local reloadUntil = (model:GetAttribute("ReloadUntil") :: number?) or 0
				setStat(stats[1], "Stockpile", ("%d/%d"):format(stock, w and w.stockCap or 60), (w and w.short or def.launcher) .. " rounds", w and stock / w.stockCap or 0)
				setStat(stats[2], "Launchers ready", l and ("%d/%d"):format(l.ready, l.total) or "0", "of this type", l and l.total > 0 and l.ready / l.total or 0, C.Good)
				setStat(stats[3], "Reload", reloadUntil > now and Format.duration(reloadUntil - now) or "READY", ("%ds per launch"):format(def.reload or 20), nil)
				setStat(stats[4], "Hits landed", Format.commas(((d.stats or {}).Hits) or 0), "unlocks better missiles", nil)
			elseif def.airDefense then
				local ad = def.airDefense
				setStat(stats[1], "Range", ("%d"):format(ad.range), "studs · +25% with radar", nil)
				setStat(stats[2], "Intercept", Format.percent(ad.chance * 100), "per engagement", ad.chance, C.Teal)
				setStat(stats[3], "Reload", Format.duration(ad.reload), "between shots", nil)
				setStat(stats[4], "Health", ("%d/%d"):format(hp, def.hp), "armor", hp / def.hp, C.Good)
			elseif def.housing then
				setStat(stats[1], "Residents", ("%s"):format(Format.commas(def.housing * eff)), ("of %s capacity"):format(Format.commas(def.housing)), eff, C.Teal)
				setStat(stats[2], "Population", Format.short(d.pop or 0), ("nation cap %s"):format(Format.short(d.popCap or 0)), (d.popCap or 0) > 0 and (d.pop or 0) / d.popCap or 0, C.Info)
				setStat(stats[3], "Power use", ("%d MW"):format(def.power or 0), "needs electricity", nil)
				setStat(stats[4], "Water use", ("%d"):format(def.water or 0), "needs water", nil)
			else
				local outText, outSub = "-", ""
				if def.powerOut then
					outText, outSub = ("%s MW"):format(Format.short(def.powerOut * eff)), "power produced"
				elseif def.waterOut then
					outText, outSub = Format.short(def.waterOut * eff), "water supplied"
				elseif def.oilOut then
					outText, outSub = ("%s/min"):format(Format.short(def.oilOut * eff)), "oil pumped"
				elseif def.steelOut then
					outText, outSub = ("%s/min"):format(Format.short(def.steelOut * eff)), "steel produced"
				elseif def.rpOut then
					outText, outSub = ("%s/min"):format(Format.short(def.rpOut * eff)), "research points"
				elseif def.income then
					outText, outSub = Format.cash(def.income * eff), "earned per pay"
				elseif def.service then
					outText, outSub = Format.short(def.service.serves * eff), string.lower(def.service.kind) .. " coverage"
				elseif def.storage then
					outText, outSub = "+" .. Format.short((def.storage.oil or 0) + (def.storage.steel or 0)), "extra storage"
				elseif def.depot then
					outText, outSub = "+" .. def.depot, "army capacity"
				elseif def.radar then
					outText, outSub = "+25%", "air defense range"
				end
				setStat(stats[1], "Output", outText, outSub, nil)
				setStat(stats[2], "Efficiency", Format.percent(eff * 100), "workers, power, water, road", eff, C.Teal)
				setStat(stats[3], "Workers", ("%d"):format(def.workers or 0), "needed to run", nil)
				setStat(stats[4], "Health", ("%d/%d"):format(hp, def.hp), model:GetAttribute("Damaged") and "knocked out!" or "structure", hp / def.hp, C.Good)
			end
		end
		statusText.Text = string.upper(status)
		local col = statusColor(status, model)
		statusText.TextColor3 = col
		statusDot.BackgroundColor3 = col
		if model:GetAttribute("Connected") == false and def.needsRoad then
			doingDesc.Text = "No road access: place a road next to this building to run at full speed."
		else
			doingDesc.Text = Hub.describeBuilding and Hub.describeBuilding(def) or def.desc
		end
		local damaged = model:GetAttribute("Damaged") == true
		repairBtn.Visible = damaged
		repairBtn.Text = ("REPAIR %s"):format(Format.cash(math.floor(def.cost * Config.RepairCostRate)))
		if updateSpecial then
			updateSpecial()
		end
	end

	refresh()
	local acc = 0
	local conn = RunService.Heartbeat:Connect(function(dt)
		acc += dt
		if acc >= 0.4 then
			acc = 0
			refresh()
		end
	end)
	local unsubscribe = ClientState.onAny(function(patch)
		if (patch.researched or patch.passes) and rebuildSpecial and def.factory then
			rebuildSpecial()
		end
	end)
	win.onClose(function()
		unsubscribe()
		conn:Disconnect()
	end)
end

function BuildingPanel.init()
	Hub.openBuilding = BuildingPanel.open
end

return BuildingPanel
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="58">
            <Properties>
              <string name="Name">Effects</string>
              <string name="Source"><![CDATA[--[[
	Effects
	Client-side visuals for combat:
	  * missiles / drones flying their synced Ballistics path with trails
	  * interceptor missiles that meet incoming strikes mid-air
	  * explosions (flash, smoke, debris-free Explosion), cluster scatter
	  * tracer shots between vehicles, move markers, build-complete sparkle
]]

local Debris = game:GetService("Debris")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Shared = ReplicatedStorage.Shared
local Ballistics = require(Shared.Util.Ballistics)
local ModelBuilder = require(Shared.ModelBuilder)
local Weapons = require(Shared.Catalog.Weapons)
local Net = require(Shared.Net)

local Client = script.Parent.Parent
local Hub = require(Client.Hub)
local Lib = require(Client.UI.Lib)
local Sounds = require(script.Parent.Sounds)

local Effects = {}

local camera = workspace.CurrentCamera
local fx: Folder

type Flight = {
	model: Model,
	from: Vector3,
	to: Vector3,
	apex: number,
	kind: string,
	t0: number,
	flight: number,
	endAlpha: number?,
	done: boolean,
	onEnd: (() -> ())?,
}

local flights: { [any]: Flight } = {}
local shake = 0

local function addTrail(model: Model, color: Color3, width: number, smoke: boolean)
	local root = model.PrimaryPart :: BasePart
	local a0 = Instance.new("Attachment")
	a0.Position = Vector3.new(0, width / 2, 2)
	a0.Parent = root
	local a1 = Instance.new("Attachment")
	a1.Position = Vector3.new(0, -width / 2, 2)
	a1.Parent = root
	local trail = Instance.new("Trail")
	trail.Attachment0 = a0
	trail.Attachment1 = a1
	trail.Lifetime = 1.4
	trail.Color = ColorSequence.new(color, Color3.fromRGB(200, 200, 200))
	trail.Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.1), NumberSequenceKeypoint.new(1, 1) })
	trail.WidthScale = NumberSequence.new({ NumberSequenceKeypoint.new(0, 1), NumberSequenceKeypoint.new(1, 2.5) })
	trail.LightEmission = 0.4
	trail.FaceCamera = true
	trail.Parent = root
	if smoke then
		local tail = root:FindFirstChild("Tail") :: Attachment?
		local p = Instance.new("ParticleEmitter")
		p.Texture = "rbxasset://textures/particles/smoke_main.dds"
		p.Color = ColorSequence.new(Color3.fromRGB(220, 220, 215))
		p.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 1.2), NumberSequenceKeypoint.new(1, 5) })
		p.Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.3), NumberSequenceKeypoint.new(1, 1) })
		p.Lifetime = NumberRange.new(1.2, 2)
		p.Rate = 40
		p.Speed = NumberRange.new(0.5, 1.5)
		p.Parent = tail or root
		local glow = Instance.new("PointLight")
		glow.Color = Color3.fromRGB(255, 180, 90)
		glow.Brightness = 3
		glow.Range = 14
		glow.Parent = root
	end
end

function Effects.explosion(pos: Vector3, scale: number, airburst: boolean?)
	local s = math.max(0.4, scale)
	-- flash
	local flash = Instance.new("Part")
	flash.Shape = Enum.PartType.Ball
	flash.Anchored = true
	flash.CanCollide = false
	flash.CanQuery = false
	flash.CanTouch = false
	flash.CastShadow = false
	flash.Material = Enum.Material.Neon
	flash.Color = airburst and Color3.fromRGB(255, 230, 170) or Color3.fromRGB(255, 160, 60)
	flash.Size = Vector3.one * 4 * s
	flash.Position = pos
	flash.Parent = fx
	Lib.tween(flash, 0.45, { Size = Vector3.one * 26 * s, Transparency = 1 })
	Debris:AddItem(flash, 0.5)
	-- smoke column
	local holder = Instance.new("Part")
	holder.Anchored = true
	holder.CanCollide = false
	holder.CanQuery = false
	holder.Transparency = 1
	holder.Size = Vector3.one
	holder.Position = pos
	holder.Parent = fx
	local smoke = Instance.new("ParticleEmitter")
	smoke.Texture = "rbxasset://textures/particles/smoke_main.dds"
	smoke.Color = ColorSequence.new(airburst and Color3.fromRGB(150, 150, 150) or Color3.fromRGB(70, 66, 60))
	smoke.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 6 * s), NumberSequenceKeypoint.new(1, 18 * s) })
	smoke.Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.2), NumberSequenceKeypoint.new(1, 1) })
	smoke.Lifetime = NumberRange.new(2.5, 4)
	smoke.Speed = NumberRange.new(6 * s, 14 * s)
	smoke.SpreadAngle = Vector2.new(60, 60)
	smoke.Rate = 0
	smoke.Parent = holder
	smoke:Emit(math.floor(14 * s))
	local fire = Instance.new("ParticleEmitter")
	fire.Texture = "rbxasset://textures/particles/fire_main.dds"
	fire.Color = ColorSequence.new(Color3.fromRGB(255, 190, 90), Color3.fromRGB(255, 90, 30))
	fire.LightEmission = 1
	fire.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 5 * s), NumberSequenceKeypoint.new(1, 1) })
	fire.Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0), NumberSequenceKeypoint.new(1, 1) })
	fire.Lifetime = NumberRange.new(0.4, 0.8)
	fire.Speed = NumberRange.new(10 * s, 24 * s)
	fire.SpreadAngle = Vector2.new(180, 180)
	fire.Rate = 0
	fire.Parent = holder
	fire:Emit(math.floor(24 * s))
	Debris:AddItem(holder, 5)
	-- sound + shockwave (no physics damage, purely visual)
	local e = Instance.new("Explosion")
	e.Position = pos
	e.BlastPressure = 0
	e.BlastRadius = 0
	e.DestroyJointRadiusPercent = 0
	e.ExplosionType = Enum.ExplosionType.NoCraters
	e.Visible = false
	e.Parent = fx
	local dist = (camera.CFrame.Position - pos).Magnitude
	shake = math.max(shake, math.clamp(1 - dist / (700 * s), 0, 1) * 1.2 * s)
end

local function spawnFlight(id: any, weaponId: string?, from: Vector3, to: Vector3, apex: number, kind: string, t0: number, flight: number, endAlpha: number?, interceptor: boolean?)
	local def = weaponId and Weapons.get(weaponId)
	local model
	if interceptor or not def then
		model = ModelBuilder.projectile({ kind = "missile", color = Color3.fromRGB(240, 240, 236), id = "GLCM" })
		model:ScaleTo(0.6)
	else
		model = ModelBuilder.projectile(def)
	end
	model.Parent = fx
	addTrail(model, interceptor and Color3.fromRGB(255, 255, 255) or Color3.fromRGB(255, 200, 120), interceptor and 0.6 or 1, kind ~= "drone")
	flights[id] = { model = model, from = from, to = to, apex = apex, kind = kind, t0 = t0, flight = flight, endAlpha = endAlpha, done = false }
	return flights[id]
end

local function onProjectile(data)
	local weapon = Weapons.get(data.w)
	spawnFlight(data.id, data.w, data.from, data.to, data.apex, data.kind, data.t0, data.flight, data.ic)
	Sounds.at("Launch", data.from, 0.6)
	if data.ic and data.icFrom then
		-- interceptor timed to meet the strike at the intercept point
		local meetTime = data.t0 + data.flight * data.ic
		local meetPos = Ballistics.position(data.from, data.to, data.apex, data.kind, data.ic)
		local dur = math.clamp(data.flight * data.ic * 0.6, 1.2, 3)
		local start = meetTime - dur
		task.delay(math.max(0, start - Lib.serverNow()), function()
			spawnFlight(tostring(data.id) .. "i", nil, data.icFrom, meetPos, 30, "missile", start, dur, 1, true)
			Sounds.at("Launch", data.icFrom, 0.5)
		end)
	end
	local _ = weapon
end

local function endFlight(id: any)
	local f = flights[id]
	if f then
		flights[id] = nil
		local root = f.model.PrimaryPart
		if root then
			-- let trails fade out
			for _, d in f.model:GetDescendants() do
				if d:IsA("BasePart") then
					d.Transparency = 1
				elseif d:IsA("ParticleEmitter") then
					d.Enabled = false
				end
			end
		end
		Debris:AddItem(f.model, 2)
	end
end

local function onProjectileEnd(data)
	local f = flights[data.id]
	local pos: Vector3
	if data.intercepted then
		if f then
			pos = Ballistics.position(f.from, f.to, f.apex, f.kind, f.endAlpha or 0.7)
		else
			return
		end
		endFlight(data.id)
		endFlight(tostring(data.id) .. "i")
		Effects.explosion(pos, 0.7, true)
		return
	end
	endFlight(data.id)
	pos = data.pos or (f and f.to) or Vector3.zero
	local w = Weapons.get(data.w or "")
	local scale = w and math.clamp(w.radius / 24, 0.6, 2) or 1
	if data.w == "CLUSTER" and w then
		for i = 1, 8 do
			task.delay(i * 0.08, function()
				local a = math.random() * math.pi * 2
				local r = math.random() * w.radius
				Effects.explosion(pos + Vector3.new(math.cos(a) * r, 0, math.sin(a) * r), 0.6)
			end)
		end
	else
		Effects.explosion(pos, scale)
	end
end

local function step()
	local now = Lib.serverNow()
	for id, f in flights do
		local alpha = (now - f.t0) / f.flight
		if alpha < 0 then
			f.model.Parent = nil
		else
			f.model.Parent = fx
			local limit = f.endAlpha or 1
			local a = math.min(alpha, limit)
			f.model:PivotTo(Ballistics.cframe(f.from, f.to, f.apex, f.kind, a))
			if alpha > limit + 2 then
				endFlight(id) -- safety: server never answered
			end
		end
	end
	if shake > 0.01 then
		local o = Vector3.new(math.random() - 0.5, math.random() - 0.5, math.random() - 0.5) * shake
		camera.CFrame *= CFrame.new(o)
		shake *= 0.88
	end
end

local function tracer(from: Vector3, to: Vector3, artillery: boolean)
	if artillery then
		local id = {}
		local flight = math.clamp((to - from).Magnitude / 220, 0.8, 2.2)
		local now = Lib.serverNow()
		spawnFlight(id, nil, from, to, 40, "missile", now, flight, 1, true)
		task.delay(flight, function()
			endFlight(id)
			Effects.explosion(to, 0.35)
		end)
		return
	end
	local p = Instance.new("Part")
	p.Anchored = true
	p.CanCollide = false
	p.CanQuery = false
	p.CanTouch = false
	p.CastShadow = false
	p.Material = Enum.Material.Neon
	p.Color = Color3.fromRGB(255, 220, 140)
	local len = (to - from).Magnitude
	p.Size = Vector3.new(0.25, 0.25, len)
	p.CFrame = CFrame.lookAt((from + to) / 2, to)
	p.Parent = fx
	Lib.tween(p, 0.18, { Transparency = 1 })
	Debris:AddItem(p, 0.2)
end

local function moveMarker(pos: Vector3)
	local ring = Instance.new("Part")
	ring.Shape = Enum.PartType.Cylinder
	ring.Anchored = true
	ring.CanCollide = false
	ring.CanQuery = false
	ring.CastShadow = false
	ring.Material = Enum.Material.Neon
	ring.Color = Color3.fromRGB(90, 230, 130)
	ring.Size = Vector3.new(0.2, 4, 4)
	ring.CFrame = CFrame.new(pos.X, 0.3, pos.Z) * CFrame.Angles(0, 0, math.rad(90))
	ring.Transparency = 0.3
	ring.Parent = fx
	Lib.tween(ring, 0.6, { Size = Vector3.new(0.2, 26, 26), Transparency = 1 })
	Debris:AddItem(ring, 0.7)
end

local function buildDone(pos: Vector3)
	local holder = Instance.new("Part")
	holder.Anchored = true
	holder.CanCollide = false
	holder.CanQuery = false
	holder.Transparency = 1
	holder.Size = Vector3.one
	holder.Position = pos + Vector3.new(0, 4, 0)
	holder.Parent = fx
	local sparkle = Instance.new("ParticleEmitter")
	sparkle.Texture = "rbxasset://textures/particles/sparkles_main.dds"
	sparkle.Color = ColorSequence.new(Color3.fromRGB(255, 230, 120))
	sparkle.LightEmission = 1
	sparkle.Size = NumberSequence.new(1.2, 0)
	sparkle.Lifetime = NumberRange.new(0.6, 1.2)
	sparkle.Speed = NumberRange.new(8, 16)
	sparkle.SpreadAngle = Vector2.new(180, 180)
	sparkle.Rate = 0
	sparkle.Parent = holder
	sparkle:Emit(30)
	Debris:AddItem(holder, 2)
	Sounds.play("Place", 1.3)
end

function Effects.init()
	fx = Instance.new("Folder")
	fx.Name = "FX"
	fx.Parent = workspace
	Net.event("Projectile").OnClientEvent:Connect(onProjectile)
	Net.event("ProjectileEnd").OnClientEvent:Connect(onProjectileEnd)
	Net.event("Effect").OnClientEvent:Connect(function(kind, a, b, c)
		if kind == "Explosion" then
			Effects.explosion(a, b or 1)
		elseif kind == "Shot" then
			tracer(a, b, c == true)
		elseif kind == "BuildDone" then
			buildDone(a)
		elseif kind == "Welcome" then
			Hub.call("showWelcome", b, c)
		elseif kind == "ResearchDone" then
			Sounds.play("Success")
		elseif kind == "RankUp" then
			Hub.call("showRankUp", a)
		end
	end)
	Hub.moveMarker = moveMarker
	-- after the camera scripts so screen shake isn't overwritten
	RunService:BindToRenderStep("FFEffects", Enum.RenderPriority.Camera.Value + 1, step)
end

return Effects
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="59">
            <Properties>
              <string name="Name">HUD</string>
              <string name="Source"><![CDATA[--[[
	HUD - Field Command
	  top-left    nation badge (flag, name, rank, power progress)
	  top-center  treasury / population / morale / power / water bar
	              + logistics strip (oil, steel, research, army)
	  top-right   PvP switch + status chips (boost, shield, PvP lock)
	  left        mission card (objective chain)
	  bottom      command dock: BUILD, ARMY, RESEARCH, WAR MAP, REWARDS, STORE
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")

local Shared = ReplicatedStorage.Shared
local Format = require(Shared.Util.Format)
local Flag = require(Shared.Util.Flag)
local Net = require(Shared.Net)

local Client = script.Parent.Parent
local ClientState = require(Client.ClientState)
local Hub = require(Client.Hub)
local Lib = require(Client.UI.Lib)
local Theme = require(Client.UI.Theme)
local Icons = require(Client.UI.Icons)
local Notifications = require(script.Parent.Notifications)
local Sounds = require(script.Parent.Sounds)

local New = Lib.New
local C = Theme.Color

local HUD = {}

local refs: { [string]: any } = {}
local dockButtons: { [string]: TextButton } = {}

---------------------------------------------------------------------------
-- Nation badge
---------------------------------------------------------------------------
local function buildBadge(gui: GuiObject)
	local badge = Lib.panel({
		Name = "NationBadge",
		Position = UDim2.fromOffset(16, 16),
		Size = UDim2.fromOffset(318, 74),
		Parent = gui,
	})
	Lib.brackets(badge, C.Accent, 8, 2, 3)
	local flagBox = New("Frame", {
		Name = "FlagBox",
		BackgroundColor3 = C.Inset,
		Position = UDim2.fromOffset(10, 12),
		Size = UDim2.fromOffset(72, 48),
		Parent = badge,
	}, { Lib.corner(3), Lib.stroke(C.Line, 1, 0.2) })
	refs.flagBox = New("Frame", { Name = "Holder", BackgroundTransparency = 1, Size = UDim2.fromScale(1, 1), ClipsDescendants = true, Parent = flagBox })
	refs.foundHint = Lib.display({
		Name = "Found",
		Text = "+ FLAG",
		TextSize = 12,
		TextColor3 = C.Accent,
		TextXAlignment = Enum.TextXAlignment.Center,
		Size = UDim2.fromScale(1, 1),
		ZIndex = 4,
		Parent = flagBox,
	})
	local edit = New("TextButton", {
		Name = "EditNation",
		BackgroundTransparency = 1,
		Text = "",
		Size = UDim2.fromScale(1, 1),
		ZIndex = 5,
		Parent = flagBox,
		Activated = function()
			Hub.call("openNation")
		end,
	})
	local _ = edit
	refs.nationName = Lib.display({
		Text = "UNNAMED NATION",
		TextSize = 19,
		Position = UDim2.fromOffset(94, 8),
		Size = UDim2.new(1, -104, 0, 24),
		Parent = badge,
	})
	refs.rank = Lib.display({
		Text = "RANK I · OUTPOST",
		TextSize = 12,
		TextColor3 = C.Accent,
		Position = UDim2.fromOffset(94, 32),
		Size = UDim2.new(1, -104, 0, 14),
		Parent = badge,
	})
	refs.rankBar = Lib.progress({ Segments = 10, Position = UDim2.fromOffset(94, 52), Size = UDim2.new(1, -104, 0, 6), Parent = badge })
	refs.power = Lib.text({
		Text = "",
		TextSize = 11,
		TextColor3 = C.Muted,
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.new(1, -10, 0, 32),
		Size = UDim2.fromOffset(110, 14),
		TextXAlignment = Enum.TextXAlignment.Right,
		Parent = badge,
	})
end

---------------------------------------------------------------------------
-- Resource bar
---------------------------------------------------------------------------
local function cell(parent: Instance, name: string, width: number, order: number, icon: string, color: Color3)
	local f = New("Frame", {
		Name = name,
		BackgroundTransparency = 1,
		Size = UDim2.fromOffset(width, 62),
		LayoutOrder = order,
		Parent = parent,
	})
	local ic = Icons.get(icon, 16, color)
	ic.Position = UDim2.fromOffset(12, 10)
	ic.Parent = f
	Lib.caption(name, { Position = UDim2.fromOffset(34, 9), Size = UDim2.new(1, -40, 0, 14), Parent = f })
	local value = Lib.display({ Text = "-", TextSize = 22, Position = UDim2.fromOffset(12, 24), Size = UDim2.new(1, -20, 0, 24), Parent = f })
	local sub = Lib.text({ Text = "", TextSize = 11, TextColor3 = C.Muted, FontFace = Theme.Font.BodyBold, Position = UDim2.fromOffset(12, 46), Size = UDim2.new(1, -20, 0, 12), Parent = f })
	return f, value, sub
end

local function vline(parent: Instance, order: number)
	New("Frame", { BackgroundColor3 = C.Line, BackgroundTransparency = 0.45, BorderSizePixel = 0, Size = UDim2.fromOffset(1, 44), LayoutOrder = order, Parent = parent })
end

local function buildResources(gui: GuiObject)
	local bar = Lib.panel({
		Name = "Resources",
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0, 16),
		Size = UDim2.fromOffset(746, 62),
		Parent = gui,
	})
	local row = New("Frame", { BackgroundTransparency = 1, Size = UDim2.fromScale(1, 1), Parent = bar }, { Lib.list("x", 0, nil, Enum.VerticalAlignment.Center) })
	local cash, cashV, cashS = cell(row, "Treasury", 200, 1, "coin", C.Good)
	refs.cash, refs.income = cashV, cashS
	refs.payBar = Lib.progress({ Position = UDim2.new(0, 12, 1, -4), Size = UDim2.new(1, -24, 0, 3), Parent = cash })
	refs.payTimer = Lib.text({
		Text = "00:00",
		FontFace = Theme.Font.Mono,
		TextSize = 11,
		TextColor3 = C.Accent,
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.new(1, -10, 0, 9),
		Size = UDim2.fromOffset(60, 14),
		TextXAlignment = Enum.TextXAlignment.Right,
		Parent = cash,
	})
	refs.cashCell = cash
	vline(row, 2)
	local _, popV, popS = cell(row, "Population", 150, 3, "people", C.Info)
	refs.pop, refs.workers = popV, popS
	vline(row, 4)
	local mood, moodV = cell(row, "Morale", 118, 5, "smile", C.Gold)
	refs.mood = moodV
	refs.moodBar = Lib.progress({ Segments = 5, Position = UDim2.new(0, 12, 0, 50), Size = UDim2.new(1, -24, 0, 4), Parent = mood })
	vline(row, 6)
	local pw, pwV = cell(row, "Power", 136, 7, "bolt", C.Gold)
	refs.powerV = pwV
	refs.powerBar = Lib.progress({ Position = UDim2.new(0, 12, 0, 50), Size = UDim2.new(1, -24, 0, 4), Parent = pw })
	vline(row, 8)
	local wt, wtV = cell(row, "Water", 136, 9, "drop", C.Info)
	refs.waterV = wtV
	refs.waterBar = Lib.progress({ Position = UDim2.new(0, 12, 0, 50), Size = UDim2.new(1, -24, 0, 4), Parent = wt })

	-- logistics strip
	local strip = New("Frame", {
		Name = "Logistics",
		BackgroundTransparency = 1,
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0, 84),
		Size = UDim2.fromOffset(746, 24),
		Parent = gui,
	}, { Lib.list("x", 6, Enum.HorizontalAlignment.Center) })
	local function chip(icon: string, color: Color3, order: number): TextLabel
		local f = New("Frame", {
			BackgroundColor3 = C.Panel,
			BackgroundTransparency = 0.15,
			AutomaticSize = Enum.AutomaticSize.X,
			Size = UDim2.fromOffset(0, 24),
			LayoutOrder = order,
			Parent = strip,
		}, { Lib.corner(3), Lib.stroke(C.LineSoft, 1, 0.2), Lib.pad(0, 9, 0, 6), Lib.list("x", 6, nil, Enum.VerticalAlignment.Center) })
		local ic = Icons.get(icon, 13, color)
		ic.LayoutOrder = 1
		ic.Parent = f
		return Lib.text({
			Text = "-",
			FontFace = Theme.Font.BodyBold,
			TextSize = 12,
			AutomaticSize = Enum.AutomaticSize.X,
			Size = UDim2.new(0, 0, 1, 0),
			TextTruncate = Enum.TextTruncate.None,
			LayoutOrder = 2,
			Parent = f,
		})
	end
	refs.oil = chip("barrel", Color3.fromRGB(214, 176, 120), 1)
	refs.steel = chip("beam", C.TextSoft, 2)
	refs.rp = chip("flask", C.Teal, 3)
	refs.army = chip("tank", Color3.fromRGB(170, 200, 130), 4)
end

---------------------------------------------------------------------------
-- PvP + status chips
---------------------------------------------------------------------------
local function buildStatus(gui: GuiObject)
	local pvp = Lib.panel({
		Name = "PvpPanel",
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.new(1, -16, 0, 16),
		Size = UDim2.fromOffset(170, 48),
		Parent = gui,
	})
	Lib.display({ Text = "PVP", TextSize = 15, Position = UDim2.fromOffset(14, 0), Size = UDim2.fromOffset(40, 48), Parent = pvp })
	refs.pvpState = Lib.display({ Text = "OFF", TextSize = 13, TextColor3 = C.Muted, Position = UDim2.fromOffset(52, 0), Size = UDim2.fromOffset(40, 48), Parent = pvp })
	local toggle, setToggle = Lib.toggle({
		Name = "PvpToggle",
		AnchorPoint = Vector2.new(1, 0.5),
		Position = UDim2.new(1, -12, 0.5, 0),
		Parent = pvp,
	}, function(want)
		local res = Net.request("SetPvp", want)
		if not res.ok and res.err then
			Notifications.show(res.err, "bad")
		end
	end)
	local _ = toggle
	refs.setPvp = setToggle
	refs.pvpPanel = pvp

	refs.chips = New("Frame", {
		Name = "StatusChips",
		BackgroundTransparency = 1,
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.new(1, -16, 0, 72),
		Size = UDim2.fromOffset(330, 120),
		Parent = gui,
	}, { Lib.list("y", 5, Enum.HorizontalAlignment.Right) })
end

local function setChip(name: string, text: string?, color: Color3?)
	local existing = refs.chips:FindFirstChild(name)
	if not text then
		if existing then
			existing:Destroy()
		end
		return
	end
	if existing then
		(existing:FindFirstChild("Label", true) :: TextLabel).Text = text
		return
	end
	local col = color or C.Accent
	local chip = New("Frame", {
		Name = name,
		BackgroundColor3 = C.Panel,
		BackgroundTransparency = 0.08,
		AutomaticSize = Enum.AutomaticSize.X,
		Size = UDim2.fromOffset(0, 24),
		Parent = refs.chips,
	}, {
		Lib.corner(3),
		Lib.stroke(col, 1, 0.45),
		Lib.pad(0, 10, 0, 8),
		Lib.list("x", 7, nil, Enum.VerticalAlignment.Center),
		New("Frame", { BackgroundColor3 = col, Size = UDim2.fromOffset(6, 6), LayoutOrder = 1 }, { Lib.round() }),
		Lib.display({
			Name = "Label",
			Text = text,
			TextSize = 11,
			TextColor3 = col,
			AutomaticSize = Enum.AutomaticSize.X,
			Size = UDim2.new(0, 0, 1, 0),
			TextTruncate = Enum.TextTruncate.None,
			LayoutOrder = 2,
		}),
	})
	local _ = chip
end

---------------------------------------------------------------------------
-- Mission card
---------------------------------------------------------------------------
local function buildMission(gui: GuiObject)
	local card = Lib.panel({
		Name = "Mission",
		Position = UDim2.fromOffset(16, 104),
		Size = UDim2.fromOffset(300, 118),
		Parent = gui,
	})
	Lib.hazard({ Position = UDim2.fromOffset(0, 0), Size = UDim2.new(1, 0, 0, 4), BackgroundTransparency = 0.15, Parent = card }, C.Accent, C.Panel, 9)
	refs.missionCaption = Lib.caption("Mission", { TextColor3 = C.Accent, Position = UDim2.fromOffset(14, 12), Size = UDim2.new(1, -28, 0, 14), Parent = card })
	refs.missionText = Lib.text({
		Text = "...",
		FontFace = Theme.Font.BodyHeavy,
		TextSize = 16,
		TextWrapped = true,
		Position = UDim2.fromOffset(14, 28),
		Size = UDim2.new(1, -28, 0, 22),
		Parent = card,
	})
	refs.missionBar = Lib.progress({ Segments = 12, Position = UDim2.fromOffset(14, 58), Size = UDim2.new(1, -28, 0, 6), Parent = card })
	refs.missionProgress = Lib.text({
		Text = "0 / 0",
		FontFace = Theme.Font.Mono,
		TextSize = 12,
		TextColor3 = C.Muted,
		Position = UDim2.fromOffset(14, 72),
		Size = UDim2.new(0.5, -14, 0, 32),
		Parent = card,
	})
	refs.missionReward = Lib.chip("$0", C.GoodSoft, C.Good, {
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.new(1, -14, 0, 78),
		Parent = card,
	})
	refs.missionClaim = Lib.button({
		Variant = "primary",
		Text = "CLAIM REWARD",
		TextSize = 14,
		Position = UDim2.fromOffset(14, 74),
		Size = UDim2.new(1, -28, 0, 32),
		Visible = false,
		Parent = card,
		Activated = function()
			local res = Net.request("ClaimQuest")
			if res.ok then
				Sounds.play("Success")
			elseif res.err then
				Notifications.show(res.err, "bad")
			end
		end,
	})
	refs.missionCard = card
end

---------------------------------------------------------------------------
-- Command dock
---------------------------------------------------------------------------
local DOCK = {
	{ id = "Build", label = "BUILD", key = "B", icon = "hammer", hub = "toggleBuild" },
	{ id = "Army", label = "ARMY", key = "G", icon = "tank", hub = "openArmy" },
	{ id = "Research", label = "RESEARCH", key = "T", icon = "flask", hub = "openResearch" },
	{ id = "War", label = "WAR MAP", key = "M", icon = "map", hub = "openTravel" },
	{ id = "Rewards", label = "REWARDS", key = "J", icon = "gift", hub = "openRewards" },
	{ id = "Store", label = "STORE", key = "", icon = "cart", hub = "openShop", gold = true },
}

local function buildDock(gui: GuiObject)
	local dock = Lib.panel({
		Name = "CommandDock",
		AnchorPoint = Vector2.new(0.5, 1),
		Position = UDim2.new(0.5, 0, 1, -14),
		Size = UDim2.fromOffset(#DOCK * 86 + 16, 86),
		Parent = gui,
	}, { Lib.pad(8), Lib.list("x", 6, Enum.HorizontalAlignment.Center, Enum.VerticalAlignment.Center) })
	Lib.brackets(dock, C.Accent, 12, 2, 4)
	for i, d in DOCK do
		local btn = Lib.button({
			Name = d.id,
			Size = UDim2.fromOffset(80, 70),
			BackgroundColor3 = d.gold and C.GoldSoft or C.Raised,
			LayoutOrder = i,
			Parent = dock,
			Activated = function()
				Hub.call(d.hub)
			end,
		}, { Lib.corner(4), Lib.stroke(d.gold and C.Gold or C.LineSoft, 1, d.gold and 0.2 or 0) })
		local ic = Icons.get(d.icon, 26, d.gold and C.Gold or C.Text)
		ic.AnchorPoint = Vector2.new(0.5, 0)
		ic.Position = UDim2.new(0.5, 0, 0, 10)
		ic.Parent = btn
		Lib.display({
			Name = "Label",
			Text = d.label,
			TextSize = 12,
			TextColor3 = d.gold and C.Gold or C.TextSoft,
			TextXAlignment = Enum.TextXAlignment.Center,
			Position = UDim2.new(0, 0, 1, -22),
			Size = UDim2.new(1, 0, 0, 16),
			Parent = btn,
		})
		if d.key ~= "" then
			Lib.text({
				Text = d.key,
				FontFace = Theme.Font.Mono,
				TextSize = 10,
				TextColor3 = C.Faint,
				Position = UDim2.fromOffset(6, 3),
				Size = UDim2.fromOffset(14, 12),
				Parent = btn,
			})
		end
		New("Frame", {
			Name = "Badge",
			BackgroundColor3 = C.Bad,
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.new(1, -8, 0, 8),
			Size = UDim2.fromOffset(10, 10),
			Visible = false,
			Parent = btn,
		}, { Lib.round(), Lib.stroke(C.Panel, 2) })
		dockButtons[d.id] = btn
	end
	refs.dock = dock

	UserInputService.InputBegan:Connect(function(input, processed)
		if processed then
			return
		end
		local map = { [Enum.KeyCode.G] = "openArmy", [Enum.KeyCode.T] = "openResearch", [Enum.KeyCode.M] = "openTravel", [Enum.KeyCode.J] = "openRewards" }
		local hub = map[input.KeyCode]
		if hub and ClientState.mode ~= "build" then
			Hub.call(hub)
		end
	end)
end

---------------------------------------------------------------------------
-- refresh
---------------------------------------------------------------------------
local RANKS = { "I", "II", "III", "IV", "V", "VI", "VII" }

local function refresh()
	local d = ClientState.data
	if d.cash == nil then
		return
	end
	refs.cash.Text = Format.cash(d.cash)
	local income = d.income or 0
	refs.income.Text = (income >= 0 and "+" or "") .. Format.cash(income) .. " / pay"
	refs.income.TextColor3 = income >= 0 and C.Good or C.Bad
	refs.pop.Text = Format.short(d.pop or 0)
	local free = math.max(0, (d.pop or 0) - (d.workersUsed or 0))
	refs.workers.Text = ("%s idle · cap %s"):format(Format.short(free), Format.short(d.popCap or 0))
	local mood = d.happiness or 0
	refs.mood.Text = Format.percent(mood)
	refs.moodBar.set(mood / 100, mood >= 70 and C.Good or (mood >= 40 and C.Gold or C.Bad))

	local power, water = d.power or { 0, 0 }, d.water or { 0, 0 }
	refs.powerV.Text = ("%s/%s"):format(Format.short(power[1]), Format.short(power[2]))
	refs.powerBar.set(power[2] > 0 and power[1] / power[2] or 1, power[1] + 0.5 < power[2] and C.Bad or C.Gold)
	refs.waterV.Text = ("%s/%s"):format(Format.short(water[1]), Format.short(water[2]))
	refs.waterBar.set(water[2] > 0 and water[1] / water[2] or 1, water[1] + 0.5 < water[2] and C.Bad or C.Info)

	refs.oil.Text = ("OIL %s/%s"):format(Format.short(d.oil or 0), Format.short(d.oilCap or 0))
	refs.steel.Text = ("STEEL %s/%s"):format(Format.short(d.steel or 0), Format.short(d.steelCap or 0))
	refs.rp.Text = ("RP %s  +%s/m"):format(Format.short(d.rp or 0), Format.short(d.rpRate or 0))
	refs.army.Text = ("ARMY %d/%d"):format(d.units or 0, d.unitCap or 0)

	local pvpOn = d.pvp == true
	refs.setPvp(pvpOn)
	refs.pvpState.Text = pvpOn and "ON" or "OFF"
	refs.pvpState.TextColor3 = pvpOn and C.Bad or C.Muted

	-- nation badge
	local nation = d.nation
	if nation ~= nil then
		local founded = type(nation) == "table" and nation.name ~= nil
		refs.nationName.Text = founded and string.upper(nation.name) or "UNNAMED NATION"
		refs.foundHint.Visible = not founded
		local flag = founded and nation.flag or ""
		if flag ~= refs.lastFlag then
			refs.lastFlag = flag
			Lib.clear(refs.flagBox)
			if founded then
				Flag.draw(refs.flagBox, flag)
			end
		end
	end
	local rank = d.rank
	if rank then
		refs.rank.Text = ("RANK %s · %s"):format(RANKS[rank.level] or tostring(rank.level), string.upper(rank.name))
		refs.rankBar.set(rank.progress or 0)
		refs.power.Text = ("POWER %s"):format(Format.short(rank.power or 0))
	end

	-- mission
	local q = d.quest
	if q then
		refs.missionCard.Visible = true
		refs.missionCaption.Text = ("MISSION %02d"):format(q.i)
		refs.missionText.Text = q.text
		refs.missionBar.set(q.max > 0 and q.cur / q.max or 0, q.done and C.Good or nil)
		refs.missionProgress.Text = ("%s / %s"):format(Format.commas(q.cur), Format.commas(q.max))
		;(refs.missionReward:FindFirstChild("Label") :: TextLabel).Text = Format.cash(q.reward)
		refs.missionClaim.Visible = q.done
		refs.missionProgress.Visible = not q.done
		refs.missionReward.Visible = not q.done
	else
		refs.missionCard.Visible = false
	end

	local daily = d.daily
	local rewardsReady = (daily ~= nil and daily.canClaim == true) or ((d.giftAt or math.huge) <= Lib.serverNow())
	;(dockButtons.Rewards:FindFirstChild("Badge") :: Frame).Visible = rewardsReady
	;(dockButtons.Research:FindFirstChild("Badge") :: Frame).Visible = d.research == false and (d.rp or 0) >= 40
end

function HUD.payPop(amount: number)
	Notifications.float((amount >= 0 and "+" or "") .. Format.cash(amount), UDim2.new(0.5, -270, 0, 88), amount >= 0 and C.Good or C.Bad)
end

function HUD.init(gui: GuiObject)
	buildBadge(gui)
	buildResources(gui)
	buildStatus(gui)
	buildMission(gui)
	buildDock(gui)
	ClientState.onAny(refresh)

	local lastCash: number? = nil
	ClientState.on("nextPay", function()
		local cash = ClientState.get("cash")
		if lastCash and cash then
			HUD.payPop(ClientState.get("income") or 0)
		end
		lastCash = cash
	end)

	ClientState.onMode(function(mode)
		local build = dockButtons.Build
		;(build:FindFirstChild("Label") :: TextLabel).Text = mode == "war" and "HOME" or "BUILD"
		refs.dock.Visible = mode ~= "build"
		refs.missionCard.Visible = mode == "play" and ClientState.get("quest") ~= false
	end)

	local acc = 0
	RunService.Heartbeat:Connect(function(dt)
		acc += dt
		if acc < 0.2 then
			return
		end
		acc = 0
		local d = ClientState.data
		local now = Lib.serverNow()
		if d.nextPay then
			local left = d.nextPay - now
			refs.payTimer.Text = "PAY " .. Format.clock(left)
			refs.payBar.set(1 - math.clamp(left / 60, 0, 1), C.Accent)
		end
		local boost = (d.boostUntil or 0) - os.time()
		setChip("Boost", boost > 0 and ("2X CASH  " .. Format.clock(boost)) or nil, C.Good)
		local shield = (d.shield or 0) - os.time()
		setChip("Shield", shield > 0 and ("SHIELD  " .. Format.clock(shield)) or nil, C.Info)
		local lock = (d.pvpLock or 0) - now
		setChip("PvpLock", lock > 0 and ("PVP LOCKED  " .. Format.clock(lock)) or nil, C.Bad)
		setChip("Damaged", (d.damaged or 0) > 0 and (("%d BUILDINGS DAMAGED"):format(d.damaged)) or nil, C.Bad)
		setChip("Unsaved", d.persistent == false and "STUDIO · DATA NOT SAVED" or nil, C.Gold)
		local giftLeft = (d.giftAt or 0) - now
		setChip("Gift", giftLeft <= 0 and d.giftAt and "GIFT READY · REWARDS [J]" or nil, C.Premium)
	end)
end

return HUD
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="60">
            <Properties>
              <string name="Name">Minimap</string>
              <string name="Source"><![CDATA[--[[
	Minimap
	Radar scope in the bottom-right corner with a rotating sweep.
	  home:  your island (front edge up): buildings coloured by category,
	         vehicles and you
	  war:   the whole map: the central battlefield, every island and
	         bridge, strategic points (coloured by owner) and vehicles
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Shared = ReplicatedStorage.Shared
local Config = require(Shared.Config)
local Grid = require(Shared.Util.Grid)
local Buildings = require(Shared.Catalog.Buildings)

local Client = script.Parent.Parent
local ClientState = require(Client.ClientState)
local Lib = require(Client.UI.Lib)
local Theme = require(Client.UI.Theme)

local New = Lib.New
local C = Theme.Color

local Minimap = {}

local player = Players.LocalPlayer
local SIZE = 176
local R = SIZE / 2 - 6

local scope: Frame
local dotsHolder: Frame
local sweep: Frame
local label: TextLabel
local pool: { Frame } = {}
local used = 0

local TAB_COLORS = {
	Housing = Color3.fromRGB(236, 222, 190),
	Roads = Color3.fromRGB(110, 116, 112),
	Utilities = Color3.fromRGB(104, 190, 255),
	Industry = Color3.fromRGB(255, 170, 70),
	Services = Color3.fromRGB(150, 230, 140),
	Research = Color3.fromRGB(84, 214, 186),
	Buildings = Color3.fromRGB(210, 220, 120),
	["Air Defense"] = Color3.fromRGB(255, 110, 90),
	Missiles = Color3.fromRGB(255, 90, 70),
	Drones = Color3.fromRGB(255, 140, 110),
}

local function dot(pos: Vector2, size: number, color: Color3, round: boolean?)
	used += 1
	local d = pool[used]
	if not d then
		d = New("Frame", { AnchorPoint = Vector2.new(0.5, 0.5), BorderSizePixel = 0, Parent = dotsHolder })
		New("UICorner", { Name = "Round", CornerRadius = UDim.new(0, 0), Parent = d })
		pool[used] = d
	end
	d.Visible = true
	d.Position = UDim2.fromOffset(SIZE / 2 + pos.X, SIZE / 2 + pos.Y)
	d.Size = UDim2.fromOffset(size, size)
	d.BackgroundColor3 = color
	d.BackgroundTransparency = 0
	d.Rotation = 0
	;(d:FindFirstChild("Round") :: UICorner).CornerRadius = UDim.new(round and 1 or 0, 0)
	return d
end

-- frame: draw in that frame's local axes (local -Z up the screen).
local function project(world: Vector3, center: Vector3, scale: number, frame: CFrame?): Vector2?
	local v
	if frame then
		local l = frame:PointToObjectSpace(world)
		v = Vector2.new(l.X, l.Z) * scale
	else
		v = Vector2.new(world.X - center.X, world.Z - center.Z) * scale
	end
	if v.Magnitude > R - 2 then
		return nil
	end
	return v
end

local function ownerOfPlot(index: number): Player?
	for _, p in Players:GetPlayers() do
		if p:GetAttribute("PlotIndex") == index then
			return p
		end
	end
	return nil
end

local function redraw()
	used = 0
	local mode = ClientState.mode
	local war = mode == "war"
	local center, scale
	local frame: CFrame? = nil
	if war then
		center = Config.MainlandOrigin
		scale = R / (Config.PlotRingRadius + Grid.PlotSize * 0.72)
		label.Text = "THEATER // ALL FRONTS"
		-- battlefield, bridges and islands
		local land = dot(Vector2.zero, Config.MainlandRadius * 2 * scale, Color3.fromRGB(60, 84, 50), true)
		land.BackgroundTransparency = 0.35
		for i = 1, Config.MaxPlots do
			local owner = ownerOfPlot(i)
			local col = owner == player and C.Accent
				or (owner and ((owner:GetAttribute("Pvp") == true) and C.Bad or C.Muted) or C.Faint)
			local v = project(Grid.plotOrigin(i), center, scale)
			if v then
				local isl = dot(v, Grid.PlotSize * scale, col)
				isl.Rotation = -math.deg(Grid.plotAngle(i))
				isl.BackgroundTransparency = owner and 0.25 or 0.7
			end
			local mid = (Grid.shore(i) + Grid.gate(i)) / 2
			local bv = project(mid, center, scale)
			if bv then
				local bridge = dot(bv, 2, C.TextSoft)
				bridge.Size = UDim2.fromOffset(2, math.max(2, (Grid.gate(i) - Grid.shore(i)).Magnitude * scale))
				bridge.Rotation = -math.deg(Grid.plotAngle(i))
			end
		end
		local points = workspace:FindFirstChild("Mainland") and workspace.Mainland:FindFirstChild("Points")
		if points then
			for _, p in points:GetChildren() do
				local base = p:FindFirstChild("Base") :: BasePart?
				if base then
					local v = project(base.CFrame.Position, center, scale)
					if v then
						local owner = (p:GetAttribute("Owner") :: number?) or 0
						local col = owner == 0 and C.Muted or (owner == player.UserId and C.Good or ((p:GetAttribute("Color") :: Color3?) or C.Bad))
						dot(v, 7, col).Rotation = 45
					end
				end
			end
		end
	else
		local idx = ClientState.get("plot")
		if not idx then
			return
		end
		center = Grid.plotOrigin(idx)
		frame = Grid.plotCFrame(idx)
		scale = R / (Grid.PlotSize / 2 * 1.42 + 20)
		label.Text = "SECTOR // HOME"
		local isl = dot(Vector2.zero, Grid.PlotSize * scale, Color3.fromRGB(46, 70, 42))
		isl.BackgroundTransparency = 0.4
		local homeland = workspace:FindFirstChild("Homeland")
		local plot = homeland and homeland:FindFirstChild("Plot_" .. idx)
		local folder = plot and plot:FindFirstChild("Buildings")
		if folder then
			for _, b in folder:GetChildren() do
				if b:IsA("Model") then
					local def = Buildings.get(b:GetAttribute("BuildingId") :: string)
					local base = b.PrimaryPart
					if def and base then
						local v = project(base.CFrame.Position, center, scale, frame)
						if v then
							local col = TAB_COLORS[def.tab] or C.TextSoft
							if b:GetAttribute("Damaged") then
								col = C.Bad
							elseif b:GetAttribute("FinishAt") then
								col = col:Lerp(C.Panel, 0.5)
							end
							local len = b:GetAttribute("Len") :: number?
							local w = math.max(def.size[1] * Grid.CellSize * scale, 1.5)
							local d = math.max((len or def.size[2] * Grid.CellSize) * scale, 1.5)
							local f = dot(v, w, col)
							f.Size = UDim2.fromOffset(w, d)
							f.Rotation = -((b:GetAttribute("Angle") :: number?) or 0)
						end
					end
				end
			end
		end
	end
	local units = workspace:FindFirstChild("Units")
	if units then
		for _, u in units:GetChildren() do
			local root = u:IsA("Model") and u.PrimaryPart
			if root then
				local v = project(root.CFrame.Position, center, scale, frame)
				if v then
					local mine = u:GetAttribute("OwnerId") == player.UserId
					dot(v, 5, mine and C.Teal or C.Bad, true)
				end
			end
		end
	end
	local char = player.Character
	local hrp = char and char:FindFirstChild("HumanoidRootPart") :: BasePart?
	if hrp and not war then
		local v = project(hrp.CFrame.Position, center, scale, frame)
		if v then
			local d = dot(v, 8, C.Accent)
			local look = frame and frame:VectorToObjectSpace(hrp.CFrame.LookVector) or hrp.CFrame.LookVector
			d.Rotation = math.deg(math.atan2(look.X, -look.Z)) + 45
		end
	end
	for i = used + 1, #pool do
		pool[i].Visible = false
	end
end

function Minimap.init(gui: GuiObject)
	local holder = New("Frame", {
		Name = "Minimap",
		AnchorPoint = Vector2.new(1, 1),
		Position = UDim2.new(1, -16, 1, -16),
		Size = UDim2.fromOffset(SIZE, SIZE + 22),
		BackgroundTransparency = 1,
		Parent = gui,
	})
	scope = New("Frame", {
		Name = "Scope",
		BackgroundColor3 = Color3.fromRGB(10, 20, 16),
		BackgroundTransparency = 0.08,
		Size = UDim2.fromOffset(SIZE, SIZE),
		Parent = holder,
	}, { Lib.round(), Lib.stroke(C.Teal, 1.5, 0.35) })
	-- range rings + crosshair
	for _, f in { 0.33, 0.66 } do
		New("Frame", {
			BackgroundTransparency = 1,
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.fromScale(0.5, 0.5),
			Size = UDim2.fromOffset(SIZE * f, SIZE * f),
			Parent = scope,
		}, { Lib.round(), Lib.stroke(C.Teal, 1, 0.8) })
	end
	New("Frame", { BackgroundColor3 = C.Teal, BackgroundTransparency = 0.82, BorderSizePixel = 0, AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5), Size = UDim2.new(1, -12, 0, 1), Parent = scope })
	New("Frame", { BackgroundColor3 = C.Teal, BackgroundTransparency = 0.82, BorderSizePixel = 0, AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5), Size = UDim2.new(0, 1, 1, -12), Parent = scope })
	-- sweep: a full-diameter bar, only one half is visible (gradient)
	sweep = New("Frame", {
		Name = "Sweep",
		BackgroundColor3 = C.Teal,
		BorderSizePixel = 0,
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.fromOffset(2, SIZE - 12),
		Parent = scope,
	}, {
		New("UIGradient", {
			Rotation = 90,
			Transparency = NumberSequence.new({
				NumberSequenceKeypoint.new(0, 0.1),
				NumberSequenceKeypoint.new(0.5, 0.6),
				NumberSequenceKeypoint.new(0.501, 1),
				NumberSequenceKeypoint.new(1, 1),
			}),
		}),
	})
	dotsHolder = New("Frame", { BackgroundTransparency = 1, Size = UDim2.fromScale(1, 1), Parent = scope })
	label = Lib.display({
		Text = "SECTOR // HOME",
		TextSize = 11,
		TextColor3 = C.Teal,
		TextXAlignment = Enum.TextXAlignment.Center,
		Position = UDim2.new(0, 0, 1, -18),
		Size = UDim2.new(1, 0, 0, 16),
		Parent = holder,
	})
	Lib.brackets(scope, C.Teal, 10, 2, 4)

	local acc = 0
	RunService.Heartbeat:Connect(function(dt)
		sweep.Rotation = (sweep.Rotation + dt * 90) % 360
		acc += dt
		if acc >= 0.5 then
			acc = 0
			local ok, err = pcall(redraw)
			if not ok then
				warn("[Minimap] " .. tostring(err))
			end
		end
	end)
	ClientState.onMode(function(mode)
		holder.Visible = mode ~= "build"
		task.defer(redraw)
	end)
end

return Minimap
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="61">
            <Properties>
              <string name="Name">Modal</string>
              <string name="Source"><![CDATA[--[[
	Modal
	Window system. One window at a time:
	  Modal.open(...)      centered window, world blurred behind it
	  Modal.openSide(...)  inspector docked on the right, world stays visible
	Both share the Field Command chrome: stencil title, amber accent bar,
	hazard strip, corner brackets and an X button.
]]

local Lighting = game:GetService("Lighting")
local UserInputService = game:GetService("UserInputService")

local UI = script.Parent.Parent.UI
local Lib = require(UI.Lib)
local Theme = require(UI.Theme)
local Icons = require(UI.Icons)

local New = Lib.New
local C = Theme.Color

local Modal = {}

export type Window = {
	root: Frame,
	header: Frame,
	iconHolder: Frame,
	title: TextLabel,
	subtitle: TextLabel,
	body: Frame,
	close: () -> (),
	onClose: ((() -> ()) -> ()),
	kind: string,
}

local layer: GuiObject
local dim: TextButton
local blur: BlurEffect? = nil
local current: Window? = nil
local closeCallbacks: { () -> () } = {}

function Modal.isOpen(): boolean
	return current ~= nil
end

function Modal.current(): Window?
	return current
end

local function setBlur(on: boolean)
	if not blur then
		local ok, b = pcall(function()
			local e = Instance.new("BlurEffect")
			e.Name = "FF_ModalBlur"
			e.Size = 0
			e.Parent = Lighting
			return e
		end)
		blur = ok and b or nil
	end
	if blur then
		Lib.tween(blur, 0.18, { Size = on and 12 or 0 })
	end
end

function Modal.close()
	if not current then
		return
	end
	local w = current
	current = nil
	local cbs = closeCallbacks
	closeCallbacks = {}
	for _, cb in cbs do
		task.spawn(cb)
	end
	if w.kind == "side" then
		Lib.tween(w.root, 0.14, { Position = UDim2.new(1, 40, 0, w.root.Position.Y.Offset) })
	else
		Lib.tween(w.root, 0.12, { Position = UDim2.new(0.5, 0, 0.5, 16) })
	end
	task.delay(0.13, function()
		w.root:Destroy()
	end)
	dim.Visible = false
	setBlur(false)
end

local function chrome(root: Frame, title: string, subtitle: string?, kind: string): Window
	local header = New("Frame", {
		Name = "Header",
		BackgroundTransparency = 1,
		Size = UDim2.new(1, 0, 0, 66),
		Parent = root,
	})
	-- amber accent bar + hazard strip
	New("Frame", { BackgroundColor3 = C.Accent, BorderSizePixel = 0, Position = UDim2.fromOffset(0, 14), Size = UDim2.fromOffset(4, 38), Parent = header })
	Lib.hazard({ Position = UDim2.new(0, 0, 1, -4), Size = UDim2.new(0, 120, 0, 4), BackgroundTransparency = 0.2, Parent = header }, C.Accent, C.Panel, 9)
	Lib.divider({ Position = UDim2.new(0, 120, 1, -2), Size = UDim2.new(1, -120, 0, 1), Parent = header })
	local iconHolder = New("Frame", {
		Name = "IconHolder",
		BackgroundColor3 = C.Inset,
		Position = UDim2.fromOffset(16, 9),
		Size = UDim2.fromOffset(52, 48),
		Parent = header,
	}, { Lib.corner(4) })
	local titleLabel = Lib.display({
		Text = string.upper(title),
		TextSize = 22,
		Position = UDim2.fromOffset(80, 10),
		Size = UDim2.new(1, -140, 0, 26),
		Parent = header,
	})
	local subtitleLabel = Lib.text({
		Text = subtitle or "",
		TextSize = Theme.TextSize.Small,
		TextColor3 = C.Muted,
		Position = UDim2.fromOffset(80, 36),
		Size = UDim2.new(1, -140, 0, 18),
		Parent = header,
	})
	local closeBtn = Lib.button({
		Name = "Close",
		AnchorPoint = Vector2.new(1, 0.5),
		Position = UDim2.new(1, -14, 0.5, 0),
		Size = UDim2.fromOffset(36, 36),
		BackgroundColor3 = C.Raised,
		Parent = header,
		Activated = function()
			Modal.close()
		end,
	}, { Lib.corner(4), Lib.stroke(C.Line, 1, 0.4) })
	local x = Icons.close(13, C.Text)
	x.AnchorPoint = Vector2.new(0.5, 0.5)
	x.Position = UDim2.fromScale(0.5, 0.5)
	x.Parent = closeBtn

	local body = New("Frame", {
		Name = "Body",
		BackgroundTransparency = 1,
		Position = UDim2.fromOffset(0, 68),
		Size = UDim2.new(1, 0, 1, -68),
		Parent = root,
	}, { Lib.pad(14, 16, 16, 16) })

	local win: Window
	win = {
		root = root,
		header = header,
		iconHolder = iconHolder,
		title = titleLabel,
		subtitle = subtitleLabel,
		body = body,
		kind = kind,
		close = function()
			if current == win then
				Modal.close()
			end
		end,
		onClose = function(cb)
			table.insert(closeCallbacks, cb)
		end,
	}
	return win
end

-- Centered window (width/height in design pixels).
function Modal.open(title: string, subtitle: string?, width: number?, height: number?): Window
	Modal.close()
	dim.Visible = true
	setBlur(true)
	local w, h = width or 640, height or 540
	local root = Lib.panel({
		Name = "Window",
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.new(0.5, 0, 0.5, 18),
		Size = UDim2.fromOffset(w, h),
		BackgroundTransparency = 0.02,
		ZIndex = 10,
		Parent = layer,
	})
	Lib.brackets(root, C.Accent, 14, 2, 4)
	Lib.tween(root, 0.18, { Position = UDim2.fromScale(0.5, 0.5) }, Enum.EasingStyle.Back)
	local win = chrome(root, title, subtitle, "center")
	current = win
	return win
end

-- Inspector docked on the right (no blur, world stays interactive).
function Modal.openSide(title: string, subtitle: string?, width: number?): Window
	Modal.close()
	local w = width or 440
	local top = 124
	local root = Lib.panel({
		Name = "Inspector",
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.new(1, w, 0, top),
		Size = UDim2.new(0, w, 1, -top - 112),
		BackgroundTransparency = 0.04,
		ZIndex = 10,
		Parent = layer,
	})
	Lib.brackets(root, C.Accent, 12, 2, 3)
	Lib.tween(root, 0.2, { Position = UDim2.new(1, -16, 0, top) }, Enum.EasingStyle.Quint)
	local win = chrome(root, title, subtitle, "side")
	current = win
	return win
end

function Modal.lift(root: Instance, z: number?)
	local zi = z or 11
	if root:IsA("GuiObject") then
		root.ZIndex = math.max(root.ZIndex, zi)
	end
	for _, d in root:GetDescendants() do
		if d:IsA("GuiObject") then
			d.ZIndex = math.max(d.ZIndex, zi)
		end
	end
end

function Modal.init(gui: GuiObject)
	layer = gui
	dim = New("TextButton", {
		Name = "Dim",
		AutoButtonColor = false,
		Text = "",
		BackgroundColor3 = Color3.new(0, 0, 0),
		BackgroundTransparency = 0.45,
		Size = UDim2.fromScale(1, 1),
		Visible = false,
		ZIndex = 9,
		Parent = gui,
		Activated = function()
			Modal.close()
		end,
	})
	UserInputService.InputBegan:Connect(function(input, processed)
		if not processed and input.KeyCode == Enum.KeyCode.Escape then
			Modal.close()
		end
	end)
end

return Modal
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="62">
            <Properties>
              <string name="Name">NationUI</string>
              <string name="Source"><![CDATA[--[[
	NationUI
	"Found your nation": name + flag designer with a live preview on a
	flagpole. Opens automatically for brand-new commanders and from the flag
	in the HUD badge. Also shows the RANK UP banner when the server promotes
	the nation.
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage.Shared
local Config = require(Shared.Config)
local Flag = require(Shared.Util.Flag)
local Format = require(Shared.Util.Format)
local Net = require(Shared.Net)

local Client = script.Parent.Parent
local ClientState = require(Client.ClientState)
local Hub = require(Client.Hub)
local Lib = require(Client.UI.Lib)
local Theme = require(Client.UI.Theme)
local Modal = require(script.Parent.Modal)
local Notifications = require(script.Parent.Notifications)
local Sounds = require(script.Parent.Sounds)

local New = Lib.New
local C = Theme.Color

local NationUI = {}

local player = Players.LocalPlayer
local bannerLayer: GuiObject
local prompted = false

local ADJECTIVES = { "Iron", "Free", "Northern", "Southern", "Azure", "Crimson", "Golden", "Grand", "Silver", "United", "Eastern", "Western", "High", "New", "Royal", "Emerald" }
local NOUNS = { "Republic", "Union", "Federation", "Dominion", "Commonwealth", "Coalition", "Empire", "Alliance", "Territory", "Protectorate", "League", "Realm" }

function NationUI.randomName(rng: Random?): string
	local r = rng or Random.new()
	for _ = 1, 10 do
		local name = ADJECTIVES[r:NextInteger(1, #ADJECTIVES)] .. " " .. NOUNS[r:NextInteger(1, #NOUNS)]
		if #name <= Config.NationNameMax then
			return name
		end
	end
	return "Free Republic"
end

local function randomFlag(r: Random): Flag.Data
	local a = r:NextInteger(1, #Flag.Colors)
	local b = r:NextInteger(1, #Flag.Colors - 1)
	if b >= a then
		b += 1
	end
	local c = r:NextInteger(1, #Flag.Colors)
	return { p = r:NextInteger(1, #Flag.Patterns), c = { a, b, c }, e = r:NextInteger(0, #Flag.Emblems - 1) }
end

function NationUI.open()
	local current = ClientState.get("nation")
	local founded = type(current) == "table" and current.name ~= nil
	local rng = Random.new()
	local data: Flag.Data = founded and Flag.decode(current.flag) or randomFlag(rng)
	data = { p = data.p, c = { data.c[1], data.c[2], data.c[3] }, e = data.e }
	local band = 1

	local win = Modal.open(
		founded and "Nation Identity" or "Found Your Nation",
		"Name it and raise a flag. Rivals see both on the war map and your border sign.",
		900,
		580
	)

	-- left: preview on a pole
	local stage = Lib.inset({ Name = "Preview", Size = UDim2.new(0, 330, 1, 0), Parent = win.body })
	New("UIGradient", { Color = ColorSequence.new(Color3.fromRGB(40, 58, 66), C.Ink), Rotation = 90, Parent = stage })
	New("Frame", { BackgroundColor3 = Color3.fromRGB(200, 204, 206), BorderSizePixel = 0, Position = UDim2.fromOffset(46, 40), Size = UDim2.fromOffset(5, 300), Parent = stage })
	New("Frame", { BackgroundColor3 = C.Accent, AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromOffset(48, 38), Size = UDim2.fromOffset(12, 12), Parent = stage }, { Lib.round() })
	local flagFrame = New("Frame", { Name = "Flag", BackgroundTransparency = 1, Position = UDim2.fromOffset(51, 48), Size = UDim2.fromOffset(240, 160), Parent = stage }, { Lib.stroke(Color3.new(0, 0, 0), 1, 0.6) })
	local nameLabel = Lib.display({
		Name = "NamePreview",
		Text = "",
		TextSize = 24,
		TextWrapped = true,
		Position = UDim2.fromOffset(20, 360),
		Size = UDim2.new(1, -40, 0, 56),
		TextYAlignment = Enum.TextYAlignment.Top,
		Parent = stage,
	})
	Lib.caption("Est. by commander " .. player.DisplayName, { TextColor3 = C.Accent, Position = UDim2.fromOffset(20, 420), Size = UDim2.new(1, -40, 0, 14), Parent = stage })

	-- right: controls
	local panel = New("Frame", { BackgroundTransparency = 1, Position = UDim2.fromOffset(350, 0), Size = UDim2.new(1, -350, 1, 0), Parent = win.body })
	Lib.caption("Nation name", { Parent = panel })
	local box = Lib.textbox({
		Name = "NameBox",
		Text = founded and current.name or NationUI.randomName(rng),
		PlaceholderText = "e.g. Iron Republic",
		Position = UDim2.fromOffset(0, 18),
		Size = UDim2.new(1, -120, 0, 40),
		Parent = panel,
	})
	Lib.button({
		Name = "Randomize",
		Variant = "secondary",
		Text = "RANDOM",
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.new(1, 0, 0, 18),
		Size = UDim2.fromOffset(110, 40),
		Parent = panel,
		Activated = function()
			box.Text = NationUI.randomName(rng)
		end,
	})

	local patternRow, colorRow, emblemRow, bandTabs
	local errorLabel: TextLabel

	local function redraw()
		Lib.clear(flagFrame)
		Flag.draw(flagFrame, data)
		nameLabel.Text = string.upper(box.Text ~= "" and box.Text or "Unnamed nation")
		for i, btn in patternRow:GetChildren() do
			if btn:IsA("GuiButton") then
				local idx = btn:GetAttribute("Index") :: number
				local holder = btn:FindFirstChild("Mini") :: Frame
				Lib.clear(holder)
				Flag.draw(holder, { p = idx, c = data.c, e = 0 })
				local st = btn:FindFirstChildOfClass("UIStroke") :: UIStroke
				st.Color = idx == data.p and C.Accent or C.Line
				st.Thickness = idx == data.p and 2 or 1
			end
			local _ = i
		end
		for _, btn in colorRow:GetChildren() do
			if btn:IsA("GuiButton") then
				local st = btn:FindFirstChildOfClass("UIStroke") :: UIStroke
				local sel = btn:GetAttribute("Index") == data.c[band]
				st.Color = sel and C.Accent or C.Line
				st.Thickness = sel and 3 or 1
			end
		end
		for _, btn in emblemRow:GetChildren() do
			if btn:IsA("GuiButton") then
				local st = btn:FindFirstChildOfClass("UIStroke") :: UIStroke
				local sel = btn:GetAttribute("Index") == data.e
				st.Color = sel and C.Accent or C.Line
				st.Thickness = sel and 2 or 1
			end
		end
		for _, btn in bandTabs:GetChildren() do
			if btn:IsA("GuiButton") then
				Lib.setButtonColor(btn, btn:GetAttribute("Index") == band and C.AccentSoft or C.Raised)
			end
		end
	end

	Lib.caption("Pattern", { Position = UDim2.fromOffset(0, 74), Parent = panel })
	patternRow = New("Frame", { Name = "Patterns", BackgroundTransparency = 1, Position = UDim2.fromOffset(0, 92), Size = UDim2.new(1, 0, 0, 52), Parent = panel }, { Lib.list("x", 8) })
	for i, name in Flag.Patterns do
		local btn = Lib.button({
			Name = name,
			BackgroundColor3 = C.Raised,
			Size = UDim2.fromOffset(72, 52),
			LayoutOrder = i,
			Parent = patternRow,
			Activated = function()
				data.p = i
				Sounds.play("Click", 1.2)
				redraw()
			end,
		}, { Lib.corner(3), Lib.stroke(C.Line, 1, 0) })
		btn:SetAttribute("Index", i)
		New("Frame", { Name = "Mini", BackgroundTransparency = 1, Position = UDim2.fromOffset(6, 6), Size = UDim2.new(1, -12, 1, -12), Parent = btn })
	end

	Lib.caption("Colours", { Position = UDim2.fromOffset(0, 160), Parent = panel })
	bandTabs = New("Frame", { Name = "Bands", BackgroundTransparency = 1, Position = UDim2.fromOffset(0, 178), Size = UDim2.new(1, 0, 0, 30), Parent = panel }, { Lib.list("x", 6) })
	for i, label in { "PRIMARY", "SECOND", "ACCENT" } do
		local tab = Lib.button({
			Name = "Band" .. i,
			Text = label,
			FontFace = Theme.Font.Display,
			TextSize = 12,
			BackgroundColor3 = C.Raised,
			Size = UDim2.fromOffset(110, 30),
			LayoutOrder = i,
			Parent = bandTabs,
			Activated = function()
				band = i
				redraw()
			end,
		}, { Lib.corner(3), Lib.stroke(C.Line, 1, 0.3) })
		tab:SetAttribute("Index", i)
	end
	colorRow = New("Frame", { Name = "Colors", BackgroundTransparency = 1, Position = UDim2.fromOffset(0, 216), Size = UDim2.new(1, 0, 0, 40), Parent = panel }, { Lib.list("x", 6) })
	for i, col in Flag.Colors do
		local sw = Lib.button({
			Name = "Color" .. i,
			BackgroundColor3 = col,
			Size = UDim2.fromOffset(34, 34),
			LayoutOrder = i,
			Parent = colorRow,
			Activated = function()
				data.c[band] = i
				redraw()
			end,
		}, { Lib.corner(3), Lib.stroke(C.Line, 1, 0) })
		sw:SetAttribute("Index", i)
	end

	Lib.caption("Emblem", { Position = UDim2.fromOffset(0, 272), Parent = panel })
	emblemRow = New("Frame", { Name = "Emblems", BackgroundTransparency = 1, Position = UDim2.fromOffset(0, 290), Size = UDim2.new(1, 0, 0, 40), Parent = panel }, { Lib.list("x", 8) })
	for i, name in Flag.Emblems do
		local btn = Lib.button({
			Name = name,
			Text = string.upper(name),
			FontFace = Theme.Font.Display,
			TextSize = 12,
			BackgroundColor3 = C.Raised,
			Size = UDim2.fromOffset(84, 36),
			LayoutOrder = i,
			Parent = emblemRow,
			Activated = function()
				data.e = i - 1
				redraw()
			end,
		}, { Lib.corner(3), Lib.stroke(C.Line, 1, 0) })
		btn:SetAttribute("Index", i - 1)
	end

	errorLabel = Lib.text({
		Name = "Error",
		Text = "",
		TextColor3 = C.Bad,
		TextSize = 13,
		FontFace = Theme.Font.BodyBold,
		AnchorPoint = Vector2.new(0, 1),
		Position = UDim2.new(0, 0, 1, -62),
		Size = UDim2.new(1, 0, 0, 18),
		Parent = panel,
	})
	Lib.hazard({ AnchorPoint = Vector2.new(0, 1), Position = UDim2.new(0, 0, 1, -54), Size = UDim2.new(1, 0, 0, 4), BackgroundTransparency = 0.3, Parent = panel }, C.Accent, C.Panel, 9)
	local busy = false
	Lib.button({
		Name = "Found",
		Variant = "primary",
		Text = founded and "UPDATE NATION" or "FOUND NATION",
		TextSize = 16,
		AnchorPoint = Vector2.new(1, 1),
		Position = UDim2.fromScale(1, 1),
		Size = UDim2.fromOffset(220, 46),
		Parent = panel,
		Activated = function()
			if busy then
				return
			end
			busy = true
			errorLabel.Text = ""
			local res = Net.request("SetNation", box.Text, Flag.encode(data))
			busy = false
			if res.ok then
				Sounds.play("Success")
				Modal.close()
				if not founded then
					Notifications.show(("The nation of %s is born. Long may it stand."):format(res.name or box.Text), "good")
				end
			else
				errorLabel.Text = res.err or "Something went wrong"
				Sounds.play("Error")
			end
		end,
	})
	if not founded then
		Lib.text({
			Text = "You can change this any time from the flag in the top-left.",
			TextSize = 12,
			TextColor3 = C.Muted,
			AnchorPoint = Vector2.new(0, 1),
			Position = UDim2.new(0, 0, 1, -14),
			Size = UDim2.new(1, -230, 0, 18),
			Parent = panel,
		})
	end

	box:GetPropertyChangedSignal("Text"):Connect(function()
		if #box.Text > Config.NationNameMax then
			box.Text = string.sub(box.Text, 1, Config.NationNameMax)
		end
		nameLabel.Text = string.upper(box.Text ~= "" and box.Text or "Unnamed nation")
	end)
	redraw()
end

---------------------------------------------------------------------------
-- Rank-up banner
---------------------------------------------------------------------------
function NationUI.showRankUp(level: number)
	local r = Config.Ranks[level]
	if not r or not bannerLayer then
		return
	end
	Sounds.play("Success")
	local banner = Lib.panel({
		Name = "RankUp",
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0, -140),
		Size = UDim2.fromOffset(520, 118),
		BackgroundTransparency = 0.02,
		Parent = bannerLayer,
	}, { Lib.pad(14, 20) })
	Lib.brackets(banner, C.Accent, 14, 2, 4)
	Lib.hazard({ Position = UDim2.new(0, -20, 0, -14), Size = UDim2.new(1, 40, 0, 6), Parent = banner }, C.Accent, C.Panel, 9)
	Lib.caption(("Rank up · tier %d of %d"):format(level, #Config.Ranks), { TextColor3 = C.Accent, Position = UDim2.fromOffset(0, 4), Parent = banner })
	Lib.display({ Text = string.upper(r.name), TextSize = 38, Position = UDim2.fromOffset(0, 20), Size = UDim2.new(1, 0, 0, 44), Parent = banner })
	local nxt = Config.Ranks[level + 1]
	Lib.text({
		Text = ("Treasury +%s%s"):format(Format.cash(r.reward), nxt and ("  ·  next: %s at %s power"):format(nxt.name, Format.short(nxt.power)) or "  ·  the top of the world"),
		TextSize = 13,
		TextColor3 = C.TextSoft,
		Position = UDim2.fromOffset(0, 68),
		Size = UDim2.new(1, 0, 0, 18),
		Parent = banner,
	})
	Lib.tween(banner, 0.45, { Position = UDim2.new(0.5, 0, 0, 120) }, Enum.EasingStyle.Back)
	task.delay(5, function()
		Lib.tween(banner, 0.35, { Position = UDim2.new(0.5, 0, 0, -140) }, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
		task.wait(0.4)
		banner:Destroy()
	end)
end

function NationUI.init(layer: GuiObject)
	bannerLayer = layer
	Hub.openNation = NationUI.open
	Hub.showRankUp = NationUI.showRankUp
	-- brand-new commanders found their nation first
	ClientState.on("nation", function(nation)
		if nation == false and not prompted then
			prompted = true
			task.delay(1.5, function()
				if ClientState.get("nation") == false and not Modal.isOpen() then
					NationUI.open()
				end
			end)
		end
	end)
end

return NationUI
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="63">
            <Properties>
              <string name="Name">NightLights</string>
              <string name="Source"><![CDATA[--[[
	NightLights
	When the server clock passes dusk, city windows light up (most of them;
	a few stay dark so blocks don't look like solid neon), Blender-kit light
	meshes switch on their glow twin, and the scene gets a cool night grade.
	Everything flips back at dawn.
]]

local Lighting = game:GetService("Lighting")
local TweenService = game:GetService("TweenService")

local NightLights = {}

local WARM = Color3.fromRGB(255, 214, 140)
local COOL = Color3.fromRGB(200, 236, 255)

local night = false
local grade: ColorCorrectionEffect? = nil

function NightLights.isNight(clock: number): boolean
	return clock >= 18.4 or clock < 5.6
end

-- Stable per-window choice: ~70% lit, a few cool office tones.
local function windowLook(p: BasePart): (boolean, Color3)
	local pos = p.CFrame.Position
	local h = (math.floor(pos.X * 7.31) + math.floor(pos.Y * 3.17) * 17 + math.floor(pos.Z * 5.13) * 31) % 100
	return h < 70, h % 9 == 0 and COOL or WARM
end

function NightLights.apply(p: Instance, on: boolean)
	if not p:IsA("BasePart") then
		return
	end
	if p:GetAttribute("NightGlow") then
		p.Transparency = on and 0 or 1
	elseif p:GetAttribute("Window") then
		if on then
			local litNow, col = windowLook(p)
			if litNow then
				if p:GetAttribute("DayColor") == nil then
					p:SetAttribute("DayColor", p.Color)
					p:SetAttribute("DayMaterial", p.Material.Name)
				end
				p.Material = Enum.Material.Neon
				p.Color = col
			end
		else
			local col = p:GetAttribute("DayColor") :: Color3?
			if col then
				p.Color = col
				local mat = p:GetAttribute("DayMaterial") :: string?
				p.Material = (mat and (Enum.Material :: any)[mat]) or Enum.Material.SmoothPlastic
			end
		end
	end
end

local function roots(): { Instance }
	local out = {}
	for _, name in { "Homeland", "Mainland" } do
		local f = workspace:FindFirstChild(name)
		if f then
			table.insert(out, f)
		end
	end
	return out
end

function NightLights.set(on: boolean)
	if on == night then
		return
	end
	night = on
	for _, root in roots() do
		for _, d in root:GetDescendants() do
			NightLights.apply(d, on)
		end
	end
	if grade then
		local goal = on and { TintColor = Color3.fromRGB(196, 212, 255), Brightness = 0.03, Contrast = 0.1, Saturation = -0.12 }
			or { TintColor = Color3.new(1, 1, 1), Brightness = 0, Contrast = 0, Saturation = 0 }
		TweenService:Create(grade, TweenInfo.new(4), goal):Play()
	end
end

local function watch(root: Instance)
	root.DescendantAdded:Connect(function(d)
		if night then
			task.defer(NightLights.apply, d, true)
		end
	end)
end

function NightLights.init()
	local ok = pcall(function()
		local g = Instance.new("ColorCorrectionEffect")
		g.Name = "NightGrade"
		g.Parent = Lighting
		grade = g
	end)
	if not ok then
		grade = nil
	end
	task.spawn(function()
		for _, name in { "Homeland", "Mainland" } do
			task.spawn(function()
				watch(workspace:WaitForChild(name))
			end)
		end
	end)
	local function check()
		NightLights.set(NightLights.isNight(Lighting.ClockTime))
	end
	pcall(function()
		Lighting:GetPropertyChangedSignal("ClockTime"):Connect(check)
	end)
	check()
end

return NightLights
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="64">
            <Properties>
              <string name="Name">Notifications</string>
              <string name="Source"><![CDATA[--[[
	Notifications
	"Comms feed": tagged messages slide in on the right (PAY, ALERT, INTEL,
	WAR, OK) and fade out. Also the floating "+$12.4k" pay-day pop.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Net = require(ReplicatedStorage.Shared.Net)
local UI = script.Parent.Parent.UI
local Lib = require(UI.Lib)
local Theme = require(UI.Theme)
local Sounds = require(script.Parent.Sounds)

local New = Lib.New
local C = Theme.Color

local Notifications = {}

local holder: Frame
local root: GuiObject

local KINDS = {
	info = { tag = "INTEL", color = C.Info },
	good = { tag = "OK", color = C.Good },
	bad = { tag = "ALERT", color = C.Bad },
	pay = { tag = "PAY", color = C.Gold },
	war = { tag = "WAR", color = C.Military },
}

local order = 0

function Notifications.show(text: string, kind: string?)
	local k = KINDS[kind or "info"] or KINDS.info
	order += 1
	local wrap = New("Frame", {
		BackgroundTransparency = 1,
		Size = UDim2.new(1, 0, 0, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		LayoutOrder = -order,
		Parent = holder,
	})
	local toast = New("Frame", {
		BackgroundColor3 = C.Panel,
		BackgroundTransparency = 0.05,
		Position = UDim2.fromOffset(60, 0),
		Size = UDim2.new(1, 0, 0, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		Parent = wrap,
	}, {
		Lib.corner(4),
		Lib.stroke(C.Line, 1, 0.4),
		Lib.pad(8, 12, 9, 16),
		New("Frame", { Name = "Bar", BackgroundColor3 = k.color, BorderSizePixel = 0, Position = UDim2.new(0, -16, 0, -8), Size = UDim2.new(0, 4, 1, 17) }),
		Lib.display({ Name = "Tag", Text = k.tag, TextSize = 11, TextColor3 = k.color, Size = UDim2.new(1, 0, 0, 13) }),
		Lib.text({
			Name = "Msg",
			Text = text,
			TextSize = 14,
			FontFace = Theme.Font.BodyBold,
			TextWrapped = true,
			TextTruncate = Enum.TextTruncate.None,
			TextYAlignment = Enum.TextYAlignment.Top,
			Position = UDim2.fromOffset(0, 15),
			Size = UDim2.new(1, 0, 0, 0),
			AutomaticSize = Enum.AutomaticSize.Y,
		}),
	})
	Lib.tween(toast, 0.22, { Position = UDim2.fromOffset(0, 0) }, Enum.EasingStyle.Quint)
	if kind == "bad" then
		Sounds.play("Error")
	elseif kind == "good" then
		Sounds.play("Click", 1.2)
	end
	-- cap the stack
	local items = {}
	for _, c in holder:GetChildren() do
		if c:IsA("Frame") then
			table.insert(items, c)
		end
	end
	table.sort(items, function(a, b)
		return a.LayoutOrder < b.LayoutOrder
	end)
	for i = 6, #items do
		items[i]:Destroy()
	end
	task.delay(kind == "war" and 6.5 or 4.5, function()
		if toast.Parent then
			Lib.tween(toast, 0.3, { Position = UDim2.fromOffset(80, 0), BackgroundTransparency = 1 })
			for _, d in toast:GetDescendants() do
				if d:IsA("TextLabel") then
					Lib.tween(d, 0.3, { TextTransparency = 1 })
				elseif d:IsA("Frame") then
					Lib.tween(d, 0.3, { BackgroundTransparency = 1 })
				elseif d:IsA("UIStroke") then
					Lib.tween(d, 0.3, { Transparency = 1 })
				end
			end
			task.wait(0.31)
			wrap:Destroy()
		end
	end)
end

-- Floating text that rises from a screen position (pay day).
function Notifications.float(text: string, at: UDim2, color: Color3?)
	local label = Lib.display({
		Text = text,
		TextSize = 24,
		TextColor3 = color or C.Good,
		TextStrokeTransparency = 0.5,
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = at,
		Size = UDim2.fromOffset(220, 30),
		TextXAlignment = Enum.TextXAlignment.Center,
		Parent = root,
	})
	Lib.tween(label, 1.5, { Position = at + UDim2.fromOffset(0, 46), TextTransparency = 1, TextStrokeTransparency = 1 })
	task.delay(1.6, function()
		label:Destroy()
	end)
end

function Notifications.init(gui: GuiObject)
	root = gui
	holder = New("Frame", {
		Name = "Comms",
		BackgroundTransparency = 1,
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.new(1, -16, 0, 196),
		Size = UDim2.fromOffset(330, 420),
		Parent = gui,
	}, { Lib.list("y", 6) })
	Net.event("Notify").OnClientEvent:Connect(function(text, kind)
		if kind == "pay" then
			Sounds.play("Pay", 1.4)
		end
		Notifications.show(text, kind)
	end)
end

return Notifications
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="65">
            <Properties>
              <string name="Name">Placement</string>
              <string name="Source"><![CDATA[--[[
	Placement
	Free-form building. Anything goes anywhere on your island, at any angle:

	  place  - LMB places (stays selected for fast building)
	  rotate - R turns 15 deg (Shift+R back), 90 deg in GRID mode
	  snap   - G toggles FREE / GRID (4-stud grid, quarter turns)
	  align  - in FREE mode, buildings near a road turn to face it and sit
	           flush with the kerb (hold Alt to place freely)
	  roads  - click-click (or drag) to draw a road of any length/direction;
	           it keeps going from the last point until you click the same
	           spot twice, right-click or press Q. Ends snap to other roads.
	  drag   - hold and drag to lay a row of the selected building
	  delete - click a building to demolish it (hotkey 2)
	  undo   - hotkey 3
	  move   - click a building, then click its new spot (hotkey 5)
	When nothing is selected, clicking one of your buildings opens its panel.
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")

local Shared = ReplicatedStorage.Shared
local Config = require(Shared.Config)
local Buildings = require(Shared.Catalog.Buildings)
local Grid = require(Shared.Util.Grid)
local Footprint = require(Shared.Util.Footprint)
local ModelBuilder = require(Shared.ModelBuilder)
local Net = require(Shared.Net)

local Client = script.Parent.Parent
local ClientState = require(Client.ClientState)
local Hub = require(Client.Hub)
local Notifications = require(script.Parent.Notifications)
local Sounds = require(script.Parent.Sounds)

local Placement = {}

local player = Players.LocalPlayer
local camera = workspace.CurrentCamera

local VALID = Color3.fromRGB(80, 220, 120)
local INVALID = Color3.fromRGB(235, 70, 60)
local MOVE = Color3.fromRGB(80, 160, 255)
local ROAD = Color3.fromRGB(255, 180, 54)

local HALF = Grid.PlotSize / 2 - 0.5
local ROAD_SNAP = 7 -- studs: endpoints join existing road ends / centrelines

type Other = { uid: number, rect: Footprint.Rect, ground: boolean, road: boolean }

local selected: any = nil
local tool: string? = nil -- nil | "delete" | "move"
local angle = 0 -- degrees, island-local
local snapMode = "free" -- "free" | "grid"
local dragMode = false
local pointer = Vector2.new(0, 0)

local ghost: Model? = nil
local plate: Part? = nil
local highlight: Highlight? = nil
local hoverHighlight: Highlight
local moving: Model? = nil -- building being moved
local movingLen: number? = nil
local spot: { x: number, z: number, a: number, valid: boolean }? = nil
local dragStart: Vector2? = nil -- local studs (row drag)
local dragTiles: { Part } = {}
local roadAnchor: Vector2? = nil -- start of the road being drawn
local roadPress: Vector2? = nil
local roadPressAnchored = false
local roadPreview: Part? = nil
local roadInfo: { len: number, cost: number, valid: boolean }? = nil
local listeners: { () -> () } = {}

-- client-side copy of the island's footprints (rebuilt from building models)
local others: { [number]: Other } = {}
local hash: Footprint.Hash = {}

local function notifyChanged()
	for _, fn in listeners do
		task.spawn(fn)
	end
end

function Placement.onChanged(fn: () -> ())
	table.insert(listeners, fn)
end

function Placement.state()
	return {
		def = selected,
		tool = tool,
		rotation = angle,
		drag = dragMode,
		moving = moving ~= nil,
		snap = snapMode,
		road = roadInfo,
		drawing = roadAnchor ~= nil,
	}
end

local function plotIndex(): number?
	return ClientState.get("plot")
end

local function buildingsFolder(): Folder?
	local idx = plotIndex()
	if not idx then
		return nil
	end
	local homeland = workspace:FindFirstChild("Homeland")
	local plot = homeland and homeland:FindFirstChild("Plot_" .. idx)
	return plot and plot:FindFirstChild("Buildings") :: Folder? or nil
end

local function isSegment(def): boolean
	return def ~= nil and def.id == "road"
end

local function isGround(def): boolean
	return def ~= nil and (def.id == "road" or def.id == "plaza")
end

local function rectFor(def, x: number, z: number, a: number, len: number?): Footprint.Rect
	local w, d = Footprint.size(def, len)
	return Footprint.rect(x, z, w, d, a)
end

local function rebuildOccupancy()
	table.clear(others)
	table.clear(hash)
	local folder = buildingsFolder()
	if not folder then
		return
	end
	for _, model in folder:GetChildren() do
		if model:IsA("Model") and model ~= moving then
			local def = Buildings.get(model:GetAttribute("BuildingId") :: string)
			local px, pz = model:GetAttribute("PX") :: number?, model:GetAttribute("PZ") :: number?
			local uid = model:GetAttribute("Uid") :: number?
			if def and px and pz and uid then
				local rect = rectFor(def, px, pz, (model:GetAttribute("Angle") :: number?) or 0, model:GetAttribute("Len") :: number?)
				others[uid] = { uid = uid, rect = rect, ground = isGround(def), road = isSegment(def) }
				Footprint.hashAdd(hash, uid, rect)
			end
		end
	end
end

local function canPlaceLocal(def, x: number, z: number, a: number, len: number?): boolean
	local rect = rectFor(def, x, z, a, len)
	if not Footprint.inside(rect, HALF) then
		return false
	end
	local ground = isGround(def)
	-- a road's round end caps count against buildings (same rule as the server)
	local mine = isSegment(def) and Footprint.capped(rect) or rect
	for uid in Footprint.hashQuery(hash, mine) do
		local o = others[uid]
		if o and not (ground and o.ground) then
			local theirs = o.road and Footprint.capped(o.rect) or o.rect
			if Footprint.overlaps(mine, theirs) then
				return false
			end
		end
	end
	return true
end

---------------------------------------------------------------------------
-- Ghost visuals
---------------------------------------------------------------------------
local function clearDragTiles()
	for _, t in dragTiles do
		t:Destroy()
	end
	table.clear(dragTiles)
end

local function clearGhost()
	if ghost then
		ghost:Destroy()
		ghost = nil
	end
	if plate then
		plate:Destroy()
		plate = nil
	end
	if roadPreview then
		roadPreview:Destroy()
		roadPreview = nil
	end
	highlight = nil
	clearDragTiles()
	spot = nil
	roadInfo = nil
end

local function neon(name: string, transparency: number): Part
	local p = Instance.new("Part")
	p.Name = name
	p.Anchored = true
	p.CanCollide = false
	p.CanQuery = false
	p.CanTouch = false
	p.Material = Enum.Material.Neon
	p.Transparency = transparency
	p.Parent = workspace
	return p
end

local function makeGhost(def, len: number?)
	clearGhost()
	local m
	if isSegment(def) then
		m = ModelBuilder.roadSegment(def.size[1] * Grid.CellSize, len or def.size[2] * Grid.CellSize)
	else
		m = ModelBuilder.building(def)
	end
	for _, d in m:GetDescendants() do
		if d:IsA("BasePart") then
			d.CanCollide = false
			d.CanQuery = false
			d.CanTouch = false
			d.CastShadow = false
			d.Transparency = math.max(d.Transparency, 0.35)
		end
	end
	local h = Instance.new("Highlight")
	h.FillTransparency = 0.75
	h.OutlineTransparency = 0.1
	h.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
	h.Parent = m
	highlight = h
	m.Name = "Ghost"
	m.Parent = workspace
	ghost = m
	plate = neon("GhostPlate", 0.55)
	if isSegment(def) and not moving then
		local preview = neon("RoadPreview", 0.35)
		preview.Parent = nil
		roadPreview = preview
	end
end

---------------------------------------------------------------------------
-- Pointer -> island
---------------------------------------------------------------------------
local function groundHit(): Vector3?
	local ray = camera:ScreenPointToRay(pointer.X, pointer.Y)
	if math.abs(ray.Direction.Y) < 1e-4 then
		return nil
	end
	local t = -ray.Origin.Y / ray.Direction.Y
	if t < 0 or t > 4000 then
		return nil
	end
	return ray.Origin + ray.Direction * t
end

-- Pointer in island-local studs.
local function localHit(): Vector2?
	local idx = plotIndex()
	local hit = groundHit()
	if not idx or not hit then
		return nil
	end
	local l = Grid.toLocal(idx, hit)
	return Vector2.new(l.X, l.Z)
end

local function buildingUnderPointer(): Model?
	local folder = buildingsFolder()
	if not folder then
		return nil
	end
	local ray = camera:ScreenPointToRay(pointer.X, pointer.Y)
	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Include
	params.FilterDescendantsInstances = { folder }
	local result = workspace:Raycast(ray.Origin, ray.Direction * 4000, params)
	if not result then
		return nil
	end
	local inst: Instance? = result.Instance
	while inst and inst.Parent ~= folder do
		inst = inst.Parent
	end
	return inst and inst:IsA("Model") and inst or nil
end

local function closestOnSegment(p: Vector2, a: Vector2, b: Vector2): (Vector2, number)
	local ab = b - a
	local t = ab.Magnitude > 1e-6 and math.clamp((p - a):Dot(ab) / ab:Dot(ab), 0, 1) or 0
	return a + ab * t, t
end

-- Snap a road end to nearby road ends, then onto nearby road centrelines.
local function snapRoadPoint(p: Vector2): (Vector2, boolean)
	local best, bestD = nil, ROAD_SNAP
	local rect = Footprint.rect(p.X, p.Y, ROAD_SNAP * 2, ROAD_SNAP * 2, 0)
	local near = Footprint.hashQuery(hash, rect, ROAD_SNAP)
	for uid in near do
		local o = others[uid]
		if o and o.road then
			local a, b = Footprint.ends(o.rect)
			for _, e in { a, b } do
				local d = (e - p).Magnitude
				if d < bestD then
					best, bestD = e, d
				end
			end
		end
	end
	if best then
		return best, true
	end
	for uid in near do
		local o = others[uid]
		if o and o.road then
			local a, b = Footprint.ends(o.rect)
			local c = closestOnSegment(p, a, b)
			local d = (c - p).Magnitude
			if d < bestD then
				best, bestD = c, d
			end
		end
	end
	if best then
		return best, true
	end
	return p, false
end

-- Building footprint position for the pointer (snap / align applied).
local function solveSpot(def, p: Vector2, len: number?): (number, number, number)
	local w, d = Footprint.size(def, len)
	if snapMode == "grid" then
		local a = (math.floor(angle / 90 + 0.5) * 90) % 360
		local x, z = Grid.snapLocal(p.X, p.Y, w, d, a)
		return x, z, a
	end
	-- align to the nearest road so the front (-Z) faces the kerb
	if not isGround(def) and not UserInputService:IsKeyDown(Enum.KeyCode.LeftAlt) then
		local reach = d / 2 + 10
		local rect = Footprint.rect(p.X, p.Y, reach * 2, reach * 2, 0)
		local best, bestD, bestRoad = nil, math.huge, nil
		for uid in Footprint.hashQuery(hash, rect, reach) do
			local o = others[uid]
			if o and o.road then
				local a, b = Footprint.ends(o.rect)
				local c = closestOnSegment(p, a, b)
				local dist = (c - p).Magnitude
				if dist < o.rect.hw + reach and dist < bestD then
					best, bestD, bestRoad = c, dist, o
				end
			end
		end
		if best and bestRoad then
			local a, b = Footprint.ends(bestRoad.rect)
			local dir = (b - a).Unit
			local normal = Vector2.new(-dir.Y, dir.X)
			if (p - best):Dot(normal) < 0 then
				normal = -normal
			end
			local yaw = math.deg(math.atan2(normal.X, normal.Y)) % 360
			local centre = best + normal * (bestRoad.rect.hw + 0.4 + d / 2)
			return math.floor(centre.X * 20 + 0.5) / 20, math.floor(centre.Y * 20 + 0.5) / 20, yaw
		end
	end
	return math.floor(p.X * 2 + 0.5) / 2, math.floor(p.Y * 2 + 0.5) / 2, angle
end

local function cashOk(cost: number): boolean
	return (ClientState.get("cash") or 0) >= cost
end

local function roadCost(def, len: number): number
	return def.cost * math.max(1, math.ceil(len / (def.size[2] * Grid.CellSize) - 0.01))
end

-- Road end point for the pointer (grid / snapping / max length applied).
local function roadPoint(p: Vector2): Vector2
	local q = p
	if snapMode == "grid" then
		q = Vector2.new(math.floor(q.X / Grid.CellSize + 0.5) * Grid.CellSize, math.floor(q.Y / Grid.CellSize + 0.5) * Grid.CellSize)
	end
	local snapped
	q, snapped = snapRoadPoint(q)
	local anchor = roadAnchor
	if anchor and not snapped then
		local v = q - anchor
		if v.Magnitude > 0.5 then
			local step = snapMode == "grid" and 45 or (UserInputService:IsKeyDown(Enum.KeyCode.LeftShift) and 15 or 0)
			if step > 0 then
				local a = math.atan2(v.X, v.Y)
				a = math.rad(math.floor(math.deg(a) / step + 0.5) * step)
				q = anchor + Vector2.new(math.sin(a), math.cos(a)) * v.Magnitude
			end
		end
		local l = (q - anchor).Magnitude
		if l > Config.RoadMaxLength then
			q = anchor + (q - anchor).Unit * Config.RoadMaxLength
		end
	end
	return q
end

---------------------------------------------------------------------------
-- Per-frame update
---------------------------------------------------------------------------
local function paint(color: Color3)
	if plate then
		plate.Color = color
	end
	if highlight then
		highlight.FillColor = color
		highlight.OutlineColor = color
	end
end

local function update()
	local active = ClientState.mode == "build" or moving ~= nil
	-- hover highlight for delete / move / inspect
	local hovered: Model? = nil
	if active and (tool == "delete" or (tool == "move" and not moving)) then
		hovered = buildingUnderPointer()
	end
	if hovered then
		if hoverHighlight.Adornee ~= hovered then
			hoverHighlight.Adornee = hovered
		end
		hoverHighlight.OutlineColor = tool == "delete" and INVALID or MOVE
		hoverHighlight.FillColor = hoverHighlight.OutlineColor
	end
	hoverHighlight.Enabled = hovered ~= nil

	local def = selected
	local idx = plotIndex()
	if not active or not def or not ghost or not plate or not idx then
		return
	end
	local p = localHit()
	if not p then
		ghost.Parent = nil
		plate.Parent = nil
		spot = nil
		return
	end

	-- drawing a road: preview the segment from the anchor
	if isSegment(def) and not moving then
		local q = roadPoint(p)
		local anchor = roadAnchor
		local w = def.size[1] * Grid.CellSize
		if anchor and roadPreview then
			local x, z, a, len = Footprint.segment(anchor.X, anchor.Y, q.X, q.Y)
			len = math.max(len, 0.1)
			local valid = len >= 2 and canPlaceLocal(def, x, z, a, len) and cashOk(roadCost(def, len))
			roadPreview.Parent = workspace
			roadPreview.Size = Vector3.new(w, 0.35, len + w)
			roadPreview.CFrame = Grid.toWorld(idx, x, z, a) * CFrame.new(0, 0.2, 0)
			roadPreview.Color = valid and ROAD or INVALID
			roadInfo = { len = len, cost = roadCost(def, len), valid = valid }
		elseif roadPreview then
			roadPreview.Parent = nil
			roadInfo = nil
		end
		-- the ghost tile marks the pen tip
		ghost.Parent = workspace
		plate.Parent = workspace
		ghost:PivotTo(Grid.toWorld(idx, q.X, q.Y, angle))
		plate.Size = Vector3.new(w + 1, 0.1, w + 1)
		plate.CFrame = Grid.toWorld(idx, q.X, q.Y, angle) * CFrame.new(0, 0.08, 0)
		paint(anchor and ROAD or VALID)
		spot = { x = q.X, z = q.Y, a = angle, valid = true }
		return
	end

	ghost.Parent = workspace
	plate.Parent = workspace
	local len = moving and movingLen or nil
	local x, z, a = solveSpot(def, p, len)
	local cost = len and roadCost(def, len) or def.cost
	local valid = canPlaceLocal(def, x, z, a, len) and (moving ~= nil or cashOk(cost))
	local cf = Grid.toWorld(idx, x, z, a)
	ghost:PivotTo(cf)
	local w, d = Footprint.size(def, len)
	plate.Size = Vector3.new(w - 0.2, 0.1, d - 0.2)
	plate.CFrame = cf * CFrame.new(0, 0.08, 0)
	paint(moving and (valid and MOVE or INVALID) or (valid and VALID or INVALID))
	spot = { x = x, z = z, a = a, valid = valid }

	-- row preview
	local start = dragStart
	if start then
		local spots = Placement.rowSpots(def, start, Vector2.new(x, z), a)
		for i, s in spots do
			local t = dragTiles[i]
			if not t then
				t = neon("RowTile", 0.45)
				dragTiles[i] = t
			end
			t.Size = Vector3.new(w - 0.4, 0.3, d - 0.4)
			t.CFrame = Grid.toWorld(idx, s[1], s[2], a) * CFrame.new(0, 0.15, 0)
			t.Color = canPlaceLocal(def, s[1], s[2], a) and VALID or INVALID
		end
		for i = #spots + 1, #dragTiles do
			dragTiles[i]:Destroy()
			dragTiles[i] = nil
		end
	end
end

-- Evenly spaced copies from a to b (spacing = footprint along the drag).
function Placement.rowSpots(def, a: Vector2, b: Vector2, yaw: number): { { number } }
	local w, d = Footprint.size(def)
	local v = b - a
	if v.Magnitude < 0.5 then
		return { { a.X, a.Y } }
	end
	local dir = v.Unit
	local rad = math.rad(yaw)
	local ux = Vector2.new(math.cos(rad), -math.sin(rad))
	local along = math.abs(dir:Dot(ux)) >= 0.7071 and w or d
	local n = math.min(math.floor(v.Magnitude / along + 0.5), 60)
	local out = {}
	for i = 0, n do
		local p = a + dir * along * i
		table.insert(out, { p.X, p.Y })
	end
	return out
end

---------------------------------------------------------------------------
-- Actions
---------------------------------------------------------------------------
local function toast(res)
	if res and not res.ok and res.err then
		Notifications.show(res.err, "bad")
		Sounds.play("Error")
		return false
	end
	return true
end

local function endRoad()
	roadAnchor = nil
	roadPress = nil
	roadInfo = nil
	if roadPreview then
		roadPreview.Parent = nil
	end
	notifyChanged()
end

function Placement.select(def)
	moving = nil
	movingLen = nil
	tool = nil
	selected = def
	dragStart = nil
	roadAnchor = nil
	if def then
		makeGhost(def)
		dragMode = def.drag == true and not isSegment(def)
	else
		clearGhost()
		dragMode = false
	end
	notifyChanged()
end

function Placement.setTool(t: string?)
	if moving then
		moving = nil
		movingLen = nil
		rebuildOccupancy()
	end
	if t == tool then
		t = nil
	end
	tool = t
	if t then
		selected = nil
		roadAnchor = nil
		clearGhost()
	end
	notifyChanged()
end

local function startMove(target: Model)
	local def = Buildings.get(target:GetAttribute("BuildingId") :: string)
	if not def then
		return
	end
	angle = (target:GetAttribute("Angle") :: number?) or 0
	tool = "move"
	selected = def
	moving = target
	movingLen = target:GetAttribute("Len") :: number?
	makeGhost(def, movingLen)
	rebuildOccupancy()
	notifyChanged()
end

-- Start moving a specific building (used by the building panel's Move button).
function Placement.beginMove(target: Model)
	startMove(target)
end

function Placement.rotate(reverse: boolean?)
	local step = snapMode == "grid" and 90 or 15
	angle = (angle + (reverse and -step or step)) % 360
	if snapMode == "grid" then
		angle = (math.floor(angle / 90 + 0.5) * 90) % 360
	end
	notifyChanged()
end

function Placement.toggleSnap()
	snapMode = snapMode == "free" and "grid" or "free"
	if snapMode == "grid" then
		angle = (math.floor(angle / 90 + 0.5) * 90) % 360
	end
	Sounds.play("Click", snapMode == "grid" and 1.2 or 0.9)
	notifyChanged()
end

function Placement.toggleDrag()
	dragMode = not dragMode
	notifyChanged()
end

function Placement.cancel()
	moving = nil
	movingLen = nil
	selected = nil
	tool = nil
	dragStart = nil
	roadAnchor = nil
	clearGhost()
	rebuildOccupancy()
	notifyChanged()
end

function Placement.undo()
	local res = Net.request("Undo")
	if toast(res) then
		Sounds.play("Click", 0.8)
		task.delay(0.3, rebuildOccupancy)
	end
end

local function placeAt(def, x: number, z: number, a: number)
	local res = Net.request("PlaceBuilding", def.id, x, z, a)
	if toast(res) then
		Sounds.play("Place")
	end
end

-- Lay a road from a to b (local studs); returns true when placed.
function Placement.drawRoad(def, a: Vector2, b: Vector2): boolean
	local res = Net.request("PlaceRoad", def.id, a.X, a.Y, b.X, b.Y)
	if toast(res) then
		Sounds.play("Place")
		return true
	end
	return false
end

local function primaryDown()
	local mode = ClientState.mode
	if mode == "war" then
		return
	end
	if moving and selected then
		local s = spot
		if not s then
			return
		end
		local uid = moving:GetAttribute("Uid")
		local res = Net.request("MoveBuilding", uid, s.x, s.z, s.a)
		if toast(res) then
			Sounds.play("Place")
			moving = nil
			movingLen = nil
			selected = nil
			clearGhost()
			task.delay(0.2, rebuildOccupancy)
			notifyChanged()
		end
		return
	end
	if mode == "build" and tool == "delete" then
		local target = buildingUnderPointer()
		if target then
			local res = Net.request("DeleteBuilding", target:GetAttribute("Uid"))
			if toast(res) then
				Sounds.play("Click", 0.7)
			end
		end
		return
	end
	if mode == "build" and tool == "move" then
		local target = buildingUnderPointer()
		if target then
			startMove(target)
		end
		return
	end
	if mode == "build" and selected then
		local s = spot
		if not s then
			return
		end
		if isSegment(selected) then
			local p = Vector2.new(s.x, s.z)
			roadPress = p
			roadPressAnchored = roadAnchor ~= nil
			if not roadAnchor then
				roadAnchor = p
				notifyChanged()
			end
		elseif dragMode then
			dragStart = Vector2.new(s.x, s.z)
		else
			placeAt(selected, s.x, s.z, s.a)
		end
		return
	end
	-- inspect
	local target = buildingUnderPointer()
	if target then
		Hub.call("openBuilding", target)
	end
end

local function primaryUp()
	local def = selected
	if def and isSegment(def) and roadPress then
		local press = roadPress
		roadPress = nil
		local s = spot
		local anchor = roadAnchor
		if not s or not anchor then
			return
		end
		local p = Vector2.new(s.x, s.z)
		local dragged = (p - press).Magnitude > 4
		if dragged or roadPressAnchored then
			if (p - anchor).Magnitude < 2 then
				endRoad() -- clicked the same spot twice: finish the road
			elseif Placement.drawRoad(def, anchor, p) then
				roadAnchor = p -- keep drawing from here
				task.delay(0.2, rebuildOccupancy)
				notifyChanged()
			end
		end
		return
	end
	local start = dragStart
	dragStart = nil
	if start and def and spot then
		clearDragTiles()
		local spots = Placement.rowSpots(def, start, Vector2.new(spot.x, spot.z), spot.a)
		if #spots == 1 then
			placeAt(def, spots[1][1], spots[1][2], spot.a)
		else
			local res = Net.request("PlaceMany", def.id, spots, spot.a)
			if toast(res) then
				Sounds.play("Place")
			end
		end
	end
end

function Placement.init()
	hoverHighlight = Instance.new("Highlight")
	hoverHighlight.FillTransparency = 0.7
	hoverHighlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
	hoverHighlight.Enabled = false
	hoverHighlight.Parent = player:WaitForChild("PlayerGui")

	UserInputService.InputChanged:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then
			pointer = Vector2.new(input.Position.X, input.Position.Y)
		end
	end)
	UserInputService.InputBegan:Connect(function(input, processed)
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
			pointer = Vector2.new(input.Position.X, input.Position.Y)
			if processed then
				return
			end
			update() -- refresh the ghost under the pointer / finger first
			primaryDown()
		elseif input.UserInputType == Enum.UserInputType.MouseButton2 and roadAnchor then
			endRoad()
		elseif not processed and ClientState.mode == "build" then
			local key = input.KeyCode
			if key == Enum.KeyCode.R or key == Enum.KeyCode.Six then
				Placement.rotate(UserInputService:IsKeyDown(Enum.KeyCode.LeftShift))
			elseif key == Enum.KeyCode.G then
				Placement.toggleSnap()
			elseif key == Enum.KeyCode.Two then
				Placement.setTool("delete")
			elseif key == Enum.KeyCode.Three or (key == Enum.KeyCode.Z and UserInputService:IsKeyDown(Enum.KeyCode.LeftControl)) then
				Placement.undo()
			elseif key == Enum.KeyCode.Four then
				Placement.toggleDrag()
			elseif key == Enum.KeyCode.Five then
				Placement.setTool("move")
			elseif key == Enum.KeyCode.Q or key == Enum.KeyCode.Escape then
				if roadAnchor then
					endRoad()
				else
					Placement.cancel()
				end
			end
		end
	end)
	UserInputService.InputEnded:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
			update()
			primaryUp()
		end
	end)

	RunService.RenderStepped:Connect(update)

	-- keep occupancy in sync with the island
	local function hookFolder()
		local folder = buildingsFolder()
		if not folder then
			return
		end
		folder.ChildAdded:Connect(function()
			task.defer(rebuildOccupancy)
		end)
		folder.ChildRemoved:Connect(function()
			task.defer(rebuildOccupancy)
		end)
		rebuildOccupancy()
	end
	ClientState.on("plot", function()
		task.wait(0.5)
		hookFolder()
	end)
	ClientState.onMode(function(mode)
		if mode ~= "build" and not moving then
			Placement.cancel()
		end
	end)
end

-- exposed for automated tests
Placement._rebuild = rebuildOccupancy
Placement._canPlace = canPlaceLocal
Placement._solve = function(def, x: number, z: number): (number, number, number)
	return solveSpot(def, Vector2.new(x, z))
end

return Placement
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="66">
            <Properties>
              <string name="Name">ResearchUI</string>
              <string name="Source"><![CDATA[--[[
	ResearchUI - Tech Tree
	Full-screen window: summary strip (RP, hits, current project), branch
	tabs (CIVIL / MILITARY), a node graph with connector lines between
	prerequisites, and a detail pane showing what a node unlocks.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Shared = ReplicatedStorage.Shared
local Research = require(Shared.Catalog.Research)
local Buildings = require(Shared.Catalog.Buildings)
local Weapons = require(Shared.Catalog.Weapons)
local Units = require(Shared.Catalog.Units)
local Format = require(Shared.Util.Format)
local Net = require(Shared.Net)

local Client = script.Parent.Parent
local ClientState = require(Client.ClientState)
local Hub = require(Client.Hub)
local Lib = require(Client.UI.Lib)
local Theme = require(Client.UI.Theme)
local Icons = require(Client.UI.Icons)
local Modal = require(script.Parent.Modal)
local Notifications = require(script.Parent.Notifications)
local Sounds = require(script.Parent.Sounds)

local New = Lib.New
local C = Theme.Color

local ResearchUI = {}

local NODE_W, NODE_H = 168, 84
local GAP_X, GAP_Y = 48, 22

local function nodeState(def): (string, string?)
	local d = ClientState.data
	local researched = d.researched or {}
	if researched[def.id] then
		return "done", nil
	end
	local active = d.research
	if active and active.id == def.id then
		return "active", nil
	end
	for _, req in def.requires do
		if not researched[req] then
			local r = Research.get(req)
			return "locked", "Needs " .. (r and r.name or req)
		end
	end
	local hits = (d.stats or {}).Hits or 0
	if def.hits and hits < def.hits then
		return "locked", ("Needs %d hits (%d)"):format(def.hits, hits)
	end
	return "available", nil
end

local function unlocksOf(id: string): { string }
	local out = {}
	for _, b in Buildings.all() do
		if b.research == id then
			table.insert(out, b.name)
		end
	end
	for _, w in Weapons.all() do
		if w.research == id then
			table.insert(out, w.name)
		end
	end
	for _, u in Units.all() do
		if u.research == id then
			table.insert(out, u.name)
		end
	end
	return out
end

local function nodePos(def): Vector2
	return Vector2.new(16 + (def.col - 1) * (NODE_W + GAP_X), 16 + (def.row - 1) * (NODE_H + GAP_Y))
end

-- Axis-aligned connector segment (rotated frames escape scroll clipping).
local function line(parent: Instance, a: Vector2, b: Vector2, color: Color3, thickness: number?)
	local t = thickness or 2
	local x0, x1 = math.min(a.X, b.X), math.max(a.X, b.X)
	local y0, y1 = math.min(a.Y, b.Y), math.max(a.Y, b.Y)
	return New("Frame", {
		BackgroundColor3 = color,
		BorderSizePixel = 0,
		Position = UDim2.fromOffset(x0 - t / 2, y0 - t / 2),
		Size = UDim2.fromOffset(math.max(x1 - x0, 0) + t, math.max(y1 - y0, 0) + t),
		ZIndex = 1,
		Parent = parent,
	})
end

function ResearchUI.open(focusId: string?)
	local win = Modal.open("Tech Tree", "Unlock new buildings, weapons and vehicles", 1240, 720)
	local ic = Icons.flask(34, C.Teal)
	ic.Position = UDim2.fromOffset(9, 7)
	ic.Parent = win.iconHolder

	local d0 = ClientState.data
	local branch = "Civil"
	if focusId then
		local f = Research.get(focusId)
		if f then
			branch = f.branch
		end
	elseif d0.researched and d0.researched.urban_planning and not d0.researched.military_doctrine then
		branch = "Military"
	end
	local selected: string? = focusId

	-- summary strip
	local top = New("Frame", { BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 70), Parent = win.body }, { Lib.list("x", 8) })
	local function summary(caption: string, order: number, width: number, color: Color3): TextLabel
		local card = Lib.card({ Size = UDim2.new(0, width, 1, 0), LayoutOrder = order, Parent = top }, { Lib.pad(9, 12) })
		Lib.caption(caption, { Parent = card })
		return Lib.display({ Text = "-", TextSize = 22, TextColor3 = color, Position = UDim2.fromOffset(0, 18), Size = UDim2.new(1, 0, 0, 28), Parent = card })
	end
	local rpLabel = summary("Research points", 1, 220, C.Teal)
	local hitsLabel = summary("Confirmed hits", 2, 160, C.Military)
	local activeCard = Lib.card({ Size = UDim2.new(1, -396, 1, 0), LayoutOrder = 3, Parent = top }, { Lib.pad(9, 12) })
	Lib.caption("Current project", { Parent = activeCard })
	local activeName = Lib.display({ Text = "IDLE", TextSize = 17, Position = UDim2.fromOffset(0, 16), Size = UDim2.new(1, -160, 0, 22), Parent = activeCard })
	local activeBar = Lib.progress({ Segments = 20, Position = UDim2.fromOffset(0, 42), Size = UDim2.new(1, -160, 0, 6), Parent = activeCard })
	local activeTime = Lib.text({ Text = "", FontFace = Theme.Font.Mono, TextSize = 11, TextColor3 = C.Muted, AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, -160, 0, 18), Size = UDim2.fromOffset(120, 16), TextXAlignment = Enum.TextXAlignment.Right, Parent = activeCard })
	Lib.button({
		Variant = "gold",
		Text = "FINISH NOW",
		TextSize = 13,
		AnchorPoint = Vector2.new(1, 0.5),
		Position = UDim2.new(1, 0, 0.5, 0),
		Size = UDim2.fromOffset(140, 38),
		Parent = activeCard,
		Activated = function()
			Hub.call("buyProduct", "InstantResearch")
		end,
	})

	-- branch tabs
	local tabs = New("Frame", { BackgroundTransparency = 1, Position = UDim2.fromOffset(0, 80), Size = UDim2.new(1, -330, 0, 32), Parent = win.body }, { Lib.list("x", 6) })
	-- tree canvas + detail pane
	local canvas = Lib.inset({ Position = UDim2.fromOffset(0, 118), Size = UDim2.new(1, -330, 1, -118), ClipsDescendants = true, Parent = win.body })
	local scroll = Lib.scroll({
		ScrollingDirection = Enum.ScrollingDirection.XY,
		AutomaticCanvasSize = Enum.AutomaticSize.XY,
		Parent = canvas,
	})
	local detail = Lib.card({ AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, 0, 0, 80), Size = UDim2.new(0, 318, 1, -80), Parent = win.body }, { Lib.pad(14) })

	local nodes: { [string]: { btn: TextButton, status: TextLabel, bar: Lib.Progress, stroke: UIStroke } } = {}
	local links: { { frame: Frame, from: string, to: string } } = {}

	local renderDetail
	local function renderTree()
		Lib.clear(scroll)
		table.clear(nodes)
		table.clear(links)
		local area = New("Frame", { BackgroundTransparency = 1, Size = UDim2.fromOffset(10, 10), Parent = scroll })
		local maxX, maxY = 0, 0
		for _, def in Research.all() do
			if def.branch == branch then
				local p = nodePos(def)
				maxX = math.max(maxX, p.X + NODE_W + 16)
				maxY = math.max(maxY, p.Y + NODE_H + 16)
				for _, req in def.requires do
					local r = Research.get(req)
					if r and r.branch == branch then
						local a = nodePos(r) + Vector2.new(NODE_W, NODE_H / 2)
						local b = p + Vector2.new(0, NODE_H / 2)
						local midX = (a.X + b.X) / 2
						-- elbow connector: out, across, in
						local f1 = line(area, a, Vector2.new(midX, a.Y), C.Line)
						local f2 = line(area, Vector2.new(midX, a.Y), Vector2.new(midX, b.Y), C.Line)
						local f3 = line(area, Vector2.new(midX, b.Y), b, C.Line)
						for _, f in { f1, f2, f3 } do
							table.insert(links, { frame = f, from = req, to = def.id })
						end
					end
				end
			end
		end
		area.Size = UDim2.fromOffset(maxX, maxY)
		for _, def in Research.all() do
			if def.branch == branch then
				local p = nodePos(def)
				local btn = Lib.button({
					Name = def.id,
					Position = UDim2.fromOffset(p.X, p.Y),
					Size = UDim2.fromOffset(NODE_W, NODE_H),
					BackgroundColor3 = C.Raised,
					ZIndex = 2,
					Parent = area,
					Activated = function()
						selected = def.id
						renderDetail()
						ResearchUI.refreshNodes()
					end,
				}, { Lib.corner(4), Lib.pad(8, 10) })
				local stroke = Lib.stroke(C.LineSoft, 1, 0)
				stroke.Parent = btn
				Lib.display({ Text = string.upper(def.name), TextSize = 13, TextWrapped = true, TextYAlignment = Enum.TextYAlignment.Top, Size = UDim2.new(1, 0, 0, 32), ZIndex = 3, Parent = btn })
				Lib.text({
					Text = ("%s RP · %s"):format(Format.short(def.rp), Format.cash(def.cash)),
					FontFace = Theme.Font.Mono,
					TextSize = 10,
					TextColor3 = C.Info,
					Position = UDim2.fromOffset(0, 34),
					Size = UDim2.new(1, 0, 0, 13),
					ZIndex = 3,
					Parent = btn,
				})
				local status = Lib.display({ Text = "", TextSize = 10, Position = UDim2.fromOffset(0, 50), Size = UDim2.new(1, 0, 0, 13), ZIndex = 3, Parent = btn })
				local bar = Lib.progress({ Position = UDim2.new(0, 0, 1, -2), Size = UDim2.new(1, 0, 0, 3), ZIndex = 3, Parent = btn })
				nodes[def.id] = { btn = btn, status = status, bar = bar, stroke = stroke }
			end
		end
		ResearchUI.refreshNodes()
	end

	local function renderTabs()
		Lib.clear(tabs)
		for i, b in { "Civil", "Military" } do
			local active = b == branch
			Lib.button({
				Name = b,
				Variant = active and "primary" or "secondary",
				Text = string.upper(b),
				TextSize = 13,
				Size = UDim2.fromOffset(130, 32),
				LayoutOrder = i,
				Parent = tabs,
				Activated = function()
					branch = b
					renderTabs()
					renderTree()
				end,
			})
		end
	end

	renderDetail = function()
		Lib.clear(detail)
		local def = selected and Research.get(selected)
		if not def then
			Lib.display({ Text = "SELECT A PROJECT", TextSize = 18, Parent = detail })
			Lib.text({ Text = "Click a node to see what it unlocks.", TextColor3 = C.Muted, TextSize = 13, Position = UDim2.fromOffset(0, 28), Parent = detail })
			return
		end
		local st, reason = nodeState(def)
		Lib.caption(def.branch .. " research", { TextColor3 = C.Accent, Parent = detail })
		Lib.display({ Text = string.upper(def.name), TextSize = 21, TextWrapped = true, Position = UDim2.fromOffset(0, 16), Size = UDim2.new(1, 0, 0, 50), TextYAlignment = Enum.TextYAlignment.Top, Parent = detail })
		Lib.text({ Text = def.desc, TextSize = 13, TextColor3 = C.TextSoft, TextWrapped = true, Position = UDim2.fromOffset(0, 66), Size = UDim2.new(1, 0, 0, 36), TextYAlignment = Enum.TextYAlignment.Top, Parent = detail })
		local costs = New("Frame", { BackgroundTransparency = 1, Position = UDim2.fromOffset(0, 108), Size = UDim2.new(1, 0, 0, 22), Parent = detail }, { Lib.list("x", 6) })
		Lib.chip(Format.short(def.rp) .. " RP", C.TealSoft, C.Teal, { Parent = costs })
		Lib.chip(Format.cash(def.cash), C.GoodSoft, C.Good, { Parent = costs })
		Lib.chip(Format.duration(def.time), C.InfoSoft, C.Info, { Parent = costs })
		if def.hits then
			Lib.chip(("%d HITS"):format(def.hits), C.BadSoft, C.Military, { Parent = costs })
		end
		Lib.caption("Unlocks", { Position = UDim2.fromOffset(0, 142), Parent = detail })
		local list = New("Frame", { BackgroundTransparency = 1, Position = UDim2.fromOffset(0, 160), Size = UDim2.new(1, 0, 1, -230), Parent = detail }, { Lib.list("y", 4) })
		for i, name in unlocksOf(def.id) do
			local row = New("Frame", { BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 18), LayoutOrder = i, Parent = list }, { Lib.list("x", 8, nil, Enum.VerticalAlignment.Center) })
			New("Frame", { BackgroundColor3 = C.Accent, Size = UDim2.fromOffset(5, 5), LayoutOrder = 1, Parent = row })
			Lib.text({ Text = name, TextSize = 13, FontFace = Theme.Font.BodyBold, AutomaticSize = Enum.AutomaticSize.X, Size = UDim2.new(0, 0, 1, 0), LayoutOrder = 2, Parent = row })
		end
		local label, variant = "RESEARCH", "primary"
		if st == "done" then
			label, variant = "RESEARCHED", "good"
		elseif st == "active" then
			label, variant = "IN PROGRESS", "secondary"
		elseif st == "locked" then
			label, variant = string.upper(reason or "LOCKED"), "ghost"
		elseif ClientState.get("research") then
			label, variant = "ANOTHER PROJECT RUNNING", "ghost"
		end
		Lib.button({
			Name = "StartResearch",
			Variant = variant,
			Text = label,
			TextSize = 13,
			AnchorPoint = Vector2.new(0, 1),
			Position = UDim2.new(0, 0, 1, 0),
			Size = UDim2.new(1, 0, 0, 44),
			Parent = detail,
			Activated = function()
				if st ~= "available" then
					if reason then
						Notifications.show(reason, "info")
					end
					return
				end
				local res = Net.request("StartResearch", def.id)
				if res.ok then
					Sounds.play("Success", 1.2)
					task.delay(0.3, renderDetail)
				elseif res.err then
					Notifications.show(res.err, "bad")
				end
			end,
		})
	end

	function ResearchUI.refreshNodes()
		local d = ClientState.data
		local active = d.research
		local now = Lib.serverNow()
		for id, n in nodes do
			local def = Research.get(id)
			if def then
				local st, reason = nodeState(def)
				local isSel = selected == id
				if st == "done" then
					Lib.setButtonColor(n.btn, C.GoodSoft)
					n.status.Text = "RESEARCHED"
					n.status.TextColor3 = C.Good
					n.bar.frame.Visible = false
					n.stroke.Color = C.Good
				elseif st == "active" and active then
					Lib.setButtonColor(n.btn, C.AccentSoft)
					n.status.Text = "IN PROGRESS"
					n.status.TextColor3 = C.Accent
					n.bar.frame.Visible = true
					n.bar.set((now - active.startAt) / math.max(1, active.finishAt - active.startAt), C.Accent)
					n.stroke.Color = C.Accent
				elseif st == "available" then
					Lib.setButtonColor(n.btn, C.Raised)
					local affordable = (d.rp or 0) >= def.rp and (d.cash or 0) >= def.cash
					n.status.Text = affordable and "AVAILABLE" or "NEED RP / CASH"
					n.status.TextColor3 = affordable and C.Teal or C.Gold
					n.bar.frame.Visible = false
					n.stroke.Color = C.Teal
				else
					Lib.setButtonColor(n.btn, C.Inset)
					n.status.Text = string.upper(reason or "LOCKED")
					n.status.TextColor3 = C.Faint
					n.bar.frame.Visible = false
					n.stroke.Color = C.LineSoft
				end
				if isSel then
					n.stroke.Color = C.Gold
					n.stroke.Thickness = 2
				else
					n.stroke.Thickness = 1
				end
			end
		end
		for _, l in links do
			local done = (d.researched or {})[l.from] == true
			l.frame.BackgroundColor3 = done and C.Teal or C.Line
			l.frame.BackgroundTransparency = done and 0 or 0.3
		end
	end

	local function refreshSummary()
		local d = ClientState.data
		rpLabel.Text = ("%s  +%s/m"):format(Format.short(d.rp or 0), Format.short(d.rpRate or 0))
		hitsLabel.Text = Format.commas(((d.stats or {}).Hits) or 0)
		local active = d.research
		local now = Lib.serverNow()
		if active then
			local def = Research.get(active.id)
			activeName.Text = string.upper(def and def.name or active.id)
			activeBar.set((now - active.startAt) / math.max(1, active.finishAt - active.startAt), C.Accent)
			activeTime.Text = Format.clock(active.finishAt - now)
		else
			activeName.Text = (d.rpRate or 0) <= 0 and "IDLE · BUILD A RESEARCH LAB" or "IDLE · PICK A PROJECT"
			activeBar.set(0)
			activeTime.Text = ""
		end
	end

	renderTabs()
	renderTree()
	renderDetail()
	refreshSummary()
	local acc = 0
	local conn = RunService.Heartbeat:Connect(function(dt)
		acc += dt
		if acc > 0.5 then
			acc = 0
			refreshSummary()
			ResearchUI.refreshNodes()
		end
	end)
	win.onClose(function()
		conn:Disconnect()
	end)
end

function ResearchUI.refreshNodes() end

function ResearchUI.init()
	Hub.openResearch = ResearchUI.open
end

return ResearchUI
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="67">
            <Properties>
              <string name="Name">RewardsUI</string>
              <string name="Source"><![CDATA[--[[
	RewardsUI
	Rewards hub with three tabs: DAILY (7-day streak calendar), GIFT
	(playtime gift with countdown) and CODES (codes + group reward), plus the
	welcome-back screen that shows offline earnings.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Shared = ReplicatedStorage.Shared
local Config = require(Shared.Config)
local Format = require(Shared.Util.Format)
local Net = require(Shared.Net)

local Client = script.Parent.Parent
local ClientState = require(Client.ClientState)
local Hub = require(Client.Hub)
local Lib = require(Client.UI.Lib)
local Theme = require(Client.UI.Theme)
local Icons = require(Client.UI.Icons)
local Modal = require(script.Parent.Modal)
local Notifications = require(script.Parent.Notifications)
local Sounds = require(script.Parent.Sounds)

local New = Lib.New
local C = Theme.Color

local RewardsUI = {}

local function daily(parent: Instance)
	local d = ClientState.get("daily") or { streak = 0, canClaim = false, next = 1, reward = 0 }
	local row = New("Frame", { BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 170), Parent = parent }, { Lib.list("x", 8) })
	local n = #Config.DailyRewards
	local nextDay = ((d.next - 1) % n) + 1
	local currentDay = ((math.max(d.streak, 1) - 1) % n) + 1
	for i, base in Config.DailyRewards do
		local isNext = d.canClaim and i == nextDay
		local claimed = (not d.canClaim and i <= currentDay and d.streak > 0) or (d.canClaim and i < nextDay)
		local card = Lib.card({
			Name = "Day" .. i,
			Size = UDim2.new(1 / n, -7, 1, 0),
			BackgroundColor3 = isNext and C.AccentSoft or (claimed and C.GoodSoft or C.Raised),
			LayoutOrder = i,
			Parent = row,
		}, { Lib.pad(10, 8) })
		if isNext then
			Lib.brackets(card, C.Accent, 8, 2, 3)
		end
		Lib.display({ Text = ("DAY %d"):format(i), TextSize = 13, TextColor3 = isNext and C.Accent or C.Muted, TextXAlignment = Enum.TextXAlignment.Center, Size = UDim2.new(1, 0, 0, 16), Parent = card })
		local gift = Icons.gift(44, i == n and C.Gold or (claimed and C.Good or C.Military))
		gift.AnchorPoint = Vector2.new(0.5, 0)
		gift.Position = UDim2.new(0.5, 0, 0, 30)
		gift.Parent = card
		Lib.display({
			Text = (isNext and Format.cash(d.reward)) or (Format.cash(base) .. "+"),
			TextSize = 14,
			TextColor3 = C.Good,
			TextXAlignment = Enum.TextXAlignment.Center,
			Position = UDim2.fromOffset(0, 92),
			Size = UDim2.new(1, 0, 0, 18),
			Parent = card,
		})
		Lib.display({
			Text = claimed and "CLAIMED" or (isNext and "TODAY" or "LOCKED"),
			TextSize = 10,
			TextColor3 = claimed and C.Good or (isNext and C.Accent or C.Faint),
			TextXAlignment = Enum.TextXAlignment.Center,
			Position = UDim2.fromOffset(0, 118),
			Size = UDim2.new(1, 0, 0, 14),
			Parent = card,
		})
	end
	Lib.button({
		Name = "ClaimDaily",
		Variant = d.canClaim and "primary" or "ghost",
		Text = d.canClaim and ("CLAIM " .. Format.cash(d.reward)) or "COME BACK TOMORROW",
		TextSize = 15,
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0, 184),
		Size = UDim2.fromOffset(300, 46),
		Parent = parent,
		Activated = function()
			local res = Net.request("ClaimDaily")
			if res.ok then
				Sounds.play("Success")
				Modal.close()
			elseif res.err then
				Notifications.show(res.err, "info")
			end
		end,
	})
	Lib.text({
		Text = ("Streak: %d day%s · rewards grow with your income · missing a day resets the streak"):format(d.streak, d.streak == 1 and "" or "s"),
		TextColor3 = C.Muted,
		TextSize = 12,
		TextXAlignment = Enum.TextXAlignment.Center,
		Position = UDim2.fromOffset(0, 238),
		Size = UDim2.new(1, 0, 0, 16),
		Parent = parent,
	})
end

local function gift(parent: Instance): () -> ()
	local box = Lib.card({ Size = UDim2.new(1, 0, 0, 220), Parent = parent }, { Lib.pad(18) })
	local ic = Icons.gift(76, C.Premium)
	ic.Position = UDim2.fromOffset(6, 10)
	ic.Parent = box
	Lib.display({ Text = "PLAYTIME GIFT", TextSize = 22, Position = UDim2.fromOffset(110, 6), Size = UDim2.new(1, -110, 0, 26), Parent = box })
	Lib.text({ Text = "Every 10 minutes you play, a supply crate worth 1.5 pay days arrives.", TextSize = 13, TextColor3 = C.TextSoft, TextWrapped = true, Position = UDim2.fromOffset(110, 34), Size = UDim2.new(1, -110, 0, 36), Parent = box })
	local value = Lib.display({ Text = "", TextSize = 28, TextColor3 = C.Good, Position = UDim2.fromOffset(110, 74), Size = UDim2.new(1, -110, 0, 32), Parent = box })
	local timer = Lib.text({ Text = "", FontFace = Theme.Font.Mono, TextSize = 14, TextColor3 = C.Accent, Position = UDim2.fromOffset(110, 108), Size = UDim2.new(1, -110, 0, 18), Parent = box })
	local claim = Lib.button({
		Name = "ClaimGift",
		Variant = "primary",
		Text = "OPEN CRATE",
		TextSize = 15,
		AnchorPoint = Vector2.new(0, 1),
		Position = UDim2.new(0, 110, 1, 0),
		Size = UDim2.fromOffset(240, 44),
		Parent = box,
		Activated = function()
			local res = Net.request("ClaimPlaytime")
			if res.ok then
				Sounds.play("Success")
			elseif res.err then
				Notifications.show(res.err, "info")
			end
		end,
	})
	return function()
		local d = ClientState.data
		local left = (d.giftAt or 0) - Lib.serverNow()
		value.Text = "+" .. Format.cash(d.giftReward or 0)
		timer.Text = left > 0 and ("NEXT CRATE IN " .. Format.clock(left)) or "READY TO OPEN"
		claim.Text = left > 0 and "NOT READY" or "OPEN CRATE"
		Lib.setButtonColor(claim, left > 0 and C.Raised or C.Accent)
		claim.TextColor3 = left > 0 and C.Muted or C.OnAccent
	end
end

local function codes(parent: Instance)
	Lib.caption("Redeem a code", { Parent = parent })
	local box = Lib.textbox({ Name = "CodeBox", PlaceholderText = "ENTER CODE", FontFace = Theme.Font.Display, TextSize = 20, Position = UDim2.fromOffset(0, 20), Size = UDim2.new(1, -170, 0, 48), Parent = parent })
	Lib.button({
		Name = "Redeem",
		Variant = "primary",
		Text = "REDEEM",
		TextSize = 15,
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.new(1, 0, 0, 20),
		Size = UDim2.fromOffset(160, 48),
		Parent = parent,
		Activated = function()
			local res = Net.request("RedeemCode", box.Text)
			if res.ok then
				Sounds.play("Success")
				box.Text = ""
			elseif res.err then
				Notifications.show(res.err, "bad")
			end
		end,
	})
	local group = Lib.card({ Position = UDim2.fromOffset(0, 90), Size = UDim2.new(1, 0, 0, 100), Parent = parent }, { Lib.pad(14) })
	local claimed = ClientState.get("groupClaimed") == true
	local hasGroup = (ClientState.get("groupId") or 0) ~= 0
	Lib.display({ Text = "JOIN THE GROUP", TextSize = 17, Size = UDim2.new(1, -170, 0, 22), Parent = group })
	Lib.text({
		Text = hasGroup and ("Join our Roblox group for a free %s and update news."):format(Format.cash(Config.GroupRewardCash)) or "No group reward is set up yet.",
		TextSize = 13,
		TextColor3 = C.Muted,
		TextWrapped = true,
		Position = UDim2.fromOffset(0, 26),
		Size = UDim2.new(1, -170, 0, 40),
		Parent = group,
	})
	Lib.button({
		Name = "ClaimGroup",
		Variant = claimed and "good" or (hasGroup and "primary" or "ghost"),
		Text = claimed and "CLAIMED" or "CLAIM",
		TextSize = 14,
		AnchorPoint = Vector2.new(1, 0.5),
		Position = UDim2.new(1, 0, 0.5, 0),
		Size = UDim2.fromOffset(150, 42),
		Parent = group,
		Activated = function()
			if claimed or not hasGroup then
				return
			end
			local res = Net.request("ClaimGroup")
			if res.ok then
				Sounds.play("Success")
				Modal.close()
			elseif res.err then
				Notifications.show(res.err, "info")
			end
		end,
	})
end

function RewardsUI.open(tab: string?)
	local current = tab or "Daily"
	local win = Modal.open("Rewards", "Daily streak · playtime crates · codes", 820, 420)
	local ic = Icons.gift(34, C.Premium)
	ic.Position = UDim2.fromOffset(9, 7)
	ic.Parent = win.iconHolder
	local tabs = New("Frame", { BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 34), Parent = win.body }, { Lib.list("x", 6) })
	local content = New("Frame", { BackgroundTransparency = 1, Position = UDim2.fromOffset(0, 46), Size = UDim2.new(1, 0, 1, -46), Parent = win.body })
	local ticker: (() -> ())? = nil
	local function render()
		Lib.clear(tabs)
		Lib.clear(content)
		ticker = nil
		for i, t in { "Daily", "Gift", "Codes" } do
			Lib.button({
				Name = t,
				Variant = t == current and "primary" or "secondary",
				Text = string.upper(t),
				TextSize = 13,
				Size = UDim2.fromOffset(120, 34),
				LayoutOrder = i,
				Parent = tabs,
				Activated = function()
					current = t
					render()
				end,
			})
		end
		if current == "Daily" then
			daily(content)
		elseif current == "Gift" then
			local tick = gift(content)
			ticker = tick
			tick()
		else
			codes(content)
		end
	end
	render()
	local acc = 0
	local conn = RunService.Heartbeat:Connect(function(dt)
		acc += dt
		if acc > 0.25 then
			acc = 0
			if ticker then
				ticker()
			end
		end
	end)
	win.onClose(function()
		conn:Disconnect()
	end)
end

function RewardsUI.showWelcome(amount: number, away: number)
	task.wait(2.5)
	local win = Modal.open("Welcome back, commander", "Your nation kept working while you were away", 560, 330)
	local ic = Icons.coin(36, C.Good)
	ic.Position = UDim2.fromOffset(8, 6)
	ic.Parent = win.iconHolder
	Lib.text({ Text = ("You were away for %s"):format(Format.duration(away)), TextColor3 = C.Muted, TextXAlignment = Enum.TextXAlignment.Center, Size = UDim2.new(1, 0, 0, 20), Parent = win.body })
	Lib.display({ Text = "+" .. Format.money(amount), TextSize = 46, TextColor3 = C.Good, TextXAlignment = Enum.TextXAlignment.Center, Position = UDim2.fromOffset(0, 26), Size = UDim2.new(1, 0, 0, 56), Parent = win.body })
	local vip = (ClientState.get("passes") or {}).VIP
	Lib.text({
		Text = vip and "VIP doubled your offline time." or "VIP doubles offline time · 2x Cash doubles the amount",
		TextSize = 13,
		TextColor3 = C.Muted,
		TextXAlignment = Enum.TextXAlignment.Center,
		Position = UDim2.fromOffset(0, 88),
		Size = UDim2.new(1, 0, 0, 18),
		Parent = win.body,
	})
	Lib.button({
		Name = "Collect",
		Variant = "primary",
		Text = "COLLECT",
		TextSize = 16,
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0, 128),
		Size = UDim2.fromOffset(240, 48),
		Parent = win.body,
		Activated = function()
			Sounds.play("Success")
			Modal.close()
		end,
	})
end

function RewardsUI.init()
	Hub.openRewards = RewardsUI.open
	Hub.openDaily = function()
		RewardsUI.open("Daily")
	end
	Hub.openCodes = function()
		RewardsUI.open("Codes")
	end
	Hub.showWelcome = function(amount, away)
		task.spawn(RewardsUI.showWelcome, amount, away)
	end
end

return RewardsUI
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="68">
            <Properties>
              <string name="Name">ShopUI</string>
              <string name="Source"><![CDATA[--[[
	ShopUI - Supply Depot (store)
	Left nav (Featured / Game Passes / Treasury / Boosts), a hero banner with
	a turntable 3D model, pass cards with model art and perk lists, cash packs
	that show their live value (they scale with income) and boosts.
	Prices come live from Roblox; in Studio, buys are granted for testing.
]]

local MarketplaceService = game:GetService("MarketplaceService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Shared = ReplicatedStorage.Shared
local Config = require(Shared.Config)
local Products = require(Shared.Catalog.Products)
local Buildings = require(Shared.Catalog.Buildings)
local ModelBuilder = require(Shared.ModelBuilder)
local Format = require(Shared.Util.Format)
local Net = require(Shared.Net)

local Client = script.Parent.Parent
local ClientState = require(Client.ClientState)
local Hub = require(Client.Hub)
local Lib = require(Client.UI.Lib)
local Theme = require(Client.UI.Theme)
local Icons = require(Client.UI.Icons)
local Modal = require(script.Parent.Modal)
local Notifications = require(script.Parent.Notifications)
local Sounds = require(script.Parent.Sounds)

local New = Lib.New
local C = Theme.Color

local ShopUI = {}

local player = Players.LocalPlayer
local priceCache: { [string]: number } = {}

-- Model shown as card art for each pass.
local PASS_ART = {
	DoubleCash = { icon = "coin" },
	VIP = { icon = "star" },
	FastBuild = { model = "office" },
	EasternPack = { model = "s400" },
	EuropeanPack = { model = "samp_t" },
	ExtraQueue = { model = "large_military_factory" },
	Billboard = { model = "billboard" },
}

local function livePrice(kind: string, id: number, fallback: number): number
	if id == 0 then
		return fallback
	end
	local key = kind .. id
	if priceCache[key] then
		return priceCache[key]
	end
	local ok, info = pcall(function()
		return MarketplaceService:GetProductInfo(id, kind == "pass" and Enum.InfoType.GamePass or Enum.InfoType.Product)
	end)
	if ok and info and info.PriceInRobux then
		priceCache[key] = info.PriceInRobux
		return info.PriceInRobux
	end
	return fallback
end

local function notConfigured()
	Notifications.show("This item isn't on sale yet (add its ID in Shared/Catalog/Products)", "bad")
end

function ShopUI.buyPass(key: string)
	local def = Products.pass(key)
	if not def then
		return
	end
	if (ClientState.get("passes") or {})[key] then
		Notifications.show("You already own " .. def.name, "info")
		return
	end
	if def.id ~= 0 then
		MarketplaceService:PromptGamePassPurchase(player, def.id)
	elseif RunService:IsStudio() and Config.StudioFreePurchases then
		Net.request("StudioPurchase", "pass", key)
	else
		notConfigured()
	end
end

function ShopUI.buyProduct(key: string)
	local def = Products.product(key)
	if not def then
		return
	end
	if def.oneTime and def.kind == "starter" and ClientState.get("starter") then
		Notifications.show("You already bought the Starter Pack", "info")
		return
	end
	if def.id ~= 0 then
		MarketplaceService:PromptProductPurchase(player, def.id)
	elseif RunService:IsStudio() and Config.StudioFreePurchases then
		Net.request("StudioPurchase", "product", key)
	else
		notConfigured()
	end
end

local function cashValue(def): number
	local gross = ClientState.get("gross") or 0
	return math.floor(math.max(def.minCash or 0, gross * ((def.minutes or 10) * 60 / Config.PayInterval)))
end

local function priceButton(price: number, owned: boolean, onClick: () -> (), props: { [string]: any }?): TextButton
	local p = {
		Name = "Buy",
		Variant = owned and "good" or "primary",
		Text = owned and "OWNED" or ("R$ " .. Format.commas(price)),
		TextSize = 15,
		Size = UDim2.new(1, 0, 0, 38),
		Activated = function()
			if not owned then
				Sounds.play("Open")
				onClick()
			end
		end,
	}
	if props then
		for k, v in props do
			p[k] = v
		end
	end
	return Lib.button(p)
end

local function art(parent: Instance, spec, color: Color3, spin: number?)
	local box = Lib.inset({ Size = UDim2.new(1, 0, 0, 96), Parent = parent })
	New("UIGradient", { Color = ColorSequence.new(color:Lerp(C.Ink, 0.55), C.Ink), Rotation = 90, Parent = box })
	if spec and spec.model then
		local def = Buildings.get(spec.model)
		if def then
			Lib.viewport(ModelBuilder.building(def), { Parent = box }, 35, spin)
		end
	else
		local ic = Icons.get(spec and spec.icon or "star", 52, color)
		ic.AnchorPoint = Vector2.new(0.5, 0.5)
		ic.Position = UDim2.fromScale(0.5, 0.5)
		ic.Parent = box
	end
	return box
end

local function passCard(parent: Instance, def, order: number)
	local owned = (ClientState.get("passes") or {})[def.key] == true
	local card = Lib.card({ Name = def.key, LayoutOrder = order, Parent = parent }, { Lib.pad(8) })
	if owned then
		Lib.stroke(C.Good, 1, 0.3).Parent = card
	end
	local a = art(card, PASS_ART[def.key], def.color)
	New("Frame", { BackgroundColor3 = def.color, BorderSizePixel = 0, Position = UDim2.new(0, 0, 1, -3), Size = UDim2.new(1, 0, 0, 3), Parent = a })
	Lib.display({ Text = string.upper(def.name), TextSize = 16, Position = UDim2.fromOffset(4, 104), Size = UDim2.new(1, -8, 0, 20), Parent = card })
	Lib.text({ Text = def.desc, TextSize = 12, TextColor3 = C.Muted, TextWrapped = true, Position = UDim2.fromOffset(4, 124), Size = UDim2.new(1, -8, 0, 30), TextYAlignment = Enum.TextYAlignment.Top, Parent = card })
	local perks = New("Frame", { BackgroundTransparency = 1, Position = UDim2.fromOffset(4, 156), Size = UDim2.new(1, -8, 1, -206), Parent = card }, { Lib.list("y", 3) })
	for i, perk in def.perks do
		local row = New("Frame", { BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 16), LayoutOrder = i, Parent = perks }, { Lib.list("x", 7, nil, Enum.VerticalAlignment.Center) })
		New("Frame", { BackgroundColor3 = C.Accent, Size = UDim2.fromOffset(5, 5), LayoutOrder = 1, Parent = row })
		Lib.text({ Text = perk, TextSize = 12, FontFace = Theme.Font.BodyBold, TextColor3 = C.TextSoft, AutomaticSize = Enum.AutomaticSize.X, Size = UDim2.new(0, 0, 1, 0), LayoutOrder = 2, Parent = row })
	end
	local holder = New("Frame", { BackgroundTransparency = 1, Position = UDim2.new(0, 0, 1, -38), Size = UDim2.new(1, 0, 0, 38), Parent = card })
	priceButton(livePrice("pass", def.id, def.robux), owned, function()
		ShopUI.buyPass(def.key)
	end).Parent = holder
end

local function productCard(parent: Instance, def, order: number, valueText: string?, icon: string?, color: Color3?)
	local card = Lib.card({ Name = def.key, LayoutOrder = order, Parent = parent }, { Lib.pad(10) })
	local col = color or C.Accent
	local ic = Icons.get(icon or "coin", 30, col)
	ic.Position = UDim2.fromOffset(0, 2)
	ic.Parent = card
	if def.tag then
		Lib.chip(def.tag, C.GoldSoft, C.Gold, { AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, 0, 0, 0), Parent = card })
	end
	Lib.display({ Text = string.upper(def.name), TextSize = 15, Position = UDim2.fromOffset(40, 0), Size = UDim2.new(1, -120, 0, 20), Parent = card })
	Lib.text({ Text = def.desc, TextSize = 12, TextColor3 = C.Muted, TextWrapped = true, Position = UDim2.fromOffset(40, 20), Size = UDim2.new(1, -40, 0, 30), TextYAlignment = Enum.TextYAlignment.Top, Parent = card })
	if valueText then
		Lib.display({ Text = valueText, TextSize = 26, TextColor3 = C.Good, Position = UDim2.fromOffset(0, 54), Size = UDim2.new(1, 0, 0, 30), Parent = card })
	end
	local holder = New("Frame", { BackgroundTransparency = 1, Position = UDim2.new(0, 0, 1, -38), Size = UDim2.new(1, 0, 0, 38), Parent = card })
	priceButton(livePrice("product", def.id, def.robux), false, function()
		ShopUI.buyProduct(def.key)
	end).Parent = holder
end

local function hero(parent: Instance, order: number)
	local starter = Products.product("StarterPack")
	local useStarter = starter ~= nil and not ClientState.get("starter")
	local passDef = Products.pass("DoubleCash")
	local banner = New("Frame", {
		Name = "Hero",
		BackgroundColor3 = Color3.new(1, 1, 1),
		Size = UDim2.new(1, -6, 0, 210),
		LayoutOrder = order,
		Parent = parent,
	}, {
		Lib.corner(6),
		New("UIGradient", { Color = ColorSequence.new(Color3.fromRGB(96, 64, 18), Color3.fromRGB(18, 22, 20)), Rotation = 0 }),
		Lib.stroke(C.Accent, 1, 0.3),
	})
	Lib.brackets(banner, C.Accent, 14, 2, 4)
	Lib.hazard({ Size = UDim2.new(0, 220, 0, 5), Parent = banner }, C.Accent, Color3.fromRGB(40, 30, 10), 9)
	local view = New("Frame", { BackgroundTransparency = 1, AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, -10, 0, 0), Size = UDim2.new(0.42, 0, 1, 0), Parent = banner })
	local def = Buildings.get(useStarter and "hypersonic_launcher" or "s400")
	if def then
		Lib.viewport(ModelBuilder.building(def), { Parent = view }, 30, 18)
	end
	local textBox = New("Frame", { BackgroundTransparency = 1, Position = UDim2.fromOffset(22, 18), Size = UDim2.new(0.56, 0, 1, -36), Parent = banner })
	Lib.chip(useStarter and "ONE-TIME OFFER" or "BEST SELLER", C.Accent, C.OnAccent, { Parent = textBox })
	Lib.display({
		Text = useStarter and "STARTER PACK" or "2X CASH · FOREVER",
		TextSize = 34,
		Position = UDim2.fromOffset(0, 28),
		Size = UDim2.new(1, 0, 0, 40),
		Parent = textBox,
	})
	Lib.text({
		Text = useStarter and "$150,000 treasury  ·  10 SRBM missiles  ·  30 min of 2x cash" or "Every pay day doubled. Offline earnings doubled. Stacks with boosts.",
		TextSize = 15,
		FontFace = Theme.Font.BodyBold,
		TextColor3 = C.TextSoft,
		TextWrapped = true,
		Position = UDim2.fromOffset(0, 72),
		Size = UDim2.new(1, 0, 0, 40),
		Parent = textBox,
	})
	Lib.display({
		Text = useStarter and "OVER 10X THE VALUE OF A CASH PACK" or "THE #1 WAY TO GROW FASTER",
		TextSize = 12,
		TextColor3 = C.Gold,
		Position = UDim2.fromOffset(0, 114),
		Size = UDim2.new(1, 0, 0, 16),
		Parent = textBox,
	})
	local price = useStarter and livePrice("product", (starter :: any).id, (starter :: any).robux) or livePrice("pass", passDef and passDef.id or 0, passDef and passDef.robux or 449)
	priceButton(price, false, function()
		if useStarter then
			ShopUI.buyProduct("StarterPack")
		else
			ShopUI.buyPass("DoubleCash")
		end
	end, {
		Name = "HeroBuy",
		Variant = "gold",
		AnchorPoint = Vector2.new(0, 1),
		Position = UDim2.new(0, 0, 1, 0),
		Size = UDim2.fromOffset(220, 46),
		TextSize = 18,
		Parent = textBox,
	})
end

local TABS = {
	{ id = "Featured", label = "FEATURED", icon = "star" },
	{ id = "Passes", label = "GAME PASSES", icon = "shield" },
	{ id = "Cash", label = "TREASURY", icon = "coin" },
	{ id = "Boosts", label = "BOOSTS", icon = "bolt" },
}

local PRODUCT_ICON = {
	boost = { "bolt", C.Good },
	instantBuild = { "hammer", C.Info },
	instantResearch = { "flask", C.Teal },
	supply = { "rocket", C.Military },
	repair = { "shield", C.Gold },
}

function ShopUI.open(tabName: string?)
	local current = tabName or "Featured"
	local win = Modal.open("Supply Depot", "Support the game · grow your nation faster", 1180, 700)
	local ic = Icons.cart(34, C.Gold)
	ic.Position = UDim2.fromOffset(9, 7)
	ic.Parent = win.iconHolder

	local nav = New("Frame", { BackgroundTransparency = 1, Size = UDim2.new(0, 190, 1, 0), Parent = win.body }, { Lib.list("y", 6) })
	local content = Lib.scroll({ Position = UDim2.fromOffset(206, 0), Size = UDim2.new(1, -206, 1, 0), Parent = win.body })

	local render
	local function renderNav()
		Lib.clear(nav)
		for i, t in TABS do
			local active = t.id == current
			local b = Lib.button({
				Name = t.id,
				Size = UDim2.new(1, 0, 0, 46),
				BackgroundColor3 = active and C.AccentSoft or C.Raised,
				LayoutOrder = i,
				Parent = nav,
				Activated = function()
					current = t.id
					renderNav()
					render()
				end,
			}, { Lib.corner(4), Lib.stroke(active and C.Accent or C.LineSoft, 1, active and 0.2 or 0) })
			local icn = Icons.get(t.icon, 18, active and C.Accent or C.TextSoft)
			icn.Position = UDim2.fromOffset(12, 14)
			icn.Parent = b
			Lib.display({ Text = t.label, TextSize = 13, TextColor3 = active and C.Accent or C.Text, Position = UDim2.fromOffset(40, 0), Size = UDim2.new(1, -46, 1, 0), Parent = b })
		end
		local note = Lib.text({
			Text = "Purchases support development. Cash packs scale with your income.",
			TextSize = 11,
			TextColor3 = C.Faint,
			TextWrapped = true,
			Size = UDim2.new(1, 0, 0, 44),
			LayoutOrder = 99,
			Parent = nav,
		})
		local _ = note
	end

	render = function()
		for _, c in content:GetChildren() do
			c:Destroy()
		end
		Lib.list("y", 12).Parent = content
		Lib.pad(0, 6, 8, 0).Parent = content
		local function grid(cellH: number, cols: number, order: number): Frame
			return New("Frame", {
				BackgroundTransparency = 1,
				Size = UDim2.new(1, 0, 0, 0),
				AutomaticSize = Enum.AutomaticSize.Y,
				LayoutOrder = order,
				Parent = content,
			}, { Lib.grid(UDim2.new(1 / cols, -8, 0, cellH), 8) })
		end
		if current == "Featured" then
			hero(content, 1)
			Lib.caption("Most popular", { LayoutOrder = 2, Parent = content })
			local g = grid(290, 3, 3)
			for i, key in { "DoubleCash", "VIP", "FastBuild" } do
				local def = Products.pass(key)
				if def then
					passCard(g, def, i)
				end
			end
			Lib.caption("Quick supplies", { LayoutOrder = 4, Parent = content })
			local g2 = grid(140, 3, 5)
			for i, key in { "Cash3", "Boost2x", "SupplyDrop" } do
				local def = Products.product(key)
				if def then
					local spec = PRODUCT_ICON[def.kind]
					productCard(g2, def, i, def.kind == "cash" and ("+" .. Format.cash(cashValue(def))) or nil, spec and spec[1] or "coin", spec and spec[2] or C.Good)
				end
			end
		elseif current == "Passes" then
			local g = grid(290, 3, 1)
			for i, def in Products.Passes do
				passCard(g, def, i)
			end
		elseif current == "Cash" then
			Lib.text({ Text = "Cash packs scale with your income - the bigger your nation, the more you get.", TextColor3 = C.Muted, TextSize = 13, Size = UDim2.new(1, 0, 0, 18), LayoutOrder = 0, Parent = content })
			local g = grid(150, 2, 1)
			local i = 0
			for _, def in Products.Developer do
				if def.kind == "cash" then
					i += 1
					productCard(g, def, i, "+" .. Format.cash(cashValue(def)), "coin", C.Good)
				end
			end
		else
			local g = grid(140, 3, 1)
			local i = 0
			for _, def in Products.Developer do
				if def.kind ~= "cash" and def.kind ~= "starter" then
					i += 1
					local spec = PRODUCT_ICON[def.kind]
					productCard(g, def, i, nil, spec and spec[1] or "star", spec and spec[2] or C.Accent)
				end
			end
		end
	end

	renderNav()
	render()
	local unsubscribe = ClientState.onAny(function(patch)
		if patch.passes or patch.starter then
			render()
		end
	end)
	win.onClose(unsubscribe)
end

function ShopUI.init()
	Hub.openShop = ShopUI.open
	Hub.buyProduct = ShopUI.buyProduct
	Hub.buyPass = ShopUI.buyPass
	Net.event("PurchaseDone").OnClientEvent:Connect(function()
		Sounds.play("Success")
	end)
	task.spawn(function()
		for _, def in Products.Passes do
			livePrice("pass", def.id, def.robux)
		end
		for _, def in Products.Developer do
			livePrice("product", def.id, def.robux)
		end
	end)
end

return ShopUI
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="69">
            <Properties>
              <string name="Name">Sounds</string>
              <string name="Source"><![CDATA[--[[
	Sounds
	UI and world sounds. Uses sounds that ship with the Roblox client so the
	game works out of the box; swap any id for your own uploaded audio.
]]

local SoundService = game:GetService("SoundService")

local Sounds = {}

Sounds.Ids = {
	Click = "rbxasset://sounds/electronicpingshort.wav",
	Place = "rbxasset://sounds/snap.wav",
	Error = "rbxasset://sounds/clickfast.wav",
	Pay = "rbxasset://sounds/electronicpingshort.wav",
	Success = "rbxasset://sounds/victory.wav",
	Launch = "rbxasset://sounds/Rocket shot.wav",
	Whoosh = "rbxasset://sounds/swoosh.wav",
	Open = "rbxasset://sounds/button.wav",
}

local cache: { [string]: Sound } = {}

function Sounds.get(name: string): Sound
	local s = cache[name]
	if s then
		return s
	end
	local snd = Instance.new("Sound")
	snd.Name = name
	snd.SoundId = Sounds.Ids[name] or ""
	snd.Volume = name == "Click" and 0.25 or 0.5
	snd.Parent = SoundService
	cache[name] = snd
	return snd
end

function Sounds.play(name: string, pitch: number?)
	local s = Sounds.get(name)
	s.PlaybackSpeed = pitch or 1
	s:Play()
end

-- Positional one-shot (explosions, launches).
function Sounds.at(name: string, position: Vector3, volume: number?)
	local holder = Instance.new("Part")
	holder.Anchored = true
	holder.CanCollide = false
	holder.CanQuery = false
	holder.Transparency = 1
	holder.Size = Vector3.one
	holder.Position = position
	holder.Parent = workspace
	local snd = Instance.new("Sound")
	snd.SoundId = Sounds.Ids[name] or ""
	snd.Volume = volume or 0.8
	snd.RollOffMaxDistance = 1500
	snd.Parent = holder
	snd:Play()
	task.delay(6, function()
		holder:Destroy()
	end)
end

return Sounds
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="70">
            <Properties>
              <string name="Name">UnitView</string>
              <string name="Source"><![CDATA[--[[
	UnitView
	Nameplates over every vehicle (navy tag with a role icon and the unit
	name), health bars when damaged, and green selection boxes for the
	units you have selected.
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Units = require(ReplicatedStorage.Shared.Catalog.Units)

local Client = script.Parent.Parent
local Lib = require(Client.UI.Lib)
local Theme = require(Client.UI.Theme)
local Icons = require(Client.UI.Icons)

local New = Lib.New

local UnitView = {}

local player = Players.LocalPlayer
local selected: { [Model]: SelectionBox } = {}
local listeners: { () -> () } = {}

local NAVY = Color3.fromRGB(24, 40, 70)

local function roleIcon(role: string): string
	if role == "Artillery" then
		return "rocket"
	elseif role == "Capture" then
		return "truck"
	elseif role == "Anti-Air" then
		return "target"
	end
	return "tank"
end

local function decorate(model: Model)
	if not model:IsA("Model") or not model:GetAttribute("Unit") then
		return
	end
	local root = model:WaitForChild("Root", 5) :: BasePart?
	if not root then
		return
	end
	local def = Units.get(model:GetAttribute("UnitId") :: string)
	local mine = model:GetAttribute("OwnerId") == player.UserId
	local color = (model:GetAttribute("Color") :: Color3?) or Theme.Color.Accent

	local gui = New("BillboardGui", {
		Name = "Tag",
		Adornee = root,
		Size = UDim2.fromOffset(130, 40),
		StudsOffsetWorldSpace = Vector3.new(0, 5, 0),
		AlwaysOnTop = true,
		MaxDistance = 2600,
		LightInfluence = 0,
		Parent = model,
	})
	local tag = New("Frame", {
		BackgroundColor3 = NAVY,
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.fromScale(0.5, 0),
		Size = UDim2.fromOffset(0, 22),
		AutomaticSize = Enum.AutomaticSize.X,
		Parent = gui,
	}, {
		Lib.corner(5),
		Lib.stroke(Color3.new(1, 1, 1), 1.5, mine and 0 or 0.4),
		Lib.list("x", 6, nil, Enum.VerticalAlignment.Center),
		Lib.pad(0, 8, 0, 3),
	})
	local iconBox = New("Frame", {
		BackgroundColor3 = color,
		Size = UDim2.fromOffset(18, 16),
		LayoutOrder = 1,
		Parent = tag,
	}, { Lib.corner(3) })
	local ic = Icons.get(roleIcon(def and def.role or ""), 14, Color3.new(1, 1, 1))
	ic.AnchorPoint = Vector2.new(0.5, 0.5)
	ic.Position = UDim2.fromScale(0.5, 0.5)
	ic.Parent = iconBox
	Lib.text({
		Text = string.upper(def and def.name or model.Name),
		TextColor3 = Color3.new(1, 1, 1),
		FontFace = Theme.Font.Bold,
		TextSize = 12,
		AutomaticSize = Enum.AutomaticSize.X,
		Size = UDim2.new(0, 0, 1, 0),
		TextTruncate = Enum.TextTruncate.None,
		LayoutOrder = 2,
		Parent = tag,
	})
	local hpBar = Lib.progress({
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0, 26),
		Size = UDim2.fromOffset(70, 4),
		Visible = false,
		Parent = gui,
	})
	local function updateHp()
		local hp = (model:GetAttribute("Hp") :: number?) or 1
		local max = (model:GetAttribute("MaxHp") :: number?) or 1
		hpBar.frame.Visible = hp < max
		hpBar.set(hp / max, hp / max > 0.35 and Theme.Color.Good or Theme.Color.Bad)
	end
	model:GetAttributeChangedSignal("Hp"):Connect(updateHp)
	updateHp()
end

function UnitView.isSelected(model: Model): boolean
	return selected[model] ~= nil
end

function UnitView.select(model: Model, on: boolean)
	if on and not selected[model] then
		selected[model] = New("SelectionBox", {
			Adornee = model,
			Color3 = Color3.fromRGB(90, 230, 130),
			LineThickness = 0.08,
			SurfaceTransparency = 1,
			Parent = model,
		})
	elseif not on and selected[model] then
		selected[model]:Destroy()
		selected[model] = nil
	end
	for _, fn in listeners do
		task.spawn(fn)
	end
end

function UnitView.clear()
	for m, box in selected do
		box:Destroy()
		selected[m] = nil
	end
	for _, fn in listeners do
		task.spawn(fn)
	end
end

function UnitView.selectedUids(): { number }
	local out = {}
	for m in selected do
		if m.Parent then
			table.insert(out, m:GetAttribute("Uid") :: number)
		else
			selected[m] = nil
		end
	end
	return out
end

function UnitView.count(): number
	local c = 0
	for m in selected do
		if m.Parent then
			c += 1
		end
	end
	return c
end

function UnitView.onSelectionChanged(fn: () -> ())
	table.insert(listeners, fn)
end

-- Your own unit models.
function UnitView.mine(): { Model }
	local out = {}
	local folder = workspace:FindFirstChild("Units")
	if folder then
		for _, m in folder:GetChildren() do
			if m:IsA("Model") and m:GetAttribute("OwnerId") == player.UserId then
				table.insert(out, m)
			end
		end
	end
	return out
end

function UnitView.init()
	local folder = workspace:WaitForChild("Units")
	folder.ChildAdded:Connect(function(m)
		task.defer(decorate, m)
	end)
	folder.ChildRemoved:Connect(function(m)
		if selected[m :: Model] then
			selected[m :: Model] = nil
			for _, fn in listeners do
				task.spawn(fn)
			end
		end
	end)
	for _, m in folder:GetChildren() do
		task.spawn(decorate, m)
	end
end

return UnitView
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="71">
            <Properties>
              <string name="Name">WarView</string>
              <string name="Source"><![CDATA[--[[
	WarView
	"Travel" opens the strategic view: a top-down camera over the central
	battlefield (every nation's island rings it, joined by a bridge) or any
	nation. From here you:
	  * pick a weapon in the hotbar (1-7) and click to launch at the reticle
	  * drag a box (or tap) to select your vehicles, right-click / tap to move;
	    they drive over the bridges, and into a rival city with PvP on
	  * watch strategic points ("AIRPORT · UNCAPTURED") and enemy nations
	WASD / arrows pan, scroll / pinch zoom, the hammer button returns home.
]]

local ContextActionService = game:GetService("ContextActionService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")

local Shared = ReplicatedStorage.Shared
local Config = require(Shared.Config)
local Grid = require(Shared.Util.Grid)
local Weapons = require(Shared.Catalog.Weapons)
local ModelBuilder = require(Shared.ModelBuilder)
local Unlocks = require(Shared.Util.Unlocks)
local Flag = require(Shared.Util.Flag)
local Format = require(Shared.Util.Format)
local Net = require(Shared.Net)

local Client = script.Parent.Parent
local ClientState = require(Client.ClientState)
local Hub = require(Client.Hub)
local Lib = require(Client.UI.Lib)
local Theme = require(Client.UI.Theme)
local Icons = require(Client.UI.Icons)
local Modal = require(script.Parent.Modal)
local Notifications = require(script.Parent.Notifications)
local Sounds = require(script.Parent.Sounds)
local UnitView = require(script.Parent.UnitView)

local New = Lib.New
local C = Theme.Color

local WarView = {}

local player = Players.LocalPlayer
local camera = workspace.CurrentCamera

local labelParent: Instance
local hotbar: Frame
local reticle: Frame
local hint: TextLabel
local selectBox: Frame
local blastRing: Part
local pointLabels: { [Instance]: BillboardGui } = {}
local plotLabels: { BillboardGui } = {}

local focus = Vector3.zero
local height = 620
local keys: { [Enum.KeyCode]: boolean } = {}
local selectedWeapon: string? = nil
local pointer = Vector2.zero
local boxStart: Vector2? = nil
local rmbStart: Vector2? = nil
local slots: { [string]: { btn: TextButton, count: TextLabel, sub: TextLabel, reload: Frame, bar: Lib.Progress } } = {}
local readout: { [string]: TextLabel } = {}
local targetLabel: TextLabel
local warOverlay: Frame

local PAN_KEYS = {
	Enum.KeyCode.W,
	Enum.KeyCode.A,
	Enum.KeyCode.S,
	Enum.KeyCode.D,
	Enum.KeyCode.Up,
	Enum.KeyCode.Down,
	Enum.KeyCode.Left,
	Enum.KeyCode.Right,
}

---------------------------------------------------------------------------
-- Helpers
---------------------------------------------------------------------------
local function groundAt(screen: Vector2): Vector3?
	local ray = camera:ScreenPointToRay(screen.X, screen.Y)
	if math.abs(ray.Direction.Y) < 1e-4 then
		return nil
	end
	local t = -ray.Origin.Y / ray.Direction.Y
	if t < 0 then
		return nil
	end
	return ray.Origin + ray.Direction * t
end

local function access(): Unlocks.Access
	return { researched = ClientState.get("researched") or {}, passes = ClientState.get("passes") or {} }
end

local function availableWeapons()
	local out = {}
	local inv = ClientState.get("inventory") or {}
	for _, w in Weapons.all() do
		if Unlocks.check(w, access()) or (inv[w.id] or 0) > 0 then
			table.insert(out, w)
		end
	end
	return out
end

local function unitUnder(screen: Vector2): Model?
	-- generous screen-space pick: closest own unit within 28px
	local best, bestD = nil, 28
	for _, m in UnitView.mine() do
		local root = m.PrimaryPart
		if root then
			local sp, onScreen = camera:WorldToScreenPoint(root.Position)
			if onScreen then
				local d = (Vector2.new(sp.X, sp.Y) - screen).Magnitude
				if d < bestD then
					best, bestD = m, d
				end
			end
		end
	end
	return best
end

---------------------------------------------------------------------------
-- Hotbar
---------------------------------------------------------------------------
local function renderHotbar()
	Lib.clear(hotbar)
	table.clear(slots)
	local list = availableWeapons()
	hotbar.Visible = ClientState.mode == "war" and #list > 0
	for i, w in list do
		local btn = Lib.button({
			Name = w.id,
			Size = UDim2.fromOffset(82, 90),
			BackgroundColor3 = C.Panel,
			BackgroundTransparency = 0.05,
			LayoutOrder = i,
			Parent = hotbar,
			Activated = function()
				WarView.selectWeapon(selectedWeapon ~= w.id and w.id or nil)
			end,
		}, { Lib.corner(4), Lib.stroke(C.Line, 1, 0.3) })
		local art = Lib.inset({ Position = UDim2.fromOffset(5, 18), Size = UDim2.new(1, -10, 0, 40), Parent = btn })
		Lib.viewport(ModelBuilder.projectile(w), { Parent = art }, 90)
		local reload = New("Frame", {
			Name = "Reload",
			BackgroundColor3 = C.Ink,
			BackgroundTransparency = 0.25,
			AnchorPoint = Vector2.new(0, 1),
			Position = UDim2.fromScale(0, 1),
			Size = UDim2.fromScale(1, 0),
			ZIndex = 3,
			Parent = art,
		})
		local count = Lib.display({
			Text = "0",
			TextSize = 15,
			AnchorPoint = Vector2.new(1, 0),
			Position = UDim2.new(1, -6, 0, 1),
			Size = UDim2.fromOffset(44, 16),
			TextXAlignment = Enum.TextXAlignment.Right,
			Parent = btn,
		})
		local sub = Lib.display({
			Text = w.short,
			TextSize = 10,
			TextColor3 = C.Muted,
			Position = UDim2.new(0, 0, 1, -28),
			Size = UDim2.new(1, 0, 0, 12),
			TextXAlignment = Enum.TextXAlignment.Center,
			Parent = btn,
		})
		local bar = Lib.progress({ Segments = 6, Position = UDim2.new(0, 6, 1, -11), Size = UDim2.new(1, -12, 0, 4), Parent = btn })
		Lib.text({ Text = tostring(i), FontFace = Theme.Font.Mono, TextColor3 = C.Accent, TextSize = 11, Position = UDim2.fromOffset(6, 2), Size = UDim2.fromOffset(12, 14), Parent = btn })
		slots[w.id] = { btn = btn, count = count, sub = sub, reload = reload, bar = bar }
	end
	WarView.refreshHotbar()
end

function WarView.refreshHotbar()
	local inv = ClientState.get("inventory") or {}
	local launchers = ClientState.get("launchers") or {}
	local now = Lib.serverNow()
	for id, s in slots do
		local w = Weapons.get(id)
		if w then
			local stock = inv[id] or 0
			s.count.Text = tostring(stock)
			s.count.TextColor3 = stock > 0 and C.Text or C.Bad
			s.bar.set(stock / w.stockCap, C.Accent)
			local l = launchers[w.family]
			local stroke = s.btn:FindFirstChildOfClass("UIStroke") :: UIStroke
			local isSel = selectedWeapon == id
			stroke.Color = isSel and C.Accent or C.Line
			stroke.Transparency = isSel and 0 or 0.3
			stroke.Thickness = isSel and 2 or 1
			Lib.setButtonColor(s.btn, isSel and C.AccentSoft or C.Panel)
			if not l then
				s.sub.Text = "NO LAUNCHER"
				s.sub.TextColor3 = C.Bad
				s.reload.Size = UDim2.fromScale(1, 1)
			elseif l.ready == 0 and l.nextReady > now then
				s.sub.Text = ("RELOAD %ds"):format(math.ceil(l.nextReady - now))
				s.sub.TextColor3 = C.Gold
				s.reload.Size = UDim2.fromScale(1, 0.6)
			else
				s.sub.Text = ("%s · %d/%d READY"):format(w.short, l.ready, l.total)
				s.sub.TextColor3 = C.Muted
				s.reload.Size = UDim2.fromScale(1, 0)
			end
		end
	end
	if selectedWeapon and not slots[selectedWeapon] then
		WarView.selectWeapon(nil)
	end
end

function WarView.selectWeapon(id: string?)
	selectedWeapon = id
	reticle.Visible = id ~= nil
	blastRing.Parent = id and workspace or nil
	if id then
		local w = Weapons.get(id)
		if w then
			local d = w.radius * 2
			blastRing.Size = Vector3.new(0.3, d, d)
		end
		UnitView.clear()
		Sounds.play("Click", 1.3)
	end
	WarView.refreshHotbar()
	WarView.refreshHint()
end

function WarView.refreshHint()
	if selectedWeapon then
		local w = Weapons.get(selectedWeapon)
		hint.Text = ("ARMED: %s  ·  LMB LAUNCH  ·  RMB CANCEL"):format(string.upper(w and w.name or selectedWeapon))
		hint.TextColor3 = C.Accent
	elseif UnitView.count() > 0 then
		hint.Text = ("%d VEHICLES SELECTED  ·  RMB / TAP TO DRIVE THERE  ·  A RIVAL CITY TO INVADE (PVP)  ·  ESC CLEAR"):format(UnitView.count())
		hint.TextColor3 = C.Teal
	else
		hint.Text = "WASD PAN  ·  SCROLL ZOOM  ·  1-7 WEAPONS  ·  DRAG TO SELECT VEHICLES"
		hint.TextColor3 = C.TextSoft
	end
	if readout.sel then
		readout.sel.Text = ("%d SELECTED"):format(UnitView.count())
	end
end

---------------------------------------------------------------------------
-- Labels for strategic points and nations
---------------------------------------------------------------------------
local function makePointLabel(point: Model)
	if pointLabels[point] then
		return
	end
	local base = point:WaitForChild("Base", 5) :: BasePart?
	if not base then
		return
	end
	local bb = New("BillboardGui", {
		Name = "PointLabel",
		Adornee = base,
		Size = UDim2.fromOffset(250, 74),
		StudsOffsetWorldSpace = Vector3.new(0, 28, 0),
		AlwaysOnTop = true,
		MaxDistance = 6000,
		LightInfluence = 0,
		Enabled = false,
		Parent = labelParent,
	})
	local tag = New("Frame", {
		BackgroundColor3 = C.Panel,
		BackgroundTransparency = 0.12,
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.fromScale(0.5, 0),
		Size = UDim2.fromOffset(240, 64),
		Parent = bb,
	}, { Lib.corner(3), Lib.stroke(C.Line, 1, 0.3), Lib.pad(6, 10) })
	local stripe = New("Frame", { BackgroundColor3 = C.Muted, BorderSizePixel = 0, Position = UDim2.new(0, -10, 0, -6), Size = UDim2.new(0, 3, 1, 12), Parent = tag })
	local title = Lib.display({ Name = "Title", Text = "", TextSize = 14, Size = UDim2.new(1, 0, 0, 16), Parent = tag })
	local status = Lib.display({ Name = "Status", Text = "", TextSize = 11, TextColor3 = C.Muted, Position = UDim2.fromOffset(0, 17), Size = UDim2.new(1, 0, 0, 13), Parent = tag })
	local bonus = Lib.text({ Name = "Bonus", Text = "", FontFace = Theme.Font.BodyBold, TextSize = 11, TextColor3 = C.Good, Position = UDim2.fromOffset(0, 30), Size = UDim2.new(1, 0, 0, 13), Parent = tag })
	local garrison = Lib.progress({ Segments = 10, Position = UDim2.fromOffset(0, 46), Size = UDim2.new(1, 0, 0, 4), Parent = tag })
	local capture = Lib.progress({ Position = UDim2.fromOffset(0, 52), Size = UDim2.new(1, 0, 0, 3), Parent = tag })
	local function update()
		local owner = (point:GetAttribute("Owner") :: number?) or 0
		local ownerName = (point:GetAttribute("OwnerName") :: string?) or ""
		local name = (point:GetAttribute("PointName") :: string?) or point.Name
		local st
		local col
		if owner == 0 then
			st, col = "UNCAPTURED", C.Muted
		elseif owner == player.UserId then
			st, col = "HELD BY YOU", C.Good
		else
			st, col = "HELD BY " .. string.upper(ownerName), (point:GetAttribute("Color") :: Color3?) or C.Bad
		end
		if point:GetAttribute("Contested") then
			st ..= "  ·  CONTESTED"
			col = C.Gold
		end
		title.Text = name
		status.Text = st
		status.TextColor3 = col
		stripe.BackgroundColor3 = col
		local g = (point:GetAttribute("Garrison") :: number?) or 0
		local gm = (point:GetAttribute("MaxGarrison") :: number?) or 1
		garrison.set(g / gm, C.Bad)
		local c = (point:GetAttribute("Capture") :: number?) or 0
		capture.frame.Visible = c > 0
		capture.set(c / 100, C.Good)
		bonus.Text = (("%s  ·  GARRISON %d"):format(string.upper((point:GetAttribute("Bonus") :: string?) or ""), g))
	end
	point.AttributeChanged:Connect(update)
	update()
	pointLabels[point] = bb
end

local function makePlotLabels()
	local homeland = workspace:WaitForChild("Homeland")
	for i = 1, Config.MaxPlots do
		local plot = homeland:WaitForChild("Plot_" .. i, 10)
		if plot then
			local ground = plot:FindFirstChild("Ground") :: BasePart?
			local bb = New("BillboardGui", {
				Name = "NationLabel",
				Adornee = ground,
				Size = UDim2.fromOffset(300, 46),
				StudsOffsetWorldSpace = Vector3.new(0, 70, 0),
				AlwaysOnTop = true,
				MaxDistance = 8000,
				LightInfluence = 0,
				Enabled = false,
				Parent = labelParent,
			})
			local tag = New("Frame", {
				BackgroundColor3 = C.Panel,
				BackgroundTransparency = 0.12,
				AnchorPoint = Vector2.new(0.5, 0),
				Position = UDim2.fromScale(0.5, 0),
				Size = UDim2.fromOffset(280, 42),
				Visible = false,
				Parent = bb,
			}, { Lib.corner(3), Lib.stroke(C.Line, 1, 0.3) })
			local flagBox = New("Frame", { BackgroundTransparency = 1, Position = UDim2.fromOffset(6, 6), Size = UDim2.fromOffset(45, 30), Parent = tag })
			local name = Lib.display({ Text = "", TextSize = 14, Position = UDim2.fromOffset(60, 4), Size = UDim2.new(1, -66, 0, 18), Parent = tag })
			local sub = Lib.display({ Text = "", TextSize = 11, Position = UDim2.fromOffset(60, 22), Size = UDim2.new(1, -66, 0, 14), Parent = tag })
			local lastFlag = ""
			local function update()
				local owner = plot:GetAttribute("OwnerId") :: number?
				local p = owner and Players:GetPlayerByUserId(owner)
				if not p then
					tag.Visible = false
					return
				end
				tag.Visible = true
				local flag = (p:GetAttribute("NationFlag") :: string?) or ""
				if flag ~= lastFlag then
					lastFlag = flag
					Lib.clear(flagBox)
					Flag.draw(flagBox, flag ~= "" and flag or nil)
				end
				local pvp = p:GetAttribute("Pvp") == true
				name.Text = string.upper((p:GetAttribute("NationName") :: string?) or (p.DisplayName .. "'s nation"))
				sub.Text = (p == player and "YOUR NATION  ·  " or ("COMMANDER " .. string.upper(p.DisplayName) .. "  ·  ")) .. (pvp and "PVP ON" or "PVP OFF")
				sub.TextColor3 = pvp and C.Bad or C.Muted
			end
			plot:GetAttributeChangedSignal("OwnerId"):Connect(update)
			task.spawn(function()
				while bb.Parent do
					update()
					task.wait(2)
				end
			end)
			table.insert(plotLabels, bb)
		end
	end
end

local function setLabels(on: boolean)
	for _, bb in pointLabels do
		bb.Enabled = on
	end
	for _, bb in plotLabels do
		bb.Enabled = on
	end
end

---------------------------------------------------------------------------
-- Camera
---------------------------------------------------------------------------
local function panHandler(_action: string, state: Enum.UserInputState, input: InputObject): Enum.ContextActionResult
	keys[input.KeyCode] = state == Enum.UserInputState.Begin or state == Enum.UserInputState.Change
	return Enum.ContextActionResult.Sink
end

-- What sits under the reticle: a strategic point, a nation, or open ground.
local function describeTarget(hit: Vector3): string
	for point, _ in pointLabels do
		local base = point:FindFirstChild("Base") :: BasePart?
		local bp = base and base.CFrame.Position
		if bp and (Vector3.new(bp.X, 0, bp.Z) - Vector3.new(hit.X, 0, hit.Z)).Magnitude < 110 then
			return string.upper(((point:GetAttribute("PointName") :: string?) or point.Name))
		end
	end
	for i = 1, Config.MaxPlots do
		if Grid.insidePlot(i, hit) then
			for _, p in Players:GetPlayers() do
				if p:GetAttribute("PlotIndex") == i then
					return string.upper((p:GetAttribute("NationName") :: string?) or p.DisplayName) .. (p == player and "  ·  OWN TERRITORY" or "")
				end
			end
			return "UNCLAIMED LAND"
		end
	end
	return ("GRID %04d·%04d"):format(math.floor(hit.X + 5000), math.floor(hit.Z + 5000))
end

local function updateCamera(dt: number)
	if ClientState.mode ~= "war" then
		return
	end
	local move = Vector3.zero
	if keys[Enum.KeyCode.W] or keys[Enum.KeyCode.Up] then
		move += Vector3.new(0, 0, -1)
	end
	if keys[Enum.KeyCode.S] or keys[Enum.KeyCode.Down] then
		move += Vector3.new(0, 0, 1)
	end
	if keys[Enum.KeyCode.A] or keys[Enum.KeyCode.Left] then
		move += Vector3.new(-1, 0, 0)
	end
	if keys[Enum.KeyCode.D] or keys[Enum.KeyCode.Right] then
		move += Vector3.new(1, 0, 0)
	end
	if move.Magnitude > 0 then
		focus += move.Unit * height * 1.3 * dt
	end
	local o = Config.MainlandOrigin
	focus = Vector3.new(math.clamp(focus.X, o.X - 2100, o.X + 2100), 0, math.clamp(focus.Z, o.Z - 2100, o.Z + 2100))
	local target = CFrame.lookAt(focus + Vector3.new(0, height, height * 0.22), focus)
	camera.CFrame = camera.CFrame:Lerp(target, math.min(1, dt * 10))

	readout.grid.Text = ("GRID %04d·%04d   ALT %dm"):format(math.floor(focus.X + 5000), math.floor(focus.Z + 5000), math.floor(height))

	-- reticle + blast ring + target readout
	if selectedWeapon then
		reticle.Position = UDim2.fromOffset(pointer.X, pointer.Y)
		local hit = groundAt(pointer)
		if hit then
			blastRing.CFrame = CFrame.new(hit.X, 0.3, hit.Z) * CFrame.Angles(0, 0, math.rad(90))
			targetLabel.Text = describeTarget(hit)
		end
	end
end

function WarView.go(target: string | number)
	Modal.close()
	Hub.call("closeBuild")
	if target == "mainland" then
		focus = Config.MainlandOrigin
		height = 1500
	elseif type(target) == "number" then
		focus = Grid.plotOrigin(target)
		height = 520
	end
	if ClientState.mode ~= "war" then
		ClientState.setMode("war")
		camera.CameraType = Enum.CameraType.Scriptable
		ContextActionService:BindActionAtPriority("WarPan", panHandler, false, Enum.ContextActionPriority.High.Value + 10, table.unpack(PAN_KEYS))
		camera.CFrame = CFrame.lookAt(focus + Vector3.new(0, height, height * 0.22), focus)
	end
	if target == "mainland" then
		readout.theater.Text = "CENTRAL FRONT"
	elseif type(target) == "number" then
		local name = "UNCLAIMED LAND"
		for _, p in Players:GetPlayers() do
			if p:GetAttribute("PlotIndex") == target then
				name = string.upper((p:GetAttribute("NationName") :: string?) or (p.DisplayName .. "'s nation"))
			end
		end
		readout.theater.Text = name
	end
	setLabels(true)
	renderHotbar()
	WarView.refreshHint()
	hint.Visible = true
	Sounds.play("Whoosh")
end

function WarView.goHome()
	if ClientState.mode ~= "war" then
		return
	end
	ContextActionService:UnbindAction("WarPan")
	table.clear(keys)
	WarView.selectWeapon(nil)
	UnitView.clear()
	setLabels(false)
	hotbar.Visible = false
	hint.Visible = false
	selectBox.Visible = false
	camera.CameraType = Enum.CameraType.Custom
	local hum = player.Character and player.Character:FindFirstChildOfClass("Humanoid")
	if hum then
		camera.CameraSubject = hum
	end
	ClientState.setMode("play")
end

---------------------------------------------------------------------------
-- Travel menu
---------------------------------------------------------------------------
function WarView.openTravel()
	local win = Modal.open("Theater Select", "Pick a theater. Launch strikes and command vehicles from the map.", 820, 560)
	local ic = Icons.map(36, C.Accent)
	ic.Position = UDim2.fromOffset(8, 6)
	ic.Parent = win.iconHolder

	-- left: fixed theaters
	local left = New("Frame", { BackgroundTransparency = 1, Size = UDim2.new(0, 300, 1, 0), Parent = win.body }, { Lib.list("y", 10) })
	local function theater(name: string, order: number, h: number, title: string, sub: string, accent: Color3, onClick: () -> ()): TextButton
		local btn = Lib.button({
			Name = name,
			BackgroundColor3 = C.Raised,
			Size = UDim2.new(1, 0, 0, h),
			LayoutOrder = order,
			Parent = left,
			Activated = onClick,
		}, { Lib.corner(Theme.Radius.Card), Lib.stroke(accent, 1, 0.55) })
		New("Frame", { BackgroundColor3 = accent, BorderSizePixel = 0, Size = UDim2.new(0, 3, 1, 0), Parent = btn })
		Lib.display({ Text = string.upper(title), TextSize = 17, Position = UDim2.fromOffset(16, 10), Size = UDim2.new(1, -28, 0, 20), Parent = btn })
		Lib.text({
			Text = sub,
			TextSize = 12,
			TextColor3 = C.Muted,
			TextWrapped = true,
			TextYAlignment = Enum.TextYAlignment.Top,
			Position = UDim2.fromOffset(16, 32),
			Size = UDim2.new(1, -28, 0, 30),
			Parent = btn,
		})
		return btn
	end

	local held, total = 0, 0
	local mainland = workspace:FindFirstChild("Mainland")
	local points = mainland and mainland:FindFirstChild("Points")
	if points then
		for _, p in points:GetChildren() do
			total += 1
			if p:GetAttribute("Owner") == player.UserId then
				held += 1
			end
		end
	end
	local deployed = 0
	for _, m in UnitView.mine() do
		if (m:GetAttribute("Location") or "home") ~= "home" then
			deployed += 1
		end
	end
	local war = theater("Mainland", 1, 170, "Central front", "The battlefield every nation's bridge leads to. Capture points for permanent bonuses.", C.Bad, function()
		WarView.go("mainland")
	end)
	Lib.hazard({ AnchorPoint = Vector2.new(0, 1), Position = UDim2.new(0, 3, 1, 0), Size = UDim2.new(1, -3, 0, 5), Parent = war }, C.Bad, C.Raised, 9)
	Lib.chip("WARZONE", C.BadSoft, C.Bad, { AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, -10, 0, 10), Parent = war })
	Lib.caption("Points held", { Position = UDim2.fromOffset(16, 80), Size = UDim2.fromOffset(120, 14), Parent = war })
	Lib.display({ Text = ("%d / %d"):format(held, total), TextSize = 26, TextColor3 = held > 0 and C.Good or C.Text, Position = UDim2.fromOffset(16, 96), Size = UDim2.fromOffset(140, 30), Parent = war })
	Lib.caption("Deployed", { Position = UDim2.fromOffset(160, 80), Size = UDim2.fromOffset(120, 14), Parent = war })
	Lib.display({ Text = tostring(deployed), TextSize = 26, Position = UDim2.fromOffset(160, 96), Size = UDim2.fromOffset(120, 30), Parent = war })

	theater("Overview", 2, 74, "Your nation · overview", "Command vehicles and watch your city from above.", C.Accent, function()
		WarView.go(ClientState.get("plot") or 1)
	end)
	theater("Walk", 3, 74, "Your nation · on foot", "Back to your commander.", C.Teal, function()
		Modal.close()
		WarView.goHome()
	end)

	-- right: rival nations
	local right = Lib.inset({ Position = UDim2.fromOffset(316, 0), Size = UDim2.new(1, -316, 1, 0), Parent = win.body }, { Lib.pad(12) })
	Lib.caption("Rival nations", { TextColor3 = C.Accent, Parent = right })
	local list = Lib.scroll({ Name = "Nations", Position = UDim2.fromOffset(0, 22), Size = UDim2.new(1, 0, 1, -22), Parent = right }, { Lib.list("y", 8) })
	local count = 0
	for _, p in Players:GetPlayers() do
		local idx = p:GetAttribute("PlotIndex") :: number?
		if p ~= player and idx then
			count += 1
			local pvp = p:GetAttribute("Pvp") == true
			local row = Lib.card({ Name = "Nation_" .. p.UserId, Size = UDim2.new(1, -8, 0, 64), LayoutOrder = pvp and count or 100 + count, Parent = list })
			local flagBox = New("Frame", { BackgroundTransparency = 1, Position = UDim2.fromOffset(10, 12), Size = UDim2.fromOffset(60, 40), Parent = row }, { Lib.stroke(C.Line, 1, 0.3) })
			Flag.draw(flagBox, p:GetAttribute("NationFlag") :: string?)
			Lib.display({
				Text = string.upper((p:GetAttribute("NationName") :: string?) or (p.DisplayName .. "'s nation")),
				TextSize = 15,
				Position = UDim2.fromOffset(82, 11),
				Size = UDim2.new(1, -250, 0, 18),
				Parent = row,
			})
			Lib.text({
				Text = ("Cmdr %s  ·  %s  ·  Power %s"):format(p.DisplayName, (p:GetAttribute("RankName") :: string?) or "Outpost", Format.short((p:GetAttribute("Power") :: number?) or 0)),
				TextSize = 12,
				TextColor3 = C.Muted,
				Position = UDim2.fromOffset(82, 32),
				Size = UDim2.new(1, -250, 0, 16),
				Parent = row,
			})
			Lib.chip(pvp and "PVP ON" or "PVP OFF", pvp and C.BadSoft or C.Inset, pvp and C.Bad or C.Muted, {
				AnchorPoint = Vector2.new(1, 0.5),
				Position = UDim2.new(1, -92, 0.5, 0),
				Parent = row,
			})
			Lib.button({
				Name = "View",
				Variant = pvp and "danger" or "secondary",
				Text = "VIEW",
				AnchorPoint = Vector2.new(1, 0.5),
				Position = UDim2.new(1, -10, 0.5, 0),
				Size = UDim2.fromOffset(72, 34),
				Parent = row,
				Activated = function()
					WarView.go(idx)
				end,
			})
		end
	end
	if count == 0 then
		Lib.text({
			Name = "Empty",
			Text = "No other nations on this server yet. The central front is still yours to take.",
			TextWrapped = true,
			TextColor3 = C.Muted,
			Size = UDim2.new(1, -8, 0, 40),
			Parent = list,
		})
	end
end

---------------------------------------------------------------------------
-- Input
---------------------------------------------------------------------------
local function launchAt(screen: Vector2)
	local id = selectedWeapon
	local hit = groundAt(screen)
	if not id or not hit then
		return
	end
	local res = Net.request("LaunchWeapon", id, hit)
	if res.ok then
		Sounds.play("Launch")
	elseif res.err then
		Notifications.show(res.err, "bad")
	end
end

local function commandAt(screen: Vector2)
	local uids = UnitView.selectedUids()
	local hit = groundAt(screen)
	if #uids == 0 or not hit then
		return
	end
	local res = Net.request("CommandUnits", uids, hit)
	if res.ok then
		Sounds.play("Click", 0.9)
		Hub.call("moveMarker", hit)
	elseif res.err then
		Notifications.show(res.err, "bad")
	end
end

local function finishBox(endPos: Vector2, additive: boolean)
	local start = boxStart
	boxStart = nil
	selectBox.Visible = false
	if not start then
		return
	end
	if (endPos - start).Magnitude < 6 then
		local unit = unitUnder(endPos)
		if unit then
			if not additive then
				UnitView.clear()
			end
			UnitView.select(unit, not UnitView.isSelected(unit))
		elseif UnitView.count() > 0 and UserInputService.TouchEnabled then
			commandAt(endPos) -- tap ground to move on touch devices
		else
			UnitView.clear()
		end
	else
		if not additive then
			UnitView.clear()
		end
		local minV = Vector2.new(math.min(start.X, endPos.X), math.min(start.Y, endPos.Y))
		local maxV = Vector2.new(math.max(start.X, endPos.X), math.max(start.Y, endPos.Y))
		for _, m in UnitView.mine() do
			local root = m.PrimaryPart
			if root then
				-- WorldToScreenPoint is in GUI space, same as InputObject.Position
				local sp, onScreen = camera:WorldToScreenPoint(root.Position)
				local p = Vector2.new(sp.X, sp.Y)
				if onScreen and p.X >= minV.X and p.X <= maxV.X and p.Y >= minV.Y and p.Y <= maxV.Y then
					UnitView.select(m, true)
				end
			end
		end
	end
	WarView.refreshHint()
end

local function onInputBegan(input: InputObject, processed: boolean)
	if ClientState.mode ~= "war" then
		return
	end
	local t = input.UserInputType
	if t == Enum.UserInputType.MouseButton1 or t == Enum.UserInputType.Touch then
		pointer = Vector2.new(input.Position.X, input.Position.Y)
		if processed then
			return
		end
		if selectedWeapon then
			launchAt(pointer)
		else
			boxStart = pointer
		end
	elseif t == Enum.UserInputType.MouseButton2 then
		rmbStart = Vector2.new(input.Position.X, input.Position.Y)
	elseif not processed and t == Enum.UserInputType.Keyboard then
		local n = input.KeyCode.Value - Enum.KeyCode.One.Value + 1
		if n >= 1 and n <= 9 then
			local list = availableWeapons()
			local w = list[n]
			if w then
				WarView.selectWeapon(selectedWeapon ~= w.id and w.id or nil)
			end
		elseif input.KeyCode == Enum.KeyCode.Escape then
			WarView.selectWeapon(nil)
			UnitView.clear()
			WarView.refreshHint()
		end
	end
end

local function onInputChanged(input: InputObject)
	if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then
		pointer = Vector2.new(input.Position.X, input.Position.Y)
		if boxStart and ClientState.mode == "war" and input.UserInputType == Enum.UserInputType.MouseMovement then
			local minV = Vector2.new(math.min(boxStart.X, pointer.X), math.min(boxStart.Y, pointer.Y))
			local size = Vector2.new(math.abs(pointer.X - boxStart.X), math.abs(pointer.Y - boxStart.Y))
			selectBox.Visible = size.Magnitude > 6
			selectBox.Position = UDim2.fromOffset(minV.X, minV.Y)
			selectBox.Size = UDim2.fromOffset(size.X, size.Y)
		end
	elseif input.UserInputType == Enum.UserInputType.MouseWheel and ClientState.mode == "war" then
		height = math.clamp(height * (1 - input.Position.Z * 0.12), 120, 2800)
	end
end

local function onInputEnded(input: InputObject)
	if ClientState.mode ~= "war" then
		return
	end
	local t = input.UserInputType
	local pos = Vector2.new(input.Position.X, input.Position.Y)
	if t == Enum.UserInputType.MouseButton1 or t == Enum.UserInputType.Touch then
		if boxStart then
			finishBox(pos, UserInputService:IsKeyDown(Enum.KeyCode.LeftShift))
		end
	elseif t == Enum.UserInputType.MouseButton2 and rmbStart then
		if (pos - rmbStart).Magnitude < 8 then
			if selectedWeapon then
				WarView.selectWeapon(nil)
			else
				commandAt(pos)
			end
		end
		rmbStart = nil
	end
end

---------------------------------------------------------------------------
-- Init
---------------------------------------------------------------------------
function WarView.init(screen: GuiObject)
	labelParent = player:WaitForChild("PlayerGui")

	-- strategic-view frame: vignette + screen brackets, drawn beneath the HUD
	warOverlay = New("Frame", {
		Name = "WarOverlay",
		BackgroundTransparency = 1,
		Size = UDim2.fromScale(1, 1),
		ZIndex = 0,
		Visible = false,
		Parent = screen,
	})
	for _, e in { { 0, 0, 1, 0, 90 }, { 0, 1, 1, 0, -90 }, { 0, 0, 0, 1, 0 }, { 1, 0, 0, 1, 180 } } do
		local horizontal = e[3] == 1
		New("Frame", {
			BackgroundColor3 = Color3.fromRGB(4, 8, 6),
			BorderSizePixel = 0,
			AnchorPoint = Vector2.new(e[1], e[2]),
			Position = UDim2.fromScale(e[1], e[2]),
			Size = horizontal and UDim2.new(1, 0, 0, 140) or UDim2.new(0, 220, 1, 0),
			ZIndex = 0,
			Parent = warOverlay,
		}, {
			New("UIGradient", {
				Rotation = e[5],
				Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.35), NumberSequenceKeypoint.new(1, 1) }),
			}),
		})
	end
	local frameInset = New("Frame", { BackgroundTransparency = 1, Position = UDim2.fromOffset(8, 8), Size = UDim2.new(1, -16, 1, -16), ZIndex = 0, Parent = warOverlay })
	Lib.brackets(frameInset, C.Accent, 34, 2, 0)

	-- theater readout (takes the mission card's slot while in war mode)
	local panel = Lib.panel({
		Name = "Theater",
		Position = UDim2.fromOffset(16, 104),
		Size = UDim2.fromOffset(300, 104),
		Parent = warOverlay,
	}, { Lib.pad(10, 14) })
	Lib.caption("Theater", { TextColor3 = C.Accent, Parent = panel })
	readout.theater = Lib.display({ Name = "Name", Text = "CENTRAL FRONT", TextSize = 20, Position = UDim2.fromOffset(0, 16), Size = UDim2.new(1, 0, 0, 24), Parent = panel })
	readout.grid = Lib.text({ Name = "Grid", Text = "", FontFace = Theme.Font.Mono, TextSize = 12, TextColor3 = C.Muted, Position = UDim2.fromOffset(0, 44), Size = UDim2.new(1, 0, 0, 16), Parent = panel })
	readout.sel = Lib.display({ Name = "Selected", Text = "0 SELECTED", TextSize = 12, TextColor3 = C.Teal, Position = UDim2.fromOffset(0, 64), Size = UDim2.new(1, 0, 0, 16), Parent = panel })

	hotbar = New("Frame", {
		Name = "Hotbar",
		AnchorPoint = Vector2.new(0.5, 1),
		Position = UDim2.new(0.5, 0, 1, -112),
		Size = UDim2.fromOffset(760, 90),
		BackgroundTransparency = 1,
		Visible = false,
		Parent = screen,
	}, { Lib.list("x", 6, Enum.HorizontalAlignment.Center) })

	-- targeting reticle: brackets, crosshair ticks and a live target readout
	reticle = New("Frame", {
		Name = "Reticle",
		AnchorPoint = Vector2.new(0.5, 0.5),
		Size = UDim2.fromOffset(52, 52),
		BackgroundTransparency = 1,
		Visible = false,
		Parent = screen,
	})
	Lib.brackets(reticle, C.Accent, 13, 2, 0)
	for _, t in { { 0.5, 0, 2, 9 }, { 0.5, 1, 2, 9 }, { 0, 0.5, 9, 2 }, { 1, 0.5, 9, 2 } } do
		New("Frame", {
			BackgroundColor3 = C.Accent,
			BorderSizePixel = 0,
			AnchorPoint = Vector2.new(t[1], t[2]),
			Position = UDim2.new(t[1], t[1] == 0.5 and 0 or (t[1] == 0 and 13 or -13), t[2], t[2] == 0.5 and 0 or (t[2] == 0 and 13 or -13)),
			Size = UDim2.fromOffset(t[3], t[4]),
			Parent = reticle,
		})
	end
	New("Frame", { BackgroundColor3 = C.Accent, AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5), Size = UDim2.fromOffset(4, 4), Parent = reticle }, { Lib.round() })
	targetLabel = Lib.display({
		Name = "Target",
		Text = "",
		TextSize = 11,
		TextColor3 = C.Accent,
		TextStrokeTransparency = 0.4,
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 1, 6),
		Size = UDim2.fromOffset(240, 14),
		TextXAlignment = Enum.TextXAlignment.Center,
		Parent = reticle,
	})

	selectBox = New("Frame", {
		Name = "SelectBox",
		BackgroundColor3 = C.Teal,
		BackgroundTransparency = 0.88,
		Visible = false,
		Parent = screen,
	}, { Lib.stroke(C.Teal, 1, 0.1) })

	hint = Lib.display({
		Name = "Hint",
		Text = "",
		AnchorPoint = Vector2.new(0.5, 1),
		Position = UDim2.new(0.5, 0, 1, -210),
		Size = UDim2.fromOffset(760, 18),
		TextColor3 = C.TextSoft,
		TextStrokeTransparency = 0.55,
		TextSize = 13,
		TextXAlignment = Enum.TextXAlignment.Center,
		Visible = false,
		Parent = screen,
	})

	blastRing = Instance.new("Part")
	blastRing.Name = "BlastRing"
	blastRing.Shape = Enum.PartType.Cylinder
	blastRing.Anchored = true
	blastRing.CanCollide = false
	blastRing.CanQuery = false
	blastRing.CanTouch = false
	blastRing.Material = Enum.Material.Neon
	blastRing.Color = C.Accent
	blastRing.Transparency = 0.72
	blastRing.CastShadow = false

	UserInputService.InputBegan:Connect(onInputBegan)
	UserInputService.InputChanged:Connect(onInputChanged)
	UserInputService.InputEnded:Connect(onInputEnded)
	UserInputService.TouchPinch:Connect(function(_positions, scale, _velocity, state)
		if ClientState.mode == "war" and state == Enum.UserInputState.Change then
			height = math.clamp(height / math.max(0.5, scale ^ 0.05), 120, 2800)
		end
	end)
	UserInputService.TouchPan:Connect(function(_positions, _translation, velocity, state)
		if ClientState.mode == "war" and not selectedWeapon and state == Enum.UserInputState.Change then
			boxStart = nil
			focus -= Vector3.new(velocity.X, 0, velocity.Y) * height * 0.00035
		end
	end)
	RunService.RenderStepped:Connect(updateCamera)

	ClientState.onAny(function(patch)
		if ClientState.mode ~= "war" then
			return
		end
		if patch.researched or patch.passes then
			renderHotbar()
		elseif patch.inventory or patch.launchers then
			WarView.refreshHotbar()
		end
	end)
	ClientState.onMode(function(mode)
		warOverlay.Visible = mode == "war"
	end)
	task.spawn(function()
		while true do
			task.wait(0.5)
			if ClientState.mode == "war" then
				WarView.refreshHotbar()
			end
		end
	end)
	UnitView.onSelectionChanged(WarView.refreshHint)

	-- labels
	task.spawn(function()
		local mainland = workspace:WaitForChild("Mainland")
		local points = mainland:WaitForChild("Points")
		for _, p in points:GetChildren() do
			task.spawn(makePointLabel, p :: Model)
		end
		points.ChildAdded:Connect(function(p)
			makePointLabel(p :: Model)
		end)
	end)
	task.spawn(makePlotLabels)

	Hub.openTravel = WarView.openTravel
	Hub.goWar = WarView.go
	Hub.goHome = WarView.goHome
end

return WarView
]]></string>
            </Properties>
          </Item>
        </Item>
        <Item class="ModuleScript" referent="72">
          <Properties>
            <string name="Name">Hub</string>
            <string name="Source"><![CDATA[--[[
	Hub
	A tiny registry so controllers can open each other's windows without
	requiring each other (avoids circular requires). Controllers assign
	functions here during init, e.g. Hub.openShop = function() ... end.
]]

local Hub: { [string]: any } = {}

function Hub.call(name: string, ...: any)
	local fn = Hub[name]
	if type(fn) == "function" then
		fn(...)
	else
		warn("[Hub] nothing registered for " .. name)
	end
end

return Hub
]]></string>
          </Properties>
        </Item>
        <Item class="LocalScript" referent="73">
          <Properties>
            <string name="Name">Main</string>
            <string name="Source"><![CDATA[--[[
	Forge & Frontline - client bootstrap.
	Creates the UI layers (auto-scaled from a 1600x900 design to any screen),
	then starts every controller.
]]

local Players = game:GetService("Players")
local TextChatService = game:GetService("TextChatService")

local Client = script.Parent
local Controllers = Client.Controllers
local ClientState = require(Client.ClientState)
local Lib = require(Client.UI.Lib)

local player = Players.LocalPlayer
local playerGui = player:WaitForChild("PlayerGui")
local camera = workspace.CurrentCamera

local DESIGN = Vector2.new(1600, 900)

-- One ScreenGui per layer, each with a scaled root frame so every
-- controller can lay out in "design pixels".
local roots: { Frame } = {}
local scales: { UIScale } = {}

local function layer(name: string, order: number): Frame
	local gui = Instance.new("ScreenGui")
	gui.Name = name
	gui.ResetOnSpawn = false
	gui.DisplayOrder = order
	gui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
	gui.Parent = playerGui
	local root = Instance.new("Frame")
	root.Name = "Root"
	root.BackgroundTransparency = 1
	root.Size = UDim2.fromScale(1, 1)
	root.Parent = gui
	local scale = Instance.new("UIScale")
	scale.Parent = root
	table.insert(roots, root)
	table.insert(scales, scale)
	return root
end

local hudLayer = layer("FF_HUD", 1)
local buildLayer = layer("FF_Build", 2)
local modalLayer = layer("FF_Modal", 5)
local toastLayer = layer("FF_Toasts", 8)

local function rescale()
	local vp = camera.ViewportSize
	local s = math.clamp(math.min(vp.X / DESIGN.X, vp.Y / DESIGN.Y), 0.5, 1.2)
	for i, root in roots do
		scales[i].Scale = s
		root.Size = UDim2.fromScale(1 / s, 1 / s)
	end
end
camera:GetPropertyChangedSignal("ViewportSize"):Connect(rescale)
rescale()

-- Controllers
local Sounds = require(Controllers.Sounds)
local Notifications = require(Controllers.Notifications)
local Modal = require(Controllers.Modal)
local HUD = require(Controllers.HUD)
local Placement = require(Controllers.Placement)
local BuildMenu = require(Controllers.BuildMenu)
local BuildingPanel = require(Controllers.BuildingPanel)
local ResearchUI = require(Controllers.ResearchUI)
local UnitView = require(Controllers.UnitView)
local WarView = require(Controllers.WarView)
local Effects = require(Controllers.Effects)
local Animator = require(Controllers.Animator)
local ShopUI = require(Controllers.ShopUI)
local RewardsUI = require(Controllers.RewardsUI)
local ArmyUI = require(Controllers.ArmyUI)
local Minimap = require(Controllers.Minimap)
local NationUI = require(Controllers.NationUI)
local NightLights = require(Controllers.NightLights)

Lib.setClickSound(Sounds.get("Click"))

Notifications.init(toastLayer)
Modal.init(modalLayer)
HUD.init(hudLayer)
Placement.init()
BuildMenu.init(buildLayer)
BuildingPanel.init()
ResearchUI.init()
UnitView.init()
WarView.init(hudLayer)
Effects.init()
Animator.init()
ShopUI.init()
RewardsUI.init()
ArmyUI.init()
Minimap.init(hudLayer)
NationUI.init(toastLayer)
NightLights.init()

ClientState.start()

-- VIP chat tag
TextChatService.OnIncomingMessage = function(message: TextChatMessage)
	local props = Instance.new("TextChatMessageProperties")
	local source = message.TextSource
	if source then
		local p = Players:GetPlayerByUserId(source.UserId)
		if p and p:GetAttribute("VIP") then
			props.PrefixText = "<font color='#F5C542'>[VIP]</font> " .. message.PrefixText
		end
	end
	return props
end
]]></string>
          </Properties>
        </Item>
        <Item class="Folder" referent="74">
          <Properties>
            <string name="Name">UI</string>
          </Properties>
          <Item class="ModuleScript" referent="75">
            <Properties>
              <string name="Name">Icons</string>
              <string name="Source"><![CDATA[--[[
	Icons
	Simple flat icons drawn with Frames, so the UI needs zero uploaded images.
	Every icon is a transparent square Frame of `size` pixels.
]]

local Lib = require(script.Parent.Lib)
local Theme = require(script.Parent.Theme)

local New = Lib.New
local Icons = {}

local function box(size: number): Frame
	return New("Frame", {
		Name = "Icon",
		BackgroundTransparency = 1,
		Size = UDim2.fromOffset(size, size),
	})
end

local function rect(parent: Instance, x: number, y: number, w: number, h: number, color: Color3, rot: number?, radius: number?): Frame
	local f = New("Frame", {
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(x, y),
		Size = UDim2.fromScale(w, h),
		BackgroundColor3 = color,
		BorderSizePixel = 0,
		Rotation = rot or 0,
		Parent = parent,
	})
	if radius then
		New("UICorner", { CornerRadius = UDim.new(radius, 0), Parent = f })
	end
	return f
end

local function circle(parent: Instance, x: number, y: number, d: number, color: Color3): Frame
	return rect(parent, x, y, d, d, color, 0, 1)
end

local function ring(parent: Instance, x: number, y: number, d: number, color: Color3, thickness: number): Frame
	local f = rect(parent, x, y, d, d, color, 0, 1)
	f.BackgroundTransparency = 1
	New("UIStroke", { Color = color, Thickness = thickness, Parent = f })
	return f
end

function Icons.person(size: number, color: Color3): Frame
	local f = box(size)
	circle(f, 0.5, 0.3, 0.36, color)
	local body = rect(f, 0.5, 0.82, 0.7, 0.42, color, 0, 0.5)
	body.ClipsDescendants = true
	return f
end

function Icons.people(size: number, color: Color3): Frame
	local f = box(size)
	circle(f, 0.68, 0.3, 0.28, color).BackgroundTransparency = 0.35
	rect(f, 0.72, 0.74, 0.5, 0.36, color, 0, 0.5).BackgroundTransparency = 0.35
	circle(f, 0.38, 0.32, 0.32, color)
	rect(f, 0.36, 0.8, 0.6, 0.4, color, 0, 0.5)
	return f
end

function Icons.smile(size: number, color: Color3): Frame
	local f = box(size)
	ring(f, 0.5, 0.5, 0.82, color, math.max(1.5, size / 12))
	circle(f, 0.36, 0.4, 0.12, color)
	circle(f, 0.64, 0.4, 0.12, color)
	local mouthClip = New("Frame", {
		BackgroundTransparency = 1,
		ClipsDescendants = true,
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.fromScale(0.5, 0.56),
		Size = UDim2.fromScale(0.42, 0.18),
		Parent = f,
	})
	local m = New("Frame", {
		BackgroundTransparency = 1,
		AnchorPoint = Vector2.new(0.5, 1),
		Position = UDim2.fromScale(0.5, 1),
		Size = UDim2.fromScale(1, 2),
		Parent = mouthClip,
	})
	New("UICorner", { CornerRadius = UDim.new(1, 0), Parent = m })
	New("UIStroke", { Color = color, Thickness = math.max(1.5, size / 12), Parent = m })
	return f
end

function Icons.coin(size: number, color: Color3): Frame
	local f = box(size)
	Lib.text({
		Text = "$",
		Size = UDim2.fromScale(1, 1),
		TextScaled = true,
		FontFace = Theme.Font.Bold,
		TextColor3 = color,
		TextXAlignment = Enum.TextXAlignment.Center,
		Parent = f,
	})
	return f
end

function Icons.hammer(size: number, color: Color3): Frame
	local f = box(size)
	rect(f, 0.56, 0.58, 0.16, 0.72, color, 45, 0.4)
	rect(f, 0.36, 0.34, 0.56, 0.24, color, 45, 0.2)
	return f
end

function Icons.trash(size: number, color: Color3): Frame
	local f = box(size)
	rect(f, 0.5, 0.2, 0.7, 0.1, color, 0, 0.5)
	rect(f, 0.5, 0.12, 0.26, 0.08, color, 0, 0.5)
	local body = rect(f, 0.5, 0.6, 0.56, 0.62, color, 0, 0.15)
	body.BackgroundTransparency = 0
	return f
end

function Icons.close(size: number, color: Color3): Frame
	local f = box(size)
	rect(f, 0.5, 0.5, 0.9, 0.14, color, 45, 0.5)
	rect(f, 0.5, 0.5, 0.9, 0.14, color, -45, 0.5)
	return f
end

function Icons.house(size: number, color: Color3): Frame
	local f = box(size)
	local roofClip = New("Frame", {
		BackgroundTransparency = 1,
		ClipsDescendants = true,
		Position = UDim2.fromScale(0, 0),
		Size = UDim2.fromScale(1, 0.48),
		Parent = f,
	})
	rect(roofClip, 0.5, 1, 0.66, 1.38, color, 45, 0.1)
	rect(f, 0.5, 0.7, 0.66, 0.44, color, 0, 0.08)
	rect(f, 0.5, 0.78, 0.18, 0.28, Color3.new(1, 1, 1), 0, 0.2).BackgroundTransparency = 0.15
	return f
end

function Icons.helmet(size: number, color: Color3): Frame
	local f = box(size)
	local clip = New("Frame", {
		BackgroundTransparency = 1,
		ClipsDescendants = true,
		Position = UDim2.fromScale(0, 0.12),
		Size = UDim2.fromScale(1, 0.5),
		Parent = f,
	})
	rect(clip, 0.5, 1, 0.78, 1.56, color, 0, 1)
	rect(f, 0.5, 0.66, 0.96, 0.14, color, 0, 0.5)
	rect(f, 0.5, 0.82, 0.12, 0.2, color, 0, 0.5)
	return f
end

function Icons.flask(size: number, color: Color3): Frame
	local f = box(size)
	rect(f, 0.5, 0.24, 0.22, 0.36, color, 0, 0.15)
	circle(f, 0.5, 0.64, 0.62, color)
	rect(f, 0.5, 0.1, 0.36, 0.08, color, 0, 0.5)
	return f
end

function Icons.bolt(size: number, color: Color3): Frame
	local f = box(size)
	rect(f, 0.58, 0.3, 0.16, 0.5, color, 25, 0.2)
	rect(f, 0.5, 0.5, 0.42, 0.13, color, 0, 0.3)
	rect(f, 0.42, 0.7, 0.16, 0.5, color, 25, 0.2)
	return f
end

function Icons.drop(size: number, color: Color3): Frame
	local f = box(size)
	circle(f, 0.5, 0.62, 0.6, color)
	rect(f, 0.5, 0.42, 0.42, 0.42, color, 45, 0.1)
	return f
end

function Icons.barrel(size: number, color: Color3): Frame
	local f = box(size)
	rect(f, 0.5, 0.5, 0.6, 0.8, color, 0, 0.18)
	rect(f, 0.5, 0.36, 0.64, 0.07, Color3.new(1, 1, 1), 0, 0.5).BackgroundTransparency = 0.5
	rect(f, 0.5, 0.64, 0.64, 0.07, Color3.new(1, 1, 1), 0, 0.5).BackgroundTransparency = 0.5
	return f
end

function Icons.beam(size: number, color: Color3): Frame
	local f = box(size)
	rect(f, 0.5, 0.2, 0.8, 0.14, color, 0, 0.1)
	rect(f, 0.5, 0.8, 0.8, 0.14, color, 0, 0.1)
	rect(f, 0.5, 0.5, 0.16, 0.66, color, 0, 0.1)
	return f
end

function Icons.gift(size: number, color: Color3): Frame
	local f = box(size)
	rect(f, 0.5, 0.64, 0.72, 0.56, color, 0, 0.1)
	rect(f, 0.5, 0.36, 0.84, 0.16, color, 0, 0.15)
	rect(f, 0.5, 0.58, 0.12, 0.7, Color3.new(1, 1, 1), 0, 0).BackgroundTransparency = 0.25
	ring(f, 0.38, 0.18, 0.24, color, math.max(1.5, size / 14))
	ring(f, 0.62, 0.18, 0.24, color, math.max(1.5, size / 14))
	return f
end

function Icons.cart(size: number, color: Color3): Frame
	local f = box(size)
	rect(f, 0.54, 0.44, 0.62, 0.36, color, 0, 0.15)
	rect(f, 0.16, 0.2, 0.26, 0.1, color, 20, 0.5)
	circle(f, 0.34, 0.84, 0.18, color)
	circle(f, 0.72, 0.84, 0.18, color)
	return f
end

function Icons.calendar(size: number, color: Color3): Frame
	local f = box(size)
	rect(f, 0.5, 0.58, 0.8, 0.7, color, 0, 0.12)
	rect(f, 0.5, 0.66, 0.6, 0.38, Color3.new(1, 1, 1), 0, 0.08).BackgroundTransparency = 0.2
	rect(f, 0.32, 0.18, 0.1, 0.22, color, 0, 0.5)
	rect(f, 0.68, 0.18, 0.1, 0.22, color, 0, 0.5)
	return f
end

function Icons.tank(size: number, color: Color3): Frame
	local f = box(size)
	rect(f, 0.5, 0.7, 0.9, 0.26, color, 0, 0.5)
	rect(f, 0.46, 0.46, 0.44, 0.24, color, 0, 0.3)
	rect(f, 0.76, 0.4, 0.46, 0.08, color, 0, 0.5)
	return f
end

function Icons.truck(size: number, color: Color3): Frame
	local f = box(size)
	rect(f, 0.4, 0.5, 0.56, 0.4, color, 0, 0.1)
	rect(f, 0.8, 0.56, 0.24, 0.28, color, 0, 0.15)
	circle(f, 0.26, 0.8, 0.18, color)
	circle(f, 0.74, 0.8, 0.18, color)
	return f
end

function Icons.rocket(size: number, color: Color3): Frame
	local f = box(size)
	rect(f, 0.5, 0.5, 0.2, 0.7, color, 35, 0.5)
	rect(f, 0.33, 0.73, 0.1, 0.24, color, 35 + 90, 0.3)
	rect(f, 0.62, 0.8, 0.1, 0.24, color, 35, 0.3)
	return f
end

function Icons.target(size: number, color: Color3): Frame
	local f = box(size)
	ring(f, 0.5, 0.5, 0.8, color, math.max(1.5, size / 14))
	ring(f, 0.5, 0.5, 0.4, color, math.max(1.5, size / 14))
	circle(f, 0.5, 0.5, 0.12, color)
	return f
end

function Icons.map(size: number, color: Color3): Frame
	local f = box(size)
	circle(f, 0.5, 0.36, 0.56, color)
	rect(f, 0.5, 0.62, 0.32, 0.32, color, 45, 0.1)
	circle(f, 0.5, 0.36, 0.22, Color3.new(1, 1, 1))
	return f
end

function Icons.ticket(size: number, color: Color3): Frame
	local f = box(size)
	rect(f, 0.5, 0.5, 0.86, 0.52, color, -15, 0.12)
	circle(f, 0.12, 0.56, 0.2, Color3.new(1, 1, 1)).BackgroundTransparency = 0.6
	return f
end

function Icons.star(size: number, color: Color3): Frame
	local f = box(size)
	for i = 0, 4 do
		rect(f, 0.5, 0.52, 0.2, 0.86, color, i * 36, 0.2)
	end
	return f
end

function Icons.shield(size: number, color: Color3): Frame
	local f = box(size)
	rect(f, 0.5, 0.36, 0.72, 0.5, color, 0, 0.15)
	rect(f, 0.5, 0.6, 0.5, 0.5, color, 45, 0.15)
	return f
end

function Icons.undo(size: number, color: Color3): Frame
	local f = box(size)
	local arc = ring(f, 0.55, 0.55, 0.66, color, math.max(1.5, size / 9))
	local cover = rect(f, 0.3, 0.75, 0.42, 0.42, Color3.new(1, 1, 1), 0, 0)
	cover.BackgroundTransparency = 1
	rect(f, 0.24, 0.3, 0.32, 0.12, color, -40, 0.5)
	rect(f, 0.3, 0.42, 0.32, 0.12, color, 50, 0.5)
	local _ = arc
	return f
end

function Icons.get(name: string, size: number, color: Color3?): Frame
	local fn = (Icons :: any)[name]
	if type(fn) ~= "function" then
		fn = Icons.star
	end
	return fn(size, color or Theme.Color.Text)
end

return Icons
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="76">
            <Properties>
              <string name="Name">Lib</string>
              <string name="Source"><![CDATA[--[[
	Lib
	Declarative UI helpers + the Field Command component set. Everything in
	the game UI is built from these, so the whole interface stays consistent
	and needs no uploaded images.

	Lib.New("Frame", { Size = ..., Activated = function() end }, { children })
	  * function values on signal properties are connected
	  * children may be Instances or nested arrays (nil holes are skipped)
]]

local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")
local Workspace = game:GetService("Workspace")

local Theme = require(script.Parent.Theme)

local C = Theme.Color
local Lib = {}

local function applyChildren(parent: Instance, children: { any }?)
	if not children then
		return
	end
	for _, child in children do
		if typeof(child) == "Instance" then
			child.Parent = parent
		elseif type(child) == "table" then
			applyChildren(parent, child)
		end
	end
end

function Lib.New(className: string, props: { [string]: any }?, children: { any }?): any
	local inst = Instance.new(className)
	local parent = nil
	if props then
		for k, v in props do
			if k == "Parent" then
				parent = v
			elseif type(v) == "function" then
				((inst :: any)[k] :: RBXScriptSignal):Connect(v)
			else
				(inst :: any)[k] = v
			end
		end
	end
	applyChildren(inst, children)
	if parent then
		inst.Parent = parent
	end
	return inst
end

local New = Lib.New

local function merge(base: { [string]: any }, over: { [string]: any }?): { [string]: any }
	if over then
		for k, v in over do
			base[k] = v
		end
	end
	return base
end
Lib.merge = merge

---------------------------------------------------------------------------
-- layout primitives
---------------------------------------------------------------------------
function Lib.corner(r: number?): UICorner
	return New("UICorner", { CornerRadius = UDim.new(0, r or Theme.Radius.Card) })
end

function Lib.round(): UICorner
	return New("UICorner", { CornerRadius = UDim.new(1, 0) })
end

function Lib.stroke(color: Color3?, thickness: number?, transparency: number?): UIStroke
	return New("UIStroke", {
		Color = color or C.Line,
		Thickness = thickness or 1,
		Transparency = transparency or 0,
		ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
	})
end

function Lib.pad(t: number, r: number?, b: number?, l: number?): UIPadding
	return New("UIPadding", {
		PaddingTop = UDim.new(0, t),
		PaddingRight = UDim.new(0, r or t),
		PaddingBottom = UDim.new(0, b or t),
		PaddingLeft = UDim.new(0, l or r or t),
	})
end

function Lib.list(direction: string?, gap: number?, hAlign: Enum.HorizontalAlignment?, vAlign: Enum.VerticalAlignment?): UIListLayout
	return New("UIListLayout", {
		FillDirection = direction == "x" and Enum.FillDirection.Horizontal or Enum.FillDirection.Vertical,
		Padding = UDim.new(0, gap or 0),
		HorizontalAlignment = hAlign or Enum.HorizontalAlignment.Left,
		VerticalAlignment = vAlign or Enum.VerticalAlignment.Top,
		SortOrder = Enum.SortOrder.LayoutOrder,
	})
end

function Lib.grid(cell: UDim2, gap: number): UIGridLayout
	return New("UIGridLayout", {
		CellSize = cell,
		CellPadding = UDim2.fromOffset(gap, gap),
		SortOrder = Enum.SortOrder.LayoutOrder,
	})
end

function Lib.frame(props: { [string]: any }?, children: { any }?): Frame
	return New("Frame", merge({ BackgroundTransparency = 1, BorderSizePixel = 0, Size = UDim2.fromScale(1, 1) }, props), children)
end

---------------------------------------------------------------------------
-- text
---------------------------------------------------------------------------
function Lib.text(props: { [string]: any }, children: { any }?): TextLabel
	return New("TextLabel", merge({
		BackgroundTransparency = 1,
		FontFace = Theme.Font.Body,
		TextColor3 = C.Text,
		TextSize = Theme.TextSize.Body,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextYAlignment = Enum.TextYAlignment.Center,
		Size = UDim2.new(1, 0, 0, 20),
		TextTruncate = Enum.TextTruncate.AtEnd,
	}, props), children)
end

-- Stencil heading / number.
function Lib.display(props: { [string]: any }, children: { any }?): TextLabel
	return Lib.text(merge({ FontFace = Theme.Font.Display, TextSize = Theme.TextSize.Title }, props), children)
end

-- Small uppercase label ("OIL STORED").
function Lib.caption(text: string, props: { [string]: any }?): TextLabel
	return Lib.text(merge({
		Text = string.upper(text),
		TextSize = Theme.TextSize.Tiny,
		TextColor3 = C.Muted,
		FontFace = Theme.Font.Display,
		Size = UDim2.new(1, 0, 0, 14),
	}, props))
end

---------------------------------------------------------------------------
-- surfaces
---------------------------------------------------------------------------
-- Corner brackets: the signature frame motif (echoes the targeting reticle).
function Lib.brackets(target: GuiObject, color: Color3?, len: number?, thick: number?, out: number?): Frame
	local col = color or C.Accent
	local l, t, o = len or 10, thick or 2, out or 3
	local holder = New("Frame", {
		Name = "Brackets",
		BackgroundTransparency = 1,
		Size = UDim2.new(1, o * 2, 1, o * 2),
		Position = UDim2.fromOffset(-o, -o),
		ZIndex = target.ZIndex + 1,
		Parent = target,
	})
	for _, c in { { 0, 0 }, { 1, 0 }, { 0, 1 }, { 1, 1 } } do
		local corner = New("Frame", {
			BackgroundTransparency = 1,
			AnchorPoint = Vector2.new(c[1], c[2]),
			Position = UDim2.fromScale(c[1], c[2]),
			Size = UDim2.fromOffset(l, l),
			ZIndex = target.ZIndex + 1,
			Parent = holder,
		})
		New("Frame", { BackgroundColor3 = col, BorderSizePixel = 0, Size = UDim2.fromOffset(l, t), Position = UDim2.fromOffset(0, c[2] == 0 and 0 or l - t), ZIndex = target.ZIndex + 1, Parent = corner })
		New("Frame", { BackgroundColor3 = col, BorderSizePixel = 0, Size = UDim2.fromOffset(t, l), Position = UDim2.fromOffset(c[1] == 0 and 0 or l - t, 0), ZIndex = target.ZIndex + 1, Parent = corner })
	end
	return holder
end

function Lib.panel(props: { [string]: any }, children: { any }?): Frame
	local f = New("Frame", merge({
		BackgroundColor3 = C.Panel,
		BackgroundTransparency = Theme.Transparency.Panel,
		BorderSizePixel = 0,
	}, props), children)
	Lib.corner(Theme.Radius.Panel).Parent = f
	Lib.stroke(C.Line, 1, 0.35).Parent = f
	-- faint top sheen
	New("UIGradient", {
		Color = ColorSequence.new(Color3.new(1, 1, 1), Color3.fromRGB(205, 210, 205)),
		Rotation = 90,
		Parent = f,
	})
	return f
end

function Lib.card(props: { [string]: any }, children: { any }?): Frame
	local f = New("Frame", merge({ BackgroundColor3 = C.Raised, BorderSizePixel = 0 }, props), children)
	Lib.corner(Theme.Radius.Card).Parent = f
	Lib.stroke(C.LineSoft, 1, 0).Parent = f
	return f
end

-- Recessed well (bars, inputs, viewports).
function Lib.inset(props: { [string]: any }, children: { any }?): Frame
	local f = New("Frame", merge({ BackgroundColor3 = C.Inset, BorderSizePixel = 0 }, props), children)
	Lib.corner(Theme.Radius.Card).Parent = f
	return f
end

function Lib.divider(props: { [string]: any }?): Frame
	return New("Frame", merge({ BackgroundColor3 = C.Line, BackgroundTransparency = 0.4, BorderSizePixel = 0, Size = UDim2.new(1, 0, 0, 1) }, props))
end

-- Diagonal hazard stripes drawn with a hard-stop gradient (no images).
function Lib.hazard(props: { [string]: any }?, a: Color3?, b: Color3?, stripes: number?): Frame
	local ca, cb = a or C.Accent, b or C.Ink
	local n = math.clamp(stripes or 8, 2, 9)
	local keys = {}
	for i = 0, n - 1 do
		local t0 = i / n
		local t1 = (i + 1) / n
		local col = i % 2 == 0 and ca or cb
		table.insert(keys, ColorSequenceKeypoint.new(t0, col))
		table.insert(keys, ColorSequenceKeypoint.new(math.max(t0, t1 - 0.001), col))
	end
	keys[#keys] = ColorSequenceKeypoint.new(1, keys[#keys].Value)
	return New("Frame", merge({ BackgroundColor3 = Color3.new(1, 1, 1), BorderSizePixel = 0, Size = UDim2.new(1, 0, 0, 6) }, props), {
		New("UIGradient", { Color = ColorSequence.new(keys), Rotation = 20 }),
	})
end

-- Legacy soft shadow (kept for compatibility, dark theme uses strokes).
function Lib.shadow(target: GuiObject)
	return target
end

---------------------------------------------------------------------------
-- controls
---------------------------------------------------------------------------
local clickSound: Sound? = nil
function Lib.setClickSound(s: Sound)
	clickSound = s
end

local VARIANTS = {
	primary = { bg = C.Accent, fg = C.OnAccent, stroke = nil, font = "Display" },
	secondary = { bg = C.Raised, fg = C.Text, stroke = C.Line, font = "Display" },
	ghost = { bg = C.Panel, fg = C.TextSoft, stroke = C.LineSoft, font = "Display" },
	good = { bg = Color3.fromRGB(70, 150, 60), fg = C.Text, stroke = nil, font = "Display" },
	danger = { bg = C.BadSoft, fg = C.Bad, stroke = C.Bad, font = "Display" },
	gold = { bg = C.Gold, fg = C.OnAccent, stroke = nil, font = "Display" },
	premium = { bg = Color3.fromRGB(110, 72, 170), fg = C.Text, stroke = C.Premium, font = "Display" },
}

-- Button with hover / press feedback. props.Variant picks a style.
function Lib.button(props: { [string]: any }, children: { any }?): TextButton
	local variant = VARIANTS[props.Variant or ""]
	local p = {
		AutoButtonColor = false,
		BackgroundColor3 = variant and variant.bg or C.Raised,
		FontFace = variant and Theme.Font.Display or Theme.Font.BodyBold,
		TextColor3 = variant and variant.fg or C.Text,
		TextSize = Theme.TextSize.Small,
		Text = "",
		Size = UDim2.fromOffset(120, 36),
		BorderSizePixel = 0,
	}
	local onClick = props.Activated
	for k, v in props do
		if k ~= "Activated" and k ~= "Variant" then
			p[k] = v
		end
	end
	local btn = New("TextButton", p, children) :: TextButton
	if variant then
		if not btn:FindFirstChildOfClass("UICorner") then
			Lib.corner(Theme.Radius.Button).Parent = btn
		end
		if variant.stroke and not btn:FindFirstChildOfClass("UIStroke") then
			Lib.stroke(variant.stroke, 1, 0.2).Parent = btn
		end
	end
	btn:SetAttribute("Base", btn.BackgroundColor3)
	local scale = New("UIScale", { Parent = btn })
	local function base(): Color3
		return (btn:GetAttribute("Base") :: Color3?) or btn.BackgroundColor3
	end
	btn.MouseEnter:Connect(function()
		local b = base()
		local lift = (b.R + b.G + b.B) / 3 > 0.5 and Color3.new(1, 1, 1) or Color3.fromRGB(90, 100, 92)
		TweenService:Create(btn, TweenInfo.new(0.1), { BackgroundColor3 = b:Lerp(lift, 0.22) }):Play()
	end)
	btn.MouseLeave:Connect(function()
		TweenService:Create(btn, TweenInfo.new(0.12), { BackgroundColor3 = base() }):Play()
		TweenService:Create(scale, TweenInfo.new(0.1), { Scale = 1 }):Play()
	end)
	btn.MouseButton1Down:Connect(function()
		TweenService:Create(scale, TweenInfo.new(0.06), { Scale = 0.95 }):Play()
	end)
	btn.MouseButton1Up:Connect(function()
		TweenService:Create(scale, TweenInfo.new(0.12, Enum.EasingStyle.Back), { Scale = 1 }):Play()
	end)
	if onClick then
		btn.Activated:Connect(function(...)
			if clickSound then
				clickSound:Play()
			end
			onClick(...)
		end)
	end
	return btn
end

-- Set a button's resting colour (keeps hover logic correct).
function Lib.setButtonColor(btn: GuiButton, color: Color3)
	btn:SetAttribute("Base", color)
	btn.BackgroundColor3 = color
end

-- On/off switch. Returns the button and a setter.
function Lib.toggle(props: { [string]: any }, onChanged: (boolean) -> ()): (TextButton, (boolean) -> ())
	local state = false
	local btn = New("TextButton", merge({
		AutoButtonColor = false,
		Text = "",
		BackgroundColor3 = C.Inset,
		Size = UDim2.fromOffset(52, 26),
		BorderSizePixel = 0,
	}, props), { Lib.round(), Lib.stroke(C.Line, 1, 0.3) })
	local knob = New("Frame", {
		BackgroundColor3 = C.Muted,
		AnchorPoint = Vector2.new(0, 0.5),
		Position = UDim2.new(0, 3, 0.5, 0),
		Size = UDim2.fromOffset(20, 20),
		Parent = btn,
	}, { Lib.round() })
	local function set(on: boolean)
		state = on
		Lib.tween(knob, 0.15, { Position = on and UDim2.new(1, -23, 0.5, 0) or UDim2.new(0, 3, 0.5, 0), BackgroundColor3 = on and C.Bad or C.Muted })
		Lib.tween(btn, 0.15, { BackgroundColor3 = on and C.BadSoft or C.Inset })
	end
	btn.Activated:Connect(function()
		if clickSound then
			clickSound:Play()
		end
		onChanged(not state)
	end)
	return btn, set
end

function Lib.textbox(props: { [string]: any }): TextBox
	return New("TextBox", merge({
		Text = "",
		PlaceholderText = "",
		PlaceholderColor3 = C.Faint,
		FontFace = Theme.Font.BodyBold,
		TextSize = Theme.TextSize.Body,
		TextColor3 = C.Text,
		BackgroundColor3 = C.Inset,
		ClearTextOnFocus = false,
		Size = UDim2.new(1, 0, 0, 40),
		TextXAlignment = Enum.TextXAlignment.Left,
		BorderSizePixel = 0,
	}, props), { Lib.corner(Theme.Radius.Button), Lib.stroke(C.Line, 1, 0.3), Lib.pad(0, 12) })
end

function Lib.scroll(props: { [string]: any }?, children: { any }?): ScrollingFrame
	return New("ScrollingFrame", merge({
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		Size = UDim2.fromScale(1, 1),
		CanvasSize = UDim2.new(),
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
		ScrollBarThickness = 4,
		ScrollBarImageColor3 = C.Accent,
		ScrollBarImageTransparency = 0.4,
	}, props), children)
end

---------------------------------------------------------------------------
-- data display
---------------------------------------------------------------------------
-- Chip: tinted label ("$12,000", "48s", "LOCKED").
function Lib.chip(text: string, bg: Color3, fg: Color3, props: { [string]: any }?): Frame
	local label = Lib.text({
		Name = "Label",
		Text = text,
		TextColor3 = fg,
		TextSize = Theme.TextSize.Tiny + 1,
		FontFace = Theme.Font.Display,
		AutomaticSize = Enum.AutomaticSize.X,
		Size = UDim2.new(0, 0, 1, 0),
		TextXAlignment = Enum.TextXAlignment.Center,
		TextTruncate = Enum.TextTruncate.None,
	})
	return New("Frame", merge({
		BackgroundColor3 = bg,
		AutomaticSize = Enum.AutomaticSize.X,
		Size = UDim2.fromOffset(0, 20),
		BorderSizePixel = 0,
	}, props), { Lib.corner(Theme.Radius.Chip), Lib.pad(0, 7), label })
end

export type Progress = { frame: Frame, set: (number, Color3?) -> () }

-- Bar; props.Segments draws notch dividers for the "ammo" look.
function Lib.progress(props: { [string]: any }?): Progress
	local segments = props and props.Segments
	local p = {}
	if props then
		for k, v in props do
			if k ~= "Segments" then
				p[k] = v
			end
		end
	end
	local fill = New("Frame", {
		Name = "Fill",
		BackgroundColor3 = C.Accent,
		Size = UDim2.fromScale(0, 1),
		BorderSizePixel = 0,
	})
	local frame = New("Frame", merge({
		BackgroundColor3 = C.Inset,
		Size = UDim2.new(1, 0, 0, 5),
		BorderSizePixel = 0,
		ClipsDescendants = true,
	}, p), { Lib.corner(2), fill })
	if segments and segments > 1 then
		for i = 1, segments - 1 do
			New("Frame", {
				BackgroundColor3 = C.Panel,
				BorderSizePixel = 0,
				AnchorPoint = Vector2.new(0.5, 0),
				Position = UDim2.fromScale(i / segments, 0),
				Size = UDim2.new(0, 2, 1, 0),
				ZIndex = 3,
				Parent = frame,
			})
		end
	end
	return {
		frame = frame,
		set = function(frac: number, color: Color3?)
			frac = math.clamp(frac, 0, 1)
			fill.Size = UDim2.fromScale(frac, 1)
			fill.BackgroundColor3 = color or (frac >= 0.995 and C.Gold or C.Accent)
		end,
	}
end

-- 3D thumbnail of a model. spin = degrees / second turntable.
function Lib.viewport(model: Model, props: { [string]: any }?, angle: number?, spin: number?): ViewportFrame
	local vp = New("ViewportFrame", merge({
		BackgroundTransparency = 1,
		Size = UDim2.fromScale(1, 1),
		Ambient = Color3.fromRGB(150, 156, 150),
		LightColor = Color3.fromRGB(255, 244, 222),
		LightDirection = Vector3.new(-1, -2, -0.6),
	}, props)) :: ViewportFrame
	local clone = model:Clone()
	clone:PivotTo(CFrame.new())
	clone.Parent = vp
	local cf, size = clone:GetBoundingBox()
	local radius = size.Magnitude / 2
	local cam = Instance.new("Camera")
	cam.FieldOfView = 30
	cam.Parent = vp
	vp.CurrentCamera = cam
	local yaw = math.rad(angle or 35)
	local dist = radius / math.sin(math.rad(cam.FieldOfView / 2)) * 0.95
	local function place()
		local dir = (CFrame.Angles(0, yaw, 0) * CFrame.Angles(math.rad(-30), 0, 0)).LookVector
		cam.CFrame = CFrame.lookAt(cf.Position - dir * dist, cf.Position)
	end
	place()
	if spin and spin ~= 0 then
		local conn
		conn = RunService.Heartbeat:Connect(function(dt)
			-- stop once the window is gone (reading a destroyed instance can throw)
			local alive, parent = pcall(function()
				return vp.Parent
			end)
			if not alive or not parent then
				conn:Disconnect()
				return
			end
			yaw += math.rad(spin) * dt
			place()
		end)
	end
	return vp
end

function Lib.tween(inst: Instance, time: number, props: { [string]: any }, style: Enum.EasingStyle?, dir: Enum.EasingDirection?): Tween
	local t = TweenService:Create(inst, TweenInfo.new(time, style or Enum.EasingStyle.Quad, dir or Enum.EasingDirection.Out), props)
	t:Play()
	return t
end

function Lib.serverNow(): number
	return Workspace:GetServerTimeNow()
end

-- Clear generated children but keep layout objects.
function Lib.clear(parent: Instance)
	for _, c in parent:GetChildren() do
		if not c:IsA("UIBase") then
			c:Destroy()
		end
	end
end

return Lib
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="77">
            <Properties>
              <string name="Name">Theme</string>
              <string name="Source"><![CDATA[--[[
	Theme - "FIELD COMMAND"
	Forge & Frontline's own visual identity: dark tactical glass, warm
	off-white type, signal-amber accents and corner brackets that echo the
	targeting reticle. Stencil-style display font for headings and numbers,
	Roblox's Builder Sans for readable body text.
]]

local rgb = Color3.fromRGB

local Theme = {}

local function family(name: string): string
	return "rbxasset://fonts/families/" .. name .. ".json"
end

local DISPLAY = family("Sarpanch")
local BODY = family("BuilderSans")
local MONO = family("RobotoMono")

Theme.Font = {
	Display = Font.new(DISPLAY, Enum.FontWeight.Bold),
	DisplayHeavy = Font.new(DISPLAY, Enum.FontWeight.ExtraBold),
	Body = Font.new(BODY, Enum.FontWeight.Medium),
	BodyBold = Font.new(BODY, Enum.FontWeight.Bold),
	BodyHeavy = Font.new(BODY, Enum.FontWeight.ExtraBold),
	Mono = Font.new(MONO, Enum.FontWeight.Bold),
	-- legacy names used by older call sites
	Regular = Font.new(BODY, Enum.FontWeight.Regular),
	Semi = Font.new(BODY, Enum.FontWeight.Medium),
	Bold = Font.new(BODY, Enum.FontWeight.Bold),
}

Theme.Color = {
	-- surfaces (dark → light)
	Ink = rgb(14, 18, 16),
	Panel = rgb(20, 25, 22),
	Raised = rgb(29, 35, 31),
	Hover = rgb(40, 47, 42),
	Inset = rgb(10, 13, 11),
	Line = rgb(62, 71, 63),
	LineSoft = rgb(40, 47, 42),

	-- type
	Text = rgb(236, 232, 216),
	TextSoft = rgb(198, 196, 180),
	Muted = rgb(146, 151, 134),
	Faint = rgb(96, 103, 92),
	OnAccent = rgb(24, 20, 10),

	-- signals
	Accent = rgb(255, 180, 54), -- signal amber
	AccentDim = rgb(120, 86, 28),
	AccentSoft = rgb(52, 41, 20),
	Teal = rgb(84, 214, 186), -- radar
	TealSoft = rgb(22, 52, 46),
	Good = rgb(132, 222, 110),
	GoodSoft = rgb(28, 54, 26),
	Bad = rgb(244, 88, 72),
	BadSoft = rgb(64, 26, 22),
	Info = rgb(104, 174, 255),
	InfoSoft = rgb(22, 40, 64),
	Gold = rgb(255, 206, 84),
	GoldSoft = rgb(66, 52, 18),
	Premium = rgb(190, 136, 255),
	PremiumSoft = rgb(44, 30, 64),

	Civil = rgb(98, 172, 255),
	Military = rgb(244, 98, 78),

	-- HUD
	Hud = rgb(14, 18, 16),
	HudText = rgb(236, 232, 216),
	HudMuted = rgb(146, 151, 134),

	White = rgb(255, 255, 255),
	Black = rgb(0, 0, 0),
	Shadow = rgb(0, 0, 0),

	-- legacy aliases (older controllers)
	Card = rgb(29, 35, 31),
	CardAlt = rgb(20, 25, 22),
	CardStroke = rgb(62, 71, 63),
	PanelStroke = rgb(62, 71, 63),
	Header = rgb(20, 25, 22),
	Track = rgb(40, 47, 42),
	Tab = rgb(29, 35, 31),
	TabActive = rgb(52, 41, 20),
	Time = rgb(104, 174, 255),
	TimeSoft = rgb(22, 40, 64),
	Amber = rgb(255, 180, 54),
	CivilSoft = rgb(22, 40, 64),
	MilitarySoft = rgb(64, 26, 22),
}

Theme.Transparency = {
	Panel = 0.06,
	Glass = 0.14,
}

Theme.Radius = {
	Panel = 6,
	Card = 5,
	Chip = 3,
	Pill = 6,
	Button = 4,
}

Theme.TextSize = {
	Tiny = 11,
	Small = 13,
	Body = 15,
	Title = 20,
	Big = 26,
	Huge = 34,
}

-- Flag colours players can pick for their nation.
Theme.FlagColors = {
	rgb(232, 232, 226), rgb(28, 30, 34), rgb(210, 52, 46), rgb(38, 92, 196),
	rgb(46, 150, 82), rgb(250, 196, 48), rgb(240, 128, 36), rgb(120, 70, 180),
	rgb(64, 176, 196), rgb(140, 32, 46), rgb(26, 54, 110), rgb(120, 132, 70),
}

return Theme
