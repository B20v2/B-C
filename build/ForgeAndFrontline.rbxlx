        </Item>
        <Item class="ModuleScript" referent="9">
          <Properties>
            <string name="Name">Products</string>
            <string name="Source"><![CDATA[--[[
	Monetization catalog.

	HOW TO GO LIVE: create each pass / developer product on the Creator Hub
	(Monetization tab of your experience) and paste its ID into `id` below.
	While an ID is 0 the item is still shown in the store and, in Studio with
	Config.StudioFreePurchases enabled, buying it grants it for free so every
	perk can be tested.

	`robux` is only the fallback label; the live price is fetched from
	MarketplaceService at runtime.
]]

export type PassDef = {
	key: string,
	id: number,
	name: string,
	robux: number,
	desc: string,
	perks: { string },
	color: Color3,
	order: number?,
}

export type ProductDef = {
	key: string,
	id: number,
	name: string,
	robux: number,
	desc: string,
	kind: string, -- "cash" | "instantBuild" | "instantResearch" | "boost" | "supply" | "starter" | "repair"
	minutes: number?, -- cash packs: minutes of income; boosts: duration
	minCash: number?,
	oneTime: boolean?,
	tag: string?,
	order: number?,
}

local Products = {}

Products.Passes = {
	{ key = "DoubleCash", id = 0, name = "2x Cash", robux = 449, color = Color3.fromRGB(46, 160, 90),
		desc = "Double every pay day, forever.", perks = { "2x pay day income", "2x offline earnings" } },
	{ key = "VIP", id = 0, name = "VIP", robux = 299, color = Color3.fromRGB(222, 170, 40),
		desc = "+25% income, VIP tag and longer offline earnings.",
		perks = { "+25% income", "VIP chat tag", "Offline earnings x2", "+10 unit cap" } },
	{ key = "FastBuild", id = 0, name = "Fast Construction", robux = 249, color = Color3.fromRGB(60, 130, 220),
		desc = "Buildings, research and factories work twice as fast.",
		perks = { "2x construction speed", "2x research speed", "2x factory speed" } },
	{ key = "EasternPack", id = 0, name = "Eastern Military Pack", robux = 399, color = Color3.fromRGB(176, 60, 60),
		desc = "Unlock the Eastern faction arsenal.",
		perks = { "Tor-M2, S-300, S-400", "OTR Launcher, Swarm Rack", "BMP-3, T-90, Tor-M" } },
	{ key = "EuropeanPack", id = 0, name = "European Military Pack", robux = 399, color = Color3.fromRGB(56, 92, 170),
		desc = "Unlock the European faction arsenal.",
		perks = { "Crotale NG, SAMP/T", "Storm Battery, Falcon Ramp", "VBCI, Leclerc, CAESAR" } },
	{ key = "ExtraQueue", id = 0, name = "Factory Expansion", robux = 149, color = Color3.fromRGB(120, 90, 200),
		desc = "Bigger production queues and a bigger army.",
		perks = { "+3 queue slots per factory", "+20 unit cap" } },
	{ key = "Billboard", id = 0, name = "Billboard", robux = 99, color = Color3.fromRGB(230, 120, 40),
		desc = "Place billboards with your own message.", perks = { "Up to 6 custom billboards" } },
} :: { PassDef }

Products.Developer = {
	{ key = "StarterPack", id = 0, name = "Starter Pack", robux = 99, kind = "starter", oneTime = true,
		tag = "BEST VALUE", desc = "$150k, 10 SRBMs and 30 minutes of 2x cash. One time only." },
	{ key = "Cash1", id = 0, name = "Pocket Change", robux = 49, kind = "cash", minutes = 10, minCash = 25000,
		desc = "10 minutes of income." },
	{ key = "Cash2", id = 0, name = "Briefcase", robux = 149, kind = "cash", minutes = 40, minCash = 100000,
		desc = "40 minutes of income." },
	{ key = "Cash3", id = 0, name = "Vault", robux = 399, kind = "cash", minutes = 150, minCash = 400000,
		tag = "POPULAR", desc = "2.5 hours of income." },
	{ key = "Cash4", id = 0, name = "National Treasury", robux = 999, kind = "cash", minutes = 480,
		minCash = 1500000, desc = "8 hours of income." },
	{ key = "Boost2x", id = 0, name = "2x Cash Boost", robux = 99, kind = "boost", minutes = 30,
		desc = "Double income for 30 minutes. Stacks time." },
	{ key = "InstantBuild", id = 0, name = "Instant Construction", robux = 39, kind = "instantBuild",
		desc = "Finish every building under construction now." },
	{ key = "InstantResearch", id = 0, name = "Instant Research", robux = 79, kind = "instantResearch",
		desc = "Finish your current research now." },
	{ key = "SupplyDrop", id = 0, name = "Supply Drop", robux = 149, kind = "supply",
		desc = "Fill every unlocked missile and drone stockpile." },
	{ key = "Repairs", id = 0, name = "Emergency Repairs", robux = 25, kind = "repair",
		desc = "Repair every damaged building for free." },
} :: { ProductDef }

for i, p in Products.Passes do
	p.order = i
end
for i, p in Products.Developer do
	p.order = i
end

function Products.pass(key: string): PassDef?
	for _, p in Products.Passes do
		if p.key == key then
			return p
		end
	end
	return nil
end

function Products.product(key: string): ProductDef?
	for _, p in Products.Developer do
		if p.key == key then
			return p
		end
	end
	return nil
end

function Products.productById(id: number): ProductDef?
	if id == 0 then
		return nil
	end
	for _, p in Products.Developer do
		if p.id == id then
			return p
		end
	end
	return nil
end

return Products
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="10">
          <Properties>
            <string name="Name">Quests</string>
            <string name="Source"><![CDATA[--[[
	Objective chain. Guides new players through every system and pays out
	cash so the early game feels fast. Checked on the server every second.

	kinds:
	  build      - own `count` finished buildings with id `target`
	  population - reach `count` citizens
	  research   - complete research node `target`
	  stock      - hold `count` of weapon `target`
	  launch     - fire `count` weapons in total
	  hits       - land `count` hits in total
	  capture    - capture `count` strategic points in total
	  units      - own `count` vehicles
]]

export type QuestDef = {
	kind: string,
	target: string?,
	count: number,
	reward: number,
	text: string,
}

local Quests: { QuestDef } = {
	{ kind = "build", target = "road", count = 4, reward = 2000, text = "Build 4 roads" },
	{ kind = "build", target = "small_house", count = 3, reward = 3000, text = "Build 3 Small Houses" },
	{ kind = "build", target = "wind_turbine", count = 1, reward = 3000, text = "Build a Wind Turbine" },
	{ kind = "build", target = "water_tower", count = 1, reward = 3000, text = "Build a Water Tower" },
	{ kind = "population", count = 60, reward = 5000, text = "Reach 60 population" },
	{ kind = "build", target = "shop", count = 1, reward = 5000, text = "Build a Corner Shop" },
	{ kind = "build", target = "park", count = 1, reward = 5000, text = "Build a Park" },
	{ kind = "build", target = "oil_pump", count = 2, reward = 8000, text = "Build 2 Oil Pumps" },
	{ kind = "build", target = "small_refinery", count = 1, reward = 10000, text = "Build a Small Refinery" },
	{ kind = "build", target = "research_lab", count = 1, reward = 10000, text = "Build a Research Lab" },
	{ kind = "research", target = "military_doctrine", count = 1, reward = 20000, text = "Research Military Doctrine" },
	{ kind = "build", target = "small_military_factory", count = 1, reward = 25000, text = "Build a Small Military Factory" },
	{ kind = "research", target = "ballistics", count = 1, reward = 25000, text = "Research Ballistics" },
	{ kind = "build", target = "srbm_launcher", count = 1, reward = 30000, text = "Build an SRBM Launcher" },
	{ kind = "stock", target = "SRBM", count = 3, reward = 30000, text = "Produce 3 SRBMs" },
	{ kind = "launch", count = 1, reward = 40000, text = "Travel and launch a missile" },
	{ kind = "population", count = 1000, reward = 50000, text = "Reach 1,000 population" },
	{ kind = "hits", count = 5, reward = 60000, text = "Land 5 hits" },
	{ kind = "units", count = 3, reward = 75000, text = "Build 3 vehicles" },
	{ kind = "capture", count = 1, reward = 100000, text = "Capture a strategic point" },
	{ kind = "population", count = 5000, reward = 150000, text = "Reach 5,000 population" },
	{ kind = "hits", count = 30, reward = 200000, text = "Land 30 hits" },
	{ kind = "population", count = 15000, reward = 400000, text = "Reach 15,000 population" },
	{ kind = "hits", count = 100, reward = 750000, text = "Land 100 hits" },
}

return Quests
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="11">
          <Properties>
            <string name="Name">Research</string>
            <string name="Source"><![CDATA[--[[
	Research tree. Research labs generate research points (RP). A node costs
	RP + cash, takes time and unlocks buildings, weapons and units that list it
	in their `research` field. Some military nodes also need confirmed hits,
	so players climb the missile ladder by actually using their arsenal.
]]

export type ResearchDef = {
	id: string,
	name: string,
	branch: string, -- "Civil" | "Military"
	col: number,
	row: number,
	rp: number,
	cash: number,
	time: number,
	requires: { string },
	hits: number?,
	desc: string,
}

local Research = {}

local list: { ResearchDef } = {}
local byId: { [string]: ResearchDef } = {}

local function R(def: { [string]: any })
	def.requires = def.requires or {}
	local typed = def :: ResearchDef
	table.insert(list, typed)
	byId[typed.id] = typed
end

-- Civil branch
R({ id = "urban_planning", name = "Urban Planning", branch = "Civil", col = 1, row = 1, rp = 40, cash = 15000,
	time = 30, desc = "Apartment blocks and offices." })
R({ id = "coal_power", name = "Coal Power", branch = "Civil", col = 1, row = 2, rp = 60, cash = 20000,
	time = 40, desc = "Coal power plants." })
R({ id = "water_treatment", name = "Water Treatment", branch = "Civil", col = 1, row = 3, rp = 60, cash = 18000,
	time = 40, desc = "Pumping stations." })
R({ id = "heavy_industry", name = "Heavy Industry", branch = "Civil", col = 1, row = 4, rp = 120, cash = 40000,
	time = 60, desc = "Steel mills, medium refineries, tank farms." })
R({ id = "solar", name = "Solar Power", branch = "Civil", col = 2, row = 2, rp = 80, cash = 25000, time = 45,
	requires = { "coal_power" }, desc = "Solar farms." })
R({ id = "public_services", name = "Public Services", branch = "Civil", col = 2, row = 1, rp = 150, cash = 50000,
	time = 60, requires = { "urban_planning" }, desc = "Schools, hospitals and universities." })
R({ id = "petrochemistry", name = "Petrochemistry", branch = "Civil", col = 2, row = 4, rp = 400, cash = 150000,
	time = 120, requires = { "heavy_industry" }, desc = "Large refineries." })
R({ id = "high_density", name = "High Density Living", branch = "Civil", col = 3, row = 1, rp = 300,
	cash = 120000, time = 90, requires = { "public_services" }, desc = "Highrise towers." })
R({ id = "nuclear", name = "Nuclear Fission", branch = "Civil", col = 3, row = 3, rp = 800, cash = 400000,
	time = 180, requires = { "solar", "heavy_industry" }, desc = "Nuclear power plants." })

-- Military branch
R({ id = "military_doctrine", name = "Military Doctrine", branch = "Military", col = 1, row = 2, rp = 100,
	cash = 30000, time = 45, desc = "Small military factory, research center." })
R({ id = "ballistics", name = "Ballistics", branch = "Military", col = 2, row = 1, rp = 150, cash = 40000,
	time = 60, requires = { "military_doctrine" }, desc = "SRBM launcher and missiles." })
R({ id = "air_defense_1", name = "Air Defense I", branch = "Military", col = 2, row = 2, rp = 120, cash = 30000,
	time = 45, requires = { "military_doctrine" }, desc = "CIWS turrets." })
R({ id = "drones_1", name = "Drone Warfare", branch = "Military", col = 2, row = 3, rp = 150, cash = 35000,
	time = 60, requires = { "military_doctrine" }, desc = "Hornet drones and racks." })
R({ id = "mechanized", name = "Mechanized Forces", branch = "Military", col = 2, row = 4, rp = 250,
	cash = 70000, time = 90, requires = { "military_doctrine", "heavy_industry" },
	desc = "Large factory, vehicle depot, trucks and IFVs." })
R({ id = "cruise_missiles", name = "Cruise Missiles", branch = "Military", col = 3, row = 1, rp = 300,
	cash = 90000, time = 90, requires = { "ballistics" }, hits = 5, desc = "GLCM launcher and missiles." })
R({ id = "air_defense_2", name = "Air Defense II", branch = "Military", col = 3, row = 2, rp = 300, cash = 80000,
	time = 90, requires = { "air_defense_1" }, desc = "SAM sites, radar, mobile anti-air." })
R({ id = "drones_2", name = "Jet Drones", branch = "Military", col = 3, row = 3, rp = 350, cash = 100000,
	time = 100, requires = { "drones_1" }, hits = 5, desc = "Raptor jet drones." })
R({ id = "armor", name = "Armored Warfare", branch = "Military", col = 3, row = 4, rp = 450, cash = 130000,
	time = 120, requires = { "mechanized" }, desc = "Main battle tanks." })
R({ id = "mrbm", name = "Medium-Range Missiles", branch = "Military", col = 4, row = 1, rp = 700, cash = 220000,
	time = 150, requires = { "cruise_missiles" }, hits = 10, desc = "MRBM launcher and missiles." })
R({ id = "air_defense_3", name = "Air Defense III", branch = "Military", col = 4, row = 2, rp = 800,
	cash = 250000, time = 180, requires = { "air_defense_2" }, desc = "Long-range SAM." })
R({ id = "rocket_artillery", name = "Rocket Artillery", branch = "Military", col = 4, row = 4, rp = 600,
	cash = 180000, time = 150, requires = { "armor" }, desc = "HIMARS." })
R({ id = "cluster", name = "Cluster Munitions", branch = "Military", col = 5, row = 1, rp = 1000, cash = 350000,
	time = 200, requires = { "mrbm" }, hits = 30, desc = "Cluster BM launcher and missiles." })
R({ id = "directed_energy", name = "Directed Energy", branch = "Military", col = 5, row = 2, rp = 2000,
	cash = 900000, time = 300, requires = { "air_defense_3" }, desc = "Laser defense." })
R({ id = "hypersonic", name = "Hypersonic Weapons", branch = "Military", col = 6, row = 1, rp = 2500,
	cash = 1200000, time = 360, requires = { "cluster" }, hits = 100, desc = "Hypersonic BM launcher." })

function Research.get(id: string): ResearchDef?
	return byId[id]
end

function Research.all(): { ResearchDef }
	return list
end

return Research
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="12">
          <Properties>
            <string name="Name">Units</string>
            <string name="Source"><![CDATA[--[[
	Units catalog: ground vehicles built in military factories. Units roll out
	at home, deploy to the mainland through the tunnel and capture points.
]]

export type UnitDef = {
	id: string,
	name: string,
	role: string,
	faction: string,
	cost: number,
	fuel: number,
	steel: number,
	time: number,
	hp: number,
	speed: number,
	dps: number,
	range: number,
	capture: number, -- capture points per second
	antiAir: number?, -- chance to shoot down projectiles nearby
	model: string,
	params: { [string]: any }?,
	research: string,
	pass: string?,
	order: number,
	desc: string,
}

local Units = {}

local list: { UnitDef } = {}
local byId: { [string]: UnitDef } = {}

local FactionPass = { Eastern = "EasternPack", European = "EuropeanPack" }

local function U(def: { [string]: any })
	def.order = #list + 1
	def.faction = def.faction or "Standard"
	if def.faction ~= "Standard" then
		def.pass = FactionPass[def.faction]
	end
	local typed = def :: UnitDef
	table.insert(list, typed)
	byId[typed.id] = typed
end

U({ id = "truck", name = "Supply Truck", role = "Capture", cost = 1500, fuel = 20, steel = 10, time = 10,
	hp = 60, speed = 34, dps = 0, range = 0, capture = 1, model = "truck", research = "mechanized",
	desc = "Cheap and fast. Good for holding points." })
U({ id = "marder", name = "Marder", role = "IFV", cost = 6000, fuel = 60, steel = 40, time = 25,
	hp = 180, speed = 26, dps = 10, range = 60, capture = 3, model = "ifv", research = "mechanized",
	desc = "Infantry fighting vehicle. Best at capturing." })
U({ id = "leopard", name = "Leopard", role = "Tank", cost = 14000, fuel = 100, steel = 90, time = 40,
	hp = 420, speed = 20, dps = 24, range = 80, capture = 2, model = "tank", research = "armor",
	desc = "Main battle tank. Tough and hard hitting." })
U({ id = "himars", name = "HIMARS", role = "Artillery", cost = 18000, fuel = 80, steel = 60, time = 45,
	hp = 140, speed = 28, dps = 40, range = 220, capture = 1, model = "mlrs", research = "rocket_artillery",
	desc = "Long-range rockets. Shreds garrisons from afar." })
U({ id = "gepard", name = "Gepard", role = "Anti-Air", cost = 12000, fuel = 60, steel = 50, time = 30,
	hp = 200, speed = 24, dps = 8, range = 60, capture = 1, antiAir = 0.3, model = "spaag",
	research = "air_defense_2", desc = "Mobile anti-air. Protects your army from drones and missiles." })
U({ id = "bmp", name = "BMP-3", role = "IFV", faction = "Eastern", cost = 6500, fuel = 60, steel = 40,
	time = 22, hp = 190, speed = 28, dps = 13, range = 65, capture = 3, model = "ifv", params = { eastern = true },
	research = "mechanized", desc = "Eastern IFV with a heavier gun." })
U({ id = "t90", name = "T-90", role = "Tank", faction = "Eastern", cost = 15000, fuel = 100, steel = 95,
	time = 38, hp = 460, speed = 20, dps = 26, range = 80, capture = 2, model = "tank", params = { eastern = true },
	research = "armor", desc = "Eastern main battle tank." })
U({ id = "tor_m", name = "Tor-M", role = "Anti-Air", faction = "Eastern", cost = 13000, fuel = 60, steel = 50,
	time = 28, hp = 220, speed = 22, dps = 6, range = 60, capture = 1, antiAir = 0.4, model = "spaag",
	params = { eastern = true }, research = "air_defense_2", desc = "Eastern mobile SAM." })
U({ id = "vbci", name = "VBCI", role = "IFV", faction = "European", cost = 6500, fuel = 55, steel = 40,
	time = 22, hp = 200, speed = 32, dps = 11, range = 65, capture = 3, model = "ifv", params = { wheeled = true },
	research = "mechanized", desc = "Fast wheeled European IFV." })
U({ id = "leclerc", name = "Leclerc", role = "Tank", faction = "European", cost = 15500, fuel = 100, steel = 90,
	time = 38, hp = 420, speed = 24, dps = 26, range = 85, capture = 2, model = "tank", params = { european = true },
	research = "armor", desc = "Fast European main battle tank." })
U({ id = "caesar", name = "CAESAR", role = "Artillery", faction = "European", cost = 17000, fuel = 70, steel = 55,
	time = 40, hp = 150, speed = 32, dps = 44, range = 240, capture = 1, model = "mlrs", params = { gun = true },
	research = "rocket_artillery", desc = "Truck-mounted howitzer with extreme range." })

function Units.get(id: string): UnitDef?
	return byId[id]
end

function Units.all(): { UnitDef }
	return list
end

return Units
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="13">
          <Properties>
            <string name="Name">WarMap</string>
            <string name="Source"><![CDATA[--[[
	Mainland strategic points. Offsets are relative to Config.MainlandOrigin.
	Bonuses are paid to the owner every pay day / tick.
]]

export type PointDef = {
	id: string,
	name: string,
	offset: Vector3,
	garrison: number,
	model: string,
	bonus: { income: number?, oil: number?, power: number?, steel: number?, rp: number? },
	bonusText: string,
}

local WarMap: { PointDef } = {
	{ id = "capital", name = "CAPITAL", offset = Vector3.new(0, 0, 0), garrison = 2500, model = "city",
		bonus = { income = 20000 }, bonusText = "+$20k per pay" },
	{ id = "airport", name = "AIRPORT", offset = Vector3.new(-720, 0, 40), garrison = 900, model = "airport",
		bonus = { income = 6000, rp = 20 }, bonusText = "+$6k per pay, +20 RP/min" },
	{ id = "oil_field", name = "OIL FIELD", offset = Vector3.new(640, 0, -380), garrison = 700, model = "oilField",
		bonus = { oil = 600 }, bonusText = "+600 oil/min" },
	{ id = "nuclear_plant", name = "NUCLEAR POWER PLANT", offset = Vector3.new(120, 0, -720), garrison = 1100,
		model = "nuclear", bonus = { power = 400 }, bonusText = "+400 MW power" },
	{ id = "city", name = "CITY", offset = Vector3.new(520, 0, 330), garrison = 1000, model = "city",
		bonus = { income = 9000 }, bonusText = "+$9k per pay" },
	{ id = "port", name = "PORT", offset = Vector3.new(-320, 0, 760), garrison = 800, model = "port",
		bonus = { steel = 300 }, bonusText = "+300 steel/min" },
	{ id = "military_base", name = "MILITARY BASE", offset = Vector3.new(-660, 0, -660), garrison = 1300,
		model = "base", bonus = { rp = 60 }, bonusText = "+60 RP/min" },
}

return WarMap
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="14">
          <Properties>
            <string name="Name">Weapons</string>
            <string name="Source"><![CDATA[--[[
	Weapons catalog: missiles and drones.
	Produced in military factories, stored in the national stockpile and
	fired from launchers of the matching `family`.
]]

export type WeaponDef = {
	id: string,
	name: string,
	short: string, -- hotbar label
	kind: string, -- "missile" | "drone"
	family: string, -- which launcher fires it
	cost: number,
	fuel: number,
	steel: number,
	time: number, -- seconds to produce at speed 1
	damage: number,
	radius: number,
	flight: number, -- seconds in the air
	apex: number, -- arc height (studs)
	interceptMod: number, -- multiplies air defense hit chance
	stockCap: number,
	research: string,
	order: number,
	color: Color3,
	desc: string,
}

local Weapons = {}

local list: { WeaponDef } = {}
local byId: { [string]: WeaponDef } = {}

local function W(def: { [string]: any })
	def.order = #list + 1
	def.stockCap = def.stockCap or 60
	local typed = def :: WeaponDef
	table.insert(list, typed)
	byId[typed.id] = typed
end

W({ id = "HORNET", name = "Hornet Drone", short = "HORNET", kind = "drone", family = "HORNET",
	cost = 600, fuel = 10, steel = 5, time = 8, damage = 30, radius = 14, flight = 22, apex = 40,
	interceptMod = 1.25, research = "drones_1", color = Color3.fromRGB(150, 155, 140),
	desc = "Slow, cheap loitering munition. Swarm defenses with them." })
W({ id = "RAPTOR", name = "Raptor Jet Drone", short = "RAPTOR", kind = "drone", family = "RAPTOR",
	cost = 1800, fuel = 25, steel = 12, time = 14, damage = 55, radius = 18, flight = 12, apex = 70,
	interceptMod = 0.9, research = "drones_2", color = Color3.fromRGB(120, 128, 118),
	desc = "Fast jet-powered strike drone." })
W({ id = "SRBM", name = "Short-Range Ballistic Missile", short = "SRBM", kind = "missile", family = "SRBM",
	cost = 2500, fuel = 40, steel = 20, time = 20, damage = 70, radius = 26, flight = 9, apex = 280,
	interceptMod = 1.0, research = "ballistics", color = Color3.fromRGB(96, 110, 70),
	desc = "Reliable ballistic strike." })
W({ id = "GLCM", name = "Ground-Launched Cruise Missile", short = "GLCM", kind = "missile", family = "GLCM",
	cost = 3200, fuel = 60, steel = 25, time = 24, damage = 80, radius = 22, flight = 15, apex = 28,
	interceptMod = 0.7, research = "cruise_missiles", color = Color3.fromRGB(150, 156, 162),
	desc = "Hugs the ground. Air defense struggles to hit it." })
W({ id = "MRBM", name = "Medium-Range Ballistic Missile", short = "MRBM", kind = "missile", family = "MRBM",
	cost = 6000, fuel = 90, steel = 50, time = 35, damage = 140, radius = 34, flight = 12, apex = 440,
	interceptMod = 0.9, research = "mrbm", color = Color3.fromRGB(180, 182, 176),
	desc = "Heavy warhead, big blast." })
W({ id = "CLUSTER", name = "Cluster Ballistic Missile", short = "CLUSTER", kind = "missile", family = "CLUSTER",
	cost = 7000, fuel = 90, steel = 60, time = 40, damage = 45, radius = 70, flight = 12, apex = 380,
	interceptMod = 1.0, research = "cluster", color = Color3.fromRGB(196, 178, 128),
	desc = "Scatters bomblets over a huge area." })
W({ id = "HYPERSONIC", name = "Hypersonic Ballistic Missile", short = "HYPER", kind = "missile", family = "HYPERSONIC",
	cost = 15000, fuel = 150, steel = 90, time = 60, damage = 200, radius = 34, flight = 6, apex = 180,
	interceptMod = 0.35, research = "hypersonic", color = Color3.fromRGB(60, 64, 70),
	desc = "Mach 10. Defenses rarely react in time." })

function Weapons.get(id: string): WeaponDef?
	return byId[id]
end

function Weapons.all(): { WeaponDef }
	return list
end

return Weapons
]]></string>
          </Properties>
        </Item>
      </Item>
      <Item class="ModuleScript" referent="15">
        <Properties>
          <string name="Name">Config</string>
          <string name="Source"><![CDATA[--[[
	Config
	Global tuning for Forge & Frontline. Every balance number that is not tied
	to a single building / weapon / unit lives here so the game can be tuned
	from one place.
]]

local Config = {}

Config.GameName = "Forge & Frontline"
Config.DataStoreName = "FF_PlayerData_v1"
Config.DataVersion = 1

-- Set to true while testing in Studio: game passes count as owned and
-- developer products are granted without a real purchase.
Config.StudioFreePurchases = true

-- Roblox group that gives the "Join group" bonus. 0 disables the reward.
Config.GroupId = 0

---------------------------------------------------------------------------
-- World / grid
---------------------------------------------------------------------------
Config.CellSize = 4 -- studs per grid cell
Config.PlotCells = 100 -- plot is PlotCells x PlotCells cells (400 x 400 studs)
Config.PlotGap = 140 -- sand + sea between plots
Config.MaxPlots = 8
Config.PlotRowLength = 4
Config.HomelandOrigin = Vector3.new(0, 0, 0)
Config.MainlandOrigin = Vector3.new(0, 0, 3200)
Config.MainlandSize = 2400

---------------------------------------------------------------------------
-- Economy
---------------------------------------------------------------------------
Config.StartCash = 60000
Config.PayInterval = 60 -- seconds between pay days
Config.TaxPerCitizen = 15 -- $ per citizen per pay at 100% tax efficiency
Config.UpkeepRate = 0.0025 -- fraction of build cost charged every pay day
Config.SellRefund = 0.5 -- refund when deleting a finished building
Config.RepairCostRate = 0.25 -- fraction of build cost to repair a damaged building
Config.BaseResourceCap = 2000 -- oil / steel stored nationally before tanks & warehouses
Config.PopulationGrowth = 0.012 -- fraction of free housing filled each second
Config.PopulationMinGrowth = 1
Config.HappinessBase = 50
Config.OfflineEarningsHours = 2 -- max hours of offline pay
Config.OfflineEarningsRate = 0.3 -- 30% of pay while away (VIP doubles)
Config.PremiumIncomeBonus = 0.1 -- Roblox Premium members earn +10%

---------------------------------------------------------------------------
-- Construction / logistics
---------------------------------------------------------------------------
Config.TruckCapacity = 250
Config.TruckSpeed = 28 -- studs per second
Config.UndoWindow = 45 -- seconds an action can be undone for a full refund
Config.MaxQueuePerFactory = 5

---------------------------------------------------------------------------
-- Combat
---------------------------------------------------------------------------
Config.PvpToggleCooldown = 180 -- after attacking you must wait before going PvP OFF
Config.NewPlayerShield = 20 * 60 -- seconds of protection for brand new nations
Config.StrikeLootRate = 0.03 -- attacker earns this fraction of the value they damage
Config.InterceptAt = 0.72 -- fraction of a flight at which interceptions happen

---------------------------------------------------------------------------
-- Conquest
---------------------------------------------------------------------------
Config.CaptureRadius = 70
Config.CaptureTime = 100 -- capture points needed (units add their capture power per second)
Config.GarrisonRegen = 4 -- garrison HP regenerated per second
Config.MaxUnitsPerPlayer = 40

-- Colour used for each plot slot's nation on the war map.
Config.NationColors = {
	Color3.fromRGB(64, 140, 230),
	Color3.fromRGB(226, 84, 74),
	Color3.fromRGB(80, 184, 96),
	Color3.fromRGB(236, 170, 40),
	Color3.fromRGB(150, 96, 216),
	Color3.fromRGB(40, 190, 196),
	Color3.fromRGB(236, 116, 180),
	Color3.fromRGB(150, 150, 150),
}

---------------------------------------------------------------------------
-- Rewards / retention
---------------------------------------------------------------------------
Config.DailyRewards = { 5000, 10000, 20000, 35000, 50000, 75000, 150000 }
Config.PlaytimeGiftInterval = 10 * 60
Config.PlaytimeGiftPays = 1.5 -- gift = 1.5 pay days of income (min 5k)
Config.GroupRewardCash = 25000

Config.Codes = {
	FORGE = 25000,
	FRONTLINE = 50000,
	RELEASE = 100000,
}

return Config
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="16">
        <Properties>
          <string name="Name">ModelBuilder</string>
          <string name="Source"><![CDATA[--[[
	ModelBuilder
	Builds every asset in the game out of plain parts: a consistent, clean,
	low-poly style with zero external asset IDs. Used by the server (real
	buildings / units), and by the client (placement ghosts, build-menu
	thumbnails, projectiles, fuel trucks).

	Conventions
	  * Models are built at the origin, unrotated, footprint centered on X/Z,
	    ground at Y = 0. Width (w) runs along X, depth (d) along Z.
	  * Front of vehicles / launchers faces -Z (the CFrame LookVector).
	  * PrimaryPart is "Base" (buildings) or "Root" (units/projectiles).
	  * Animated sub-models carry attributes the client animator reads:
	      Spin = rad/s around the sub-model's local axis given by SpinAxis
	      Rock = amplitude (radians) for pump jacks
]]

local Config = require(script.Parent.Config)

local ModelBuilder = {}

local CELL = Config.CellSize
local G = 0.4 -- foundation slab height

local rgb = Color3.fromRGB
local C = {
	concrete = rgb(206, 206, 200),
	pad = rgb(186, 186, 180),
	wall = rgb(234, 233, 228),
	wallWarm = rgb(226, 216, 196),
	wallCool = rgb(214, 218, 222),
	panel = rgb(218, 214, 206),
	terracotta = rgb(180, 90, 66),
	slate = rgb(90, 98, 112),
	roofGrey = rgb(150, 152, 156),
	glass = rgb(72, 96, 120),
	window = rgb(64, 74, 88),
	metal = rgb(168, 172, 176),
	darkMetal = rgb(78, 82, 88),
	steel = rgb(120, 126, 132),
	olive = rgb(92, 102, 66),
	oliveDark = rgb(70, 78, 50),
	eastern = rgb(74, 94, 60),
	european = rgb(170, 156, 118),
	sand = rgb(178, 162, 120),
	red = rgb(192, 58, 48),
	orange = rgb(222, 132, 44),
	yellow = rgb(226, 182, 52),
	grass = rgb(104, 142, 80),
	leaf = rgb(80, 122, 62),
	leafLight = rgb(110, 150, 70),
	trunk = rgb(110, 84, 60),
	asphalt = rgb(74, 76, 80),
	line = rgb(226, 224, 214),
	water = rgb(86, 150, 196),
	white = rgb(245, 245, 242),
	black = rgb(30, 32, 36),
	brick = rgb(168, 104, 84),
	blue = rgb(70, 120, 200),
	solar = rgb(38, 58, 96),
}
ModelBuilder.Colors = C

---------------------------------------------------------------------------
-- Primitive helpers (operate on the model currently being built)
---------------------------------------------------------------------------
local M: Model

local function finish(p: BasePart, color: Color3, material: Enum.Material?)
	p.Anchored = true
	p.Color = color
	p.Material = material or Enum.Material.SmoothPlastic
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	p.CanTouch = false
	p.Parent = M
end

-- Box with its BOTTOM at y (easy stacking).
local function blk(sx: number, sy: number, sz: number, x: number, y: number, z: number, color: Color3, material: Enum.Material?): Part
	local p = Instance.new("Part")
	p.Size = Vector3.new(sx, sy, sz)
	p.CFrame = CFrame.new(x, y + sy / 2, z)
	finish(p, color, material)
	return p
end

-- Box at an arbitrary center CFrame.
local function plank(sx: number, sy: number, sz: number, cf: CFrame, color: Color3, material: Enum.Material?): Part
	local p = Instance.new("Part")
	p.Size = Vector3.new(sx, sy, sz)
	p.CFrame = cf
	finish(p, color, material)
	return p
end

-- Vertical cylinder, bottom at y.
local function cyl(h: number, d: number, x: number, y: number, z: number, color: Color3, material: Enum.Material?): Part
	local p = Instance.new("Part")
	p.Shape = Enum.PartType.Cylinder
	p.Size = Vector3.new(h, d, d)
	p.CFrame = CFrame.new(x, y + h / 2, z) * CFrame.Angles(0, 0, math.rad(90))
	finish(p, color, material)
	return p
end

-- Cylinder whose axis is the X axis of cf.
local function axleCyl(len: number, d: number, cf: CFrame, color: Color3, material: Enum.Material?): Part
	local p = Instance.new("Part")
	p.Shape = Enum.PartType.Cylinder
	p.Size = Vector3.new(len, d, d)
	p.CFrame = cf
	finish(p, color, material)
	return p
end

local function ball(d: number, x: number, y: number, z: number, color: Color3, material: Enum.Material?): Part
	local p = Instance.new("Part")
	p.Shape = Enum.PartType.Ball
	p.Size = Vector3.new(d, d, d)
	p.CFrame = CFrame.new(x, y, z)
	finish(p, color, material)
	return p
end

local function noCollide(p: BasePart)
	p.CanCollide = false
	return p
end

-- Window bands around a box (centered x,z; floors stacked from y0).
local function windows(w: number, d: number, x: number, z: number, y0: number, floors: number, floorH: number, color: Color3?, gaps: boolean?)
	local col = color or C.window
	for f = 0, floors - 1 do
		local y = y0 + f * floorH + floorH * 0.32
		local h = floorH * 0.42
		noCollide(blk(w - 1, h, 0.2, x, y, z - d / 2 - 0.05, col))
		noCollide(blk(w - 1, h, 0.2, x, y, z + d / 2 + 0.05, col))
		noCollide(blk(0.2, h, d - 1, x - w / 2 - 0.05, y, z, col))
		noCollide(blk(0.2, h, d - 1, x + w / 2 + 0.05, y, z, col))
	end
	if gaps then
		-- vertical mullions so long facades read as individual windows
		local step = 3
		local n = math.floor((w - 1) / step)
		for i = 1, n - 1 do
			local px = x - (w - 1) / 2 + i * step
			noCollide(blk(0.35, floors * floorH - 0.6, 0.3, px, y0 + 0.3, z - d / 2 - 0.08, C.panel))
			noCollide(blk(0.35, floors * floorH - 0.6, 0.3, px, y0 + 0.3, z + d / 2 + 0.08, C.panel))
		end
	end
end

-- Gable roof built from two tilted planks; ridge runs along Z.
local function gableRoof(w: number, d: number, x: number, y: number, z: number, color: Color3, pitch: number?)
	local a = math.rad(pitch or 28)
	local half = w / 2
	local rise = half * math.tan(a)
	local len = half / math.cos(a) + 0.5
	plank(len, 0.4, d + 0.6, CFrame.new(x + half / 2, y + rise / 2, z) * CFrame.Angles(0, 0, -a), color)
	plank(len, 0.4, d + 0.6, CFrame.new(x - half / 2, y + rise / 2, z) * CFrame.Angles(0, 0, a), color)
	-- gable infill so the roof never looks hollow (kept inside the slopes)
	blk(w * 0.42, rise * 0.55, d - 0.2, x, y, z, C.wall)
	return rise
end

local function tree(x: number, z: number, s: number?)
	local k = s or 1
	noCollide(cyl(2.2 * k, 0.5 * k, x, G, z, C.trunk))
	noCollide(ball(3 * k, x, G + 3 * k, z, C.leaf))
	noCollide(ball(2 * k, x + 0.6 * k, G + 4 * k, z - 0.3 * k, C.leafLight))
end

local function wheelPair(x: number, y: number, z: number, track: number, d: number)
	axleCyl(0.7, d, CFrame.new(x - track / 2, y, z), C.black)
	axleCyl(0.7, d, CFrame.new(x + track / 2, y, z), C.black)
end

local function base(w: number, d: number, color: Color3?, h: number?): Part
	local p = blk(w, h or G, d, 0, 0, 0, color or C.concrete)
	p.Name = "Base"
	M.PrimaryPart = p
	return p
end

local function spinGroup(name: string, speed: number, axis: string): Model
	local sub = Instance.new("Model")
	sub.Name = name
	sub:SetAttribute("Spin", speed)
	sub:SetAttribute("SpinAxis", axis)
	sub.Parent = M
	return sub
end

-- Run fn with M temporarily pointing at a sub-model.
local function into(sub: Model, fn: () -> ())
	local prev = M
	M = sub
	fn()
	M = prev
end

---------------------------------------------------------------------------
-- Building styles
---------------------------------------------------------------------------
local Styles: { [string]: (w: number, d: number, p: { [string]: any }) -> () } = {}

Styles.house = function(w, d, p)
	local bw, bd = w - 1.6, d - 1.6
	local wallC = p.wallColor or C.wallWarm
	blk(bw, 5, bd, 0, G, 0, wallC)
	local roofC = p.roof == "slate" and C.slate or C.terracotta
	gableRoof(bw + 0.6, bd, 0, G + 5, 0, roofC)
	noCollide(blk(1.4, 2.6, 0.2, 0, G, -bd / 2 - 0.1, C.trunk)) -- door
	noCollide(blk(1.2, 1.2, 0.2, -bw / 4 - 0.3, G + 2.2, -bd / 2 - 0.1, C.window))
	noCollide(blk(1.2, 1.2, 0.2, bw / 4 + 0.3, G + 2.2, -bd / 2 - 0.1, C.window))
	noCollide(blk(0.2, 1.2, 1.2, bw / 2 + 0.1, G + 2.2, 0, C.window))
	noCollide(blk(0.2, 1.2, 1.2, -bw / 2 - 0.1, G + 2.2, 0, C.window))
	blk(0.8, 2.5, 0.8, bw / 4, G + 6, bd / 4, C.brick)
end

Styles.townhouse = function(w, d, p)
	local n = p.count or 3
	local each = w / n
	local walls = { C.wallWarm, C.wall, rgb(222, 200, 186) }
	for i = 1, n do
		local x = -w / 2 + each * (i - 0.5)
		local bw, bd = each - 0.3, d - 1.6
		blk(bw, 7, bd, x, G, 0, walls[(i - 1) % #walls + 1])
		gableRoof(bw, bd, x, G + 7, 0, i % 2 == 0 and C.slate or C.terracotta, 24)
		noCollide(blk(1.4, 2.6, 0.2, x, G, -bd / 2 - 0.1, C.trunk))
		noCollide(blk(bw - 2, 1.2, 0.2, x, G + 4.4, -bd / 2 - 0.1, C.window))
		noCollide(blk(bw - 2, 1.2, 0.2, x, G + 4.4, bd / 2 + 0.1, C.window))
	end
end

Styles.apartment = function(w, d, p)
	local floors = p.floors or 4
	local fh = 3.2
	local bw, bd = w - 1.4, d - 1.4
	blk(bw, floors * fh + 0.8, bd, 0, G, 0, C.panel)
	windows(bw, bd, 0, 0, G + 0.8, floors, fh, C.window, true)
	blk(bw + 0.4, 0.6, bd + 0.4, 0, G + floors * fh + 0.8, 0, C.roofGrey)
	-- rooftop details
	local units = math.max(1, math.floor(bw / 12))
	for i = 1, units do
		local x = -bw / 2 + (i - 0.5) * (bw / units)
		blk(2.2, 1.6, 2.2, x, G + floors * fh + 1.4, 0, C.metal)
	end
	-- entrances
	local doors = math.max(1, math.floor(bw / 10))
	for i = 1, doors do
		local x = -bw / 2 + (i - 0.5) * (bw / doors)
		noCollide(blk(2, 2.6, 0.4, x, G, -bd / 2 - 0.2, C.darkMetal))
	end
end

Styles.tower = function(w, d, p)
	local floors = p.floors or 14
	local fh = 3.2
	local bw, bd = w - 2.2, d - 2.2
	blk(w - 0.8, 4, d - 0.8, 0, G, 0, C.wallCool)
	blk(bw, floors * fh, bd, 0, G + 4, 0, C.wall)
	windows(bw, bd, 0, 0, G + 4, floors, fh, C.glass)
	local top = G + 4 + floors * fh
	blk(bw - 2, 3, bd - 2, 0, top, 0, C.roofGrey)
	noCollide(cyl(6, 0.3, 0, top + 3, 0, C.metal))
	noCollide(ball(0.7, 0, top + 9.2, 0, C.red, Enum.Material.Neon))
end

Styles.road = function(w, d, _p)
	local p = blk(w, 0.3, d, 0, 0, 0, C.asphalt)
	p.Name = "Base"
	M.PrimaryPart = p
end

Styles.plaza = function(w, d, _p)
	local b = M.PrimaryPart :: BasePart
	b.Color = rgb(196, 190, 176)
	cyl(0.8, 6, 0, G, 0, C.pad)
	cyl(0.85, 5, 0, G, 0, C.water, Enum.Material.Glass).Transparency = 0.2
	noCollide(cyl(2.4, 0.6, 0, G, 0, C.pad))
	tree(-w / 2 + 2, -d / 2 + 2, 0.8)
	tree(w / 2 - 2, d / 2 - 2, 0.8)
	tree(w / 2 - 2, -d / 2 + 2, 0.8)
	tree(-w / 2 + 2, d / 2 - 2, 0.8)
end

Styles.windTurbine = function(_w, _d, _p)
	cyl(1, 2.4, 0, G, 0, C.pad)
	cyl(30, 1.1, 0, G + 1, 0, C.white)
	local top = G + 31
	blk(1.6, 1.6, 3.2, 0, top - 0.4, 0.2, C.white)
	local rotor = spinGroup("Rotor", 1.6, "X")
	into(rotor, function()
		local hubCF = CFrame.new(0, top + 0.4, -1.7)
		local hub = axleCyl(0.8, 1.2, hubCF * CFrame.Angles(0, math.rad(90), 0), C.white)
		hub.Name = "Hub"
		rotor.PrimaryPart = hub
		for k = 0, 2 do
			noCollide(plank(0.7, 12, 0.25, hubCF * CFrame.Angles(0, 0, math.rad(k * 120)) * CFrame.new(0, 6.2, 0), C.white))
		end
	end)
end

Styles.solarFarm = function(w, d, _p)
	local rows = math.floor((d - 2) / 4)
	for r = 0, rows - 1 do
		local z = -d / 2 + 2.5 + r * 4
		for _, x in { -w / 4, w / 4 } do
			noCollide(blk(0.3, 1.2, 0.3, x, G, z, C.metal))
		end
		local panel = plank(w - 2, 0.2, 2.8, CFrame.new(0, G + 1.6, z) * CFrame.Angles(math.rad(-25), 0, 0), C.solar)
		panel.Reflectance = 0.15
	end
end

local function stripedChimney(x: number, z: number, h: number, dia: number)
	local seg = h / 6
	for i = 0, 5 do
		cyl(seg, dia, x, G + i * seg, z, i % 2 == 0 and C.white or C.red)
	end
end

local function coolingTower(x: number, z: number, scale: number)
	local s = scale
	cyl(5 * s, 14 * s, x, G, z, C.wallCool)
	cyl(5 * s, 12.5 * s, x, G + 5 * s, z, C.wallCool)
	cyl(4 * s, 11.5 * s, x, G + 10 * s, z, C.wallCool)
	cyl(4 * s, 12.2 * s, x, G + 14 * s, z, C.wallCool)
	cyl(0.8 * s, 12.5 * s, x, G + 17.4 * s, z, C.red)
	-- dark interior so the top reads as hollow
	noCollide(cyl(0.2, 10.5 * s, x, G + 18.1 * s, z, C.darkMetal))
end

Styles.coalPlant = function(w, d, _p)
	blk(w * 0.55, 12, d * 0.62, -w * 0.18, G, -d * 0.12, C.wallCool)
	windows(w * 0.55, d * 0.62, -w * 0.18, -d * 0.12, G + 2, 3, 3.4, C.window)
	blk(w * 0.25, 18, d * 0.35, -w * 0.3, G, d * 0.28, C.metal)
	stripedChimney(-w * 0.08, d * 0.32, 34, 2.6)
	stripedChimney(-w * 0.18, d * 0.32, 34, 2.6)
	coolingTower(w * 0.28, -d * 0.12, 1)
	-- coal pile
	local pile = cyl(2.5, 9, w * 0.3, G, d * 0.3, C.black)
	pile.Material = Enum.Material.Slate
end

Styles.nuclearPlant = function(w, d, _p)
	coolingTower(-w * 0.26, -d * 0.2, 1.45)
	coolingTower(w * 0.02, -d * 0.24, 1.45)
	-- reactor
	cyl(10, 14, w * 0.3, G, d * 0.18, C.wall)
	ball(14, w * 0.3, G + 10, d * 0.18, C.wall)
	-- turbine hall
	blk(w * 0.5, 9, d * 0.28, -w * 0.15, G, d * 0.3, C.wallCool)
	windows(w * 0.5, d * 0.28, -w * 0.15, d * 0.3, G + 1.5, 2, 3.4)
	blk(w * 0.5, 0.5, 1.2, -w * 0.15, G + 9, d * 0.3, C.red)
	-- switchyard
	for i = 0, 3 do
		noCollide(blk(0.5, 6, 0.5, w * 0.42, G, -d * 0.4 + i * 4, C.metal))
	end
end

Styles.waterTower = function(_w, _d, _p)
	for _, o in { Vector3.new(-1.6, 0, -1.6), Vector3.new(1.6, 0, -1.6), Vector3.new(-1.6, 0, 1.6), Vector3.new(1.6, 0, 1.6) } do
		blk(0.5, 14, 0.5, o.X, G, o.Z, C.metal)
	end
	cyl(14, 1, 0, G, 0, C.metal)
	ball(7.5, 0, G + 17, 0, C.white)
	cyl(1, 7.6, 0, G + 16.3, 0, C.white)
end

Styles.pumpStation = function(w, d, _p)
	blk(w * 0.45, 6, d * 0.4, -w * 0.22, G, -d * 0.22, C.wallWarm)
	gableRoof(w * 0.45, d * 0.4, -w * 0.22, G + 6, -d * 0.22, C.slate, 18)
	for _, x in { w * 0.18, -w * 0.18 } do
		cyl(1.2, d * 0.36, x, G, d * 0.22, C.pad)
		cyl(1.25, d * 0.3, x, G, d * 0.22, C.water, Enum.Material.Glass).Transparency = 0.15
	end
	axleCyl(w * 0.5, 0.8, CFrame.new(w * 0.12, G + 1.4, -d * 0.22), C.blue)
end

Styles.oilPump = function(w, d, _p)
	blk(2.4, 0.6, d - 1, 0, G, 0, C.darkMetal)
	-- A-frame
	plank(0.4, 5.2, 0.4, CFrame.new(-0.7, G + 2.8, 0) * CFrame.Angles(0, 0, math.rad(-8)), C.darkMetal)
	plank(0.4, 5.2, 0.4, CFrame.new(0.7, G + 2.8, 0) * CFrame.Angles(0, 0, math.rad(8)), C.darkMetal)
	blk(1, 1.2, 1.4, 0, G + 0.6, d / 2 - 1.6, C.darkMetal) -- motor
	local beam = Instance.new("Model")
	beam.Name = "Beam"
	beam:SetAttribute("Rock", math.rad(16))
	beam.Parent = M
	into(beam, function()
		local pivot = plank(0.6, 0.6, 0.6, CFrame.new(0, G + 5.4, 0), C.darkMetal)
		pivot.Name = "Pivot"
		beam.PrimaryPart = pivot
		plank(0.6, 0.7, d - 1.4, CFrame.new(0, G + 5.6, 0), C.orange)
		plank(0.9, 2.2, 1, CFrame.new(0, G + 5.2, -d / 2 + 1), C.orange) -- horse head
		plank(1, 1.2, 1, CFrame.new(0, G + 5.2, d / 2 - 1.2), C.darkMetal)
	end)
	noCollide(blk(0.2, 4.5, 0.2, 0, G, -d / 2 + 0.9, C.black)) -- polished rod
	local _ = w
end

Styles.oilTank = function(w, d, _p)
	for _, o in { Vector2.new(-1, -1), Vector2.new(1, -1), Vector2.new(-1, 1), Vector2.new(1, 1) } do
		local x, z = o.X * w / 4, o.Y * d / 4
		cyl(5, w / 2 - 1, x, G, z, C.white)
		cyl(0.3, w / 2 - 0.9, x, G + 5, z, C.metal)
	end
end

Styles.refinery = function(w, d, p)
	local s = p.scale or 1
	-- control building
	blk(w * 0.3, 5, d * 0.25, -w * 0.3, G, -d * 0.33, C.wall)
	windows(w * 0.3, d * 0.25, -w * 0.3, -d * 0.33, G + 1, 1, 3.4)
	-- storage tanks
	local tankD = math.min(w, d) * 0.22
	local tanks = { Vector2.new(-0.28, 0.18), Vector2.new(-0.28, -0.05) }
	if s >= 2 then
		table.insert(tanks, Vector2.new(0.32, 0.3))
	end
	if s >= 3 then
		table.insert(tanks, Vector2.new(0.32, 0.05))
	end
	for _, t in tanks do
		cyl(4 + s, tankD, t.X * w, G, t.Y * d, C.white)
		cyl(0.3, tankD + 0.1, t.X * w, G + 4 + s, t.Y * d, C.metal)
	end
	-- distillation columns
	for i = 0, s do
		local x = w * (0.02 + i * 0.09)
		cyl(14 + s * 4 - i * 2, 1.8, x, G, -d * 0.12, C.metal)
		cyl(0.6, 2.1, x, G + 6, -d * 0.12, C.darkMetal)
	end
	-- pipe rack
	blk(w * 0.7, 0.5, 1.2, 0, G + 3, d * 0.05, C.steel)
	for i = 0, 4 do
		noCollide(blk(0.4, 3, 0.4, -w * 0.35 + i * w * 0.175, G, d * 0.05, C.steel))
	end
	-- flare stack
	cyl(16 + s * 4, 0.8, w * 0.4, G, -d * 0.38, C.metal)
	cyl(1.2, 1, w * 0.4, G + 16 + s * 4, -d * 0.38, C.red)
end

Styles.steelMill = function(w, d, _p)
	blk(w * 0.7, 12, d * 0.65, -w * 0.1, G, 0, C.steel)
	blk(w * 0.7 + 0.2, 1, d * 0.65 + 0.2, -w * 0.1, G + 8, 0, C.orange)
	gableRoof(w * 0.7, d * 0.65, -w * 0.1, G + 12, 0, C.darkMetal, 14)
	for i = 0, 2 do
		cyl(26, 1.8, w * 0.36, G, -d * 0.3 + i * d * 0.3, C.darkMetal)
		cyl(1, 2, w * 0.36, G + 22, -d * 0.3 + i * d * 0.3, C.orange)
	end
	plank(w * 0.4, 0.6, 1.2, CFrame.new(w * 0.15, G + 6, -d * 0.4) * CFrame.Angles(0, 0, math.rad(-18)), C.darkMetal)
end

Styles.warehouse = function(w, d, _p)
	blk(w - 1.2, 7, d - 1.2, 0, G, 0, C.wallCool)
	gableRoof(w - 1.2, d - 1.2, 0, G + 7, 0, C.roofGrey, 12)
	local doors = math.max(2, math.floor(w / 8))
	for i = 1, doors do
		local x = -w / 2 + (i - 0.5) * (w / doors)
		noCollide(blk(3, 4.5, 0.25, x, G, -d / 2 + 0.5, C.darkMetal))
	end
end

Styles.factory = function(w, d, p)
	local military = p.tint == "military"
	local wallC = military and rgb(150, 154, 132) or C.wallWarm
	local roofC = military and C.oliveDark or C.roofGrey
	local bw, bd = w - 1.6, d - 1.6
	local h = p.large and 10 or 8
	blk(bw, h, bd, 0, G, 0, wallC)
	-- sawtooth roof
	local teeth = math.max(2, math.floor(bd / 6))
	local step = bd / teeth
	for i = 0, teeth - 1 do
		local z = -bd / 2 + (i + 0.5) * step
		plank(bw, 0.4, step / math.cos(math.rad(30)), CFrame.new(0, G + h + step * 0.29, z) * CFrame.Angles(math.rad(-30), 0, 0), roofC)
		noCollide(blk(bw - 0.4, step * 0.55, 0.2, 0, G + h, z + step / 2 - 0.15, C.glass))
	end
	noCollide(blk(bw - 2, 1.4, 0.2, 0, G + 3, -bd / 2 - 0.1, C.window))
	for i = 1, (p.large and 3 or 2) do
		noCollide(blk(3.4, 4.4, 0.3, -bw / 2 + i * bw / ((p.large and 3 or 2) + 1), G, bd / 2 + 0.1, C.darkMetal))
	end
	cyl(h + 10, 1.6, bw / 2 - 2, G, -bd / 2 + 2, military and C.oliveDark or C.brick)
	if military then
		blk(4, 0.2, 4, -bw / 2 + 3, G + h + 0.1, -bd / 2 + 3, C.red).CanCollide = false
	end
end

Styles.shop = function(w, d, _p)
	local bw, bd = w - 1.4, d - 1.4
	blk(bw, 4.6, bd, 0, G, 0, C.wall)
	blk(bw + 0.2, 0.4, bd + 0.2, 0, G + 4.6, 0, C.roofGrey)
	noCollide(blk(bw - 1, 2.6, 0.2, 0, G + 0.6, -bd / 2 - 0.1, C.glass))
	local awning = noCollide(plank(bw, 0.2, 1.8, CFrame.new(0, G + 3.6, -bd / 2 - 0.8) * CFrame.Angles(math.rad(18), 0, 0), C.red))
	awning.Name = "Awning"
	noCollide(blk(bw * 0.7, 0.9, 0.25, 0, G + 4.8, -bd / 2 + 0.2, C.yellow))
end

Styles.park = function(w, d, _p)
	local b = M.PrimaryPart :: BasePart
	b.Color = C.grass
	b.Material = Enum.Material.Grass
	noCollide(blk(w - 0.5, 0.06, 1.2, 0, G, 0, rgb(214, 200, 168)))
	noCollide(blk(1.2, 0.06, d - 0.5, 0, G, 0, rgb(214, 200, 168)))
	tree(-w / 4, -d / 4, 1)
	tree(w / 4, d / 4, 1.2)
	tree(w / 4, -d / 4, 0.9)
	cyl(0.15, w / 3, -w / 4, G, d / 4, C.water, Enum.Material.Glass).CanCollide = false
	noCollide(blk(1.6, 0.5, 0.5, 2, G + 0.3, -1.2, C.trunk))
end

Styles.office = function(w, d, p)
	local floors = p.floors or 8
	local fh = 3.4
	local bw, bd = w - 1.6, d - 1.6
	blk(bw, floors * fh, bd, 0, G, 0, C.glass, Enum.Material.Glass).Transparency = 0
	for f = 1, floors do
		noCollide(blk(bw + 0.2, 0.5, bd + 0.2, 0, G + f * fh - 0.5, 0, C.wallCool))
	end
	blk(bw - 2, 2, bd - 2, 0, G + floors * fh, 0, C.metal)
end

Styles.school = function(w, d, _p)
	blk(w * 0.9, 7, d * 0.35, 0, G, -d * 0.28, C.brick)
	windows(w * 0.9, d * 0.35, 0, -d * 0.28, G + 0.8, 2, 3.2, C.window)
	blk(w * 0.9 + 0.3, 0.5, d * 0.35 + 0.3, 0, G + 7, -d * 0.28, C.roofGrey)
	-- sports field
	noCollide(blk(w * 0.7, 0.08, d * 0.45, 0, G, d * 0.2, C.grass, Enum.Material.Grass))
	noCollide(blk(0.2, 0.1, d * 0.45, 0, G, d * 0.2, C.line))
	noCollide(cyl(9, 0.25, w * 0.42, G, d * 0.42, C.metal))
	noCollide(blk(0.1, 1.4, 2.2, w * 0.42, G + 7.4, d * 0.42 - 1.1, C.blue))
end

Styles.hospital = function(w, d, _p)
	blk(w * 0.8, 10, d * 0.45, 0, G, -d * 0.18, C.white)
	windows(w * 0.8, d * 0.45, 0, -d * 0.18, G + 0.8, 3, 3.1, C.glass)
	blk(w * 0.35, 6, d * 0.35, -w * 0.2, G, d * 0.25, C.white)
	local top = G + 10
	noCollide(blk(5, 0.15, 1.4, 0, top, -d * 0.18, C.red))
	noCollide(blk(1.4, 0.15, 5, 0, top, -d * 0.18, C.red))
	noCollide(cyl(0.1, 6, w * 0.25, G, d * 0.25, C.darkMetal))
	noCollide(blk(2.4, 0.12, 0.4, w * 0.25, G + 0.1, d * 0.25, C.line))
end

Styles.billboard = function(w, _d, _p)
	blk(0.4, 6, 0.4, -w / 3, G, 0, C.darkMetal)
	blk(0.4, 6, 0.4, w / 3, G, 0, C.darkMetal)
	local board = blk(w - 0.2, 4.2, 0.4, 0, G + 5, 0, C.white)
	board.Name = "Board"
	for _, face in { Enum.NormalId.Front, Enum.NormalId.Back } do
		local gui = Instance.new("SurfaceGui")
		gui.Face = face
		gui.CanvasSize = Vector2.new(400, 110)
		gui.LightInfluence = 0.2
		gui.Parent = board
		local label = Instance.new("TextLabel")
		label.Name = "Message"
		label.Size = UDim2.fromScale(1, 1)
		label.BackgroundColor3 = rgb(250, 248, 240)
		label.TextColor3 = rgb(28, 34, 46)
		label.TextScaled = true
		label.FontFace = Font.new("rbxasset://fonts/families/TitilliumWeb.json", Enum.FontWeight.Bold)
		label.Text = "YOUR AD HERE"
		label.Parent = gui
		local pad = Instance.new("UIPadding")
		pad.PaddingLeft = UDim.new(0, 12)
		pad.PaddingRight = UDim.new(0, 12)
		pad.Parent = label
	end
end

Styles.researchLab = function(w, d, _p)
	blk(w * 0.8, 6, d * 0.6, 0, G, -d * 0.1, C.white)
	windows(w * 0.8, d * 0.6, 0, -d * 0.1, G + 0.8, 1, 4, C.glass)
	ball(5.5, w * 0.15, G + 6, -d * 0.1, C.wallCool)
	noCollide(cyl(5, 0.25, -w * 0.25, G + 6, -d * 0.2, C.metal))
	noCollide(blk(w * 0.8, 0.06, d * 0.25, 0, G, d * 0.32, C.grass, Enum.Material.Grass))
end

Styles.university = function(w, d, _p)
	blk(w * 0.85, 9, d * 0.5, 0, G, d * 0.05, C.wallWarm)
	windows(w * 0.85, d * 0.5, 0, d * 0.05, G + 1, 2, 3.6, C.window)
	blk(w * 0.4, 1.2, 3, 0, G, -d * 0.25, C.pad)
	for i = 0, 5 do
		cyl(8, 0.9, -w * 0.17 + i * w * 0.068, G + 1.2, -d * 0.25, C.white)
	end
	blk(w * 0.42, 1.4, 3.4, 0, G + 9, -d * 0.25, C.white)
	ball(7, 0, G + 9, d * 0.05, rgb(120, 160, 150))
end

Styles.milResearch = function(w, d, _p)
	blk(w * 0.75, 5, d * 0.5, -w * 0.05, G, -d * 0.12, rgb(140, 146, 124))
	blk(w * 0.75 + 0.3, 0.5, d * 0.5 + 0.3, -w * 0.05, G + 5, -d * 0.12, C.oliveDark)
	windows(w * 0.75, d * 0.5, -w * 0.05, -d * 0.12, G + 1, 1, 3.4)
	for i, x in { -w * 0.25, w * 0.05 } do
		noCollide(cyl(1.6, 0.8, x, G, d * 0.3, C.metal))
		plank(5 - i, 0.3, 5 - i, CFrame.new(x, G + 3, d * 0.3) * CFrame.Angles(math.rad(-35), 0, 0), C.white)
	end
	noCollide(cyl(16, 0.35, w * 0.35, G, d * 0.3, C.metal))
	noCollide(ball(0.6, w * 0.35, G + 16.2, d * 0.3, C.red, Enum.Material.Neon))
end

Styles.depot = function(w, d, _p)
	blk(w - 1.4, 6, d * 0.55, 0, G, d * 0.15, rgb(150, 154, 132))
	blk(w - 1.2, 0.5, d * 0.55 + 0.2, 0, G + 6, d * 0.15, C.oliveDark)
	local doors = 4
	for i = 1, doors do
		local x = -w / 2 + 0.7 + (i - 0.5) * ((w - 1.4) / doors)
		noCollide(blk(((w - 1.4) / doors) - 1, 4.6, 0.25, x, G, d * 0.15 - d * 0.275 - 0.1, C.darkMetal))
	end
	noCollide(blk(w - 1, 0.06, d * 0.35, 0, G, -d * 0.28, C.asphalt))
end

Styles.radar = function(_w, _d, _p)
	blk(3, 3, 3, 0, G, 0, rgb(150, 154, 132))
	cyl(8, 1.2, 0, G + 3, 0, C.metal)
	local dish = spinGroup("Dish", 1.2, "Y")
	into(dish, function()
		local hub = plank(1, 1, 1, CFrame.new(0, G + 11.5, 0), C.metal)
		hub.Name = "Hub"
		dish.PrimaryPart = hub
		plank(7, 3, 0.3, CFrame.new(0, G + 12.2, 0) * CFrame.Angles(math.rad(-15), 0, 0), C.white)
	end)
end

local function factionColor(p: { [string]: any }): Color3
	if p.eastern then
		return C.eastern
	elseif p.european then
		return C.european
	elseif p.tint == "sand" then
		return C.sand
	elseif p.tint == "dark" then
		return rgb(66, 70, 74)
	elseif p.tint == "eastern" then
		return C.eastern
	elseif p.tint == "european" then
		return C.european
	end
	return C.olive
end

Styles.ciws = function(_w, _d, p)
	local col = factionColor(p)
	cyl(1, 6, 0, G, 0, C.pad)
	cyl(2, 2.6, 0, G + 1, 0, col)
	blk(2.6, 1.8, 2.6, 0, G + 3, 0, col)
	axleCyl(3.4, 0.5, CFrame.new(0, G + 3.9, -2.6) * CFrame.Angles(0, math.rad(90), 0) * CFrame.Angles(0, 0, math.rad(20)), C.darkMetal)
	ball(2.2, 0, G + 5.4, 0.4, C.white)
end

local function launcherTruck(len: number, col: Color3)
	blk(3.2, 1.2, len, 0, G + 0.9, 0, col)
	blk(3.2, 2.2, 2.6, 0, G + 0.9, -len / 2 + 1.3, col) -- cab
	noCollide(blk(2.8, 0.8, 0.15, 0, G + 2.2, -len / 2 - 0.02, C.window))
	local axles = math.max(2, math.floor(len / 2.6))
	for i = 0, axles - 1 do
		wheelPair(0, G + 0.75, -len / 2 + 1.2 + i * ((len - 2.4) / (axles - 1)), 3.3, 1.5)
	end
end

Styles.sam = function(w, d, p)
	local col = factionColor(p)
	local count = p.large and 2 or 1
	for i = 1, count do
		local x = count == 1 and -w * 0.12 or (-w * 0.3 + (i - 1) * w * 0.32)
		local len = d * 0.7
		local unit = Instance.new("Model")
		unit.Name = "Launcher" .. i
		unit.Parent = M
		into(unit, function()
			launcherTruck(len, col)
			local tubeCF = CFrame.new(0, G + 4, len * 0.12) * CFrame.Angles(math.rad(50), 0, 0)
			for tx = -1, 1, 2 do
				plank(1.2, 1.2, len * 0.55, tubeCF * CFrame.new(tx * 0.7, 0.6, 0), col)
				plank(1.2, 1.2, len * 0.55, tubeCF * CFrame.new(tx * 0.7, -0.6, 0), col)
			end
		end)
		unit:TranslateBy(Vector3.new(x, 0, 0))
	end
	-- radar truck
	local rx = w * 0.32
	blk(2.6, 1.2, d * 0.45, rx, G + 0.6, d * 0.1, col)
	plank(3.6, 3.2, 0.4, CFrame.new(rx, G + 4, d * 0.1) * CFrame.Angles(math.rad(-20), 0, 0), C.white)
end

Styles.laser = function(_w, _d, _p)
	cyl(1.2, 8, 0, G, 0, C.pad)
	cyl(3, 3.6, 0, G + 1.2, 0, C.metal)
	blk(3.4, 2.8, 3.4, 0, G + 4.2, 0, C.wall)
	local lens = axleCyl(1.6, 2.2, CFrame.new(0, G + 5.6, -2) * CFrame.Angles(0, math.rad(90), 0), rgb(120, 200, 255), Enum.Material.Neon)
	lens.Name = "Lens"
end

Styles.launcher = function(w, d, p)
	local col = factionColor(p)
	local len = d - 1.2
	launcherTruck(len, col)
	if p.kind == "box" then
		local boxCF = CFrame.new(0, G + 3.6, len * 0.12) * CFrame.Angles(math.rad(25), 0, 0)
		plank(3, 2.4, len * 0.62, boxCF, col)
		for ix = -1, 1, 2 do
			for iy = -1, 1, 2 do
				noCollide(plank(0.9, 0.9, 0.2, boxCF * CFrame.new(ix * 0.7, iy * 0.55, -len * 0.31 - 0.05), C.black))
			end
		end
	else
		local h = p.big and 18 or 14
		local z = len * 0.22
		-- erector frame
		blk(0.4, h * 0.85, 0.4, -1.3, G + 2, z + 1.2, C.darkMetal)
		blk(0.4, h * 0.85, 0.4, 1.3, G + 2, z + 1.2, C.darkMetal)
		cyl(h, p.big and 1.9 or 1.5, 0, G + 2, z, rgb(220, 222, 214))
		ball(p.big and 1.9 or 1.5, 0, G + 2 + h, z, C.darkMetal)
		cyl(1.2, (p.big and 1.9 or 1.5) + 0.1, 0, G + 2 + h * 0.55, z, col)
	end
	local _ = w
end

local function deltaDrone(cf: CFrame, s: number, color: Color3)
	plank(0.5 * s, 0.4 * s, 3.2 * s, cf, color)
	plank(4.2 * s, 0.15 * s, 1.2 * s, cf * CFrame.new(0, 0, 0.6 * s) * CFrame.Angles(0, math.rad(25), 0), color)
	plank(4.2 * s, 0.15 * s, 1.2 * s, cf * CFrame.new(0, 0, 0.6 * s) * CFrame.Angles(0, math.rad(-25), 0), color)
end

Styles.droneRack = function(w, d, p)
	local n = p.big and 4 or 2
	blk(w - 1, 1, d - 1, 0, G, 0, C.oliveDark)
	for i = 1, n do
		local x = -w / 2 + 0.5 + (i - 0.5) * ((w - 1) / n)
		local cf = CFrame.new(x, G + 3.2, 0) * CFrame.Angles(math.rad(30), 0, 0)
		plank(0.6, 0.3, d - 2, cf * CFrame.new(0, -0.4, 0), C.darkMetal)
		deltaDrone(cf, 0.8, rgb(170, 172, 164))
		noCollide(blk(0.3, 2.4, 0.3, x, G + 1, d / 2 - 2, C.darkMetal))
	end
end

Styles.droneRamp = function(w, d, p)
	local col = p.tint == "european" and C.european or C.olive
	plank(2.6, 0.5, d - 1.5, CFrame.new(0, G + 2.4, 0) * CFrame.Angles(math.rad(14), 0, 0), C.darkMetal)
	blk(1, 2, 1, 0, G, d / 2 - 1.5, C.darkMetal)
	local cf = CFrame.new(0, G + 3.4, -d * 0.1) * CFrame.Angles(math.rad(14), 0, 0)
	axleCyl(5, 1.1, cf * CFrame.Angles(0, math.rad(90), 0), col)
	plank(6, 0.2, 1.6, cf * CFrame.new(0, 0, 0.4), col)
	plank(2.2, 0.2, 0.8, cf * CFrame.new(0, 0, 2.2), col)
	blk(w * 0.3, 3, 4, w * 0.3, G, d * 0.3, rgb(150, 154, 132))
end

---------------------------------------------------------------------------
-- Public: buildings
---------------------------------------------------------------------------
function ModelBuilder.building(def: { id: string, model: string, size: { number }, params: { [string]: any }? }): Model
	local model = Instance.new("Model")
	model.Name = def.id
	M = model
	local w, d = def.size[1] * CELL, def.size[2] * CELL
	if def.model ~= "road" then
		base(w - 0.2, d - 0.2, (def.model == "park") and C.grass or C.concrete)
	end
	local style = Styles[def.model]
	if style then
		style(w, d, def.params or {})
	else
		blk(w - 2, 4, d - 2, 0, G, 0, C.wall)
	end
	return model
end

---------------------------------------------------------------------------
-- Units (vehicles), front = -Z
---------------------------------------------------------------------------
local function root(sx: number, sy: number, sz: number): Part
	local r = Instance.new("Part")
	r.Name = "Root"
	r.Size = Vector3.new(sx, sy, sz)
	r.CFrame = CFrame.new(0, sy / 2, 0)
	r.Transparency = 1
	r.CanCollide = false
	r.CanTouch = false
	r.Anchored = true
	r.Parent = M
	M.PrimaryPart = r
	return r
end

local function tracks(len: number, width: number)
	blk(1, 1.4, len, -width / 2 + 0.5, 0, 0, C.black)
	blk(1, 1.4, len, width / 2 - 0.5, 0, 0, C.black)
end

local UnitStyles: { [string]: (p: { [string]: any }, col: Color3) -> () } = {}

UnitStyles.truck = function(_p, col)
	root(3.6, 3.4, 8)
	blk(3.2, 2.4, 2.4, 0, 0.8, -2.6, col)
	noCollide(blk(2.8, 0.8, 0.15, 0, 2.1, -3.82, C.window))
	blk(3.4, 2.6, 5, 0, 0.8, 1.2, rgb(120, 126, 98))
	wheelPair(0, 0.75, -2.6, 3.3, 1.5)
	wheelPair(0, 0.75, 0.6, 3.3, 1.5)
	wheelPair(0, 0.75, 2.6, 3.3, 1.5)
end

UnitStyles.ifv = function(p, col)
	root(4.4, 3.6, 9)
	if p.wheeled then
		for _, z in { -3, -1, 1, 3 } do
			wheelPair(0, 0.8, z, 4.1, 1.6)
		end
		blk(3.8, 1.8, 8.6, 0, 0.9, 0, col)
	else
		tracks(8.6, 4.4)
		blk(3.6, 1.8, 8.6, 0, 0.6, 0, col)
	end
	plank(3.6, 0.3, 2.2, CFrame.new(0, 2.2, -4.2) * CFrame.Angles(math.rad(-30), 0, 0), col)
	blk(2.2, 1, 2.6, 0, 2.6, -0.5, col)
	axleCyl(3.2, 0.3, CFrame.new(0, 3.1, -3.2) * CFrame.Angles(0, math.rad(90), 0), C.darkMetal)
end

UnitStyles.tank = function(_p, col)
	root(5, 3.8, 10)
	tracks(9.6, 5)
	blk(4, 1.6, 9.6, 0, 0.7, 0, col)
	blk(3.4, 1.3, 4, 0, 2.3, 0.6, col)
	axleCyl(6, 0.45, CFrame.new(0, 2.9, -4.2) * CFrame.Angles(0, math.rad(90), 0), col)
end

UnitStyles.mlrs = function(p, col)
	root(3.8, 4, 9.6)
	blk(3.2, 1, 9, 0, 0.8, 0, col)
	blk(3.2, 2.2, 2.4, 0, 1.8, -3.3, col)
	noCollide(blk(2.8, 0.8, 0.15, 0, 3, -4.52, C.window))
	for _, z in { -3.3, 1.2, 3.4 } do
		wheelPair(0, 0.75, z, 3.3, 1.5)
	end
	if p.gun then
		axleCyl(7, 0.5, CFrame.new(0, 2.8, 0.4) * CFrame.Angles(0, math.rad(90), 0) * CFrame.Angles(0, 0, math.rad(-12)), C.darkMetal)
	else
		local pod = plank(3, 2, 4.4, CFrame.new(0, 3, 1.8) * CFrame.Angles(math.rad(12), 0, 0), col)
		pod.Name = "Pod"
		noCollide(plank(2.4, 1.4, 0.2, CFrame.new(0, 3.5, -0.42) * CFrame.Angles(math.rad(12), 0, 0), C.black))
	end
end

UnitStyles.spaag = function(_p, col)
	root(4.6, 4.4, 9)
	tracks(8.6, 4.6)
	blk(3.8, 1.6, 8.6, 0, 0.7, 0, col)
	blk(3, 1.6, 3.2, 0, 2.3, 0.4, col)
	axleCyl(3.6, 0.3, CFrame.new(-1.7, 3, -1.6) * CFrame.Angles(0, math.rad(90), 0), C.darkMetal)
	axleCyl(3.6, 0.3, CFrame.new(1.7, 3, -1.6) * CFrame.Angles(0, math.rad(90), 0), C.darkMetal)
	plank(2, 1.4, 0.2, CFrame.new(0, 4.4, 1.6), C.white)
end

function ModelBuilder.unit(def: { id: string, model: string, params: { [string]: any }? }): Model
	local model = Instance.new("Model")
	model.Name = def.id
	M = model
	local p = def.params or {}
	local col = p.eastern and C.eastern or (p.european and C.european or C.olive)
	local style = UnitStyles[def.model] or UnitStyles.truck
	style(p, col)
	for _, part in model:GetDescendants() do
		if part:IsA("BasePart") then
			part.CanCollide = false
			part.Anchored = true
		end
	end
	return model
end

---------------------------------------------------------------------------
-- Projectiles (client visuals), forward = -Z
---------------------------------------------------------------------------
function ModelBuilder.projectile(def: { kind: string, color: Color3, id: string }): Model
	local model = Instance.new("Model")
	model.Name = def.id
	M = model
	local r = root(1, 1, 1)
	r.CFrame = CFrame.new()
	if def.kind == "drone" then
		if def.id == "RAPTOR" then
			axleCyl(4.4, 0.9, CFrame.Angles(0, math.rad(90), 0), def.color)
			plank(5, 0.15, 1.4, CFrame.new(0, 0, 0.6), def.color)
			plank(2, 0.15, 0.7, CFrame.new(0, 0, 2), def.color)
		else
			deltaDrone(CFrame.new(), 1, def.color)
		end
	else
		local len = def.id == "MRBM" and 7 or (def.id == "GLCM" and 4.5 or 6)
		axleCyl(len, 0.9, CFrame.Angles(0, math.rad(90), 0), def.color)
		ball(0.9, 0, 0, -len / 2, def.color)
		for k = 0, 3 do
			plank(0.12, 1.2, 1, CFrame.new(0, 0, len / 2 - 0.5) * CFrame.Angles(0, 0, math.rad(45 + k * 90)) * CFrame.new(0, 0.6, 0), C.darkMetal)
		end
		if def.id == "GLCM" then
			plank(3, 0.1, 0.6, CFrame.new(0, 0, 0.2), def.color)
		end
	end
	local tail = Instance.new("Attachment")
	tail.Name = "Tail"
	tail.Position = Vector3.new(0, 0, 2.6)
	tail.Parent = r
	for _, part in model:GetDescendants() do
		if part:IsA("BasePart") then
			part.CanCollide = false
			part.CanQuery = false
			part.CastShadow = false
		end
	end
	return model
end

function ModelBuilder.fuelTruck(): Model
	local model = Instance.new("Model")
	model.Name = "FuelTruck"
	M = model
	root(3.4, 3.6, 8)
	blk(3, 2.2, 2.2, 0, 0.8, -2.8, C.white)
	noCollide(blk(2.6, 0.8, 0.15, 0, 2, -3.92, C.window))
	blk(3, 0.6, 5.6, 0, 0.7, 0.9, C.darkMetal)
	axleCyl(5, 2.6, CFrame.new(0, 2.6, 0.9) * CFrame.Angles(0, math.rad(90), 0), C.white)
	noCollide(blk(3.1, 0.4, 2, 0, 2.4, 0.9, C.orange))
	wheelPair(0, 0.7, -2.8, 3.1, 1.4)
	wheelPair(0, 0.7, 1.4, 3.1, 1.4)
	wheelPair(0, 0.7, 3, 3.1, 1.4)
	for _, part in model:GetDescendants() do
		if part:IsA("BasePart") then
			part.CanCollide = false
			part.CanQuery = false
		end
	end
	return model
end

---------------------------------------------------------------------------
-- Mainland strategic point structures (size in studs)
---------------------------------------------------------------------------
local PointStyles: { [string]: (s: number) -> () } = {}

PointStyles.city = function(s)
	local rng = Random.new(7)
	for i = 1, 22 do
		local x = rng:NextNumber(-s / 2.4, s / 2.4)
		local z = rng:NextNumber(-s / 2.4, s / 2.4)
		local h = rng:NextNumber(5, 22)
		local w = rng:NextNumber(6, 12)
		blk(w, h, w * rng:NextNumber(0.8, 1.4), x, 0, z, i % 3 == 0 and C.wallWarm or C.wallCool)
		blk(w * 0.9, 0.4, w * 0.9, x, h, z, C.roofGrey)
	end
	blk(s * 0.9, 0.2, 5, 0, 0, 0, C.asphalt)
	blk(5, 0.2, s * 0.9, 0, 0, 0, C.asphalt)
end

PointStyles.airport = function(s)
	blk(14, 0.3, s * 1.4, 0, 0, 0, C.asphalt)
	blk(6, 0.3, s * 1.2, 22, 0, 0, C.asphalt)
	for i = -6, 6 do
		noCollide(blk(0.8, 0.1, 6, 0, 0.3, i * s / 10, C.line))
	end
	for i = 0, 4 do
		local z = -s * 0.5 + i * s * 0.25
		blk(14, 7, 12, -26, 0, z, C.wallCool)
		gableRoof(14, 12, -26, 7, z, C.roofGrey, 14)
	end
	cyl(18, 3, -18, 0, s * 0.62, C.white)
	blk(6, 3, 6, -18, 18, s * 0.62, C.glass)
end

PointStyles.oilField = function(s)
	local rng = Random.new(3)
	for _ = 1, 9 do
		local x, z = rng:NextNumber(-s / 2.4, s / 2.4), rng:NextNumber(-s / 2.4, s / 2.4)
		blk(2.4, 0.6, 9, x, 0, z, C.darkMetal)
		blk(0.6, 0.7, 9, x, 5, z, C.orange)
		blk(0.6, 5, 0.6, x, 0, z, C.darkMetal)
	end
	for i = 0, 2 do
		cyl(6, 10, s * 0.35, 0, -s * 0.3 + i * 13, C.white)
	end
end

PointStyles.nuclear = function(s)
	local prev = G
	coolingTower(-s * 0.2, 0, 1.6)
	coolingTower(s * 0.12, -s * 0.1, 1.6)
	cyl(12, 16, s * 0.3, 0, s * 0.25, C.wall)
	ball(16, s * 0.3, 12, s * 0.25, C.wall)
	blk(s * 0.5, 9, 14, -s * 0.05, 0, s * 0.3, C.wallCool)
	local _ = prev
end

PointStyles.port = function(s)
	blk(s, 2, s * 0.35, 0, -1.6, -s * 0.2, C.concrete)
	local rng = Random.new(5)
	local colors = { C.red, C.blue, C.orange, C.olive, C.white }
	for i = 1, 26 do
		local x = rng:NextNumber(-s / 2.3, s / 2.3)
		local z = rng:NextNumber(-s * 0.3, -s * 0.08)
		blk(3, 3, 7, x, 0.4, z, colors[(i % #colors) + 1])
	end
	for i = 0, 2 do
		local x = -s * 0.3 + i * s * 0.3
		blk(1.2, 22, 1.2, x - 3, 0, -s * 0.34, C.orange)
		blk(1.2, 22, 1.2, x + 3, 0, -s * 0.34, C.orange)
		blk(1.2, 1.2, 24, x, 22, -s * 0.34 + 6, C.orange)
	end
end

PointStyles.base = function(s)
	for i = 0, 2 do
		local x = -s * 0.3 + i * s * 0.3
		blk(16, 8, 14, x, 0, -s * 0.15, rgb(150, 154, 132))
		gableRoof(16, 14, x, 8, -s * 0.15, C.oliveDark, 16)
	end
	cyl(0.3, 18, s * 0.25, 0, s * 0.25, C.asphalt)
	cyl(18, 0.6, -s * 0.35, 0, s * 0.3, C.metal)
	-- perimeter wall
	for _, side in { -1, 1 } do
		blk(s, 3, 1, 0, 0, side * s / 2, C.pad)
		blk(1, 3, s, side * s / 2, 0, 0, C.pad)
	end
end

function ModelBuilder.warPoint(style: string, size: number): Model
	local model = Instance.new("Model")
	model.Name = style
	M = model
	local prevG = G
	G = 0
	local fn = PointStyles[style] or PointStyles.city
	fn(size)
	G = prevG
	local center = Instance.new("Part")
	center.Name = "Base"
	center.Anchored = true
	center.Size = Vector3.new(size, 0.2, size)
	center.CFrame = CFrame.new(0, -0.1, 0)
	center.Transparency = 1
	center.CanCollide = false
	center.Parent = model
	model.PrimaryPart = center
	return model
end

---------------------------------------------------------------------------
-- States
---------------------------------------------------------------------------
-- Under construction: show the building as a translucent blueprint.
function ModelBuilder.setConstruction(model: Model, on: boolean)
	for _, d in model:GetDescendants() do
		if d:IsA("BasePart") and d.Name ~= "Base" and d.Name ~= "Root" then
			if on then
				if d:GetAttribute("T0") == nil then
					d:SetAttribute("T0", d.Transparency)
					d:SetAttribute("C0", d.CanCollide)
				end
				d.Transparency = math.max(d.Transparency, 0.7)
				d.CanCollide = false
			else
				local t0 = d:GetAttribute("T0")
				if t0 ~= nil then
					d.Transparency = t0 :: number
					d.CanCollide = d:GetAttribute("C0") == true
					d:SetAttribute("T0", nil)
					d:SetAttribute("C0", nil)
				end
			end
		end
	end
end

-- Damaged by a strike: scorched colours + smoke until repaired.
function ModelBuilder.setDamaged(model: Model, on: boolean)
	for _, d in model:GetDescendants() do
		if d:IsA("BasePart") and d.Name ~= "Root" then
			if on then
				if d:GetAttribute("Col0") == nil then
					d:SetAttribute("Col0", d.Color)
				end
				d.Color = (d:GetAttribute("Col0") :: Color3):Lerp(Color3.new(0.12, 0.11, 0.1), 0.6)
			else
				local c0 = d:GetAttribute("Col0")
				if c0 ~= nil then
					d.Color = c0 :: Color3
					d:SetAttribute("Col0", nil)
				end
			end
		end
	end
	local base = model.PrimaryPart
	if not base then
		return
	end
	local existing = base:FindFirstChild("DamageSmoke")
	if on and not existing then
		local att = Instance.new("Attachment")
		att.Name = "DamageSmoke"
		att.Position = Vector3.new(0, 4, 0)
		att.Parent = base
		local smoke = Instance.new("ParticleEmitter")
		smoke.Texture = "rbxasset://textures/particles/smoke_main.dds"
		smoke.Color = ColorSequence.new(Color3.fromRGB(60, 60, 60))
		smoke.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 3), NumberSequenceKeypoint.new(1, 9) })
		smoke.Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.4), NumberSequenceKeypoint.new(1, 1) })
		smoke.Lifetime = NumberRange.new(3, 5)
		smoke.Rate = 4
		smoke.Speed = NumberRange.new(4, 7)
		smoke.Parent = att
	elseif not on and existing then
		existing:Destroy()
	end
end

return ModelBuilder
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="17">
        <Properties>
          <string name="Name">Net</string>
          <string name="Source"><![CDATA[--[[
	Net
	Every remote the game uses is declared here. The server creates them on
	boot, the client waits for them. Using a fixed list means a typo is caught
	immediately instead of silently creating a dead remote.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Net = {}

-- Client -> server requests that return a result ({ ok, err, ... }).
Net.Functions = {
	"PlaceBuilding",
	"PlaceMany",
	"DeleteBuilding",
	"MoveBuilding",
	"Undo",
	"RepairBuilding",
	"RepairAll",
	"SetFuelDestination",
	"QueueProduction",
	"CancelProduction",
	"StartResearch",
	"LaunchWeapon",
	"SetPvp",
	"CommandUnits",
	"DeployUnits",
	"RecallUnits",
	"ClaimDaily",
	"ClaimPlaytime",
	"ClaimQuest",
	"ClaimGroup",
	"RedeemCode",
	"SetBillboard",
	"GetSnapshot",
	"StudioPurchase",
}

-- Server -> client pushes.
Net.Events = {
	"State", -- partial state patch for the local player
	"Notify", -- toast message
	"Projectile", -- a missile / drone launched (all clients)
	"ProjectileEnd", -- impact or interception (all clients)
	"Effect", -- one-shot visual effect
	"PurchaseDone", -- a product / pass purchase was granted
}

local folder: Folder? = nil

local function getFolder(): Folder
	if folder then
		return folder
	end
	local result: Folder
	if RunService:IsServer() then
		local existing = ReplicatedStorage:FindFirstChild("Remotes")
		if existing then
			result = existing :: Folder
		else
			local f = Instance.new("Folder")
			f.Name = "Remotes"
			for _, name in Net.Functions do
				local rf = Instance.new("RemoteFunction")
				rf.Name = name
				rf.Parent = f
			end
			for _, name in Net.Events do
				local re = Instance.new("RemoteEvent")
				re.Name = name
				re.Parent = f
			end
			f.Parent = ReplicatedStorage
			result = f
		end
	else
		result = ReplicatedStorage:WaitForChild("Remotes") :: Folder
	end
	folder = result
	return result
end

function Net.fn(name: string): RemoteFunction
	assert(table.find(Net.Functions, name), "Unknown remote function " .. name)
	return getFolder():WaitForChild(name) :: RemoteFunction
end

function Net.event(name: string): RemoteEvent
	assert(table.find(Net.Events, name), "Unknown remote event " .. name)
	return getFolder():WaitForChild(name) :: RemoteEvent
end

-- Server helper: bind a request handler with per-player rate limiting and
-- error isolation so one bad request can never break the remote.
function Net.handle(name: string, handler: (Player, ...any) -> any, maxPerSecond: number?)
	local remote = Net.fn(name)
	local limit = maxPerSecond or 8
	local buckets: { [Player]: { t: number, n: number } } = {}
	remote.OnServerInvoke = function(player: Player, ...)
		local now = os.clock()
		local b = buckets[player]
		if not b or now - b.t >= 1 then
			b = { t = now, n = 0 }
			buckets[player] = b
		end
		b.n += 1
		if b.n > limit then
			return { ok = false, err = "Slow down!" }
		end
		local ok, result = pcall(handler, player, ...)
		if not ok then
			warn(("[Net] %s failed for %s: %s"):format(name, player.Name, tostring(result)))
			return { ok = false, err = "Something went wrong" }
		end
		return result
	end
	game:GetService("Players").PlayerRemoving:Connect(function(p)
		buckets[p] = nil
	end)
end

-- Client helper: invoke a request safely.
function Net.request(name: string, ...): any
	local ok, result = pcall(Net.fn(name).InvokeServer, Net.fn(name), ...)
	if not ok then
		return { ok = false, err = "Connection problem" }
	end
	return result or { ok = false }
end

return Net
]]></string>
        </Properties>
      </Item>
      <Item class="Folder" referent="18">
        <Properties>
          <string name="Name">Util</string>
        </Properties>
        <Item class="ModuleScript" referent="19">
          <Properties>
            <string name="Name">Ballistics</string>
            <string name="Source"><![CDATA[--[[
	Ballistics
	Deterministic flight paths so the server (interception timing) and every
	client (visuals) agree on where a projectile is at any moment.
]]

local Ballistics = {}

local function smooth(t: number): number
	return t * t * (3 - 2 * t)
end

-- Position at progress alpha (0..1).
function Ballistics.position(from: Vector3, to: Vector3, apex: number, kind: string, alpha: number): Vector3
	alpha = math.clamp(alpha, 0, 1)
	local flat = from:Lerp(to, alpha)
	local height: number
	if kind == "drone" or apex < 60 then
		-- climb quickly, cruise, then dive onto the target
		local climb = math.min(1, alpha / 0.12)
		local dive = alpha > 0.85 and (1 - (alpha - 0.85) / 0.15) or 1
		height = apex * smooth(climb) * smooth(math.clamp(dive, 0, 1))
	else
		height = 4 * apex * alpha * (1 - alpha)
	end
	return flat + Vector3.new(0, height, 0)
end

function Ballistics.cframe(from: Vector3, to: Vector3, apex: number, kind: string, alpha: number): CFrame
	local p0 = Ballistics.position(from, to, apex, kind, alpha)
	local p1 = Ballistics.position(from, to, apex, kind, math.min(1, alpha + 0.01))
	if (p1 - p0).Magnitude < 1e-3 then
		p1 = p0 + (to - from).Unit
	end
	return CFrame.lookAt(p0, p1)
end

return Ballistics
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="20">
          <Properties>
            <string name="Name">Format</string>
            <string name="Source"><![CDATA[--[[
	Format
	Number / time formatting helpers shared by client UI and server messages.
]]

local Format = {}

local SUFFIXES = { "", "k", "M", "B", "T", "Qd", "Qn" }

-- 1234 -> "1.2k", 24100000 -> "24.1M"
function Format.short(n: number): string
	local negative = n < 0
	n = math.abs(n)
	local index = 1
	while n >= 1000 and index < #SUFFIXES do
		n /= 1000
		index += 1
	end
	local text
	if index == 1 then
		text = tostring(math.floor(n + 0.5))
	elseif n >= 100 then
		text = string.format("%d%s", math.floor(n), SUFFIXES[index])
	else
		text = string.format("%.1f%s", math.floor(n * 10) / 10, SUFFIXES[index])
		text = text:gsub("%.0" .. SUFFIXES[index] .. "$", SUFFIXES[index])
	end
	return (negative and "-" or "") .. text
end

function Format.cash(n: number): string
	if n < 0 then
		return "-$" .. Format.short(-n)
	end
	return "$" .. Format.short(n)
end

-- 12000 -> "12,000"
function Format.commas(n: number): string
	local s = tostring(math.floor(math.abs(n) + 0.5))
	local formatted = s:reverse():gsub("(%d%d%d)", "%1,"):reverse()
	if formatted:sub(1, 1) == "," then
		formatted = formatted:sub(2)
	end
	return (n < 0 and "-" or "") .. formatted
end

function Format.money(n: number): string
	return "$" .. Format.commas(n)
end

-- 83 -> "01:23"
function Format.clock(seconds: number): string
	seconds = math.max(0, math.floor(seconds))
	local h = seconds // 3600
	local m = (seconds % 3600) // 60
	local s = seconds % 60
	if h > 0 then
		return string.format("%d:%02d:%02d", h, m, s)
	end
	return string.format("%02d:%02d", m, s)
end

-- 48 -> "48s", 130 -> "2m 10s"
function Format.duration(seconds: number): string
	seconds = math.max(0, math.floor(seconds))
	if seconds < 60 then
		return seconds .. "s"
	elseif seconds < 3600 then
		local s = seconds % 60
		return (seconds // 60) .. "m" .. (s > 0 and (" " .. s .. "s") or "")
	end
	local m = (seconds % 3600) // 60
	return (seconds // 3600) .. "h" .. (m > 0 and (" " .. m .. "m") or "")
end

function Format.rate(n: number): string
	local sign = n >= 0 and "+" or ""
	return sign .. Format.short(n) .. " / Min"
end

function Format.percent(n: number): string
	return math.floor(n + 0.5) .. "%"
end

return Format
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="21">
          <Properties>
            <string name="Name">Grid</string>
            <string name="Source"><![CDATA[--[[
	Grid
	Plot layout and cell <-> world conversion. Shared so the client placement
	ghost and the server validation always agree.
]]

local Config = require(script.Parent.Parent.Config)

local Grid = {}

local CELL = Config.CellSize
local N = Config.PlotCells

Grid.CellSize = CELL
Grid.PlotCells = N
Grid.PlotSize = N * CELL

-- World-space center of plot `index` (1-based) at ground height.
function Grid.plotOrigin(index: number): Vector3
	local i = index - 1
	local row = i // Config.PlotRowLength
	local col = i % Config.PlotRowLength
	local pitch = Grid.PlotSize + Config.PlotGap
	local width = (Config.PlotRowLength - 1) * pitch
	return Config.HomelandOrigin + Vector3.new(col * pitch - width / 2, 0, row * pitch)
end

-- Footprint (in cells) after rotation. r = number of quarter turns.
function Grid.footprint(w: number, d: number, r: number): (number, number)
	if r % 2 == 1 then
		return d, w
	end
	return w, d
end

-- Center of a footprint whose min corner is at cell (x, z).
function Grid.cellToWorld(origin: Vector3, x: number, z: number, fw: number, fd: number): Vector3
	return origin + Vector3.new((x + fw / 2 - N / 2) * CELL, 0, (z + fd / 2 - N / 2) * CELL)
end

function Grid.cframeFor(origin: Vector3, x: number, z: number, w: number, d: number, r: number): CFrame
	local fw, fd = Grid.footprint(w, d, r)
	local pos = Grid.cellToWorld(origin, x, z, fw, fd)
	return CFrame.new(pos) * CFrame.Angles(0, math.rad(90 * r), 0)
end

-- Min corner cell for a footprint centered as close as possible to `world`.
function Grid.worldToCell(origin: Vector3, world: Vector3, fw: number, fd: number): (number, number)
	local local_ = world - origin
	local x = math.floor(local_.X / CELL + N / 2 - fw / 2 + 0.5)
	local z = math.floor(local_.Z / CELL + N / 2 - fd / 2 + 0.5)
	return x, z
end

function Grid.inBounds(x: number, z: number, fw: number, fd: number): boolean
	return x >= 0 and z >= 0 and x + fw <= N and z + fd <= N
end

function Grid.key(x: number, z: number): number
	return z * N + x
end

-- Is a world position inside the plot centered at origin (with optional margin)?
function Grid.insidePlot(origin: Vector3, pos: Vector3, margin: number?): boolean
	local half = Grid.PlotSize / 2 + (margin or 0)
	local d = pos - origin
	return math.abs(d.X) <= half and math.abs(d.Z) <= half
end

return Grid
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="22">
          <Properties>
            <string name="Name">Unlocks</string>
            <string name="Source"><![CDATA[--[[
	Unlocks
	One place that answers "can this player use X?" for buildings, weapons and
	units, used by the build menu (locked badges) and the server (validation).
]]

local Unlocks = {}

export type Access = {
	researched: { [string]: boolean },
	passes: { [string]: boolean },
}

-- Returns ok, reason
function Unlocks.check(def: { research: string?, pass: string? }, access: Access): (boolean, string?)
	if def.pass and not access.passes[def.pass] then
		return false, "Requires pass"
	end
	if def.research and not access.researched[def.research] then
		return false, "Research needed"
	end
	return true, nil
end

return Unlocks
]]></string>
          </Properties>
        </Item>
      </Item>
    </Item>
  </Item>
  <Item class="ServerScriptService" referent="23">
    <Properties>
      <string name="Name">ServerScriptService</string>
    </Properties>
    <Item class="Folder" referent="24">
      <Properties>
        <string name="Name">Server</string>
      </Properties>
      <Item class="Script" referent="25">
        <Properties>
          <string name="Name">Main</string>
          <token name="RunContext">0</token>
          <string name="Source"><![CDATA[--[[
	Forge & Frontline - server bootstrap.
	Initialises every service, then creates a runtime Nation for each player
	once their data has loaded, and tears it down (after saving) on leave.
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage.Shared.Config)
local Net = require(ReplicatedStorage.Shared.Net)

local Services = script.Parent.Services
local Nations = require(Services.Nations)

local S = {
	DataService = require(Services.DataService),
	PlotService = require(Services.PlotService),
	StateService = require(Services.StateService),
	BuildService = require(Services.BuildService),
	EconomyService = require(Services.EconomyService),
	LogisticsService = require(Services.LogisticsService),
	ProductionService = require(Services.ProductionService),
	ResearchService = require(Services.ResearchService),
	UnitService = require(Services.UnitService),
	ConquestService = require(Services.ConquestService),
	CombatService = require(Services.CombatService),
	MonetizationService = require(Services.MonetizationService),
	RewardService = require(Services.RewardService),
}

local ORDER = {
	"DataService",
	"PlotService",
	"StateService",
	"BuildService",
	"EconomyService",
	"LogisticsService",
	"ProductionService",
	"ResearchService",
	"UnitService",
	"ConquestService",
	"CombatService",
	"MonetizationService",
	"RewardService",
}

-- Make sure every remote exists before any client asks for it.
for _, name in Net.Functions do
	Net.fn(name)
end

for _, name in ORDER do
	S[name].init(S)
end

local function setupLeaderstats(player: Player)
	local stats = Instance.new("Folder")
	stats.Name = "leaderstats"
	local cash = Instance.new("StringValue")
	cash.Name = "Cash"
	cash.Value = "$0"
	cash.Parent = stats
	local pop = Instance.new("StringValue")
	pop.Name = "Population"
	pop.Value = "0"
	pop.Parent = stats
	stats.Parent = player
end

local Format = require(ReplicatedStorage.Shared.Util.Format)

local function updateLeaderstats(n: Nations.Nation)
	local ls = n.player:FindFirstChild("leaderstats")
	if ls then
		local cash = ls:FindFirstChild("Cash") :: StringValue?
		local pop = ls:FindFirstChild("Population") :: StringValue?
		if cash then
			cash.Value = Format.cash(n.data.Cash)
		end
		if pop then
			pop.Value = Format.short(n.data.Population)
		end
	end
end

local function onLoaded(player: Player, data: { [string]: any })
	local plot = S.PlotService.claim(player)
	if not plot then
		player:Kick("This server is full. Please join another server.")
		return
	end
	local now = Nations.now()
	local n: Nations.Nation = {
		player = player,
		userId = player.UserId,
		data = data,
		plotIndex = plot.index,
		origin = plot.origin,
		folder = plot.buildings,
		buildings = {},
		grid = {},
		stats = {},
		passes = {},
		premium = false,
		joinAt = now,
		nextPayAt = now + Config.PayInterval,
		giftAt = now + Config.PlaytimeGiftInterval,
		pvpLockUntil = 0,
		shieldUntil = data.FirstJoin + Config.NewPlayerShield,
		undo = {},
		units = {},
		nextUnitUid = 1,
		sent = {},
		ready = false,
	}
	Nations.add(n)
	if player.Character then
		player.Character:PivotTo(S.PlotService.spawnCFrame(plot.index))
	end
	player:SetAttribute("Pvp", data.Pvp)
	player:SetAttribute("NationColor", Config.NationColors[plot.index])
	S.MonetizationService.loadPasses(n)
	S.BuildService.loadNation(n)
	if not player.Parent then
		if S.PlotService.get(player) == nil then
			n.folder:ClearAllChildren()
		end
		return
	end
	S.EconomyService.compute(n, 0)
	S.UnitService.loadNation(n)
	S.RewardService.onJoin(n)
	n.ready = true
	S.StateService.push(n, true)
	updateLeaderstats(n)
end

S.DataService.beforeSave(function(player, _data)
	local n = Nations.get(player)
	if n and n.ready then
		S.BuildService.serialize(n)
		S.UnitService.serialize(n)
	end
end)

for _, name in ORDER do
	S[name].start()
end

Players.PlayerAdded:Connect(setupLeaderstats)
for _, p in Players:GetPlayers() do
	setupLeaderstats(p)
end

S.DataService.onLoaded(onLoaded)

Players.PlayerRemoving:Connect(function(player)
	-- serialize + save first (runs synchronously up to the first yield)
	S.DataService.release(player)
	local n = Nations.get(player)
	if n then
		n.ready = false
		S.UnitService.clearNation(n)
		Nations.remove(player)
	end
	S.PlotService.release(player)
end)

-- Leaderboard refresh
task.spawn(function()
	while true do
		task.wait(5)
		for _, n in Nations.all() do
			if n.ready then
				updateLeaderstats(n)
			end
		end
	end
end)

print(("[%s] server ready"):format(Config.GameName))
]]></string>
        </Properties>
      </Item>
      <Item class="Folder" referent="26">
        <Properties>
          <string name="Name">Services</string>
        </Properties>
        <Item class="ModuleScript" referent="27">
          <Properties>
            <string name="Name">BuildService</string>
            <string name="Source"><![CDATA[--[[
	BuildService
	Server-authoritative placement: validates every request against the grid,
	cash, research, passes and limits. Owns building runtime objects, their
	models, construction timers, road connectivity, undo, move and repair.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TextService = game:GetService("TextService")

local Shared = ReplicatedStorage.Shared
local Config = require(Shared.Config)
local Grid = require(Shared.Util.Grid)
local Unlocks = require(Shared.Util.Unlocks)
local Buildings = require(Shared.Catalog.Buildings)
local ModelBuilder = require(Shared.ModelBuilder)
local Net = require(Shared.Net)
local Nations = require(script.Parent.Nations)

type Nation = Nations.Nation
type BRuntime = Nations.BRuntime

local BuildService = {}
local S: { [string]: any }

---------------------------------------------------------------------------
-- Grid helpers
---------------------------------------------------------------------------
local function footprintOf(def, r: number): (number, number)
	return Grid.footprint(def.size[1], def.size[2], r)
end

local function cellsOf(def, x: number, z: number, r: number): { number }
	local fw, fd = footprintOf(def, r)
	local out = {}
	for cx = x, x + fw - 1 do
		for cz = z, z + fd - 1 do
			table.insert(out, Grid.key(cx, cz))
		end
	end
	return out
end

local function isRoadDef(def): boolean
	return def.id == "road" or def.id == "plaza"
end

function BuildService.canPlace(n: Nation, def, x: number, z: number, r: number, ignoreUid: number?): (boolean, string?)
	if typeof(x) ~= "number" or typeof(z) ~= "number" or x ~= x or z ~= z then
		return false, "Invalid position"
	end
	local fw, fd = footprintOf(def, r)
	if not Grid.inBounds(x, z, fw, fd) then
		return false, "Outside your land"
	end
	for _, key in cellsOf(def, x, z, r) do
		local occ = n.grid[key]
		if occ and occ ~= ignoreUid then
			return false, "Space is taken"
		end
	end
	return true, nil
end

local function connectedAt(n: Nation, b: BRuntime): boolean
	if not b.def.needsRoad or isRoadDef(b.def) then
		return true
	end
	local fw, fd = footprintOf(b.def, b.r)
	local function isRoad(cx: number, cz: number): boolean
		if cx < 0 or cz < 0 or cx >= Grid.PlotCells or cz >= Grid.PlotCells then
			return false
		end
		local uid = n.grid[Grid.key(cx, cz)]
		local other = uid and n.buildings[uid]
		return other ~= nil and isRoadDef(other.def) and other.finishAt == nil
	end
	for cx = b.x, b.x + fw - 1 do
		if isRoad(cx, b.z - 1) or isRoad(cx, b.z + fd) then
			return true
		end
	end
	for cz = b.z, b.z + fd - 1 do
		if isRoad(b.x - 1, cz) or isRoad(b.x + fw, cz) then
			return true
		end
	end
	return false
end

function BuildService.recomputeRoads(n: Nation)
	for _, b in n.buildings do
		b.connected = connectedAt(n, b)
		if b.model then
			b.model:SetAttribute("Connected", b.connected)
		end
	end
end

---------------------------------------------------------------------------
-- Models
---------------------------------------------------------------------------
local function applyBillboard(n: Nation, b: BRuntime)
	if not b.def.billboard or not b.model then
		return
	end
	local text = n.data.Billboard ~= "" and n.data.Billboard or (n.player.DisplayName .. " WAS HERE")
	for _, d in b.model:GetDescendants() do
		if d:IsA("TextLabel") and d.Name == "Message" then
			d.Text = text
		end
	end
end

function BuildService.worldCFrame(n: Nation, b: BRuntime): CFrame
	return Grid.cframeFor(n.origin, b.x, b.z, b.def.size[1], b.def.size[2], b.r)
end

local function spawnModel(n: Nation, b: BRuntime)
	if b.model then
		b.model:Destroy()
	end
	local model = ModelBuilder.building(b.def)
	model.Name = tostring(b.uid)
	model:PivotTo(BuildService.worldCFrame(n, b))
	model:SetAttribute("Uid", b.uid)
	model:SetAttribute("BuildingId", b.id)
	model:SetAttribute("OwnerId", n.userId)
	model:SetAttribute("MaxHp", b.def.hp)
	model:SetAttribute("Hp", b.hp)
	model:SetAttribute("Connected", b.connected)
	if b.finishAt then
		model:SetAttribute("BuildStart", b.startAt or Nations.now())
		model:SetAttribute("FinishAt", b.finishAt)
		model:SetAttribute("Status", "Under Construction")
		ModelBuilder.setConstruction(model, true)
	end
	if b.damaged then
		model:SetAttribute("Damaged", true)
		ModelBuilder.setDamaged(model, true)
	end
	model.Parent = n.folder
	b.model = model
	applyBillboard(n, b)
end

---------------------------------------------------------------------------
-- Runtime creation
---------------------------------------------------------------------------
local function newRuntime(n: Nation, def, x: number, z: number, r: number, uid: number?): BRuntime
	local id = uid
	if not id then
		id = n.data.NextUid
		n.data.NextUid += 1
	end
	local b: BRuntime = {
		uid = id :: number,
		id = def.id,
		def = def,
		x = x,
		z = z,
		r = r,
		model = nil,
		finishAt = nil,
		startAt = nil,
		damaged = false,
		hp = def.hp,
		oil = 0,
		fuel = 0,
		incoming = 0,
		dest = 0,
		trucks = {},
		queue = {},
		reloadUntil = 0,
		connected = true,
		eff = 1,
		status = "",
	}
	if def.refine then
		for _ = 1, def.refine.trucks do
			table.insert(b.trucks, { state = "idle", target = 0, amount = 0, arriveAt = 0, returnAt = 0 })
		end
	end
	return b
end

local function insert(n: Nation, b: BRuntime)
	n.buildings[b.uid] = b
	for _, key in cellsOf(b.def, b.x, b.z, b.r) do
		n.grid[key] = b.uid
	end
end

local function unindex(n: Nation, b: BRuntime)
	for _, key in cellsOf(b.def, b.x, b.z, b.r) do
		if n.grid[key] == b.uid then
			n.grid[key] = nil
		end
	end
end

function BuildService.access(n: Nation): Unlocks.Access
	return { researched = n.data.Researched, passes = n.passes }
end

-- Core placement used by requests, undo and loading.
local function placeInternal(n: Nation, def, x: number, z: number, r: number, charge: boolean): (boolean, string?, BRuntime?)
	local ok, err = BuildService.canPlace(n, def, x, z, r)
	if not ok then
		return false, err, nil
	end
	if def.max and Nations.countAll(n, def.id) >= def.max then
		return false, ("Limit reached (max %d)"):format(def.max), nil
	end
	if charge then
		if n.data.Cash < def.cost then
			return false, "Not enough cash", nil
		end
		n.data.Cash -= def.cost
	end
	local b = newRuntime(n, def, x, z, r)
	local time = def.buildTime / Nations.speed(n)
	if time > 0 then
		b.startAt = Nations.now()
		b.finishAt = b.startAt + time
	end
	insert(n, b)
	b.connected = connectedAt(n, b)
	spawnModel(n, b)
	if isRoadDef(def) and not b.finishAt then
		BuildService.recomputeRoads(n)
	end
	return true, nil, b
end

local function pushUndo(n: Nation, action: { [string]: any })
	action.t = Nations.now()
	table.insert(n.undo, action)
	if #n.undo > 25 then
		table.remove(n.undo, 1)
	end
end

local function removeInternal(n: Nation, b: BRuntime)
	unindex(n, b)
	n.buildings[b.uid] = nil
	if b.model then
		b.model:Destroy()
		b.model = nil
	end
	-- refund queued production
	for _, item in b.queue do
		local cat = item.kind == "unit" and S.ProductionService.unitDef(item.id) or S.ProductionService.weaponDef(item.id)
		if cat then
			n.data.Cash += cat.cost
		end
	end
	if isRoadDef(b.def) then
		BuildService.recomputeRoads(n)
	end
end

function BuildService.completeConstruction(n: Nation, b: BRuntime)
	b.finishAt = nil
	b.startAt = nil
	if b.model then
		ModelBuilder.setConstruction(b.model, false)
		b.model:SetAttribute("FinishAt", nil)
		b.model:SetAttribute("BuildStart", nil)
	end
	if isRoadDef(b.def) then
		BuildService.recomputeRoads(n)
	end
	Net.event("Effect"):FireClient(n.player, "BuildDone", b.model and b.model:GetPivot().Position or n.origin, b.def.name)
end

function BuildService.setDamaged(n: Nation, b: BRuntime, on: boolean)
	b.damaged = on
	if on then
		b.hp = 0
	else
		b.hp = b.def.hp
	end
	if b.model then
		b.model:SetAttribute("Damaged", on or nil)
		b.model:SetAttribute("Hp", b.hp)
		ModelBuilder.setDamaged(b.model, on)
	end
	local _ = n
end

-- Apply strike damage; returns damage actually dealt.
function BuildService.damage(n: Nation, b: BRuntime, amount: number): number
	if b.damaged or isRoadDef(b.def) then
		return 0
	end
	local dealt = math.min(b.hp, amount)
	b.hp -= dealt
	if b.model then
		b.model:SetAttribute("Hp", b.hp)
	end
	if b.hp <= 0 then
		BuildService.setDamaged(n, b, true)
		-- stored resources are lost when a building is knocked out
		b.fuel = 0
		b.oil = 0
	end
	return dealt
end

---------------------------------------------------------------------------
-- Load / save
---------------------------------------------------------------------------
function BuildService.loadNation(n: Nation)
	for _, s in n.data.Buildings do
		local def = Buildings.get(s.id)
		if def then
			local r = s.r or 0
			if BuildService.canPlace(n, def, s.x, s.z, r) then
				local b = newRuntime(n, def, s.x, s.z, r, s.u)
				b.finishAt = s.f
				b.startAt = s.st
				b.damaged = s.d == true
				b.hp = b.damaged and 0 or math.clamp(s.hp or def.hp, 1, def.hp)
				b.oil = s.o or 0
				b.fuel = s.fu or 0
				b.dest = s.de or 0
				if s.q then
					for _, q in s.q do
						table.insert(b.queue, { id = q.id, kind = q.k, progress = q.p or 0, started = q.s == true })
					end
				end
				insert(n, b)
				if (s.u or 0) >= n.data.NextUid then
					n.data.NextUid = s.u + 1
				end
			end
		end
	end
	BuildService.recomputeRoads(n)
	-- spawn models gradually so a huge city doesn't hitch the server
	local count = 0
	for _, b in n.buildings do
		if not n.player.Parent then
			return
		end
		spawnModel(n, b)
		count += 1
		if count % 40 == 0 then
			task.wait()
		end
	end
end

function BuildService.serialize(n: Nation)
	local out = {}
	for _, b in n.buildings do
		local q = nil
		if #b.queue > 0 then
			q = {}
			for _, item in b.queue do
				table.insert(q, { id = item.id, k = item.kind, p = item.progress, s = item.started })
			end
		end
		local fuel = b.fuel
		-- fuel on the road is returned to the refinery when saving
		for _, t in b.trucks do
			if t.state ~= "idle" and t.state ~= "back" then
				fuel += t.amount
			end
		end
		table.insert(out, {
			u = b.uid,
			id = b.id,
			x = b.x,
			z = b.z,
			r = b.r ~= 0 and b.r or nil,
			f = b.finishAt,
			st = b.startAt,
			d = b.damaged or nil,
			hp = (b.hp < b.def.hp and not b.damaged) and math.floor(b.hp) or nil,
			o = b.oil > 0 and math.floor(b.oil) or nil,
			fu = fuel > 0 and math.floor(fuel) or nil,
			de = b.dest ~= 0 and b.dest or nil,
			q = q,
		})
	end
	n.data.Buildings = out
end

---------------------------------------------------------------------------
-- Tick (called by the simulation loop)
---------------------------------------------------------------------------
function BuildService.tick(n: Nation, now: number)
	for _, b in n.buildings do
		if b.finishAt and now >= b.finishAt then
			BuildService.completeConstruction(n, b)
		end
	end
end

function BuildService.finishAll(n: Nation)
	for _, b in n.buildings do
		if b.finishAt then
			BuildService.completeConstruction(n, b)
		end
	end
end

function BuildService.repairAll(n: Nation, free: boolean): (number, number)
	local count, cost = 0, 0
	for _, b in n.buildings do
		if b.damaged then
			local price = math.floor(b.def.cost * Config.RepairCostRate)
			if free or n.data.Cash >= price then
				if not free then
					n.data.Cash -= price
					cost += price
				end
				BuildService.setDamaged(n, b, false)
				count += 1
			end
		end
	end
	return count, cost
end

---------------------------------------------------------------------------
-- Requests
---------------------------------------------------------------------------
local function nationOf(player: Player): Nation?
	local n = Nations.get(player)
	if n and n.ready then
		return n
	end
	return nil
end

local function validRotation(r: any): number
	if typeof(r) ~= "number" then
		return 0
	end
	return math.floor(r) % 4
end

local function requireDef(n: Nation, id: any): (any, string?)
	if typeof(id) ~= "string" then
		return nil, "Unknown building"
	end
	local def = Buildings.get(id)
	if not def then
		return nil, "Unknown building"
	end
	local ok, reason = Unlocks.check(def, BuildService.access(n))
	if not ok then
		return nil, reason
	end
	return def, nil
end

local function onPlace(player: Player, id: any, x: any, z: any, r: any)
	local n = nationOf(player)
	if not n then
		return { ok = false, err = "Loading..." }
	end
	local def, err = requireDef(n, id)
	if not def then
		return { ok = false, err = err }
	end
	if typeof(x) ~= "number" or typeof(z) ~= "number" then
		return { ok = false, err = "Invalid position" }
	end
	local ok, perr, b = placeInternal(n, def, math.floor(x), math.floor(z), validRotation(r), true)
	if not ok or not b then
		return { ok = false, err = perr }
	end
	pushUndo(n, { kind = "place", uid = b.uid, cost = def.cost })
	S.StateService.push(n)
	return { ok = true, uid = b.uid }
end

local function onPlaceMany(player: Player, id: any, cells: any, r: any)
	local n = nationOf(player)
	if not n then
		return { ok = false, err = "Loading..." }
	end
	local def, err = requireDef(n, id)
	if not def then
		return { ok = false, err = err }
	end
	if typeof(cells) ~= "table" then
		return { ok = false, err = "Invalid request" }
	end
	local placed = 0
	local lastErr: string? = nil
	local uids = {}
	for i, cell in cells do
		if i > 250 then
			break
		end
		if typeof(cell) == "table" and typeof(cell[1]) == "number" and typeof(cell[2]) == "number" then
			local ok, perr, b = placeInternal(n, def, math.floor(cell[1]), math.floor(cell[2]), validRotation(r), true)
			if ok and b then
				placed += 1
				table.insert(uids, b.uid)
			else
				lastErr = perr
				if perr == "Not enough cash" then
					break
				end
			end
		end
	end
	if placed > 0 then
		pushUndo(n, { kind = "placeMany", uids = uids, cost = def.cost })
		BuildService.recomputeRoads(n)
		S.StateService.push(n)
	end
	return { ok = placed > 0, placed = placed, err = placed == 0 and lastErr or nil }
end

local function refundFor(b: BRuntime): number
	if b.finishAt then
		return b.def.cost
	elseif b.damaged then
		return math.floor(b.def.cost * Config.SellRefund * 0.5)
	end
	return math.floor(b.def.cost * Config.SellRefund)
end

local function onDelete(player: Player, uid: any)
	local n = nationOf(player)
	if not n or typeof(uid) ~= "number" then
		return { ok = false, err = "Invalid request" }
	end
	local b = n.buildings[uid]
	if not b then
		return { ok = false, err = "Building not found" }
	end
	local refund = refundFor(b)
	n.data.Cash += refund
	pushUndo(n, { kind = "delete", id = b.id, x = b.x, z = b.z, r = b.r, refund = refund, wasBuilt = b.finishAt == nil })
	removeInternal(n, b)
	S.StateService.push(n)
	return { ok = true, refund = refund }
end

local function onMove(player: Player, uid: any, x: any, z: any, r: any)
	local n = nationOf(player)
	if not n or typeof(uid) ~= "number" or typeof(x) ~= "number" or typeof(z) ~= "number" then
		return { ok = false, err = "Invalid request" }
	end
	local b = n.buildings[uid]
	if not b then
		return { ok = false, err = "Building not found" }
	end
	local nx, nz, nr = math.floor(x), math.floor(z), validRotation(r)
	local ok, err = BuildService.canPlace(n, b.def, nx, nz, nr, b.uid)
	if not ok then
		return { ok = false, err = err }
	end
	pushUndo(n, { kind = "move", uid = b.uid, x = b.x, z = b.z, r = b.r })
	unindex(n, b)
	b.x, b.z, b.r = nx, nz, nr
	for _, key in cellsOf(b.def, b.x, b.z, b.r) do
		n.grid[key] = b.uid
	end
	if b.model then
		b.model:PivotTo(BuildService.worldCFrame(n, b))
	end
	BuildService.recomputeRoads(n)
	return { ok = true }
end

local function onUndo(player: Player)
	local n = nationOf(player)
	if not n then
		return { ok = false }
	end
	local action = table.remove(n.undo)
	if not action then
		return { ok = false, err = "Nothing to undo" }
	end
	if Nations.now() - action.t > Config.UndoWindow then
		table.clear(n.undo)
		return { ok = false, err = "Too late to undo" }
	end
	if action.kind == "place" or action.kind == "placeMany" then
		local uids = action.uids or { action.uid }
		for _, uid in uids do
			local b = n.buildings[uid]
			if b then
				n.data.Cash += b.def.cost
				removeInternal(n, b)
			end
		end
	elseif action.kind == "delete" then
		local def = Buildings.get(action.id)
		if def then
			if n.data.Cash < action.refund then
				return { ok = false, err = "Not enough cash" }
			end
			local ok, err, b = placeInternal(n, def, action.x, action.z, action.r, false)
			if not ok or not b then
				return { ok = false, err = err }
			end
			n.data.Cash -= action.refund
			if action.wasBuilt then
				-- it was finished before: put it back finished
				BuildService.completeConstruction(n, b)
			end
		end
	elseif action.kind == "move" then
		local b = n.buildings[action.uid]
		if b and BuildService.canPlace(n, b.def, action.x, action.z, action.r, b.uid) then
			unindex(n, b)
			b.x, b.z, b.r = action.x, action.z, action.r
			for _, key in cellsOf(b.def, b.x, b.z, b.r) do
				n.grid[key] = b.uid
			end
			if b.model then
				b.model:PivotTo(BuildService.worldCFrame(n, b))
			end
			BuildService.recomputeRoads(n)
		end
	end
	S.StateService.push(n)
	return { ok = true }
end

local function onRepair(player: Player, uid: any)
	local n = nationOf(player)
	if not n or typeof(uid) ~= "number" then
		return { ok = false, err = "Invalid request" }
	end
	local b = n.buildings[uid]
	if not b or not b.damaged then
		return { ok = false, err = "Nothing to repair" }
	end
	local price = math.floor(b.def.cost * Config.RepairCostRate)
	if n.data.Cash < price then
		return { ok = false, err = "Not enough cash" }
	end
	n.data.Cash -= price
	BuildService.setDamaged(n, b, false)
	S.StateService.push(n)
	return { ok = true }
end

local function onRepairAll(player: Player)
	local n = nationOf(player)
	if not n then
		return { ok = false }
	end
	local count, cost = BuildService.repairAll(n, false)
	S.StateService.push(n)
	if count == 0 then
		return { ok = false, err = "Nothing to repair (or not enough cash)" }
	end
	return { ok = true, count = count, cost = cost }
end

local function onSetBillboard(player: Player, text: any)
	local n = nationOf(player)
	if not n or typeof(text) ~= "string" then
		return { ok = false }
	end
	if not n.passes.Billboard then
		return { ok = false, err = "Requires the Billboard pass" }
	end
	text = string.sub(text, 1, 40)
	local ok, filtered = pcall(function()
		local result = TextService:FilterStringAsync(text, player.UserId, Enum.TextFilterContext.PublicChat)
		return result:GetNonChatStringForBroadcastAsync()
	end)
	if not ok then
		return { ok = false, err = "Could not filter text, try again" }
	end
	n.data.Billboard = filtered
	for _, b in n.buildings do
		applyBillboard(n, b)
	end
	return { ok = true, text = filtered }
end

function BuildService.init(services)
	S = services
end

function BuildService.start()
	Net.handle("PlaceBuilding", onPlace, 12)
	Net.handle("PlaceMany", onPlaceMany, 4)
	Net.handle("DeleteBuilding", onDelete, 12)
	Net.handle("MoveBuilding", onMove, 8)
	Net.handle("Undo", onUndo, 6)
	Net.handle("RepairBuilding", onRepair, 8)
	Net.handle("RepairAll", onRepairAll, 2)
	Net.handle("SetBillboard", onSetBillboard, 1)
end

return BuildService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="28">
          <Properties>
            <string name="Name">CombatService</string>
            <string name="Source"><![CDATA[--[[
	CombatService
	Missile / drone strikes, air-defense interception, damage and PvP rules.

	A strike is resolved deterministically at launch: the server picks the
	launcher, rolls every air defense covering the target, and broadcasts one
	"Projectile" event with the full flight description. All clients animate
	the same flight (Ballistics module) and the server applies the result
	when the flight time elapses.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage.Shared
local Config = require(Shared.Config)
local Format = require(Shared.Util.Format)
local Net = require(Shared.Net)
local Unlocks = require(Shared.Util.Unlocks)
local Weapons = require(Shared.Catalog.Weapons)
local Nations = require(script.Parent.Nations)

type Nation = Nations.Nation
type BRuntime = Nations.BRuntime

local CombatService = {}
local S: { [string]: any }
local nextId = 0

local function flatDist(a: Vector3, b: Vector3): number
	return Vector2.new(a.X - b.X, a.Z - b.Z).Magnitude
end

function CombatService.isShielded(n: Nation): boolean
	return os.time() < n.shieldUntil
end

-- Launchers of a family: total, ready count, the first ready one, next ready time.
function CombatService.launcherState(n: Nation, family: string, now: number): (number, number, BRuntime?, number)
	local total, ready, first, nextReady = 0, 0, nil, math.huge
	for _, b in n.buildings do
		if b.def.launcher == family and Nations.isActive(b) then
			total += 1
			if b.reloadUntil <= now then
				ready += 1
				first = first or b
			else
				nextReady = math.min(nextReady, b.reloadUntil)
			end
		end
	end
	return total, ready, first, nextReady
end

local function radarBonus(n: Nation): number
	for _, b in n.buildings do
		if b.def.radar and Nations.isActive(b) then
			return b.def.radar
		end
	end
	return 0
end

-- Air defenses (buildings of `defender`) that can engage a strike on `target`.
local function defensesFor(defender: Nation, target: Vector3, arrival: number): { BRuntime }
	local out = {}
	local bonus = 1 + radarBonus(defender)
	for _, b in defender.buildings do
		local ad = b.def.airDefense
		if ad and Nations.isActive(b) and b.eff > 0.3 and b.reloadUntil <= arrival then
			local pos = S.BuildService.worldCFrame(defender, b).Position
			if flatDist(pos, target) <= ad.range * bonus then
				table.insert(out, b)
			end
		end
	end
	table.sort(out, function(a, c)
		return a.def.airDefense.chance > c.def.airDefense.chance
	end)
	return out
end

local function classifyTarget(attacker: Nation, target: Vector3): (string?, Nation?, string?)
	if S.UnitService.inMainland(target) then
		return "mainland", nil, nil
	end
	local owner = S.PlotService.ownerAt(target)
	if not owner then
		return nil, nil, "Pick a target on the mainland or an enemy nation"
	end
	if owner == attacker.player then
		return nil, nil, "You can't strike your own nation"
	end
	local defender = Nations.get(owner)
	if not defender or not defender.ready then
		return nil, nil, "That nation isn't ready"
	end
	if not attacker.data.Pvp then
		return nil, nil, "Turn PvP ON to attack other nations"
	end
	if not defender.data.Pvp then
		return nil, nil, owner.DisplayName .. " has PvP OFF"
	end
	if CombatService.isShielded(defender) then
		return nil, nil, owner.DisplayName .. " is protected by the new-nation shield"
	end
	return "nation", defender, nil
end

local function impact(attacker: Nation, weapon, target: Vector3, defender: Nation?, kind: string): (number, number)
	local dealtTotal, value = 0, 0
	local cluster = weapon.id == "CLUSTER"
	local function falloff(d: number): number
		if cluster then
			return 1
		end
		return 1 - 0.5 * math.clamp(d / weapon.radius, 0, 1)
	end

	if kind == "nation" and defender then
		local damagedNames = {}
		for _, b in defender.buildings do
			local center = S.BuildService.worldCFrame(defender, b).Position
			local halfSize = math.min(b.def.size[1], b.def.size[2]) * Config.CellSize / 2
			local d = math.max(0, flatDist(center, target) - halfSize)
			if d <= weapon.radius then
				local wasDamaged = b.damaged
				local dealt = S.BuildService.damage(defender, b, weapon.damage * falloff(d))
				if dealt > 0 then
					dealtTotal += dealt
					value += b.def.cost * (dealt / b.def.hp)
					if b.damaged and not wasDamaged then
						table.insert(damagedNames, b.def.name)
					end
				end
			end
		end
		for _, u in S.UnitService.unitsNear(target, weapon.radius, attacker.userId) do
			if u.n == defender then
				dealtTotal += weapon.damage
				S.UnitService.damage(u, weapon.damage, attacker)
			end
		end
		if dealtTotal > 0 then
			local msg = ("%s's %s hit your nation"):format(attacker.player.DisplayName, weapon.short)
			if #damagedNames > 0 then
				msg ..= (" — %s knocked out"):format(table.concat(damagedNames, ", ", 1, math.min(3, #damagedNames)))
			end
			Nations.notify(defender.player, msg, "bad")
		end
	else
		for _, u in S.UnitService.unitsNear(target, weapon.radius, attacker.userId) do
			dealtTotal += weapon.damage
			S.UnitService.damage(u, weapon.damage * falloff(flatDist(u.root.CFrame.Position, target)), attacker)
		end
		local point = S.ConquestService.pointNear(target, weapon.radius)
		if point then
			-- warheads are very effective against garrisons
			dealtTotal += S.ConquestService.damageGarrison(point, weapon.damage * 2.5, attacker)
		end
	end
	return dealtTotal, value
end

local function launch(attacker: Nation, weaponId: string, target: Vector3): (boolean, string?)
	local weapon = Weapons.get(weaponId)
	if not weapon then
		return false, "Unknown weapon"
	end
	local ok, reason = Unlocks.check(weapon, S.BuildService.access(attacker))
	if not ok then
		return false, reason
	end
	local stock = attacker.data.Inventory[weaponId] or 0
	if stock <= 0 then
		return false, "No " .. weapon.short .. " in stock - build some in a military factory"
	end
	local now = Nations.now()
	local total, _, launcher, nextReady = CombatService.launcherState(attacker, weapon.family, now)
	if total == 0 then
		return false, "Build a launcher for " .. weapon.short
	end
	if not launcher then
		return false, ("All %s launchers reloading (%ds)"):format(weapon.short, math.ceil(nextReady - now))
	end
	local kind, defender, err = classifyTarget(attacker, target)
	if not kind then
		return false, err
	end

	-- commit
	attacker.data.Inventory[weaponId] = stock - 1
	launcher.reloadUntil = now + (launcher.def.reload or 20)
	if launcher.model then
		launcher.model:SetAttribute("ReloadUntil", launcher.reloadUntil)
	end
	attacker.data.Stats.Launches += 1
	if kind == "nation" then
		attacker.pvpLockUntil = now + Config.PvpToggleCooldown
		attacker.shieldUntil = 0 -- attacking ends your own new-nation shield
	end

	local from = S.BuildService.worldCFrame(attacker, launcher).Position + Vector3.new(0, 8, 0)
	local target0 = Vector3.new(target.X, 0, target.Z)
	local dist = flatDist(from, target0)
	local flight = weapon.flight * math.clamp(dist / 1600, 0.7, 1.5)
	local apex = weapon.apex * math.clamp(dist / 1600, 0.6, 1.4)
	if weapon.apex < 60 then
		apex = weapon.apex
	end

	-- interception
	local interceptAt: number? = nil
	local interceptFrom: Vector3? = nil
	local interceptorName: string? = nil
	local arrival = now + flight * Config.InterceptAt
	if defender then
		for _, ad in defensesFor(defender, target0, arrival) do
			ad.reloadUntil = arrival + ad.def.airDefense.reload
			if math.random() < ad.def.airDefense.chance * weapon.interceptMod then
				interceptAt = Config.InterceptAt
				interceptFrom = S.BuildService.worldCFrame(defender, ad).Position + Vector3.new(0, 5, 0)
				interceptorName = ad.def.name
				break
			end
		end
	else
		for _, u in S.UnitService.unitsNear(target0, 140, attacker.userId) do
			if u.def.antiAir and math.random() < u.def.antiAir * weapon.interceptMod then
				interceptAt = Config.InterceptAt
				interceptFrom = u.root.CFrame.Position + Vector3.new(0, 3, 0)
				interceptorName = u.def.name
				break
			end
		end
	end

	nextId += 1
	local id = nextId
	Net.event("Projectile"):FireAllClients({
		id = id,
		w = weaponId,
		from = from,
		to = target0,
		t0 = now,
		flight = flight,
		apex = apex,
		kind = weapon.kind,
		ic = interceptAt,
		icFrom = interceptFrom,
		owner = attacker.userId,
	})

	local resolveIn = flight * (interceptAt or 1)
	task.delay(resolveIn, function()
		if interceptAt then
			Net.event("ProjectileEnd"):FireAllClients({ id = id, intercepted = true })
			if attacker.player.Parent then
				Nations.notify(attacker.player, ("Your %s was intercepted by a %s"):format(weapon.short, interceptorName or "defense"), "bad")
			end
			if defender and defender.player.Parent then
				Nations.notify(defender.player, ("Your %s intercepted %s's %s"):format(interceptorName or "defense", attacker.player.DisplayName, weapon.short), "good")
			end
			return
		end
		local stillDefender = defender
		if defender and not defender.player.Parent then
			stillDefender = nil
		end
		local dealt, value = 0, 0
		if attacker.player.Parent then
			dealt, value = impact(attacker, weapon, target0, stillDefender, kind)
		end
		Net.event("ProjectileEnd"):FireAllClients({ id = id, intercepted = false, hit = dealt > 0, pos = target0, w = weaponId })
		if dealt > 0 and attacker.player.Parent then
			attacker.data.Stats.Hits += 1
			local loot = math.floor(value * Config.StrikeLootRate)
			attacker.data.Cash += loot
			Nations.notify(attacker.player, ("Direct hit!%s"):format(loot > 0 and (" +" .. Format.cash(loot) .. " war spoils") or ""), "good")
			S.StateService.push(attacker)
		end
	end)
	return true, nil
end

local function onLaunch(player: Player, weaponId: any, target: any)
	local n = Nations.get(player)
	if not n or not n.ready or typeof(weaponId) ~= "string" or typeof(target) ~= "Vector3" then
		return { ok = false, err = "Invalid request" }
	end
	if target.X ~= target.X or math.abs(target.X) > 1e5 or math.abs(target.Z) > 1e5 then
		return { ok = false, err = "Invalid target" }
	end
	local ok, err = launch(n, weaponId, target)
	S.StateService.push(n)
	return { ok = ok, err = err }
end

local function onSetPvp(player: Player, on: any)
	local n = Nations.get(player)
	if not n or typeof(on) ~= "boolean" then
		return { ok = false }
	end
	if not on and Nations.now() < n.pvpLockUntil then
		return { ok = false, err = ("You attacked recently. PvP stays ON for %ds"):format(math.ceil(n.pvpLockUntil - Nations.now())) }
	end
	n.data.Pvp = on
	player:SetAttribute("Pvp", on)
	S.StateService.push(n)
	return { ok = true }
end

function CombatService.init(services)
	S = services
end

function CombatService.start()
	Net.handle("LaunchWeapon", onLaunch, 6)
	Net.handle("SetPvp", onSetPvp, 2)
end

return CombatService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="29">
          <Properties>
            <string name="Name">ConquestService</string>
            <string name="Source"><![CDATA[--[[
	ConquestService
	Generates the mainland (low-poly hills, dirt roads, forests, strategic
	points, staging pads) and runs the capture loop:

	  * Each point has a garrison. Enemy units in range shoot it down, missile
	    strikes knock big chunks off it, and it regenerates when left alone.
	  * At zero garrison, a single nation's units inside the ring capture it
	    (contested if the owner or a third nation is present).
	  * Owned points pay their bonus (cash, oil, power, steel, RP) every tick.
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage.Shared
local Config = require(Shared.Config)
local WarMap = require(Shared.Catalog.WarMap)
local ModelBuilder = require(Shared.ModelBuilder)
local Nations = require(script.Parent.Nations)

type Nation = Nations.Nation

export type Point = {
	def: any,
	center: Vector3,
	model: Model,
	ring: BasePart,
	owner: number,
	garrison: number,
	capture: number,
	capturer: number,
}

local ConquestService = {}
local S: { [string]: any }
local points: { Point } = {}

local ORIGIN = Config.MainlandOrigin
local HALF = Config.MainlandSize / 2
local NEUTRAL = Color3.fromRGB(200, 200, 196)

local function part(parent: Instance, size: Vector3, cf: CFrame, color: Color3, material: Enum.Material?): Part
	local p = Instance.new("Part")
	p.Anchored = true
	p.Size = size
	p.CFrame = cf
	p.Color = color
	p.Material = material or Enum.Material.SmoothPlastic
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	p.CanTouch = false
	p.Parent = parent
	return p
end

---------------------------------------------------------------------------
-- World generation
---------------------------------------------------------------------------
local function buildGround(world: Folder)
	local tile = Config.MainlandSize / 2
	for ix = -1, 0 do
		for iz = -1, 0 do
			local c = ORIGIN + Vector3.new((ix + 0.5) * tile, -3, (iz + 0.5) * tile)
			part(world, Vector3.new(tile, 6, tile), CFrame.new(c), Color3.fromRGB(86, 110, 60), Enum.Material.Grass).Name = "Ground"
		end
	end
	local rim = 60
	for _, s in { -1, 1 } do
		part(world, Vector3.new(Config.MainlandSize + rim * 2, 6, rim), CFrame.new(ORIGIN + Vector3.new(0, -3.5, s * (HALF + rim / 2))), Color3.fromRGB(206, 184, 136), Enum.Material.Sand)
		part(world, Vector3.new(rim, 6, Config.MainlandSize), CFrame.new(ORIGIN + Vector3.new(s * (HALF + rim / 2), -3.5, 0)), Color3.fromRGB(206, 184, 136), Enum.Material.Sand)
	end
end

local function buildHills(world: Folder)
	local rng = Random.new(42)
	local greens = { Color3.fromRGB(72, 96, 52), Color3.fromRGB(96, 118, 62), Color3.fromRGB(118, 128, 70), Color3.fromRGB(84, 104, 56) }
	for _ = 1, 70 do
		-- hills hug the edges so the middle stays open for fighting
		local side = rng:NextInteger(1, 4)
		local along = rng:NextNumber(-HALF, HALF)
		local inward = rng:NextNumber(0, 260)
		local x, z
		if side == 1 then
			x, z = along, -HALF + inward
		elseif side == 2 then
			x, z = along, HALF - inward
		elseif side == 3 then
			x, z = -HALF + inward, along
		else
			x, z = HALF - inward, along
		end
		local size = Vector3.new(rng:NextNumber(60, 180), rng:NextNumber(30, 90), rng:NextNumber(60, 180))
		local cf = CFrame.new(ORIGIN + Vector3.new(x, -size.Y * 0.25, z))
			* CFrame.Angles(rng:NextNumber(-0.5, 0.5), rng:NextNumber(0, math.pi), rng:NextNumber(-0.5, 0.5))
		local hill = part(world, size, cf, greens[rng:NextInteger(1, #greens)])
		hill.Name = "Hill"
		hill.CanQuery = false
	end
end

local function buildRoad(world: Folder, a: Vector3, b: Vector3, bend: number)
	local mid = (a + b) / 2
	local dir = (b - a)
	local perp = Vector3.new(-dir.Z, 0, dir.X).Unit
	local ctrl = mid + perp * bend
	local segments = 14
	local prev = a
	for i = 1, segments do
		local t = i / segments
		local p = a * (1 - t) ^ 2 + ctrl * (2 * (1 - t) * t) + b * t ^ 2
		local len = (p - prev).Magnitude
		if len > 0.5 then
			local cf = CFrame.lookAt((prev + p) / 2, p) + Vector3.new(0, 0.05, 0)
			local seg = part(world, Vector3.new(9, 0.2, len + 4), cf, Color3.fromRGB(112, 78, 52))
			seg.Name = "Road"
			seg.CanCollide = false
		end
		prev = p
	end
end

local function buildTrees(world: Folder)
	local rng = Random.new(9)
	for _ = 1, 26 do
		local c = ORIGIN + Vector3.new(rng:NextNumber(-HALF + 120, HALF - 120), 0, rng:NextNumber(-HALF + 120, HALF - 120))
		local tooClose = false
		for _, def in WarMap do
			if ((ORIGIN + def.offset) - c).Magnitude < 160 then
				tooClose = true
				break
			end
		end
		if not tooClose then
			for _ = 1, rng:NextInteger(5, 10) do
				local p = c + Vector3.new(rng:NextNumber(-40, 40), 0, rng:NextNumber(-40, 40))
				local s = rng:NextNumber(0.8, 1.5)
				part(world, Vector3.new(1, 5 * s, 1), CFrame.new(p + Vector3.new(0, 2.5 * s, 0)), Color3.fromRGB(96, 74, 52)).CanCollide = false
				local canopy = part(world, Vector3.new(7 * s, 7 * s, 7 * s), CFrame.new(p + Vector3.new(0, 7 * s, 0)), Color3.fromRGB(62, 96, 50))
				canopy.Shape = Enum.PartType.Ball
				canopy.CanCollide = false
			end
		end
	end
end

local function buildStaging(world: Folder)
	for i = 1, Config.MaxPlots do
		local pos = ORIGIN + Vector3.new(-1050 + (i - 1) * 300, 0, HALF - 110)
		local pad = part(world, Vector3.new(90, 0.4, 60), CFrame.new(pos + Vector3.new(0, 0.2, 0)), Color3.fromRGB(176, 176, 168))
		pad.Name = "Staging_" .. i
		part(world, Vector3.new(0.6, 14, 0.6), CFrame.new(pos + Vector3.new(-40, 7, -26)), Color3.fromRGB(80, 84, 90))
		local flag = part(world, Vector3.new(0.2, 4, 7), CFrame.new(pos + Vector3.new(-40, 12, -22.5)), Config.NationColors[i])
		flag.Name = "Flag"
		-- tunnel mouth
		part(world, Vector3.new(26, 14, 10), CFrame.new(pos + Vector3.new(0, 7, 40)), Color3.fromRGB(120, 124, 116))
		part(world, Vector3.new(16, 10, 10.4), CFrame.new(pos + Vector3.new(0, 5, 40)), Color3.fromRGB(30, 32, 36))
	end
end

local function buildPoint(world: Folder, def): Point
	local center = ORIGIN + def.offset
	local model = ModelBuilder.warPoint(def.model, 130)
	model.Name = def.id
	model:PivotTo(CFrame.new(center))
	local ring = Instance.new("Part")
	ring.Name = "Ring"
	ring.Shape = Enum.PartType.Cylinder
	ring.Anchored = true
	ring.CanCollide = false
	ring.CanQuery = false
	ring.Size = Vector3.new(0.3, Config.CaptureRadius * 2, Config.CaptureRadius * 2)
	ring.CFrame = CFrame.new(center + Vector3.new(0, 0.1, 0)) * CFrame.Angles(0, 0, math.rad(90))
	ring.Color = NEUTRAL
	ring.Transparency = 0.75
	ring.Material = Enum.Material.SmoothPlastic
	ring.Parent = model
	model:SetAttribute("PointId", def.id)
	model:SetAttribute("PointName", def.name)
	model:SetAttribute("Bonus", def.bonusText)
	model:SetAttribute("MaxGarrison", def.garrison)
	model:SetAttribute("Garrison", def.garrison)
	model:SetAttribute("Capture", 0)
	model:SetAttribute("Owner", 0)
	model:SetAttribute("OwnerName", "")
	model.Parent = world
	return {
		def = def,
		center = center,
		model = model,
		ring = ring,
		owner = 0,
		garrison = def.garrison,
		capture = 0,
		capturer = 0,
	}
end

---------------------------------------------------------------------------
-- Queries used by other services
---------------------------------------------------------------------------
local function flatDist(a: Vector3, b: Vector3): number
	return Vector2.new(a.X - b.X, a.Z - b.Z).Magnitude
end

function ConquestService.points(): { Point }
	return points
end

function ConquestService.enemyPointInRange(pos: Vector3, range: number, userId: number): Point?
	for _, p in points do
		if p.owner ~= userId and p.garrison > 0 and flatDist(pos, p.center) <= range + Config.CaptureRadius then
			return p
		end
	end
	return nil
end

function ConquestService.pointNear(pos: Vector3, extra: number): Point?
	for _, p in points do
		if flatDist(pos, p.center) <= Config.CaptureRadius + extra then
			return p
		end
	end
	return nil
end

function ConquestService.damageGarrison(p: Point, amount: number, attacker: Nation?): number
	if attacker and p.owner == attacker.userId then
		return 0
	end
	local dealt = math.min(p.garrison, amount)
	p.garrison -= dealt
	p.model:SetAttribute("Garrison", math.floor(p.garrison))
	return dealt
end

function ConquestService.bonusFor(n: Nation): { income: number, oil: number, power: number, steel: number, rp: number }
	local b = { income = 0, oil = 0, power = 0, steel = 0, rp = 0 }
	for _, p in points do
		if p.owner == n.userId then
			for k, v in p.def.bonus do
				b[k] += v
			end
		end
	end
	return b
end

local function setOwner(p: Point, userId: number)
	local old = p.owner
	p.owner = userId
	p.capture = 0
	p.capturer = 0
	local n = userId ~= 0 and Nations.byUserId(userId) or nil
	p.model:SetAttribute("Owner", userId)
	p.model:SetAttribute("OwnerName", n and n.player.DisplayName or "")
	p.ring.Color = n and (Config.NationColors[n.plotIndex] or NEUTRAL) or NEUTRAL
	p.model:SetAttribute("Color", p.ring.Color)
	if n then
		p.garrison = p.def.garrison * 0.3
		n.data.Stats.Captures += 1
		Nations.notifyAll(("%s captured the %s!"):format(n.player.DisplayName, p.def.name), "war")
	end
	local oldNation = old ~= 0 and Nations.byUserId(old) or nil
	if oldNation and old ~= userId then
		Nations.notify(oldNation.player, ("You lost the %s"):format(p.def.name), "bad")
	end
end

function ConquestService.releaseOwner(userId: number)
	for _, p in points do
		if p.owner == userId then
			setOwner(p, 0)
			p.garrison = p.def.garrison * 0.5
		end
		if p.capturer == userId then
			p.capture = 0
			p.capturer = 0
		end
	end
end

---------------------------------------------------------------------------
-- Capture loop
---------------------------------------------------------------------------
local function step(dt: number)
	local units = S.UnitService.mainlandUnits()
	for _, p in points do
		local occupants: { [number]: { power: number, units: { any } } } = {}
		for _, u in units do
			if flatDist(u.root.CFrame.Position, p.center) <= Config.CaptureRadius then
				local o = occupants[u.n.userId]
				if not o then
					o = { power = 0, units = {} }
					occupants[u.n.userId] = o
				end
				o.power += u.def.capture
				table.insert(o.units, u)
			end
		end
		local enemyIds = {}
		for userId in occupants do
			if userId ~= p.owner then
				table.insert(enemyIds, userId)
			end
		end
		local ownerPresent = p.owner ~= 0 and occupants[p.owner] ~= nil

		if #enemyIds == 0 then
			p.garrison = math.min(p.def.garrison, p.garrison + Config.GarrisonRegen * dt)
			p.capture = math.max(0, p.capture - 5 * dt)
			if p.capture == 0 then
				p.capturer = 0
			end
		else
			-- the garrison fights back
			if p.garrison > 0 then
				local dps = 6 + p.def.garrison * 0.012
				local target = occupants[enemyIds[1]].units[1]
				if target then
					S.UnitService.damage(target, dps * dt, nil)
				end
			end
			if p.garrison <= 0 and not ownerPresent and #enemyIds == 1 then
				local id = enemyIds[1]
				if p.capturer ~= id then
					p.capturer = id
					p.capture = 0
				end
				p.capture += occupants[id].power * dt
				if p.capture >= Config.CaptureTime then
					setOwner(p, id)
				end
			end
		end
		p.model:SetAttribute("Garrison", math.floor(p.garrison))
		p.model:SetAttribute("Capture", math.floor(p.capture / Config.CaptureTime * 100))
		p.model:SetAttribute("Capturer", p.capturer)
		p.model:SetAttribute("Contested", #enemyIds > 0 and (ownerPresent or #enemyIds > 1))
	end
end

-- exposed for automated tests
ConquestService._step = step

function ConquestService.init(services)
	S = services
	local world = Instance.new("Folder")
	world.Name = "Mainland"
	world.Parent = workspace
	buildGround(world)
	buildHills(world)
	local capital = ORIGIN
	for i, def in WarMap do
		if def.id ~= "capital" then
			buildRoad(world, capital, ORIGIN + def.offset, (i % 2 == 0 and 1 or -1) * 140)
		end
	end
	for i = 1, Config.MaxPlots do
		local staging = ORIGIN + Vector3.new(-1050 + (i - 1) * 300, 0, HALF - 110)
		if i % 2 == 1 then
			buildRoad(world, staging, capital, (i - 4) * 30)
		end
	end
	buildTrees(world)
	buildStaging(world)
	local pointsFolder = Instance.new("Folder")
	pointsFolder.Name = "Points"
	pointsFolder.Parent = world
	for _, def in WarMap do
		table.insert(points, buildPoint(pointsFolder, def))
	end
end

function ConquestService.start()
	task.spawn(function()
		while true do
			task.wait(1)
			local ok, err = pcall(step, 1)
			if not ok then
				warn("[Conquest] step failed: " .. tostring(err))
			end
		end
	end)
	Players.PlayerRemoving:Connect(function(player)
		ConquestService.releaseOwner(player.UserId)
	end)
end

return ConquestService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="30">
          <Properties>
            <string name="Name">DataService</string>
            <string name="Source"><![CDATA[--[[
	DataService
	Loads and saves player data with DataStoreService.

	  * Session lock: a profile records which server owns it. Another server
	    will wait (and eventually steal a stale lock) instead of loading a
	    copy, so items can't be duplicated by server hopping.
	  * Autosave every 2 minutes, on leave and on shutdown (BindToClose).
	  * Missing fields are filled from the template so new features never
	    break old saves.
	  * In Studio without API access the game still runs (data just isn't
	    persisted) so you can test immediately.
]]

local DataStoreService = game:GetService("DataStoreService")
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage.Shared.Config)

local DataService = {}

local AUTOSAVE_INTERVAL = 120
local LOCK_EXPIRE = 300

local store: DataStore? = nil
local storeOk = false
local profiles: { [Player]: { [string]: any } } = {}
local loadedCallbacks: { (Player, { [string]: any }) -> () } = {}
local beforeSaveCallbacks: { (Player, { [string]: any }) -> () } = {}
local releasing: { [Player]: boolean } = {}

local function template(): { [string]: any }
	return {
		Version = Config.DataVersion,
		Cash = Config.StartCash,
		Population = 0,
		ResearchPoints = 0,
		Researched = {},
		ActiveResearch = nil,
		Buildings = {},
		NextUid = 1,
		Inventory = {},
		Units = {},
		Oil = 0,
		Steel = 0,
		Stats = { Hits = 0, Launches = 0, Captures = 0, Kills = 0, TotalEarned = 0, PlayTime = 0 },
		Pvp = false,
		FirstJoin = 0,
		LastOnline = 0,
		LastPay = 0,
		Daily = { Streak = 0, LastDay = 0 },
		Quest = 1,
		Flags = {},
		BoostUntil = 0,
		Redeemed = {},
		Receipts = {},
		Billboard = "",
	}
end

local function reconcile(data: { [string]: any }, tmpl: { [string]: any })
	for k, v in tmpl do
		if data[k] == nil then
			if type(v) == "table" then
				data[k] = table.clone(v)
			else
				data[k] = v
			end
		elseif type(v) == "table" and type(data[k]) == "table" and next(v) ~= nil then
			reconcile(data[k], v)
		end
	end
end

local function keyFor(player: Player): string
	return "player_" .. player.UserId
end

local function now(): number
	return os.time()
end

local function tryLoad(player: Player): { [string]: any }?
	local s = store
	if not s then
		return nil
	end
	local result: { [string]: any }? = nil
	local attempts = 0
	while attempts < 8 and player.Parent do
		attempts += 1
		local stolen = false
		local ok, err = pcall(function()
			s:UpdateAsync(keyFor(player), function(old)
				local data = old or template()
				local lock = data._lock
				if lock and lock.job ~= game.JobId and now() - (lock.t or 0) < LOCK_EXPIRE then
					-- another server still owns this profile
					result = nil
					return nil
				end
				stolen = lock ~= nil and lock.job ~= game.JobId
				data._lock = { job = game.JobId, t = now() }
				result = data
				return data
			end)
		end)
		if ok and result then
			if stolen then
				warn(("[Data] Took over a stale session lock for %s"):format(player.Name))
			end
			return result
		elseif not ok then
			warn(("[Data] Load attempt %d failed for %s: %s"):format(attempts, player.Name, tostring(err)))
		end
		task.wait(attempts < 3 and 2 or 6)
	end
	return nil
end

local function save(player: Player, release: boolean): boolean
	local data = profiles[player]
	local s = store
	if not data or not s then
		return false
	end
	for _, cb in beforeSaveCallbacks do
		local ok, err = pcall(cb, player, data)
		if not ok then
			warn("[Data] beforeSave failed: " .. tostring(err))
		end
	end
	data.LastOnline = now()
	data._lock = (not release) and { job = game.JobId, t = now() } or nil
	local payload = data
	local ok, err = false, nil
	for _ = 1, 3 do
		ok, err = pcall(function()
			s:UpdateAsync(keyFor(player), function(old)
				if old and old._lock and old._lock.job ~= game.JobId then
					-- someone else took this profile; never overwrite it
					return nil
				end
				return payload
			end)
		end)
		if ok then
			break
		end
		task.wait(1)
	end
	if not ok then
		warn(("[Data] Save failed for %s: %s"):format(player.Name, tostring(err)))
	end
	return ok
end

function DataService.get(player: Player): { [string]: any }?
	return profiles[player]
end

function DataService.onLoaded(cb: (Player, { [string]: any }) -> ())
	table.insert(loadedCallbacks, cb)
	for p, data in profiles do
		task.spawn(cb, p, data)
	end
end

-- Lets runtime services write their live state into the profile right before it saves.
function DataService.beforeSave(cb: (Player, { [string]: any }) -> ())
	table.insert(beforeSaveCallbacks, cb)
end

function DataService.save(player: Player)
	task.spawn(save, player, false)
end

-- Final save when a player leaves. beforeSave callbacks run synchronously
-- (before the first yield) so callers can tear down runtime state right after.
function DataService.release(player: Player)
	if profiles[player] and not releasing[player] then
		releasing[player] = true
		task.spawn(function()
			save(player, true)
			profiles[player] = nil
			releasing[player] = nil
		end)
	end
end

function DataService.isPersistent(): boolean
	return storeOk
end

local function onPlayerAdded(player: Player)
	local data: { [string]: any }?
	if storeOk then
		data = tryLoad(player)
		if not data then
			if player.Parent then
				player:Kick("Could not load your nation. Please rejoin in a moment.")
			end
			return
		end
	else
		data = template()
	end
	local profile = data :: { [string]: any }
	if not player.Parent then
		-- left while loading: release the session lock we just took
		if storeOk then
			profiles[player] = profile
			save(player, true)
			profiles[player] = nil
		end
		return
	end
	reconcile(profile, template())
	if profile.FirstJoin == 0 then
		profile.FirstJoin = now()
	end
	profiles[player] = profile
	for _, cb in loadedCallbacks do
		task.spawn(cb, player, profile)
	end
end

function DataService.init(_S)
	local ok, result = pcall(function()
		return DataStoreService:GetDataStore(Config.DataStoreName)
	end)
	if ok then
		store = result
		-- In Studio, a quick read tells us whether API access is enabled.
		local readOk = pcall(function()
			(result :: DataStore):GetAsync("__probe")
		end)
		storeOk = readOk
		if not readOk then
			warn("[Data] DataStores unavailable (enable Studio API access to save). Running without saving.")
		end
	else
		warn("[Data] DataStores unavailable: " .. tostring(result))
	end
end

function DataService.start()
	Players.PlayerAdded:Connect(onPlayerAdded)
	for _, p in Players:GetPlayers() do
		task.spawn(onPlayerAdded, p)
	end


	task.spawn(function()
		while true do
			task.wait(AUTOSAVE_INTERVAL)
			for player in profiles do
				task.spawn(save, player, false)
				task.wait(0.5)
			end
		end
	end)

	game:BindToClose(function()
		if RunService:IsStudio() and not storeOk then
			return
		end
		local pending = 0
		for player in profiles do
			if not releasing[player] then
				pending += 1
				task.spawn(function()
					save(player, true)
					pending -= 1
				end)
			end
		end
		local start = os.clock()
		while pending > 0 and os.clock() - start < 25 do
			task.wait(0.2)
		end
	end)
end

return DataService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="31">
          <Properties>
            <string name="Name">EconomyService</string>
            <string name="Source"><![CDATA[--[[
	EconomyService
	Runs the 1-second simulation loop for every nation and owns the core
	economy: workers, power, water, road access, happiness, population,
	national resources and pay day.

	Each tick (in order):
	  BuildService (construction) -> Economy (stats) -> Logistics (refineries,
	  trucks) -> Production (factories) -> Research -> Rewards (quests) -> State
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage.Shared
local Config = require(Shared.Config)
local Format = require(Shared.Util.Format)
local Nations = require(script.Parent.Nations)

type Nation = Nations.Nation

local EconomyService = {}
local S: { [string]: any }

local SERVICE_HAPPINESS = { Leisure = 15, Commerce = 10, Education = 10, Health = 15 }

local function setAttr(model: Model?, key: string, value: any)
	if model and model:GetAttribute(key) ~= value then
		model:SetAttribute(key, value)
	end
end
EconomyService.setAttr = setAttr

function EconomyService.incomeMultiplier(n: Nation): number
	local mult = 1
	if n.passes.VIP then
		mult += 0.25
	end
	if n.premium then
		mult += Config.PremiumIncomeBonus
	end
	if n.passes.DoubleCash then
		mult *= 2
	end
	if n.data.BoostUntil > os.time() then
		mult *= 2
	end
	return mult
end

function EconomyService.compute(n: Nation, dt: number)
	local data = n.data
	local pop = data.Population
	local bonus = S.ConquestService.bonusFor(n)

	-- 1) worker demand from active buildings
	local workersDemand = 0
	for _, b in n.buildings do
		if Nations.isActive(b) and b.def.workers then
			workersDemand += b.def.workers
		end
	end
	local wr = workersDemand > 0 and math.min(1, pop / workersDemand) or 1

	local function baseEff(b): number
		local e = b.connected and 1 or 0.5
		if b.def.workers then
			e *= wr
		end
		return e
	end

	-- 2) power
	local powerSupply, powerDemand = bonus.power or 0, 0
	for _, b in n.buildings do
		if Nations.isActive(b) then
			if b.def.powerOut then
				powerSupply += b.def.powerOut * baseEff(b)
			end
			if b.def.power then
				powerDemand += b.def.power
			end
		end
	end
	local pr = powerDemand > 0 and math.min(1, powerSupply / powerDemand) or 1

	-- 3) water
	local waterSupply, waterDemand = 0, 0
	for _, b in n.buildings do
		if Nations.isActive(b) then
			if b.def.waterOut then
				waterSupply += b.def.waterOut * baseEff(b) * (b.def.power and pr or 1)
			end
			if b.def.water then
				waterDemand += b.def.water
			end
		end
	end
	local wtr = waterDemand > 0 and math.min(1, waterSupply / waterDemand) or 1

	-- 4) per-building efficiency and outputs
	local housingCap = 0
	local oilRate, steelRate, rpRate = bonus.oil or 0, bonus.steel or 0, bonus.rp or 0
	local commerce = bonus.income or 0
	local services = { Leisure = 0, Commerce = 0, Education = 0, Health = 0 }
	local pollution, upkeep, damaged, constructing = 0, 0, 0, 0
	local oilCap, steelCap = Config.BaseResourceCap, Config.BaseResourceCap
	local depotCap = 0

	for _, b in n.buildings do
		local def = b.def
		if b.finishAt then
			constructing += 1
			b.eff = 0
			setAttr(b.model, "Status", "Under Construction")
		elseif b.damaged then
			damaged += 1
			upkeep += def.cost * Config.UpkeepRate
			b.eff = 0
			setAttr(b.model, "Status", "Damaged - Needs Repair")
		else
			upkeep += def.cost * Config.UpkeepRate
			local road = b.connected and 1 or 0.5
			local eff = road
			if def.workers then
				eff *= wr
			end
			if def.power then
				eff *= pr
			end
			if def.water then
				eff *= wtr
			end
			if def.housing then
				local h = road * (0.4 + 0.6 * math.min(pr, wtr))
				housingCap += def.housing * h
				eff = h
			end
			b.eff = eff
			if def.oilOut then
				oilRate += def.oilOut * eff
			end
			if def.steelOut then
				steelRate += def.steelOut * eff
			end
			if def.rpOut then
				rpRate += def.rpOut * eff
			end
			if def.income then
				commerce += def.income * eff
			end
			if def.service then
				services[def.service.kind] += def.service.serves * eff
			end
			if def.pollution then
				pollution += def.pollution
			end
			if def.storage then
				oilCap += def.storage.oil or 0
				steelCap += def.storage.steel or 0
			end
			if def.depot then
				depotCap += def.depot
			end
			-- generic status; specialised services overwrite it afterwards
			local status
			if not b.connected then
				status = "No Road Access - Half Speed"
			elseif def.workers and wr < 0.999 then
				status = "Not Enough Workers"
			elseif def.power and pr < 0.999 then
				status = "Not Enough Power"
			elseif def.water and wtr < 0.999 then
				status = "Not Enough Water"
			else
				status = "Working"
			end
			b.status = status
			setAttr(b.model, "Status", status)
		end
		setAttr(b.model, "Eff", math.floor(b.eff * 100 + 0.5))
	end

	-- 5) happiness
	local happiness = Config.HappinessBase
	for kind, max in SERVICE_HAPPINESS do
		local coverage = pop > 0 and math.min(1, services[kind] / pop) or 1
		happiness += max * coverage
	end
	happiness -= math.min(25, pollution * 0.6)
	happiness -= (1 - pr) * 20 + (1 - wtr) * 20
	happiness -= math.min(15, damaged * 2)
	if pop < 150 then
		happiness += 10 -- small towns are forgiving so new players grow fast
	end
	happiness = math.clamp(happiness, 0, 100)

	-- 6) population
	if pop < housingCap and happiness >= 35 then
		local growth = math.max(Config.PopulationMinGrowth, (housingCap - pop) * Config.PopulationGrowth) * dt
		pop = math.min(housingCap, pop + growth)
	elseif pop > housingCap then
		pop = math.max(housingCap, pop - math.max(1, (pop - housingCap) * 0.06) * dt)
	end
	if happiness < 25 then
		pop = math.max(0, pop - pop * 0.003 * dt)
	end
	data.Population = pop

	-- 7) national resources
	data.Oil = math.min(oilCap, data.Oil + oilRate / 60 * dt)
	data.Steel = math.min(steelCap, data.Steel + steelRate / 60 * dt)
	data.ResearchPoints += rpRate / 60 * dt

	-- 8) projected pay
	local taxes = pop * Config.TaxPerCitizen * (0.4 + 0.8 * happiness / 100)
	local mult = EconomyService.incomeMultiplier(n)
	local gross = (taxes + commerce) * mult
	local net = gross - upkeep

	local st = n.stats
	st.housingCap = housingCap
	st.workersDemand = workersDemand
	st.workersUsed = math.min(pop, workersDemand)
	st.powerSupply, st.powerDemand = powerSupply, powerDemand
	st.waterSupply, st.waterDemand = waterSupply, waterDemand
	st.happiness = happiness
	st.oilRate, st.steelRate, st.rpRate = oilRate, steelRate, rpRate
	st.oilCap, st.steelCap = oilCap, steelCap
	st.taxes, st.commerce, st.upkeep = taxes, commerce, upkeep
	st.gross, st.income, st.mult = gross, net, mult
	st.depotCap = depotCap
	st.damaged, st.constructing = damaged, constructing
	st.services = services
end

function EconomyService.payDay(n: Nation)
	local net = math.floor(n.stats.income or 0)
	local data = n.data
	data.Cash = math.max(0, data.Cash + net)
	data.LastPay = net
	if net > 0 then
		data.Stats.TotalEarned += net
	end
	if net ~= 0 then
		Nations.notify(n.player, (net > 0 and "Pay day! +" or "Pay day: ") .. Format.cash(net), "pay")
	end
end

-- Cash = income per pay day for `minutes` minutes (used by cash packs & gifts).
function EconomyService.incomeFor(n: Nation, minutes: number): number
	local perPay = math.max(n.stats.gross or 0, 0)
	return perPay * (minutes * 60 / Config.PayInterval)
end

local function tick(dt: number)
	local now = Nations.now()
	for _, n in Nations.all() do
		if n.ready then
			local ok, err = pcall(function()
				S.BuildService.tick(n, now)
				EconomyService.compute(n, dt)
				S.LogisticsService.tick(n, dt, now)
				S.ProductionService.tick(n, dt, now)
				S.ResearchService.tick(n, now)
				S.RewardService.tick(n, now)
				if now >= n.nextPayAt then
					n.nextPayAt += Config.PayInterval
					if n.nextPayAt < now then
						n.nextPayAt = now + Config.PayInterval
					end
					EconomyService.payDay(n)
				end
				n.data.Stats.PlayTime += dt
				S.StateService.push(n)
			end)
			if not ok then
				warn("[Economy] tick failed for " .. n.player.Name .. ": " .. tostring(err))
			end
		end
	end
end

-- exposed for automated tests
EconomyService._tick = tick

function EconomyService.init(services)
	S = services
end

function EconomyService.start()
	task.spawn(function()
		local last = os.clock()
		while true do
			task.wait(1)
			local t = os.clock()
			local dt = math.min(3, t - last)
			last = t
			tick(dt)
		end
	end)
end

return EconomyService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="32">
          <Properties>
            <string name="Name">LogisticsService</string>
            <string name="Source"><![CDATA[--[[
	LogisticsService
	Oil pumps fill the national oil pool. Refineries pull oil, refine it into
	fuel and dispatch fuel trucks to fuel consumers (military factories),
	either to a chosen destination or "Auto" (the one with most free space).

	Truck trips are exposed to clients as model attributes
	("Truck1" = "targetUid|departAt|arriveAt|returnAt") so every client,
	including late joiners, animates trucks driving along the roads.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage.Shared
local Config = require(Shared.Config)
local Net = require(Shared.Net)
local Nations = require(script.Parent.Nations)

type Nation = Nations.Nation
type BRuntime = Nations.BRuntime

local LogisticsService = {}
local S: { [string]: any }

local MIN_LOAD = 60

local function freeSpace(b: BRuntime): number
	return (b.def.fuelCap or 0) - b.fuel - b.incoming
end

local function centerOf(n: Nation, b: BRuntime): Vector3
	return S.BuildService.worldCFrame(n, b).Position
end

local function chooseTarget(n: Nation, refinery: BRuntime): BRuntime?
	if refinery.dest ~= 0 then
		local t = n.buildings[refinery.dest]
		if t and t.def.fuelCap and Nations.isActive(t) and freeSpace(t) > 1 then
			return t
		end
		return nil
	end
	local best, bestFree = nil, 1
	for _, b in n.buildings do
		if b.def.fuelCap and Nations.isActive(b) then
			local free = freeSpace(b)
			if free > bestFree then
				best, bestFree = b, free
			end
		end
	end
	return best
end

function LogisticsService.tick(n: Nation, dt: number, now: number)
	local setAttr = S.EconomyService.setAttr
	local oilShare = 0
	local refineries = 0
	for _, b in n.buildings do
		if b.def.refine and Nations.isActive(b) then
			refineries += 1
		end
	end
	if refineries > 0 then
		oilShare = (n.stats.oilRate or 0) / refineries
	end

	for _, b in n.buildings do
		local rf = b.def.refine
		if rf then
			-- trucks keep driving even if the refinery gets knocked out
			local busy = false
			for i, t in b.trucks do
				if t.state == "out" and now >= t.arriveAt then
					local target = n.buildings[t.target]
					if target and target.def.fuelCap then
						target.incoming = math.max(0, target.incoming - t.amount)
						target.fuel = math.min(target.def.fuelCap, target.fuel + t.amount)
					else
						b.fuel = math.min(rf.fuelCap, b.fuel + t.amount) -- destination vanished: bring it home
					end
					t.state = "back"
				end
				if t.state == "back" and now >= t.returnAt then
					t.state = "idle"
					setAttr(b.model, "Truck" .. i, "")
				end
				if t.state ~= "idle" then
					busy = true
				end
			end

			if Nations.isActive(b) then
				-- pull oil from the national pool
				local want = math.min(rf.oilCap - b.oil, rf.rate * 2 / 60 * dt)
				local take = math.max(0, math.min(want, n.data.Oil))
				n.data.Oil -= take
				b.oil += take
				-- refine
				local amount = math.max(0, math.min(b.oil, rf.rate / 60 * dt * b.eff, rf.fuelCap - b.fuel))
				b.oil -= amount
				b.fuel += amount

				-- dispatch idle trucks
				for i, t in b.trucks do
					if t.state == "idle" and b.fuel >= math.min(MIN_LOAD, rf.fuelCap) then
						local target = chooseTarget(n, b)
						if target then
							local load = math.floor(math.min(b.fuel, Config.TruckCapacity, freeSpace(target)))
							if load > 0 then
								local a, c = centerOf(n, b), centerOf(n, target)
								local dist = math.abs(a.X - c.X) + math.abs(a.Z - c.Z)
								local trip = math.max(4, dist / Config.TruckSpeed)
								t.state = "out"
								t.target = target.uid
								t.amount = load
								t.arriveAt = now + trip
								t.returnAt = now + trip * 2
								b.fuel -= load
								target.incoming += load
								busy = true
								setAttr(b.model, "Truck" .. i, ("%d|%.2f|%.2f|%.2f"):format(target.uid, now, t.arriveAt, t.returnAt))
							end
						end
					end
				end

				local status
				if busy then
					status = "Fuel Truck Already Delivering"
				elseif b.fuel >= rf.fuelCap - 0.5 then
					status = chooseTarget(n, b) and "Loading Truck" or "Fuel Storage Full - No Destination"
				elseif b.oil < 1 and n.data.Oil < 1 then
					status = "Waiting For Oil - Build Oil Pumps"
				elseif b.status ~= "Working" then
					status = b.status
				else
					status = "Refining Oil Into Fuel"
				end
				setAttr(b.model, "Status", status)
			end
			setAttr(b.model, "Oil", math.floor(b.oil))
			setAttr(b.model, "Fuel", math.floor(b.fuel))
			setAttr(b.model, "OilArriving", math.floor(oilShare * 10) / 10)
			setAttr(b.model, "Dest", b.dest)
		elseif b.def.fuelCap then
			setAttr(b.model, "Fuel", math.floor(b.fuel))
			setAttr(b.model, "Incoming", math.floor(b.incoming))
		end
	end
end

local function onSetDestination(player: Player, refineryUid: any, destUid: any)
	local n = Nations.get(player)
	if not n or typeof(refineryUid) ~= "number" or typeof(destUid) ~= "number" then
		return { ok = false }
	end
	local b = n.buildings[refineryUid]
	if not b or not b.def.refine then
		return { ok = false, err = "Not a refinery" }
	end
	if destUid ~= 0 then
		local t = n.buildings[destUid]
		if not t or not t.def.fuelCap then
			return { ok = false, err = "That building doesn't use fuel" }
		end
	end
	b.dest = destUid
	if b.model then
		b.model:SetAttribute("Dest", destUid)
	end
	return { ok = true }
end

function LogisticsService.init(services)
	S = services
end

function LogisticsService.start()
	Net.handle("SetFuelDestination", onSetDestination, 6)
end

return LogisticsService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="33">
          <Properties>
            <string name="Name">MonetizationService</string>
            <string name="Source"><![CDATA[--[[
	MonetizationService
	Game passes, developer products (ProcessReceipt) and Roblox Premium.

	  * Receipts are idempotent: every granted PurchaseId is remembered in the
	    player's data, and we only return PurchaseGranted after granting.
	  * Cash packs scale with the player's income so they stay worth buying at
	    every stage of the game (with a floor for brand new players).
	  * In Studio (Config.StudioFreePurchases) the store's buy buttons grant
	    items directly so every perk can be tested without publishing.
]]

local MarketplaceService = game:GetService("MarketplaceService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Shared = ReplicatedStorage.Shared
local Config = require(Shared.Config)
local Format = require(Shared.Util.Format)
local Net = require(Shared.Net)
local Products = require(Shared.Catalog.Products)
local Weapons = require(Shared.Catalog.Weapons)
local Unlocks = require(Shared.Util.Unlocks)
local Nations = require(script.Parent.Nations)

type Nation = Nations.Nation

local MonetizationService = {}
local S: { [string]: any }

local function isPremium(player: Player): boolean
	local ok, premium = pcall(function()
		return player.MembershipType == Enum.MembershipType.Premium
	end)
	return ok and premium == true
end

local function applyPassPerks(n: Nation)
	n.player:SetAttribute("VIP", n.passes.VIP == true)
end

function MonetizationService.grantPass(n: Nation, key: string)
	if n.passes[key] then
		return
	end
	n.passes[key] = true
	applyPassPerks(n)
	local def = Products.pass(key)
	Nations.notify(n.player, ("%s unlocked! Thank you for supporting the game"):format(def and def.name or key), "good")
	Net.event("PurchaseDone"):FireClient(n.player, "pass", key)
	S.StateService.push(n)
end

function MonetizationService.loadPasses(n: Nation)
	for _, def in Products.Passes do
		if def.id ~= 0 then
			local ok, owns = pcall(MarketplaceService.UserOwnsGamePassAsync, MarketplaceService, n.userId, def.id)
			if ok and owns then
				n.passes[def.key] = true
			end
		end
		-- passes bought in Studio test sessions are remembered in data while testing
		if RunService:IsStudio() and n.data.Flags["StudioPass_" .. def.key] then
			n.passes[def.key] = true
		end
	end
	n.premium = isPremium(n.player)
	applyPassPerks(n)
end

-- Returns true when the product was granted.
function MonetizationService.grantProduct(n: Nation, def): boolean
	local data = n.data
	local kind = def.kind
	if kind == "cash" then
		local amount = math.max(def.minCash or 0, S.EconomyService.incomeFor(n, def.minutes or 10))
		amount = math.floor(amount)
		data.Cash += amount
		Nations.notify(n.player, ("+%s added to your treasury"):format(Format.cash(amount)), "pay")
	elseif kind == "boost" then
		data.BoostUntil = math.max(os.time(), data.BoostUntil) + (def.minutes or 30) * 60
		Nations.notify(n.player, "2x Cash boost active!", "good")
	elseif kind == "instantBuild" then
		S.BuildService.finishAll(n)
		Nations.notify(n.player, "All construction finished!", "good")
	elseif kind == "instantResearch" then
		if data.ActiveResearch then
			S.ResearchService.complete(n)
		else
			-- nothing running: bank the value as research points instead
			data.ResearchPoints += 500
			Nations.notify(n.player, "No research running - +500 RP instead", "good")
		end
	elseif kind == "supply" then
		local access = S.BuildService.access(n)
		for _, w in Weapons.all() do
			if Unlocks.check(w, access) then
				data.Inventory[w.id] = math.max(data.Inventory[w.id] or 0, w.stockCap)
			end
		end
		Nations.notify(n.player, "Supply drop delivered: stockpiles full!", "good")
	elseif kind == "repair" then
		local count = S.BuildService.repairAll(n, true)
		Nations.notify(n.player, ("%d buildings repaired"):format(count), "good")
	elseif kind == "starter" then
		data.Cash += 150000
		data.Inventory.SRBM = (data.Inventory.SRBM or 0) + 10
		data.BoostUntil = math.max(os.time(), data.BoostUntil) + 30 * 60
		data.Flags.StarterPack = true
		Nations.notify(n.player, "Starter Pack: +$150k, 10 SRBMs and 30 min of 2x cash!", "good")
	else
		return false
	end
	Net.event("PurchaseDone"):FireClient(n.player, "product", def.key)
	S.StateService.push(n)
	return true
end

local function processReceipt(info)
	local player = Players:GetPlayerByUserId(info.PlayerId)
	if not player then
		return Enum.ProductPurchaseDecision.NotProcessedYet
	end
	local n = Nations.get(player)
	if not n or not n.ready then
		return Enum.ProductPurchaseDecision.NotProcessedYet
	end
	local receipts = n.data.Receipts
	if table.find(receipts, info.PurchaseId) then
		return Enum.ProductPurchaseDecision.PurchaseGranted
	end
	local def = Products.productById(info.ProductId)
	if not def then
		warn("[Monetization] Unknown product id " .. tostring(info.ProductId))
		return Enum.ProductPurchaseDecision.NotProcessedYet
	end
	local ok, granted = pcall(MonetizationService.grantProduct, n, def)
	if not ok or not granted then
		warn("[Monetization] Grant failed: " .. tostring(granted))
		return Enum.ProductPurchaseDecision.NotProcessedYet
	end
	table.insert(receipts, info.PurchaseId)
	while #receipts > 60 do
		table.remove(receipts, 1)
	end
	S.DataService.save(player)
	return Enum.ProductPurchaseDecision.PurchaseGranted
end

local function onStudioPurchase(player: Player, kind: any, key: any)
	if not (RunService:IsStudio() and Config.StudioFreePurchases) then
		return { ok = false, err = "Purchases go through Roblox" }
	end
	local n = Nations.get(player)
	if not n or typeof(key) ~= "string" then
		return { ok = false }
	end
	if kind == "pass" then
		if not Products.pass(key) then
			return { ok = false }
		end
		n.data.Flags["StudioPass_" .. key] = true
		MonetizationService.grantPass(n, key)
		return { ok = true }
	elseif kind == "product" then
		local def = Products.product(key)
		if not def then
			return { ok = false }
		end
		return { ok = MonetizationService.grantProduct(n, def) }
	end
	return { ok = false }
end

function MonetizationService.init(services)
	S = services
end

function MonetizationService.start()
	MarketplaceService.ProcessReceipt = processReceipt
	MarketplaceService.PromptGamePassPurchaseFinished:Connect(function(player, passId, purchased)
		if not purchased then
			return
		end
		local n = Nations.get(player)
		if not n then
			return
		end
		for _, def in Products.Passes do
			if def.id == passId and def.id ~= 0 then
				MonetizationService.grantPass(n, def.key)
			end
		end
	end)
	Players.PlayerMembershipChanged:Connect(function(player)
		local n = Nations.get(player)
		if n then
			n.premium = isPremium(player)
		end
	end)
	Net.handle("StudioPurchase", onStudioPurchase, 3)
end

return MonetizationService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="34">
          <Properties>
            <string name="Name">Nations</string>
            <string name="Source"><![CDATA[--[[
	Nations
	Runtime registry of every player's nation (live state that is not just
	saved data: building instances, occupancy grid, computed stats, timers).
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Net = require(ReplicatedStorage.Shared.Net)

export type BRuntime = {
	uid: number,
	id: string,
	def: any,
	x: number,
	z: number,
	r: number,
	model: Model?,
	finishAt: number?,
	startAt: number?,
	damaged: boolean,
	hp: number,
	oil: number,
	fuel: number,
	incoming: number,
	dest: number,
	trucks: { { state: string, target: number, amount: number, arriveAt: number, returnAt: number } },
	queue: { { id: string, kind: string, progress: number, started: boolean } },
	reloadUntil: number,
	connected: boolean,
	eff: number,
	status: string,
}

export type Nation = {
	player: Player,
	userId: number,
	data: { [string]: any },
	plotIndex: number,
	origin: Vector3,
	folder: Folder,
	buildings: { [number]: BRuntime },
	grid: { [number]: number },
	stats: { [string]: any },
	passes: { [string]: boolean },
	premium: boolean,
	joinAt: number,
	nextPayAt: number,
	giftAt: number,
	pvpLockUntil: number,
	shieldUntil: number,
	undo: { { [string]: any } },
	units: { [number]: any },
	nextUnitUid: number,
	sent: { [string]: string },
	ready: boolean,
}

local Nations = {}

local byPlayer: { [Player]: Nation } = {}

function Nations.now(): number
	return workspace:GetServerTimeNow()
end

function Nations.add(n: Nation)
	byPlayer[n.player] = n
end

function Nations.remove(player: Player)
	byPlayer[player] = nil
end

function Nations.get(player: Player): Nation?
	return byPlayer[player]
end

function Nations.all(): { [Player]: Nation }
	return byPlayer
end

function Nations.byUserId(userId: number): Nation?
	local p = Players:GetPlayerByUserId(userId)
	return p and byPlayer[p] or nil
end

-- kind: "info" | "good" | "bad" | "pay"
function Nations.notify(player: Player, text: string, kind: string?)
	Net.event("Notify"):FireClient(player, text, kind or "info")
end

function Nations.notifyAll(text: string, kind: string?)
	Net.event("Notify"):FireAllClients(text, kind or "info")
end

function Nations.hasPass(n: Nation, key: string): boolean
	return n.passes[key] == true
end

-- Multiplier for construction, research and factory speed.
function Nations.speed(n: Nation): number
	return n.passes.FastBuild and 2 or 1
end

function Nations.countBuilt(n: Nation, id: string): number
	local c = 0
	for _, b in n.buildings do
		if b.id == id and not b.finishAt then
			c += 1
		end
	end
	return c
end

function Nations.countAll(n: Nation, id: string): number
	local c = 0
	for _, b in n.buildings do
		if b.id == id then
			c += 1
		end
	end
	return c
end

-- Finished, undamaged building.
function Nations.isActive(b: BRuntime): boolean
	return b.finishAt == nil and not b.damaged
end

return Nations
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="35">
          <Properties>
            <string name="Name">PlotService</string>
            <string name="Source"><![CDATA[--[[
	PlotService
	Builds the homeland islands (one per player slot), the sea, assigns a plot
	to each joining player and keeps their character spawning on it.
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage.Shared.Config)
local Grid = require(ReplicatedStorage.Shared.Util.Grid)

local PlotService = {}

type Plot = {
	index: number,
	origin: Vector3,
	model: Model,
	buildings: Folder,
	sign: TextLabel,
	owner: Player?,
}

local plots: { Plot } = {}
local byPlayer: { [Player]: Plot } = {}

local GRASS = Color3.fromRGB(100, 138, 76)
local SAND = Color3.fromRGB(214, 190, 140)
local SEA = Color3.fromRGB(88, 156, 196)
local BORDER = Color3.fromRGB(96, 204, 255)

local function part(parent: Instance, name: string, size: Vector3, cf: CFrame, color: Color3, material: Enum.Material?): Part
	local p = Instance.new("Part")
	p.Name = name
	p.Anchored = true
	p.Size = size
	p.CFrame = cf
	p.Color = color
	p.Material = material or Enum.Material.SmoothPlastic
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	p.Parent = parent
	return p
end

local function buildSea(world: Folder)
	-- Sea tiles covering the homeland and the mainland (parts max out at 2048 studs).
	local tile = 2000
	for ix = -2, 2 do
		for iz = -1, 3 do
			local p = part(world, "Sea", Vector3.new(tile, 2, tile), CFrame.new(ix * tile, -3, iz * tile + 600), SEA)
			p.Reflectance = 0.05
			p.CanQuery = false
		end
	end
end

local function buildPlot(world: Folder, index: number): Plot
	local origin = Grid.plotOrigin(index)
	local size = Grid.PlotSize
	local model = Instance.new("Model")
	model.Name = "Plot_" .. index

	local ground = part(model, "Ground", Vector3.new(size, 6, size), CFrame.new(origin - Vector3.new(0, 3, 0)), GRASS, Enum.Material.Grass)
	ground:SetAttribute("PlotIndex", index)
	local rim = 34
	part(model, "Sand", Vector3.new(size + rim * 2, 6, size + rim * 2), CFrame.new(origin - Vector3.new(0, 3.6, 0)), SAND, Enum.Material.Sand)

	-- thin light-blue border line marking the buildable area
	local h = 0.15
	for _, s in { -1, 1 } do
		local a = part(model, "Border", Vector3.new(size, h, 0.5), CFrame.new(origin + Vector3.new(0, h / 2, s * size / 2)), BORDER, Enum.Material.Neon)
		local b = part(model, "Border", Vector3.new(0.5, h, size), CFrame.new(origin + Vector3.new(s * size / 2, h / 2, 0)), BORDER, Enum.Material.Neon)
		a.Transparency, b.Transparency = 0.25, 0.25
		a.CanCollide, b.CanCollide = false, false
		a.CanQuery, b.CanQuery = false, false
	end

	-- nation sign on the sand at the south edge
	local signPos = origin + Vector3.new(0, 0, size / 2 + rim * 0.55)
	part(model, "SignPostL", Vector3.new(0.8, 9, 0.8), CFrame.new(signPos + Vector3.new(-10, 4.5, 0)), Color3.fromRGB(80, 84, 90))
	part(model, "SignPostR", Vector3.new(0.8, 9, 0.8), CFrame.new(signPos + Vector3.new(10, 4.5, 0)), Color3.fromRGB(80, 84, 90))
	local board = part(model, "SignBoard", Vector3.new(26, 5, 0.6), CFrame.new(signPos + Vector3.new(0, 9, 0)), Color3.fromRGB(245, 245, 240))
	local gui = Instance.new("SurfaceGui")
	gui.Face = Enum.NormalId.Front -- faces into the plot
	gui.CanvasSize = Vector2.new(520, 100)
	gui.Parent = board
	local label = Instance.new("TextLabel")
	label.Size = UDim2.fromScale(1, 1)
	label.BackgroundTransparency = 1
	label.TextColor3 = Color3.fromRGB(28, 34, 46)
	label.TextScaled = true
	label.FontFace = Font.new("rbxasset://fonts/families/TitilliumWeb.json", Enum.FontWeight.Bold)
	label.Text = "UNCLAIMED LAND"
	label.Parent = gui

	local buildings = Instance.new("Folder")
	buildings.Name = "Buildings"
	buildings.Parent = model

	model.PrimaryPart = ground
	model.Parent = world
	return { index = index, origin = origin, model = model, buildings = buildings, sign = label, owner = nil }
end

function PlotService.spawnCFrame(index: number): CFrame
	local origin = Grid.plotOrigin(index)
	return CFrame.new(origin + Vector3.new(0, 4, Grid.PlotSize / 2 - 12)) * CFrame.Angles(0, 0, 0)
end

function PlotService.claim(player: Player): Plot?
	for _, plot in plots do
		if plot.owner == nil then
			plot.owner = player
			byPlayer[player] = plot
			plot.sign.Text = string.upper(player.DisplayName) .. "'S NATION"
			plot.model:SetAttribute("OwnerId", player.UserId)
			player:SetAttribute("PlotIndex", plot.index)
			return plot
		end
	end
	return nil
end

function PlotService.release(player: Player)
	local plot = byPlayer[player]
	if not plot then
		return
	end
	byPlayer[player] = nil
	plot.owner = nil
	plot.sign.Text = "UNCLAIMED LAND"
	plot.model:SetAttribute("OwnerId", nil)
	plot.buildings:ClearAllChildren()
end

function PlotService.get(player: Player): Plot?
	return byPlayer[player]
end

-- Which player's plot contains this world position?
function PlotService.ownerAt(pos: Vector3): Player?
	for _, plot in plots do
		if plot.owner and Grid.insidePlot(plot.origin, pos, 0) then
			return plot.owner
		end
	end
	return nil
end

local function bindCharacter(player: Player)
	local function place(character: Model)
		local plot = byPlayer[player]
		if not plot then
			return
		end
		character:WaitForChild("HumanoidRootPart", 10)
		task.defer(function()
			if character.Parent then
				character:PivotTo(PlotService.spawnCFrame(plot.index))
			end
		end)
	end
	player.CharacterAdded:Connect(place)
	if player.Character then
		place(player.Character)
	end
end

function PlotService.init(_S)
	local world = Instance.new("Folder")
	world.Name = "Homeland"
	world.Parent = workspace
	buildSea(world)
	for i = 1, Config.MaxPlots do
		table.insert(plots, buildPlot(world, i))
	end
end

function PlotService.start()
	Players.PlayerAdded:Connect(bindCharacter)
	for _, p in Players:GetPlayers() do
		bindCharacter(p)
	end
end

return PlotService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="36">
          <Properties>
            <string name="Name">ProductionService</string>
            <string name="Source"><![CDATA[--[[
	ProductionService
	Military factories build missiles, drones and vehicles from a queue.
	Cash is paid when queued, steel when an item starts, and fuel is burned
	while it is being built (delivered by refinery trucks).
]]

local HttpService = game:GetService("HttpService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage.Shared
local Config = require(Shared.Config)
local Net = require(Shared.Net)
local Unlocks = require(Shared.Util.Unlocks)
local Weapons = require(Shared.Catalog.Weapons)
local Units = require(Shared.Catalog.Units)
local Nations = require(script.Parent.Nations)

type Nation = Nations.Nation

local ProductionService = {}
local S: { [string]: any }

function ProductionService.weaponDef(id: string)
	return Weapons.get(id)
end

function ProductionService.unitDef(id: string)
	return Units.get(id)
end

local function catalogFor(kind: string, id: string): any
	if kind == "unit" then
		return Units.get(id)
	end
	return Weapons.get(id)
end

function ProductionService.queueLimit(n: Nation): number
	return Config.MaxQueuePerFactory + (n.passes.ExtraQueue and 3 or 0)
end

local function encodeQueue(b): string
	local out = {}
	for _, item in b.queue do
		table.insert(out, { id = item.id, k = item.kind, p = math.floor(item.progress * 100) / 100 })
	end
	return HttpService:JSONEncode(out)
end

function ProductionService.tick(n: Nation, dt: number, _now: number)
	local setAttr = S.EconomyService.setAttr
	local speed = Nations.speed(n)
	for _, b in n.buildings do
		local fac = b.def.factory
		if fac then
			if Nations.isActive(b) then
				local item = b.queue[1]
				local status
				if not item then
					status = "Idle - Queue Something To Build"
				else
					local cat = catalogFor(item.kind, item.id)
					if not cat then
						table.remove(b.queue, 1)
						status = "Idle"
					elseif not item.started and n.data.Steel < cat.steel then
						status = ("Waiting For Steel (%d needed)"):format(cat.steel)
					else
						if not item.started then
							n.data.Steel -= cat.steel
							item.started = true
						end
						local dp = speed * fac.speed * math.max(b.eff, 0.25) / cat.time * dt
						dp = math.min(dp, 1 - item.progress)
						local fuelNeeded = cat.fuel * dp
						if b.fuel + 1e-6 < fuelNeeded then
							-- burn what we have, then wait for the next truck
							local partial = b.fuel / math.max(cat.fuel, 1e-3)
							item.progress += partial
							b.fuel = 0
							status = "Waiting For Fuel Delivery"
						else
							b.fuel -= fuelNeeded
							item.progress += dp
							status = ("Building %s (%d%%)"):format(cat.name, math.floor(item.progress * 100))
						end
						if item.progress >= 0.999 then
							item.progress = 1
							if item.kind == "unit" then
								if S.UnitService.canAdd(n) then
									S.UnitService.spawn(n, item.id, nil, b)
									table.remove(b.queue, 1)
									Nations.notify(n.player, cat.name .. " rolled out of the factory", "good")
								else
									status = "Army Full - Build Vehicle Depots"
								end
							else
								local stock = n.data.Inventory[item.id] or 0
								if stock < cat.stockCap then
									n.data.Inventory[item.id] = stock + 1
									table.remove(b.queue, 1)
								else
									status = "Stockpile Full - Fire Some!"
								end
							end
						end
					end
				end
				setAttr(b.model, "Status", status)
			end
			setAttr(b.model, "Queue", encodeQueue(b))
		end
	end
end

local function onQueue(player: Player, factoryUid: any, kind: any, id: any)
	local n = Nations.get(player)
	if not n or typeof(factoryUid) ~= "number" or (kind ~= "unit" and kind ~= "weapon") or typeof(id) ~= "string" then
		return { ok = false, err = "Invalid request" }
	end
	local b = n.buildings[factoryUid]
	if not b or not b.def.factory then
		return { ok = false, err = "Not a factory" }
	end
	if b.finishAt then
		return { ok = false, err = "Factory is still being built" }
	end
	local cat = catalogFor(kind, id)
	if not cat then
		return { ok = false, err = "Unknown item" }
	end
	local ok, reason = Unlocks.check(cat, S.BuildService.access(n))
	if not ok then
		return { ok = false, err = reason }
	end
	if #b.queue >= ProductionService.queueLimit(n) then
		return { ok = false, err = "Queue is full" }
	end
	if n.data.Cash < cat.cost then
		return { ok = false, err = "Not enough cash" }
	end
	n.data.Cash -= cat.cost
	table.insert(b.queue, { id = id, kind = kind, progress = 0, started = false })
	if b.model then
		b.model:SetAttribute("Queue", encodeQueue(b))
	end
	S.StateService.push(n)
	return { ok = true }
end

local function onCancel(player: Player, factoryUid: any, index: any)
	local n = Nations.get(player)
	if not n or typeof(factoryUid) ~= "number" or typeof(index) ~= "number" then
		return { ok = false }
	end
	local b = n.buildings[factoryUid]
	if not b or not b.def.factory then
		return { ok = false }
	end
	local item = b.queue[math.floor(index)]
	if not item then
		return { ok = false }
	end
	local cat = catalogFor(item.kind, item.id)
	table.remove(b.queue, math.floor(index))
	if cat then
		n.data.Cash += cat.cost
		if item.started then
			n.data.Steel += cat.steel
		end
	end
	if b.model then
		b.model:SetAttribute("Queue", encodeQueue(b))
	end
	S.StateService.push(n)
	return { ok = true }
end

function ProductionService.init(services)
	S = services
end

function ProductionService.start()
	Net.handle("QueueProduction", onQueue, 10)
	Net.handle("CancelProduction", onCancel, 10)
end

return ProductionService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="37">
          <Properties>
            <string name="Name">ResearchService</string>
            <string name="Source"><![CDATA[--[[
	ResearchService
	One active research at a time. RP and cash are paid up front; the timer
	keeps running while offline (finishAt is an absolute time).
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage.Shared
local Net = require(Shared.Net)
local Research = require(Shared.Catalog.Research)
local Nations = require(script.Parent.Nations)

type Nation = Nations.Nation

local ResearchService = {}
local S: { [string]: any }

function ResearchService.canStart(n: Nation, id: string): (boolean, string?)
	local def = Research.get(id)
	if not def then
		return false, "Unknown research"
	end
	local data = n.data
	if data.Researched[id] then
		return false, "Already researched"
	end
	if data.ActiveResearch then
		return false, "Already researching something"
	end
	for _, req in def.requires do
		if not data.Researched[req] then
			local r = Research.get(req)
			return false, "Requires " .. (r and r.name or req)
		end
	end
	if def.hits and data.Stats.Hits < def.hits then
		return false, ("Requires %d hits (you have %d)"):format(def.hits, data.Stats.Hits)
	end
	if data.ResearchPoints < def.rp then
		return false, "Not enough research points"
	end
	if data.Cash < def.cash then
		return false, "Not enough cash"
	end
	return true, nil
end

function ResearchService.complete(n: Nation)
	local active = n.data.ActiveResearch
	if not active then
		return
	end
	n.data.Researched[active.id] = true
	n.data.ActiveResearch = nil
	local def = Research.get(active.id)
	Nations.notify(n.player, "Research complete: " .. (def and def.name or active.id), "good")
	Net.event("Effect"):FireClient(n.player, "ResearchDone", nil, def and def.name or active.id)
end

function ResearchService.tick(n: Nation, now: number)
	local active = n.data.ActiveResearch
	if active and now >= active.finishAt then
		ResearchService.complete(n)
	end
end

local function onStart(player: Player, id: any)
	local n = Nations.get(player)
	if not n or typeof(id) ~= "string" then
		return { ok = false, err = "Invalid request" }
	end
	local ok, err = ResearchService.canStart(n, id)
	if not ok then
		return { ok = false, err = err }
	end
	local def = Research.get(id)
	if not def then
		return { ok = false }
	end
	n.data.ResearchPoints -= def.rp
	n.data.Cash -= def.cash
	local now = Nations.now()
	n.data.ActiveResearch = { id = id, startAt = now, finishAt = now + def.time / Nations.speed(n) }
	S.StateService.push(n)
	return { ok = true }
end

function ResearchService.init(services)
	S = services
end

function ResearchService.start()
	Net.handle("StartResearch", onStart, 4)
end

return ResearchService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="38">
          <Properties>
            <string name="Name">RewardService</string>
            <string name="Source"><![CDATA[--[[
	RewardService
	Retention loops: offline earnings, daily login streak, playtime gifts,
	group reward, codes and the objective (quest) chain.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage.Shared
local Config = require(Shared.Config)
local Format = require(Shared.Util.Format)
local Net = require(Shared.Net)
local Quests = require(Shared.Catalog.Quests)
local Nations = require(script.Parent.Nations)

type Nation = Nations.Nation

local RewardService = {}
local S: { [string]: any }

local function today(): number
	return os.time() // 86400
end

---------------------------------------------------------------------------
-- Offline earnings
---------------------------------------------------------------------------
function RewardService.onJoin(n: Nation)
	local data = n.data
	n.giftAt = n.joinAt + Config.PlaytimeGiftInterval
	if data.LastOnline > 0 and data.LastPay > 0 then
		local away = os.time() - data.LastOnline
		if away > 120 then
			local capped = math.min(away, Config.OfflineEarningsHours * 3600 * (n.passes.VIP and 2 or 1))
			local rate = Config.OfflineEarningsRate * (n.passes.DoubleCash and 2 or 1)
			local amount = math.floor(data.LastPay * (capped / Config.PayInterval) * rate)
			if amount > 0 then
				data.Cash += amount
				Net.event("Effect"):FireClient(n.player, "Welcome", nil, amount, away)
			end
		end
	end
end

---------------------------------------------------------------------------
-- Daily / gift / group / codes
---------------------------------------------------------------------------
function RewardService.dailyReward(n: Nation, streak: number): number
	local base = Config.DailyRewards[((streak - 1) % #Config.DailyRewards) + 1]
	return math.floor(base + math.max(0, n.stats.gross or 0) * 2)
end

function RewardService.dailyInfo(n: Nation): { [string]: any }
	local d = n.data.Daily
	local canClaim = d.LastDay < today()
	local nextStreak = (d.LastDay == today() - 1) and d.Streak + 1 or (canClaim and 1 or d.Streak)
	return { streak = d.Streak, canClaim = canClaim, next = nextStreak, reward = RewardService.dailyReward(n, math.max(1, nextStreak)) }
end

function RewardService.giftReward(n: Nation): number
	return math.floor(math.max(5000, (n.stats.gross or 0) * Config.PlaytimeGiftPays))
end

local function onClaimDaily(player: Player)
	local n = Nations.get(player)
	if not n then
		return { ok = false }
	end
	local d = n.data.Daily
	if d.LastDay >= today() then
		return { ok = false, err = "Come back tomorrow!" }
	end
	d.Streak = (d.LastDay == today() - 1) and d.Streak + 1 or 1
	d.LastDay = today()
	local reward = RewardService.dailyReward(n, d.Streak)
	n.data.Cash += reward
	Nations.notify(player, ("Day %d reward: +%s"):format(d.Streak, Format.cash(reward)), "pay")
	S.StateService.push(n)
	return { ok = true, reward = reward }
end

local function onClaimPlaytime(player: Player)
	local n = Nations.get(player)
	if not n then
		return { ok = false }
	end
	local now = Nations.now()
	if now < n.giftAt then
		return { ok = false, err = "Gift not ready yet" }
	end
	local reward = RewardService.giftReward(n)
	n.data.Cash += reward
	n.giftAt = now + Config.PlaytimeGiftInterval
	Nations.notify(player, ("Playtime gift: +%s"):format(Format.cash(reward)), "pay")
	S.StateService.push(n)
	return { ok = true, reward = reward }
end

local function onClaimGroup(player: Player)
	local n = Nations.get(player)
	if not n or Config.GroupId == 0 then
		return { ok = false, err = "No group reward" }
	end
	if n.data.Flags.Group then
		return { ok = false, err = "Already claimed" }
	end
	local ok, inGroup = pcall(player.IsInGroup, player, Config.GroupId)
	if not ok or not inGroup then
		return { ok = false, err = "Join the group first, then claim!" }
	end
	n.data.Flags.Group = true
	n.data.Cash += Config.GroupRewardCash
	Nations.notify(player, ("Thanks for joining! +%s"):format(Format.cash(Config.GroupRewardCash)), "pay")
	S.StateService.push(n)
	return { ok = true }
end

local function onRedeem(player: Player, code: any)
	local n = Nations.get(player)
	if not n or typeof(code) ~= "string" then
		return { ok = false }
	end
	code = string.upper((code:gsub("%s", "")))
	local reward = Config.Codes[code]
	if not reward then
		return { ok = false, err = "Invalid code" }
	end
	if n.data.Redeemed[code] then
		return { ok = false, err = "Code already redeemed" }
	end
	n.data.Redeemed[code] = true
	n.data.Cash += reward
	Nations.notify(player, ("Code redeemed: +%s"):format(Format.cash(reward)), "pay")
	S.StateService.push(n)
	return { ok = true, reward = reward }
end

---------------------------------------------------------------------------
-- Quests
---------------------------------------------------------------------------
function RewardService.questProgress(n: Nation): (any?, number, number)
	local q = Quests[n.data.Quest]
	if not q then
		return nil, 0, 0
	end
	local data = n.data
	local cur = 0
	if q.kind == "build" then
		cur = Nations.countBuilt(n, q.target :: string)
	elseif q.kind == "population" then
		cur = math.floor(data.Population)
	elseif q.kind == "research" then
		cur = data.Researched[q.target :: string] and 1 or 0
	elseif q.kind == "stock" then
		cur = data.Inventory[q.target :: string] or 0
	elseif q.kind == "launch" then
		cur = data.Stats.Launches
	elseif q.kind == "hits" then
		cur = data.Stats.Hits
	elseif q.kind == "capture" then
		cur = data.Stats.Captures
	elseif q.kind == "units" then
		cur = S.UnitService.count(n)
	end
	return q, math.min(cur, q.count), q.count
end

function RewardService.tick(_n: Nation, _now: number)
	-- quest progress is computed on demand by StateService
end

local function onClaimQuest(player: Player)
	local n = Nations.get(player)
	if not n then
		return { ok = false }
	end
	local q, cur, max = RewardService.questProgress(n)
	if not q or cur < max then
		return { ok = false, err = "Objective not complete" }
	end
	n.data.Quest += 1
	n.data.Cash += q.reward
	Nations.notify(player, ("Objective complete: +%s"):format(Format.cash(q.reward)), "pay")
	S.StateService.push(n)
	return { ok = true, reward = q.reward }
end

function RewardService.init(services)
	S = services
end

function RewardService.start()
	Net.handle("ClaimDaily", onClaimDaily, 2)
	Net.handle("ClaimPlaytime", onClaimPlaytime, 2)
	Net.handle("ClaimGroup", onClaimGroup, 2)
	Net.handle("RedeemCode", onRedeem, 2)
	Net.handle("ClaimQuest", onClaimQuest, 3)
end

return RewardService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="39">
          <Properties>
            <string name="Name">StateService</string>
            <string name="Source"><![CDATA[--[[
	StateService
	Builds the local player's state snapshot and sends only the keys that
	changed since the last push (one small RemoteEvent per second at most).
]]

local HttpService = game:GetService("HttpService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage.Shared
local Config = require(Shared.Config)
local Net = require(Shared.Net)
local Weapons = require(Shared.Catalog.Weapons)
local Nations = require(script.Parent.Nations)

type Nation = Nations.Nation

local StateService = {}
local S: { [string]: any }

local function r1(x: number?): number
	return math.floor((x or 0) * 10 + 0.5) / 10
end

function StateService.snapshot(n: Nation): { [string]: any }
	local data = n.data
	local st = n.stats
	local now = Nations.now()

	local launchers = {}
	local seen = {}
	for _, w in Weapons.all() do
		if not seen[w.family] then
			seen[w.family] = true
			local total, ready, _, nextReady = S.CombatService.launcherState(n, w.family, now)
			if total > 0 then
				launchers[w.family] = { total = total, ready = ready, nextReady = nextReady ~= math.huge and nextReady or 0 }
			end
		end
	end

	local q, qCur, qMax = S.RewardService.questProgress(n)
	local quest: any = false
	if q then
		quest = { i = data.Quest, text = q.text, cur = qCur, max = qMax, reward = q.reward, done = qCur >= qMax }
	end

	return {
		cash = math.floor(data.Cash),
		income = math.floor(st.income or 0),
		gross = math.floor(st.gross or 0),
		upkeep = math.floor(st.upkeep or 0),
		mult = r1(st.mult or 1),
		nextPay = n.nextPayAt,
		pop = math.floor(data.Population),
		popCap = math.floor(st.housingCap or 0),
		workersDemand = math.floor(st.workersDemand or 0),
		workersUsed = math.floor(st.workersUsed or 0),
		happiness = math.floor(st.happiness or 0),
		power = { math.floor(st.powerSupply or 0), math.floor(st.powerDemand or 0) },
		water = { math.floor(st.waterSupply or 0), math.floor(st.waterDemand or 0) },
		oil = math.floor(data.Oil),
		oilCap = st.oilCap or Config.BaseResourceCap,
		oilRate = r1(st.oilRate),
		steel = math.floor(data.Steel),
		steelCap = st.steelCap or Config.BaseResourceCap,
		steelRate = r1(st.steelRate),
		rp = math.floor(data.ResearchPoints),
		rpRate = r1(st.rpRate),
		researched = data.Researched,
		research = data.ActiveResearch or false,
		inventory = data.Inventory,
		launchers = launchers,
		units = S.UnitService.count(n),
		unitCap = S.UnitService.cap(n),
		stats = data.Stats,
		pvp = data.Pvp,
		pvpLock = n.pvpLockUntil,
		shield = n.shieldUntil,
		passes = n.passes,
		boostUntil = data.BoostUntil,
		quest = quest,
		daily = S.RewardService.dailyInfo(n),
		giftAt = n.giftAt,
		giftReward = S.RewardService.giftReward(n),
		groupId = Config.GroupId,
		groupClaimed = data.Flags.Group == true,
		starter = data.Flags.StarterPack == true,
		plot = n.plotIndex,
		billboard = data.Billboard,
		queueLimit = S.ProductionService.queueLimit(n),
		damaged = st.damaged or 0,
		persistent = S.DataService.isPersistent(),
	}
end

-- Send changed keys (or everything when full = true).
function StateService.push(n: Nation, full: boolean?)
	if not n.ready or not n.player.Parent then
		return
	end
	local snap = StateService.snapshot(n)
	local patch = {}
	local any = false
	for k, v in snap do
		local enc = type(v) == "table" and HttpService:JSONEncode(v) or tostring(v)
		if full or n.sent[k] ~= enc then
			n.sent[k] = enc
			patch[k] = v
			any = true
		end
	end
	if any then
		Net.event("State"):FireClient(n.player, patch)
	end
end

function StateService.init(services)
	S = services
end

function StateService.start()
	Net.handle("GetSnapshot", function(player)
		local n = Nations.get(player)
		if not n or not n.ready then
			return nil
		end
		local snap = StateService.snapshot(n)
		for k, v in snap do
			n.sent[k] = type(v) == "table" and HttpService:JSONEncode(v) or tostring(v)
		end
		return snap
	end, 4)
end

return StateService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="40">
          <Properties>
            <string name="Name">UnitService</string>
            <string name="Source"><![CDATA[--[[
	UnitService
	Ground vehicles. Units are physics assemblies driven by AlignPosition /
	AlignOrientation (server-owned) so they glide smoothly on every client.
	They roll out at home, deploy to the mainland staging area through the
	"tunnel", move in formation and fight automatically on the mainland.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage.Shared
local Config = require(Shared.Config)
local Grid = require(Shared.Util.Grid)
local Net = require(Shared.Net)
local Units = require(Shared.Catalog.Units)
local ModelBuilder = require(Shared.ModelBuilder)
local Nations = require(script.Parent.Nations)

type Nation = Nations.Nation

export type Unit = {
	uid: number,
	id: string,
	def: any,
	n: Nation,
	hp: number,
	model: Model,
	root: BasePart,
	align: AlignPosition,
	orient: AlignOrientation,
	location: string, -- "home" | "mainland"
	height: number,
	lastShot: number,
}

local UnitService = {}
local S: { [string]: any }
local folder: Folder
local all: { [Unit]: boolean } = {}

local HALF = Config.MainlandSize / 2

function UnitService.inMainland(pos: Vector3): boolean
	local d = pos - Config.MainlandOrigin
	return math.abs(d.X) <= HALF and math.abs(d.Z) <= HALF
end

function UnitService.stagingPos(n: Nation): Vector3
	return Config.MainlandOrigin + Vector3.new(-1050 + (n.plotIndex - 1) * 300, 0, HALF - 110)
end

function UnitService.cap(n: Nation): number
	local cap = 10 + (n.stats.depotCap or 0)
	if n.passes.VIP then
		cap += 10
	end
	if n.passes.ExtraQueue then
		cap += 20
	end
	return math.min(cap, Config.MaxUnitsPerPlayer + 20)
end

function UnitService.count(n: Nation): number
	local c = 0
	for _ in n.units do
		c += 1
	end
	return c
end

function UnitService.canAdd(n: Nation): boolean
	return UnitService.count(n) < UnitService.cap(n)
end

local function homePos(n: Nation, near: any?): Vector3
	local anchor: Vector3? = nil
	for _, b in n.buildings do
		if b.def.depot and Nations.isActive(b) then
			anchor = S.BuildService.worldCFrame(n, b).Position
			break
		end
	end
	if not anchor and near then
		anchor = S.BuildService.worldCFrame(n, near).Position
	end
	local base = anchor or (n.origin + Vector3.new(0, 0, Grid.PlotSize / 2 - 30))
	local rng = Random.new()
	local p = base + Vector3.new(rng:NextNumber(-18, 18), 0, rng:NextNumber(-18, 18))
	-- keep inside the plot
	local half = Grid.PlotSize / 2 - 6
	local d = p - n.origin
	return n.origin + Vector3.new(math.clamp(d.X, -half, half), 0, math.clamp(d.Z, -half, half))
end

local function setTarget(u: Unit, pos: Vector3)
	local current = u.root.CFrame.Position
	local target = Vector3.new(pos.X, u.height, pos.Z)
	u.align.Position = target
	local flatDir = Vector3.new(target.X - current.X, 0, target.Z - current.Z)
	if flatDir.Magnitude > 1 then
		u.orient.CFrame = CFrame.lookAt(Vector3.zero, flatDir.Unit)
	end
	u.model:SetAttribute("Moving", true)
end

local function teleport(u: Unit, pos: Vector3)
	local cf = CFrame.new(pos.X, u.height, pos.Z) * u.root.CFrame.Rotation
	u.model:PivotTo(cf)
	u.root.AssemblyLinearVelocity = Vector3.zero
	u.align.Position = cf.Position
end

function UnitService.spawn(n: Nation, id: string, hp: number?, near: any?, uid: number?): Unit?
	local def = Units.get(id)
	if not def then
		return nil
	end
	local model = ModelBuilder.unit(def)
	local root = model.PrimaryPart :: BasePart
	local height = root.Size.Y / 2
	-- weld everything to the root and make it a physics assembly
	for _, p in model:GetDescendants() do
		if p:IsA("BasePart") then
			p.CanCollide = false
			p.CanTouch = false
			if p ~= root then
				p.Massless = true
				local w = Instance.new("WeldConstraint")
				w.Part0 = root
				w.Part1 = p
				w.Parent = p
			end
		end
	end
	local att = Instance.new("Attachment")
	att.Name = "Drive"
	att.Parent = root
	local align = Instance.new("AlignPosition")
	align.Mode = Enum.PositionAlignmentMode.OneAttachment
	align.Attachment0 = att
	align.MaxForce = 1e7
	align.MaxVelocity = def.speed
	align.Responsiveness = 30
	align.Parent = root
	local orient = Instance.new("AlignOrientation")
	orient.Mode = Enum.OrientationAlignmentMode.OneAttachment
	orient.Attachment0 = att
	orient.MaxTorque = 1e7
	orient.Responsiveness = 18
	orient.Parent = root

	local unitUid = uid or n.nextUnitUid
	if unitUid >= n.nextUnitUid then
		n.nextUnitUid = unitUid + 1
	end
	model.Name = def.name
	model:SetAttribute("Unit", true)
	model:SetAttribute("UnitId", def.id)
	model:SetAttribute("Uid", unitUid)
	model:SetAttribute("OwnerId", n.userId)
	model:SetAttribute("OwnerName", n.player.DisplayName)
	model:SetAttribute("Hp", hp or def.hp)
	model:SetAttribute("MaxHp", def.hp)
	model:SetAttribute("Color", Config.NationColors[n.plotIndex] or Color3.new(1, 1, 1))

	local pos = homePos(n, near)
	model:PivotTo(CFrame.new(pos.X, height, pos.Z))
	for _, p in model:GetDescendants() do
		if p:IsA("BasePart") then
			p.Anchored = false
		end
	end
	align.Position = Vector3.new(pos.X, height, pos.Z)
	orient.CFrame = CFrame.new()
	model.Parent = folder
	pcall(function()
		root:SetNetworkOwner(nil)
	end)

	local u: Unit = {
		uid = unitUid,
		id = id,
		def = def,
		n = n,
		hp = hp or def.hp,
		model = model,
		root = root,
		align = align,
		orient = orient,
		location = "home",
		height = height,
		lastShot = 0,
	}
	n.units[unitUid] = u
	all[u] = true
	return u
end

function UnitService.remove(u: Unit, exploded: boolean?)
	all[u] = nil
	u.n.units[u.uid] = nil
	if exploded then
		Net.event("Effect"):FireAllClients("Explosion", u.root.CFrame.Position, 1)
	end
	u.model:Destroy()
end

-- Returns true if destroyed.
function UnitService.damage(u: Unit, amount: number, attacker: Nation?): boolean
	if not all[u] then
		return false
	end
	u.hp -= amount
	u.model:SetAttribute("Hp", math.max(0, math.floor(u.hp)))
	if u.hp <= 0 then
		Nations.notify(u.n.player, ("Your %s was destroyed"):format(u.def.name), "bad")
		if attacker then
			attacker.data.Stats.Kills += 1
		end
		UnitService.remove(u, true)
		return true
	end
	return false
end

function UnitService.unitsNear(pos: Vector3, radius: number, excludeUserId: number?): { Unit }
	local out = {}
	for u in all do
		if u.n.userId ~= excludeUserId then
			local p = u.root.CFrame.Position
			local d = Vector2.new(p.X - pos.X, p.Z - pos.Z).Magnitude
			if d <= radius then
				table.insert(out, u)
			end
		end
	end
	return out
end

function UnitService.mainlandUnits(): { Unit }
	local out = {}
	for u in all do
		if u.location == "mainland" then
			table.insert(out, u)
		end
	end
	return out
end

function UnitService.loadNation(n: Nation)
	for _, s in n.data.Units do
		if UnitService.count(n) >= Config.MaxUnitsPerPlayer + 20 then
			break
		end
		UnitService.spawn(n, s.id, s.hp, nil, s.u)
	end
end

function UnitService.serialize(n: Nation)
	local out = {}
	for _, u in n.units do
		table.insert(out, { u = u.uid, id = u.id, hp = math.floor(u.hp) })
	end
	n.data.Units = out
end

function UnitService.clearNation(n: Nation)
	for _, u in n.units do
		UnitService.remove(u, false)
	end
end

---------------------------------------------------------------------------
-- Commands
---------------------------------------------------------------------------
local function collect(n: Nation, uids: any, filter: ((Unit) -> boolean)?): { Unit }
	local out = {}
	if typeof(uids) == "table" then
		for i, uid in uids do
			if i > 100 then
				break
			end
			local u = typeof(uid) == "number" and n.units[uid] or nil
			if u and (not filter or filter(u)) then
				table.insert(out, u)
			end
		end
	else
		for _, u in n.units do
			if not filter or filter(u) then
				table.insert(out, u)
			end
		end
	end
	return out
end

local function deploy(n: Nation, u: Unit)
	local staging = UnitService.stagingPos(n)
	local rng = Random.new()
	teleport(u, staging + Vector3.new(rng:NextNumber(-30, 30), 0, rng:NextNumber(-20, 20)))
	u.location = "mainland"
	u.model:SetAttribute("Location", "mainland")
end

local function recall(n: Nation, u: Unit)
	teleport(u, homePos(n))
	u.location = "home"
	u.model:SetAttribute("Location", "home")
end

local function onCommand(player: Player, uids: any, target: any)
	local n = Nations.get(player)
	if not n or typeof(target) ~= "Vector3" then
		return { ok = false, err = "Invalid request" }
	end
	local units = collect(n, uids)
	if #units == 0 then
		return { ok = false, err = "Select units first" }
	end
	local toMainland = UnitService.inMainland(target)
	local toHome = Grid.insidePlot(n.origin, target, 0)
	if not toMainland and not toHome then
		return { ok = false, err = "Units can only move on your land or the mainland" }
	end
	-- simple square formation around the target
	local cols = math.ceil(math.sqrt(#units))
	local spacing = 11
	for i, u in units do
		if toMainland and u.location ~= "mainland" then
			deploy(n, u)
		elseif toHome and u.location == "mainland" then
			recall(n, u)
		end
		local row = (i - 1) // cols
		local col = (i - 1) % cols
		local offset = Vector3.new((col - (cols - 1) / 2) * spacing, 0, (row - (cols - 1) / 2) * spacing)
		setTarget(u, target + offset)
	end
	return { ok = true, count = #units }
end

local function onDeploy(player: Player, uids: any)
	local n = Nations.get(player)
	if not n then
		return { ok = false }
	end
	local units = collect(n, uids, function(u)
		return u.location ~= "mainland"
	end)
	for _, u in units do
		deploy(n, u)
	end
	if #units > 0 then
		Nations.notify(player, ("%d units drove through the tunnel to the mainland"):format(#units), "good")
	end
	return { ok = #units > 0, count = #units, err = #units == 0 and "No units at home" or nil }
end

local function onRecall(player: Player, uids: any)
	local n = Nations.get(player)
	if not n then
		return { ok = false }
	end
	local units = collect(n, uids, function(u)
		return u.location ~= "home"
	end)
	for _, u in units do
		recall(n, u)
	end
	return { ok = #units > 0, count = #units, err = #units == 0 and "No units on the mainland" or nil }
end

---------------------------------------------------------------------------
-- Combat loop (mainland only)
---------------------------------------------------------------------------
local STEP = 0.5

local function combatStep()
	local now = os.clock()
	local units = UnitService.mainlandUnits()
	for _, u in units do
		if all[u] then
			-- arrival
			if u.model:GetAttribute("Moving") then
				local d = (u.align.Position - u.root.CFrame.Position) * Vector3.new(1, 0, 1)
				if d.Magnitude < 2 then
					u.model:SetAttribute("Moving", nil)
				end
			end
			if u.def.dps > 0 then
				local pos = u.root.CFrame.Position
				local best, bestD = nil, u.def.range
				for _, other in units do
					if other.n ~= u.n and all[other] then
						local d = (other.root.CFrame.Position - pos).Magnitude
						if d <= bestD then
							best, bestD = other, d
						end
					end
				end
				if best then
					if now - u.lastShot > 1 then
						u.lastShot = now
						Net.event("Effect"):FireAllClients("Shot", pos + Vector3.new(0, 2, 0), best.root.CFrame.Position, u.def.range > 150)
					end
					UnitService.damage(best, u.def.dps * STEP, u.n)
				else
					local point = S.ConquestService.enemyPointInRange(pos, u.def.range, u.n.userId)
					if point then
						if now - u.lastShot > 1.2 then
							u.lastShot = now
							Net.event("Effect"):FireAllClients("Shot", pos + Vector3.new(0, 2, 0), point.center + Vector3.new(0, 4, 0), u.def.range > 150)
						end
						S.ConquestService.damageGarrison(point, u.def.dps * STEP, u.n)
					end
				end
			end
		end
	end
end

-- exposed for automated tests
UnitService._combatStep = combatStep

function UnitService.init(services)
	S = services
	folder = Instance.new("Folder")
	folder.Name = "Units"
	folder.Parent = workspace
end

function UnitService.start()
	Net.handle("CommandUnits", onCommand, 6)
	Net.handle("DeployUnits", onDeploy, 3)
	Net.handle("RecallUnits", onRecall, 3)
	task.spawn(function()
		while true do
			task.wait(STEP)
			local ok, err = pcall(combatStep)
			if not ok then
				warn("[Units] combat step failed: " .. tostring(err))
			end
		end
	end)
end

return UnitService
]]></string>
          </Properties>
        </Item>
      </Item>
    </Item>
  </Item>
  <Item class="SoundService" referent="41">
    <Properties>
      <string name="Name">SoundService</string>
      <bool name="RespectFilteringEnabled">true</bool>
    </Properties>
  </Item>
  <Item class="StarterPlayer" referent="42">
    <Properties>
      <string name="Name">StarterPlayer</string>
      <float name="CameraMaxZoomDistance">450</float>
      <float name="CameraMinZoomDistance">8</float>
    </Properties>
    <Item class="StarterPlayerScripts" referent="43">
      <Properties>
        <string name="Name">StarterPlayerScripts</string>
      </Properties>
      <Item class="Folder" referent="44">
        <Properties>
          <string name="Name">Client</string>
        </Properties>
        <Item class="ModuleScript" referent="45">
          <Properties>
            <string name="Name">ClientState</string>
            <string name="Source"><![CDATA[--[[
	ClientState
	Holds the latest state the server sent for the local player and lets
	controllers subscribe to changes. Also tracks the client "mode":
	  "play"  - walking around your nation
	  "build" - build menu open / placing / deleting / moving
	  "war"   - strategic camera (Travel): aim weapons, command units
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Net = require(ReplicatedStorage.Shared.Net)

local ClientState = {}

ClientState.data = {} :: { [string]: any }
ClientState.mode = "play"
ClientState.player = Players.LocalPlayer

local keyListeners: { [string]: { (any) -> () } } = {}
local anyListeners: { (patch: { [string]: any }) -> () } = {}
local modeListeners: { (string, string) -> () } = {}

local function fire(patch: { [string]: any })
	for k, v in patch do
		ClientState.data[k] = v
	end
	for k, v in patch do
		local list = keyListeners[k]
		if list then
			for _, fn in list do
				task.spawn(fn, v)
			end
		end
	end
	for _, fn in anyListeners do
		task.spawn(fn, patch)
	end
end

-- Subscribe to one key; called immediately if a value already exists.
function ClientState.on(key: string, fn: (any) -> ())
	keyListeners[key] = keyListeners[key] or {}
	table.insert(keyListeners[key], fn)
	if ClientState.data[key] ~= nil then
		task.spawn(fn, ClientState.data[key])
	end
end

-- Returns a function that unsubscribes.
function ClientState.onAny(fn: (patch: { [string]: any }) -> ()): () -> ()
	table.insert(anyListeners, fn)
	return function()
		local i = table.find(anyListeners, fn)
		if i then
			table.remove(anyListeners, i)
		end
	end
end

function ClientState.get(key: string): any
	return ClientState.data[key]
end

function ClientState.setMode(mode: string)
	local old = ClientState.mode
	if old == mode then
		return
	end
	ClientState.mode = mode
	for _, fn in modeListeners do
		task.spawn(fn, mode, old)
	end
end

function ClientState.onMode(fn: (string, string) -> ())
	table.insert(modeListeners, fn)
end

function ClientState.start()
	Net.event("State").OnClientEvent:Connect(fire)
	task.spawn(function()
		for _ = 1, 60 do
			local snap = Net.request("GetSnapshot")
			if type(snap) == "table" and snap.cash ~= nil then
				fire(snap)
				return
			end
			task.wait(1)
		end
	end)
end

return ClientState
]]></string>
          </Properties>
        </Item>
        <Item class="Folder" referent="46">
          <Properties>
            <string name="Name">Controllers</string>
          </Properties>
          <Item class="ModuleScript" referent="47">
            <Properties>
              <string name="Name">Animator</string>
              <string name="Source"><![CDATA[--[[
	Animator
	Makes the cities feel alive (client-side only, distance culled):
	  * wind turbine rotors and radar dishes spin, pump jacks rock
	  * construction progress bars over buildings being built
	  * fuel trucks drive refinery -> factory -> refinery along the grid
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Shared = ReplicatedStorage.Shared
local ModelBuilder = require(Shared.ModelBuilder)
local Format = require(Shared.Util.Format)

local Client = script.Parent.Parent
local Lib = require(Client.UI.Lib)
local Theme = require(Client.UI.Theme)

local New = Lib.New

local Animator = {}

local camera = workspace.CurrentCamera
local CULL = 650

type Spinner = { sub: Model, base: CFrame, speed: number, axis: string, rock: number?, phase: number }

local spinners: { [Model]: Spinner } = {}
local bars: { [Model]: { gui: BillboardGui, bar: Lib.Progress, label: TextLabel } } = {}
local trucks: { [string]: Model } = {}
local refineries: { [Model]: boolean } = {}

local function axisAngles(axis: string, angle: number): CFrame
	if axis == "X" then
		return CFrame.Angles(angle, 0, 0)
	elseif axis == "Y" then
		return CFrame.Angles(0, angle, 0)
	end
	return CFrame.Angles(0, 0, angle)
end

local function registerSpinners(building: Model)
	for _, d in building:GetDescendants() do
		if d:IsA("Model") and (d:GetAttribute("Spin") or d:GetAttribute("Rock")) and d.PrimaryPart then
			spinners[d] = {
				sub = d,
				base = d:GetPivot(),
				speed = (d:GetAttribute("Spin") :: number?) or 2,
				axis = (d:GetAttribute("SpinAxis") :: string?) or "Y",
				rock = d:GetAttribute("Rock") :: number?,
				phase = math.random() * 10,
			}
		end
	end
	local base = building.PrimaryPart
	if base then
		-- the server moved the building: re-read the rest pose
		base:GetPropertyChangedSignal("CFrame"):Connect(function()
			task.defer(function()
				for sub, s in spinners do
					if sub:IsDescendantOf(building) then
						s.base = sub:GetPivot()
					end
				end
			end)
		end)
	end
end

local function updateBar(building: Model)
	local finishAt = building:GetAttribute("FinishAt") :: number?
	local existing = bars[building]
	if finishAt and not existing then
		local base = building.PrimaryPart
		if not base then
			return
		end
		local gui = New("BillboardGui", {
			Name = "Construction",
			Adornee = base,
			Size = UDim2.fromOffset(120, 34),
			StudsOffsetWorldSpace = Vector3.new(0, 12, 0),
			AlwaysOnTop = true,
			MaxDistance = 380,
			LightInfluence = 0,
			Parent = building,
		})
		local card = New("Frame", {
			BackgroundColor3 = Theme.Color.Hud,
			BackgroundTransparency = 0.2,
			Size = UDim2.fromScale(1, 1),
			Parent = gui,
		}, { Lib.corner(6), Lib.pad(4, 8) })
		local label = Lib.text({ Text = "", TextColor3 = Color3.new(1, 1, 1), TextSize = 12, FontFace = Theme.Font.Bold, TextXAlignment = Enum.TextXAlignment.Center, Size = UDim2.new(1, 0, 0, 16), Parent = card })
		local bar = Lib.progress({ Position = UDim2.new(0, 0, 1, -6), Size = UDim2.new(1, 0, 0, 5), Parent = card })
		bars[building] = { gui = gui, bar = bar, label = label }
	elseif not finishAt and existing then
		existing.gui:Destroy()
		bars[building] = nil
	end
end

local function hookBuilding(building: Instance)
	if not building:IsA("Model") then
		return
	end
	task.defer(function()
		registerSpinners(building)
		updateBar(building)
		if building:GetAttribute("BuildingId") and tostring(building:GetAttribute("BuildingId")):find("refinery") then
			refineries[building] = true
		end
	end)
	building:GetAttributeChangedSignal("FinishAt"):Connect(function()
		updateBar(building)
	end)
	building.AncestryChanged:Connect(function()
		if not building.Parent then
			for sub in spinners do
				if not sub.Parent or sub:IsDescendantOf(building) then
					spinners[sub] = nil
				end
			end
			if bars[building] then
				bars[building] = nil
			end
			refineries[building] = nil
		end
	end)
end

local function hookPlot(plot: Instance)
	local folder = plot:WaitForChild("Buildings", 10)
	if not folder then
		return
	end
	folder.ChildAdded:Connect(hookBuilding)
	for _, b in folder:GetChildren() do
		hookBuilding(b)
	end
end

---------------------------------------------------------------------------
-- Trucks
---------------------------------------------------------------------------
local function truckModel(key: string): Model
	local m = trucks[key]
	if not m then
		m = ModelBuilder.fuelTruck()
		m.Parent = workspace:FindFirstChild("FX") or workspace
		trucks[key] = m
	end
	return m
end

-- L-shaped route: along X first, then Z.
local function routePoint(a: Vector3, b: Vector3, f: number): (Vector3, Vector3)
	local corner = Vector3.new(b.X, 0, a.Z)
	local l1 = math.abs(b.X - a.X)
	local l2 = math.abs(b.Z - a.Z)
	local total = math.max(0.01, l1 + l2)
	local d = f * total
	if d <= l1 then
		local dir = Vector3.new(b.X >= a.X and 1 or -1, 0, 0)
		return Vector3.new(a.X, 0, a.Z) + dir * d, dir
	end
	local dir = Vector3.new(0, 0, b.Z >= a.Z and 1 or -1)
	return corner + dir * (d - l1), dir
end

local function updateTrucks(now: number)
	local active: { [string]: boolean } = {}
	local camPos = camera.CFrame.Position
	for refinery in refineries do
		local folder = refinery.Parent
		if folder and refinery.PrimaryPart then
			for i = 1, 3 do
				local attr = refinery:GetAttribute("Truck" .. i) :: string?
				if attr and attr ~= "" then
					local uidStr, depart, arrive, ret = attr:match("^(%d+)|([%d%.]+)|([%d%.]+)|([%d%.]+)$")
					local target = uidStr and folder:FindFirstChild(uidStr) :: Model?
					local a = refinery:GetPivot().Position
					if target and depart and arrive and ret and (a - camPos).Magnitude < CULL * 1.5 then
						local b = target:GetPivot().Position
						local t0, t1, t2 = tonumber(depart) :: number, tonumber(arrive) :: number, tonumber(ret) :: number
						local pos, dir
						if now <= t1 then
							pos, dir = routePoint(a, b, math.clamp((now - t0) / math.max(0.1, t1 - t0), 0, 1))
						else
							pos, dir = routePoint(b, a, math.clamp((now - t1) / math.max(0.1, t2 - t1), 0, 1))
						end
						-- reversed route on the way back so the truck retraces the L
						local key = refinery.Name .. "_" .. i
						active[key] = true
						local m = truckModel(key)
						m:PivotTo(CFrame.lookAt(pos + Vector3.new(0, 0.2, 0), pos + Vector3.new(0, 0.2, 0) + dir))
					end
				end
			end
		end
	end
	for key, m in trucks do
		if not active[key] then
			m:Destroy()
			trucks[key] = nil
		end
	end
end

---------------------------------------------------------------------------
-- Frame loop
---------------------------------------------------------------------------
local function step()
	local now = Lib.serverNow()
	local t = os.clock()
	local camPos = camera.CFrame.Position
	for sub, s in spinners do
		if sub.Parent and (s.base.Position - camPos).Magnitude < CULL then
			local angle
			if s.rock then
				angle = math.sin(t * 2.2 + s.phase) * s.rock
				sub:PivotTo(s.base * CFrame.Angles(angle, 0, 0))
			else
				angle = (t + s.phase) * s.speed
				sub:PivotTo(s.base * axisAngles(s.axis, angle))
			end
		end
	end
	for building, b in bars do
		local finishAt = building:GetAttribute("FinishAt") :: number?
		local start = building:GetAttribute("BuildStart") :: number?
		if finishAt and start then
			b.bar.set((now - start) / math.max(0.1, finishAt - start), Theme.Color.Accent)
			b.label.Text = "Building " .. Format.clock(finishAt - now)
		end
	end
	updateTrucks(now)
end

function Animator.init()
	task.spawn(function()
		local homeland = workspace:WaitForChild("Homeland")
		homeland.ChildAdded:Connect(function(c)
			if c.Name:match("^Plot_") then
				hookPlot(c)
			end
		end)
		for _, c in homeland:GetChildren() do
			if c.Name:match("^Plot_") then
				task.spawn(hookPlot, c)
			end
		end
	end)
	RunService.RenderStepped:Connect(step)
end

return Animator
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="48">
            <Properties>
              <string name="Name">ArmyUI</string>
              <string name="Source"><![CDATA[--[[
	ArmyUI
	Overview of your vehicles: counts per type and location, plus one-click
	Deploy (through the tunnel to the mainland), Recall and Select.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage.Shared
local Units = require(Shared.Catalog.Units)
local Net = require(Shared.Net)

local Client = script.Parent.Parent
local ClientState = require(Client.ClientState)
local Hub = require(Client.Hub)
local Lib = require(Client.UI.Lib)
local Theme = require(Client.UI.Theme)
local Icons = require(Client.UI.Icons)
local Modal = require(script.Parent.Modal)
local Notifications = require(script.Parent.Notifications)
local Sounds = require(script.Parent.Sounds)
local UnitView = require(script.Parent.UnitView)

local New = Lib.New

local ArmyUI = {}

function ArmyUI.open()
	local win = Modal.open("Army", "Vehicles are built in Military Factories", 640, 520)
	local ic = Icons.tank(40, Color3.fromRGB(110, 130, 80))
	ic.Position = UDim2.fromOffset(6, 4)
	ic.Parent = win.iconHolder

	local mine = UnitView.mine()
	local byType: { [string]: { home: number, mainland: number } } = {}
	for _, m in mine do
		local id = m:GetAttribute("UnitId") :: string
		byType[id] = byType[id] or { home = 0, mainland = 0 }
		if m:GetAttribute("Location") == "mainland" then
			byType[id].mainland += 1
		else
			byType[id].home += 1
		end
	end

	local top = New("Frame", { BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 40), Parent = win.body }, { Lib.list("x", 8) })
	Lib.text({
		Text = ("%d / %d vehicles"):format(ClientState.get("units") or #mine, ClientState.get("unitCap") or 10),
		FontFace = Theme.Font.Bold,
		TextSize = Theme.TextSize.Title,
		Size = UDim2.new(0, 190, 1, 0),
		LayoutOrder = 1,
		Parent = top,
	})
	local function action(text: string, color: Color3, order: number, fn: () -> ())
		Lib.button({
			Text = text,
			FontFace = Theme.Font.Bold,
			TextColor3 = Color3.new(1, 1, 1),
			BackgroundColor3 = color,
			Size = UDim2.fromOffset(128, 38),
			LayoutOrder = order,
			Parent = top,
			Activated = fn,
		}, { Lib.corner(7) })
	end
	action("Deploy All", Theme.Color.Military, 2, function()
		local res = Net.request("DeployUnits", nil)
		if res.ok then
			Sounds.play("Whoosh")
			Modal.close()
			Hub.call("goWar", "mainland")
		elseif res.err then
			Notifications.show(res.err, "info")
		end
	end)
	action("Recall All", Theme.Color.Time, 3, function()
		local res = Net.request("RecallUnits", nil)
		if res.ok then
			Modal.close()
		elseif res.err then
			Notifications.show(res.err, "info")
		end
	end)
	action("Command", Theme.Color.Good, 4, function()
		Modal.close()
		Hub.call("goWar", "mainland")
		for _, m in UnitView.mine() do
			if m:GetAttribute("Location") == "mainland" then
				UnitView.select(m, true)
			end
		end
	end)

	local list = New("ScrollingFrame", {
		BackgroundTransparency = 1,
		Position = UDim2.fromOffset(0, 52),
		Size = UDim2.new(1, 0, 1, -52),
		CanvasSize = UDim2.new(),
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
		ScrollBarThickness = 4,
		BorderSizePixel = 0,
		Parent = win.body,
	}, { Lib.list("y", 6) })
	local any = false
	for i, def in Units.all() do
		local counts = byType[def.id]
		if counts then
			any = true
			local row = Lib.card({ Size = UDim2.new(1, -6, 0, 56), LayoutOrder = i, Parent = list }, { Lib.pad(8, 14) })
			Lib.text({ Text = def.name, FontFace = Theme.Font.Bold, Size = UDim2.new(0.4, 0, 0, 20), Parent = row })
			Lib.text({ Text = def.role .. " · " .. def.desc, TextSize = Theme.TextSize.Tiny, TextColor3 = Theme.Color.Muted, Position = UDim2.fromOffset(0, 20), Size = UDim2.new(0.6, 0, 0, 16), Parent = row })
			Lib.chip(("%d home"):format(counts.home), Theme.Color.TimeSoft, Theme.Color.Time, { AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -86, 0.5, 0), Parent = row })
			Lib.chip(("%d mainland"):format(counts.mainland), Theme.Color.BadSoft, Theme.Color.Bad, { AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, 0, 0.5, 0), Parent = row })
		end
	end
	if not any then
		Lib.text({
			Text = "No vehicles yet. Research Mechanized Forces, build a Military Factory, then queue vehicles in its panel.",
			TextWrapped = true,
			TextColor3 = Theme.Color.Muted,
			Size = UDim2.new(1, 0, 0, 44),
			Parent = list,
		})
	end
end

function ArmyUI.init()
	Hub.openArmy = ArmyUI.open
end

return ArmyUI
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="49">
            <Properties>
              <string name="Name">BuildMenu</string>
              <string name="Source"><![CDATA[--[[
	BuildMenu
	The bottom build bar:
	  [Civilian/Military rail] [tabs, breadcrumb, faction toggle, item cards]
	  [tools: Delete 2, Undo 3, Drag 4, Move 5, Rotate 6, close X + selected detail]
	plus the hover tooltip ("SRBM Launcher $12000 · LMB place · R turn").
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local UserInputService = game:GetService("UserInputService")

local Shared = ReplicatedStorage.Shared
local Buildings = require(Shared.Catalog.Buildings)
local Weapons = require(Shared.Catalog.Weapons)
local Research = require(Shared.Catalog.Research)
local Products = require(Shared.Catalog.Products)
local ModelBuilder = require(Shared.ModelBuilder)
local Unlocks = require(Shared.Util.Unlocks)
local Format = require(Shared.Util.Format)

local Client = script.Parent.Parent
local ClientState = require(Client.ClientState)
local Hub = require(Client.Hub)
local Lib = require(Client.UI.Lib)
local Theme = require(Client.UI.Theme)
local Icons = require(Client.UI.Icons)
local Placement = require(script.Parent.Placement)
local Notifications = require(script.Parent.Notifications)
local Sounds = require(script.Parent.Sounds)

local New = Lib.New

local BuildMenu = {}

local root: Frame
local tooltip: Frame
local category = "Civilian"
local tab = "Housing"
local faction = "Standard"
local refs: { [string]: any } = {}
local cards: { [string]: { btn: TextButton, lock: Frame, price: Frame, def: any } } = {}
local thumbs: { [string]: Model } = {}

local W, H = 1480, 218

local function access(): Unlocks.Access
	return {
		researched = ClientState.get("researched") or {},
		passes = ClientState.get("passes") or {},
	}
end

local function thumbModel(def): Model
	local m = thumbs[def.id]
	if not m then
		m = ModelBuilder.building(def)
		thumbs[def.id] = m
	end
	return m
end

function BuildMenu.describe(def): string
	local bits = {}
	if def.launcher then
		local w
		for _, wd in Weapons.all() do
			if wd.family == def.launcher then
				w = wd
				break
			end
		end
		return ("Requires 1 %s per launch | max %d shared · %ds reload"):format(def.launcher, w and w.stockCap or 60, def.reload or 20)
	end
	if def.airDefense then
		local ad = def.airDefense
		return ("Range %d · %d%% hit chance · %ds reload"):format(ad.range, math.floor(ad.chance * 100), ad.reload)
	end
	if def.housing then
		table.insert(bits, ("+%d residents"):format(def.housing))
	end
	if def.powerOut then
		table.insert(bits, ("+%d MW"):format(def.powerOut))
	end
	if def.waterOut then
		table.insert(bits, ("+%d water"):format(def.waterOut))
	end
	if def.oilOut then
		table.insert(bits, ("+%d oil/min"):format(def.oilOut))
	end
	if def.steelOut then
		table.insert(bits, ("+%d steel/min"):format(def.steelOut))
	end
	if def.refine then
		table.insert(bits, ("%d fuel/min"):format(def.refine.rate))
	end
	if def.factory then
		table.insert(bits, "Builds weapons & vehicles")
	end
	if def.rpOut then
		table.insert(bits, ("+%d RP/min"):format(def.rpOut))
	end
	if def.income then
		table.insert(bits, ("+$%s per pay"):format(Format.commas(def.income)))
	end
	if def.service then
		table.insert(bits, ("Serves %s"):format(Format.short(def.service.serves)))
	end
	if def.storage then
		table.insert(bits, ("+%s storage"):format(Format.short((def.storage.oil or 0) + (def.storage.steel or 0))))
	end
	if def.depot then
		table.insert(bits, ("+%d army size"):format(def.depot))
	end
	if def.workers then
		table.insert(bits, ("%d workers"):format(def.workers))
	end
	if def.power then
		table.insert(bits, ("uses %d MW"):format(def.power))
	end
	if #bits == 0 then
		return def.desc
	end
	return table.concat(bits, " · ")
end

local function lockReason(def): (boolean, string?)
	return Unlocks.check(def, access())
end

local function tinyLock(color: Color3): Frame
	local f = New("Frame", { BackgroundTransparency = 1, Size = UDim2.fromOffset(10, 12) })
	New("Frame", {
		BackgroundColor3 = color,
		Position = UDim2.fromOffset(0, 5),
		Size = UDim2.fromOffset(10, 7),
		Parent = f,
	}, { Lib.corner(2) })
	local shackle = New("Frame", {
		BackgroundTransparency = 1,
		Position = UDim2.fromOffset(2, 0),
		Size = UDim2.fromOffset(6, 8),
		Parent = f,
	}, { Lib.round() })
	Lib.stroke(color, 1.5).Parent = shackle
	return f
end

---------------------------------------------------------------------------
-- Cards
---------------------------------------------------------------------------
local function updateCard(entry)
	local def = entry.def
	local ok = lockReason(def)
	entry.lock.Visible = not ok
	local state = Placement.state()
	local isSel = state.def ~= nil and state.def.id == def.id
	local stroke = entry.btn:FindFirstChildOfClass("UIStroke") :: UIStroke
	stroke.Color = isSel and Theme.Color.Teal or Theme.Color.CardStroke
	stroke.Thickness = isSel and 2 or 1
	Lib.setButtonColor(entry.btn, isSel and Theme.Color.AccentSoft or Theme.Color.Card)
	local afford = (ClientState.get("cash") or 0) >= def.cost
	local label = entry.price:FindFirstChild("Label") :: TextLabel
	label.TextColor3 = afford and Theme.Color.Good or Theme.Color.Bad
end

local function makeCard(def, order: number): TextButton
	local btn = Lib.button({
		Name = def.id,
		Size = UDim2.fromOffset(150, 118),
		BackgroundColor3 = Theme.Color.Card,
		LayoutOrder = order,
		Activated = function()
			local ok, reason = lockReason(def)
			if not ok then
				Notifications.show(("%s: %s"):format(def.name, reason or "Locked"), "info")
				if def.pass then
					Hub.call("openShop", "Passes")
				elseif def.research then
					Hub.call("openResearch", def.research)
				end
				return
			end
			local state = Placement.state()
			if state.def and state.def.id == def.id then
				Placement.select(nil)
			else
				Placement.select(def)
			end
		end,
	}, { Lib.corner(Theme.Radius.Card), Lib.stroke(Theme.Color.CardStroke) })
	local art = New("Frame", {
		BackgroundColor3 = Theme.Color.CivilSoft,
		Position = UDim2.fromOffset(6, 6),
		Size = UDim2.new(1, -12, 0, 62),
		Parent = btn,
	}, { Lib.corner(6) })
	art.BackgroundColor3 = category == "Military" and Color3.fromRGB(232, 238, 246) or Theme.Color.CivilSoft
	Lib.viewport(thumbModel(def), { Parent = art }, 40)
	local lock = New("Frame", {
		Name = "Lock",
		BackgroundColor3 = Color3.new(1, 1, 1),
		Position = UDim2.fromOffset(10, 10),
		Size = UDim2.fromOffset(52, 18),
		Visible = false,
		Parent = btn,
	}, {
		Lib.corner(4),
		Lib.text({
			Text = "Locked",
			TextColor3 = Theme.Color.Bad,
			TextSize = Theme.TextSize.Tiny,
			FontFace = Theme.Font.Bold,
			Size = UDim2.fromScale(1, 1),
			TextXAlignment = Enum.TextXAlignment.Center,
		}),
	})
	Lib.text({
		Text = def.name,
		FontFace = Theme.Font.Bold,
		TextSize = Theme.TextSize.Small,
		Position = UDim2.fromOffset(10, 70),
		Size = UDim2.new(1, -16, 0, 18),
		Parent = btn,
	})
	local chips = New("Frame", {
		BackgroundTransparency = 1,
		Position = UDim2.fromOffset(10, 90),
		Size = UDim2.new(1, -16, 0, 22),
		Parent = btn,
	}, { Lib.list("x", 6) })
	local price = Lib.chip("$" .. Format.commas(def.cost), Theme.Color.GoodSoft, Theme.Color.Good, { LayoutOrder = 1 })
	price.Parent = chips
	if def.buildTime > 0 then
		Lib.chip(Format.duration(def.buildTime), Theme.Color.TimeSoft, Theme.Color.Time, { LayoutOrder = 2 }).Parent = chips
	end
	cards[def.id] = { btn = btn, lock = lock, price = price, def = def }
	updateCard(cards[def.id])
	btn.MouseEnter:Connect(function()
		refs.hoverDef = def
		BuildMenu.refreshTooltip()
	end)
	btn.MouseLeave:Connect(function()
		if refs.hoverDef == def then
			refs.hoverDef = nil
			BuildMenu.refreshTooltip()
		end
	end)
	return btn
end

local function renderCards()
	Lib.clear(refs.scroller)
	table.clear(cards)
	local hasFactions = Buildings.tabHasFactions(category, tab)
	refs.factions.Visible = hasFactions
	local list = Buildings.forTab(category, tab, hasFactions and faction or nil)
	for i, def in list do
		makeCard(def, i).Parent = refs.scroller
	end
	refs.crumb.Text = ("%s / %s (%d)"):format(category, tab, #list)
	if #list == 0 then
		Lib.text({
			Text = "Nothing here yet.",
			TextColor3 = Theme.Color.Muted,
			Size = UDim2.fromOffset(300, 40),
			Parent = refs.scroller,
		})
	end
end

---------------------------------------------------------------------------
-- Tabs / categories / factions
---------------------------------------------------------------------------
local function renderTabs()
	Lib.clear(refs.tabs)
	for _, c in Buildings.Categories do
		if c.id == category then
			for i, t in c.tabs do
				local active = t == tab
				Lib.button({
					Text = t,
					FontFace = Theme.Font.Semi,
					TextSize = Theme.TextSize.Small,
					BackgroundColor3 = active and Theme.Color.TabActive or Theme.Color.Tab,
					Size = UDim2.fromOffset(98, 32),
					LayoutOrder = i,
					Parent = refs.tabs,
					Activated = function()
						tab = t
						faction = "Standard"
						renderTabs()
						BuildMenu.renderFactions()
						renderCards()
					end,
				}, { Lib.corner(6), active and Lib.stroke(Theme.Color.Teal, 1, 0.4) or nil })
			end
		end
	end
	for _, c in Buildings.Categories do
		local tile = refs["cat_" .. c.id] :: TextButton
		local active = c.id == category
		Lib.setButtonColor(tile, active and (c.id == "Civilian" and Theme.Color.CivilSoft or Theme.Color.MilitarySoft) or Theme.Color.Card)
	end
end

function BuildMenu.renderFactions()
	Lib.clear(refs.factions)
	local passes = ClientState.get("passes") or {}
	for i, f in Buildings.Factions do
		local passKey = Buildings.FactionPass[f]
		local locked = passKey ~= nil and not passes[passKey]
		local active = f == faction
		local btn = Lib.button({
			Name = f,
			Size = UDim2.fromOffset(86, 26),
			BackgroundColor3 = active and Theme.Color.Card or Theme.Color.CardAlt,
			LayoutOrder = i,
			Parent = refs.factions,
			Activated = function()
				if locked and passKey then
					local p = Products.pass(passKey)
					Notifications.show(("%s requires the %s"):format(f, p and p.name or "pack"), "info")
					Hub.call("openShop", "Passes")
					return
				end
				faction = f
				BuildMenu.renderFactions()
				renderCards()
			end,
		}, { Lib.corner(5), Lib.list("x", 5, Enum.HorizontalAlignment.Center, Enum.VerticalAlignment.Center) })
		Lib.text({
			Text = f,
			TextSize = Theme.TextSize.Small,
			FontFace = active and Theme.Font.Bold or Theme.Font.Semi,
			TextColor3 = active and Theme.Color.Text or Theme.Color.Muted,
			AutomaticSize = Enum.AutomaticSize.X,
			Size = UDim2.new(0, 0, 1, 0),
			LayoutOrder = 1,
			Parent = btn,
		})
		if locked then
			local l = tinyLock(Theme.Color.Amber)
			l.LayoutOrder = 2
			l.Parent = btn
		end
	end
end

local function setCategory(c: string)
	category = c
	for _, cat in Buildings.Categories do
		if cat.id == c then
			tab = cat.tabs[1]
		end
	end
	faction = "Standard"
	renderTabs()
	BuildMenu.renderFactions()
	renderCards()
end

---------------------------------------------------------------------------
-- Right panel
---------------------------------------------------------------------------
local function toolButton(parent: Instance, label: string, key: string, icon: string?, order: number, onClick: () -> ()): TextButton
	local btn = Lib.button({
		Name = label,
		Size = UDim2.fromOffset(92, 30),
		BackgroundColor3 = Theme.Color.Card,
		LayoutOrder = order,
		Parent = parent,
		Activated = onClick,
	}, { Lib.corner(6), Lib.stroke(Theme.Color.CardStroke) })
	local x = 8
	if icon then
		local ic = Icons.get(icon, 14, Theme.Color.Text)
		ic.Position = UDim2.fromOffset(7, 8)
		ic.Parent = btn
		x = 26
	end
	Lib.text({
		Text = label,
		TextSize = Theme.TextSize.Small,
		FontFace = Theme.Font.Semi,
		Position = UDim2.fromOffset(x, 0),
		Size = UDim2.new(1, -x - 18, 1, 0),
		Parent = btn,
	})
	if key ~= "" then
		Lib.text({
			Text = key,
			TextSize = Theme.TextSize.Tiny,
			TextColor3 = Theme.Color.Muted,
			AnchorPoint = Vector2.new(1, 0),
			Position = UDim2.new(1, -8, 0, 0),
			Size = UDim2.new(0, 12, 1, 0),
			TextXAlignment = Enum.TextXAlignment.Right,
			Parent = btn,
		})
	end
	return btn
end

local function buildRight(parent: Frame)
	local tools = New("Frame", {
		BackgroundTransparency = 1,
		Position = UDim2.fromOffset(8, 8),
		Size = UDim2.new(1, -16, 0, 68),
		Parent = parent,
	}, { Lib.grid(UDim2.fromOffset(92, 30), 6) })
	refs.toolDelete = toolButton(tools, "Delete", "2", "trash", 1, function()
		Placement.setTool("delete")
	end)
	refs.toolUndo = toolButton(tools, "Undo", "3", "undo", 2, function()
		Placement.undo()
	end)
	refs.toolDrag = toolButton(tools, "Drag", "4", nil, 3, function()
		Placement.toggleDrag()
	end)
	refs.toolMove = toolButton(tools, "Move", "5", nil, 4, function()
		Placement.setTool("move")
	end)
	refs.toolRotate = toolButton(tools, "Rotate", "6", nil, 5, function()
		Placement.rotate()
	end)
	local close = Lib.button({
		Name = "Close",
		Size = UDim2.fromOffset(30, 30),
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.new(1, -8, 0, 8),
		BackgroundColor3 = Theme.Color.Card,
		Parent = parent,
		Activated = function()
			BuildMenu.close()
		end,
	}, { Lib.corner(6), Lib.stroke(Theme.Color.CardStroke) })
	local x = Icons.close(12, Theme.Color.Text)
	x.AnchorPoint = Vector2.new(0.5, 0.5)
	x.Position = UDim2.fromScale(0.5, 0.5)
	x.Parent = close
	tools.Size = UDim2.new(1, -54, 0, 68)

	local detail = Lib.card({
		Position = UDim2.fromOffset(8, 82),
		Size = UDim2.new(1, -16, 0, 76),
		Parent = parent,
	})
	local art = New("Frame", {
		BackgroundColor3 = Theme.Color.CivilSoft,
		Position = UDim2.fromOffset(6, 6),
		Size = UDim2.fromOffset(70, 64),
		Parent = detail,
	}, { Lib.corner(6) })
	refs.detailArt = art
	refs.detailName = Lib.text({ Text = "Nothing selected", FontFace = Theme.Font.Bold, TextSize = Theme.TextSize.Small, Position = UDim2.fromOffset(84, 6), Size = UDim2.new(1, -170, 0, 18), Parent = detail })
	refs.detailPrice = Lib.text({ Text = "", FontFace = Theme.Font.Bold, TextSize = Theme.TextSize.Small, TextColor3 = Theme.Color.Good, AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, -8, 0, 6), Size = UDim2.fromOffset(80, 18), TextXAlignment = Enum.TextXAlignment.Right, Parent = detail })
	refs.detailReq = Lib.text({ Text = "Pick something to build", TextSize = Theme.TextSize.Tiny, TextColor3 = Theme.Color.Time, Position = UDim2.fromOffset(84, 26), Size = UDim2.new(1, -92, 0, 28), TextWrapped = true, TextYAlignment = Enum.TextYAlignment.Top, Parent = detail })
	refs.detailTime = Lib.text({ Text = "", TextSize = Theme.TextSize.Tiny, TextColor3 = Theme.Color.Muted, Position = UDim2.fromOffset(84, 54), Size = UDim2.new(1, -92, 0, 16), Parent = detail })

	local footer = New("Frame", {
		BackgroundColor3 = Theme.Color.CardAlt,
		Position = UDim2.fromOffset(8, 166),
		Size = UDim2.new(1, -16, 0, 26),
		Parent = parent,
	}, { Lib.corner(6) })
	refs.selectedLabel = Lib.text({ Text = "Selected: none", TextSize = Theme.TextSize.Tiny, TextColor3 = Theme.Color.TextSoft, Position = UDim2.fromOffset(10, 0), Size = UDim2.new(1, -20, 1, 0), Parent = footer })
end

local function refreshTools()
	local s = Placement.state()
	local function mark(btn: TextButton, on: boolean)
		Lib.setButtonColor(btn, on and Theme.Color.TabActive or Theme.Color.Card)
	end
	mark(refs.toolDelete, s.tool == "delete")
	mark(refs.toolMove, s.tool == "move")
	mark(refs.toolDrag, s.drag)
	local def = s.def
	Lib.clear(refs.detailArt)
	if def then
		Lib.viewport(thumbModel(def), { Parent = refs.detailArt }, 40)
		refs.detailName.Text = def.name
		refs.detailPrice.Text = "$" .. Format.commas(def.cost)
		refs.detailReq.Text = BuildMenu.describe(def)
		refs.detailTime.Text = def.buildTime > 0 and ("Builds in " .. Format.duration(def.buildTime)) or "Builds instantly"
		refs.selectedLabel.Text = (s.moving and "Moving: " or "Selected: ") .. def.name .. (s.drag and "  (drag to place a line)" or "")
	else
		refs.detailName.Text = s.tool == "delete" and "Demolish" or (s.tool == "move" and "Move" or "Nothing selected")
		refs.detailPrice.Text = ""
		refs.detailReq.Text = s.tool == "delete" and "Click a building to remove it (50% refund, 100% while under construction)"
			or (s.tool == "move" and "Click a building, then click its new spot" or "Pick something to build")
		refs.detailTime.Text = ""
		refs.selectedLabel.Text = s.tool and ("Tool: " .. s.tool) or "Selected: none"
	end
	for _, entry in cards do
		updateCard(entry)
	end
	BuildMenu.refreshTooltip()
end

function BuildMenu.refreshTooltip()
	local s = Placement.state()
	local def = refs.hoverDef or s.def
	if not def or not root.Visible then
		tooltip.Visible = false
		return
	end
	tooltip.Visible = true
	refs.tipName.Text = def.name
	local afford = (ClientState.get("cash") or 0) >= def.cost
	refs.tipPrice.Text = "$" .. Format.commas(def.cost)
	refs.tipPrice.TextColor3 = afford and Theme.Color.Good or Theme.Color.Bad
	local ok, reason = lockReason(def)
	refs.tipHint.Text = ok and (s.drag and "LMB drag   R turn   Q cancel" or "LMB place   R turn   Q cancel") or (reason or "Locked")
	if not ok and def.research then
		local r = Research.get(def.research)
		refs.tipHint.Text = "Research: " .. (r and r.name or def.research)
	elseif not ok and def.pass then
		local p = Products.pass(def.pass)
		refs.tipHint.Text = "Requires " .. (p and p.name or def.pass)
	end
end

---------------------------------------------------------------------------
-- Open / close
---------------------------------------------------------------------------
function BuildMenu.open()
	if ClientState.mode == "war" then
		return
	end
	root.Visible = true
	ClientState.setMode("build")
	Sounds.play("Open", 1.1)
	renderTabs()
	BuildMenu.renderFactions()
	renderCards()
	refreshTools()
end

function BuildMenu.close()
	Placement.cancel()
	root.Visible = false
	tooltip.Visible = false
	if ClientState.mode == "build" then
		ClientState.setMode("play")
	end
end

function BuildMenu.toggle()
	if ClientState.mode == "war" then
		Hub.call("goHome")
	elseif root.Visible then
		BuildMenu.close()
	else
		BuildMenu.open()
	end
end

function BuildMenu.init(gui: GuiObject)
	root = Lib.panel({
		Name = "BuildMenu",
		AnchorPoint = Vector2.new(0.5, 1),
		Position = UDim2.new(0.5, 0, 1, -12),
		Size = UDim2.fromOffset(W, H),
		Visible = false,
		Parent = gui,
	})

	-- category rail
	local rail = New("Frame", {
		BackgroundTransparency = 1,
		Position = UDim2.fromOffset(10, 10),
		Size = UDim2.fromOffset(84, H - 20),
		Parent = root,
	}, { Lib.list("y", 8) })
	for i, c in Buildings.Categories do
		local tile = Lib.button({
			Name = c.id,
			Size = UDim2.fromOffset(84, (H - 28) / 2),
			BackgroundColor3 = Theme.Color.Card,
			LayoutOrder = i,
			Parent = rail,
			Activated = function()
				setCategory(c.id)
			end,
		}, { Lib.corner(8), Lib.stroke(Theme.Color.CardStroke) })
		local color = c.id == "Civilian" and Theme.Color.Civil or Theme.Color.Military
		local box = New("Frame", {
			BackgroundColor3 = color,
			AnchorPoint = Vector2.new(0.5, 0),
			Position = UDim2.new(0.5, 0, 0, 12),
			Size = UDim2.fromOffset(42, 42),
			Parent = tile,
		}, { Lib.corner(8) })
		local ic = Icons.get(c.id == "Civilian" and "house" or "helmet", 28, Color3.new(1, 1, 1))
		ic.AnchorPoint = Vector2.new(0.5, 0.5)
		ic.Position = UDim2.fromScale(0.5, 0.5)
		ic.Parent = box
		Lib.text({
			Text = c.id,
			TextSize = Theme.TextSize.Small,
			TextColor3 = Theme.Color.TextSoft,
			TextXAlignment = Enum.TextXAlignment.Center,
			Position = UDim2.new(0, 0, 1, -28),
			Size = UDim2.new(1, 0, 0, 18),
			Parent = tile,
		})
		refs["cat_" .. c.id] = tile
	end

	-- main area
	local mainW = W - 104 - 330
	local main = Lib.card({
		BackgroundColor3 = Theme.Color.CardAlt,
		Position = UDim2.fromOffset(104, 10),
		Size = UDim2.fromOffset(mainW, H - 20),
		Parent = root,
	})
	refs.tabs = New("Frame", {
		BackgroundTransparency = 1,
		Position = UDim2.fromOffset(10, 8),
		Size = UDim2.new(1, -20, 0, 32),
		Parent = main,
	}, { Lib.list("x", 8) })
	refs.crumb = Lib.caption("", {
		Position = UDim2.fromOffset(12, 46),
		Size = UDim2.new(0.5, 0, 0, 18),
		TextSize = Theme.TextSize.Small,
		Parent = main,
	})
	refs.factions = New("Frame", {
		BackgroundColor3 = Theme.Color.CardAlt,
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.new(1, -10, 0, 42),
		Size = UDim2.fromOffset(276, 30),
		Parent = main,
	}, { Lib.corner(6), Lib.stroke(Theme.Color.CardStroke), Lib.pad(2), Lib.list("x", 4) })
	refs.scroller = New("ScrollingFrame", {
		BackgroundTransparency = 1,
		Position = UDim2.fromOffset(10, 72),
		Size = UDim2.new(1, -20, 0, 124),
		CanvasSize = UDim2.new(),
		AutomaticCanvasSize = Enum.AutomaticSize.X,
		ScrollingDirection = Enum.ScrollingDirection.X,
		ScrollBarThickness = 4,
		ScrollBarImageColor3 = Theme.Color.Faint,
		BorderSizePixel = 0,
		Parent = main,
	}, { Lib.list("x", 8), Lib.pad(2, 2, 6, 2) })

	-- right panel
	local right = Lib.card({
		BackgroundColor3 = Theme.Color.CardAlt,
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.new(1, -10, 0, 10),
		Size = UDim2.fromOffset(316, H - 20),
		Parent = root,
	})
	buildRight(right)

	-- tooltip
	tooltip = Lib.card({
		Name = "Tooltip",
		AnchorPoint = Vector2.new(0.5, 1),
		Position = UDim2.new(0.5, 0, 1, -H - 22),
		Size = UDim2.fromOffset(320, 60),
		Visible = false,
		Parent = gui,
	}, { Lib.pad(8, 14) })
	refs.tipName = Lib.text({ Text = "", FontFace = Theme.Font.Bold, Size = UDim2.new(1, -90, 0, 22), Parent = tooltip })
	refs.tipPrice = Lib.text({ Text = "", FontFace = Theme.Font.Bold, AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, 0, 0, 0), Size = UDim2.fromOffset(90, 22), TextXAlignment = Enum.TextXAlignment.Right, Parent = tooltip })
	refs.tipHint = Lib.text({ Text = "", TextSize = Theme.TextSize.Small, TextColor3 = Theme.Color.Muted, Position = UDim2.fromOffset(0, 24), Size = UDim2.new(1, 0, 0, 18), Parent = tooltip })

	Placement.onChanged(refreshTools)
	ClientState.onAny(function(patch)
		if not root.Visible then
			return
		end
		if patch.researched or patch.passes then
			BuildMenu.renderFactions()
			renderCards()
		elseif patch.cash then
			for _, entry in cards do
				updateCard(entry)
			end
			BuildMenu.refreshTooltip()
		end
	end)

	UserInputService.InputBegan:Connect(function(input, processed)
		if processed then
			return
		end
		if input.KeyCode == Enum.KeyCode.B then
			BuildMenu.toggle()
		elseif input.KeyCode == Enum.KeyCode.X and root.Visible then
			BuildMenu.close()
		end
	end)

	Hub.toggleBuild = BuildMenu.toggle
	Hub.openBuild = BuildMenu.open
	Hub.closeBuild = BuildMenu.close
	Hub.describeBuilding = BuildMenu.describe
	setCategory("Civilian")
end

return BuildMenu
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="50">
            <Properties>
              <string name="Name">BuildingPanel</string>
              <string name="Source"><![CDATA[--[[
	BuildingPanel
	Click any of your buildings to inspect it. Layout follows the classic
	"Medium Refinery" panel: four stat cards, "What it is doing", then a
	building-specific section (fuel destinations, production queue, launcher
	readiness...) and Repair / Move / Delete actions.
]]

local HttpService = game:GetService("HttpService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Shared = ReplicatedStorage.Shared
local Config = require(Shared.Config)
local Buildings = require(Shared.Catalog.Buildings)
local Weapons = require(Shared.Catalog.Weapons)
local Units = require(Shared.Catalog.Units)
local ModelBuilder = require(Shared.ModelBuilder)
local Unlocks = require(Shared.Util.Unlocks)
local Format = require(Shared.Util.Format)
local Net = require(Shared.Net)

local Client = script.Parent.Parent
local ClientState = require(Client.ClientState)
local Hub = require(Client.Hub)
local Lib = require(Client.UI.Lib)
local Theme = require(Client.UI.Theme)
local Modal = require(script.Parent.Modal)
local Notifications = require(script.Parent.Notifications)
local Placement = require(script.Parent.Placement)
local Sounds = require(script.Parent.Sounds)

local New = Lib.New

local BuildingPanel = {}

type StatCard = { value: TextLabel, sub: TextLabel, caption: TextLabel, bar: Lib.Progress }

local function statCard(parent: Instance, order: number): StatCard
	local card = Lib.card({ LayoutOrder = order, Size = UDim2.new(0.25, -6, 0, 88), Parent = parent }, { Lib.pad(10, 12) })
	local caption = Lib.caption("", { Parent = card })
	local value = Lib.text({
		Text = "-",
		FontFace = Theme.Font.Bold,
		TextSize = Theme.TextSize.Big,
		Position = UDim2.fromOffset(0, 16),
		Size = UDim2.new(1, 0, 0, 30),
		Parent = card,
	})
	local sub = Lib.text({
		Text = "",
		TextSize = Theme.TextSize.Tiny,
		TextColor3 = Theme.Color.Muted,
		Position = UDim2.fromOffset(0, 46),
		Size = UDim2.new(1, 0, 0, 14),
		Parent = card,
	})
	local bar = Lib.progress({ Position = UDim2.new(0, 0, 1, -4), Size = UDim2.new(1, 0, 0, 4), Parent = card })
	return { value = value, sub = sub, caption = caption, bar = bar }
end

local function setStat(c: StatCard, caption: string, value: string, sub: string, frac: number?)
	c.caption.Text = string.upper(caption)
	c.value.Text = value
	c.sub.Text = sub
	c.bar.frame.Visible = frac ~= nil
	if frac then
		c.bar.set(frac)
	end
end

local function weaponForFamily(family: string)
	for _, w in Weapons.all() do
		if w.family == family then
			return w
		end
	end
	return nil
end

local function plotFolder(): Folder?
	local idx = ClientState.get("plot")
	local homeland = workspace:FindFirstChild("Homeland")
	local plot = idx and homeland and homeland:FindFirstChild("Plot_" .. idx)
	return plot and plot:FindFirstChild("Buildings") :: Folder? or nil
end

-- Fuel consumers in your nation, numbered per type ("Large Military Factory #2").
local function consumers(): { { uid: number, name: string, model: Model, cap: number } }
	local out = {}
	local folder = plotFolder()
	if not folder then
		return out
	end
	local models = {}
	for _, m in folder:GetChildren() do
		local def = Buildings.get(m:GetAttribute("BuildingId") :: string)
		if def and def.fuelCap then
			table.insert(models, { m = m, def = def })
		end
	end
	table.sort(models, function(a, b)
		return (a.m:GetAttribute("Uid") :: number) < (b.m:GetAttribute("Uid") :: number)
	end)
	local counts = {}
	for _, e in models do
		counts[e.def.id] = (counts[e.def.id] or 0) + 1
		table.insert(out, {
			uid = e.m:GetAttribute("Uid") :: number,
			name = ("%s #%d"):format(e.def.name, counts[e.def.id]),
			model = e.m,
			cap = e.def.fuelCap,
		})
	end
	return out
end

function BuildingPanel.open(model: Model)
	local def = Buildings.get(model:GetAttribute("BuildingId") :: string)
	if not def then
		return
	end
	local uid = model:GetAttribute("Uid") :: number
	local win = Modal.open(def.name, model:GetAttribute("Status") :: string? or "", 720, 620)
	Sounds.play("Open")
	Lib.viewport(ModelBuilder.building(def), { Parent = win.iconHolder }, 40)

	local scroll = New("ScrollingFrame", {
		BackgroundTransparency = 1,
		Size = UDim2.fromScale(1, 1),
		CanvasSize = UDim2.new(),
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
		ScrollBarThickness = 4,
		ScrollBarImageColor3 = Theme.Color.Faint,
		BorderSizePixel = 0,
		Parent = win.body,
	}, { Lib.list("y", 10), Lib.pad(0, 6, 6, 0) })

	-- stat cards
	local statRow = New("Frame", { BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 88), LayoutOrder = 1, Parent = scroll }, { Lib.list("x", 8) })
	local stats = { statCard(statRow, 1), statCard(statRow, 2), statCard(statRow, 3), statCard(statRow, 4) }

	-- what it is doing
	local doing = Lib.card({ LayoutOrder = 2, Size = UDim2.new(1, 0, 0, 70), Parent = scroll }, { Lib.pad(10, 12) })
	Lib.caption("What it is doing", { Parent = doing })
	local doingText = Lib.text({ Text = "", FontFace = Theme.Font.Bold, Position = UDim2.fromOffset(0, 18), Size = UDim2.new(1, 0, 0, 20), Parent = doing })
	local doingDesc = Lib.text({ Text = def.desc, TextSize = Theme.TextSize.Small, TextColor3 = Theme.Color.Muted, Position = UDim2.fromOffset(0, 38), Size = UDim2.new(1, 0, 0, 16), Parent = doing })

	-- special section container
	local special = Lib.card({ LayoutOrder = 3, Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, Parent = scroll }, { Lib.pad(10, 12), Lib.list("y", 6) })
	local specialTitle = Lib.caption("", { LayoutOrder = 0, Parent = special })
	special.Visible = false

	-- actions
	local actions = New("Frame", { BackgroundTransparency = 1, LayoutOrder = 9, Size = UDim2.new(1, 0, 0, 40), Parent = scroll }, { Lib.list("x", 8, Enum.HorizontalAlignment.Right) })
	local repairBtn = Lib.button({
		Text = "Repair",
		FontFace = Theme.Font.Bold,
		TextColor3 = Color3.new(1, 1, 1),
		BackgroundColor3 = Theme.Color.Good,
		Size = UDim2.fromOffset(160, 38),
		LayoutOrder = 1,
		Visible = false,
		Parent = actions,
		Activated = function()
			local res = Net.request("RepairBuilding", uid)
			if res.ok then
				Sounds.play("Success")
			elseif res.err then
				Notifications.show(res.err, "bad")
			end
		end,
	}, { Lib.corner(6) })
	Lib.button({
		Text = "Move",
		FontFace = Theme.Font.Bold,
		Size = UDim2.fromOffset(110, 38),
		LayoutOrder = 2,
		Parent = actions,
		Activated = function()
			Modal.close()
			Hub.call("openBuild")
			Placement.beginMove(model)
		end,
	}, { Lib.corner(6), Lib.stroke() })
	local confirmDelete = false
	local deleteBtn: TextButton
	deleteBtn = Lib.button({
		Text = "Delete",
		FontFace = Theme.Font.Bold,
		TextColor3 = Theme.Color.Bad,
		Size = UDim2.fromOffset(150, 38),
		LayoutOrder = 3,
		Parent = actions,
		Activated = function()
			if not confirmDelete then
				confirmDelete = true
				deleteBtn.Text = "Click again to confirm"
				task.delay(3, function()
					confirmDelete = false
					if deleteBtn.Parent then
						deleteBtn.Text = "Delete"
					end
				end)
				return
			end
			local res = Net.request("DeleteBuilding", uid)
			if res.ok then
				Modal.close()
				Notifications.show(("%s demolished (+%s)"):format(def.name, Format.cash(res.refund or 0)), "info")
			elseif res.err then
				Notifications.show(res.err, "bad")
			end
		end,
	}, { Lib.corner(6), Lib.stroke(Theme.Color.Bad, 1, 0.5) })

	-------------------------------------------------------------------
	-- building specific sections
	-------------------------------------------------------------------
	local rebuildSpecial: (() -> ())? = nil
	local updateSpecial: (() -> ())? = nil

	if def.refine then
		special.Visible = true
		local rows: { [number]: { bar: Lib.Progress, amount: TextLabel, radio: Frame } } = {}
		local signature = ""
		local listHolder = New("Frame", { BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, LayoutOrder = 1, Parent = special }, { Lib.list("y", 6) })
		local function row(destUid: number, name: string, right: string, order: number)
			local btn = Lib.button({
				Size = UDim2.new(1, 0, 0, destUid == 0 and 38 or 48),
				BackgroundColor3 = Theme.Color.Card,
				LayoutOrder = order,
				Parent = listHolder,
				Activated = function()
					local res = Net.request("SetFuelDestination", uid, destUid)
					if not res.ok and res.err then
						Notifications.show(res.err, "bad")
					end
				end,
			}, { Lib.corner(6), Lib.stroke() })
			local radio = New("Frame", {
				BackgroundColor3 = Color3.new(1, 1, 1),
				Position = UDim2.fromOffset(12, destUid == 0 and 9 or 14),
				Size = UDim2.fromOffset(20, 20),
				Parent = btn,
			}, { Lib.round(), Lib.stroke(Theme.Color.Faint, 2) })
			New("Frame", { Name = "Dot", BackgroundColor3 = Theme.Color.Accent, AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5), Size = UDim2.fromOffset(12, 12), Visible = false, Parent = radio }, { Lib.round() })
			Lib.text({ Text = name, FontFace = Theme.Font.Bold, TextSize = Theme.TextSize.Small, TextColor3 = destUid == 0 and Theme.Color.Accent or Theme.Color.Text, Position = UDim2.fromOffset(44, destUid == 0 and 0 or 4), Size = UDim2.new(0.6, 0, 0, destUid == 0 and 38 or 22), Parent = btn })
			local amount = Lib.text({ Text = right, TextSize = Theme.TextSize.Tiny, TextColor3 = Theme.Color.TextSoft, AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, -12, 0, destUid == 0 and 0 or 4), Size = UDim2.new(0.35, 0, 0, destUid == 0 and 38 or 22), TextXAlignment = Enum.TextXAlignment.Right, Parent = btn })
			local bar = Lib.progress({ Position = UDim2.new(0, 44, 0, 30), Size = UDim2.new(1, -56, 0, 5), Parent = btn, Visible = destUid ~= 0 })
			rows[destUid] = { bar = bar, amount = amount, radio = radio }
		end
		local function rebuildList()
			local list = consumers()
			local sig = ""
			for _, c in list do
				sig ..= c.uid .. ","
			end
			if sig == signature then
				return
			end
			signature = sig
			Lib.clear(listHolder)
			table.clear(rows)
			specialTitle.Text = ("FUEL GOES TO (%d BUILDINGS)"):format(#list)
			row(0, "Auto", "Most free space", 0)
			for i, c in list do
				row(c.uid, c.name, "", i)
			end
			if #list == 0 then
				Lib.text({ Text = "No fuel users yet - build a Military Factory.", TextSize = Theme.TextSize.Small, TextColor3 = Theme.Color.Muted, LayoutOrder = 99, Parent = listHolder })
			end
		end
		rebuildSpecial = rebuildList
		updateSpecial = function()
			rebuildList()
			local dest = (model:GetAttribute("Dest") :: number?) or 0
			for _, c in consumers() do
				local r = rows[c.uid]
				if r then
					local fuel = (c.model:GetAttribute("Fuel") :: number?) or 0
					r.amount.Text = ("%s / %s"):format(Format.commas(fuel), Format.commas(c.cap))
					r.bar.set(fuel / c.cap)
				end
			end
			for id, r in rows do
				(r.radio:FindFirstChild("Dot") :: Frame).Visible = id == dest
			end
		end
	elseif def.factory then
		special.Visible = true
		local queueHolder = New("Frame", { BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, LayoutOrder = 1, Parent = special }, { Lib.list("y", 4) })
		Lib.caption("Build", { LayoutOrder = 2, Parent = special })
		local options = New("Frame", { BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, LayoutOrder = 3, Parent = special }, { Lib.grid(UDim2.new(0.25, -6, 0, 74), 6) })
		local lastQueue = ""
		local function renderOptions()
			Lib.clear(options)
			local acc = { researched = ClientState.get("researched") or {}, passes = ClientState.get("passes") or {} }
			local items = {}
			for _, w in Weapons.all() do
				table.insert(items, { kind = "weapon", def = w })
			end
			for _, u in Units.all() do
				table.insert(items, { kind = "unit", def = u })
			end
			for i, item in items do
				local d = item.def
				local ok = Unlocks.check(d, acc)
				local btn = Lib.button({
					LayoutOrder = (ok and 0 or 100) + i,
					BackgroundColor3 = ok and Theme.Color.Card or Theme.Color.CardAlt,
					Parent = options,
					Activated = function()
						if not ok then
							Notifications.show(d.name .. " is locked - check Research" .. (d.pass and " or the Store" or ""), "info")
							return
						end
						local res = Net.request("QueueProduction", uid, item.kind, d.id)
						if res.ok then
							Sounds.play("Click", 1.1)
						elseif res.err then
							Notifications.show(res.err, "bad")
						end
					end,
				}, { Lib.corner(6), Lib.stroke(), Lib.pad(6, 8) })
				Lib.text({ Text = (item.kind == "weapon" and (d :: any).short or d.name), FontFace = Theme.Font.Bold, TextSize = Theme.TextSize.Small, TextColor3 = ok and Theme.Color.Text or Theme.Color.Faint, Size = UDim2.new(1, 0, 0, 18), Parent = btn })
				Lib.text({ Text = ok and ("%d fuel · %d steel · %s"):format(d.fuel, d.steel, Format.duration(d.time)) or "Locked", TextSize = Theme.TextSize.Tiny, TextColor3 = ok and Theme.Color.Muted or Theme.Color.Bad, Position = UDim2.fromOffset(0, 18), Size = UDim2.new(1, 0, 0, 14), Parent = btn })
				local chip = Lib.chip("$" .. Format.commas(d.cost), Theme.Color.GoodSoft, Theme.Color.Good, { Position = UDim2.fromOffset(0, 38), Size = UDim2.fromOffset(0, 20) })
				chip.Parent = btn
			end
		end
		renderOptions()
		rebuildSpecial = renderOptions
		updateSpecial = function()
			local q = (model:GetAttribute("Queue") :: string?) or "[]"
			if q == lastQueue then
				return
			end
			lastQueue = q
			local ok, items = pcall(HttpService.JSONDecode, HttpService, q)
			if not ok then
				items = {}
			end
			Lib.clear(queueHolder)
			specialTitle.Text = ("PRODUCTION QUEUE (%d / %d)"):format(#items, ClientState.get("queueLimit") or Config.MaxQueuePerFactory)
			if #items == 0 then
				Lib.text({ Text = "Queue is empty - pick something below.", TextSize = Theme.TextSize.Small, TextColor3 = Theme.Color.Muted, Parent = queueHolder })
			end
			for i, it in items do
				local cat = it.k == "unit" and Units.get(it.id) or Weapons.get(it.id)
				local rowF = Lib.card({ Size = UDim2.new(1, 0, 0, 34), LayoutOrder = i, Parent = queueHolder })
				Lib.text({ Text = cat and cat.name or it.id, FontFace = Theme.Font.Semi, TextSize = Theme.TextSize.Small, Position = UDim2.fromOffset(10, 0), Size = UDim2.new(0.4, 0, 0, 22), Parent = rowF })
				local bar = Lib.progress({ Position = UDim2.new(0, 10, 0, 24), Size = UDim2.new(0.85, -20, 0, 4), Parent = rowF })
				bar.set(it.p or 0, Theme.Color.Accent)
				Lib.button({
					Text = "Cancel",
					TextSize = Theme.TextSize.Tiny,
					TextColor3 = Theme.Color.Bad,
					AnchorPoint = Vector2.new(1, 0.5),
					Position = UDim2.new(1, -6, 0.5, 0),
					Size = UDim2.fromOffset(60, 24),
					Parent = rowF,
					Activated = function()
						Net.request("CancelProduction", uid, i)
					end,
				}, { Lib.corner(5), Lib.stroke() })
			end
		end
	elseif def.launcher then
		special.Visible = true
		specialTitle.Text = "STRIKE"
		Lib.text({ Text = "Open the war map with Travel, pick this weapon in the hotbar and click a target.", TextSize = Theme.TextSize.Small, TextColor3 = Theme.Color.TextSoft, TextWrapped = true, Size = UDim2.new(1, 0, 0, 34), LayoutOrder = 1, Parent = special })
		Lib.button({
			Text = "Open War Map",
			FontFace = Theme.Font.Bold,
			TextColor3 = Color3.new(1, 1, 1),
			BackgroundColor3 = Theme.Color.Military,
			Size = UDim2.fromOffset(180, 36),
			LayoutOrder = 2,
			Parent = special,
			Activated = function()
				Modal.close()
				Hub.call("goWar", "mainland")
			end,
		}, { Lib.corner(6) })
	elseif def.billboard then
		special.Visible = true
		specialTitle.Text = "BILLBOARD MESSAGE"
		local box = New("TextBox", {
			Text = ClientState.get("billboard") or "",
			PlaceholderText = "Type your message (40 characters)",
			FontFace = Theme.Font.Semi,
			TextSize = Theme.TextSize.Body,
			TextColor3 = Theme.Color.Text,
			BackgroundColor3 = Color3.new(1, 1, 1),
			ClearTextOnFocus = false,
			Size = UDim2.new(1, 0, 0, 36),
			LayoutOrder = 1,
			Parent = special,
		}, { Lib.corner(6), Lib.stroke(), Lib.pad(0, 10) })
		Lib.button({
			Text = "Save Message",
			FontFace = Theme.Font.Bold,
			TextColor3 = Color3.new(1, 1, 1),
			BackgroundColor3 = Theme.Color.Accent,
			Size = UDim2.fromOffset(160, 34),
			LayoutOrder = 2,
			Parent = special,
			Activated = function()
				local res = Net.request("SetBillboard", box.Text)
				if res.ok then
					Notifications.show("Billboards updated", "good")
				elseif res.err then
					Notifications.show(res.err, "bad")
				end
			end,
		}, { Lib.corner(6) })
	end

	-------------------------------------------------------------------
	-- live refresh
	-------------------------------------------------------------------
	local function refresh()
		if not model.Parent then
			Modal.close()
			return
		end
		local status = (model:GetAttribute("Status") :: string?) or ""
		local finishAt = model:GetAttribute("FinishAt") :: number?
		local now = Lib.serverNow()
		if finishAt then
			local start = (model:GetAttribute("BuildStart") :: number?) or now
			local frac = (now - start) / math.max(0.1, finishAt - start)
			status = ("Under Construction - %s left"):format(Format.duration(finishAt - now))
			setStat(stats[1], "Construction", Format.percent(frac * 100), "Being built", frac)
			setStat(stats[2], "Cost", Format.cash(def.cost), "Full refund if cancelled", nil)
			setStat(stats[3], "Health", ("%d"):format(def.hp), "Max health", nil)
			setStat(stats[4], "Size", ("%dx%d"):format(def.size[1], def.size[2]), "Grid cells", nil)
		else
			local eff = ((model:GetAttribute("Eff") :: number?) or 0) / 100
			local hp = (model:GetAttribute("Hp") :: number?) or def.hp
			local d = ClientState.data
			if def.refine then
				local oil = (model:GetAttribute("Oil") :: number?) or 0
				local fuel = (model:GetAttribute("Fuel") :: number?) or 0
				setStat(stats[1], "Oil Stored", ("%s / %s"):format(Format.commas(oil), Format.commas(def.refine.oilCap)), "Waiting To Refine", oil / def.refine.oilCap)
				setStat(stats[2], "Fuel Stored", ("%s / %s"):format(Format.commas(fuel), Format.commas(def.refine.fuelCap)), "Waiting For Trucks", fuel / def.refine.fuelCap)
				setStat(stats[3], "Fuel Output", ("%s / Min"):format(Format.short(def.refine.rate * eff)), "Refined From Oil", nil)
				setStat(stats[4], "Oil Arriving", ("+%s / Min"):format(Format.short((model:GetAttribute("OilArriving") :: number?) or 0)), "From Your Oil Pumps", nil)
			elseif def.factory then
				local fuel = (model:GetAttribute("Fuel") :: number?) or 0
				setStat(stats[1], "Fuel Stored", ("%s / %s"):format(Format.commas(fuel), Format.commas(def.fuelCap or 0)), "Delivered By Trucks", fuel / (def.fuelCap or 1))
				setStat(stats[2], "Steel", Format.short(d.steel or 0), ("+%s / Min nationally"):format(Format.short(d.steelRate or 0)), nil)
				setStat(stats[3], "Build Speed", ("x%s"):format(tostring(def.factory.speed * ((d.passes or {}).FastBuild and 2 or 1))), "Fast Construction doubles it", nil)
				setStat(stats[4], "Efficiency", Format.percent(eff * 100), "Workers, power, road", eff)
			elseif def.launcher then
				local w = weaponForFamily(def.launcher)
				local stock = w and ((d.inventory or {})[w.id] or 0) or 0
				local l = (d.launchers or {})[def.launcher]
				local reloadUntil = (model:GetAttribute("ReloadUntil") :: number?) or 0
				setStat(stats[1], "Stockpile", ("%d / %d"):format(stock, w and w.stockCap or 60), (w and w.short or def.launcher) .. " missiles", w and stock / w.stockCap or 0)
				setStat(stats[2], "Launchers Ready", l and ("%d / %d"):format(l.ready, l.total) or "0", "Of this type", nil)
				setStat(stats[3], "Reload", reloadUntil > now and Format.duration(reloadUntil - now) or "Ready", ("%ds per launch"):format(def.reload or 20), nil)
				setStat(stats[4], "Hits Landed", Format.commas(((d.stats or {}).Hits) or 0), "Unlocks better missiles", nil)
			elseif def.airDefense then
				local ad = def.airDefense
				setStat(stats[1], "Range", ("%d"):format(ad.range), "Studs (+25% with radar)", nil)
				setStat(stats[2], "Hit Chance", Format.percent(ad.chance * 100), "Per engagement", ad.chance)
				setStat(stats[3], "Reload", Format.duration(ad.reload), "Between shots", nil)
				setStat(stats[4], "Health", ("%d / %d"):format(hp, def.hp), "Armor", hp / def.hp)
			elseif def.housing then
				setStat(stats[1], "Residents", ("up to %s"):format(Format.commas(def.housing * eff)), ("Max %s"):format(Format.commas(def.housing)), eff)
				setStat(stats[2], "Population", Format.short(d.pop or 0), ("Capacity %s"):format(Format.short(d.popCap or 0)), (d.popCap or 0) > 0 and (d.pop or 0) / d.popCap or 0)
				setStat(stats[3], "Power Use", ("%d MW"):format(def.power or 0), "Needs electricity", nil)
				setStat(stats[4], "Water Use", ("%d"):format(def.water or 0), "Needs water", nil)
			else
				local outText, outSub = "-", ""
				if def.powerOut then
					outText, outSub = ("%s MW"):format(Format.short(def.powerOut * eff)), "Power produced"
				elseif def.waterOut then
					outText, outSub = Format.short(def.waterOut * eff), "Water supplied"
				elseif def.oilOut then
					outText, outSub = ("%s / Min"):format(Format.short(def.oilOut * eff)), "Oil pumped"
				elseif def.steelOut then
					outText, outSub = ("%s / Min"):format(Format.short(def.steelOut * eff)), "Steel produced"
				elseif def.rpOut then
					outText, outSub = ("%s / Min"):format(Format.short(def.rpOut * eff)), "Research points"
				elseif def.income then
					outText, outSub = Format.cash(def.income * eff), "Earned per pay"
				elseif def.service then
					outText, outSub = Format.short(def.service.serves * eff), def.service.kind .. " coverage"
				elseif def.storage then
					outText, outSub = "+" .. Format.short((def.storage.oil or 0) + (def.storage.steel or 0)), "Extra storage"
				elseif def.depot then
					outText, outSub = "+" .. def.depot, "Army capacity"
				end
				setStat(stats[1], "Output", outText, outSub, nil)
				setStat(stats[2], "Efficiency", Format.percent(eff * 100), "Workers, power, water, road", eff)
				setStat(stats[3], "Workers", ("%d"):format(def.workers or 0), "Needed to run", nil)
				setStat(stats[4], "Health", ("%d / %d"):format(hp, def.hp), model:GetAttribute("Damaged") and "Knocked out!" or "Structure", hp / def.hp)
			end
		end
		win.subtitle.Text = status
		doingText.Text = status
		doingText.TextColor3 = (model:GetAttribute("Damaged") or status:find("Not Enough") or status:find("No Road")) and Theme.Color.Bad or Theme.Color.Text
		if model:GetAttribute("Connected") == false and def.needsRoad then
			doingDesc.Text = "Place a road next to this building to run at full speed."
		else
			doingDesc.Text = Hub.describeBuilding and Hub.describeBuilding(def) or def.desc
		end
		local damaged = model:GetAttribute("Damaged") == true
		repairBtn.Visible = damaged
		repairBtn.Text = ("Repair (%s)"):format(Format.cash(math.floor(def.cost * Config.RepairCostRate)))
		if updateSpecial then
			updateSpecial()
		end
	end

	refresh()
	local acc = 0
	local conn = RunService.Heartbeat:Connect(function(dt)
		acc += dt
		if acc >= 0.4 then
			acc = 0
			refresh()
		end
	end)
	local unsubscribe = ClientState.onAny(function(patch)
		if (patch.researched or patch.passes) and rebuildSpecial and def.factory then
			rebuildSpecial()
		end
	end)
	win.onClose(function()
		unsubscribe()
		conn:Disconnect()
	end)
end

function BuildingPanel.init()
	Hub.openBuilding = BuildingPanel.open
end

return BuildingPanel
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="51">
            <Properties>
              <string name="Name">Effects</string>
              <string name="Source"><![CDATA[--[[
	Effects
	Client-side visuals for combat:
	  * missiles / drones flying their synced Ballistics path with trails
	  * interceptor missiles that meet incoming strikes mid-air
	  * explosions (flash, smoke, debris-free Explosion), cluster scatter
	  * tracer shots between vehicles, move markers, build-complete sparkle
]]

local Debris = game:GetService("Debris")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Shared = ReplicatedStorage.Shared
local Ballistics = require(Shared.Util.Ballistics)
local ModelBuilder = require(Shared.ModelBuilder)
local Weapons = require(Shared.Catalog.Weapons)
local Net = require(Shared.Net)

local Client = script.Parent.Parent
local Hub = require(Client.Hub)
local Lib = require(Client.UI.Lib)
local Sounds = require(script.Parent.Sounds)

local Effects = {}

local camera = workspace.CurrentCamera
local fx: Folder

type Flight = {
	model: Model,
	from: Vector3,
	to: Vector3,
	apex: number,
	kind: string,
	t0: number,
	flight: number,
	endAlpha: number?,
	done: boolean,
	onEnd: (() -> ())?,
}

local flights: { [any]: Flight } = {}
local shake = 0

local function addTrail(model: Model, color: Color3, width: number, smoke: boolean)
	local root = model.PrimaryPart :: BasePart
	local a0 = Instance.new("Attachment")
	a0.Position = Vector3.new(0, width / 2, 2)
	a0.Parent = root
	local a1 = Instance.new("Attachment")
	a1.Position = Vector3.new(0, -width / 2, 2)
	a1.Parent = root
	local trail = Instance.new("Trail")
	trail.Attachment0 = a0
	trail.Attachment1 = a1
	trail.Lifetime = 1.4
	trail.Color = ColorSequence.new(color, Color3.fromRGB(200, 200, 200))
	trail.Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.1), NumberSequenceKeypoint.new(1, 1) })
	trail.WidthScale = NumberSequence.new({ NumberSequenceKeypoint.new(0, 1), NumberSequenceKeypoint.new(1, 2.5) })
	trail.LightEmission = 0.4
	trail.FaceCamera = true
	trail.Parent = root
	if smoke then
		local tail = root:FindFirstChild("Tail") :: Attachment?
		local p = Instance.new("ParticleEmitter")
		p.Texture = "rbxasset://textures/particles/smoke_main.dds"
		p.Color = ColorSequence.new(Color3.fromRGB(220, 220, 215))
		p.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 1.2), NumberSequenceKeypoint.new(1, 5) })
		p.Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.3), NumberSequenceKeypoint.new(1, 1) })
		p.Lifetime = NumberRange.new(1.2, 2)
		p.Rate = 40
		p.Speed = NumberRange.new(0.5, 1.5)
		p.Parent = tail or root
		local glow = Instance.new("PointLight")
		glow.Color = Color3.fromRGB(255, 180, 90)
		glow.Brightness = 3
		glow.Range = 14
		glow.Parent = root
	end
end

function Effects.explosion(pos: Vector3, scale: number, airburst: boolean?)
	local s = math.max(0.4, scale)
	-- flash
	local flash = Instance.new("Part")
	flash.Shape = Enum.PartType.Ball
	flash.Anchored = true
	flash.CanCollide = false
	flash.CanQuery = false
	flash.CanTouch = false
	flash.CastShadow = false
	flash.Material = Enum.Material.Neon
	flash.Color = airburst and Color3.fromRGB(255, 230, 170) or Color3.fromRGB(255, 160, 60)
	flash.Size = Vector3.one * 4 * s
	flash.Position = pos
	flash.Parent = fx
	Lib.tween(flash, 0.45, { Size = Vector3.one * 26 * s, Transparency = 1 })
	Debris:AddItem(flash, 0.5)
	-- smoke column
	local holder = Instance.new("Part")
	holder.Anchored = true
	holder.CanCollide = false
	holder.CanQuery = false
	holder.Transparency = 1
	holder.Size = Vector3.one
	holder.Position = pos
	holder.Parent = fx
	local smoke = Instance.new("ParticleEmitter")
	smoke.Texture = "rbxasset://textures/particles/smoke_main.dds"
	smoke.Color = ColorSequence.new(airburst and Color3.fromRGB(150, 150, 150) or Color3.fromRGB(70, 66, 60))
	smoke.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 6 * s), NumberSequenceKeypoint.new(1, 18 * s) })
	smoke.Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.2), NumberSequenceKeypoint.new(1, 1) })
	smoke.Lifetime = NumberRange.new(2.5, 4)
	smoke.Speed = NumberRange.new(6 * s, 14 * s)
	smoke.SpreadAngle = Vector2.new(60, 60)
	smoke.Rate = 0
	smoke.Parent = holder
	smoke:Emit(math.floor(14 * s))
	local fire = Instance.new("ParticleEmitter")
	fire.Texture = "rbxasset://textures/particles/fire_main.dds"
	fire.Color = ColorSequence.new(Color3.fromRGB(255, 190, 90), Color3.fromRGB(255, 90, 30))
	fire.LightEmission = 1
	fire.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 5 * s), NumberSequenceKeypoint.new(1, 1) })
	fire.Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0), NumberSequenceKeypoint.new(1, 1) })
	fire.Lifetime = NumberRange.new(0.4, 0.8)
	fire.Speed = NumberRange.new(10 * s, 24 * s)
	fire.SpreadAngle = Vector2.new(180, 180)
	fire.Rate = 0
	fire.Parent = holder
	fire:Emit(math.floor(24 * s))
	Debris:AddItem(holder, 5)
	-- sound + shockwave (no physics damage, purely visual)
	local e = Instance.new("Explosion")
	e.Position = pos
	e.BlastPressure = 0
	e.BlastRadius = 0
	e.DestroyJointRadiusPercent = 0
	e.ExplosionType = Enum.ExplosionType.NoCraters
	e.Visible = false
	e.Parent = fx
	local dist = (camera.CFrame.Position - pos).Magnitude
	shake = math.max(shake, math.clamp(1 - dist / (700 * s), 0, 1) * 1.2 * s)
end

local function spawnFlight(id: any, weaponId: string?, from: Vector3, to: Vector3, apex: number, kind: string, t0: number, flight: number, endAlpha: number?, interceptor: boolean?)
	local def = weaponId and Weapons.get(weaponId)
	local model
	if interceptor or not def then
		model = ModelBuilder.projectile({ kind = "missile", color = Color3.fromRGB(240, 240, 236), id = "GLCM" })
		model:ScaleTo(0.6)
	else
		model = ModelBuilder.projectile(def)
	end
	model.Parent = fx
	addTrail(model, interceptor and Color3.fromRGB(255, 255, 255) or Color3.fromRGB(255, 200, 120), interceptor and 0.6 or 1, kind ~= "drone")
	flights[id] = { model = model, from = from, to = to, apex = apex, kind = kind, t0 = t0, flight = flight, endAlpha = endAlpha, done = false }
	return flights[id]
end

local function onProjectile(data)
	local weapon = Weapons.get(data.w)
	spawnFlight(data.id, data.w, data.from, data.to, data.apex, data.kind, data.t0, data.flight, data.ic)
	Sounds.at("Launch", data.from, 0.6)
	if data.ic and data.icFrom then
		-- interceptor timed to meet the strike at the intercept point
		local meetTime = data.t0 + data.flight * data.ic
		local meetPos = Ballistics.position(data.from, data.to, data.apex, data.kind, data.ic)
		local dur = math.clamp(data.flight * data.ic * 0.6, 1.2, 3)
		local start = meetTime - dur
		task.delay(math.max(0, start - Lib.serverNow()), function()
			spawnFlight(tostring(data.id) .. "i", nil, data.icFrom, meetPos, 30, "missile", start, dur, 1, true)
			Sounds.at("Launch", data.icFrom, 0.5)
		end)
	end
	local _ = weapon
end

local function endFlight(id: any)
	local f = flights[id]
	if f then
		flights[id] = nil
		local root = f.model.PrimaryPart
		if root then
			-- let trails fade out
			for _, d in f.model:GetDescendants() do
				if d:IsA("BasePart") then
					d.Transparency = 1
				elseif d:IsA("ParticleEmitter") then
					d.Enabled = false
				end
			end
		end
		Debris:AddItem(f.model, 2)
	end
end

local function onProjectileEnd(data)
	local f = flights[data.id]
	local pos: Vector3
	if data.intercepted then
		if f then
			pos = Ballistics.position(f.from, f.to, f.apex, f.kind, f.endAlpha or 0.7)
		else
			return
		end
		endFlight(data.id)
		endFlight(tostring(data.id) .. "i")
		Effects.explosion(pos, 0.7, true)
		return
	end
	endFlight(data.id)
	pos = data.pos or (f and f.to) or Vector3.zero
	local w = Weapons.get(data.w or "")
	local scale = w and math.clamp(w.radius / 24, 0.6, 2) or 1
	if data.w == "CLUSTER" and w then
		for i = 1, 8 do
			task.delay(i * 0.08, function()
				local a = math.random() * math.pi * 2
				local r = math.random() * w.radius
				Effects.explosion(pos + Vector3.new(math.cos(a) * r, 0, math.sin(a) * r), 0.6)
			end)
		end
	else
		Effects.explosion(pos, scale)
	end
end

local function step()
	local now = Lib.serverNow()
	for id, f in flights do
		local alpha = (now - f.t0) / f.flight
		if alpha < 0 then
			f.model.Parent = nil
		else
			f.model.Parent = fx
			local limit = f.endAlpha or 1
			local a = math.min(alpha, limit)
			f.model:PivotTo(Ballistics.cframe(f.from, f.to, f.apex, f.kind, a))
			if alpha > limit + 2 then
				endFlight(id) -- safety: server never answered
			end
		end
	end
	if shake > 0.01 then
		local o = Vector3.new(math.random() - 0.5, math.random() - 0.5, math.random() - 0.5) * shake
		camera.CFrame *= CFrame.new(o)
		shake *= 0.88
	end
end

local function tracer(from: Vector3, to: Vector3, artillery: boolean)
	if artillery then
		local id = {}
		local flight = math.clamp((to - from).Magnitude / 220, 0.8, 2.2)
		local now = Lib.serverNow()
		spawnFlight(id, nil, from, to, 40, "missile", now, flight, 1, true)
		task.delay(flight, function()
			endFlight(id)
			Effects.explosion(to, 0.35)
		end)
		return
	end
	local p = Instance.new("Part")
	p.Anchored = true
	p.CanCollide = false
	p.CanQuery = false
	p.CanTouch = false
	p.CastShadow = false
	p.Material = Enum.Material.Neon
	p.Color = Color3.fromRGB(255, 220, 140)
	local len = (to - from).Magnitude
	p.Size = Vector3.new(0.25, 0.25, len)
	p.CFrame = CFrame.lookAt((from + to) / 2, to)
	p.Parent = fx
	Lib.tween(p, 0.18, { Transparency = 1 })
	Debris:AddItem(p, 0.2)
end

local function moveMarker(pos: Vector3)
	local ring = Instance.new("Part")
	ring.Shape = Enum.PartType.Cylinder
	ring.Anchored = true
	ring.CanCollide = false
	ring.CanQuery = false
	ring.CastShadow = false
	ring.Material = Enum.Material.Neon
	ring.Color = Color3.fromRGB(90, 230, 130)
	ring.Size = Vector3.new(0.2, 4, 4)
	ring.CFrame = CFrame.new(pos.X, 0.3, pos.Z) * CFrame.Angles(0, 0, math.rad(90))
	ring.Transparency = 0.3
	ring.Parent = fx
	Lib.tween(ring, 0.6, { Size = Vector3.new(0.2, 26, 26), Transparency = 1 })
	Debris:AddItem(ring, 0.7)
end

local function buildDone(pos: Vector3)
	local holder = Instance.new("Part")
	holder.Anchored = true
	holder.CanCollide = false
	holder.CanQuery = false
	holder.Transparency = 1
	holder.Size = Vector3.one
	holder.Position = pos + Vector3.new(0, 4, 0)
	holder.Parent = fx
	local sparkle = Instance.new("ParticleEmitter")
	sparkle.Texture = "rbxasset://textures/particles/sparkles_main.dds"
	sparkle.Color = ColorSequence.new(Color3.fromRGB(255, 230, 120))
	sparkle.LightEmission = 1
	sparkle.Size = NumberSequence.new(1.2, 0)
	sparkle.Lifetime = NumberRange.new(0.6, 1.2)
	sparkle.Speed = NumberRange.new(8, 16)
	sparkle.SpreadAngle = Vector2.new(180, 180)
	sparkle.Rate = 0
	sparkle.Parent = holder
	sparkle:Emit(30)
	Debris:AddItem(holder, 2)
	Sounds.play("Place", 1.3)
end

function Effects.init()
	fx = Instance.new("Folder")
	fx.Name = "FX"
	fx.Parent = workspace
	Net.event("Projectile").OnClientEvent:Connect(onProjectile)
	Net.event("ProjectileEnd").OnClientEvent:Connect(onProjectileEnd)
	Net.event("Effect").OnClientEvent:Connect(function(kind, a, b, c)
		if kind == "Explosion" then
			Effects.explosion(a, b or 1)
		elseif kind == "Shot" then
			tracer(a, b, c == true)
		elseif kind == "BuildDone" then
			buildDone(a)
		elseif kind == "Welcome" then
			Hub.call("showWelcome", b, c)
		elseif kind == "ResearchDone" then
			Sounds.play("Success")
		end
	end)
	Hub.moveMarker = moveMarker
	-- after the camera scripts so screen shake isn't overwritten
	RunService:BindToRenderStep("FFEffects", Enum.RenderPriority.Camera.Value + 1, step)
end

return Effects
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="52">
            <Properties>
              <string name="Name">HUD</string>
              <string name="Source"><![CDATA[--[[
	HUD
	Always-on interface:
	  * top bar: PvP toggle, cash + next pay countdown, population + free
	    workers, happiness, Travel
	  * resource strip: power, water, oil, steel, research points, army
	  * objective tracker with claim button (left)
	  * side menu: Store, Research, Army, Daily, Gift, Codes (left)
	  * hammer button to open the build menu (bottom center)
]]

local RunService = game:GetService("RunService")

local Client = script.Parent.Parent
local ClientState = require(Client.ClientState)
local Hub = require(Client.Hub)
local Lib = require(Client.UI.Lib)
local Theme = require(Client.UI.Theme)
local Icons = require(Client.UI.Icons)
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Format = require(ReplicatedStorage.Shared.Util.Format)
local Net = require(ReplicatedStorage.Shared.Net)
local Notifications = require(script.Parent.Notifications)
local Sounds = require(script.Parent.Sounds)

local New = Lib.New

local HUD = {}

local refs: { [string]: any } = {}

local function pill(width: number, tint: Color3, order: number): Frame
	return New("Frame", {
		BackgroundColor3 = Color3.new(1, 1, 1),
		BackgroundTransparency = 0.12,
		Size = UDim2.fromOffset(width, 46),
		LayoutOrder = order,
	}, {
		Lib.corner(Theme.Radius.Pill),
		Lib.stroke(Color3.new(1, 1, 1), 1, 0.86),
		New("UIGradient", {
			Color = ColorSequence.new(tint, Theme.Color.Hud),
			Rotation = 0,
		}),
	})
end

local function hudText(props: { [string]: any }): TextLabel
	local p = {
		TextColor3 = Theme.Color.HudText,
		FontFace = Theme.Font.Bold,
		TextSize = Theme.TextSize.Body,
	}
	for k, v in props do
		p[k] = v
	end
	return Lib.text(p)
end

local function buildTopBar(gui: GuiObject)
	local bar = New("Frame", {
		Name = "TopBar",
		BackgroundTransparency = 1,
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0, 14),
		Size = UDim2.fromOffset(800, 46),
		Parent = gui,
	}, { Lib.list("x", 10, Enum.HorizontalAlignment.Center) })

	-- PvP toggle
	local pvp = Lib.button({
		Name = "Pvp",
		Size = UDim2.fromOffset(104, 46),
		BackgroundColor3 = Theme.Color.Hud,
		BackgroundTransparency = 0.25,
		LayoutOrder = 1,
		Parent = bar,
		Activated = function()
			local on = ClientState.get("pvp") == true
			local res = Net.request("SetPvp", not on)
			if not res.ok and res.err then
				Notifications.show(res.err, "bad")
			end
		end,
	}, { Lib.corner(Theme.Radius.Pill), Lib.stroke(Color3.new(1, 1, 1), 1, 0.86) })
	refs.pvpLabel = hudText({ Text = "PVP OFF", Size = UDim2.fromScale(1, 1), TextXAlignment = Enum.TextXAlignment.Center, TextSize = Theme.TextSize.Small, Parent = pvp })
	refs.pvp = pvp

	-- Cash
	local cash = pill(196, Theme.Color.CashTint, 2)
	cash.Parent = bar
	local coin = Icons.coin(22, Theme.Color.HudText)
	coin.Position = UDim2.fromOffset(12, 12)
	coin.Parent = cash
	refs.cash = hudText({ Text = "$0", Position = UDim2.fromOffset(40, 0), Size = UDim2.new(0, 84, 1, 0), TextSize = 19, Parent = cash })
	refs.payTimer = hudText({ Text = "01:00", Position = UDim2.new(1, -66, 0, 6), Size = UDim2.fromOffset(56, 18), TextSize = Theme.TextSize.Small, TextXAlignment = Enum.TextXAlignment.Center, Parent = cash })
	hudText({ Text = "Next Pay", Position = UDim2.new(1, -66, 0, 23), Size = UDim2.fromOffset(56, 14), TextSize = Theme.TextSize.Tiny, TextColor3 = Color3.fromRGB(150, 220, 160), TextXAlignment = Enum.TextXAlignment.Center, Parent = cash })
	refs.cashPill = cash

	-- Population
	local pop = pill(196, Theme.Color.PopTint, 3)
	pop.Parent = bar
	local people = Icons.people(24, Theme.Color.HudText)
	people.Position = UDim2.fromOffset(12, 11)
	people.Parent = pop
	refs.pop = hudText({ Text = "0", AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, -12, 0, 4), Size = UDim2.fromOffset(120, 22), TextSize = 18, TextXAlignment = Enum.TextXAlignment.Right, Parent = pop })
	refs.workers = hudText({ Text = "0 workers free", AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, -12, 0, 25), Size = UDim2.fromOffset(150, 14), TextSize = Theme.TextSize.Tiny, TextColor3 = Theme.Color.HudMuted, FontFace = Theme.Font.Semi, TextXAlignment = Enum.TextXAlignment.Right, Parent = pop })

	-- Happiness
	local happy = pill(176, Theme.Color.HappyTint, 4)
	happy.Parent = bar
	local smile = Icons.smile(22, Theme.Color.HudText)
	smile.Position = UDim2.fromOffset(12, 12)
	smile.Parent = happy
	refs.happy = hudText({ Text = "0%", AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, -14, 0, 0), Size = UDim2.new(0, 80, 1, 0), TextSize = 18, TextXAlignment = Enum.TextXAlignment.Right, Parent = happy })

	-- Travel
	local travel = Lib.button({
		Name = "Travel",
		Size = UDim2.fromOffset(104, 46),
		BackgroundColor3 = Theme.Color.Hud,
		BackgroundTransparency = 0.25,
		LayoutOrder = 5,
		Parent = bar,
		Activated = function()
			Hub.call("openTravel")
		end,
	}, { Lib.corner(Theme.Radius.Pill), Lib.stroke(Color3.new(1, 1, 1), 1, 0.86) })
	hudText({ Text = "Travel", Size = UDim2.fromScale(1, 1), TextXAlignment = Enum.TextXAlignment.Center, TextSize = Theme.TextSize.Small, Parent = travel })

	-- status chips (boost / shield) under the bar
	refs.chips = New("Frame", {
		BackgroundTransparency = 1,
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0, 98),
		Size = UDim2.fromOffset(600, 22),
		Parent = gui,
	}, { Lib.list("x", 6, Enum.HorizontalAlignment.Center) })
end

local function resourceChip(parent: Instance, icon: string, color: Color3, order: number): TextLabel
	local f = New("Frame", {
		BackgroundColor3 = Theme.Color.Hud,
		BackgroundTransparency = 0.35,
		AutomaticSize = Enum.AutomaticSize.X,
		Size = UDim2.fromOffset(0, 26),
		LayoutOrder = order,
		Parent = parent,
	}, { Lib.corner(6), Lib.pad(0, 10, 0, 6), Lib.list("x", 6, nil, Enum.VerticalAlignment.Center) })
	local ic = Icons.get(icon, 14, color)
	ic.LayoutOrder = 1
	ic.Parent = f
	return hudText({
		Text = "-",
		TextSize = Theme.TextSize.Small,
		FontFace = Theme.Font.Semi,
		AutomaticSize = Enum.AutomaticSize.X,
		Size = UDim2.new(0, 0, 1, 0),
		TextTruncate = Enum.TextTruncate.None,
		LayoutOrder = 2,
		Parent = f,
	})
end

local function buildResourceStrip(gui: GuiObject)
	local strip = New("Frame", {
		Name = "Resources",
		BackgroundTransparency = 1,
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0, 66),
		Size = UDim2.fromOffset(900, 26),
		Parent = gui,
	}, { Lib.list("x", 6, Enum.HorizontalAlignment.Center) })
	refs.power = resourceChip(strip, "bolt", Color3.fromRGB(250, 210, 80), 1)
	refs.water = resourceChip(strip, "drop", Color3.fromRGB(110, 190, 250), 2)
	refs.oil = resourceChip(strip, "barrel", Color3.fromRGB(200, 170, 120), 3)
	refs.steel = resourceChip(strip, "beam", Color3.fromRGB(200, 206, 214), 4)
	refs.rp = resourceChip(strip, "flask", Color3.fromRGB(160, 220, 200), 5)
	refs.army = resourceChip(strip, "tank", Color3.fromRGB(170, 200, 130), 6)
end

local function buildQuest(gui: GuiObject)
	local card = Lib.card({
		Name = "Objective",
		Position = UDim2.fromOffset(16, 130),
		Size = UDim2.fromOffset(250, 104),
		BackgroundTransparency = 0.04,
		Parent = gui,
	}, { Lib.pad(10, 12) })
	refs.questCaption = Lib.caption("Objective", { Parent = card })
	refs.questText = Lib.text({
		Text = "...",
		FontFace = Theme.Font.Bold,
		Position = UDim2.fromOffset(0, 16),
		Size = UDim2.new(1, 0, 0, 22),
		Parent = card,
	})
	local bar = Lib.progress({ Position = UDim2.fromOffset(0, 44), Size = UDim2.new(1, 0, 0, 6), Parent = card })
	refs.questBar = bar
	refs.questProgress = Lib.text({
		Text = "0 / 0",
		TextSize = Theme.TextSize.Small,
		TextColor3 = Theme.Color.Muted,
		Position = UDim2.fromOffset(0, 54),
		Size = UDim2.new(0.5, 0, 0, 24),
		Parent = card,
	})
	refs.questReward = Lib.chip("$0", Theme.Color.GoodSoft, Theme.Color.Good, {
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.new(1, 0, 0, 56),
		Parent = card,
	})
	refs.questClaim = Lib.button({
		Text = "CLAIM REWARD",
		FontFace = Theme.Font.Bold,
		TextColor3 = Color3.new(1, 1, 1),
		BackgroundColor3 = Theme.Color.Good,
		Position = UDim2.fromOffset(0, 54),
		Size = UDim2.new(1, 0, 0, 28),
		Visible = false,
		Parent = card,
		Activated = function()
			local res = Net.request("ClaimQuest")
			if res.ok then
				Sounds.play("Success")
			elseif res.err then
				Notifications.show(res.err, "bad")
			end
		end,
	}, { Lib.corner(6) })
	refs.questCard = card
end

local function sideButton(parent: Instance, name: string, icon: string, color: Color3, order: number, onClick: () -> ()): TextButton
	local btn = Lib.button({
		Name = name,
		Size = UDim2.fromOffset(58, 58),
		BackgroundColor3 = Theme.Color.Card,
		LayoutOrder = order,
		Parent = parent,
		Activated = onClick,
	}, { Lib.corner(10), Lib.stroke(Theme.Color.CardStroke) })
	local tile = New("Frame", {
		BackgroundColor3 = color,
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0, 6),
		Size = UDim2.fromOffset(30, 30),
		Parent = btn,
	}, { Lib.corner(7) })
	local ic = Icons.get(icon, 20, Color3.new(1, 1, 1))
	ic.AnchorPoint = Vector2.new(0.5, 0.5)
	ic.Position = UDim2.fromScale(0.5, 0.5)
	ic.Parent = tile
	Lib.text({
		Name = "Label",
		Text = name,
		TextSize = Theme.TextSize.Tiny,
		FontFace = Theme.Font.Bold,
		TextXAlignment = Enum.TextXAlignment.Center,
		Position = UDim2.fromOffset(0, 38),
		Size = UDim2.new(1, 0, 0, 16),
		Parent = btn,
	})
	local badge = New("Frame", {
		Name = "Badge",
		BackgroundColor3 = Theme.Color.Bad,
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.new(1, -6, 0, 6),
		Size = UDim2.fromOffset(12, 12),
		Visible = false,
		Parent = btn,
	}, { Lib.round(), Lib.stroke(Color3.new(1, 1, 1), 2) })
	local _ = badge
	return btn
end

local function buildSideMenu(gui: GuiObject)
	local col = New("Frame", {
		Name = "SideMenu",
		BackgroundTransparency = 1,
		Position = UDim2.fromOffset(16, 246),
		Size = UDim2.fromOffset(124, 400),
		Parent = gui,
	}, { Lib.grid(UDim2.fromOffset(58, 58), 8) })
	refs.shopBtn = sideButton(col, "Store", "cart", Theme.Color.Gold, 1, function()
		Hub.call("openShop")
	end)
	refs.researchBtn = sideButton(col, "Research", "flask", Color3.fromRGB(70, 170, 150), 2, function()
		Hub.call("openResearch")
	end)
	refs.armyBtn = sideButton(col, "Army", "tank", Color3.fromRGB(110, 130, 80), 3, function()
		Hub.call("openArmy")
	end)
	refs.dailyBtn = sideButton(col, "Daily", "calendar", Theme.Color.Military, 4, function()
		Hub.call("openDaily")
	end)
	refs.giftBtn = sideButton(col, "Gift", "gift", Color3.fromRGB(150, 96, 216), 5, function()
		local res = Net.request("ClaimPlaytime")
		if res.ok then
			Sounds.play("Success")
		elseif res.err then
			Notifications.show(res.err, "info")
		end
	end)
	refs.codesBtn = sideButton(col, "Codes", "ticket", Theme.Color.Civil, 6, function()
		Hub.call("openCodes")
	end)
end

local function buildHammer(gui: GuiObject)
	local btn = Lib.button({
		Name = "BuildButton",
		AnchorPoint = Vector2.new(0.5, 1),
		Position = UDim2.new(0.5, 0, 1, -16),
		Size = UDim2.fromOffset(100, 66),
		BackgroundColor3 = Theme.Color.Card,
		Parent = gui,
		Activated = function()
			Hub.call("toggleBuild")
		end,
	}, { Lib.corner(12), Lib.stroke(Theme.Color.CardStroke, 1) })
	local ic = Icons.hammer(30, Theme.Color.Text)
	ic.AnchorPoint = Vector2.new(0.5, 0)
	ic.Position = UDim2.new(0.5, 0, 0, 8)
	ic.Parent = btn
	refs.hammerLabel = Lib.text({
		Text = "BUILD  [B]",
		TextSize = Theme.TextSize.Tiny,
		FontFace = Theme.Font.Bold,
		TextXAlignment = Enum.TextXAlignment.Center,
		Position = UDim2.new(0, 0, 1, -20),
		Size = UDim2.new(1, 0, 0, 16),
		Parent = btn,
	})
	refs.hammer = btn
end

local function setChip(name: string, text: string?, bg: Color3, fg: Color3)
	local existing = refs.chips:FindFirstChild(name)
	if not text then
		if existing then
			existing:Destroy()
		end
		return
	end
	if existing then
		(existing:FindFirstChild("Label") :: TextLabel).Text = text
	else
		local chip = Lib.chip(text, bg, fg)
		chip.Name = name
		chip.Parent = refs.chips
	end
end

local function refresh()
	local d = ClientState.data
	if d.cash == nil then
		return
	end
	refs.cash.Text = Format.cash(d.cash)
	refs.pop.Text = Format.short(d.pop or 0)
	local free = math.max(0, (d.pop or 0) - (d.workersUsed or 0))
	refs.workers.Text = Format.short(free) .. " workers free"
	refs.happy.Text = Format.percent(d.happiness or 0)

	local pvpOn = d.pvp == true
	refs.pvpLabel.Text = pvpOn and "PVP ON" or "PVP OFF"
	Lib.setButtonColor(refs.pvp, pvpOn and Color3.fromRGB(150, 40, 40) or Theme.Color.Hud)

	local power, water = d.power or { 0, 0 }, d.water or { 0, 0 }
	refs.power.Text = ("%s / %s MW"):format(Format.short(power[1]), Format.short(power[2]))
	refs.power.TextColor3 = power[1] + 0.5 < power[2] and Color3.fromRGB(255, 140, 120) or Theme.Color.HudText
	refs.water.Text = ("%s / %s"):format(Format.short(water[1]), Format.short(water[2]))
	refs.water.TextColor3 = water[1] + 0.5 < water[2] and Color3.fromRGB(255, 140, 120) or Theme.Color.HudText
	refs.oil.Text = ("%s / %s"):format(Format.short(d.oil or 0), Format.short(d.oilCap or 0))
	refs.steel.Text = ("%s / %s"):format(Format.short(d.steel or 0), Format.short(d.steelCap or 0))
	refs.rp.Text = ("%s RP  +%s/m"):format(Format.short(d.rp or 0), Format.short(d.rpRate or 0))
	refs.army.Text = ("%d / %d"):format(d.units or 0, d.unitCap or 0)

	local q = d.quest
	if q then
		refs.questCard.Visible = true
		refs.questCaption.Text = ("OBJECTIVE %d"):format(q.i)
		refs.questText.Text = q.text
		refs.questBar.set(q.max > 0 and q.cur / q.max or 0, q.done and Theme.Color.Good or nil)
		refs.questProgress.Text = ("%s / %s"):format(Format.commas(q.cur), Format.commas(q.max))
		;(refs.questReward:FindFirstChild("Label") :: TextLabel).Text = Format.cash(q.reward)
		refs.questClaim.Visible = q.done
		refs.questProgress.Visible = not q.done
		refs.questReward.Visible = not q.done
	else
		refs.questCard.Visible = false
	end

	local daily = d.daily
	refs.dailyBtn.Badge.Visible = daily ~= nil and daily.canClaim == true
end

function HUD.payPop(amount: number)
	Notifications.float((amount >= 0 and "+" or "") .. Format.cash(amount), UDim2.new(0.5, -90, 0, 70))
end

function HUD.init(gui: GuiObject)
	buildTopBar(gui)
	buildResourceStrip(gui)
	buildQuest(gui)
	buildSideMenu(gui)
	buildHammer(gui)
	ClientState.onAny(refresh)

	local lastCash: number? = nil
	ClientState.on("nextPay", function()
		local cash = ClientState.get("cash")
		if lastCash and cash then
			HUD.payPop(ClientState.get("income") or 0)
		end
		lastCash = cash
	end)

	ClientState.onMode(function(mode)
		refs.hammerLabel.Text = mode == "war" and "BACK HOME" or (mode == "build" and "CLOSE  [B]" or "BUILD  [B]")
		refs.hammer.Visible = mode ~= "build"
	end)

	-- countdowns
	local acc = 0
	RunService.Heartbeat:Connect(function(dt)
		acc += dt
		if acc < 0.2 then
			return
		end
		acc = 0
		local d = ClientState.data
		local now = Lib.serverNow()
		if d.nextPay then
			refs.payTimer.Text = Format.clock(d.nextPay - now)
		end
		if d.giftAt then
			local left = d.giftAt - now
			local label = refs.giftBtn:FindFirstChild("Label") :: TextLabel
			label.Text = left > 0 and Format.clock(left) or "CLAIM!"
			refs.giftBtn.Badge.Visible = left <= 0
		end
		local boost = (d.boostUntil or 0) - os.time()
		setChip("Boost", boost > 0 and ("2x CASH  " .. Format.clock(boost)) or nil, Theme.Color.GoodSoft, Theme.Color.Good)
		local shield = (d.shield or 0) - os.time()
		setChip("Shield", shield > 0 and ("NEW NATION SHIELD  " .. Format.clock(shield)) or nil, Theme.Color.TimeSoft, Theme.Color.Time)
		local lock = (d.pvpLock or 0) - now
		setChip("PvpLock", lock > 0 and ("PVP LOCKED ON  " .. Format.clock(lock)) or nil, Theme.Color.BadSoft, Theme.Color.Bad)
		setChip("Unsaved", d.persistent == false and "STUDIO: DATA NOT SAVED (enable API access)" or nil, Theme.Color.GoldSoft, Theme.Color.Amber)
	end)
end

return HUD
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="53">
            <Properties>
              <string name="Name">Modal</string>
              <string name="Source"><![CDATA[--[[
	Modal
	One centered window at a time (building panel, research, shop, daily...).
	Builds the shared window chrome: header with icon, title, subtitle and an
	X button, plus a scrolling body.
]]

local UserInputService = game:GetService("UserInputService")

local UI = script.Parent.Parent.UI
local Lib = require(UI.Lib)
local Theme = require(UI.Theme)
local Icons = require(UI.Icons)

local New = Lib.New

local Modal = {}

export type Window = {
	root: Frame,
	header: Frame,
	iconHolder: Frame,
	title: TextLabel,
	subtitle: TextLabel,
	body: Frame,
	close: () -> (),
	onClose: ((() -> ()) -> ()),
}

local layer: GuiObject
local dim: TextButton
local current: Window? = nil
local closeCallbacks: { () -> () } = {}

function Modal.isOpen(): boolean
	return current ~= nil
end

function Modal.close()
	if not current then
		return
	end
	local w = current
	current = nil
	local cbs = closeCallbacks
	closeCallbacks = {}
	for _, cb in cbs do
		task.spawn(cb)
	end
	Lib.tween(w.root, 0.12, { Position = UDim2.new(0.5, 0, 0.5, 14) })
	task.delay(0.1, function()
		w.root:Destroy()
	end)
	dim.Visible = false
end

-- width/height in pixels at UIScale 1.
function Modal.open(title: string, subtitle: string?, width: number?, height: number?): Window
	Modal.close()
	dim.Visible = true
	local w, h = width or 640, height or 540
	local root = Lib.panel({
		Name = "Window",
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.new(0.5, 0, 0.5, 14),
		Size = UDim2.fromOffset(w, h),
		BackgroundColor3 = Theme.Color.Panel,
		ZIndex = 10,
		Parent = layer,
	})
	Lib.tween(root, 0.16, { Position = UDim2.fromScale(0.5, 0.5) }, Enum.EasingStyle.Back)

	local header = New("Frame", {
		Name = "Header",
		BackgroundColor3 = Theme.Color.Header,
		Size = UDim2.new(1, 0, 0, 64),
		BorderSizePixel = 0,
		ZIndex = 10,
		Parent = root,
	}, { Lib.corner(Theme.Radius.Panel) })
	-- square off the header's bottom corners
	New("Frame", {
		BackgroundColor3 = Theme.Color.Header,
		BorderSizePixel = 0,
		Position = UDim2.new(0, 0, 1, -10),
		Size = UDim2.new(1, 0, 0, 10),
		ZIndex = 10,
		Parent = header,
	})
	New("Frame", {
		BackgroundColor3 = Theme.Color.PanelStroke,
		BorderSizePixel = 0,
		Position = UDim2.new(0, 0, 1, 0),
		Size = UDim2.new(1, 0, 0, 1),
		ZIndex = 11,
		Parent = header,
	})
	local iconHolder = New("Frame", {
		Name = "IconHolder",
		BackgroundTransparency = 1,
		Position = UDim2.fromOffset(16, 8),
		Size = UDim2.fromOffset(52, 48),
		ZIndex = 11,
		Parent = header,
	})
	local titleLabel = Lib.text({
		Text = title,
		FontFace = Theme.Font.Bold,
		TextSize = Theme.TextSize.Title,
		Position = UDim2.fromOffset(78, 12),
		Size = UDim2.new(1, -140, 0, 24),
		ZIndex = 11,
		Parent = header,
	})
	local subtitleLabel = Lib.text({
		Text = subtitle or "",
		TextSize = Theme.TextSize.Small,
		TextColor3 = Theme.Color.Muted,
		FontFace = Theme.Font.Regular,
		Position = UDim2.fromOffset(78, 35),
		Size = UDim2.new(1, -140, 0, 18),
		ZIndex = 11,
		Parent = header,
	})
	local closeBtn = Lib.button({
		Name = "Close",
		AnchorPoint = Vector2.new(1, 0.5),
		Position = UDim2.new(1, -14, 0.5, 0),
		Size = UDim2.fromOffset(36, 36),
		BackgroundColor3 = Theme.Color.Header,
		ZIndex = 11,
		Parent = header,
		Activated = function()
			Modal.close()
		end,
	}, { Lib.corner(8) })
	local x = Icons.close(14, Theme.Color.Text)
	x.AnchorPoint = Vector2.new(0.5, 0.5)
	x.Position = UDim2.fromScale(0.5, 0.5)
	x.ZIndex = 12
	for _, d in x:GetDescendants() do
		if d:IsA("GuiObject") then
			d.ZIndex = 12
		end
	end
	x.Parent = closeBtn

	local body = New("Frame", {
		Name = "Body",
		BackgroundTransparency = 1,
		Position = UDim2.fromOffset(0, 65),
		Size = UDim2.new(1, 0, 1, -65),
		ZIndex = 10,
		Parent = root,
	}, { Lib.pad(14) })

	local win: Window
	win = {
		root = root,
		header = header,
		iconHolder = iconHolder,
		title = titleLabel,
		subtitle = subtitleLabel,
		body = body,
		close = function()
			if current == win then
				Modal.close()
			end
		end,
		onClose = function(cb)
			table.insert(closeCallbacks, cb)
		end,
	}
	current = win
	return win
end

-- Make every GuiObject under `root` render above the dim layer.
function Modal.lift(root: Instance, z: number?)
	local zi = z or 11
	if root:IsA("GuiObject") then
		root.ZIndex = math.max(root.ZIndex, zi)
	end
	for _, d in root:GetDescendants() do
		if d:IsA("GuiObject") then
			d.ZIndex = math.max(d.ZIndex, zi)
		end
	end
end

function Modal.init(gui: GuiObject)
	layer = gui
	dim = New("TextButton", {
		Name = "Dim",
		AutoButtonColor = false,
		Text = "",
		BackgroundColor3 = Color3.new(0, 0, 0),
		BackgroundTransparency = 0.55,
		Size = UDim2.fromScale(1, 1),
		Visible = false,
		ZIndex = 9,
		Parent = gui,
		Activated = function()
			Modal.close()
		end,
	})
	UserInputService.InputBegan:Connect(function(input, processed)
		if not processed and input.KeyCode == Enum.KeyCode.Escape then
			Modal.close()
		end
	end)
end

return Modal
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="54">
            <Properties>
              <string name="Name">Notifications</string>
              <string name="Source"><![CDATA[--[[
	Notifications
	Toast stack (top center) for server messages, plus the floating
	"+$12.4k" pay-day pop over the cash pill.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Net = require(ReplicatedStorage.Shared.Net)
local UI = script.Parent.Parent.UI
local Lib = require(UI.Lib)
local Theme = require(UI.Theme)
local Sounds = require(script.Parent.Sounds)

local New = Lib.New

local Notifications = {}

local holder: Frame
local KIND_COLORS = {
	info = Theme.Color.Accent,
	good = Theme.Color.Good,
	bad = Theme.Color.Bad,
	pay = Theme.Color.Good,
	war = Theme.Color.Military,
}

local order = 0

function Notifications.show(text: string, kind: string?)
	local k = kind or "info"
	order += 1
	local accent = KIND_COLORS[k] or Theme.Color.Accent
	local toast = New("Frame", {
		BackgroundColor3 = Theme.Color.Card,
		Size = UDim2.fromOffset(0, 40),
		AutomaticSize = Enum.AutomaticSize.X,
		BackgroundTransparency = 1,
		LayoutOrder = -order,
		Parent = holder,
	}, {
		Lib.corner(8),
		Lib.stroke(Theme.Color.CardStroke, 1, 1),
		Lib.pad(0, 16, 0, 14),
		Lib.list("x", 10, Enum.HorizontalAlignment.Left, Enum.VerticalAlignment.Center),
		New("Frame", {
			Name = "Dot",
			BackgroundColor3 = accent,
			Size = UDim2.fromOffset(8, 8),
			BackgroundTransparency = 1,
		}, { Lib.round() }),
		Lib.text({
			Name = "Label",
			Text = text,
			FontFace = Theme.Font.Semi,
			TextSize = Theme.TextSize.Body,
			AutomaticSize = Enum.AutomaticSize.X,
			Size = UDim2.new(0, 0, 1, 0),
			TextTruncate = Enum.TextTruncate.None,
			TextTransparency = 1,
		}),
	})
	local stroke = toast:FindFirstChildOfClass("UIStroke") :: UIStroke
	local dot = toast:FindFirstChild("Dot") :: Frame
	local label = toast:FindFirstChild("Label") :: TextLabel
	Lib.tween(toast, 0.15, { BackgroundTransparency = 0.04 })
	Lib.tween(stroke, 0.15, { Transparency = 0 })
	Lib.tween(dot, 0.15, { BackgroundTransparency = 0 })
	Lib.tween(label, 0.15, { TextTransparency = 0 })
	if k == "bad" then
		Sounds.play("Error")
	elseif k == "good" then
		Sounds.play("Click", 1.2)
	end
	-- keep at most 5 toasts
	local toasts = {}
	for _, c in holder:GetChildren() do
		if c:IsA("Frame") then
			table.insert(toasts, c)
		end
	end
	table.sort(toasts, function(a, b)
		return a.LayoutOrder < b.LayoutOrder
	end)
	for i = 6, #toasts do
		toasts[i]:Destroy()
	end
	task.delay(k == "war" and 6 or 4, function()
		if toast.Parent then
			Lib.tween(toast, 0.25, { BackgroundTransparency = 1 })
			Lib.tween(stroke, 0.25, { Transparency = 1 })
			Lib.tween(dot, 0.25, { BackgroundTransparency = 1 })
			Lib.tween(label, 0.25, { TextTransparency = 1 })
			task.wait(0.26)
			toast:Destroy()
		end
	end)
end

-- Floating text that rises from a screen position (pay day).
function Notifications.float(text: string, at: UDim2, color: Color3?)
	local label = Lib.text({
		Text = text,
		FontFace = Theme.Font.Bold,
		TextSize = 22,
		TextColor3 = color or Color3.fromRGB(120, 230, 140),
		TextStrokeTransparency = 0.6,
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = at,
		Size = UDim2.fromOffset(200, 30),
		TextXAlignment = Enum.TextXAlignment.Center,
		Parent = holder.Parent,
	})
	Lib.tween(label, 1.4, { Position = at - UDim2.fromOffset(0, 50), TextTransparency = 1, TextStrokeTransparency = 1 })
	task.delay(1.5, function()
		label:Destroy()
	end)
end

function Notifications.init(gui: GuiObject)
	holder = New("Frame", {
		Name = "Toasts",
		BackgroundTransparency = 1,
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0, 126),
		Size = UDim2.fromOffset(700, 260),
		Parent = gui,
	}, { Lib.list("y", 6, Enum.HorizontalAlignment.Center) })
	Net.event("Notify").OnClientEvent:Connect(function(text, kind)
		if kind == "pay" then
			Sounds.play("Pay", 1.4)
		end
		Notifications.show(text, kind)
	end)
end

return Notifications
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="55">
            <Properties>
              <string name="Name">Placement</string>
              <string name="Source"><![CDATA[--[[
	Placement
	Ghost previews and every build tool:
	  place  - LMB place (stays selected for fast building), R rotate
	  drag   - hold and drag to paint a line (roads, or any item with Drag on)
	  delete - click a building to demolish it (hotkey 2)
	  undo   - hotkey 3
	  move   - click a building, then click its new spot (hotkey 5)
	  rotate - R / hotkey 6
	When nothing is selected, clicking one of your buildings opens its panel.
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")

local Shared = ReplicatedStorage.Shared
local Buildings = require(Shared.Catalog.Buildings)
local Grid = require(Shared.Util.Grid)
local ModelBuilder = require(Shared.ModelBuilder)
local Net = require(Shared.Net)

local Client = script.Parent.Parent
local ClientState = require(Client.ClientState)
local Hub = require(Client.Hub)
local Notifications = require(script.Parent.Notifications)
local Sounds = require(script.Parent.Sounds)

local Placement = {}

local player = Players.LocalPlayer
local camera = workspace.CurrentCamera

local VALID = Color3.fromRGB(80, 220, 120)
local INVALID = Color3.fromRGB(235, 70, 60)
local MOVE = Color3.fromRGB(80, 160, 255)

local selected: any = nil
local tool: string? = nil -- nil | "delete" | "move"
local rotation = 0
local dragMode = false
local pointer = Vector2.new(0, 0)

local ghost: Model? = nil
local plate: Part? = nil
local highlight: Highlight? = nil
local hoverHighlight: Highlight
local dragStart: Vector2? = nil -- cell
local dragTiles: { Part } = {}
local moving: Model? = nil -- building being moved
local lastCell: Vector2? = nil
local listeners: { () -> () } = {}

-- client-side occupancy (rebuilt from the plot's building models)
local occupied: { [number]: number } = {}

local function notifyChanged()
	for _, fn in listeners do
		task.spawn(fn)
	end
end

function Placement.onChanged(fn: () -> ())
	table.insert(listeners, fn)
end

function Placement.state()
	return { def = selected, tool = tool, rotation = rotation, drag = dragMode, moving = moving ~= nil }
end

local function plotOrigin(): Vector3?
	local idx = ClientState.get("plot")
	if not idx then
		return nil
	end
	return Grid.plotOrigin(idx)
end

local function buildingsFolder(): Folder?
	local idx = ClientState.get("plot")
	if not idx then
		return nil
	end
	local homeland = workspace:FindFirstChild("Homeland")
	local plot = homeland and homeland:FindFirstChild("Plot_" .. idx)
	return plot and plot:FindFirstChild("Buildings") :: Folder? or nil
end

local function footprintFromModel(model: Model): (number?, number?, number?, number?, number?)
	local def = Buildings.get(model:GetAttribute("BuildingId") :: string)
	local origin = plotOrigin()
	if not def or not origin then
		return nil
	end
	local pivot = model:GetPivot()
	local _, yaw, _ = pivot:ToOrientation()
	local r = math.floor(math.deg(yaw) / 90 + 0.5) % 4
	local fw, fd = Grid.footprint(def.size[1], def.size[2], r)
	local x, z = Grid.worldToCell(origin, pivot.Position, fw, fd)
	return x, z, fw, fd, r
end

local function rebuildOccupancy()
	table.clear(occupied)
	local folder = buildingsFolder()
	if not folder then
		return
	end
	for _, model in folder:GetChildren() do
		if model:IsA("Model") and model ~= moving then
			local x, z, fw, fd = footprintFromModel(model)
			if x and z and fw and fd then
				local uid = model:GetAttribute("Uid") :: number
				for cx = x, x + fw - 1 do
					for cz = z, z + fd - 1 do
						occupied[Grid.key(cx, cz)] = uid
					end
				end
			end
		end
	end
end

local function canPlaceLocal(def, x: number, z: number, r: number): boolean
	local fw, fd = Grid.footprint(def.size[1], def.size[2], r)
	if not Grid.inBounds(x, z, fw, fd) then
		return false
	end
	for cx = x, x + fw - 1 do
		for cz = z, z + fd - 1 do
			if occupied[Grid.key(cx, cz)] then
				return false
			end
		end
	end
	return true
end

---------------------------------------------------------------------------
-- Ghost visuals
---------------------------------------------------------------------------
local function clearGhost()
	if ghost then
		ghost:Destroy()
		ghost = nil
	end
	if plate then
		plate:Destroy()
		plate = nil
	end
	highlight = nil
	for _, t in dragTiles do
		t:Destroy()
	end
	table.clear(dragTiles)
	lastCell = nil
end

local function makeGhost(def)
	clearGhost()
	local m = ModelBuilder.building(def)
	for _, d in m:GetDescendants() do
		if d:IsA("BasePart") then
			d.CanCollide = false
			d.CanQuery = false
			d.CanTouch = false
			d.CastShadow = false
			d.Transparency = math.max(d.Transparency, 0.35)
		end
	end
	local h = Instance.new("Highlight")
	h.FillTransparency = 0.75
	h.OutlineTransparency = 0.1
	h.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
	h.Parent = m
	highlight = h
	m.Name = "Ghost"
	m.Parent = workspace
	ghost = m

	local p = Instance.new("Part")
	p.Name = "GhostPlate"
	p.Anchored = true
	p.CanCollide = false
	p.CanQuery = false
	p.CanTouch = false
	p.Material = Enum.Material.Neon
	p.Transparency = 0.55
	p.Parent = workspace
	plate = p
end

local function tilePart(): Part
	local p = Instance.new("Part")
	p.Anchored = true
	p.CanCollide = false
	p.CanQuery = false
	p.CanTouch = false
	p.Material = Enum.Material.Neon
	p.Transparency = 0.45
	p.Parent = workspace
	return p
end

---------------------------------------------------------------------------
-- Pointer -> world
---------------------------------------------------------------------------
local function groundHit(): Vector3?
	local ray = camera:ScreenPointToRay(pointer.X, pointer.Y)
	if math.abs(ray.Direction.Y) < 1e-4 then
		return nil
	end
	local t = -ray.Origin.Y / ray.Direction.Y
	if t < 0 or t > 3000 then
		return nil
	end
	return ray.Origin + ray.Direction * t
end

local function buildingUnderPointer(): Model?
	local folder = buildingsFolder()
	if not folder then
		return nil
	end
	local ray = camera:ScreenPointToRay(pointer.X, pointer.Y)
	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Include
	params.FilterDescendantsInstances = { folder }
	local result = workspace:Raycast(ray.Origin, ray.Direction * 3000, params)
	if not result then
		return nil
	end
	local inst: Instance? = result.Instance
	while inst and inst.Parent ~= folder do
		inst = inst.Parent
	end
	return inst and inst:IsA("Model") and inst or nil
end

local function cellAt(def, r: number): (number?, number?)
	local origin = plotOrigin()
	local hit = groundHit()
	if not origin or not hit then
		return nil
	end
	local fw, fd = Grid.footprint(def.size[1], def.size[2], r)
	return Grid.worldToCell(origin, hit, fw, fd)
end

-- cells for a straight drag line from a to b (dominant axis), stepping by footprint
local function dragCells(def, a: Vector2, b: Vector2, r: number): { { number } }
	local fw, fd = Grid.footprint(def.size[1], def.size[2], r)
	local out = {}
	local dx, dz = b.X - a.X, b.Y - a.Y
	if math.abs(dx) >= math.abs(dz) then
		local steps = math.floor(math.abs(dx) / fw + 0.5)
		local dir = dx >= 0 and 1 or -1
		for i = 0, math.min(steps, 120) do
			table.insert(out, { a.X + i * fw * dir, a.Y })
		end
	else
		local steps = math.floor(math.abs(dz) / fd + 0.5)
		local dir = dz >= 0 and 1 or -1
		for i = 0, math.min(steps, 120) do
			table.insert(out, { a.X, a.Y + i * fd * dir })
		end
	end
	return out
end

---------------------------------------------------------------------------
-- Per-frame update
---------------------------------------------------------------------------
local function cashOk(def): boolean
	return (ClientState.get("cash") or 0) >= def.cost
end

local function update()
	local active = ClientState.mode == "build" or moving ~= nil
	-- hover highlight for delete / move / inspect
	local hovered: Model? = nil
	if active and (tool == "delete" or (tool == "move" and not moving)) then
		hovered = buildingUnderPointer()
	end
	if hovered then
		if hoverHighlight.Adornee ~= hovered then
			hoverHighlight.Adornee = hovered
		end
		hoverHighlight.OutlineColor = tool == "delete" and INVALID or MOVE
		hoverHighlight.FillColor = hoverHighlight.OutlineColor
	end
	hoverHighlight.Enabled = hovered ~= nil

	local def = selected
	if not active or not def or not ghost or not plate then
		return
	end
	local origin = plotOrigin()
	if not origin then
		return
	end
	local x, z = cellAt(def, rotation)
	if not x or not z then
		ghost.Parent = nil
		plate.Parent = nil
		return
	end
	ghost.Parent = workspace
	plate.Parent = workspace

	local valid = canPlaceLocal(def, x, z, rotation) and (moving ~= nil or cashOk(def))
	local cf = Grid.cframeFor(origin, x, z, def.size[1], def.size[2], rotation)
	ghost:PivotTo(cf)
	local fw, fd = Grid.footprint(def.size[1], def.size[2], rotation)
	plate.Size = Vector3.new(fw * Grid.CellSize - 0.2, 0.1, fd * Grid.CellSize - 0.2)
	plate.CFrame = CFrame.new(cf.Position + Vector3.new(0, 0.08, 0))
	local color = moving and (valid and MOVE or INVALID) or (valid and VALID or INVALID)
	plate.Color = color
	if highlight then
		highlight.FillColor = color
		highlight.OutlineColor = color
	end

	-- drag preview
	if dragStart then
		local cells = dragCells(def, dragStart, Vector2.new(x, z), rotation)
		for i, c in cells do
			local t = dragTiles[i]
			if not t then
				t = tilePart()
				dragTiles[i] = t
			end
			local tcf = Grid.cframeFor(origin, c[1], c[2], def.size[1], def.size[2], rotation)
			t.Size = Vector3.new(fw * Grid.CellSize - 0.4, 0.3, fd * Grid.CellSize - 0.4)
			t.CFrame = CFrame.new(tcf.Position + Vector3.new(0, 0.15, 0))
			t.Color = canPlaceLocal(def, c[1], c[2], rotation) and VALID or INVALID
		end
		for i = #cells + 1, #dragTiles do
			dragTiles[i]:Destroy()
			dragTiles[i] = nil
		end
	end
	lastCell = Vector2.new(x, z)
end

---------------------------------------------------------------------------
-- Actions
---------------------------------------------------------------------------
local function toast(res)
	if res and not res.ok and res.err then
		Notifications.show(res.err, "bad")
		return false
	end
	return true
end

function Placement.select(def)
	moving = nil
	tool = nil
	selected = def
	dragStart = nil
	rotation = rotation % 4
	if def then
		makeGhost(def)
		dragMode = def.drag == true
	else
		clearGhost()
		dragMode = false
	end
	notifyChanged()
end

function Placement.setTool(t: string?)
	if moving then
		moving = nil
		rebuildOccupancy()
	end
	if t == tool then
		t = nil
	end
	tool = t
	if t then
		selected = nil
		clearGhost()
	end
	notifyChanged()
end

-- Start moving a specific building (used by the building panel's Move button).
function Placement.beginMove(target: Model)
	local def = Buildings.get(target:GetAttribute("BuildingId") :: string)
	if not def then
		return
	end
	local _, _, _, _, r = footprintFromModel(target)
	rotation = r or 0
	tool = "move"
	selected = def
	makeGhost(def)
	moving = target
	rebuildOccupancy()
	notifyChanged()
end

function Placement.rotate()
	rotation = (rotation + 1) % 4
	notifyChanged()
end

function Placement.toggleDrag()
	dragMode = not dragMode
	notifyChanged()
end

function Placement.cancel()
	moving = nil
	selected = nil
	tool = nil
	dragStart = nil
	clearGhost()
	rebuildOccupancy()
	notifyChanged()
end

function Placement.undo()
	local res = Net.request("Undo")
	if toast(res) then
		Sounds.play("Click", 0.8)
		task.delay(0.3, rebuildOccupancy)
	end
end

local function placeAt(def, x: number, z: number)
	local res = Net.request("PlaceBuilding", def.id, x, z, rotation)
	if toast(res) then
		Sounds.play("Place")
	end
end

local function primaryDown()
	local mode = ClientState.mode
	if mode == "war" then
		return
	end
	if moving and selected then
		if not lastCell then
			return
		end
		local uid = moving:GetAttribute("Uid")
		local res = Net.request("MoveBuilding", uid, lastCell.X, lastCell.Y, rotation)
		if toast(res) then
			Sounds.play("Place")
			moving = nil
			selected = nil
			clearGhost()
			task.delay(0.2, rebuildOccupancy)
			notifyChanged()
		end
		return
	end
	if mode == "build" and tool == "delete" then
		local target = buildingUnderPointer()
		if target then
			local res = Net.request("DeleteBuilding", target:GetAttribute("Uid"))
			if toast(res) then
				Sounds.play("Click", 0.7)
			end
		end
		return
	end
	if mode == "build" and tool == "move" then
		local target = buildingUnderPointer()
		if target then
			local def = Buildings.get(target:GetAttribute("BuildingId") :: string)
			if def then
				local _, _, _, _, r = footprintFromModel(target)
				rotation = r or 0
				selected = def
				makeGhost(def)
				moving = target
				rebuildOccupancy()
				notifyChanged()
			end
		end
		return
	end
	if mode == "build" and selected then
		if not lastCell then
			return
		end
		if dragMode then
			dragStart = lastCell
		else
			placeAt(selected, lastCell.X, lastCell.Y)
		end
		return
	end
	-- inspect
	local target = buildingUnderPointer()
	if target then
		Hub.call("openBuilding", target)
	end
end

local function primaryUp()
	if dragStart and selected and lastCell then
		local cells = dragCells(selected, dragStart, lastCell, rotation)
		dragStart = nil
		for _, t in dragTiles do
			t:Destroy()
		end
		table.clear(dragTiles)
		if #cells == 1 then
			placeAt(selected, cells[1][1], cells[1][2])
		else
			local res = Net.request("PlaceMany", selected.id, cells, rotation)
			if toast(res) then
				Sounds.play("Place")
			end
		end
	end
	dragStart = nil
end

function Placement.init()
	hoverHighlight = Instance.new("Highlight")
	hoverHighlight.FillTransparency = 0.7
	hoverHighlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
	hoverHighlight.Enabled = false
	hoverHighlight.Parent = player:WaitForChild("PlayerGui")

	UserInputService.InputChanged:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then
			pointer = Vector2.new(input.Position.X, input.Position.Y)
		end
	end)
	UserInputService.InputBegan:Connect(function(input, processed)
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
			pointer = Vector2.new(input.Position.X, input.Position.Y)
			if processed then
				return
			end
			if input.UserInputType == Enum.UserInputType.Touch then
				update() -- refresh the ghost under the finger first
			end
			primaryDown()
		elseif not processed and ClientState.mode == "build" then
			local key = input.KeyCode
			if key == Enum.KeyCode.R or key == Enum.KeyCode.Six then
				Placement.rotate()
			elseif key == Enum.KeyCode.Two then
				Placement.setTool("delete")
			elseif key == Enum.KeyCode.Three or (key == Enum.KeyCode.Z and UserInputService:IsKeyDown(Enum.KeyCode.LeftControl)) then
				Placement.undo()
			elseif key == Enum.KeyCode.Four then
				Placement.toggleDrag()
			elseif key == Enum.KeyCode.Five then
				Placement.setTool("move")
			elseif key == Enum.KeyCode.Q then
				Placement.cancel()
			end
		end
	end)
	UserInputService.InputEnded:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
			primaryUp()
		end
	end)

	RunService.RenderStepped:Connect(update)

	-- keep occupancy in sync with the plot
	local function hookFolder()
		local folder = buildingsFolder()
		if not folder then
			return
		end
		folder.ChildAdded:Connect(function()
			task.defer(rebuildOccupancy)
		end)
		folder.ChildRemoved:Connect(function()
			task.defer(rebuildOccupancy)
		end)
		rebuildOccupancy()
	end
	ClientState.on("plot", function()
		task.wait(0.5)
		hookFolder()
	end)
	ClientState.onMode(function(mode)
		if mode ~= "build" and not moving then
			Placement.cancel()
		end
	end)
end

return Placement
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="56">
            <Properties>
              <string name="Name">ResearchUI</string>
              <string name="Source"><![CDATA[--[[
	ResearchUI
	The research tree window: Civil and Military branches laid out by
	column/row, with costs, requirements, hit gates and the active project.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Shared = ReplicatedStorage.Shared
local Research = require(Shared.Catalog.Research)
local Format = require(Shared.Util.Format)
local Net = require(Shared.Net)

local Client = script.Parent.Parent
local ClientState = require(Client.ClientState)
local Hub = require(Client.Hub)
local Lib = require(Client.UI.Lib)
local Theme = require(Client.UI.Theme)
local Icons = require(Client.UI.Icons)
local Modal = require(script.Parent.Modal)
local Notifications = require(script.Parent.Notifications)
local Sounds = require(script.Parent.Sounds)

local New = Lib.New

local ResearchUI = {}

local NODE_W, NODE_H, GAP = 142, 92, 8

local function nodeState(def): (string, string?)
	local d = ClientState.data
	local researched = d.researched or {}
	if researched[def.id] then
		return "done", nil
	end
	local active = d.research
	if active and active.id == def.id then
		return "active", nil
	end
	for _, req in def.requires do
		if not researched[req] then
			local r = Research.get(req)
			return "locked", "Needs " .. (r and r.name or req)
		end
	end
	local hits = (d.stats or {}).Hits or 0
	if def.hits and hits < def.hits then
		return "locked", ("Needs %d hits (%d)"):format(def.hits, hits)
	end
	return "available", nil
end

function ResearchUI.open(focusId: string?)
	local win = Modal.open("Research", "Unlock new buildings, weapons and vehicles", 960, 660)
	local ic = Icons.flask(40, Color3.fromRGB(70, 170, 150))
	ic.Position = UDim2.fromOffset(4, 4)
	ic.Parent = win.iconHolder

	-- summary row
	local top = New("Frame", { BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 76), Parent = win.body }, { Lib.list("x", 8) })
	local function summary(caption: string, order: number, width: number): TextLabel
		local card = Lib.card({ Size = UDim2.new(0, width, 1, 0), LayoutOrder = order, Parent = top }, { Lib.pad(10, 12) })
		Lib.caption(caption, { Parent = card })
		return Lib.text({ Text = "-", FontFace = Theme.Font.Bold, TextSize = Theme.TextSize.Title, Position = UDim2.fromOffset(0, 18), Size = UDim2.new(1, 0, 0, 26), Parent = card })
	end
	local rpLabel = summary("Research Points", 1, 190)
	local hitsLabel = summary("Hits Landed", 2, 150)
	local activeCard = Lib.card({ Size = UDim2.new(1, -364, 1, 0), LayoutOrder = 3, Parent = top }, { Lib.pad(10, 12) })
	Lib.caption("Current Project", { Parent = activeCard })
	local activeName = Lib.text({ Text = "Nothing - pick a project below", FontFace = Theme.Font.Bold, Position = UDim2.fromOffset(0, 16), Size = UDim2.new(1, -150, 0, 22), Parent = activeCard })
	local activeBar = Lib.progress({ Position = UDim2.fromOffset(0, 44), Size = UDim2.new(1, -150, 0, 6), Parent = activeCard })
	local activeTime = Lib.text({ Text = "", TextSize = Theme.TextSize.Tiny, TextColor3 = Theme.Color.Muted, Position = UDim2.fromOffset(0, 50), Size = UDim2.new(1, -150, 0, 14), Parent = activeCard })
	Lib.button({
		Text = "Finish Now",
		FontFace = Theme.Font.Bold,
		TextColor3 = Color3.new(1, 1, 1),
		BackgroundColor3 = Theme.Color.Gold,
		AnchorPoint = Vector2.new(1, 0.5),
		Position = UDim2.new(1, 0, 0.5, 0),
		Size = UDim2.fromOffset(136, 36),
		Parent = activeCard,
		Activated = function()
			Hub.call("buyProduct", "InstantResearch")
		end,
	}, { Lib.corner(6) })

	local scroll = New("ScrollingFrame", {
		BackgroundTransparency = 1,
		Position = UDim2.fromOffset(0, 86),
		Size = UDim2.new(1, 0, 1, -86),
		CanvasSize = UDim2.new(),
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
		ScrollBarThickness = 4,
		ScrollBarImageColor3 = Theme.Color.Faint,
		BorderSizePixel = 0,
		Parent = win.body,
	}, { Lib.list("y", 10) })

	local nodes: { [string]: { btn: TextButton, status: TextLabel, bar: Lib.Progress } } = {}

	for bi, branch in { "Civil", "Military" } do
		local maxRow, maxCol = 0, 0
		for _, def in Research.all() do
			if def.branch == branch then
				maxRow = math.max(maxRow, def.row)
				maxCol = math.max(maxCol, def.col)
			end
		end
		Lib.caption(branch .. " Research", { LayoutOrder = bi * 2 - 1, Parent = scroll })
		local area = New("Frame", {
			BackgroundTransparency = 1,
			Size = UDim2.new(1, 0, 0, maxRow * (NODE_H + GAP)),
			LayoutOrder = bi * 2,
			Parent = scroll,
		})
		for _, def in Research.all() do
			if def.branch == branch then
				local btn = Lib.button({
					Name = def.id,
					Position = UDim2.fromOffset((def.col - 1) * (NODE_W + GAP), (def.row - 1) * (NODE_H + GAP)),
					Size = UDim2.fromOffset(NODE_W, NODE_H),
					BackgroundColor3 = Theme.Color.Card,
					Parent = area,
					Activated = function()
						local st, reason = nodeState(def)
						if st == "available" then
							local res = Net.request("StartResearch", def.id)
							if res.ok then
								Sounds.play("Success", 1.2)
							elseif res.err then
								Notifications.show(res.err, "bad")
							end
						elseif reason then
							Notifications.show(reason, "info")
						end
					end,
				}, { Lib.corner(8), Lib.stroke(), Lib.pad(7, 9) })
				Lib.text({ Text = def.name, FontFace = Theme.Font.Bold, TextSize = Theme.TextSize.Small, Size = UDim2.new(1, 0, 0, 18), Parent = btn })
				Lib.text({ Text = def.desc, TextSize = Theme.TextSize.Tiny, TextColor3 = Theme.Color.Muted, TextWrapped = true, TextYAlignment = Enum.TextYAlignment.Top, Position = UDim2.fromOffset(0, 18), Size = UDim2.new(1, 0, 0, 28), Parent = btn })
				Lib.text({
					Text = ("%s RP · %s · %s"):format(Format.short(def.rp), Format.cash(def.cash), Format.duration(def.time)),
					TextSize = Theme.TextSize.Tiny,
					TextColor3 = Theme.Color.Time,
					FontFace = Theme.Font.Bold,
					Position = UDim2.fromOffset(0, 46),
					Size = UDim2.new(1, 0, 0, 14),
					Parent = btn,
				})
				local status = Lib.text({ Text = "", TextSize = Theme.TextSize.Tiny, FontFace = Theme.Font.Bold, Position = UDim2.fromOffset(0, 62), Size = UDim2.new(1, 0, 0, 14), Parent = btn })
				local bar = Lib.progress({ Position = UDim2.new(0, 0, 1, -3), Size = UDim2.new(1, 0, 0, 3), Parent = btn })
				nodes[def.id] = { btn = btn, status = status, bar = bar }
				if def.id == focusId then
					local stroke = btn:FindFirstChildOfClass("UIStroke") :: UIStroke
					stroke.Color = Theme.Color.Gold
					stroke.Thickness = 2
				end
			end
		end
	end

	local function refresh()
		local d = ClientState.data
		rpLabel.Text = ("%s  (+%s/m)"):format(Format.short(d.rp or 0), Format.short(d.rpRate or 0))
		hitsLabel.Text = Format.commas(((d.stats or {}).Hits) or 0)
		local active = d.research
		local now = Lib.serverNow()
		if active then
			local def = Research.get(active.id)
			activeName.Text = def and def.name or active.id
			local frac = (now - active.startAt) / math.max(1, active.finishAt - active.startAt)
			activeBar.set(frac, Theme.Color.Accent)
			activeTime.Text = Format.duration(active.finishAt - now) .. " left"
		else
			activeName.Text = "Nothing - pick a project below"
			activeBar.set(0)
			activeTime.Text = (d.rpRate or 0) <= 0 and "Build a Research Lab (Military > Research) to earn RP" or ""
		end
		for id, n in nodes do
			local def = Research.get(id)
			if def then
				local st, reason = nodeState(def)
				local stroke = n.btn:FindFirstChildOfClass("UIStroke") :: UIStroke
				if st == "done" then
					Lib.setButtonColor(n.btn, Theme.Color.GoodSoft)
					n.status.Text = "RESEARCHED"
					n.status.TextColor3 = Theme.Color.Good
					n.bar.frame.Visible = false
				elseif st == "active" and active then
					Lib.setButtonColor(n.btn, Theme.Color.AccentSoft)
					n.status.Text = "IN PROGRESS"
					n.status.TextColor3 = Theme.Color.Accent
					n.bar.frame.Visible = true
					n.bar.set((now - active.startAt) / math.max(1, active.finishAt - active.startAt), Theme.Color.Accent)
				elseif st == "available" then
					Lib.setButtonColor(n.btn, Theme.Color.Card)
					local affordable = (d.rp or 0) >= def.rp and (d.cash or 0) >= def.cash
					n.status.Text = d.research and "WAIT FOR CURRENT PROJECT" or (affordable and "CLICK TO RESEARCH" or "NOT ENOUGH RP / CASH")
					n.status.TextColor3 = affordable and Theme.Color.Teal or Theme.Color.Amber
					n.bar.frame.Visible = false
					if stroke.Color ~= Theme.Color.Gold then
						stroke.Color = Theme.Color.Teal
					end
				else
					Lib.setButtonColor(n.btn, Theme.Color.CardAlt)
					n.status.Text = string.upper(reason or "LOCKED")
					n.status.TextColor3 = Theme.Color.Faint
					n.bar.frame.Visible = false
				end
			end
		end
	end

	refresh()
	local acc = 0
	local conn = RunService.Heartbeat:Connect(function(dt)
		acc += dt
		if acc > 0.5 then
			acc = 0
			refresh()
		end
	end)
	win.onClose(function()
		conn:Disconnect()
	end)
end

function ResearchUI.init()
	Hub.openResearch = ResearchUI.open
end

return ResearchUI
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="57">
            <Properties>
              <string name="Name">RewardsUI</string>
              <string name="Source"><![CDATA[--[[
	RewardsUI
	Daily login streak, codes + group reward, and the welcome-back popup
	that shows offline earnings.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage.Shared
local Config = require(Shared.Config)
local Format = require(Shared.Util.Format)
local Net = require(Shared.Net)

local Client = script.Parent.Parent
local ClientState = require(Client.ClientState)
local Hub = require(Client.Hub)
local Lib = require(Client.UI.Lib)
local Theme = require(Client.UI.Theme)
local Icons = require(Client.UI.Icons)
local Modal = require(script.Parent.Modal)
local Notifications = require(script.Parent.Notifications)
local Sounds = require(script.Parent.Sounds)

local New = Lib.New

local RewardsUI = {}

function RewardsUI.openDaily()
	local win = Modal.open("Daily Rewards", "Log in every day to build your streak", 760, 360)
	local ic = Icons.calendar(38, Theme.Color.Military)
	ic.Position = UDim2.fromOffset(6, 4)
	ic.Parent = win.iconHolder
	local daily = ClientState.get("daily") or { streak = 0, canClaim = false, next = 1, reward = 0 }
	local row = New("Frame", { BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 150), Parent = win.body }, { Lib.list("x", 8) })
	local nextDay = ((daily.next - 1) % #Config.DailyRewards) + 1
	local currentDay = ((math.max(daily.streak, 1) - 1) % #Config.DailyRewards) + 1
	for i, base in Config.DailyRewards do
		local isNext = daily.canClaim and i == nextDay
		local claimed = (not daily.canClaim and i <= currentDay and daily.streak > 0) or (daily.canClaim and i < nextDay)
		local card = Lib.card({
			Size = UDim2.new(1 / #Config.DailyRewards, -7, 1, 0),
			BackgroundColor3 = isNext and Theme.Color.GoldSoft or (claimed and Theme.Color.GoodSoft or Theme.Color.Card),
			LayoutOrder = i,
			Parent = row,
		}, { Lib.pad(10, 8) })
		if isNext then
			local stroke = card:FindFirstChildOfClass("UIStroke") :: UIStroke
			stroke.Color = Theme.Color.Gold
			stroke.Thickness = 2
		end
		Lib.caption("Day " .. i, { TextXAlignment = Enum.TextXAlignment.Center, Parent = card })
		local gift = Icons.gift(40, i == 7 and Theme.Color.Gold or Theme.Color.Military)
		gift.AnchorPoint = Vector2.new(0.5, 0)
		gift.Position = UDim2.new(0.5, 0, 0, 24)
		gift.Parent = card
		Lib.text({
			Text = i == nextDay and daily.canClaim and Format.cash(daily.reward) or Format.cash(base) .. "+",
			FontFace = Theme.Font.Bold,
			TextSize = Theme.TextSize.Small,
			TextColor3 = Theme.Color.Good,
			TextXAlignment = Enum.TextXAlignment.Center,
			Position = UDim2.fromOffset(0, 76),
			Size = UDim2.new(1, 0, 0, 18),
			Parent = card,
		})
		Lib.text({
			Text = claimed and "CLAIMED" or (isNext and "TODAY" or ""),
			FontFace = Theme.Font.Bold,
			TextSize = Theme.TextSize.Tiny,
			TextColor3 = claimed and Theme.Color.Good or Theme.Color.Amber,
			TextXAlignment = Enum.TextXAlignment.Center,
			Position = UDim2.fromOffset(0, 100),
			Size = UDim2.new(1, 0, 0, 14),
			Parent = card,
		})
	end
	Lib.button({
		Text = daily.canClaim and ("Claim " .. Format.cash(daily.reward)) or "Come back tomorrow",
		FontFace = Theme.Font.Bold,
		TextSize = Theme.TextSize.Body,
		TextColor3 = Color3.new(1, 1, 1),
		BackgroundColor3 = daily.canClaim and Theme.Color.Good or Theme.Color.Faint,
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0, 166),
		Size = UDim2.fromOffset(260, 44),
		Parent = win.body,
		Activated = function()
			local res = Net.request("ClaimDaily")
			if res.ok then
				Sounds.play("Success")
				Modal.close()
			elseif res.err then
				Notifications.show(res.err, "info")
			end
		end,
	}, { Lib.corner(8) })
	Lib.text({
		Text = ("Current streak: %d day%s. Rewards grow with your income."):format(daily.streak, daily.streak == 1 and "" or "s"),
		TextColor3 = Theme.Color.Muted,
		TextSize = Theme.TextSize.Small,
		TextXAlignment = Enum.TextXAlignment.Center,
		Position = UDim2.fromOffset(0, 220),
		Size = UDim2.new(1, 0, 0, 18),
		Parent = win.body,
	})
end

function RewardsUI.openCodes()
	local win = Modal.open("Codes & Rewards", "Redeem codes from our socials", 520, 360)
	local ic = Icons.ticket(38, Theme.Color.Civil)
	ic.Position = UDim2.fromOffset(6, 4)
	ic.Parent = win.iconHolder
	local box = New("TextBox", {
		Text = "",
		PlaceholderText = "Enter code",
		FontFace = Theme.Font.Bold,
		TextSize = Theme.TextSize.Title,
		TextColor3 = Theme.Color.Text,
		BackgroundColor3 = Color3.new(1, 1, 1),
		ClearTextOnFocus = false,
		Size = UDim2.new(1, -150, 0, 46),
		Parent = win.body,
	}, { Lib.corner(8), Lib.stroke(), Lib.pad(0, 12) })
	Lib.button({
		Text = "Redeem",
		FontFace = Theme.Font.Bold,
		TextSize = Theme.TextSize.Body,
		TextColor3 = Color3.new(1, 1, 1),
		BackgroundColor3 = Theme.Color.Accent,
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.new(1, 0, 0, 0),
		Size = UDim2.fromOffset(140, 46),
		Parent = win.body,
		Activated = function()
			local res = Net.request("RedeemCode", box.Text)
			if res.ok then
				Sounds.play("Success")
				box.Text = ""
			elseif res.err then
				Notifications.show(res.err, "bad")
			end
		end,
	}, { Lib.corner(8) })

	local group = Lib.card({ Position = UDim2.fromOffset(0, 66), Size = UDim2.new(1, 0, 0, 96), Parent = win.body }, { Lib.pad(12, 14) })
	Lib.text({ Text = "Group Reward", FontFace = Theme.Font.Bold, Size = UDim2.new(1, -160, 0, 22), Parent = group })
	local claimed = ClientState.get("groupClaimed") == true
	local hasGroup = (ClientState.get("groupId") or 0) ~= 0
	Lib.text({
		Text = hasGroup and ("Join our Roblox group for a free %s and updates."):format(Format.cash(Config.GroupRewardCash)) or "No group reward set up yet.",
		TextSize = Theme.TextSize.Small,
		TextColor3 = Theme.Color.Muted,
		TextWrapped = true,
		Position = UDim2.fromOffset(0, 24),
		Size = UDim2.new(1, -160, 0, 40),
		Parent = group,
	})
	Lib.button({
		Text = claimed and "CLAIMED" or "Claim",
		FontFace = Theme.Font.Bold,
		TextColor3 = claimed and Theme.Color.Good or Color3.new(1, 1, 1),
		BackgroundColor3 = claimed and Theme.Color.GoodSoft or Theme.Color.Good,
		AnchorPoint = Vector2.new(1, 0.5),
		Position = UDim2.new(1, 0, 0.5, 0),
		Size = UDim2.fromOffset(140, 40),
		Parent = group,
		Activated = function()
			if claimed or not hasGroup then
				return
			end
			local res = Net.request("ClaimGroup")
			if res.ok then
				Sounds.play("Success")
				Modal.close()
			elseif res.err then
				Notifications.show(res.err, "info")
			end
		end,
	}, { Lib.corner(8) })
end

function RewardsUI.showWelcome(amount: number, away: number)
	task.wait(2) -- let the HUD settle first
	local win = Modal.open("Welcome back!", "Your nation kept working while you were away", 480, 300)
	local ic = Icons.coin(40, Theme.Color.Good)
	ic.Position = UDim2.fromOffset(6, 4)
	ic.Parent = win.iconHolder
	Lib.text({
		Text = ("You were away for %s"):format(Format.duration(away)),
		TextColor3 = Theme.Color.Muted,
		TextXAlignment = Enum.TextXAlignment.Center,
		Size = UDim2.new(1, 0, 0, 22),
		Parent = win.body,
	})
	Lib.text({
		Text = "+" .. Format.money(amount),
		FontFace = Theme.Font.Bold,
		TextSize = 40,
		TextColor3 = Theme.Color.Good,
		TextXAlignment = Enum.TextXAlignment.Center,
		Position = UDim2.fromOffset(0, 30),
		Size = UDim2.new(1, 0, 0, 50),
		Parent = win.body,
	})
	local vip = (ClientState.get("passes") or {}).VIP
	Lib.text({
		Text = vip and "VIP doubled your offline time!" or "VIP doubles offline time, 2x Cash doubles the amount.",
		TextSize = Theme.TextSize.Small,
		TextColor3 = Theme.Color.Muted,
		TextXAlignment = Enum.TextXAlignment.Center,
		Position = UDim2.fromOffset(0, 86),
		Size = UDim2.new(1, 0, 0, 18),
		Parent = win.body,
	})
	Lib.button({
		Text = "Collect",
		FontFace = Theme.Font.Bold,
		TextSize = Theme.TextSize.Body,
		TextColor3 = Color3.new(1, 1, 1),
		BackgroundColor3 = Theme.Color.Good,
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0, 120),
		Size = UDim2.fromOffset(220, 44),
		Parent = win.body,
		Activated = function()
			Sounds.play("Success")
			Modal.close()
		end,
	}, { Lib.corner(8) })
end

function RewardsUI.init()
	Hub.openDaily = RewardsUI.openDaily
	Hub.openCodes = RewardsUI.openCodes
	Hub.showWelcome = function(amount, away)
		task.spawn(RewardsUI.showWelcome, amount, away)
	end
end

return RewardsUI
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="58">
            <Properties>
              <string name="Name">ShopUI</string>
              <string name="Source"><![CDATA[--[[
	ShopUI
	The store: Featured (starter pack + best sellers), Passes, Cash and
	Boosts. Prices are fetched live from Roblox; cash packs show exactly how
	much they will give right now (they scale with your income).
]]

local MarketplaceService = game:GetService("MarketplaceService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Shared = ReplicatedStorage.Shared
local Config = require(Shared.Config)
local Products = require(Shared.Catalog.Products)
local Format = require(Shared.Util.Format)
local Net = require(Shared.Net)

local Client = script.Parent.Parent
local ClientState = require(Client.ClientState)
local Hub = require(Client.Hub)
local Lib = require(Client.UI.Lib)
local Theme = require(Client.UI.Theme)
local Icons = require(Client.UI.Icons)
local Modal = require(script.Parent.Modal)
local Notifications = require(script.Parent.Notifications)
local Sounds = require(script.Parent.Sounds)

local New = Lib.New

local ShopUI = {}

local player = Players.LocalPlayer
local priceCache: { [string]: number } = {}

local function livePrice(kind: string, id: number, fallback: number): number
	if id == 0 then
		return fallback
	end
	local key = kind .. id
	if priceCache[key] then
		return priceCache[key]
	end
	local ok, info = pcall(function()
		return MarketplaceService:GetProductInfo(id, kind == "pass" and Enum.InfoType.GamePass or Enum.InfoType.Product)
	end)
	if ok and info and info.PriceInRobux then
		priceCache[key] = info.PriceInRobux
		return info.PriceInRobux
	end
	return fallback
end

local function notConfigured()
	Notifications.show("This item isn't on sale yet (add its ID in Shared/Catalog/Products)", "bad")
end

function ShopUI.buyPass(key: string)
	local def = Products.pass(key)
	if not def then
		return
	end
	if (ClientState.get("passes") or {})[key] then
		Notifications.show("You already own " .. def.name, "info")
		return
	end
	if def.id ~= 0 then
		MarketplaceService:PromptGamePassPurchase(player, def.id)
	elseif RunService:IsStudio() and Config.StudioFreePurchases then
		Net.request("StudioPurchase", "pass", key)
	else
		notConfigured()
	end
end

function ShopUI.buyProduct(key: string)
	local def = Products.product(key)
	if not def then
		return
	end
	if def.oneTime and def.kind == "starter" and ClientState.get("starter") then
		Notifications.show("You already bought the Starter Pack", "info")
		return
	end
	if def.id ~= 0 then
		MarketplaceService:PromptProductPurchase(player, def.id)
	elseif RunService:IsStudio() and Config.StudioFreePurchases then
		Net.request("StudioPurchase", "product", key)
	else
		notConfigured()
	end
end

local function cashValue(def): number
	local gross = ClientState.get("gross") or 0
	return math.floor(math.max(def.minCash or 0, gross * ((def.minutes or 10) * 60 / Config.PayInterval)))
end

local function robuxButton(price: number, owned: boolean, onClick: () -> (), props: { [string]: any }?): TextButton
	local p = {
		Text = owned and "OWNED" or ("R$ " .. Format.commas(price)),
		FontFace = Theme.Font.Bold,
		TextSize = Theme.TextSize.Body,
		TextColor3 = owned and Theme.Color.Good or Color3.new(1, 1, 1),
		BackgroundColor3 = owned and Theme.Color.GoodSoft or Theme.Color.Good,
		Size = UDim2.new(1, 0, 0, 36),
		Activated = function()
			if not owned then
				Sounds.play("Open")
				onClick()
			end
		end,
	}
	if props then
		for k, v in props do
			p[k] = v
		end
	end
	return Lib.button(p, { Lib.corner(7) })
end

local function passCard(parent: Instance, def, order: number)
	local owned = (ClientState.get("passes") or {})[def.key] == true
	local card = Lib.card({ LayoutOrder = order, Parent = parent }, { Lib.pad(0) })
	local head = New("Frame", {
		BackgroundColor3 = def.color,
		Size = UDim2.new(1, 0, 0, 58),
		Parent = card,
	}, { Lib.corner(8), New("UIGradient", { Color = ColorSequence.new(Color3.new(1, 1, 1), Color3.fromRGB(200, 200, 200)), Rotation = 90 }) })
	New("Frame", { BackgroundColor3 = def.color, BorderSizePixel = 0, Position = UDim2.new(0, 0, 1, -8), Size = UDim2.new(1, 0, 0, 8), Parent = head })
	Lib.text({ Text = def.name, TextColor3 = Color3.new(1, 1, 1), FontFace = Theme.Font.Bold, TextSize = Theme.TextSize.Title, Position = UDim2.fromOffset(12, 6), Size = UDim2.new(1, -24, 0, 26), Parent = head })
	Lib.text({ Text = def.desc, TextColor3 = Color3.fromRGB(240, 240, 240), TextSize = Theme.TextSize.Tiny, Position = UDim2.fromOffset(12, 32), Size = UDim2.new(1, -24, 0, 16), Parent = head })
	local perks = New("Frame", { BackgroundTransparency = 1, Position = UDim2.fromOffset(12, 66), Size = UDim2.new(1, -24, 1, -116), Parent = card }, { Lib.list("y", 3) })
	for i, perk in def.perks do
		Lib.text({ Text = "•  " .. perk, TextSize = Theme.TextSize.Small, TextColor3 = Theme.Color.TextSoft, Size = UDim2.new(1, 0, 0, 18), LayoutOrder = i, Parent = perks })
	end
	local btnHolder = New("Frame", { BackgroundTransparency = 1, Position = UDim2.new(0, 12, 1, -46), Size = UDim2.new(1, -24, 0, 36), Parent = card })
	robuxButton(livePrice("pass", def.id, def.robux), owned, function()
		ShopUI.buyPass(def.key)
	end).Parent = btnHolder
end

local function productCard(parent: Instance, def, order: number, valueText: string?)
	local card = Lib.card({ LayoutOrder = order, Parent = parent }, { Lib.pad(12) })
	if def.tag then
		Lib.chip(def.tag, Theme.Color.GoldSoft, Theme.Color.Amber, { AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, 0, 0, 0), Parent = card })
	end
	Lib.text({ Text = def.name, FontFace = Theme.Font.Bold, TextSize = Theme.TextSize.Body, Size = UDim2.new(1, -90, 0, 22), Parent = card })
	Lib.text({ Text = def.desc, TextSize = Theme.TextSize.Small, TextColor3 = Theme.Color.Muted, TextWrapped = true, TextYAlignment = Enum.TextYAlignment.Top, Position = UDim2.fromOffset(0, 24), Size = UDim2.new(1, 0, 0, 34), Parent = card })
	if valueText then
		Lib.text({ Text = valueText, FontFace = Theme.Font.Bold, TextSize = Theme.TextSize.Big, TextColor3 = Theme.Color.Good, Position = UDim2.fromOffset(0, 58), Size = UDim2.new(1, 0, 0, 30), Parent = card })
	end
	local holder = New("Frame", { BackgroundTransparency = 1, Position = UDim2.new(0, 0, 1, -36), Size = UDim2.new(1, 0, 0, 36), Parent = card })
	robuxButton(livePrice("product", def.id, def.robux), false, function()
		ShopUI.buyProduct(def.key)
	end).Parent = holder
end

local function starterHero(parent: Instance, order: number)
	local def = Products.product("StarterPack")
	if not def or ClientState.get("starter") then
		return
	end
	local hero = New("Frame", {
		BackgroundColor3 = Color3.new(1, 1, 1),
		Size = UDim2.new(1, -6, 0, 132),
		LayoutOrder = order,
		Parent = parent,
	}, {
		Lib.corner(10),
		New("UIGradient", { Color = ColorSequence.new(Color3.fromRGB(46, 120, 220), Color3.fromRGB(110, 70, 200)), Rotation = 0 }),
		Lib.pad(16, 20),
	})
	Lib.chip("ONE TIME OFFER", Color3.fromRGB(255, 220, 90), Color3.fromRGB(90, 60, 0), { Parent = hero })
	Lib.text({ Text = "Starter Pack", TextColor3 = Color3.new(1, 1, 1), FontFace = Theme.Font.Bold, TextSize = 28, Position = UDim2.fromOffset(0, 26), Size = UDim2.new(0.6, 0, 0, 34), Parent = hero })
	Lib.text({ Text = "$150,000  ·  10 SRBM missiles  ·  30 min of 2x cash", TextColor3 = Color3.fromRGB(230, 236, 255), TextSize = Theme.TextSize.Body, Position = UDim2.fromOffset(0, 62), Size = UDim2.new(0.65, 0, 0, 20), Parent = hero })
	Lib.text({ Text = "Worth over 10x the Robux of a cash pack", TextColor3 = Color3.fromRGB(255, 226, 120), FontFace = Theme.Font.Bold, TextSize = Theme.TextSize.Small, Position = UDim2.fromOffset(0, 84), Size = UDim2.new(0.65, 0, 0, 18), Parent = hero })
	robuxButton(livePrice("product", def.id, def.robux), false, function()
		ShopUI.buyProduct("StarterPack")
	end, {
		AnchorPoint = Vector2.new(1, 0.5),
		Position = UDim2.new(1, 0, 0.5, 0),
		Size = UDim2.fromOffset(170, 48),
		BackgroundColor3 = Color3.fromRGB(255, 196, 40),
		TextColor3 = Color3.fromRGB(60, 40, 0),
		TextSize = 20,
		Parent = hero,
	})
end

local TABS = { "Featured", "Passes", "Cash", "Boosts" }

function ShopUI.open(tabName: string?)
	local current = tabName or "Featured"
	local win = Modal.open("Store", "Support the game and grow faster", 920, 640)
	local ic = Icons.cart(38, Theme.Color.Gold)
	ic.Position = UDim2.fromOffset(6, 4)
	ic.Parent = win.iconHolder

	local tabs = New("Frame", { BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 34), Parent = win.body }, { Lib.list("x", 8) })
	local content = New("ScrollingFrame", {
		BackgroundTransparency = 1,
		Position = UDim2.fromOffset(0, 44),
		Size = UDim2.new(1, 0, 1, -44),
		CanvasSize = UDim2.new(),
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
		ScrollBarThickness = 4,
		ScrollBarImageColor3 = Theme.Color.Faint,
		BorderSizePixel = 0,
		Parent = win.body,
	})

	local render
	local function renderTabs()
		Lib.clear(tabs)
		for i, t in TABS do
			Lib.button({
				Text = t,
				FontFace = Theme.Font.Semi,
				BackgroundColor3 = t == current and Theme.Color.TabActive or Theme.Color.Tab,
				Size = UDim2.fromOffset(110, 34),
				LayoutOrder = i,
				Parent = tabs,
				Activated = function()
					current = t
					renderTabs()
					render()
				end,
			}, { Lib.corner(6) })
		end
	end

	render = function()
		for _, c in content:GetChildren() do
			c:Destroy()
		end
		local function grid(cellH: number, cols: number, order: number): Frame
			return New("Frame", {
				BackgroundTransparency = 1,
				Size = UDim2.new(1, -6, 0, 0),
				AutomaticSize = Enum.AutomaticSize.Y,
				LayoutOrder = order,
				Parent = content,
			}, { Lib.grid(UDim2.new(1 / cols, -8, 0, cellH), 8) })
		end
		Lib.list("y", 12).Parent = content
		if current == "Featured" then
			starterHero(content, 1)
			local g = grid(250, 3, 2)
			for i, key in { "DoubleCash", "VIP", "FastBuild" } do
				local def = Products.pass(key)
				if def then
					passCard(g, def, i)
				end
			end
			local g2 = grid(150, 3, 3)
			for i, key in { "Cash3", "Boost2x", "SupplyDrop" } do
				local def = Products.product(key)
				if def then
					productCard(g2, def, i, def.kind == "cash" and ("+" .. Format.cash(cashValue(def))) or nil)
				end
			end
		elseif current == "Passes" then
			local g = grid(250, 3, 1)
			for i, def in Products.Passes do
				passCard(g, def, i)
			end
		elseif current == "Cash" then
			Lib.text({ Text = "Cash packs scale with your income - the bigger your nation, the more you get.", TextColor3 = Theme.Color.Muted, TextSize = Theme.TextSize.Small, Size = UDim2.new(1, 0, 0, 18), LayoutOrder = 0, Parent = content })
			local g = grid(160, 2, 1)
			local i = 0
			for _, def in Products.Developer do
				if def.kind == "cash" then
					i += 1
					productCard(g, def, i, "+" .. Format.cash(cashValue(def)))
				end
			end
		else
			local g = grid(150, 3, 1)
			local i = 0
			for _, def in Products.Developer do
				if def.kind ~= "cash" and def.kind ~= "starter" then
					i += 1
					productCard(g, def, i, nil)
				end
			end
		end
	end

	renderTabs()
	render()
	local unsubscribe = ClientState.onAny(function(patch)
		if patch.passes or patch.starter then
			render()
		end
	end)
	win.onClose(unsubscribe)
end

function ShopUI.init()
	Hub.openShop = ShopUI.open
	Hub.buyProduct = ShopUI.buyProduct
	Hub.buyPass = ShopUI.buyPass
	Net.event("PurchaseDone").OnClientEvent:Connect(function()
		Sounds.play("Success")
	end)
	-- warm the price cache so the store opens instantly
	task.spawn(function()
		for _, def in Products.Passes do
			livePrice("pass", def.id, def.robux)
		end
		for _, def in Products.Developer do
			livePrice("product", def.id, def.robux)
		end
	end)
end

return ShopUI
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="59">
            <Properties>
              <string name="Name">Sounds</string>
              <string name="Source"><![CDATA[--[[
	Sounds
	UI and world sounds. Uses sounds that ship with the Roblox client so the
	game works out of the box; swap any id for your own uploaded audio.
]]

local SoundService = game:GetService("SoundService")

local Sounds = {}

Sounds.Ids = {
	Click = "rbxasset://sounds/electronicpingshort.wav",
	Place = "rbxasset://sounds/snap.wav",
	Error = "rbxasset://sounds/clickfast.wav",
	Pay = "rbxasset://sounds/electronicpingshort.wav",
	Success = "rbxasset://sounds/victory.wav",
	Launch = "rbxasset://sounds/Rocket shot.wav",
	Whoosh = "rbxasset://sounds/swoosh.wav",
	Open = "rbxasset://sounds/button.wav",
}

local cache: { [string]: Sound } = {}

function Sounds.get(name: string): Sound
	local s = cache[name]
	if s then
		return s
	end
	local snd = Instance.new("Sound")
	snd.Name = name
	snd.SoundId = Sounds.Ids[name] or ""
	snd.Volume = name == "Click" and 0.25 or 0.5
	snd.Parent = SoundService
	cache[name] = snd
	return snd
end

function Sounds.play(name: string, pitch: number?)
	local s = Sounds.get(name)
	s.PlaybackSpeed = pitch or 1
	s:Play()
end

-- Positional one-shot (explosions, launches).
function Sounds.at(name: string, position: Vector3, volume: number?)
	local holder = Instance.new("Part")
	holder.Anchored = true
	holder.CanCollide = false
	holder.CanQuery = false
	holder.Transparency = 1
	holder.Size = Vector3.one
	holder.Position = position
	holder.Parent = workspace
	local snd = Instance.new("Sound")
	snd.SoundId = Sounds.Ids[name] or ""
	snd.Volume = volume or 0.8
	snd.RollOffMaxDistance = 1500
	snd.Parent = holder
	snd:Play()
	task.delay(6, function()
		holder:Destroy()
	end)
end

return Sounds
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="60">
            <Properties>
              <string name="Name">UnitView</string>
              <string name="Source"><![CDATA[--[[
	UnitView
	Nameplates over every vehicle (navy tag with a role icon and the unit
	name), health bars when damaged, and green selection boxes for the
	units you have selected.
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Units = require(ReplicatedStorage.Shared.Catalog.Units)

local Client = script.Parent.Parent
local Lib = require(Client.UI.Lib)
local Theme = require(Client.UI.Theme)
local Icons = require(Client.UI.Icons)

local New = Lib.New

local UnitView = {}

local player = Players.LocalPlayer
local selected: { [Model]: SelectionBox } = {}
local listeners: { () -> () } = {}

local NAVY = Color3.fromRGB(24, 40, 70)

local function roleIcon(role: string): string
	if role == "Artillery" then
		return "rocket"
	elseif role == "Capture" then
		return "truck"
	elseif role == "Anti-Air" then
		return "target"
	end
	return "tank"
end

local function decorate(model: Model)
	if not model:IsA("Model") or not model:GetAttribute("Unit") then
		return
	end
	local root = model:WaitForChild("Root", 5) :: BasePart?
	if not root then
		return
	end
	local def = Units.get(model:GetAttribute("UnitId") :: string)
	local mine = model:GetAttribute("OwnerId") == player.UserId
	local color = (model:GetAttribute("Color") :: Color3?) or Theme.Color.Accent

	local gui = New("BillboardGui", {
		Name = "Tag",
		Adornee = root,
		Size = UDim2.fromOffset(130, 40),
		StudsOffsetWorldSpace = Vector3.new(0, 5, 0),
		AlwaysOnTop = true,
		MaxDistance = 2600,
		LightInfluence = 0,
		Parent = model,
	})
	local tag = New("Frame", {
		BackgroundColor3 = NAVY,
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.fromScale(0.5, 0),
		Size = UDim2.fromOffset(0, 22),
		AutomaticSize = Enum.AutomaticSize.X,
		Parent = gui,
	}, {
		Lib.corner(5),
		Lib.stroke(Color3.new(1, 1, 1), 1.5, mine and 0 or 0.4),
		Lib.list("x", 6, nil, Enum.VerticalAlignment.Center),
		Lib.pad(0, 8, 0, 3),
	})
	local iconBox = New("Frame", {
		BackgroundColor3 = color,
		Size = UDim2.fromOffset(18, 16),
		LayoutOrder = 1,
		Parent = tag,
	}, { Lib.corner(3) })
	local ic = Icons.get(roleIcon(def and def.role or ""), 14, Color3.new(1, 1, 1))
	ic.AnchorPoint = Vector2.new(0.5, 0.5)
	ic.Position = UDim2.fromScale(0.5, 0.5)
	ic.Parent = iconBox
	Lib.text({
		Text = string.upper(def and def.name or model.Name),
		TextColor3 = Color3.new(1, 1, 1),
		FontFace = Theme.Font.Bold,
		TextSize = 12,
		AutomaticSize = Enum.AutomaticSize.X,
		Size = UDim2.new(0, 0, 1, 0),
		TextTruncate = Enum.TextTruncate.None,
		LayoutOrder = 2,
		Parent = tag,
	})
	local hpBar = Lib.progress({
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0, 26),
		Size = UDim2.fromOffset(70, 4),
		Visible = false,
		Parent = gui,
	})
	local function updateHp()
		local hp = (model:GetAttribute("Hp") :: number?) or 1
		local max = (model:GetAttribute("MaxHp") :: number?) or 1
		hpBar.frame.Visible = hp < max
		hpBar.set(hp / max, hp / max > 0.35 and Theme.Color.Good or Theme.Color.Bad)
	end
	model:GetAttributeChangedSignal("Hp"):Connect(updateHp)
	updateHp()
end

function UnitView.isSelected(model: Model): boolean
	return selected[model] ~= nil
end

function UnitView.select(model: Model, on: boolean)
	if on and not selected[model] then
		selected[model] = New("SelectionBox", {
			Adornee = model,
			Color3 = Color3.fromRGB(90, 230, 130),
			LineThickness = 0.08,
			SurfaceTransparency = 1,
			Parent = model,
		})
	elseif not on and selected[model] then
		selected[model]:Destroy()
		selected[model] = nil
	end
	for _, fn in listeners do
		task.spawn(fn)
	end
end

function UnitView.clear()
	for m, box in selected do
		box:Destroy()
		selected[m] = nil
	end
	for _, fn in listeners do
		task.spawn(fn)
	end
end

function UnitView.selectedUids(): { number }
	local out = {}
	for m in selected do
		if m.Parent then
			table.insert(out, m:GetAttribute("Uid") :: number)
		else
			selected[m] = nil
		end
	end
	return out
end

function UnitView.count(): number
	local c = 0
	for m in selected do
		if m.Parent then
			c += 1
		end
	end
	return c
end

function UnitView.onSelectionChanged(fn: () -> ())
	table.insert(listeners, fn)
end

-- Your own unit models.
function UnitView.mine(): { Model }
	local out = {}
	local folder = workspace:FindFirstChild("Units")
	if folder then
		for _, m in folder:GetChildren() do
			if m:IsA("Model") and m:GetAttribute("OwnerId") == player.UserId then
				table.insert(out, m)
			end
		end
	end
	return out
end

function UnitView.init()
	local folder = workspace:WaitForChild("Units")
	folder.ChildAdded:Connect(function(m)
		task.defer(decorate, m)
	end)
	folder.ChildRemoved:Connect(function(m)
		if selected[m :: Model] then
			selected[m :: Model] = nil
			for _, fn in listeners do
				task.spawn(fn)
			end
		end
	end)
	for _, m in folder:GetChildren() do
		task.spawn(decorate, m)
	end
end

return UnitView
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="61">
            <Properties>
              <string name="Name">WarView</string>
              <string name="Source"><![CDATA[--[[
	WarView
	"Travel" opens the strategic view: a top-down camera over the mainland or
	any nation. From here you:
	  * pick a weapon in the hotbar (1-7) and click to launch at the reticle
	  * drag a box (or tap) to select your vehicles, right-click / tap to move
	  * watch strategic points ("AIRPORT · UNCAPTURED") and enemy nations
	WASD / arrows pan, scroll / pinch zoom, the hammer button returns home.
]]

local ContextActionService = game:GetService("ContextActionService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")

local Shared = ReplicatedStorage.Shared
local Config = require(Shared.Config)
local Grid = require(Shared.Util.Grid)
local Weapons = require(Shared.Catalog.Weapons)
local ModelBuilder = require(Shared.ModelBuilder)
local Unlocks = require(Shared.Util.Unlocks)
local Net = require(Shared.Net)

local Client = script.Parent.Parent
local ClientState = require(Client.ClientState)
local Hub = require(Client.Hub)
local Lib = require(Client.UI.Lib)
local Theme = require(Client.UI.Theme)
local Icons = require(Client.UI.Icons)
local Modal = require(script.Parent.Modal)
local Notifications = require(script.Parent.Notifications)
local Sounds = require(script.Parent.Sounds)
local UnitView = require(script.Parent.UnitView)

local New = Lib.New

local WarView = {}

local player = Players.LocalPlayer
local camera = workspace.CurrentCamera

local labelParent: Instance
local hotbar: Frame
local reticle: Frame
local hint: TextLabel
local selectBox: Frame
local blastRing: Part
local pointLabels: { [Instance]: BillboardGui } = {}
local plotLabels: { BillboardGui } = {}

local focus = Vector3.zero
local height = 620
local keys: { [Enum.KeyCode]: boolean } = {}
local selectedWeapon: string? = nil
local pointer = Vector2.zero
local boxStart: Vector2? = nil
local rmbStart: Vector2? = nil
local slots: { [string]: { btn: TextButton, count: TextLabel, sub: TextLabel } } = {}

local RETICLE = Color3.fromRGB(232, 150, 52)
local PAN_KEYS = {
	Enum.KeyCode.W,
	Enum.KeyCode.A,
	Enum.KeyCode.S,
	Enum.KeyCode.D,
	Enum.KeyCode.Up,
	Enum.KeyCode.Down,
	Enum.KeyCode.Left,
	Enum.KeyCode.Right,
}

---------------------------------------------------------------------------
-- Helpers
---------------------------------------------------------------------------
local function groundAt(screen: Vector2): Vector3?
	local ray = camera:ScreenPointToRay(screen.X, screen.Y)
	if math.abs(ray.Direction.Y) < 1e-4 then
		return nil
	end
	local t = -ray.Origin.Y / ray.Direction.Y
	if t < 0 then
		return nil
	end
	return ray.Origin + ray.Direction * t
end

local function access(): Unlocks.Access
	return { researched = ClientState.get("researched") or {}, passes = ClientState.get("passes") or {} }
end

local function availableWeapons()
	local out = {}
	local inv = ClientState.get("inventory") or {}
	for _, w in Weapons.all() do
		if Unlocks.check(w, access()) or (inv[w.id] or 0) > 0 then
			table.insert(out, w)
		end
	end
	return out
end

local function unitUnder(screen: Vector2): Model?
	-- generous screen-space pick: closest own unit within 28px
	local best, bestD = nil, 28
	for _, m in UnitView.mine() do
		local root = m.PrimaryPart
		if root then
			local sp, onScreen = camera:WorldToScreenPoint(root.Position)
			if onScreen then
				local d = (Vector2.new(sp.X, sp.Y) - screen).Magnitude
				if d < bestD then
					best, bestD = m, d
				end
			end
		end
	end
	return best
end

---------------------------------------------------------------------------
-- Hotbar
---------------------------------------------------------------------------
local function renderHotbar()
	Lib.clear(hotbar)
	table.clear(slots)
	local list = availableWeapons()
	hotbar.Visible = ClientState.mode == "war" and #list > 0
	for i, w in list do
		local btn = Lib.button({
			Name = w.id,
			Size = UDim2.fromOffset(66, 66),
			BackgroundColor3 = Theme.Color.Hud,
			BackgroundTransparency = 0.25,
			LayoutOrder = i,
			Parent = hotbar,
			Activated = function()
				WarView.selectWeapon(selectedWeapon ~= w.id and w.id or nil)
			end,
		}, { Lib.corner(8), Lib.stroke(Color3.new(1, 1, 1), 1, 0.8) })
		local art = New("Frame", { BackgroundTransparency = 1, Position = UDim2.fromOffset(4, 10), Size = UDim2.new(1, -8, 0, 36), Parent = btn })
		Lib.viewport(ModelBuilder.projectile(w), { Parent = art }, 90)
		local count = Lib.text({
			Text = "0",
			TextColor3 = Theme.Color.HudText,
			FontFace = Theme.Font.Bold,
			TextSize = Theme.TextSize.Tiny,
			AnchorPoint = Vector2.new(1, 0),
			Position = UDim2.new(1, -5, 0, 3),
			Size = UDim2.fromOffset(30, 12),
			TextXAlignment = Enum.TextXAlignment.Right,
			Parent = btn,
		})
		local sub = Lib.text({
			Text = w.short,
			TextColor3 = Theme.Color.HudMuted,
			FontFace = Theme.Font.Bold,
			TextSize = 10,
			Position = UDim2.new(0, 0, 1, -16),
			Size = UDim2.new(1, 0, 0, 12),
			TextXAlignment = Enum.TextXAlignment.Center,
			Parent = btn,
		})
		Lib.text({
			Text = tostring(i),
			TextColor3 = Theme.Color.HudMuted,
			TextSize = 10,
			Position = UDim2.fromOffset(5, 2),
			Size = UDim2.fromOffset(10, 12),
			Parent = btn,
		})
		slots[w.id] = { btn = btn, count = count, sub = sub }
	end
	WarView.refreshHotbar()
end

function WarView.refreshHotbar()
	local inv = ClientState.get("inventory") or {}
	local launchers = ClientState.get("launchers") or {}
	local now = Lib.serverNow()
	for id, s in slots do
		local w = Weapons.get(id)
		if w then
			s.count.Text = tostring(inv[id] or 0)
			local l = launchers[w.family]
			local stroke = s.btn:FindFirstChildOfClass("UIStroke") :: UIStroke
			local isSel = selectedWeapon == id
			stroke.Color = isSel and Theme.Color.Teal or Color3.new(1, 1, 1)
			stroke.Transparency = isSel and 0 or 0.8
			stroke.Thickness = isSel and 2 or 1
			if not l then
				s.sub.Text = "NO LAUNCHER"
			elseif l.ready == 0 and l.nextReady > now then
				s.sub.Text = ("RELOAD %ds"):format(math.ceil(l.nextReady - now))
			else
				s.sub.Text = w.short
			end
		end
	end
	if selectedWeapon and not slots[selectedWeapon] then
		WarView.selectWeapon(nil)
	end
end

function WarView.selectWeapon(id: string?)
	selectedWeapon = id
	reticle.Visible = id ~= nil
	blastRing.Parent = id and workspace or nil
	if id then
		local w = Weapons.get(id)
		if w then
			local d = w.radius * 2
			blastRing.Size = Vector3.new(0.3, d, d)
		end
		UnitView.clear()
		Sounds.play("Click", 1.3)
	end
	WarView.refreshHotbar()
	WarView.refreshHint()
end

function WarView.refreshHint()
	if selectedWeapon then
		local w = Weapons.get(selectedWeapon)
		hint.Text = ("%s selected · Click a target to launch · Right-click to cancel"):format(w and w.name or selectedWeapon)
	elseif UnitView.count() > 0 then
		hint.Text = ("%d units selected · Right-click (or tap) the ground to move · Esc to clear"):format(UnitView.count())
	else
		hint.Text = "WASD pan · Scroll zoom · 1-7 weapons · Drag to select vehicles"
	end
end

---------------------------------------------------------------------------
-- Labels for strategic points and nations
---------------------------------------------------------------------------
local function makePointLabel(point: Model)
	if pointLabels[point] then
		return
	end
	local base = point:WaitForChild("Base", 5) :: BasePart?
	if not base then
		return
	end
	local bb = New("BillboardGui", {
		Name = "PointLabel",
		Adornee = base,
		Size = UDim2.fromOffset(260, 56),
		StudsOffsetWorldSpace = Vector3.new(0, 24, 0),
		AlwaysOnTop = true,
		MaxDistance = 6000,
		LightInfluence = 0,
		Enabled = false,
		Parent = labelParent,
	})
	local title = Lib.text({
		Name = "Title",
		Text = "",
		TextColor3 = Color3.fromRGB(240, 240, 232),
		TextStrokeTransparency = 0.5,
		FontFace = Theme.Font.Semi,
		TextSize = 13,
		TextXAlignment = Enum.TextXAlignment.Center,
		Size = UDim2.new(1, 0, 0, 18),
		Parent = bb,
	})
	local bonus = Lib.text({
		Name = "Bonus",
		Text = point:GetAttribute("Bonus") :: string? or "",
		TextColor3 = Color3.fromRGB(200, 220, 180),
		TextStrokeTransparency = 0.6,
		TextSize = 11,
		TextXAlignment = Enum.TextXAlignment.Center,
		Position = UDim2.fromOffset(0, 17),
		Size = UDim2.new(1, 0, 0, 14),
		Parent = bb,
	})
	local garrison = Lib.progress({ AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.new(0.5, 0, 0, 36), Size = UDim2.fromOffset(120, 4), Parent = bb })
	local capture = Lib.progress({ AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.new(0.5, 0, 0, 44), Size = UDim2.fromOffset(120, 4), Parent = bb })
	local function update()
		local owner = (point:GetAttribute("Owner") :: number?) or 0
		local ownerName = (point:GetAttribute("OwnerName") :: string?) or ""
		local name = (point:GetAttribute("PointName") :: string?) or point.Name
		local status
		if owner == 0 then
			status = "UNCAPTURED"
		elseif owner == player.UserId then
			status = "YOURS"
		else
			status = string.upper(ownerName)
		end
		if point:GetAttribute("Contested") then
			status ..= " · CONTESTED"
		end
		title.Text = ("%s  ·  %s"):format(name, status)
		title.TextColor3 = owner == player.UserId and Color3.fromRGB(140, 230, 160) or Color3.fromRGB(240, 240, 232)
		local g = (point:GetAttribute("Garrison") :: number?) or 0
		local gm = (point:GetAttribute("MaxGarrison") :: number?) or 1
		garrison.set(g / gm, Theme.Color.Bad)
		local c = (point:GetAttribute("Capture") :: number?) or 0
		capture.frame.Visible = c > 0
		capture.set(c / 100, Theme.Color.Good)
		bonus.Text = ((point:GetAttribute("Bonus") :: string?) or "") .. ("  ·  garrison %d"):format(g)
	end
	point.AttributeChanged:Connect(update)
	update()
	pointLabels[point] = bb
end

local function makePlotLabels()
	local homeland = workspace:WaitForChild("Homeland")
	for i = 1, Config.MaxPlots do
		local plot = homeland:WaitForChild("Plot_" .. i, 10)
		if plot then
			local ground = plot:FindFirstChild("Ground") :: BasePart?
			local bb = New("BillboardGui", {
				Name = "NationLabel",
				Adornee = ground,
				Size = UDim2.fromOffset(300, 40),
				StudsOffsetWorldSpace = Vector3.new(0, 60, 0),
				AlwaysOnTop = true,
				MaxDistance = 8000,
				LightInfluence = 0,
				Enabled = false,
				Parent = labelParent,
			})
			local label = Lib.text({
				Text = "",
				TextColor3 = Color3.new(1, 1, 1),
				TextStrokeTransparency = 0.4,
				FontFace = Theme.Font.Bold,
				TextSize = 16,
				TextXAlignment = Enum.TextXAlignment.Center,
				Size = UDim2.fromScale(1, 1),
				Parent = bb,
			})
			local function update()
				local owner = plot:GetAttribute("OwnerId") :: number?
				local p = owner and Players:GetPlayerByUserId(owner)
				if not p then
					label.Text = ""
					return
				end
				local pvp = p:GetAttribute("Pvp") == true
				label.Text = ("%s%s  ·  PVP %s"):format(p == player and "YOUR NATION - " or "", string.upper(p.DisplayName), pvp and "ON" or "OFF")
				label.TextColor3 = pvp and Color3.fromRGB(255, 170, 160) or Color3.fromRGB(220, 230, 240)
			end
			plot:GetAttributeChangedSignal("OwnerId"):Connect(update)
			task.spawn(function()
				while bb.Parent do
					update()
					task.wait(2)
				end
			end)
			table.insert(plotLabels, bb)
		end
	end
end

local function setLabels(on: boolean)
	for _, bb in pointLabels do
		bb.Enabled = on
	end
	for _, bb in plotLabels do
		bb.Enabled = on
	end
end

---------------------------------------------------------------------------
-- Camera
---------------------------------------------------------------------------
local function panHandler(_action: string, state: Enum.UserInputState, input: InputObject): Enum.ContextActionResult
	keys[input.KeyCode] = state == Enum.UserInputState.Begin or state == Enum.UserInputState.Change
	return Enum.ContextActionResult.Sink
end

local function updateCamera(dt: number)
	if ClientState.mode ~= "war" then
		return
	end
	local move = Vector3.zero
	if keys[Enum.KeyCode.W] or keys[Enum.KeyCode.Up] then
		move += Vector3.new(0, 0, -1)
	end
	if keys[Enum.KeyCode.S] or keys[Enum.KeyCode.Down] then
		move += Vector3.new(0, 0, 1)
	end
	if keys[Enum.KeyCode.A] or keys[Enum.KeyCode.Left] then
		move += Vector3.new(-1, 0, 0)
	end
	if keys[Enum.KeyCode.D] or keys[Enum.KeyCode.Right] then
		move += Vector3.new(1, 0, 0)
	end
	if move.Magnitude > 0 then
		focus += move.Unit * height * 1.3 * dt
	end
	focus = Vector3.new(math.clamp(focus.X, -2600, 2600), 0, math.clamp(focus.Z, -800, 4600))
	local target = CFrame.lookAt(focus + Vector3.new(0, height, height * 0.22), focus)
	camera.CFrame = camera.CFrame:Lerp(target, math.min(1, dt * 10))

	-- reticle + blast ring
	if selectedWeapon then
		reticle.Position = UDim2.fromOffset(pointer.X, pointer.Y)
		local hit = groundAt(pointer)
		if hit then
			blastRing.CFrame = CFrame.new(hit.X, 0.3, hit.Z) * CFrame.Angles(0, 0, math.rad(90))
		end
	end
end

function WarView.go(target: string | number)
	Modal.close()
	Hub.call("closeBuild")
	if target == "mainland" then
		focus = Config.MainlandOrigin
		height = 900
	elseif type(target) == "number" then
		focus = Grid.plotOrigin(target)
		height = 520
	end
	if ClientState.mode ~= "war" then
		ClientState.setMode("war")
		camera.CameraType = Enum.CameraType.Scriptable
		ContextActionService:BindActionAtPriority("WarPan", panHandler, false, Enum.ContextActionPriority.High.Value + 10, table.unpack(PAN_KEYS))
		camera.CFrame = CFrame.lookAt(focus + Vector3.new(0, height, height * 0.22), focus)
	end
	setLabels(true)
	renderHotbar()
	WarView.refreshHint()
	hint.Visible = true
	Sounds.play("Whoosh")
end

function WarView.goHome()
	if ClientState.mode ~= "war" then
		return
	end
	ContextActionService:UnbindAction("WarPan")
	table.clear(keys)
	WarView.selectWeapon(nil)
	UnitView.clear()
	setLabels(false)
	hotbar.Visible = false
	hint.Visible = false
	selectBox.Visible = false
	camera.CameraType = Enum.CameraType.Custom
	local hum = player.Character and player.Character:FindFirstChildOfClass("Humanoid")
	if hum then
		camera.CameraSubject = hum
	end
	ClientState.setMode("play")
end

---------------------------------------------------------------------------
-- Travel menu
---------------------------------------------------------------------------
function WarView.openTravel()
	local win = Modal.open("Travel", "Choose where to look. Launch strikes and command units from the map.", 520, 520)
	local ic = Icons.map(38, Theme.Color.Accent)
	ic.Position = UDim2.fromOffset(6, 4)
	ic.Parent = win.iconHolder
	local list = New("ScrollingFrame", {
		BackgroundTransparency = 1,
		Size = UDim2.fromScale(1, 1),
		CanvasSize = UDim2.new(),
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
		ScrollBarThickness = 4,
		BorderSizePixel = 0,
		Parent = win.body,
	}, { Lib.list("y", 8) })
	local function entry(order: number, title: string, sub: string, chipText: string?, chipBad: boolean?, onClick: () -> ())
		local btn = Lib.button({ Size = UDim2.new(1, -6, 0, 58), LayoutOrder = order, Parent = list, Activated = onClick }, { Lib.corner(8), Lib.stroke(), Lib.pad(8, 14) })
		Lib.text({ Text = title, FontFace = Theme.Font.Bold, Size = UDim2.new(1, -120, 0, 22), Parent = btn })
		Lib.text({ Text = sub, TextSize = Theme.TextSize.Small, TextColor3 = Theme.Color.Muted, Position = UDim2.fromOffset(0, 22), Size = UDim2.new(1, -120, 0, 18), Parent = btn })
		if chipText then
			Lib.chip(chipText, chipBad and Theme.Color.BadSoft or Theme.Color.GoodSoft, chipBad and Theme.Color.Bad or Theme.Color.Good, {
				AnchorPoint = Vector2.new(1, 0.5),
				Position = UDim2.new(1, 0, 0.5, 0),
				Parent = btn,
			})
		end
	end
	entry(1, "Mainland - War Map", "Capture strategic points for big bonuses", "WARZONE", true, function()
		WarView.go("mainland")
	end)
	entry(2, "Your Nation (overview)", "Command units and watch your city from above", nil, nil, function()
		WarView.go(ClientState.get("plot") or 1)
	end)
	entry(3, "Your Nation (walk)", "Back to your character", nil, nil, function()
		Modal.close()
		WarView.goHome()
	end)
	local order = 10
	for _, p in Players:GetPlayers() do
		if p ~= player then
			local idx = p:GetAttribute("PlotIndex") :: number?
			if idx then
				order += 1
				local pvp = p:GetAttribute("Pvp") == true
				entry(order, p.DisplayName .. "'s Nation", pvp and "PvP ON - can be attacked" or "PvP OFF - can't be attacked", pvp and "PVP ON" or "PVP OFF", pvp, function()
					WarView.go(idx)
				end)
			end
		end
	end
end

---------------------------------------------------------------------------
-- Input
---------------------------------------------------------------------------
local function launchAt(screen: Vector2)
	local id = selectedWeapon
	local hit = groundAt(screen)
	if not id or not hit then
		return
	end
	local res = Net.request("LaunchWeapon", id, hit)
	if res.ok then
		Sounds.play("Launch")
	elseif res.err then
		Notifications.show(res.err, "bad")
	end
end

local function commandAt(screen: Vector2)
	local uids = UnitView.selectedUids()
	local hit = groundAt(screen)
	if #uids == 0 or not hit then
		return
	end
	local res = Net.request("CommandUnits", uids, hit)
	if res.ok then
		Sounds.play("Click", 0.9)
		Hub.call("moveMarker", hit)
	elseif res.err then
		Notifications.show(res.err, "bad")
	end
end

local function finishBox(endPos: Vector2, additive: boolean)
	local start = boxStart
	boxStart = nil
	selectBox.Visible = false
	if not start then
		return
	end
	if (endPos - start).Magnitude < 6 then
		local unit = unitUnder(endPos)
		if unit then
			if not additive then
				UnitView.clear()
			end
			UnitView.select(unit, not UnitView.isSelected(unit))
		elseif UnitView.count() > 0 and UserInputService.TouchEnabled then
			commandAt(endPos) -- tap ground to move on touch devices
		else
			UnitView.clear()
		end
	else
		if not additive then
			UnitView.clear()
		end
		local minV = Vector2.new(math.min(start.X, endPos.X), math.min(start.Y, endPos.Y))
		local maxV = Vector2.new(math.max(start.X, endPos.X), math.max(start.Y, endPos.Y))
		for _, m in UnitView.mine() do
			local root = m.PrimaryPart
			if root then
				-- WorldToScreenPoint is in GUI space, same as InputObject.Position
				local sp, onScreen = camera:WorldToScreenPoint(root.Position)
				local p = Vector2.new(sp.X, sp.Y)
				if onScreen and p.X >= minV.X and p.X <= maxV.X and p.Y >= minV.Y and p.Y <= maxV.Y then
					UnitView.select(m, true)
				end
			end
		end
	end
	WarView.refreshHint()
end

local function onInputBegan(input: InputObject, processed: boolean)
	if ClientState.mode ~= "war" then
		return
	end
	local t = input.UserInputType
	if t == Enum.UserInputType.MouseButton1 or t == Enum.UserInputType.Touch then
		pointer = Vector2.new(input.Position.X, input.Position.Y)
		if processed then
			return
		end
		if selectedWeapon then
			launchAt(pointer)
		else
			boxStart = pointer
		end
	elseif t == Enum.UserInputType.MouseButton2 then
		rmbStart = Vector2.new(input.Position.X, input.Position.Y)
	elseif not processed and t == Enum.UserInputType.Keyboard then
		local n = input.KeyCode.Value - Enum.KeyCode.One.Value + 1
		if n >= 1 and n <= 9 then
			local list = availableWeapons()
			local w = list[n]
			if w then
				WarView.selectWeapon(selectedWeapon ~= w.id and w.id or nil)
			end
		elseif input.KeyCode == Enum.KeyCode.Escape then
			WarView.selectWeapon(nil)
			UnitView.clear()
			WarView.refreshHint()
		end
	end
end

local function onInputChanged(input: InputObject)
	if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then
		pointer = Vector2.new(input.Position.X, input.Position.Y)
		if boxStart and ClientState.mode == "war" and input.UserInputType == Enum.UserInputType.MouseMovement then
			local minV = Vector2.new(math.min(boxStart.X, pointer.X), math.min(boxStart.Y, pointer.Y))
			local size = Vector2.new(math.abs(pointer.X - boxStart.X), math.abs(pointer.Y - boxStart.Y))
			selectBox.Visible = size.Magnitude > 6
			selectBox.Position = UDim2.fromOffset(minV.X, minV.Y)
			selectBox.Size = UDim2.fromOffset(size.X, size.Y)
		end
	elseif input.UserInputType == Enum.UserInputType.MouseWheel and ClientState.mode == "war" then
		height = math.clamp(height * (1 - input.Position.Z * 0.12), 120, 1800)
	end
end

local function onInputEnded(input: InputObject)
	if ClientState.mode ~= "war" then
		return
	end
	local t = input.UserInputType
	local pos = Vector2.new(input.Position.X, input.Position.Y)
	if t == Enum.UserInputType.MouseButton1 or t == Enum.UserInputType.Touch then
		if boxStart then
			finishBox(pos, UserInputService:IsKeyDown(Enum.KeyCode.LeftShift))
		end
	elseif t == Enum.UserInputType.MouseButton2 and rmbStart then
		if (pos - rmbStart).Magnitude < 8 then
			if selectedWeapon then
				WarView.selectWeapon(nil)
			else
				commandAt(pos)
			end
		end
		rmbStart = nil
	end
end

---------------------------------------------------------------------------
-- Init
---------------------------------------------------------------------------
function WarView.init(screen: GuiObject)
	labelParent = player:WaitForChild("PlayerGui")
	hotbar = New("Frame", {
		Name = "Hotbar",
		AnchorPoint = Vector2.new(0.5, 1),
		Position = UDim2.new(0.5, 0, 1, -96),
		Size = UDim2.fromOffset(600, 66),
		BackgroundTransparency = 1,
		Visible = false,
		Parent = screen,
	}, { Lib.list("x", 6, Enum.HorizontalAlignment.Center) })

	reticle = New("Frame", {
		Name = "Reticle",
		AnchorPoint = Vector2.new(0.5, 0.5),
		Size = UDim2.fromOffset(46, 46),
		BackgroundTransparency = 1,
		Visible = false,
		Parent = screen,
	})
	for _, c in { { 0, 0 }, { 1, 0 }, { 0, 1 }, { 1, 1 } } do
		local corner = New("Frame", {
			AnchorPoint = Vector2.new(c[1], c[2]),
			Position = UDim2.fromScale(c[1], c[2]),
			Size = UDim2.fromOffset(12, 12),
			BackgroundTransparency = 1,
			Parent = reticle,
		})
		New("Frame", { BackgroundColor3 = RETICLE, BorderSizePixel = 0, Size = UDim2.fromOffset(12, 2), Position = UDim2.fromOffset(0, c[2] == 0 and 0 or 10), Parent = corner })
		New("Frame", { BackgroundColor3 = RETICLE, BorderSizePixel = 0, Size = UDim2.fromOffset(2, 12), Position = UDim2.fromOffset(c[1] == 0 and 0 or 10, 0), Parent = corner })
	end
	New("Frame", { BackgroundColor3 = RETICLE, AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5), Size = UDim2.fromOffset(4, 4), Parent = reticle }, { Lib.round() })

	selectBox = New("Frame", {
		Name = "SelectBox",
		BackgroundColor3 = Color3.fromRGB(90, 230, 130),
		BackgroundTransparency = 0.85,
		Visible = false,
		Parent = screen,
	}, { Lib.stroke(Color3.fromRGB(90, 230, 130), 1) })

	hint = Lib.text({
		Name = "Hint",
		Text = "",
		AnchorPoint = Vector2.new(0.5, 1),
		Position = UDim2.new(0.5, 0, 1, -168),
		Size = UDim2.fromOffset(700, 20),
		TextColor3 = Color3.new(1, 1, 1),
		TextStrokeTransparency = 0.5,
		TextSize = Theme.TextSize.Small,
		TextXAlignment = Enum.TextXAlignment.Center,
		Visible = false,
		Parent = screen,
	})

	blastRing = Instance.new("Part")
	blastRing.Name = "BlastRing"
	blastRing.Shape = Enum.PartType.Cylinder
	blastRing.Anchored = true
	blastRing.CanCollide = false
	blastRing.CanQuery = false
	blastRing.CanTouch = false
	blastRing.Material = Enum.Material.Neon
	blastRing.Color = RETICLE
	blastRing.Transparency = 0.72
	blastRing.CastShadow = false

	UserInputService.InputBegan:Connect(onInputBegan)
	UserInputService.InputChanged:Connect(onInputChanged)
	UserInputService.InputEnded:Connect(onInputEnded)
	UserInputService.TouchPinch:Connect(function(_positions, scale, _velocity, state)
		if ClientState.mode == "war" and state == Enum.UserInputState.Change then
			height = math.clamp(height / math.max(0.5, scale ^ 0.05), 120, 1800)
		end
	end)
	UserInputService.TouchPan:Connect(function(_positions, _translation, velocity, state)
		if ClientState.mode == "war" and not selectedWeapon and state == Enum.UserInputState.Change then
			boxStart = nil
			focus -= Vector3.new(velocity.X, 0, velocity.Y) * height * 0.00035
		end
	end)
	RunService.RenderStepped:Connect(updateCamera)

	ClientState.onAny(function(patch)
		if ClientState.mode ~= "war" then
			return
		end
		if patch.researched or patch.passes then
			renderHotbar()
		elseif patch.inventory or patch.launchers then
			WarView.refreshHotbar()
		end
	end)
	task.spawn(function()
		while true do
			task.wait(0.5)
			if ClientState.mode == "war" then
				WarView.refreshHotbar()
			end
		end
	end)
	UnitView.onSelectionChanged(WarView.refreshHint)

	-- labels
	task.spawn(function()
		local mainland = workspace:WaitForChild("Mainland")
		local points = mainland:WaitForChild("Points")
		for _, p in points:GetChildren() do
			task.spawn(makePointLabel, p :: Model)
		end
		points.ChildAdded:Connect(function(p)
			makePointLabel(p :: Model)
		end)
	end)
	task.spawn(makePlotLabels)

	Hub.openTravel = WarView.openTravel
	Hub.goWar = WarView.go
	Hub.goHome = WarView.goHome
end

return WarView
]]></string>
            </Properties>
          </Item>
        </Item>
        <Item class="ModuleScript" referent="62">
          <Properties>
            <string name="Name">Hub</string>
            <string name="Source"><![CDATA[--[[
	Hub
	A tiny registry so controllers can open each other's windows without
	requiring each other (avoids circular requires). Controllers assign
	functions here during init, e.g. Hub.openShop = function() ... end.
]]

local Hub: { [string]: any } = {}

function Hub.call(name: string, ...: any)
	local fn = Hub[name]
	if type(fn) == "function" then
		fn(...)
	else
		warn("[Hub] nothing registered for " .. name)
	end
end

return Hub
]]></string>
          </Properties>
        </Item>
        <Item class="LocalScript" referent="63">
          <Properties>
            <string name="Name">Main</string>
            <string name="Source"><![CDATA[--[[
	Forge & Frontline - client bootstrap.
	Creates the UI layers (auto-scaled from a 1600x900 design to any screen),
	then starts every controller.
]]

local Players = game:GetService("Players")
local TextChatService = game:GetService("TextChatService")

local Client = script.Parent
local Controllers = Client.Controllers
local ClientState = require(Client.ClientState)
local Lib = require(Client.UI.Lib)

local player = Players.LocalPlayer
local playerGui = player:WaitForChild("PlayerGui")
local camera = workspace.CurrentCamera

local DESIGN = Vector2.new(1600, 900)

-- One ScreenGui per layer, each with a scaled root frame so every
-- controller can lay out in "design pixels".
local roots: { Frame } = {}
local scales: { UIScale } = {}

local function layer(name: string, order: number): Frame
	local gui = Instance.new("ScreenGui")
	gui.Name = name
	gui.ResetOnSpawn = false
	gui.DisplayOrder = order
	gui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
	gui.Parent = playerGui
	local root = Instance.new("Frame")
	root.Name = "Root"
	root.BackgroundTransparency = 1
	root.Size = UDim2.fromScale(1, 1)
	root.Parent = gui
	local scale = Instance.new("UIScale")
	scale.Parent = root
	table.insert(roots, root)
	table.insert(scales, scale)
	return root
end

local hudLayer = layer("FF_HUD", 1)
local buildLayer = layer("FF_Build", 2)
local modalLayer = layer("FF_Modal", 5)
local toastLayer = layer("FF_Toasts", 8)

local function rescale()
	local vp = camera.ViewportSize
	local s = math.clamp(math.min(vp.X / DESIGN.X, vp.Y / DESIGN.Y), 0.5, 1.2)
	for i, root in roots do
		scales[i].Scale = s
		root.Size = UDim2.fromScale(1 / s, 1 / s)
	end
end
camera:GetPropertyChangedSignal("ViewportSize"):Connect(rescale)
rescale()

-- Controllers
local Sounds = require(Controllers.Sounds)
local Notifications = require(Controllers.Notifications)
local Modal = require(Controllers.Modal)
local HUD = require(Controllers.HUD)
local Placement = require(Controllers.Placement)
local BuildMenu = require(Controllers.BuildMenu)
local BuildingPanel = require(Controllers.BuildingPanel)
local ResearchUI = require(Controllers.ResearchUI)
local UnitView = require(Controllers.UnitView)
local WarView = require(Controllers.WarView)
local Effects = require(Controllers.Effects)
local Animator = require(Controllers.Animator)
local ShopUI = require(Controllers.ShopUI)
local RewardsUI = require(Controllers.RewardsUI)
local ArmyUI = require(Controllers.ArmyUI)

Lib.setClickSound(Sounds.get("Click"))

Notifications.init(toastLayer)
Modal.init(modalLayer)
HUD.init(hudLayer)
Placement.init()
BuildMenu.init(buildLayer)
BuildingPanel.init()
ResearchUI.init()
UnitView.init()
WarView.init(hudLayer)
Effects.init()
Animator.init()
ShopUI.init()
RewardsUI.init()
ArmyUI.init()

ClientState.start()

-- VIP chat tag
TextChatService.OnIncomingMessage = function(message: TextChatMessage)
	local props = Instance.new("TextChatMessageProperties")
	local source = message.TextSource
	if source then
		local p = Players:GetPlayerByUserId(source.UserId)
		if p and p:GetAttribute("VIP") then
			props.PrefixText = "<font color='#F5C542'>[VIP]</font> " .. message.PrefixText
		end
	end
	return props
end
]]></string>
          </Properties>
        </Item>
        <Item class="Folder" referent="64">
          <Properties>
            <string name="Name">UI</string>
          </Properties>
          <Item class="ModuleScript" referent="65">
            <Properties>
              <string name="Name">Icons</string>
              <string name="Source"><![CDATA[--[[
	Icons
	Simple flat icons drawn with Frames, so the UI needs zero uploaded images.
	Every icon is a transparent square Frame of `size` pixels.
]]

local Lib = require(script.Parent.Lib)
local Theme = require(script.Parent.Theme)

local New = Lib.New
local Icons = {}

local function box(size: number): Frame
	return New("Frame", {
		Name = "Icon",
		BackgroundTransparency = 1,
		Size = UDim2.fromOffset(size, size),
	})
end

local function rect(parent: Instance, x: number, y: number, w: number, h: number, color: Color3, rot: number?, radius: number?): Frame
	local f = New("Frame", {
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(x, y),
		Size = UDim2.fromScale(w, h),
		BackgroundColor3 = color,
		BorderSizePixel = 0,
		Rotation = rot or 0,
		Parent = parent,
	})
	if radius then
		New("UICorner", { CornerRadius = UDim.new(radius, 0), Parent = f })
	end
	return f
end

local function circle(parent: Instance, x: number, y: number, d: number, color: Color3): Frame
	return rect(parent, x, y, d, d, color, 0, 1)
end

local function ring(parent: Instance, x: number, y: number, d: number, color: Color3, thickness: number): Frame
	local f = rect(parent, x, y, d, d, color, 0, 1)
	f.BackgroundTransparency = 1
	New("UIStroke", { Color = color, Thickness = thickness, Parent = f })
	return f
end

function Icons.person(size: number, color: Color3): Frame
	local f = box(size)
	circle(f, 0.5, 0.3, 0.36, color)
	local body = rect(f, 0.5, 0.82, 0.7, 0.42, color, 0, 0.5)
	body.ClipsDescendants = true
	return f
end

function Icons.people(size: number, color: Color3): Frame
	local f = box(size)
	circle(f, 0.68, 0.3, 0.28, color).BackgroundTransparency = 0.35
	rect(f, 0.72, 0.74, 0.5, 0.36, color, 0, 0.5).BackgroundTransparency = 0.35
	circle(f, 0.38, 0.32, 0.32, color)
	rect(f, 0.36, 0.8, 0.6, 0.4, color, 0, 0.5)
	return f
end

function Icons.smile(size: number, color: Color3): Frame
	local f = box(size)
	ring(f, 0.5, 0.5, 0.82, color, math.max(1.5, size / 12))
	circle(f, 0.36, 0.4, 0.12, color)
	circle(f, 0.64, 0.4, 0.12, color)
	local mouthClip = New("Frame", {
		BackgroundTransparency = 1,
		ClipsDescendants = true,
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.fromScale(0.5, 0.56),
		Size = UDim2.fromScale(0.42, 0.18),
		Parent = f,
	})
	local m = New("Frame", {
		BackgroundTransparency = 1,
		AnchorPoint = Vector2.new(0.5, 1),
		Position = UDim2.fromScale(0.5, 1),
		Size = UDim2.fromScale(1, 2),
		Parent = mouthClip,
	})
	New("UICorner", { CornerRadius = UDim.new(1, 0), Parent = m })
	New("UIStroke", { Color = color, Thickness = math.max(1.5, size / 12), Parent = m })
	return f
end

function Icons.coin(size: number, color: Color3): Frame
	local f = box(size)
	Lib.text({
		Text = "$",
		Size = UDim2.fromScale(1, 1),
		TextScaled = true,
		FontFace = Theme.Font.Bold,
		TextColor3 = color,
		TextXAlignment = Enum.TextXAlignment.Center,
		Parent = f,
	})
	return f
end

function Icons.hammer(size: number, color: Color3): Frame
	local f = box(size)
	rect(f, 0.56, 0.58, 0.16, 0.72, color, 45, 0.4)
	rect(f, 0.36, 0.34, 0.56, 0.24, color, 45, 0.2)
	return f
end

function Icons.trash(size: number, color: Color3): Frame
	local f = box(size)
	rect(f, 0.5, 0.2, 0.7, 0.1, color, 0, 0.5)
	rect(f, 0.5, 0.12, 0.26, 0.08, color, 0, 0.5)
	local body = rect(f, 0.5, 0.6, 0.56, 0.62, color, 0, 0.15)
	body.BackgroundTransparency = 0
	return f
end

function Icons.close(size: number, color: Color3): Frame
	local f = box(size)
	rect(f, 0.5, 0.5, 0.9, 0.14, color, 45, 0.5)
	rect(f, 0.5, 0.5, 0.9, 0.14, color, -45, 0.5)
	return f
end

function Icons.house(size: number, color: Color3): Frame
	local f = box(size)
	local roofClip = New("Frame", {
		BackgroundTransparency = 1,
		ClipsDescendants = true,
		Position = UDim2.fromScale(0, 0),
		Size = UDim2.fromScale(1, 0.48),
		Parent = f,
	})
	rect(roofClip, 0.5, 1, 0.66, 1.38, color, 45, 0.1)
	rect(f, 0.5, 0.7, 0.66, 0.44, color, 0, 0.08)
	rect(f, 0.5, 0.78, 0.18, 0.28, Color3.new(1, 1, 1), 0, 0.2).BackgroundTransparency = 0.15
	return f
end

function Icons.helmet(size: number, color: Color3): Frame
	local f = box(size)
	local clip = New("Frame", {
		BackgroundTransparency = 1,
		ClipsDescendants = true,
		Position = UDim2.fromScale(0, 0.12),
		Size = UDim2.fromScale(1, 0.5),
		Parent = f,
	})
	rect(clip, 0.5, 1, 0.78, 1.56, color, 0, 1)
	rect(f, 0.5, 0.66, 0.96, 0.14, color, 0, 0.5)
	rect(f, 0.5, 0.82, 0.12, 0.2, color, 0, 0.5)
	return f
end

function Icons.flask(size: number, color: Color3): Frame
	local f = box(size)
	rect(f, 0.5, 0.24, 0.22, 0.36, color, 0, 0.15)
	circle(f, 0.5, 0.64, 0.62, color)
	rect(f, 0.5, 0.1, 0.36, 0.08, color, 0, 0.5)
	return f
end

function Icons.bolt(size: number, color: Color3): Frame
	local f = box(size)
	rect(f, 0.58, 0.3, 0.16, 0.5, color, 25, 0.2)
	rect(f, 0.5, 0.5, 0.42, 0.13, color, 0, 0.3)
	rect(f, 0.42, 0.7, 0.16, 0.5, color, 25, 0.2)
	return f
end

function Icons.drop(size: number, color: Color3): Frame
	local f = box(size)
	circle(f, 0.5, 0.62, 0.6, color)
	rect(f, 0.5, 0.42, 0.42, 0.42, color, 45, 0.1)
	return f
end

function Icons.barrel(size: number, color: Color3): Frame
	local f = box(size)
	rect(f, 0.5, 0.5, 0.6, 0.8, color, 0, 0.18)
	rect(f, 0.5, 0.36, 0.64, 0.07, Color3.new(1, 1, 1), 0, 0.5).BackgroundTransparency = 0.5
	rect(f, 0.5, 0.64, 0.64, 0.07, Color3.new(1, 1, 1), 0, 0.5).BackgroundTransparency = 0.5
	return f
end

function Icons.beam(size: number, color: Color3): Frame
	local f = box(size)
	rect(f, 0.5, 0.2, 0.8, 0.14, color, 0, 0.1)
	rect(f, 0.5, 0.8, 0.8, 0.14, color, 0, 0.1)
	rect(f, 0.5, 0.5, 0.16, 0.66, color, 0, 0.1)
	return f
end

function Icons.gift(size: number, color: Color3): Frame
	local f = box(size)
	rect(f, 0.5, 0.64, 0.72, 0.56, color, 0, 0.1)
	rect(f, 0.5, 0.36, 0.84, 0.16, color, 0, 0.15)
	rect(f, 0.5, 0.58, 0.12, 0.7, Color3.new(1, 1, 1), 0, 0).BackgroundTransparency = 0.25
	ring(f, 0.38, 0.18, 0.24, color, math.max(1.5, size / 14))
	ring(f, 0.62, 0.18, 0.24, color, math.max(1.5, size / 14))
	return f
end

function Icons.cart(size: number, color: Color3): Frame
	local f = box(size)
	rect(f, 0.54, 0.44, 0.62, 0.36, color, 0, 0.15)
	rect(f, 0.16, 0.2, 0.26, 0.1, color, 20, 0.5)
	circle(f, 0.34, 0.84, 0.18, color)
	circle(f, 0.72, 0.84, 0.18, color)
	return f
end

function Icons.calendar(size: number, color: Color3): Frame
	local f = box(size)
	rect(f, 0.5, 0.58, 0.8, 0.7, color, 0, 0.12)
	rect(f, 0.5, 0.66, 0.6, 0.38, Color3.new(1, 1, 1), 0, 0.08).BackgroundTransparency = 0.2
	rect(f, 0.32, 0.18, 0.1, 0.22, color, 0, 0.5)
	rect(f, 0.68, 0.18, 0.1, 0.22, color, 0, 0.5)
	return f
end

function Icons.tank(size: number, color: Color3): Frame
	local f = box(size)
	rect(f, 0.5, 0.7, 0.9, 0.26, color, 0, 0.5)
	rect(f, 0.46, 0.46, 0.44, 0.24, color, 0, 0.3)
	rect(f, 0.76, 0.4, 0.46, 0.08, color, 0, 0.5)
	return f
end

function Icons.truck(size: number, color: Color3): Frame
	local f = box(size)
	rect(f, 0.4, 0.5, 0.56, 0.4, color, 0, 0.1)
	rect(f, 0.8, 0.56, 0.24, 0.28, color, 0, 0.15)
	circle(f, 0.26, 0.8, 0.18, color)
	circle(f, 0.74, 0.8, 0.18, color)
	return f
end

function Icons.rocket(size: number, color: Color3): Frame
	local f = box(size)
	rect(f, 0.5, 0.5, 0.2, 0.7, color, 35, 0.5)
	rect(f, 0.33, 0.73, 0.1, 0.24, color, 35 + 90, 0.3)
	rect(f, 0.62, 0.8, 0.1, 0.24, color, 35, 0.3)
	return f
end

function Icons.target(size: number, color: Color3): Frame
	local f = box(size)
	ring(f, 0.5, 0.5, 0.8, color, math.max(1.5, size / 14))
	ring(f, 0.5, 0.5, 0.4, color, math.max(1.5, size / 14))
	circle(f, 0.5, 0.5, 0.12, color)
	return f
end

function Icons.map(size: number, color: Color3): Frame
	local f = box(size)
	circle(f, 0.5, 0.36, 0.56, color)
	rect(f, 0.5, 0.62, 0.32, 0.32, color, 45, 0.1)
	circle(f, 0.5, 0.36, 0.22, Color3.new(1, 1, 1))
	return f
end

function Icons.ticket(size: number, color: Color3): Frame
	local f = box(size)
	rect(f, 0.5, 0.5, 0.86, 0.52, color, -15, 0.12)
	circle(f, 0.12, 0.56, 0.2, Color3.new(1, 1, 1)).BackgroundTransparency = 0.6
	return f
end

function Icons.star(size: number, color: Color3): Frame
	local f = box(size)
	for i = 0, 4 do
		rect(f, 0.5, 0.52, 0.2, 0.86, color, i * 36, 0.2)
	end
	return f
end

function Icons.shield(size: number, color: Color3): Frame
	local f = box(size)
	rect(f, 0.5, 0.36, 0.72, 0.5, color, 0, 0.15)
	rect(f, 0.5, 0.6, 0.5, 0.5, color, 45, 0.15)
	return f
end

function Icons.undo(size: number, color: Color3): Frame
	local f = box(size)
	local arc = ring(f, 0.55, 0.55, 0.66, color, math.max(1.5, size / 9))
	local cover = rect(f, 0.3, 0.75, 0.42, 0.42, Color3.new(1, 1, 1), 0, 0)
	cover.BackgroundTransparency = 1
	rect(f, 0.24, 0.3, 0.32, 0.12, color, -40, 0.5)
	rect(f, 0.3, 0.42, 0.32, 0.12, color, 50, 0.5)
	local _ = arc
	return f
end

function Icons.get(name: string, size: number, color: Color3?): Frame
	local fn = (Icons :: any)[name]
	if type(fn) ~= "function" then
		fn = Icons.star
	end
	return fn(size, color or Theme.Color.Text)
end

return Icons
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="66">
            <Properties>
              <string name="Name">Lib</string>
              <string name="Source"><![CDATA[--[[
	Lib
	Tiny declarative UI helpers. Everything in the game UI is built in code
	with these, so the whole interface stays consistent and needs no assets.

	Lib.New("Frame", { Size = ..., Activated = function() end }, { children })
	  * function values on signal properties are connected
	  * children may be Instances or nested arrays
]]

local TweenService = game:GetService("TweenService")
local Workspace = game:GetService("Workspace")

local Theme = require(script.Parent.Theme)

local Lib = {}

local function applyChildren(parent: Instance, children: { any }?)
	if not children then
		return
	end
	for _, child in children do
		if typeof(child) == "Instance" then
			child.Parent = parent
		elseif type(child) == "table" then
			applyChildren(parent, child)
		end
	end
end

function Lib.New(className: string, props: { [string]: any }?, children: { any }?): any
	local inst = Instance.new(className)
	local parent = nil
	if props then
		for k, v in props do
			if k == "Parent" then
				parent = v
			elseif type(v) == "function" then
				((inst :: any)[k] :: RBXScriptSignal):Connect(v)
			else
				(inst :: any)[k] = v
			end
		end
	end
	applyChildren(inst, children)
	if parent then
		inst.Parent = parent
	end
	return inst
end

local New = Lib.New

function Lib.corner(r: number?): UICorner
	return New("UICorner", { CornerRadius = UDim.new(0, r or Theme.Radius.Card) })
end

function Lib.round(): UICorner
	return New("UICorner", { CornerRadius = UDim.new(1, 0) })
end

function Lib.stroke(color: Color3?, thickness: number?, transparency: number?): UIStroke
	return New("UIStroke", {
		Color = color or Theme.Color.CardStroke,
		Thickness = thickness or 1,
		Transparency = transparency or 0,
		ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
	})
end

function Lib.pad(t: number, r: number?, b: number?, l: number?): UIPadding
	return New("UIPadding", {
		PaddingTop = UDim.new(0, t),
		PaddingRight = UDim.new(0, r or t),
		PaddingBottom = UDim.new(0, b or t),
		PaddingLeft = UDim.new(0, l or r or t),
	})
end

function Lib.list(direction: string?, gap: number?, hAlign: Enum.HorizontalAlignment?, vAlign: Enum.VerticalAlignment?): UIListLayout
	return New("UIListLayout", {
		FillDirection = direction == "x" and Enum.FillDirection.Horizontal or Enum.FillDirection.Vertical,
		Padding = UDim.new(0, gap or 0),
		HorizontalAlignment = hAlign or Enum.HorizontalAlignment.Left,
		VerticalAlignment = vAlign or Enum.VerticalAlignment.Top,
		SortOrder = Enum.SortOrder.LayoutOrder,
	})
end

function Lib.grid(cell: UDim2, gap: number): UIGridLayout
	return New("UIGridLayout", {
		CellSize = cell,
		CellPadding = UDim2.fromOffset(gap, gap),
		SortOrder = Enum.SortOrder.LayoutOrder,
	})
end

-- Text label with theme defaults. props override anything.
function Lib.text(props: { [string]: any }, children: { any }?): TextLabel
	local p = {
		BackgroundTransparency = 1,
		FontFace = Theme.Font.Semi,
		TextColor3 = Theme.Color.Text,
		TextSize = Theme.TextSize.Body,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextYAlignment = Enum.TextYAlignment.Center,
		Size = UDim2.new(1, 0, 0, 20),
		TextTruncate = Enum.TextTruncate.AtEnd,
	}
	for k, v in props do
		p[k] = v
	end
	return New("TextLabel", p, children)
end

-- Small uppercase caption ("OIL STORED").
function Lib.caption(text: string, props: { [string]: any }?): TextLabel
	local p = {
		Text = string.upper(text),
		TextSize = Theme.TextSize.Tiny,
		TextColor3 = Theme.Color.Muted,
		FontFace = Theme.Font.Semi,
		Size = UDim2.new(1, 0, 0, 14),
	}
	if props then
		for k, v in props do
			p[k] = v
		end
	end
	return Lib.text(p)
end

local clickSound: Sound? = nil
function Lib.setClickSound(s: Sound)
	clickSound = s
end

-- Button with hover / press feedback.
function Lib.button(props: { [string]: any }, children: { any }?): TextButton
	local p = {
		AutoButtonColor = false,
		BackgroundColor3 = Theme.Color.Card,
		FontFace = Theme.Font.Semi,
		TextColor3 = Theme.Color.Text,
		TextSize = Theme.TextSize.Small,
		Text = "",
		Size = UDim2.fromOffset(120, 36),
	}
	local onClick = props.Activated
	for k, v in props do
		if k ~= "Activated" then
			p[k] = v
		end
	end
	local btn = New("TextButton", p, children) :: TextButton
	btn:SetAttribute("Base", btn.BackgroundColor3)
	local scale = New("UIScale", { Parent = btn })
	local function base(): Color3
		return (btn:GetAttribute("Base") :: Color3?) or btn.BackgroundColor3
	end
	btn.MouseEnter:Connect(function()
		TweenService:Create(btn, TweenInfo.new(0.12), { BackgroundColor3 = base():Lerp(Color3.new(1, 1, 1), 0.25) }):Play()
	end)
	btn.MouseLeave:Connect(function()
		TweenService:Create(btn, TweenInfo.new(0.12), { BackgroundColor3 = base() }):Play()
		TweenService:Create(scale, TweenInfo.new(0.1), { Scale = 1 }):Play()
	end)
	btn.MouseButton1Down:Connect(function()
		TweenService:Create(scale, TweenInfo.new(0.06), { Scale = 0.96 }):Play()
	end)
	btn.MouseButton1Up:Connect(function()
		TweenService:Create(scale, TweenInfo.new(0.1), { Scale = 1 }):Play()
	end)
	if onClick then
		btn.Activated:Connect(function(...)
			if clickSound then
				clickSound:Play()
			end
			onClick(...)
		end)
	end
	return btn
end

-- Set a button's resting colour (keeps hover logic correct).
function Lib.setButtonColor(btn: GuiButton, color: Color3)
	btn:SetAttribute("Base", color)
	btn.BackgroundColor3 = color
end

function Lib.panel(props: { [string]: any }, children: { any }?): Frame
	local p = {
		BackgroundColor3 = Theme.Color.Panel,
		BorderSizePixel = 0,
	}
	for k, v in props do
		p[k] = v
	end
	local f = New("Frame", p, children)
	Lib.corner(Theme.Radius.Panel).Parent = f
	Lib.stroke(Theme.Color.PanelStroke).Parent = f
	return f
end

function Lib.card(props: { [string]: any }, children: { any }?): Frame
	local p = {
		BackgroundColor3 = Theme.Color.Card,
		BorderSizePixel = 0,
	}
	for k, v in props do
		p[k] = v
	end
	local f = New("Frame", p, children)
	Lib.corner(Theme.Radius.Card).Parent = f
	Lib.stroke(Theme.Color.CardStroke).Parent = f
	return f
end

-- Soft drop shadow behind a frame (no image assets needed).
function Lib.shadow(target: GuiObject)
	local s = New("Frame", {
		Name = "Shadow",
		BackgroundColor3 = Theme.Color.Shadow,
		BackgroundTransparency = 0.82,
		Size = UDim2.new(1, 6, 1, 8),
		Position = UDim2.fromOffset(-3, 2),
		ZIndex = target.ZIndex - 1,
		BorderSizePixel = 0,
	}, { Lib.corner(Theme.Radius.Panel + 3) })
	s.Parent = target.Parent
	-- keep shadow glued to target
	local function sync()
		s.Size = UDim2.new(target.Size.X.Scale, target.Size.X.Offset + 6, target.Size.Y.Scale, target.Size.Y.Offset + 8)
		s.Position = UDim2.new(target.Position.X.Scale, target.Position.X.Offset - 3, target.Position.Y.Scale, target.Position.Y.Offset + 2)
		s.AnchorPoint = target.AnchorPoint
		s.Visible = target.Visible
	end
	sync()
	target:GetPropertyChangedSignal("Size"):Connect(sync)
	target:GetPropertyChangedSignal("Position"):Connect(sync)
	target:GetPropertyChangedSignal("Visible"):Connect(sync)
	return s
end

-- Coloured chip with text ("$12000", "48s", "Locked").
function Lib.chip(text: string, bg: Color3, fg: Color3, props: { [string]: any }?): Frame
	local label = Lib.text({
		Name = "Label",
		Text = text,
		TextColor3 = fg,
		TextSize = Theme.TextSize.Small,
		FontFace = Theme.Font.Bold,
		AutomaticSize = Enum.AutomaticSize.X,
		Size = UDim2.new(0, 0, 1, 0),
		TextXAlignment = Enum.TextXAlignment.Center,
		TextTruncate = Enum.TextTruncate.None,
	})
	local p = {
		BackgroundColor3 = bg,
		AutomaticSize = Enum.AutomaticSize.X,
		Size = UDim2.fromOffset(0, 22),
		BorderSizePixel = 0,
	}
	if props then
		for k, v in props do
			p[k] = v
		end
	end
	return New("Frame", p, { Lib.corner(Theme.Radius.Chip), Lib.pad(0, 8), label })
end

export type Progress = { frame: Frame, set: (number, Color3?) -> () }

function Lib.progress(props: { [string]: any }?): Progress
	local fill = New("Frame", {
		Name = "Fill",
		BackgroundColor3 = Theme.Color.Accent,
		Size = UDim2.fromScale(0, 1),
		BorderSizePixel = 0,
	}, { Lib.round() })
	local p = {
		BackgroundColor3 = Theme.Color.Track,
		Size = UDim2.new(1, 0, 0, 5),
		BorderSizePixel = 0,
		ClipsDescendants = true,
	}
	if props then
		for k, v in props do
			p[k] = v
		end
	end
	local frame = New("Frame", p, { Lib.round(), fill })
	return {
		frame = frame,
		set = function(frac: number, color: Color3?)
			frac = math.clamp(frac, 0, 1)
			fill.Size = UDim2.fromScale(frac, 1)
			fill.BackgroundColor3 = color or (frac >= 0.995 and Theme.Color.Amber or Theme.Color.Accent)
		end,
	}
end

-- 3D thumbnail of a model (build cards, panel headers).
function Lib.viewport(model: Model, props: { [string]: any }?, angle: number?): ViewportFrame
	local p = {
		BackgroundTransparency = 1,
		Size = UDim2.fromScale(1, 1),
		Ambient = Color3.fromRGB(190, 196, 206),
		LightColor = Color3.fromRGB(255, 252, 245),
		LightDirection = Vector3.new(-1, -2, -0.6),
	}
	if props then
		for k, v in props do
			p[k] = v
		end
	end
	local vp = New("ViewportFrame", p) :: ViewportFrame
	local clone = model:Clone()
	clone:PivotTo(CFrame.new())
	clone.Parent = vp
	local cf, size = clone:GetBoundingBox()
	local radius = size.Magnitude / 2
	local cam = Instance.new("Camera")
	cam.FieldOfView = 30
	local dir = (CFrame.Angles(0, math.rad(angle or 35), 0) * CFrame.Angles(math.rad(-32), 0, 0)).LookVector
	local dist = radius / math.sin(math.rad(cam.FieldOfView / 2)) * 0.92
	cam.CFrame = CFrame.lookAt(cf.Position - dir * dist, cf.Position)
	cam.Parent = vp
	vp.CurrentCamera = cam
	return vp
end

function Lib.tween(inst: Instance, time: number, props: { [string]: any }, style: Enum.EasingStyle?, dir: Enum.EasingDirection?): Tween
	local t = TweenService:Create(inst, TweenInfo.new(time, style or Enum.EasingStyle.Quad, dir or Enum.EasingDirection.Out), props)
	t:Play()
	return t
end

function Lib.serverNow(): number
	return Workspace:GetServerTimeNow()
end

-- Clear generated children but keep layout objects.
function Lib.clear(parent: Instance)
	for _, c in parent:GetChildren() do
		if not c:IsA("UIBase") then
			c:Destroy()
		end
	end
end

return Lib
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="67">
            <Properties>
              <string name="Name">Theme</string>
              <string name="Source"><![CDATA[--[[
	Theme
	The visual language of the whole UI: soft blue-grey panels, white cards,
	small uppercase labels, bold numbers, green price / blue time chips and a
	dark glass HUD. Change values here to restyle everything.
]]

local rgb = Color3.fromRGB

local Theme = {}

Theme.Font = {
	Regular = Font.new("rbxasset://fonts/families/TitilliumWeb.json", Enum.FontWeight.Regular),
	Semi = Font.new("rbxasset://fonts/families/TitilliumWeb.json", Enum.FontWeight.SemiBold),
	Bold = Font.new("rbxasset://fonts/families/TitilliumWeb.json", Enum.FontWeight.Bold),
}

Theme.Color = {
	Panel = rgb(234, 240, 246),
	PanelStroke = rgb(206, 216, 228),
	Card = rgb(250, 251, 253),
	CardAlt = rgb(242, 246, 250),
	CardStroke = rgb(220, 228, 238),
	Header = rgb(246, 249, 252),
	Text = rgb(28, 36, 50),
	TextSoft = rgb(70, 80, 96),
	Muted = rgb(112, 122, 138),
	Faint = rgb(160, 170, 184),

	Accent = rgb(58, 124, 228),
	AccentSoft = rgb(222, 234, 250),
	Teal = rgb(52, 166, 196),
	TealSoft = rgb(206, 236, 244),
	Amber = rgb(196, 128, 26),
	Good = rgb(36, 140, 74),
	GoodSoft = rgb(214, 240, 222),
	Time = rgb(56, 104, 182),
	TimeSoft = rgb(220, 232, 248),
	Bad = rgb(204, 52, 52),
	BadSoft = rgb(250, 224, 224),
	Gold = rgb(222, 170, 40),
	GoldSoft = rgb(252, 240, 206),

	Track = rgb(218, 225, 234),
	Tab = rgb(226, 233, 241),
	TabActive = rgb(204, 236, 244),

	Civil = rgb(84, 156, 230),
	CivilSoft = rgb(226, 238, 250),
	Military = rgb(208, 76, 76),
	MilitarySoft = rgb(248, 220, 220),

	Hud = rgb(26, 32, 30),
	HudText = rgb(244, 246, 248),
	HudMuted = rgb(186, 196, 190),
	CashTint = rgb(56, 96, 66),
	PopTint = rgb(58, 74, 92),
	HappyTint = rgb(104, 100, 52),

	White = rgb(255, 255, 255),
	Black = rgb(0, 0, 0),
	Shadow = rgb(20, 28, 40),
}

Theme.Radius = {
	Panel = 10,
	Card = 8,
	Chip = 5,
	Pill = 8,
}

Theme.TextSize = {
	Tiny = 11,
	Small = 13,
	Body = 15,
	Title = 19,
	Big = 24,
	Huge = 32,
}

return Theme
]]></string>
